{
  "name": "helpdeskc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch & wrangler dev",
    "build": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "db:generate": "drizzle-kit generate --config drizzle.config.postgres.ts",
    "db:migrate:local": "drizzle-kit migrate --config drizzle.config.postgres.ts",
    "db:seed": "bun run scripts/seed.ts",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-bootstrap": "^2.10.5",
    "bootstrap": "^5.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^4.127.1"
  }
}
