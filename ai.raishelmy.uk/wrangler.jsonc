{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-raishelmy",
  "account_id": "530e4678b2077d9a34625964d9060d88",   // developer (Hira) account
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // Cloudflare AI Gateway this portal fronts (AI → AI Gateway in the dashboard).
    "AI_GATEWAY_ID": "raisai",
    "CF_ACCOUNT_ID": "530e4678b2077d9a34625964d9060d88",
    // Budget windows (daily / weekly / monthly) are computed in this timezone.
    "BUDGET_TIMEZONE": "Asia/Kuala_Lumpur",
    "PUBLIC_BASE_URL": "https://ai.raishelmy.uk"
  },

  // Secrets (wrangler secret put <NAME>):
  //   ADMIN_PASSWORD        portal login
  //   SAAS_SSO_SECRET       shared with saas.raishelmy.uk/admin (also signs the session cookie)
  //   CLOUDFLARE_API_TOKEN  Hira-account token: Workers AI Run + AI Gateway Read (upstream Workers AI calls + cost sync)
  //   EDGE_SECRET           shared with edge-proxy; requests without x-rais-edge are refused
  //   AI_GATEWAY_TOKEN      optional — gateway auth token if the gateway has authentication enabled / BYOK keys
  //   ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY, ...  optional per-provider upstream keys
  //   <PROVIDER>_API_KEY    any other AI Gateway provider slug, upper-cased, dashes → underscores

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/healthz"]
  },

  // Public hostname ai.raishelmy.uk is a zone in the raishelmy account, so it is served by the
  // edge proxy in ./edge-proxy (raishelmy account) which relays to this Worker's workers.dev URL.
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-raishelmy",
      "database_id": "320aaf20-4cac-45ed-8229-b9b1f73ea246",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
