{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Lives in the raishelmy account (owner of the raishelmy.uk zone). Relays ai.raishelmy.uk
  // to the real app Worker in the Hira account. Secret: EDGE_SECRET (same value as the app).
  "name": "ai-raishelmy",
  "account_id": "6af8ff18a864c2b56f1a3aa78cb24f80",
  "main": "index.ts",
  "compatibility_date": "2026-08-27",
  "vars": { "ORIGIN": "https://ai-raishelmy.developer-530.workers.dev" },
  "routes": [{ "pattern": "ai.raishelmy.uk", "custom_domain": true }],
  "observability": { "enabled": true }
}
