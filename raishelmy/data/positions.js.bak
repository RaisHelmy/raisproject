      competencies: ['SAP HR / ERP', 'LDAP / AD', 'Esri ArcGIS', 'SIP / PBX', 'Oracle', 'REST / SOAP', 'MDM', 'Middleware Design', 'XMPP / Jitsi', 'Enterprise Architecture', '.NET Integration', 'JWT / SSO'],
