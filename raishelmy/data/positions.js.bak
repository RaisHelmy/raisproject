/* ─────────────────────────────────────────────────────────────────────────────
   POSITIONS DATA
   Position-specific content for CV and Cover Letter templates.
   Each entry overrides only the parts that vary; shared experience
   entries (jobs 1-5, education, projects) remain in the template HTML.
───────────────────────────────────────────────────────────────────────────── */
window.POSITIONS = {

  /* ── 1. .NET Developer ───────────────────────────────────────────────────── */
  'dotnet-developer': {
    label: '.NET Developer',
    cv: {
      pageTitle: 'Rais Helmy Sapiullah — .NET Developer CV',
      roleTags: ['Senior .NET Developer', 'Back End Engineer', 'C# Developer', 'Clean Architecture', 'CQRS Practitioner'],
      glanceSpec: '.NET 8 · Clean Architecture<br>CQRS · MediatR · DDD<br>Enterprise Backend<br>Insurance &amp; ERP APIs',
      summary: `Senior .NET Developer with <span class="cv-exp-text">6+</span> years of enterprise backend delivery across insurance, ERP, and defence sectors in Malaysia. I design and build systems grounded in <strong>.NET 8 Clean Architecture</strong>, <strong>CQRS with MediatR</strong>, and <strong>Domain-Driven Design</strong> — enforcing strict layer separation and writing code that teams can inherit and extend. Currently at Etiqa Insurance engineering policy lifecycle APIs, AMLA watchlist batch jobs, and Oracle/SQL Server integrations under BNM regulatory requirements. I take ownership of correctness, auditability, and long-term maintainability.`,
      competencies: ['.NET 8', 'ASP.NET Core', 'C#', 'Clean Architecture', 'CQRS / DDD', 'MediatR', 'EF Core', 'SQL Server', 'Oracle', 'REST API', 'JWT Auth', 'Serilog'],
    },
    cl: {
      pageTitle: 'Rais Helmy Sapiullah — Cover Letter · .NET Developer',
      headerRole: 'Senior .NET Developer · Clean Architecture · CQRS · MediatR',
      subject: 'Application for Senior .NET Developer Position',
      targetRole: 'Senior .NET Developer',
      sigTags: ['Senior .NET Developer', 'Clean Architecture', 'CQRS / DDD', 'MediatR Expert'],
      hlCells: [
        { label: 'experience', val: '6+ Years', sub: '.NET · C# · Enterprise Backend' },
        { label: 'core stack', val: '.NET 8 · CQRS · MediatR', sub: 'Clean Arch · EF Core · SQL Server' },
        { label: 'domains', val: 'Insurance · ERP · Defence', sub: 'BNM · PDRM · TNB · Etiqa' }
      ],
      body: [
        `I am writing to express my strong interest in joining your engineering team as a <strong>Senior .NET Developer</strong>. With over <strong>six years of hands-on experience</strong> delivering enterprise-grade .NET backend systems across Malaysia's insurance, ERP, and defence sectors, I am confident I can contribute meaningfully from day one.`,
        `In my current role at <em>Etiqa Insurance and Takaful Berhad</em>, I engineer production systems using <strong>.NET 8 Clean Architecture and CQRS with MediatR</strong> — building insurance policy lifecycle APIs, integrating with <strong>SQL Server, Oracle, MDM, and PolisyM</strong>, and delivering a fully automated <strong>AMLA Watchlist Batch Job</strong> for BNM-aligned regulatory compliance. Writing .NET code that must be correct, auditable, and resilient under real regulatory pressure is my daily environment.`,
        `Prior to this, I was engaged by <em>JuruQuest Consulting</em> to rescue a failing enterprise mobile project for <strong>Tenaga Nasional Berhad (TNB)</strong>. I rebuilt the <strong>.NET 6 REST API</strong> from the ground up — introducing clean API design, JWT authentication, <strong>LDAP / SAP integration</strong>, and a configurable multi-layer approval workflow engine. The backend now serves field operations across TNB's asset management and permit systems.`,
        `Earlier in my career I served as <strong>Solution Architect</strong> for the <strong>PDRM C4i Command and Control Centre</strong> — delivering a mission-critical .NET Core API backend integrated with GIS, telephony, unified communications, and enterprise VPN. Writing reliable software for a law enforcement command centre demanded the highest standard of engineering discipline.`,
        `Beyond delivery, I bring practical experience in <strong>Cloudflare Workers serverless</strong> architectures, <strong>GitLab CI/CD</strong>, Docker, and a consistent commitment to writing maintainable, well-structured .NET code that future engineers can confidently own.`,
        `I thrive in environments where the engineering bar is set deliberately high, the problems are real, and quality is non-negotiable. I would welcome the opportunity to bring that same rigour to your .NET team.`,
        `Thank you sincerely for your time and consideration. I look forward to discussing how my background aligns with your team's goals.`
      ]
    }
  },

  /* ── 2. Technical Support ────────────────────────────────────────────────── */
  'technical-support': {
    label: 'Technical Support',
    cv: {
      pageTitle: 'Rais Helmy Sapiullah — Technical Support CV',
      roleTags: ['Technical Support Engineer', 'Systems Administrator', 'Integration Specialist', 'IT Support', 'Infrastructure Support'],
      glanceSpec: 'Enterprise Support · Diagnostics<br>LDAP / AD · Windows Server<br>System Integration<br>Multi-Domain Experience',
      summary: `Adaptable technical support engineer with <span class="cv-exp-text">6+</span> years bridging complex enterprise systems and end-user environments across insurance, utility, and defence sectors. Experienced in diagnosing production failures, maintaining critical enterprise platforms, and supporting <strong>LDAP/AD, SQL Server, SAP, Oracle</strong> integrations under strict SLA conditions. Comfortable operating across the full stack — from infrastructure diagnostics and Windows/Linux server management to API-level troubleshooting and application monitoring with <strong>Application Insights</strong> and <strong>Serilog</strong>.`,
      competencies: ['Troubleshooting', 'LDAP / AD', 'Windows Server', 'SQL Server', 'System Diagnostics', 'API Testing', 'VMware ESXi', 'Linux', 'Network Support', 'Incident Response', 'Application Insights', 'Postman'],
    },
    cl: {
      pageTitle: 'Rais Helmy Sapiullah — Cover Letter · Technical Support',
      headerRole: 'Technical Support Engineer · System Integration · Infrastructure',
      subject: 'Application for Technical Support Engineer Position',
      targetRole: 'Technical Support Engineer',
      sigTags: ['Technical Support Engineer', 'System Integration', 'LDAP / AD Specialist', 'IT Troubleshooting'],
      hlCells: [
        { label: 'experience', val: '6+ Years', sub: '.NET · Mobile · Infrastructure' },
        { label: 'core stack', val: 'LDAP · SQL Server · SAP', sub: 'Windows Server · VMware · Linux' },
        { label: 'domains', val: 'Insurance · Defence · Utility', sub: 'TNB · PDRM · Etiqa' }
      ],
      body: [
        `I am writing to express my strong interest in the <strong>Technical Support Engineer</strong> position at your organisation. With over <strong>six years of enterprise delivery experience</strong> across some of Malaysia's most demanding technical environments — insurance, law enforcement, and national utility — I bring deep practical ability to diagnose, resolve, and prevent complex system issues.`,
        `In my current role at <em>Etiqa Insurance and Takaful Berhad</em>, I maintain and extend enterprise insurance backend systems integrated with <strong>SQL Server, Oracle, MDM, and PolisyM</strong>. I have first-hand experience with production incident response, regulatory audit log review, and API-level troubleshooting at scale. Supporting complex integrations under BNM compliance requirements has sharpened my ability to work under pressure while keeping stakeholders informed.`,
        `At <em>JuruQuest Consulting</em> on the <strong>TNB TOMAS</strong> project, I performed full reverse engineering of a broken production codebase — diagnose-first, fix-second — and rebuilt the system from scratch. This included <strong>LDAP / Active Directory integration</strong> for enterprise SSO, <strong>SAP ERP</strong> data synchronisation, and multi-layer approval workflows serving TNB field engineers on iOS and Android. Supporting complex systems across teams requires exactly this kind of structured diagnostic thinking.`,
        `At <em>Vector Intelligence</em>, I designed and supported <strong>VMware ESXi hyperconverged infrastructure</strong>, enterprise <strong>VPN perimeters</strong> (OpenVPN, IPSec), <strong>Active Directory RBAC</strong>, and integrated CCTV / communications systems for the <strong>PDRM C4i Command Centre</strong> — a 24/7 law enforcement operations platform where uptime was non-negotiable.`,
        `I bring strong documentation habits, structured incident reporting, and a calm, methodical approach to high-pressure support scenarios. I communicate technical issues clearly to both engineering teams and non-technical stakeholders.`,
        `I would welcome the opportunity to contribute this depth of diagnostic and system support experience to your team.`,
        `Thank you sincerely for your time and consideration. I look forward to discussing how my background can support your operations.`
      ]
    }
  },

  /* ── 3. Full Stack Engineer ──────────────────────────────────────────────── */
