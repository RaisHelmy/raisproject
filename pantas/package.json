{
  "name": "pantas",
  "private": true,
  "type": "module",
  "workspaces": [
    "mobile/apps/*",
    "mobile/packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.postgres.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.postgres.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "uuid": "^11.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.28.1",
    "pg": "^8.13.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
