{
  "name": "super-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Super MCP — Autonomous Software Engineering & IT Operations Platform",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -c \"SET search_path TO raisinfrasupermcp;\" -f migrations/0002_postgres_init.sql"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "highcharts": "^11.4.8",
    "highcharts-react-official": "^3.2.1",
    "hono": "^4.6.3",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/bun": "^1.1.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^3.78.0"
  }
}
