@model Integrity.IntegrityPledge.Models.PledgeVM

@{
    ViewBag.Title = "Integrity Module";
}

<style>
    .page-secondary-title {
        font-style: italic;
        font-size: 18px;
    }
</style>

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Integrity Modules
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>

<br />
<br />

<div class="row">
    <div class="col-md-4">
        <div class="row">
            <div class="col-md-2">
                <img src="@Url.Content("~/assets/img/others/calendar.png")" />
            </div>

            <div class="col-md-10">
                <div class="row">
                    <span class="col-md-12">
                        <a href="@Url.Action("AssetDeclaration", "Asset")">
                            Perisytiharan Harta
                        </a>
                    </span>
                    <span class="col-md-12">My Asset Declaration</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="row">
            <div class="col-md-2">
                <img src="@Url.Content("~/assets/img/others/calendar.png")" />
            </div>

            <div class="col-md-10">
                <div class="row">
                    <span class="col-md-12">
                        <a href="@Url.Action("Index", "IntegrityPledge")">
                            Ikrar Integriti
                        </a>
                    </span>
                    <span class="col-md-12">Integrity Pledge</span>
                </div>
                @*<div class="row">
                    <span class="col-md-12">
                        <a href="@Url.Action("Index", "IntegrityPledge", new { Category = "Staff" })">
                            - Staff Pledge
                        </a>
                    </span>
                    <div class="col-md-12">
                        <a href="@Url.Action("Index", "IntegrityPledge", new { Category = "Procurement Staff" })">
                            - Procurement Staff Pledge
                            (Procurement Staff Only)
                        </a>
                    </div>
                </div>*@
            </div>
        </div>
    </div>
</div>

<br />

<br />

<div class="row">
    <div class="col-md-4">
        <div class="row">
            <div class="col-md-2">
                <img src="@Url.Content("~/assets/img/others/calendar.png")" />
            </div>

            <div class="col-md-10">
                <div class="row">
                    <span class="col-md-12">
                        <a href="@Url.Action("Index", "COI")">
                            Perisytiharan Percanggahan Kepentingan
                        </a>
                    </span>
                    <span class="col-md-12">Conflict of Interest Declaration</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="row">
            <div class="col-md-2">
                @*<img src="@Url.Content("~/assets/img/others/calendar.png")" />*@
                <i class="fa fa-file-o" style="font-size: 40px;"></i>
            </div>

            <div class="col-md-10">
                <div class="row">
                    <span class="col-md-12">
                        <a href="http://stg.ess2.tnb.com.my/COI%20Manual%20Document/Forms/AllItems.aspx">
                            User Guide / Panduan Pengguna
                        </a>
                    </span>
                    @*<span class="col-md-12">Conflict of Interest (COI)</span>*@
                </div>
            </div>
        </div>
    </div>
</div>

<br />
<br />
<br />


<style>
    th {
        text-align: left;
        padding: 5px;
    }

    table {
        border-collapse: collapse;
    }

    td {
        padding: 7px 5px;
    }

    th {
        background: lightgrey;
    }

    .table-text {
        margin: 0;
    }

    .table-secondary-title {
        font-style: italic;
    }
</style>

<div class="row">
    <div class="col-md-offset-3 col-md-6">
        <table border="1">
            <thead>
                <tr>
                    <th>
                        <p class="table-text">Perisytiharan</p>
                        <p class="table-text table-secondary-title">Declaration</p>
                    </th>
                    <th>
                        <p class="table-text">Kekerapan</p>
                        <p class="table-text table-secondary-title">Frequency</p>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <p class="table-text">Perisytiharan Harta</p>
                        <p class="table-text table-secondary-title">Declaration of Asset</p>
                    </td>
                    <td>
                        <p class="table-text">Setiap tahun dan apabila aset diperoleh dan/atau dilupuskan</p>
                        <p class="table-text table-secondary-title">Annually and when assets are acquired and/or disposed</p>
                    </td>
                </tr>
                <tr>
                    <td>
                       
                        <p class="table-text">Ikrar Integriti</p>
                        <p class="table-text table-secondary-title">Integrity Pledge</p>
                    </td>
                    <td>
                        <p class="table-text">Tahunan</p>
                        <p class="table-text table-secondary-title">Annually</p>
                    </td>
                </tr>
                <tr>
                    <td>
                        <p class="table-text">Perisytiharan Percanggahan Kepentingan</p>
                        <p class="table-text table-secondary-title">Conflict of Interest Declaration</p>
                    </td>
                    <td>
                        <p class="table-text">Setiap tahun dan/atau apabila terjadi konflik</p>
                        <p class="table-text table-secondary-title">Annually and/or when a conflict arises</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>