@using SEP.RoutingManagement.Models
@model IEnumerable<App>


<div class="form-section">
    <div class="row">
        <div class="col-md-10">
            <h1 class="page-title">
                Module Routing Configurations
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
        <div class="col-md-2">
            <select id="appSelection" class="form-control text-right">
                <option value="">
                    -   Select App   -
                </option>
                @foreach (var app2 in Model)
                {
                    <option value="@app2.ID">
                        @app2.ApplicationName
                    </option>
                }
            </select>
        </div>
    </div>
</div>
@foreach (var app in Model)
{
    <div id="@app.ID" class="portlet box blue portlet-apps" style="display: none;">
        <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-reorder"></i> @app.ApplicationName
            </div>
            <div class="tools">
                <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
            </div>
        </div>

        <div class="portlet-body form">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Application Name</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control ReferenceNo" name="ReferenceNo"
                                           readonly="readonly" value="@app.ApplicationName" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Display Name</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control Status" name="Status"
                                           readonly="readonly" value="@app.DisplayName" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Intray</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control ReferenceNo" name="ReferenceNo"
                                           readonly="readonly" value="@app.Intray" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Active</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control Status" name="Status"
                                           readonly="readonly" value="@app.Active" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">

                </div>
            </div>
        </div>
    </div>
}

<script>
    $(function () {
        $('#appSelection').on('change', function () {
            var selectedApp = $(this).val();

            $('.portlet-apps').hide();
            $('#' + selectedApp).show();
        });
    });
</script>