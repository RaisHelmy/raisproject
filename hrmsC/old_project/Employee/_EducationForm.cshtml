                EducationAttachMandatory: _EducationAttachMandatory,
                AttachmentSessionName: _AttachmentSessionName,
                AttachmentSourceType: _AttachmentSourceType,
                AttachmentCategory: _AttachmentCategory,
                createdBy: _createdBy
            };
            ResultMsg = "The request (Add Education Information) has been successfully submitted.";
            Url = '@Url.Content("~/Employee/SubmitEducationForm")';
        }
        else if (FormAction.toUpperCase() == "EDIT") {
            var form = {
                EmployeeID: _EmployeeID,
                EducationSelectedValue: _EducationSelectedValue,
                EducationSelectedText: _EducationSelectedText,
                CountrySelectedValue: _CountrySelectedValue,
                CountrySelectedText: _CountrySelectedText,
                SchoolSelectedValue: _SchoolSelectedValue,
                SchoolSelectedText: _SchoolSelectedText,
                CertificateSelectedValue: _CertificateSelectedValue,
                CertificateSelectedText: _CertificateSelectedText,
                CGPA: _CGPA,
                ClassSelectedValue: _ClassSelectedValue,
                ClassSelectedText: _ClassSelectedText,
                FinalGrade: _FinalGrade,
                BranchOfStudy1SelectedValue: _BranchOfStudy1SelectedValue,
                BranchOfStudy1SelectedText: _BranchOfStudy1SelectedText,
                BranchOfStudy2SelectedValue: _BranchOfStudy2SelectedValue,
                BranchOfStudy2SelectedText: _BranchOfStudy2SelectedText,
                GraduatedDateValue: _GraduatedDateValue,
                GraduatedDateText: _GraduatedDateText,
                BahasaMalaysiaGrade: _BahasaMalaysiaGrade,
                EducationSponsorshipStatusSelectedValue: _EducationSponsorshipStatusSelectedValue,
                EducationSponsorshipStatusSelectedText: _EducationSponsorshipStatusSelectedText,
                Comment: _Comment,
                EducationAttachMandatory: _EducationAttachMandatory,
                AttachmentSessionName: _AttachmentSessionName,
                AttachmentSourceType: _AttachmentSourceType,
                AttachmentCategory: _AttachmentCategory,
                createdBy: _createdBy,
                HiddenRecordNumber: _HiddenRecordNumber,
                HiddenObjectID: _HiddenObjectID,
                HiddenLockIndicator: _HiddenLockIndicator,
                HiddenStartDate: _HiddenStartDate,
                HiddenEndDate: _HiddenEndDate,
                HiddenEducation: _HiddenEducation,
                HiddenCountry: _HiddenCountry,
                HiddenSchool: _HiddenSchool,
                HiddenCertificate: _HiddenCertificate,
                HiddenCGPA: _HiddenCGPA,
                HiddenClass: _HiddenClass,
                HiddenFinalGrade: _HiddenFinalGrade,
                HiddenBranchOfStudy1: _HiddenBranchOfStudy1,
                HiddenBranchOfStudy2: _HiddenBranchOfStudy2,
                HiddenGraduatedDate: _HiddenGraduatedDate,
                HiddenBahasaMalaysiaGrade: _HiddenBahasaMalaysiaGrade,
                HiddenEducationSponsorshipStatus: _HiddenEducationSponsorshipStatus,

            };

            ResultMsg = "The request (Edit Education Information) has been successfully submitted.";
            Url = '@Url.Content("~/Employee/UpdateEducationForm")';
        }

        if ($('#divLoading').is(':visible')) {

            $.ajax({
                type: "POST",
                url: Url,
                cache: false,
                async: false,
                dataType: "json",
                data: form,
                success: function (result) {
                    if (result.Success) {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").show();

                        ResultMsg += "<br/><br/>Request No: <label class='refno'>" + result.RequestNo + "</label>";
                        $(".Success-body .well").html(ResultMsg);
                        $("#SuccessSubmit").modal();

                        $("#btnOK").click(function () { RedirectTo(FormAction.toUpperCase()); });
                    }
                    else {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").hide();
                        btn.disabled = false;

                        alert(result.ErrorMsg);

                    }
                },
                error: function (e) {

                }
            });
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "INSERT":
                location.reload();
                break;
            case "EDIT":
                location.reload();
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }


    function AllowEdit_Education(btn, FormAction) {

        var EmployeeCode = "@Model.Item1.EmployeeCode";
        var EmployeeID = "@Model.Item1.EmployeeID";

        var Education = "@Model.Item1.EducationCode";
        var RecordNumber = "@Model.Item1.RecordNumber";
        var StartDate = "@Service.FormatDateInNumber(Model.Item1.StartDate, "dd/MM/yyyy")";
        var EndDate = "@Service.FormatDateInNumber(Model.Item1.EndDate, "dd/MM/yyyy")";
        var Action = 'Edit';

        $("#divEPM_Modal #FormCategory").val("@module");
        $("#divEPM_Modal #FormAction").val(Action);
        var url = "@Url.Content("~/Employee/_EducationForm")";
        var data = {
            EmployeeCode: EmployeeCode,
            EmployeeID: EmployeeID,
            Education: Education,
            RecordNumber: RecordNumber,
            StartDate: StartDate,
            EndDate: EndDate,
            Mode: Action
        };
        btn.disabled = false;
        OpenEditPanel('Edit Education Info', Action, url, data)
    }


</script>

@*Script Load Form Function*@
<script type="text/javascript">
    function ReformatDate(edate, Type) {
        try {
            if (edate.length > 0)
            {
                var myDate = $.datepicker.parseDate("dd/mm/yy", edate);
                var d = myDate.getDate();
                var m = myDate.getMonth();
                m += 1;
                var y = myDate.getFullYear();

                var newdate = (y + "-" + m + "-" + d);
                return newdate;
            }
            return "";
        }

        catch (e) {
            var Error = "ERROR";
            //alert('Invalid Date Format ('+Type+')' + e);
            //alert(e);
            return Error;
        }

    }

</script>

