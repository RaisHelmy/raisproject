@*script Main Function *@
<script type="text/javascript">
    function LoadFormConfiguration() {
        $("#divEPM_Modal #AttachmentSessionName").val("@ViewBag.AttachmentSessionName");
        $("#divEPM_Modal #AttachmentSourceType").val("@ViewBag.AttachmentSourceType");

        //$('#divEPM_Modal #ddlEducation').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#divEPM_Modal #ddlCountry').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#divEPM_Modal #ddlCertificate').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#divEPM_Modal #ddlSchool').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#divEPM_Modal #ddlClass').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#divEPM_Modal #ddlBranchOfStudy1').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#ddlBranchOfStudy2').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#divEPM_Modal #ddlEducationSponsorshipStatus').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        $("#divEPM_Modal #GraduatedDate").datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            endDate: "@dtStrEnd"
        });

        @Html.Raw("RetrieveEducationOptions();");
        @Html.Raw("RetrieveCountryOptions();");
        @Html.Raw("RetrieveCertificateOptions();");
        @Html.Raw("RetrieveSchoolOptions();");
        @Html.Raw("RetrieveClassOptions();");
        @Html.Raw("RetrieveBranchOfStudyOptions();");
        @Html.Raw("RetrieveEducationSponsorshipStatusOptions();");
        Checking();
        var ReadOnly = "@ReadOnly";
        if (ReadOnly.toUpperCase() == "FALSE")
        {
             Attachment();
        }
    }

    function LoadFormOnChange() {

        $('#divEPM_Modal #ddlEducation').change(function () {
            // if changed to, for example, the last option, then
            // $(this).find('option:selected').text() == D
            // $(this).val() == 4
            // get whatever value you want into a variable
            var HiddenEducationValue = $("#divEPM_Modal #ddlEducation option:selected").val() + "";
            var HiddenEducationText = $("#divEPM_Modal #ddlEducation option:selected").text() + "";

            // and update the hidden input's value
            $('#divEPM_Modal #EducationName').val(HiddenEducationText);
            $('#divEPM_Modal #EducationCode').val(HiddenEducationValue);
            EducationChange();
        });

        $('#divEPM_Modal #ddlCountry').change(function () {
            // if changed to, for example, the last option, then
            // $(this).find('option:selected').text() == D
            // $(this).val() == 4
            // get whatever value you want into a variable
            var HiddenCountryValue = $("#divEPM_Modal #ddlCountry option:selected").val() + "";
            var HiddenCountryText = $("#divEPM_Modal #ddlCountry option:selected").text() + "";

            // and update the hidden input's value
            $('#divEPM_Modal #CountryName').val(HiddenCountryText);
            $('#divEPM_Modal #CountryCode').val(HiddenCountryValue);
            CountryChange();
        });

        $('#divEPM_Modal #ddlCertificate').change(function () {
            // if changed to, for example, the last option, then
            // $(this).find('option:selected').text() == D
            // $(this).val() == 4
