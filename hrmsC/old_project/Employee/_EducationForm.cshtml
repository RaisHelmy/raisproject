                                        {
                                            <input type="text" class="form-control" id="EducationName" name="EducationName" value="@Model.Item1.Education" readonly="readonly" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="EducationName" id="EducationName" value="@Model.Item1.Education" />
