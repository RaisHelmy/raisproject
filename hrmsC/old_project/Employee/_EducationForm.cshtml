@*script Submission Activity *@
<script type="text/javascript">


    function FormValidation(btn) {
        btn.disabled = true;

        var _ValidationMsg = '';
        var EducationCode = document.getElementById('EducationCode').value;
        var CountryCode = document.getElementById('CountryCode').value;
        var CertificateCode = document.getElementById('CertificateCode').value;
        var CGPA = document.getElementById('CGPA').value;
        var ClassCode = document.getElementById('ClassCode').value;
        var BranchOfStudy1Code = document.getElementById('BranchOfStudy1Code').value;
        var GraduatedDate = $("#divEPM_Modal #GraduatedDate").val() + "";
        var _GraduatedDateValue = ReformatDate($("#divEPM_Modal #GraduatedDate").val() + "", "Graduated Date");
        var BahasaMalaysiaGrade = $("#divEPM_Modal #BahasaMalaysiaGrade").val() + "";
        var EducationAttachMandatory = document.getElementById('EducationAttachMandatory').value;
        var CreateONLY = "@Create";

        var CountTotal_Attachment = "";
        if (EducationAttachMandatory == "true") {
            CountTotal_Attachment = document.getElementById('CountTotal_Attachment').value;
        }
        // SubAttachment/_AttachmentListing

        if (EducationCode == "") {
            _ValidationMsg += '- Education is required.\n';
        }

        if (CountryCode == "") {
            _ValidationMsg += '- Country is required.\n';
        }

        if (CGPA != "")
        {
            var re = /^\d{1,4}(\.\d{1,2})?$/;

            if (!re.test(CGPA)) {
                // Wrong
                _ValidationMsg += '- CGPA is invalid.\n';
            }

        }
        else
        {
            if (!$("#divEPM_Modal .spanCGPARequired").hasClass("hidden")) {
                _ValidationMsg += '- CGPA is required.\n';
            }
            
        }

        if (ClassCode == "") {
            if (!$("#divEPM_Modal .spanClassRequired").hasClass("hidden")) {
                _ValidationMsg += '- Class is required.\n';
            }
        }

        if (BranchOfStudy1Code == "") {
            _ValidationMsg += '- Branch Of Study 1 is required.\n';
        }

        if (BahasaMalaysiaGrade == "") {
            if (!$("#divEPM_Modal .spanSPMRequired").hasClass("hidden")) {
                _ValidationMsg += '- SPM/MCE Bahasa Malaysia Grad is required.\n';
            }
        }

        if (GraduatedDate == "") {
            _ValidationMsg += '- Graduated Date is required.\n';
        }
        else if (_GraduatedDateValue.toUpperCase() == "ERROR") {
            _ValidationMsg += '- Invalid Graduated Date Format (dd/MM/yyyy).\n';
        }

        //if (EducationAttachMandatory.toUpperCase() == "TRUE" && CreateONLY.toUpperCase() == "TRUE") {
        //    if (CountTotal_Attachment == "0") {
        //        _ValidationMsg += '- Attachment is required.\n';
        //    }
        //}

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application. If you want to make changes, click Close.');
            $("#divLoading2").show();
            $("#ConfirmUpdate").modal('show');

        }
        btn.disabled = false;
    }

