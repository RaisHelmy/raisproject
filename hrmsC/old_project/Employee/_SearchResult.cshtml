@model List<ESS.Employee.Models.EmployeeSearch>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Search Result
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Employee No</th>
                                <th>Employee Name</th>
                                <th>Employee Group</th>
                                <th>Company</th>
                                <th>Division / Department</th>
                                <th>Unit / Section</th>
                                <th>Official HP No.</th>
                                <th>Office No.</th>
                                <th>Extension No.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Employee/Index")?EmployeeID=@item.EmployeeID">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@((string.IsNullOrEmpty(item.EmployeeCode)) ? "-" : item.EmployeeCode)</td>
                                    <td>@((string.IsNullOrEmpty(item.EmployeeName)) ? "-" : item.EmployeeName)</td>
                                    <td>@((string.IsNullOrEmpty(item.GroupName)) ? "-" : item.GroupName)</td>
                                    <td>@((string.IsNullOrEmpty(item.CompanyCode)) ? "-" : item.CompanyCode)</td>
                                    <td>@((string.IsNullOrEmpty(item.AreaName)) ? "-" : item.AreaName)</td>
                                    <td>@((string.IsNullOrEmpty(item.SubAreaName)) ? "-" : item.SubAreaName)</td>
                                    <td>@((string.IsNullOrEmpty(item.OfficeMobile)) ? "-" : item.OfficeMobile)</td>
                                    <td>@((string.IsNullOrEmpty(item.OfficeNo)) ? "-" : item.OfficeNo)</td>
                                    <td>@((string.IsNullOrEmpty(item.ExtNo)) ? "-" : item.ExtNo)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>



