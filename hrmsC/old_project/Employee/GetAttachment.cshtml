@model List<ESS.Employee.Models.EmpAttachmentInfo>
@using ESS.Employee
@{
    Layout = null;
    var Path = string.Format("{0}://{1}{2}", Request.Url.Scheme, Request.Url.Authority, Url.Content("~"));
}
<input type="hidden" value="@ViewBag.RequestID" />
<div class="form-body">
    <div class="form-horizontal">
        <div class="table-toolbar">
            <table id="tblAttachment" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th></th>
                        <th>Field Name</th>
                        <th>Category  </th>
                        <th>Description</th>
                        <th>Attachment</th>
                        @*<th>Size</th>*@
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in @Model)
            {
                        <tr>
                            <td>
                                <a class="btn blue btn-sm" onclick="DownloadAttachment('@item.ID')"><i class="fa fa-download"></i></a>
                            </td>
                            <td>@((string.IsNullOrEmpty(item.FieldName)) ? "-" : item.FieldName)</td>
                            <td>@((string.IsNullOrEmpty(item.RequestCategory)) ? "-" : item.RequestCategory)</td>
                            <td>@((string.IsNullOrEmpty(item.Description)) ? "-" : item.Description)</td>
                            <td>@((string.IsNullOrEmpty(item.DocumentName)) ? "-" : item.DocumentName)</td>
                            @*<td>@item.DocumentSize</td>*@
                            @if (item.CreatedDate.HasValue)
                            {
                               
                                <td>@Service.FormatDateInNumber(item.CreatedDate, "dd/MM/yyyy")</td>
                            }
                            else
                            {
                                <td>-</td>
                            }

                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
<script type="text/javascript">
        //transformTable("#tblAttachment");

        //$('#tblAttachment').dataTable(
        //{
        //    "bLengthChange": false,
        //    "bFilter": false,
        //    "bPaginate": false,
        //    "bInfo": false,
        //    "bSortable": false,

        //});

        function DownloadAttachment(_AttachmentID) {
            var AttachmentID = _AttachmentID;
            //window.open('@Path' + '/api/FileWebApi/' + AttachmentID);

            var jqxhr = $.ajax('@Path' + '/ETKMS')
                .done(function () {
                    window.open('@Path' + '/Attachment/DownloadFile/' + AttachmentID);
                });
        }
</script>
