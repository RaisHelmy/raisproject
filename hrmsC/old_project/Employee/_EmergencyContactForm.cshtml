@model Tuple<ESS.Employee.Models.EmergencyContactInfo, ESS.Employee.Models.Setting>
@using ESS.Employee;
@{
    #region
    string module = "EmergencyContact";

    Layout = null;
    bool ReadOnly = false;
    bool EditReadOnly = false;
    bool Create = false;

    string classViewReadOnly = "";
    string EmployeeCategory_EmergencyContact = ViewBag.EmployeeCategory_EmergencyContact + "";

    string Mode = ViewBag.Mode + "";
    string divMode = "";
    if (String.Equals(Mode, "View", StringComparison.OrdinalIgnoreCase))
    {
        ReadOnly = true;
        classViewReadOnly = "disabled = 'disabled' ";
        divMode = "";
    }
    else if (String.Equals(Mode, "Edit", StringComparison.OrdinalIgnoreCase))
    {
        ReadOnly = false;
        EditReadOnly = true;
        classViewReadOnly = "";
        divMode = "Edit";
    }
    else
    {
        Create = true;
        divMode = "Insert";
    }

    bool runFieldVisible = false;
    if (Model.Item2 != null)
    {
        runFieldVisible = true;
    }
    #endregion
}

<div id="_EmergencyContactInfo" class="row">
