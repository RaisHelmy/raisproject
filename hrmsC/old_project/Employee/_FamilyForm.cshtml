        var EmployerNameValue = "@Model.Item1.EmployerNameValue";

        for (i = 0; i < divBoxes.length; i++) {
            var divID = divBoxes[i].id;
            if ($("#divEPM_Modal #" + divID + " span").hasClass("checked")) {
                $("#divEPM_Modal #" + divID + " span").removeClass("checked");
            }
            var checkboxID = divID.replace("uniform-", "");

            if ($("#divEPM_Modal #" + checkboxID).val() == EmployerNameValue) {
                $("#divEPM_Modal #" + divID + " span").addClass("checked");
            }

            if (EmployerNameValue == '1') {
                //check is hidden
                if ($("#divEPM_Modal .divOtherEmployerName").hasClass("hidden")) {
                    //if is hidden show it
                    $("#divEPM_Modal .divOtherEmployerName").removeClass("hidden");
                }
            }
            else {
                if (!$("#divEPM_Modal .divOtherEmployerName").hasClass("hidden")) {
