    function ValidateIsICExist(EmpNo, NewICNo, valid, action) {
		var deferred = $.Deferred();

		if (valid) {
			$.ajax({
				type: "POST",
				url: "@Url.Action("CheckNewICExist", "Employee")?EmpNo=" + EmpNo + "&IC=" + NewICNo,
				success: function (result) {
					if (result.result == "1") {
						if (action == "Edit")
							deferred.resolve();
						else
							deferred.reject();
					}
					else {
						deferred.resolve();
					}
				},
				error: function (err) {
					console.log(err);
					alert("Error in the ajax call.");
					deferred.reject();
				}
			});
		}
		else {
			deferred.resolve();
		}

		return deferred;
	}

