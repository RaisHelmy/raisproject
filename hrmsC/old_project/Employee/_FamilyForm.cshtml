@model Tuple<ESS.Employee.Models.FamilyInfo, ESS.Employee.Models.Setting>
@using ESS.Employee;
@{
    #region
    string module = "Family";

    Layout = null;
    bool ReadOnly = false;
    bool EditReadOnly = false;
    bool Create = false;

    string classViewReadOnly = "";
    string EmployeeCategory_Family = ViewBag.EmployeeCategory_Family + "";

    string Mode = ViewBag.Mode + "";
    string divMode = "";

    if (string.Equals(Mode, "View", StringComparison.OrdinalIgnoreCase))
    {
        ReadOnly = true;
        classViewReadOnly = "disabled = 'disabled' ";
        divMode = "";
    }
    else if (string.Equals(Mode, "Edit", StringComparison.OrdinalIgnoreCase))
    {
        ReadOnly = false;
        EditReadOnly = true;
        classViewReadOnly = "";
        divMode = "Edit";
    }
    else
    {
        Create = true;
        divMode = "Insert";
    }

    bool runFieldVisible = false;
    if (Model.Item2 != null)
    {
        runFieldVisible = true;
    }

    DateTime setdateEnd = DateTime.Now;
    string dtStrEnd = setdateEnd.ToString("dd/MM/yyyy");
    #endregion
}

<style>
    #OtherEmployerName {
        width: auto;
        padding: 2px 2px;
        display: unset;
    }
</style>

<div id="EditItemTemplate">
    <input type="hidden" id="HiddenStartDate" value="@Service.FormatDateInNumber(Model.Item1.StartDate, "dd/MM/yyyy")" />
    <input type="hidden" id="HiddenEndDate" value="@Service.FormatDateInNumber(Model.Item1.EndDate, "dd/MM/yyyy")" />
    <input type="hidden" id="HiddenFirstName" value="@Model.Item1.FirstName" />
    <input type="hidden" id="HiddenLastName" value="@Model.Item1.LastName" />
    <input type="hidden" id="HiddenSurnamePrefix" value="@Model.Item1.SurnamePrefix" />
    <input type="hidden" id="HiddenMaidenName" value="@Model.Item1.MaidenName" />
    <input type="hidden" id="HiddenInitials" value="@Model.Item1.Initials" />
    <input type="hidden" id="HiddenTaxNumber" value="@Model.Item1.TaxNumber" />

    <input type="hidden" id="HiddenTaxOffice" value="@Model.Item1.TaxOffice" />
    <input type="hidden" id="HiddenReferenceNumber" value="@Model.Item1.ReferenceNumber" />
    <input type="hidden" id="HiddenNameFormat" value="@Model.Item1.NameFormat" />
    <input type="hidden" id="HiddenSchoolTypeCode" value="@Model.Item1.SchoolTypeCode" />
    @*<input type="hidden" id="HiddenChildCustody" value="@Model.Item1.CheckChildCusdoty" />*@

    <input type="hidden" id="HiddenAddressLine1" value="@Model.Item1.AddressLine1" />
    <input type="hidden" id="HiddenAddressLine2" value="@Model.Item1.AddressLine2" />

    <input type="hidden" id="HiddenAddressLine3" value="@Model.Item1.AddressLine3" />
    <input type="hidden" id="HiddenPostcode" value="@Model.Item1.Postcode" />
    <input type="hidden" id="HiddenCity" value="@Model.Item1.City" />
    <input type="hidden" id="HiddenCOName" value="@Model.Item1.COName" />
    <input type="hidden" id="HiddenTelephoneNumber" value="@Model.Item1.TelephoneNumber" />

    <input type="hidden" id="HiddenCommType1" value="@Model.Item1.CommType1" />
    <input type="hidden" id="HiddenPhoneNo1" value="@Model.Item1.PhoneNo1" />
    <input type="hidden" id="HiddenCommType2" value="@Model.Item1.CommType2" />
    <input type="hidden" id="HiddenPhoneNo2" value="@Model.Item1.PhoneNo2" />
    <input type="hidden" id="HiddenCommType3" value="@Model.Item1.CommType3" />
    <input type="hidden" id="HiddenPhoneNo3" value="@Model.Item1.PhoneNo3" />
    <input type="hidden" id="HiddenCommType4" value="@Model.Item1.CommType4" />
    <input type="hidden" id="HiddenPhoneNo4" value="@Model.Item1.PhoneNo4" />

    <input type="hidden" id="HiddenCountryCode" value="@Model.Item1.CountryCode" />
    <input type="hidden" id="HiddenStateCode" value="@Model.Item1.StateCode" />
    <input type="hidden" id="HiddenZAddf" value="@Model.Item1.ZAddf" />
    <input type="hidden" id="HiddenZRelt" value="@Model.Item1.ZRelt" />
    <input type="hidden" id="HiddenZUniq" value="@Model.Item1.ZUniq" />
</div>

<div id="_FamilyInfo" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Family Info
                </div>
            </div>
            <div class="portlet-body form" id="SearchGet_FamilyInfo">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group divRelationshipType">
                                    <label class="control-label col-md-4 ">
                                        Relationship Type<span class="required spanRelationshipTypeRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" name="RelationshipTypeCode" id="RelationshipTypeCode" value="@Model.Item1.RelationshipTypeCode" />
                                        @if (EditReadOnly || ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="RelationshipTypeName" name="RelationshipTypeName" value="@Model.Item1.RelationshipType" readonly="readonly" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="RelationshipTypeName" id="RelationshipTypeName" value="@Model.Item1.RelationshipType" />
                                            <select tabindex="0" id="ddlRelationshipType" class="form-control" @classViewReadOnly></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divGender">
                                    <label class="control-label col-md-4 ">
                                        Gender
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenGender" id="HiddenGender" value="@Model.Item1.Gender">
                                        <input type="hidden" name="GenderCode" id="GenderCode" value="@Model.Item1.GenderCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="GenderName" name="GenderName" value="@Model.Item1.Gender" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="GenderName" id="GenderName" value="@Model.Item1.Gender" />
                                            <select tabindex="0" id="ddlGender" class="form-control" @classViewReadOnly></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divName">
                                    <label class="control-label col-md-4 ">
                                        Name <span class="required spanFamilyNameRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control FamilyName" MaxLength="80" style="text-transform:capitalize"
                                               name="FamilyName" value="@Model.Item1.Name" pattern="\d{1,5}" id="FamilyName" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenFamilyName" value="@Model.Item1.Name" id="HiddenFamilyName">
                                    </div>
                                </div>
                                <div class="form-group divNewICNo">
                                    <label class="control-label col-md-4 ">
                                        New IC No.
                                        <span class="required spanNewICNoRequired" id="spanNewICNoRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" MaxLength="12"
                                               name="NewICNo" value="@Model.Item1.NewICNo" id="NewICNo" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenNewICNo" id="HiddenNewICNo" value="@Model.Item1.NewICNo">

                                        <input type="hidden" class="form-control"
                                               name="HiddenNewICNo_Name" id="HiddenNewICNo_Name" value="New IC No">
                                    </div>
                                </div>
                                <div class="form-group divOldICNo">
                                    <label class="control-label col-md-4 ">
                                        Old IC No
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" MaxLength="20"
                                               name="OldICNo" value="@Model.Item1.OldICNo" id="OldICNo" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenOldICNo" id="HiddenOldICNo" value="@Model.Item1.OldICNo">
                                    </div>
                                </div>
                                <div class="form-group divPassportNo">
                                    <label class="control-label col-md-4 ">
                                        Passport No.
                                        <span class="required spanPassportNoRequired" id="spanPassportNoRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" MaxLength="20"
                                               name="PassportNo" value="@Model.Item1.PassportNo" id="PassportNo" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenPassportNo" id="HiddenPassportNo" value="@Model.Item1.PassportNo">
                                    </div>
                                </div>
                                <div class="form-group divNationality divNationalityEdit">
                                    <label class="control-label col-md-4 ">
                                        Nationality <span class="required spanNationalityRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenNationality" id="HiddenNationality" value="@Model.Item1.Nationality">
                                        <input type="hidden" name="NationalityCode" id="NationalityCode" value="@Model.Item1.NationalityCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="NationalityName" name="NationalityName" value="@Model.Item1.Nationality" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="NationalityName" id="NationalityName" value="@Model.Item1.Nationality" />
                                            <select tabindex="0" id="ddlNationality" class="form-control" onchange="setTimeout(Checking,100);" @classViewReadOnly></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divDateOfDeath">
                                    <label class="control-label col-md-4 ">
                                        Date of Death
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="DateOfDeath" name="DateOfDeath" value="@Service.FormatDateInNumber(Model.Item1.DateOfDeath, "dd/MM/yyyy")" readonly="readonly" />
                                        }
                                        else
                                        {
                                            <div class="input-group date date-picker" id="boxDateOfDeath" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control DateOfDeath"
                                                       id="DateOfDeath" name="DateOfDeath" value="@Service.FormatDateInNumber(Model.Item1.DateOfDeath, "dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnDateOfDeath" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        }
                                        <input type="hidden" class="form-control"
                                               name="HiddenDateOfDeath" id="HiddenDateOfDeath" value="@Service.FormatDateInNumber(Model.Item1.DateOfDeath, "dd/MM/yyyy")">

                                    </div>
                                </div>
                                <div class="form-group divDateOfAdoption divDateOfAdoptionInsert divDateOfAdoptionEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Date of Adoption <span class="required spanDateOfAdoptionRequired hidden">*</span>
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="DateOfAdoption" name="DateOfAdoption" value="@Service.FormatDateInNumber(Model.Item1.DateOfAdoption, "dd/MM/yyyy")" readonly="readonly" />
                                        }
                                        else
                                        {
                                            <div class="input-group date date-picker" id="boxDateOfAdoption" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control DateOfAdoption"
                                                       id="DateOfAdoption" name="DateOfAdoption" value="@Service.FormatDateInNumber(Model.Item1.DateOfAdoption, "dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnDateOfAdoption" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        }
                                        <input type="hidden" class="form-control"
                                               name="HiddenDateOfAdoption" id="HiddenDateOfAdoption" value="@Service.FormatDateInNumber(Model.Item1.DateOfAdoption, "dd/MM/yyyy")">
                                    </div>
                                </div>
                                <div class="form-group divEligibleForMedical divEligibleForMedicalInsert divEligibleForMedicalEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Eligible For Medical
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <div class="checkbox-list">
                                            @{
                                                string CheckMedical = "";
                                                string boolMedical = "false";
                                                string a = "";
                                                if (Model.Item1.EligibleForMedical.HasValue)
                                                {
                                                    if (Model.Item1.EligibleForMedical.Value)
                                                    {
                                                        CheckMedical = "checked";
                                                        a = CheckMedical;
                                                    }
                                                    boolMedical = Model.Item1.EligibleForMedical + "";
                                                }

                                            }

                                            <input type="checkbox" id="chkMedical" @CheckMedical disabled>
                                        </div>
                                        <input type="hidden" class="form-control" name="HiddenMedical" id="HiddenMedical" value="@boolMedical">
                                    </div>
                                </div>

                                <div class="form-group divEducationInstitution divEducationInstitutionInsert divEducationInstitutionEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Education Institution <span class="required spanEducationInstitutionRequired hidden">*</span>
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenEducationInstitutionText" id="HiddenEducationInstitutionText" value="@Model.Item1.EducationInstitution">

                                        <input type="hidden" name="HiddenEducationInstitutionCode" id="HiddenEducationInstitutionCode" value="@Model.Item1.EducationInstitutionCode" />
                                        <input type="hidden" name="EducationInstitutionCode" id="EducationInstitutionCode" value="@Model.Item1.EducationInstitutionCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="EducationInstitutionName" name="EducationInstitutionName" value="@Model.Item1.EducationInstitution" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="EducationInstitutionName" id="EducationInstitutionName" value="@Model.Item1.EducationInstitution" />
                                            <select tabindex="0" id="ddlEducationInstitution" class="form-control" @classViewReadOnly></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divEmployerName divEmployerNameInsert divEmployerNameEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Employer Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="EmployerName" name="EmployerName" value="@Model.Item1.EmployerName" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <div class="radio-list">
                                                <label>
                                                    <input type="radio" name="EmployerName" id="EmployerName_0" value="0" @classViewReadOnly> TNB / TNB Subsidiaries
                                                </label>
                                                <label>
                                                    <input type="radio" name="EmployerName" id="EmployerName_1" value="1" @classViewReadOnly> Others <span id="SpanOtherEmployerName" class="divOtherEmployerName divOtherEmployerNameInsert divOtherEmployerNameEdit">:</span>
                                                    <input type="text" class="form-control divOtherEmployerName divOtherEmployerNameInsert divOtherEmployerNameEdit" width="150" name="OtherEmployerName" @classViewReadOnly value="@Model.Item1.EmployerName" id="OtherEmployerName">
                                                </label>
                                            </div>
                                        }

                                        <input type="hidden" class="form-control"
                                               name="HiddenOtherEmployerName" id="HiddenOtherEmployerName" value="@Model.Item1.EmployerName">
                                    </div>
                                </div>
                                <div class="form-group divSpouseEmployeeNo divSpouseEmployeeNoInsert divSpouseEmployeeNoEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Spouse Employee No.<span class="required spanSpouseEmployeeNoRequired hidden">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control"
                                               name="SpouseEmployeeNo" id="SpouseEmployeeNo" value="@Model.Item1.SpouseEmployeeNo" maxlength="8" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenSpouseEmployeeNo" id="HiddenSpouseEmployeeNo" value="@Model.Item1.SpouseEmployeeNo">
                                    </div>
                                </div>
                                <div class="form-group divJobTitle divJobTitleInsert divJobTitleEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Job Title
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control"
                                               name="JobTitle" id="JobTitle" value="@Model.Item1.JobTitle" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenJobTitle" id="HiddenJobTitle" value="@Model.Item1.JobTitle">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group divFamilyNo divFamilyNoEdit divFamilyNoInsert hidden">
                                    <label class="control-label col-md-4 ">
                                        Family No.
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control"
                                               name="FamilyNo" id="FamilyNo" value="@Model.Item1.FamilyNo" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenFamilyNo" id="HiddenFamilyNo" value="@Model.Item1.FamilyNo">
                                    </div>
                                </div>
                                <div class="form-group divRelChild divRelChildInsert divRelChildEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Rel/Child<span class="required spanRelChildRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenRelChild" id="HiddenRelChild" value="@Model.Item1.RelChild">
                                        <input type="hidden" name="RelChildCode" id="RelChildCode" value="@Model.Item1.RelChildCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="RelChildName" name="RelChildName" value="@Model.Item1.RelChild" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="RelChildName" id="RelChildName" value="@Model.Item1.RelChild" />
                                            <select tabindex="0" id="ddlRelChild" class="form-control" onchange="setTimeout(Checking,100);" @classViewReadOnly></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divChildSpouseNo divChildSpouseNoInsert divChildSpouseNoEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Child Spouse Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenChildSpouseNo" id="HiddenChildSpouseNo" value="@Model.Item1.ChildSpouseNo">
                                        <input type="hidden" name="ChildSpouseNoCode" id="ChildSpouseNoCode" value="@Model.Item1.ChildSpouseNo" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="ChildSpouseNoName" name="ChildSpouseNoName" value="" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="ChildSpouseNoName" id="ChildSpouseNoName" value="" />
                                            <select tabindex="0" id="ddlChildSpouseNo" class="form-control" @classViewReadOnly></select>
                                        }
                                        <input type="hidden" class="form-control" name="HiddenChildSpouseName" id="HiddenChildSpouseName" value="">
                                    </div>
                                </div>
                                <div class="form-group divCountryOfBirth">
                                    <label class="control-label col-md-4 ">
                                        Country of Birth
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenCountryOfBirth" id="HiddenCountryOfBirth" value="@Model.Item1.CountryOfBirth">
                                        <input type="hidden" name="CountryOfBirthCode" id="CountryOfBirthCode" value="@Model.Item1.CountryOfBirthCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="CountryOfBirthName" name="CountryOfBirthName" value="@Model.Item1.CountryOfBirth" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="CountryOfBirthName" id="CountryOfBirthName" value="@Model.Item1.CountryOfBirth" />
                                            <select tabindex="0" id="ddlCountryOfBirth" class="form-control" onchange="setTimeout(Checking, 100);" @classViewReadOnly></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divBirthPlace divBirthPlaceInsert divBirthPlaceEdit">
                                    <label class="control-label col-md-4 ">
                                        Birth Place
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" name="BirthPlace" id="BirthPlace" value="@Model.Item1.BirthPlace" MaxLength="25" @classViewReadOnly>
                                        <input type="hidden" class="form-control" name="HiddenBirthPlace" id="HiddenBirthPlace" value="@Model.Item1.BirthPlace">
                                    </div>
                                </div>
                                <div class="form-group divDateOfBirth">
                                    <label class="control-label col-md-4 ">
                                        Date of Birth <span class="required spanDateOfBirthRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="DateOfBirth" name="DateOfBirth" value="@Service.FormatDateInNumber(Model.Item1.DateOfBirth, "dd/MM/yyyy")" readonly="readonly" />
                                        }
                                        else
                                        {
                                            <div class="input-group date date-picker" id="boxDateOfBirth" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control DateOfBirth" onchange="DOBChange()" id="DateOfBirth" name="DateOfBirth" value="@Service.FormatDateInNumber(Model.Item1.DateOfBirth, "dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnDateOfBirth" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        }

                                        <input type="hidden" class="form-control" name="HiddenDateOfBirth" id="HiddenDateOfBirth" value="@Service.FormatDateInNumber(Model.Item1.DateOfBirth, "dd/MM/yyyy")" />
                                    </div>
                                </div>
                                <div class="form-group divBirthCertNo">
                                    <label class="control-label col-md-4 ">
                                        Birth Cert No.<span class="required spanBirthCertNoRequired" id="spanBirthCertNoRequired">*</span>
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <input type="text" class="form-control"
                                               name="BirthCertNo" id="BirthCertNo" value="@Model.Item1.BirthCertNo" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenBirthCertNo" id="HiddenBirthCertNo" value="@Model.Item1.BirthCertNo">
                                        <input type="hidden" class="form-control"
                                               name="HiddenBirthCertNo_Name" id="HiddenBirthCertNo_Name" value="Birth Cert No">
                                    </div>
                                </div>
                                <div class="form-group divMaritalStatus divMaritalStatusInsert divMaritalStatusEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        <span class="spanMaritalStatusLbl">Marital Status</span>
                                        <span class="required spanMaritalStatusRequired hidden">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenMaritalStatus" id="HiddenMaritalStatus" value="@Model.Item1.MaritalStatus">
                                        <input type="hidden" name="MaritalStatusCode" id="MaritalStatusCode" value="@Model.Item1.MaritalStatusCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="MaritalStatusName" name="MaritalStatusName" value="@Model.Item1.MaritalStatus" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="MaritalStatusName" id="MaritalStatusName" value="@Model.Item1.MaritalStatus" />
                                            <select tabindex="0" id="ddlMaritalStatus" class="form-control" @classViewReadOnly onchange="setTimeout(Checking,100);"></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divMaritalStatusDate divMaritalStatusDateInsert divMaritalStatusDateEdit hidden">
