@*script Submission Activity *@
<script type="text/javascript">
	function FormValidation(btn) {
		var deferred = $.Deferred();
		btn.disabled = true;
		var action = btn.innerHTML;
		if (action.indexOf("Add") > -1)
			action = "Add";

		if (action.indexOf("Update") > -1)
			action = "Edit";

		var _ValidationMsg = '';

		var EmpNo = $("#divEPM_Modal #EmployeeCode").val() + "";
		var RelationshipTypeCode = $("#divEPM_Modal #RelationshipTypeCode").val() + "";
		var FamilyName = $("#divEPM_Modal #FamilyName").val() + "";
		var InstitutionName = $("#divEPM_Modal #InstitutionName").val() + "";
		var NewICNo = $("#divEPM_Modal #NewICNo").val() + "";
		var _hdnNewICNo = $("#divEPM_Modal #HiddenNewICNo").val() + "";
		var OldICNo = $("#divEPM_Modal #OldICNo").val() + "";
		var PassportNo = $("#divEPM_Modal #PassportNo").val() + "";
		var NationalityCode = $("#divEPM_Modal #NationalityCode").val() + "";
		var BirthCertNo = $("#divEPM_Modal #BirthCertNo").val() + "";
		var SpouseEmployeeNo = $("#divEPM_Modal #SpouseEmployeeNo").val() + "";

		var _chkStudent = $('#divEPM_Modal #chkStudent').is(":checked");

		var FamilyAttachMandatory = $("#divEPM_Modal #FamilyAttachMandatory").val() + "";
		var CreateONLY = "@Create";
		var DateOfBirth = $("#divEPM_Modal #DateOfBirth").val() + "";
		var _DateOfBirthValue = ReformatDate($("#divEPM_Modal #DateOfBirth").val() + "", "Date of Birth");

		var DateOfDeath = $("#divEPM_Modal #DateOfDeath").val() + "";
		var _DateOfDeathValue = ReformatDate($("#divEPM_Modal #DateOfDeath").val() + "", "Date of Death");

		var DateOfAdoption = $("#divEPM_Modal #DateOfAdoption").val() + "";
		var _DateOfAdoptionValue = ReformatDate($("#divEPM_Modal #DateOfAdoption").val() + "", "Date of Adoption");

		var EducationEndDate = $("#divEPM_Modal #EducationEndDate").val() + "";
		var _EducationEndDateValue = ReformatDate($("#divEPM_Modal #EducationEndDate").val() + "", "Date of Education End");

		var DisabilityTypeCode = $("#divEPM_Modal #DisabilityTypeCode").val() + "";
		var DisabilityDate = $("#divEPM_Modal #DisabilityDate").val() + "";
		var _DisabilityDateValue = ReformatDate($("#divEPM_Modal #DisabilityDate").val() + "", "Date of Disability");

		var MaritalStatusCode = $("#divEPM_Modal #MaritalStatusCode").val() + "";
		var MaritalStatusDate = $("#divEPM_Modal #MaritalStatusDate").val() + "";
		var _MaritalStatusDateValue = ReformatDate($("#divEPM_Modal #MaritalStatusDate").val() + "", "Date of Marital Status");

		var RelChildCode = $("#divEPM_Modal #RelChildCode").val() + "";

		var CountTotal_Attachment = "";
		if (FamilyAttachMandatory == "true") {
			CountTotal_Attachment = $("#divEPM_Modal #CountTotal_Attachment").val() + "";
		}

		if (RelationshipTypeCode == "") {
			if (!$("#divEPM_Modal .spanRelationshipTypeRequired").hasClass("hidden")) {
				_ValidationMsg += '- Relationship Type is required.\n';
			}
		}

		if (FamilyName == "") {
			_ValidationMsg += '- Name is required.\n';
		}

		if (OldICNo != "") {
			var regex = /^[a-zA-Z0-9]+$/;
			if (!regex.test(OldICNo)) {
				// Wrong
				_ValidationMsg += '- Old IC No. is invalid.\n';
			}
		}

		if (PassportNo == "") {
			if (!$("#divEPM_Modal .spanPassportNoRequired").hasClass("hidden")) {
				_ValidationMsg += '- Passport No. is required.\n';
			}
		}

		if (NationalityCode == "") {
			if (!$("#divEPM_Modal .spanNationalityRequired").hasClass("hidden")) {
				_ValidationMsg += '- Nationality is required.\n';
			}
		}

		if (BirthCertNo == "") {
			if (!$("#divEPM_Modal .spanBirthCertNoRequired").hasClass("hidden")) {
				_ValidationMsg += '- Birth Cert No. is required.\n';
			}
		}

		if (SpouseEmployeeNo != "") {
			var re = /^[0-9]{8}$/;

			if (!re.test(SpouseEmployeeNo)) {
				// Wrong
				_ValidationMsg += '- Spouse Employee No. is invalid.\n';
			}
		}
		else {
			if (!$("#divEPM_Modal .spanSpouseEmployeeNoRequired").hasClass("hidden")) {
				_ValidationMsg += '- Spouse Employee No. is required.\n';
			}
		}

		if (DateOfBirth == "") {
			if (!$("#divEPM_Modal .spanDateOfBirthRequired").hasClass("hidden")) {
				_ValidationMsg += '- Date of Birth is required.\n';
			}
		}
		else if (_DateOfBirthValue.toUpperCase() == "ERROR") {
			_ValidationMsg += '- Invalid Date of Birth Format (dd/MM/yyyy).\n';
		}

		if (DateOfDeath == "") {
			//if (!$(".spanDateOfDeathRequired").hasClass("hidden")) {
			//    _ValidationMsg += '- Date of Death is required.\n';
			//}
		}
		else if (_DateOfDeathValue.toUpperCase() == "ERROR") {
			_ValidationMsg += '- Invalid Date of Death Format (dd/MM/yyyy).\n';
		}

		if (DateOfAdoption == "") {
			if (!$(".spanDateOfAdoptionRequired").hasClass("hidden")) {
			    _ValidationMsg += '- Date of Adoption is required.\n';
			}
		}
		else if (_DateOfAdoptionValue.toUpperCase() == "ERROR") {
			_ValidationMsg += '- Invalid Date of Adoption Format (dd/MM/yyyy).\n';
		}

		//Student checkbox is checked, then education end date is mandatory
		if (_chkStudent) {
			if (EducationEndDate == "") {
				if (!$("#divEPM_Modal .spanEducationEndDateRequired").hasClass("hidden")) {
					_ValidationMsg += '- Education End Date is required.\n';
				}
			}
			else if (_EducationEndDateValue.toUpperCase() == "ERROR") {
				_ValidationMsg += '- Invalid Date of Education End Format (dd/MM/yyyy).\n';
			}
		}
		else {
			$("#divEPM_Modal #EducationEndDate").val("");
			$("#divEPM_Modal #EducationEndDate").val("");
		}

		if (InstitutionName == "") {
			if (!$("#divEPM_Modal .spanInstitutionNameRequired").hasClass("hidden")) {
				_ValidationMsg += '- Institution Name is required.\n';
			}
		}

		if (DisabilityTypeCode == "") {
			if (!$("#divEPM_Modal .spanDisabilityTypeRequired").hasClass("hidden")) {
				_ValidationMsg += '- Disability Type is required.\n';
			}
		}

		if (DisabilityDate == "") {
			if (!$("#divEPM_Modal .spanDisabilityDateRequired").hasClass("hidden")) {
				_ValidationMsg += '- Disability Date is required.\n';
			}
		}
		else if (_DisabilityDateValue.toUpperCase() == "ERROR") {
			_ValidationMsg += '- Invalid Date of Disability Format (dd/MM/yyyy).\n';
		}

		if (MaritalStatusCode == "") {
			if (!$("#divEPM_Modal .spanMaritalStatusRequired").hasClass("hidden")) {
				_ValidationMsg += '- Marital Status is required.\n';
			}
		}

		if ((MaritalStatusDate == "" && RelationshipTypeCode != "2" && !$("#divEPM_Modal .spanMaritalStatusDateRequired").hasClass("hidden")) ||
			(MaritalStatusCode == "1" && MaritalStatusDate == "" && !$("#divEPM_Modal .spanMaritalStatusDateRequired").hasClass("hidden"))) {
			_ValidationMsg += '- Marital Status Date is required.\n';
		}
		else if (MaritalStatusCode == "1" && MaritalStatusDate != "" && _MaritalStatusDateValue.toUpperCase() != "ERROR" && RelationshipTypeCode == "2") {
			$('#divEPM_Modal #chkMarried').prop("checked", true);
		}
		else if (_MaritalStatusDateValue.toUpperCase() == "ERROR") {
			_ValidationMsg += '- Invalid Marital Status Date Format (dd/MM/yyyy).\n';
		}
		else {
			$('#divEPM_Modal #chkMarried').prop("checked", false);
		}

		if (DateOfBirth != "" && NewICNo != "" && NewICNo.length == 12) {
			var regex = /^[0-9]{12}$/;

			if (regex.test(NewICNo)) {
				var splitDOB = DateOfBirth.split('/');
				var IC_DOB = NewICNo.substring(0, 6);
				var DOB_IC_Format = splitDOB[2].substring(2, 4) + splitDOB[1] + splitDOB[0];

				if (DOB_IC_Format != IC_DOB) {
					_ValidationMsg += '- New IC No and Date Of Birth are not match.\n';
				}
			}
		}

		if (RelChildCode == "") {
			if (!$("#divEPM_Modal .spanRelChildRequired").hasClass("hidden")) {
				_ValidationMsg += '- Rel/Child is required.\n';
			}
		}

		if (FamilyAttachMandatory.toUpperCase() == "TRUE" && CreateONLY.toUpperCase() == "TRUE") {
			if (CountTotal_Attachment == "0") {
				_ValidationMsg += '- Attachment is required.\n';
			}
		}

		var valid = false;

		if (NewICNo == "") {
			if (!$("#divEPM_Modal .spanNewICNoRequired").hasClass("hidden")) {
				_ValidationMsg += '- New IC No. is required.\n';
			}
		}
		else {
			var regex = /^[0-9]{12}$/;
			if (!regex.test(NewICNo)) {
				_ValidationMsg += '- New IC No. is invalid.\n';
				//deferred.reject();
			}
			else {
				valid = true;
				//deferred.resolve();
			}
		}

		ValidateIsICExist(EmpNo, NewICNo, valid, action).fail(
			function () {
				_ValidationMsg += '- New IC No. is existed.\n';
				alert(_ValidationMsg);
				deferred.reject();
			}).done(
			function () {
				if (_ValidationMsg != "") {
					alert(_ValidationMsg);
					deferred.reject();
				}
				else {
					deferred.resolve();
					$("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application. If you want to make changes, click Close.');
					$("#divLoading2").show();
					$("#ConfirmUpdate").modal('show');
				}
