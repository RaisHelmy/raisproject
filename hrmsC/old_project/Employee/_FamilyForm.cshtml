                //check is hidden
                if (!$("#divEPM_Modal #OtherEmployerName").hasClass("hidden")) {
                    //if not hide it
                    $("#divEPM_Modal .divOtherEmployerName").addClass("hidden");
                }
            }
            else if (this.value == '1') {
                //check is hidden
                if ($("#divEPM_Modal #OtherEmployerName").hasClass("hidden")) {
                    //if is hidden show it
                    $("#divEPM_Modal .divOtherEmployerName").removeClass("hidden");
                }
            }
            Checking('');
