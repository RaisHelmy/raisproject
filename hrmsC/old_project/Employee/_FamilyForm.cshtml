                @*var url = '@Url.Action("Profile", "Employee")?RequestNo=' + EmployeeCode + '&Status=Submitted';
                window.location.href = url;*@
                location.reload();
                break;
            case "EDIT":
                //Response.Redirect("/Employee/_layouts/tnbess/Employee/Confirmation.aspx?RequestNo=" + requestNo + "&Status=" + Employee.ActivityAction.Submitted);
                @*var url = '@Url.Action("Profile", "Employee")?RequestNo=' + EmployeeCode + '&Status=Submitted';
                window.location.href = url;*@
                location.reload();
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }

