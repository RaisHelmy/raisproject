	function GetFamilyFormSetting(HiddenRelationshipTypeValue, HiddenRelationshipTypeText, HiddenRelationshipChildValue, HiddenGenderValue, DateOfBirth, HiddenNationalityValue, HiddenStudentValue,
		HiddenMarriedValue, HiddenHandicappedValue, HiddenEmployerNameValue, HiddenOtherEmployerName, HiddenEmployedValue, ReadOnly, ddlType) {
        var Category = "@EmployeeCategory_Family" + "";
        var RequestID = "";
        var FormAction = $("#divEPM_Modal #FormAction").val();
        var divMode = "@divMode";
        var PreMaritalStatusValue = $("#divEPM_Modal #MaritalStatusCode").val();
		var PreMaritalStatusName = "";

		var HiddenMedicalValue = "false";
		if ('@Model.Item1.EligibleForMedical.HasValue' == "True") {
			HiddenMedicalValue = '@Model.Item1.EligibleForMedical';
			HiddenMedicalValue = HiddenMedicalValue.toLowerCase();
		}

		var url = window.location.href;
		var TaskID = "";

		if (url.indexOf("TaskID") >= 0)
			TaskID = "1";

        var _DateOfBirthValue = ReformatDate($("#DateOfBirth").val() + "", "Date of Birth");

        if (_DateOfBirthValue.toUpperCase() == "ERROR")
        {
            alert(_DateOfBirthValue);
        }
        else
		{
			$.get('@Url.Action("GetFamilyFormSetting", "Employee")?HiddenRelationshipTypeValue=' + HiddenRelationshipTypeValue
								   + '&HiddenRelationshipChildValue=' + HiddenRelationshipChildValue
                                   + '&HiddenGenderValue=' + HiddenGenderValue
                                   + '&DateOfBirth=' + DateOfBirth
                                   + '&HiddenNationalityValue=' + HiddenNationalityValue
                                   + '&HiddenStudentValue=' + HiddenStudentValue
                                   + '&HiddenMarriedValue=' + HiddenMarriedValue
                                   + '&HiddenHandicappedValue=' + HiddenHandicappedValue
                                   + '&HiddenEmployerNameValue=' + HiddenEmployerNameValue
                                   + '&HiddenOtherEmployerName=' + HiddenOtherEmployerName
								   + '&HiddenEmployedValue=' + HiddenEmployedValue
								   + '&HiddenMedicalValue=' + HiddenMedicalValue
                                   + '&PreMaritalStatusValue=' + PreMaritalStatusValue
                                   + '&PreMaritalStatusName=' + PreMaritalStatusName
								   + '&ReadOnly=' + ReadOnly
								   + '&TaskID=' + TaskID,
				function (result) {
                   Setting_FieldVisible = result.FieldVisible;
                   Setting_FieldEnable = result.FieldEnable;
                   Setting_FieldChecked = result.FieldChecked;
                   Setting_FieldValue = result.FieldValue;
                   var ReadOnly = "@ReadOnly";

                   PopulateSetting(divMode, "#divEPM_Modal", "#SettingFormChange", Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue);
                   //PopulateSetting(divMode, divMain, LogDiv, Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue)

                   if (ReadOnly.toUpperCase() == "FALSE") {
					   if (ddlType == 'attachmentSetting') {
                           SearchGet_AttachmentInfo(Category, HiddenRelationshipTypeText, RequestID);
                       }
                   }
               });
        }
	}

    function ReformatDate(edate, Type) {
        try {
            if (edate.length > 0)
            {
                var myDate = $.datepicker.parseDate("dd/mm/yy", edate);
                var d = myDate.getDate();
                var m = myDate.getMonth();
                m += 1;
                var y = myDate.getFullYear();

                var newdate = (y + "-" + m + "-" + d);
                return newdate;
            }
            return "";
        }
        catch (e) {
            var Error = "ERROR";
            //alert('Invalid Date Format ('+Type+')' + e);
            //alert(e);
            return Error;
        }
    }
</script>

