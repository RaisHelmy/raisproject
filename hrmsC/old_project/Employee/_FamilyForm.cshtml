@*script Sub Function -->Get Required Attachment *@
<script type="text/javascript">
	function GetRequiredAttachment() {
		var BirtCertNo = $("#divEPM_Modal #BirthCertNo").val() + "";
		var NewICNo = $("#divEPM_Modal #NewICNo").val() + "";
		var IsStudent = $('#divEPM_Modal #chkStudent').is(":checked") + "";
		var IsDisabled = $('#divEPM_Modal #chkHandicapped').is(":checked") + "";
		var IsAdopted = $("#ddlRelChild option:selected").val() + "" == '02' ? "true" : "false";
		var MaritalStatus = $('#ddlMaritalStatus option:selected').val() + "";
		var MaritalStatusDate = $('#divEPM_Modal #MaritalStatusDate').val() + "";
		var Category = "@EmployeeCategory_Family" + "";
		var Criteria = $("#divEPM_Modal #RelationshipTypeName").val() + "";

		$.ajax({
			type: "POST",
			url: "@Url.Action("GetRequiredAttachmentOnFieldChanged", "Employee")?Category=" + Category
				+ "&Criteria=" + Criteria
				+ "&BirthCertNo=" + BirtCertNo
				+ "&NewICNo=" + NewICNo
				+ "&IsStudent=" + IsStudent
				+ "&IsDisabled=" + IsDisabled
				+ "&IsAdopted=" + IsAdopted
				+ "&MaritalStatus=" + MaritalStatus
				+ "&MaritalStatusDate=" + MaritalStatusDate,
			success: function (result) {
				if (result != "")
					$(".divAttachmentRequired").removeClass("hidden");
				else
					$(".divAttachmentRequired").addClass("hidden");

				$(".DocumentsRequired").empty().append(result);
			},
			error: function (err) {
				console.log(err);
				alert("Error in the ajax call.");
			}
		});
	}
</script>

