@using ESS.Employee;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Retirement Letter Listing";

    DateTime d1a = DateTime.Now.AddYears(-20);
    DateTime d1b = DateTime.Now.AddYears(20);
    string dtRetFrom = d1a.ToString("dd MMM yyyy");
    string dtRetTo = d1b.ToString("dd MMM yyyy");

    DateTime d2a = DateTime.Now.AddYears(-20);
    DateTime d2b = DateTime.Now.AddYears(20);
    string dtRelFrom = d2a.ToString("dd MMM yyyy");
    string dtRelTo = d2b.ToString("dd MMM yyyy");

    List<ESS.Core.DropDownObject> StatusDDL = ViewBag.StatusDDL;

    DateTime checkRetirementDateFrom = DateTime.Now.AddDays(-365);
    DateTime checkRetirementDateTo = DateTime.Now.AddDays(365).AddMonths(1);

    DateTime presetRetirementDateFrom = new DateTime(checkRetirementDateFrom.Year, checkRetirementDateFrom.Month, 1);
    DateTime presetRetirementDateTo = new DateTime(checkRetirementDateTo.Year, checkRetirementDateTo.Month, 1).AddDays(-1);

    DateTime checkReleaseDateFrom = DateTime.Now.AddDays(-365);
    DateTime checkReleaseDateTo = DateTime.Now.AddDays(365).AddMonths(1);

    DateTime presetReleaseDateFrom = new DateTime(checkReleaseDateFrom.Year, checkReleaseDateFrom.Month, 1);
    DateTime presetReleaseDateTo = new DateTime(checkReleaseDateTo.Year, checkReleaseDateTo.Month, 1).AddDays(-1);
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Retirement Letter Listing<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" id="Employee" name="Employee" placeholder="Name or ID" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Retirement Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divRetirementDateFrom" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control" id="RetirementDateFrom" name="RetirementDateFrom" value="@Service.FormatDateInNumber(presetRetirementDateFrom, "dd/MM/yyyy")" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Retirement Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divRetirementDateTo" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control" id="RetirementDateTo" name="RetirementDateTo" value="@Service.FormatDateInNumber(presetRetirementDateTo, "dd/MM/yyyy")" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Release Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divReleaseDateFrom" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control" id="ReleaseDateFrom" name="ReleaseDateFrom" value="@Service.FormatDateInNumber(presetReleaseDateFrom, "dd/MM/yyyy")" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Release Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divReleaseDateTo" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control" id="ReleaseDateTo" name="ReleaseDateTo" value="@Service.FormatDateInNumber(presetReleaseDateTo, "dd/MM/yyyy")" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <input type="hidden" name="StatusCode" id="StatusCode" value="" />
                        <input type="hidden" name="StatusName" id="StatusName" value="" />
                        @Html.DropDownList("ddlStatus", new SelectList(StatusDDL, "Value", "Text"), new { @id = "ddlStatus", @class = "bs-select form-control" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>

<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
    top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
    opacity: .8; filter: alpha(opacity=70); display:none;">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

    </p>
</div>

@*script Main Function *@
<script type="text/javascript">
    function LoadFormConfiguration() {

        $('#divRetirementDateFrom').datepicker('setStartDate', '@dtRetFrom');
        $('#divRetirementDateFrom').datepicker('setEndDate', '@dtRetTo');

        $('#divRetirementDateTo').datepicker('setStartDate', '@dtRetFrom');
        $('#divRetirementDateTo').datepicker('setEndDate', '@dtRetTo');

        $("#divRetirementDateFrom").datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        }).on("input", function (e) {
            try {
                var dateParse = $.datepicker.parseDate("dd/mm/yy", $("#RetirementDateFrom").val());
            }
            catch (e) { }
            if (dateParse) {
                Checking('');
            }
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());

            minDate.setDate(minDate.getDate() + 1);
            $('#divRetirementDateTo').datepicker('setStartDate', minDate);
        });

        $("#divRetirementDateTo").datepicker({
            autoclose: true,
        })
            .on('changeDate', function (selected) {
                var minDate = new Date(selected.date.valueOf());
                minDate.setDate(minDate.getDate() - 1);
                $('#divRetirementDateFrom').datepicker('setEndDate', minDate);
            });

        $("#RetirementDateFrom").on("blur", function (e) {
            if ($('#RetirementDateFrom').val() == "") {
                $('#divRetirementDateTo').datepicker('setStartDate', '@dtRetFrom');
            }

        });

        $("#RetirementDateTo").on("blur", function (e) {
            if ($('#RetirementDateTo').val() == "") {
                $('#divRetirementDateFrom').datepicker('setEndDate', '@dtRetTo');
            }

        });

        $('#divReleaseDateFrom').datepicker('setStartDate', '@dtRetFrom');
        $('#divReleaseDateFrom').datepicker('setEndDate', '@dtRetTo');

        $('#divReleaseDateTo').datepicker('setStartDate', '@dtRetFrom');
        $('#divReleaseDateTo').datepicker('setEndDate', '@dtRetTo');

        $("#divReleaseDateFrom").datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        }).on("input", function (e) {
            try {
                var dateParse = $.datepicker.parseDate("dd/mm/yy", $("#ReleaseDateFrom").val());
            }
            catch (e) { }
            if (dateParse) {
                Checking('');
            }
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());

            minDate.setDate(minDate.getDate() + 1);
            $('#divReleaseDateTo').datepicker('setStartDate', minDate);
        });

        $("#divReleaseDateTo").datepicker({
            autoclose: true,
        })
            .on('changeDate', function (selected) {
                var minDate = new Date(selected.date.valueOf());
                minDate.setDate(minDate.getDate() - 1);
                $('#divReleaseDateFrom').datepicker('setEndDate', minDate);
            });

        $("#ReleaseDateFrom").on("blur", function (e) {
            if ($('#ReleaseDateFrom').val() == "") {
                $('#divReleaseDateTo').datepicker('setStartDate', '@dtRetFrom');
            }

        });

        $("#ReleaseDateTo").on("blur", function (e) {
            if ($('#ReleaseDateTo').val() == "") {
                $('#divReleaseDateFrom').datepicker('setEndDate', '@dtRetTo');
            }

        });
    }
    function LoadFormOnChange() {

        $('#ddlStatus').change(function () {
            // if changed to, for example, the last option, then
            // $(this).find('option:selected').text() == D
            // $(this).val() == 4
            // get whatever value you want into a variable
            var HiddenStatusValue = $("#ddlStatus option:selected").val() + "";
            var HiddenStatusText = $("#ddlStatus option:selected").text() + "";

            // and update the hidden input's value
            $('#StatusName').val(HiddenStatusText);
            $('#StatusCode').val(HiddenStatusValue);
        });
    }
</script>

@*script Retrieve DDL AJAX *@
<script type="text/javascript">

    function RetrieveDepartmentOptions() {
        var CompanyCode = $("#DivisionCode").val() + "";
        var url = '@Url.Action("GetDepartmentOptions", "Employee")?CompanyCode=' + CompanyCode;
        $.get(url, function (result) {
            Department = result;
            PopulateDepartment();
        });
    }

    function RetrieveUnitSectionOptions() {
        var DepartmentCode = $("#DepartmentCode").val() + "";
        var url = '@Url.Action("GetUnitSectionOptions", "Employee")?DepartmentCode=' + DepartmentCode;
        $.get(url, function (result) {
            UnitSection = result;
            PopulateUnitSection();
        });
    }

</script>

@*script Clear Filter and get listing *@
<script type="text/javascript">
    function ReformatDate(edate, Type) {
        try {
            if (edate.length > 0) {
                var myDate = $.datepicker.parseDate("dd/mm/yy", edate);
                var d = myDate.getDate();
                var m = myDate.getMonth();
                m += 1;
                var y = myDate.getFullYear();

                var newdate = (y + "-" + m + "-" + d);
                return newdate;
            }
            return "";
        }

        catch (e) {
            var Error = "ERROR";
            //alert('Invalid Date Format ('+Type+')' + e);
            //alert(e);
            return Error;
        }

    }

    function SearchListing() {

        var _Employee = $('#Employee').val();
        var _Status = $('#StatusCode').val();
        var _RetirementDateFrom = $('#RetirementDateFrom').val();
        var _RetirementDateTo = $('#RetirementDateTo').val();
        var _ReleaseDateFrom = $('#ReleaseDateFrom').val();
        var _ReleaseDateTo = $('#ReleaseDateTo').val();

        var form = {
            Employee: _Employee,
            Status: _Status,
            RetirementDateFrom: _RetirementDateFrom,
            RetirementDateTo: _RetirementDateTo,
            ReleaseDateFrom: _ReleaseDateFrom,
            ReleaseDateTo: _ReleaseDateTo
        };

        $("#divLoading").show();

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Employee/_RetirementLetterListingResult")',
            cache: false,
            dataType: "html",
            data: form ,
            success: function (content) {
                $("#divLoading").hide();
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
                $("#divLoading").hide();
            }
        });
    }

    function ClearFilter() {
        $('#Employee').val("");
        $('#ddlStatus').val("").change();
        $('#RetirementDateFrom').val("");
        $('#RetirementDateTo').val("");
        $('#ReleaseDateFrom').val("");
        $('#ReleaseDateTo').val("");
        SearchListing();
    }
</script>

@*script Load Form *@
<script type="text/javascript">
    jQuery(document).ready(function () {

        LoadFormConfiguration();
        LoadFormOnChange();

        SearchListing();
    });

</script>