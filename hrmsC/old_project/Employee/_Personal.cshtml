@*@model ESS.Employee.Models.PersonalInfo*@
@model Tuple<ESS.Employee.Models.PersonalInfo, ESS.Employee.Models.Setting>
@using ESS.Employee
@{
    Layout = null;
    string ID = "";
    string module = "Personal";
    string module2 = "ProfileImage";

    bool runFieldVisible = false;
    if (Model.Item2 != null)
    {
        runFieldVisible = true;
    }

    bool hasProfileImg = false;
    //Obtain from Index
    if (string.IsNullOrEmpty(ViewBag.Base64String + ""))
    {
        hasProfileImg = true;
        //< img src = "http://localhost:49773/Assets/img/fb-profile.jpg" />
        ViewBag.Base64String = Url.Action("../Assets/img/fb-profile.jpg");
    }

    #region
    Layout = null;
    bool ReadOnly = false;
    bool EditReadOnly = false;
    bool Create = false;

    string classViewReadOnly = "";
    string EmployeeCategory_Personal = ViewBag.EmployeeCategory_Personal + "";

    string Mode = ViewBag.Mode + "";
    string divMode = "";
    if (string.Equals(Mode, "View", StringComparison.OrdinalIgnoreCase))
    {
        ReadOnly = true;
        classViewReadOnly = "disabled = 'disabled' ";
        divMode = "";
    }
    else if (String.Equals(Mode, "Edit", StringComparison.OrdinalIgnoreCase))
    {
        ReadOnly = false;
        EditReadOnly = true;
        classViewReadOnly = "";
        divMode = "Edit";
    }
    else
    {
        Create = true;
        divMode = "Insert";
    }

    DateTime setdateEnd = DateTime.Now;
    string dtStrEnd = setdateEnd.ToString("dd/MM/yyyy");
    #endregion
}
<style>
     /*.boxFormViewGeneralInfo_Photo2 img{
    display: block;
    margin: 0 auto;
    }*/
    .divProfileImage{
    text-align: center;
    }
    .boxFormViewGeneralInfo_Photo
    {
        padding: 7px;
        width: 150px;
        border: 1px solid #ffffff;
        /*border-radius: 50% !important;*/
        background-size: cover;
        margin:0 auto;
    }

    .imgProfile
    {
        /*background-image: url("/_layouts/15/ESS/Assets/img/fb-profile.jpg") !important; */
        /*border-radius: 50% !important;*/
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
    }

    .left {
        float: left;
        width: 50%;
    }

    .clearfix::after {
        clear: both;
        display: table;
    }

    .right {
        float: right;
        width: 50%;
    }

	@@media only screen and (max-width: 768px) {
		.container {
			flex-direction: column-reverse;
		}

		.left, .right {
