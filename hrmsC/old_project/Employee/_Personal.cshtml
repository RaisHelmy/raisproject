        var i = 0;
        ddlReligion.empty();
        ddlReligion.append('<option value="" selected="selected"> - Please Select - </option>');
        for (i = 0; i < Religion.length; i++) {
            ddlReligion
            ddlReligion.append('<option value="' + Religion[i].Value + '">' + Religion[i].Text + '</option>');
        }

        var selectedReligionCode = $('input[name="ReligionCode"]');
