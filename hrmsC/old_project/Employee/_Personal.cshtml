<script type="text/javascript">
    function FormValidation(btn) {
        btn.disabled = true;
        var _ValidationMsg = '';
        var TitleCode = $("#divEPM_Modal #TitleCode").val() + "";
        var MaritalStatusCode = $("#divEPM_Modal #MaritalStatusCode").val() + "";

        var MaritalStatusName = $("#divEPM_Modal #MaritalStatusName").val() + "";
        var HiddenMaritalStatus = $("#divEPM_Modal #HiddenMaritalStatus").val() + "";

        var PersonalAttachMandatory = $("#divEPM_Modal #PersonalAttachMandatory").val() + "";
        var CreateONLY = "@Create";

        var CountTotal_Attachment = "";
        if (PersonalAttachMandatory == "true") {
            CountTotal_Attachment = $("#divEPM_Modal #CountTotal_Attachment").val() + "";
        }
        // SubAttachment/_AttachmentListing

        if (TitleCode == "") {
            _ValidationMsg += '- Title is required.\n';
        }

        if (MaritalStatusCode == "") {
            _ValidationMsg += '- Marital Status is required.\n';
        }
        else
        {
            if (MaritalStatusName.toUpperCase() != HiddenMaritalStatus.toUpperCase()) {
                alert('Marital Status is changed, please update your Family Info.');
            }
        }

        //Validate upon Submission Form
        //if (PersonalAttachMandatory.toUpperCase() == "TRUE" && CreateONLY.toUpperCase() == "TRUE") {
        //    if (CountTotal_Attachment == "0") {
        //        _ValidationMsg += '- Attachment is required.\n';
        //    }
        //}

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            $("#ConfirmUpdate .modal-body .well").html('Clicking Update will submit this application. If you want to make changes, click Close.');
            $("#divLoading2").show();
            $("#ConfirmUpdate").modal('show');
        }
        btn.disabled = false;
    }

	function ConfirmAction_Personal(btn, FormAction, RequestID) {
        //at index page
        var _EmployeeID = $("#divEPM_Modal #EmployeeID").val() + "";
        var _EmployeeCode = $("#divEPM_Modal #EmployeeCode").val() + "";

        var _EmployeeName = $("#divEPM_Modal #HiddenEmployeeName").val() + "";
        var _NewIC = $("#divEPM_Modal #HiddenNewICNo").val() + "";
        var _OldIC = $("#divEPM_Modal #HiddenOldICNo").val() + "";
        var _Bumiputera = $("#divEPM_Modal #HiddenBumiputera").val() + "";
        var _TitleSelectedValue = $("#divEPM_Modal #TitleCode").val() + "";
        var _TitleSelectedText = $("#divEPM_Modal #TitleName").val() + "";
        var _Passport = $("#divEPM_Modal #PassportNo").val() + "";
        var _ReligionSelectedValue = $("#divEPM_Modal #ReligionCode").val() + "";
        var _ReligionSelectedText = $("#divEPM_Modal #ReligionName").val() + "";
        var _MaritalStatusSelectedValue = $("#divEPM_Modal #MaritalStatusCode").val() + "";
        var _MaritalStatusSelectedText = $("#divEPM_Modal #MaritalStatusName").val() + "";
        var _MaritalStatusDateText = $("#divEPM_Modal #MaritalStatusDate").val() + "";
        var _MaritalStatusDateValue = ReformatDate($("#divEPM_Modal #MaritalStatusDate").val() + "", "Date of Marital Status");

        var _PersonalAttachMandatory = $("#divEPM_Modal #PersonalAttachMandatory").val() + "";
        var _AttachmentSessionName = $("#divEPM_Modal #AttachmentSessionName").val() + "";
        var _AttachmentSourceType = $("#divEPM_Modal #AttachmentSourceType").val() + "";
        var _AttachmentCategory = "@EmployeeCategory_Personal" + "";
        var _Comment = $("#divEPM_Modal #Comment").val() + "";
        var _createdBy = $("#divEPM_Modal #ActionerID").val() + "";

        var _HiddenDateOfBirth = $("#divEPM_Modal #HiddenDateOfBirth").val() + "";
        var _HiddenGender = $("#divEPM_Modal #HiddenGender").val() + "";
        var _HiddenNationality = $("#divEPM_Modal #HiddenNationality").val() + "";
        var _HiddenRace = $("#divEPM_Modal #HiddenRace").val() + "";
        var _HiddenTitle = $("#divEPM_Modal #HiddenTitle").val() + "";
        var _HiddenPassport = $("#divEPM_Modal #HiddenPassportNo").val() + "";
        var _HiddenReligion = $("#divEPM_Modal #HiddenReligion").val() + "";
        var _HiddenMaritalStatus = $("#divEPM_Modal #HiddenMaritalStatus").val() + "";
        var _HiddenMaritalStatusDate = $("#divEPM_Modal #HiddenMaritalStatusDate").val() + "";

		var url = window.location.href;
		var TaskID = "";

		if (url.indexOf("TaskID") >= 0)
			TaskID = "1";

		if (RequestID == undefined) {
			RequestID = "";
		}

        var Url = "";

		if (FormAction.toUpperCase() == "EDIT") {
            var form = {
                EmployeeID: _EmployeeID,
                EmployeeCode: _EmployeeCode,
                EmployeeName: _EmployeeName,
                NewIC: _NewIC,
                OldIC: _OldIC,
                Bumiputera: _Bumiputera,
                TitleSelectedValue: _TitleSelectedValue,
                TitleSelectedText: _TitleSelectedText,
                Passport: _Passport,
                ReligionSelectedValue: _ReligionSelectedValue,
                ReligionSelectedText: _ReligionSelectedText,
                MaritalStatusSelectedValue: _MaritalStatusSelectedValue,
                MaritalStatusSelectedText: _MaritalStatusSelectedText,
                MaritalStatusDateValue: _MaritalStatusDateValue,
                MaritalStatusDateText: _MaritalStatusDateText,
                PersonalAttachMandatory: _PersonalAttachMandatory,
                AttachmentSessionName: _AttachmentSessionName,
                AttachmentSourceType: _AttachmentSourceType,
                AttachmentCategory: _AttachmentCategory,
                Comment: _Comment,
                createdBy: _createdBy,
                HiddenDateOfBirth: _HiddenDateOfBirth,
                HiddenGender: _HiddenGender,
                HiddenNationality: _HiddenNationality,
                HiddenRace: _HiddenRace,
                HiddenTitle: _HiddenTitle,
                HiddenPassport: _HiddenPassport,
                HiddenReligion: _HiddenReligion,
                HiddenMaritalStatus: _HiddenMaritalStatus,
				HiddenMaritalStatusDate: _HiddenMaritalStatusDate,
				RequestID: RequestID,
				TaskID: TaskID
            };
			console.log(form);

			if (RequestID)
				ResultMsg = "Personal Info successfully updated.";
			else
				ResultMsg = "The request (Edit Personal Information) has been successfully submitted.";

			Url = '@Url.Content("~/Employee/UpdatePersonalForm")';
        }
        $("#divLoading").show();
        if ($('#divLoading').is(':visible')) {
            $.ajax({
                type: "POST",
                url: Url,
                cache: false,
                async: false,
                dataType: "json",
                data: form,
				success: function (result) {

                    if (result.Success) {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
						$("#divLoading2").show();

						if (!RequestID)
							ResultMsg += "<br/><br/>Request No: <label class='refno'>" + result.RequestNo + "</label>";

                        $(".Success-body .well").html(ResultMsg);
                        $("#SuccessSubmit").modal();

                        $("#btnOK").click(function () { RedirectTo(FormAction.toUpperCase()); });
                    }
                    else {
                        var method = result.Method;
                        var ErrorMsg = result.ErrorMsg;
                        var HiddenAttachment = $("#divEPM_Modal #HiddenPersonalAttachMandatory").val();

                        if (method.toUpperCase() == "ALERT")
                        {
                            $("#ConfirmUpdate").modal('toggle');
                            $("#divLoading").hide();
                            $("#divLoading2").hide();
                            btn.disabled = false;
                            //ensure value is reset
                            $("#divEPM_Modal #PersonalAttachMandatory").val(HiddenAttachment);
                            alert(ErrorMsg);
                        }
                        else
                        {
                            var txt;
                            if (confirm(ErrorMsg) == true) {
                                $("#divEPM_Modal #PersonalAttachMandatory").val("False");
                                ConfirmAction_Personal(btn, FormAction);
                            } else {
                                //ensure value is reset
                                $("#divEPM_Modal #PersonalAttachMandatory").val(HiddenAttachment);

                                $("#ConfirmUpdate").modal('toggle');
                                $("#divLoading").hide();
                                $("#divLoading2").hide();
                                btn.disabled = false;
                            }
                        }
                    }
                },
                error: function (e) {

                }
            });
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "INSERT":
                location.reload();
                break;
            case "EDIT":
                location.reload();
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }
</script>

