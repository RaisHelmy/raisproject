        var checkSelectedReligionCode = "";
        // Check if has previous value available in DDL
        $('#divEPM_Modal #ddlReligion option').each(function () {
            if (this.value == selectedReligionCode.val()) {
                checkSelectedReligionCode = selectedReligionCode.val();
                return false;
            }
        });
        ddlReligion.val(checkSelectedReligionCode).change();

        //$('#divEPM_Modal #ddlReligion').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});
    }

