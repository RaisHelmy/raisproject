@*script Main Function *@
<script type="text/javascript">
        function LoadFormConfiguration()
        {
            $("#divEPM_Modal #AttachmentSessionName").val("@ViewBag.AttachmentSessionName");
            $("#divEPM_Modal #AttachmentSourceType").val("@ViewBag.AttachmentSourceType");

            //$('#divEPM_Modal #ddlTitle').select2({
            //    showSearchInput: false,
            //    minimumResultsForSearch: -1
            //});

            //$('#divEPM_Modal #ddlReligion').select2({
            //    showSearchInput: false,
            //    minimumResultsForSearch: -1
            //});

            //$('#divEPM_Modal #ddlMaritalStatus').select2({
            //    showSearchInput: false,
            //    minimumResultsForSearch: -1
            //});

            @*$('#divEPM_Modal #boxMaritalStatusDate').datepicker('setEndDate', '@dtStrEnd');*@
            //may
            $("#divEPM_Modal #MaritalStatusDate").datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                endDate: "@dtStrEnd"
            });

            @Html.Raw("RetrieveTitleOptions();");

            @Html.Raw("RetrieveReligionOptions();");
            @Html.Raw("RetrieveMaritalStatusOptions();");

            var Category = "@EmployeeCategory_Personal" + "";
            var RequestID = "";
            var Criteria = "";
            //function SearchGet_AttachmentInfo(Category, "", RequestID)
            SearchGet_AttachmentInfo(Category, Criteria, RequestID);
        }

        function LoadFormOnChange() {
            $('#divEPM_Modal #ddlTitle').change(function () {
                // if changed to, for example, the last option, then
                // $(this).find('option:selected').text() == D
                // $(this).val() == 4
                // get whatever value you want into a variable
                var HiddenTitleValue = $("#divEPM_Modal #ddlTitle option:selected").val() + "";
                var HiddenTitleText = $("#divEPM_Modal #ddlTitle option:selected").text() + "";

                // and update the hidden input's value
                $('#divEPM_Modal #TitleName').val(HiddenTitleText);
                $('#divEPM_Modal #TitleCode').val(HiddenTitleValue);
                $('#divEPM_Modal #_getTitleName').val(HiddenTitleText);
                $('#divEPM_Modal #_getTitleCode').val(HiddenTitleValue);
            });

            $('#divEPM_Modal #ddlReligion').change(function () {
                // if changed to, for example, the last option, then
                // $(this).find('option:selected').text() == D
                // $(this).val() == 4
                // get whatever value you want into a variable
                var HiddenReligionValue = $("#divEPM_Modal #ddlReligion option:selected").val() + "";
                var HiddenReligionText = $("#divEPM_Modal #ddlReligion option:selected").text() + "";

                // and update the hidden input's value
                $('#divEPM_Modal #ReligionName').val(HiddenReligionText);
                $('#divEPM_Modal #ReligionCode').val(HiddenReligionValue);
            });

            $('#divEPM_Modal #ddlMaritalStatus').change(function () {
                // if changed to, for example, the last option, then
                // $(this).find('option:selected').text() == D
                // $(this).val() == 4
                // get whatever value you want into a variable
                var HiddenMaritalStatusValue = $("#divEPM_Modal #ddlMaritalStatus option:selected").val() + "";
                var HiddenMaritalStatusText = $("#divEPM_Modal #ddlMaritalStatus option:selected").text() + "";

                // and update the hidden input's value
                $('#divEPM_Modal #MaritalStatusName').val(HiddenMaritalStatusText);
                $('#divEPM_Modal #MaritalStatusCode').val(HiddenMaritalStatusValue);
            });
        }
</script>

@*script AJAX DDL -->Get DDL Value *@
<script type="text/javascript">
    function RetrieveTitleOptions() {
        var EmployeeCode = $("divEPM_Modal #EmployeeCode").val() + "";
        var url = '@Url.Action("GetTitleOptions", "Employee")?employeeCode=' + EmployeeCode;
        $.get(url, function (result) {
            Title = result;
            PopulateTitle();
        });
    }

    function RetrieveReligionOptions() {
        $.get('@Url.Action("GetReligionOptions", "Employee")', function (result) {
            Religion = result;
            PopulateReligion();
        });
    }

    function RetrieveMaritalStatusOptions() {
        $.get('@Url.Action("GetMaritalStatusOptions", "Employee")', function (result) {
            MaritalStatus = result;
            PopulateMaritalStatus();
        });
    }
</script>

@*script AJAX DDL -->Populate DDL Value *@
<script type="text/javascript">
    // Populate Address Type dropdown
    function PopulateTitle() {
        var ddlTitle = $('#divEPM_Modal #ddlTitle');

        var i = 0;
        ddlTitle.empty();
        ddlTitle.append('<option value="" selected="selected"> - Please Select - </option>');
        for (i = 0; i < Title.length; i++) {
            ddlTitle.append('<option value="' + Title[i].Value + '">' + Title[i].Text + '</option>');
        }

        var selectedTitleCode = $('input[name="TitleCode"]');
        var selectedTitleName = $('input[name="TitleName"]');

        // Set dropdown value if has previous value available
        var checkSelectedTitleCode = "";
        // Check if has previous value available in DDL
        $('#divEPM_Modal #ddlTitle option').each(function ()
        {
            if (this.value == selectedTitleCode.val()) {
                checkSelectedTitleCode = selectedTitleCode.val();
                return false;
            }
        });
        ddlTitle.val(checkSelectedTitleCode).change();

        //$('#divEPM_Modal #ddlTitle').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});
    }

