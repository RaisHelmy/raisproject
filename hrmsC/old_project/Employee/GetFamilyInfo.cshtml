@model Tuple<List<ESS.Employee.Models.FamilyInfo>, ESS.Employee.Models.Setting>
@using ESS.Employee
@{
    string ID = "";
    string module = "Family";

    string divMode = "";

    bool runFieldVisible = false;
    if (Model.Item2 != null)
    {
        runFieldVisible = true;
    }
}
@if (Model.Item1 != null)
{
<div class="form-body">
    <div class="form-horizontal">
        <div class="table-toolbar">
            
            <table id="tblResultFamilyInfo" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th class="hidden">
                            <input id="RemoveFamilyCheckboxHeader" type="checkbox" onchange="SelectAllFamily(this)" />
                        </th>
                        <th>Relationship Type</th>
                        <th>Name</th>
                        <th>Date of Birth</th>
                        <th>New IC / Police / Military No.</th>
                    </tr>
                </thead>
                <tbody>
                   @foreach (var item in @Model.Item1)
                   {
                        <tr>
                            <td class="hidden">
                                @{ 
                                    ID = "RemoveFamilyCheckbox_" + item.Name.Replace(" ", "");
                                }
                                <input type="checkbox" id="@ID" class="RemoveFamilyCheckbox" value="@item.Name" />
                            </td>
                            <td>
                                <a href="#ProfileFamily" class="ViewFamily" 
                                    data-Family="@item.FamilyNo" 
                                   data-RelationshipCode="@item.RelationshipTypeCode" 
                                   data-RelationshipText="@item.RelationshipType">
                                    @((string.IsNullOrEmpty(item.RelationshipType)) ? "-" : item.RelationshipType)
                                </a>
                            </td>
                            <td>@((string.IsNullOrEmpty(item.Name)) ? "-" : item.Name)</td>
                            @if (!string.IsNullOrEmpty(item.DateOfBirth + ""))
                            {
                                <td>@Service.FormatDateInNumber(item.DateOfBirth, "dd/MM/yyyy")</td>
                            }
                            else
                            {
                                <td>-</td>
                            }
                            <td>@((string.IsNullOrEmpty(item.NewICNo)) ? "-" : item.NewICNo)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="form-horizontal">
        <div class="table-toolbar">
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-group addFamilyDiv hidden">
                        <a class="btn green btnAddFamily" id="btnAddFamily" onclick="OpenNewPanel('Add New Family Info', '@module', 'INSERT');">
                            Add
                            <i class="fa fa-plus"></i>
                        </a>
                    </div>
                    <div class="btn-group hidden">
                        <a class="btn red" id="btnRemoveFamily" onclick="RemoveFamily();">
                            Delete
                            <i class="fa fa-minus"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="CountClick" value="0"/>

<script type="text/javascript">
    transformTable("#tblResultFamilyInfo");
    function SelectAllFamily(element) {
        $('#tblResultFamilyInfo .RemoveFamilyCheckbox').attr('checked', element.checked);
    }

    $(document).ready(function () {

        App.initAjax();

        var divMode = "@divMode";
        var runFieldVisible = "@runFieldVisible";

        if (runFieldVisible.toUpperCase() == "TRUE")
        {
            Setting_FieldVisible = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldVisible))');
            Setting_FieldEnable = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldEnable))');
            Setting_FieldChecked = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldChecked))');
            Setting_FieldValue = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldValue))');

            PopulateSetting(divMode, "#SearchGetFamilyInfo", "#SettingSection", Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue);
            //PopulateSetting(divMode, divMain, LogDiv, Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue)
        }


        $('#uniform-RemoveFamilyCheckboxHeader').click(function (e)
        {
            var CountClick = $("#CountClick").val();
            CountClick++;
            var divBoxes = $("div[id^='uniform-RemoveFamilyCheckbox_']"); //checkbox items

            if (CountClick % 2 === 0)
            {
                /* we are even */
                if ($("#uniform-RemoveFamilyCheckboxHeader span").hasClass("checked")) {
                    $("#uniform-RemoveFamilyCheckboxHeader span").removeClass("checked")
                }
                for (i = 0; i < divBoxes.length; i++) {

                    var A = divBoxes[i].id;
                    if ($("#" + A + " span").hasClass("checked")) {
                        $("#" + A + " span").removeClass("checked");
                    }
                }
            }
            else {
                /* we are odd */

                if (!$("#uniform-RemoveFamilyCheckboxHeader span").hasClass("checked")) {
                    $("#uniform-RemoveFamilyCheckboxHeader span").addClass("checked")
                }

                for (i = 0; i < divBoxes.length; i++) {

                    var A = divBoxes[i].id;
                    if (!$("#" + A + " span").hasClass("checked")) {
                        $("#" + A + " span").addClass("checked");
                    }
                }
            }


            $("#CountClick").val(CountClick);
        });

        $('.RemoveFamilyCheckbox').click(function (e)
        {
            var CountClick = $("#CountClick").val();
            var id = this.id;
            //uniform-id

            if (!$("#uniform-" + id +" span").hasClass("checked"))
            {
                //uncheck "select all", if one of the listed checkbox item is unchecked
                if ($("#uniform-RemoveFamilyCheckboxHeader span").hasClass("checked"))
                {
                    CountClick++;
                    $("#uniform-RemoveFamilyCheckboxHeader span").removeClass("checked");
                }

            }

            var divBoxes = $("div[id^='uniform-RemoveFamilyCheckbox_']"); //checkbox items
            var Count = 0;
            for (i = 0; i < divBoxes.length; i++)
            {
                var A = divBoxes[i].id;
                if ($("#" + A + " span").hasClass("checked"))
                {
                    Count++;
                }
            }

            if(Count == divBoxes.length)
            {
                if (!$("#uniform-RemoveFamilyCheckboxHeader span").hasClass("checked"))
                {
                    CountClick++;
                    $("#uniform-RemoveFamilyCheckboxHeader span").addClass("checked");
                }
            }
            $("#CountClick").val(CountClick);
        });
    });

    $('.ViewFamily').click(function (e) {
        e.preventDefault();
        var EmployeeCode = $("#divEPM_Modal #EmployeeCode").val();
        var EmployeeID = $("#divEPM_Modal #EmployeeID").val();

        var FamilyNo = $(this).attr('data-Family');
        //FamilyNo = FamilyNo.replace("&nbsp;", "");

        var RelationshipTypeCode = $(this).attr('data-RelationshipCode');
        var RelationshipTypeText = $(this).attr('data-RelationshipText');
        var Action = 'VIEW';

        $("#divEPM_Modal #FormCategory").val("@module");
        $("#divEPM_Modal #FormAction").val(Action);
        var url="@Url.Content("~/Employee/_FamilyForm")";
        var data = {
            EmployeeCode: EmployeeCode,
            EmployeeID: EmployeeID,
            RelationshipTypeText: RelationshipTypeText,
            RelationshipTypeValue: RelationshipTypeCode,
            FamilyNo: FamilyNo,
            Mode: Action
        };
        OpenEditPanel('View Family Info', Action, url, data)
    });

</script>
}

