@model Tuple<ESS.Employee.Models.CurrentEmploymentInfo, ESS.Employee.Models.Setting>
@using ESS.Employee
@{
    Layout = null;
    string ID = "";
    string module = "CurrentEmployment";

    string divMode = "";

    bool runFieldVisible = false;
    if (Model.Item2 != null)
    {
        runFieldVisible = true;
    }
}

@if (Model.Item1 != null)
{
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group divDivision">
                    <label class="control-label col-md-4 ">
                        Company
                    </label>
                    <div class="col-md-8 form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.DivisionCode)) ? "-" : Model.Item1.DivisionCode)</label>
                    </div>
                </div>
                <div class="form-group divDepartment">
                    <label class="control-label col-md-4 ">
                        Division / Department
                    </label>
                    <div class="col-md-8 form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.Department)) ? "-" : Model.Item1.Department)</label>
                    </div>
                </div>
                <div class="form-group divUnitSection">
                    <label class="control-label col-md-4">
                        Unit / Section
                    </label>
                    <div class="col-md-8 form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.UnitSection)) ? "-" : Model.Item1.UnitSection)</label>
                    </div>
                </div>
                <div class="form-group divEmployeeGroup">
                    <label class="control-label col-md-4 ">
                        Employee Group
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.EmployeeGroup)) ? "-" : Model.Item1.EmployeeGroup)</label>
                    </div>
                </div>
                <div class="form-group divEmployeeSubGroup">
                    <label class="control-label col-md-4 ">
                        Employee Subgroup
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.EmployeeSubGroup)) ? "-" : Model.Item1.EmployeeSubGroup)</label>
                    </div>
                </div>
                <div class="form-group divPosition">
                    <label class="control-label col-md-4 ">
                        Position
                    </label>
                    <div class="col-md-8  form-control-static">
                        @*<label>@((string.IsNullOrEmpty(Model.Item1.PositionGrade)) ? "-" : Model.Item1.PositionGrade)</label>*@
                        <label>@((string.IsNullOrEmpty(Model.Item1.Position)) ? "-" : Model.Item1.Position)</label>
                    </div>
                </div>
                <div class="form-group divDuty">
                    <label class="control-label col-md-4 ">
                        Job
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.Duty)) ? "-" : Model.Item1.Duty)</label>
                    </div>
                </div>
                <div class="form-group divPayScaleGroup">
                    <label class="control-label col-md-4 ">
                        Pay Scale Group
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.PayScaleGroup)) ? "-" : Model.Item1.PayScaleGroup)</label>
                    </div>
                </div>
                <div class="form-group divImmediateManager">
                    <label class="control-label col-md-4 ">
                        Immediate Manager
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.ImmediateManagerName)) ? "-" : Model.Item1.ImmediateManagerName)</label>
                    </div>
                </div>
                <div class="form-group divEmail">
                    <label class="control-label col-md-4 ">
                        Email 1
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.Email)) ? "-" : Model.Item1.Email)</label>
                    </div>
                </div>
                <div class="form-group divEmail2">
                    <label class="control-label col-md-4 ">
                        Email 2
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.Email2)) ? "-" : Model.Item1.Email2)</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group divContractJoinedDate">
                    <label class="control-label col-md-4 ">
                        Joined Date (Contract)
                    </label>
                    <div class="col-md-8  form-control-static">
                        @if (!string.IsNullOrEmpty(Model.Item1.ContractJoinedDate + ""))
                        {
                            <label>
                                @Service.FormatDateInNumber(Model.Item1.ContractJoinedDate, "dd/MM/yyyy")
                            </label>
                        }
                        else
                        {
                            <label>-</label>
                        }
                    </div>
                </div>
                <div class="form-group divPermanentJoinedDate">
                    <label class="control-label col-md-4 ">
                        Joined Date (Permanent)
                    </label>
                    <div class="col-md-8  form-control-static">
                        @if (!string.IsNullOrEmpty(Model.Item1.PermanentJoinedDate + ""))
                        {
                            <label>
                                @Service.FormatDateInNumber(@Model.Item1.PermanentJoinedDate, "dd/MM/yyyy")
                            </label>
                        }
                        else
                        {
                            <label>-</label>
                        }
                    </div>
                </div>
                <div class="form-group divFirstConfirmationDate">
                    <label class="control-label col-md-4 ">
                        First Confirmation Date
                    </label>
                    <div class="col-md-8  form-control-static">
                       @if (!string.IsNullOrEmpty(Model.Item1.FirstConfirmationDate + ""))
                       {
                            <label>
                                @Service.FormatDateInNumber(Model.Item1.FirstConfirmationDate, "dd/MM/yyyy")
                            </label>
                        }
                        else
                        {
                            <label>-</label>
                        }
                    </div>
                </div>
                <div class="form-group divLastPromotionDate">
                    <label class="control-label col-md-4 ">
                        Last Promotion / Upgrading Date
                    </label>
                    <div class="col-md-8  form-control-static">
                       @if (!string.IsNullOrEmpty(Model.Item1.LastPromotionDate + ""))
                       {
                            <label>
                                @Service.FormatDateInNumber(Model.Item1.LastPromotionDate, "dd/MM/yyyy")
                            </label>
                        }
                        else
                        {
                            <label>-</label>
                        }
                    </div>
                </div>
                <div class="form-group divRetirementDate">
                    <label class="control-label col-md-4 ">
                        Retirement Date
                    </label>
                    <div class="col-md-8  form-control-static">
                       @if (!string.IsNullOrEmpty(Model.Item1.RetireDate + ""))
                       {
                            <label>
                                @Service.FormatDateInNumber(Model.Item1.RetireDate, "dd/MM/yyyy")
                            </label>
                        }
                        else
                        {
                            <label>-</label>
                        }
                    </div>
                </div>
                <div class="form-group divContractRetirementAge">
                    <label class="control-label col-md-4 ">
                        Retirement Age
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.ContractRetirementAge)) ? "-" : Model.Item1.ContractRetirementAge)</label>
                    </div>
                </div>
                <div class="form-group divOfficeNo">
                    <label class="control-label col-md-4 ">
                        Office No.
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.OfficeNo)) ? "-" : Model.Item1.OfficeNo)</label>
                    </div>
                </div>
                <div class="form-group divOfficeExtension">
                    <label class="control-label col-md-4 ">
                        Office Extension
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.OfficeExtension)) ? "-" : Model.Item1.OfficeExtension)</label>
                    </div>
                </div>
                <div class="form-group divOfficialHPNo">
                    <label class="control-label col-md-4 ">
                        Official HP No.
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.OfficeHPNo)) ? "-" : Model.Item1.OfficeHPNo)</label>
                    </div>
                </div>
                <div class="form-group divOfficeFaxNo">
                    <label class="control-label col-md-4 ">
                        Office Fax No.
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.OfficeFaxNo)) ? "-" : Model.Item1.OfficeFaxNo)</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-horizontal">
        <div class="table-toolbar">
            <div class="row">
                <div class="col-md-12">
                    <br />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-group editCurrentEmployerDiv hidden">
                        <a class="btn green editCurrentEmployer" id="editCurrentEmployer">
                            Edit
                            <i class="fa fa-pencil"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {

        App.initAjax();

        var divMode = "@divMode";
        var runFieldVisible = "@runFieldVisible";

        if (runFieldVisible.toUpperCase() == "TRUE") {
            Setting_FieldVisible = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldVisible))');
            Setting_FieldEnable = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldEnable))');
            Setting_FieldChecked = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldChecked))');
            Setting_FieldValue = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldValue))');

            PopulateSetting(divMode, "#SearchGetCurrentEmploymentInfo", "#SettingSection", Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue);
            //PopulateSetting(divMode, divMain, LogDiv, Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue)
        }
    });

    $('.editCurrentEmployer').click(function (e) {
        e.preventDefault();

        //var EmployeeCode = $(this).attr('data-EmployeeCode');
        var EmployeeCode = $("#EmployeeCode").val();
        var EmployeeID = $("#EmployeeID").val();
        var Action = 'EDIT';

        $("#FormCategory").val("@module");
        $("#FormAction").val(Action);
        var url="@Url.Content("~/Employee/_CurrentEmployment")";
        var data = {
            EmployeeCode: EmployeeCode,
            EmployeeID: EmployeeID,
            Mode: Action,
        };
        OpenEditPanel('Edit Current Employment Info', Action, url, data)
    });



</script>
}
