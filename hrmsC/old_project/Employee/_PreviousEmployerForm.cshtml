@*script Main Function *@
<script type="text/javascript">
    function LoadFormConfiguration()
    {
        $("#divEPM_Modal #AttachmentSessionName").val("@ViewBag.AttachmentSessionName");
        $("#divEPM_Modal #AttachmentSourceType").val("@ViewBag.AttachmentSourceType");

        //$('#divEPM_Modal #ddlCountry').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        $("#divEPM_Modal #StartDate").datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            StartDate:"",
            endDate: "@dtStrEnd"
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());

            minDate.setDate(minDate.getDate());
            $('#EndDate').datepicker('setStartDate', minDate);
        }).on("blur", function (e) {
            if ($('#StartDate').val() == "") {
                $('#EndDate').datepicker('setStartDate', "");
            }

        });

        $("#divEPM_Modal #EndDate").datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            StartDate: "",
            endDate: "@dtStrEnd"
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());
            minDate.setDate(minDate.getDate());
            $('#StartDate').datepicker('setEndDate', minDate);
        }).on("blur", function (e) {
            if ($('#EndDate').val() == "") {
                $('#StartDate').datepicker('setEndDate', "@dtStrEnd");
            }

        });





        @Html.Raw("RetrieveCountryOptions();");

    }

    function LoadFormOnChange() {

        $('#ddlCountry').change(function () {
            // if changed to, for example, the last option, then
            // $(this).find('option:selected').text() == D
            // $(this).val() == 4
            // get whatever value you want into a variable
            var HiddenCountryValue = $("#ddlCountry option:selected").val() + "";
            var HiddenCountryText = $("#ddlCountry option:selected").text() + "";

            // and update the hidden input's value
            $('#CountryName').val(HiddenCountryText);
            $('#CountryCode').val(HiddenCountryValue);
        });

    }
</script>

@*script Sub Function -->Get DDL Value *@
<script type="text/javascript">
   function RetrieveCountryOptions() {
        $.get('@Url.Action("GetCountryOptions", "Employee")', function (result) {
            Country = result;
            PopulateCountry();
        });
    }

    // Populate Country dropdown
    function PopulateCountry() {
        var ddlCountry = $('#divEPM_Modal #ddlCountry');

        var i = 0;
        ddlCountry.empty();
        ddlCountry.append('<option value="" selected="selected"> - Please Select - </option>');
        for (i = 0; i < Country.length; i++) {
            ddlCountry.append('<option value="' + Country[i].Value + '">' + Country[i].Text + '</option>');
        }

        var selectedCountryCode = $('input[name="CountryCode"]');
        var selectedCountryName = $('input[name="CountryName"]');

        // Set dropdown value if has previous value available
        var checkSelectedCountryCode = "";
        // Check if has previous value available in DDL
        $('#divEPM_Modal #ddlCountry option').each(function () {
            if (this.value == selectedCountryCode.val()) {
                checkSelectedCountryCode = selectedCountryCode.val();
                return false;
            }
        });
        ddlCountry.val(checkSelectedCountryCode).change();


        //$('#divEPM_Modal #ddlCountry').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});
    }
</script>

@*script Submission Activity *@
<script type="text/javascript">

    function FormValidation(btn) {
        btn.disabled = true;

        var _ValidationMsg = '';
        var StartDate = $("#divEPM_Modal #StartDate").val() + "";
        var EndDate = $("#divEPM_Modal #EndDate").val() + "";
        var PreviousEmployer = $("#divEPM_Modal #PreviousEmployer").val() + "";
        var CountryCode = $("#divEPM_Modal #CountryCode").val() + "";

        var PreviousEmployerAttachMandatory = $("#divEPM_Modal #PreviousEmployerAttachMandatory").val() + "";
        var CreateONLY = "@Create";

        var CountTotal_Attachment = "";
        if (PreviousEmployerAttachMandatory == "true") {
            CountTotal_Attachment = $("#divEPM_Modal #CountTotal_Attachment").val() + ""; 
        }
        // SubAttachment/_AttachmentListing

        if (StartDate == "") {
            _ValidationMsg += '- Start Date is required.\n';
        }

        if (EndDate == "") {
            _ValidationMsg += '- End Date is required.\n';
        }

        if (PreviousEmployer == "") {
            _ValidationMsg += '- Previous Employer is required.\n';
        }

        if (CountryCode == "") {
            _ValidationMsg += '- Country is required.\n';
        }

        if (PreviousEmployerAttachMandatory.toUpperCase() == "TRUE" && CreateONLY.toUpperCase() == "TRUE") {
            if (CountTotal_Attachment == "0") {
                _ValidationMsg += '- Attachment is required.\n';
            }
        }

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application. If you want to make changes, click Close.');
            $("#divLoading2").show();
            $("#ConfirmUpdate").modal('show');

        }
        btn.disabled = false;
    }

    function ConfirmAction_PreviousEmployer(btn, FormAction) {

        //at index page
        var _EmployeeID = $("#divEPM_Modal #EmployeeID").val() + "";
        var _createdBy = $("#divEPM_Modal #ActionerID").val() + "";

        var _PreviousEmployer = $("#divEPM_Modal #PreviousEmployer").val() + "";
        var _City = $("#divEPM_Modal #City").val() + "";
        var _CountrySelectedValue = $("#divEPM_Modal #CountryCode").val() + "";
        var _CountrySelectedText = $("#divEPM_Modal #CountryName").val() + "";

        var _Position = $("#divEPM_Modal #Position").val() + "";
        var _StartDate = $("#divEPM_Modal #StartDate").val() + "";
        var _EndDate = $("#divEPM_Modal #EndDate").val() + "";

        var _PreviousEmployerAttachMandatory = $("#divEPM_Modal #PreviousEmployerAttachMandatory").val() + "";
        var _AttachmentSessionName = $("#divEPM_Modal #AttachmentSessionName").val() + "";
        var _AttachmentSourceType = $("#divEPM_Modal #AttachmentSourceType").val() + "";
        var _AttachmentCategory = "@EmployeeCategory_PreviousEmployer" + "";

        var _HiddenStartDate = $("#divEPM_Modal #HiddenStartDate").val() + "";
        var _HiddenEndDate = $("#divEPM_Modal #HiddenEndDate").val() + "";
        var _HiddenLockIndicator = $("#divEPM_Modal #HiddenLockIndicator").val() + "";
        var _HiddenObjectID = $("#divEPM_Modal #HiddenObjectID").val() + "";
        var _HiddenPreviousEmployer = $("#divEPM_Modal #HiddenPreviousEmployer").val() + "";
        var _HiddenCity = $("#divEPM_Modal #HiddenCity").val() + "";
        var _HiddenCountry = $("#divEPM_Modal #HiddenCountry").val() + "";
        var _HiddenPosition = $("#divEPM_Modal #HiddenPosition").val() + "";
        var _HiddenRecordNumber = $("#divEPM_Modal #HiddenRecordNumber").val() + "";
        var _HiddenSubType = $("#divEPM_Modal #HiddenSubType").val() + "";

        var Url = "";

        if (FormAction.toUpperCase() == "INSERT") {
            var form = {
                EmployeeID: _EmployeeID,
                PreviousEmployer: _PreviousEmployer,
                City: _City,
                CountrySelectedValue: _CountrySelectedValue,
                CountrySelectedText: _CountrySelectedText,
                Position: _Position,
                StartDate: _StartDate,
                EndDate: _EndDate,
                createdBy: _createdBy
            };
            ResultMsg = "The request (Add Previous Employer Information) has been successfully submitted.";
            Url = '@Url.Content("~/Employee/SubmitPreviousEmployerForm")';
        }
        else if (FormAction.toUpperCase() == "EDIT") {
            var form = {
                EmployeeID: _EmployeeID,
                PreviousEmployer: _PreviousEmployer,
                City: _City,
                CountrySelectedValue: _CountrySelectedValue,
                CountrySelectedText: _CountrySelectedText,
                Position: _Position,
                StartDate: _StartDate,
                EndDate: _EndDate,
                createdBy: _createdBy,
                HiddenStartDate: _HiddenStartDate,
                HiddenEndDate: _HiddenEndDate,
                HiddenLockIndicator: _HiddenLockIndicator,
                HiddenObjectID: _HiddenObjectID,
                HiddenPreviousEmployer: _HiddenPreviousEmployer,
                HiddenCity: _HiddenCity,
                HiddenCountry: _HiddenCountry,
                HiddenPosition: _HiddenPosition,
                HiddenRecordNumber: _HiddenRecordNumber,
                HiddenSubType: _HiddenSubType
            };

            ResultMsg = "The request (Edit Previous Employer Information) has been successfully submitted.";
            Url = '@Url.Content("~/Employee/UpdatePreviousEmployerForm")';
        }

        if ($('#divLoading').is(':visible')) {

            $.ajax({
                type: "POST",
                url: Url,
                cache: false,
                async: false,
                dataType: "json",
                data: form,
                success: function (result) {
                    if (result.Success) {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").show();

                        ResultMsg += "<br/><br/>Request No: <label class='refno'>" + result.RequestNo + "</label>";
                        $(".Success-body .well").html(ResultMsg);
                        $("#SuccessSubmit").modal();

                        $("#btnOK").click(function () { RedirectTo(FormAction.toUpperCase()); });
                    }
                    else {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").hide();
                        btn.disabled = false;

                        alert(result.ErrorMsg);

                    }
                },
                error: function (e) {

                }
            });
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "INSERT":
                location.reload();
                break;
            case "EDIT":
                location.reload();
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }

    function AllowEdit_PreviousEmployer(btn, FormAction) {

        var EmployeeCode = "@Model.Item1.EmployeeCode";
        var EmployeeID = "@Model.Item1.EmployeeID";

        var LockIndicator = "@Model.Item1.LockIndicator";
        var ObjectID = "@Model.Item1.ObjectID";
        var RecordNumber = "@Model.Item1.RecordNumber";
        var SubType = "@Model.Item1.SubType";
        var StartDate = "@Service.FormatDateInNumber(Model.Item1.StartDate, "dd/MM/yyyy")";
        var EndDate = "@Service.FormatDateInNumber(Model.Item1.EndDate, "dd/MM/yyyy")";

        var Action = 'Edit';


        $("#divEPM_Modal #FormCategory").val("@module");
        $("#divEPM_Modal #FormAction").val(Action);
        var url = "@Url.Content("~/Employee/_PreviousEmployerForm")";
        var data = {
            EmployeeCode: EmployeeCode,
            EmployeeID: EmployeeID,
            LockIndicator: LockIndicator,
            ObjectID: ObjectID,
            RecordNumber: RecordNumber,
            SubType: SubType,
            StartDate: StartDate,
            EndDate: EndDate,
            Mode: Action
        };
        btn.disabled = false;
        OpenEditPanel('Edit Previous Employer Info', Action, url, data)
    }


</script>

@*Script Load Form Function*@
<script type="text/javascript">
    function ReformatDate(edate, Type) {
        try {
            if (edate.length > 0)
            {
                var myDate = $.datepicker.parseDate("dd/mm/yy", edate);
                var d = myDate.getDate();
                var m = myDate.getMonth();
                m += 1;
                var y = myDate.getFullYear();

                var newdate = (y + "-" + m + "-" + d);
                return newdate;
            }
            return "";
        }

        catch (e) {
            var Error = "ERROR";
            //alert('Invalid Date Format ('+Type+')' + e);
            //alert(e);
            return Error;
        }

    }

</script>

@*script Load Form *@
<script type="text/javascript">

    $(document).ready(function () {
        App.initAjax();

        var divMode = "@divMode";
        var runFieldVisible = "@runFieldVisible";

        if (runFieldVisible.toUpperCase() == "TRUE") {
            Setting_FieldVisible = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldVisible))');
            Setting_FieldEnable = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldEnable))');
            Setting_FieldChecked = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldChecked))');
            Setting_FieldValue = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldValue))');

            PopulateSetting(divMode, "#divEPM_Modal", "#SettingFormLoad", Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue);
            //PopulateSetting(divMode, divMain, LogDiv, Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue)

        }

        LoadFormConfiguration();

        LoadFormOnChange();

    });

</script>



