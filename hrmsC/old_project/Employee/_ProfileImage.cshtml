@*script Main Function *@
<script type="text/javascript">
    function LoadFormConfiguration() {
        $(".btnModeEdit").each(function (i, obj) {
            if ($(this).hasClass("hidden")) {
                $(this).removeClass("hidden");
            }
        });

        $(".btnModeInsert").addClass('hidden');
    }
</script>

@*script Submission Activity *@
<script type="text/javascript">
    

    function FormValidation(btn) {
        btn.disabled = true;

        var ValidationMsg = ''; 
        var _selectedFile = $("#ProfileImageForm #UploadImage").val() + "";
        var _ImagePreviewResult = $("#ProfileImageForm #_ImagePreviewResult").val() + "";
        if (_selectedFile == '') {
            ValidationMsg += '- Please Select a file to upload.\n'
        }

        //if (_ImagePreviewResult.toUpperCase() != 'SUCCESS') {
        //    ValidationMsg += '- Unable to load images. Please re-upload another profile images.\n'
        //}

        if (ValidationMsg != null && ValidationMsg != '') {
            $('#ProfileImageForm #UploadImage').val("");
            $("#ProfileImageForm #previewImgProfile").css('background-image', 'none');
            alert(ValidationMsg);
        }
        else {
            $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application. If you want to make changes, click Close.');
            $("#divLoading2").show();
            $("#ConfirmUpdate").modal('show');

        }
        btn.disabled = false;
    }

    function ConfirmAction_ProfileImage(btn, FormAction)
    {
        //at index page
        var _EmployeeID = $("#divEPM_Modal #EmployeeID").val() + "";

        var _FileContents = $("#ProfileImageForm #_ImageContentURL").val() + "";
        var _DocumentName = $("#ProfileImageForm #_ImageDocumentName").val() + "";
        var _DocumentSize = $("#ProfileImageForm #_ImageDocumentSize").val() + "";
        var _DocumentContentType = $("#ProfileImageForm #_ImageDocumentContentType").val() + "";
        var _SourceType = $("#ProfileImageForm #_ImageSourceType").val() + "";
        var _RequestID = $("#ProfileImageForm #_ImageRequestID").val() + "";
        var _createdBy = "@_ActionerID";

        var Url = "";

        if (FormAction.toUpperCase() == "EDIT") {
            var form = {
                EmployeeID: _EmployeeID,
                FileContents: _FileContents,
                DocumentName: _DocumentName,
                DocumentSize: _DocumentSize,
                DocumentContentType: _DocumentContentType,
                SourceType: _SourceType,
                SourceID: _RequestID,
                createdBy: _createdBy,
            };

            ResultMsg = "The request (Upload Photo) has been successfully submitted.";
            Url = '@Url.Content("~/Employee/UpdateProfileImage")';
        }

        if ($('#divLoading').is(':visible')) {

            $.ajax({
                type: "POST",
                url: Url,
                cache: false,
                async: false,
                dataType: "json",
                data: form,
                success: function (result) {
                    if (result.Success) {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").show();

                        ResultMsg += "<br/><br/>Request No: <label class='refno'>" + result.RequestNo + "</label>";
                        $(".Success-body .well").html(ResultMsg);
                        $("#SuccessSubmit").modal();

                        $("#btnOK").click(function () { RedirectTo(FormAction.toUpperCase()); });
                    }
                    else {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").hide();
                        btn.disabled = false;

                        alert(result.ErrorMsg);

                    }
                },
                error: function (e) {

                }
            });
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "INSERT":
                location.reload();
                break;
            case "EDIT":
                location.reload();
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }
</script>

