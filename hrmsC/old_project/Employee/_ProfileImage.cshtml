@{
    #region
    Layout = null;
    string module = "ProfileImage";
    string _SourceType = ViewBag.SourceType + "";
    string _RequestID = ViewBag.RequestID + "";
    string _MaximumFileSize = ViewBag.MaximumFileSize + "";
    string _AllowedFileTypes = ViewBag.AllowedFileTypes + "";
    string _ActionerID = ViewBag.ActionerID + "";

    string maxSize = _MaximumFileSize;
    if (!string.IsNullOrEmpty(_MaximumFileSize))
    {
        int bits = int.Parse(_MaximumFileSize);
        double mb = (double)bits / (1024 * 1024);
        maxSize = string.Format("{0:f1}", mb);
    }

    #endregion
}
