    function _ConvertImageToBaseSixtyFour() {
        var _AllowedMaxSize = parseFloat($('#ProfileImageForm #_ImageFileSize').val()) || 0;
        var _AllowedExtensions = $('#ProfileImageForm #_ImageFileExtension').val();
        var _selectedFile = document.getElementById('UploadImage').files;

        if (_selectedFile.length > 0) {
            var _fileToLoad = _selectedFile[0];

            var _fileReader = new FileReader();

            _fileReader.onload = function (fileLoadedEvent) {
                var _ValidFile = false;
                var _documentName = $('#ProfileImageForm #UploadImage')[0].files[0].name;
                var _documentSize = $('#ProfileImageForm #UploadImage')[0].files[0].size;
                var _fileExtension = _documentName.substring(_documentName.lastIndexOf('.') + 1).toLowerCase();
                //alert(_documentSize + "");
                if (_AllowedExtensions.indexOf(_fileExtension) > -1) {
                    var _docSize = parseFloat(_documentSize) || 0;
                    if (_docSize > _AllowedMaxSize) {
                        $('#ProfileImageForm #UploadImage').val("");
                        alert('- File size has exceeded the allowed limit of ' + @maxSize + ' MB');
                    }
                    else {
                        _ValidFile = true;
                    }
                }
                else {
                    $('#ProfileImageForm #UploadImage').val("");
                    alert('- Invalid file type. Only files of the following extensions are allowed (' + _AllowedExtensions + ')');
                }

                if (_ValidFile) {
                    var _fileContents = $('#ProfileImageForm #_ImageContents');
                    _fileContents.value = fileLoadedEvent.target.result;
                    var _documentContentType = _fileContents.value.split(",")[0].split(":")[1].split(";")[0];
                    document.getElementById("previewImgProfile").src = fileLoadedEvent.target.result;
                    //$("#ProfileImageForm #previewImgProfile").css("background-image", "url('" + fileLoadedEvent.target.result + "')");
                    $('#ProfileImageForm #_ImageDocumentName').val(_documentName);
                    $('#ProfileImageForm #_ImageDocumentSize').val(_documentSize);
                    $('#ProfileImageForm #_ImageDocumentContentType').val(_documentContentType);
                    $('#ProfileImageForm #_ImageContentURL').val(fileLoadedEvent.target.result);

                    //runImage(fileLoadedEvent.target.result);
                    
                    //console.log(_fileContents.value + "====" + _documentName + "====" + _documentSize);
                }
            };

            _fileReader.readAsDataURL(_fileToLoad);
        }
    }

