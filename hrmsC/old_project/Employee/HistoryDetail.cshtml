    function SearchGet_AttachmentInfo(Category, Criteria, RequestID) {
        var FormCategory = $("#FormCategory").val();

        if ($('.divAttachment').css('display') != 'none')
        {
            $("#_Attachment").html("Loading...");

            //value might be overight by user if choose not to attached
            $("#" + FormCategory + "AttachMandatory").val("true");
            //force attachment
            $("#Hidden" + FormCategory + "AttachMandatory").val("true");
            var A = "@Model.EmployeeID'";
            var AttachmentSessionName = $("#AttachmentSessionName").val();
            var AttachmentSourceType = $("#AttachmentSourceType").val();
            $.ajax({
                type: "GET",
                url: '@Url.Content("~/Employee/_Attachment")',
                cache: false,
                dataType: "html",
                data: { EmployeeID: '@Model.EmployeeID', Category: Category, Criteria: Criteria, RequestID: RequestID, SessionName: AttachmentSessionName, SourceType: AttachmentSourceType },
                success: function (content) {
                    $("#_Attachment").html(content);
                },
                error: function (e) {
                    console.log(e);
                }
            });
        }
        else
        {
            $("#" + FormCategory + "AttachMandatory").val("false");
        }
    }

