                </div>
                <div class="modal-body">
                    <div class="row hidden">
                        <div class="col-md-12 btnModeEdit hidden">
                            <a class="btn green pull-right" style="margin: 5px;" href="javascript:AllowRefresh(this);">Refresh</a>
                        </div>
                    </div>
                    <div id="_Form">

                    </div>
                    <div id="_Attachment" class="divAttachment hidden">

                    </div>
                    <div id="FormInformation" class="hidden divEPMSecretForm">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Employee ID
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control"
