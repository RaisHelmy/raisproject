@model ESS.Employee.Models.EmployeeRequest
@{
    string Title = ViewBag.Title;
    ViewBag.Title = "TNB Employee Profile -" + Title;

    bool closeDisclaimer = false;
    if (ViewBag.CloseDisclaimer != null)
    {
        closeDisclaimer = ViewBag.CloseDisclaimer == "1";
    }

}
<style>
    .refno {
        color: #0000CC;
        font-weight: bold;
    }
</style>

@using (Html.BeginForm("HistoryDetail", "Employee", FormMethod.Post))
{
    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
                    @Title
                    <span style="padding-left:20px;">
                        <small></small>
                    </span>
                </h1>
                <input type="hidden" name="RequestID" value="@Model.RequestID" />
            </div>
        </div>
    </div>

    <!-- Employee Details -->
    @Html.Partial("_ApplicationEmployeeInfo", Model.Submiter)
    @Html.Partial("_ApplicationRequest", Model)

    @Html.Action("_ApplicationAuditLog", "Employee", new { SourceID = Model.RequestID })

    @Html.Action("_ApplicationActionButtons", "Employee", new { vm = Model })
}

<div id="divEPM_Modal">
    <div class="modal fade" id="FormModal" tabindex="-1" aria-hidden="true">
