@*script Main Function *@
<script type="text/javascript">
    function LoadFormConfiguration()
    {
        $("#divEPM_Modal #AttachmentSessionName").val("@ViewBag.AttachmentSessionName");
        $("#divEPM_Modal #AttachmentSourceType").val("@ViewBag.AttachmentSourceType");
    }
</script>

@*script Sub Function -->Get DDL Value *@


@*script Submission Activity *@
<script type="text/javascript">

    function FormValidation(btn) {
        btn.disabled = true;

        var _ValidationMsg = '';

        var CurrentEmploymentAttachMandatory = $("#divEPM_Modal #CurrentEmploymentAttachMandatory").val() + "";

        var CreateONLY = "@Create";

        var CountTotal_Attachment = "";
        if (CurrentEmploymentAttachMandatory == "true") {
            CountTotal_Attachment = $("#divEPM_Modal #CountTotal_Attachment").val() + ""; 
        }
        // SubAttachment/_AttachmentListing

        if (CurrentEmploymentAttachMandatory.toUpperCase() == "TRUE" && CreateONLY.toUpperCase() == "TRUE") {
            if (CountTotal_Attachment == "0") {
                _ValidationMsg += '- Attachment is required.\n';
            }
        }

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application. If you want to make changes, click Close.');
            $("#divLoading2").show();
            $("#ConfirmUpdate").modal('show');

        }
        btn.disabled = false;
    }

    function ConfirmAction_CurrentEmployment(btn, FormAction) {

        //at index page
        var _EmployeeID = $("#divEPM_Modal #EmployeeID").val() + "";
        var _EmployeeCode = $("#divEPM_Modal #EmployeeCode").val() + "";
        var _createdBy = $("#divEPM_Modal #ActionerID").val() + "";

        var _OfficeNo = $("#divEPM_Modal #OfficeNo").val() + "";
        var _OfficeExtension = $("#divEPM_Modal #OfficeExtension").val() + "";
        var _OfficeHPNo = $("#divEPM_Modal #OfficeHPNo").val() + "";
        var _OfficeFaxNo = $("#divEPM_Modal #OfficeFaxNo").val() + "";
        var _Email2 = $("#divEPM_Modal #Email2").val() + "";

        var _CurrentEmploymentAttachMandatory = $("#divEPM_Modal #CurrentEmploymentAttachMandatory").val() + "";
        var _AttachmentSessionName = $("#AttachmentSessionName").val() + "";
        var _AttachmentSourceType = $("#AttachmentSourceType").val() + "";
        var _AttachmentCategory = "@EmployeeCategory_CurrentEmployment" + "";

        var _HiddenOfficeNo = $("#divEPM_Modal #HiddenOfficeNo").val() + "";
        var _HiddenOfficeExtension = $("#divEPM_Modal #HiddenOfficeExtension").val() + "";
        var _HiddenOfficeHPNo = $("#divEPM_Modal #HiddenOfficeHPNo").val() + "";
        var _HiddenOfficeFaxNo = $("#divEPM_Modal #HiddenOfficeFaxNo").val() + "";
        var _HiddenEmail2 = $("#divEPM_Modal #HiddenEmail2").val() + "";

        var Url = "";

        if (FormAction.toUpperCase() == "EDIT") {
            var form = {
                EmployeeID: _EmployeeID,
                EmployeeCode: _EmployeeCode,
                OfficeNo: _OfficeNo,
                OfficeExtension: _OfficeExtension,
                OfficeHPNo: _OfficeHPNo,
                OfficeFaxNo: _OfficeFaxNo,
                Email2: _Email2,
                createdBy: _createdBy,
                HiddenOfficeNo: _HiddenOfficeNo,
                HiddenOfficeExtension: _HiddenOfficeExtension,
                HiddenOfficeHPNo: _HiddenOfficeHPNo,
                HiddenOfficeFaxNo: _HiddenOfficeFaxNo,
                HiddenEmail2: _HiddenEmail2
            };

            ResultMsg = "The request (Edit Current Employment Information) has been successfully submitted.";
            Url = '@Url.Content("~/Employee/UpdateCurrentEmploymentForm")';
        }

        if ($('#divLoading').is(':visible')) {

            $.ajax({
                type: "POST",
                url: Url,
                cache: false,
                async: false,
                dataType: "json",
                data: form,
                success: function (result) {
                    if (result.Success) {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").show();

                        ResultMsg += "<br/><br/>Request No: <label class='refno'>" + result.RequestNo + "</label>";
                        $(".Success-body .well").html(ResultMsg);
                        $("#SuccessSubmit").modal();

                        $("#btnOK").click(function () { RedirectTo(FormAction.toUpperCase()); });
                    }
                    else {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").hide();
                        btn.disabled = false;

                        alert(result.ErrorMsg);

                    }
                },
                error: function (e) {

                }
            });
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "INSERT":
                location.reload();
                break;
            case "EDIT":
                location.reload();
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }
</script>

@*Script Load Form Function*@
<script type="text/javascript">
    function ReformatDate(edate, Type) {
        try {
            if (edate.length > 0)
            {
                var myDate = $.datepicker.parseDate("dd/mm/yy", edate);
                var d = myDate.getDate();
                var m = myDate.getMonth();
                m += 1;
                var y = myDate.getFullYear();

                var newdate = (y + "-" + m + "-" + d);
                return newdate;
            }
            return "";
        }

        catch (e) {
            var Error = "ERROR";
            //alert('Invalid Date Format ('+Type+')' + e);
            //alert(e);
            return Error;
        }

    }

</script>

@*script Load Form *@
<script type="text/javascript">

    $(document).ready(function () {
        App.initAjax();

        var divMode = "@divMode";
        var runFieldVisible = "@runFieldVisible";

        if (runFieldVisible.toUpperCase() == "TRUE") {
            Setting_FieldVisible = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldVisible))');
            Setting_FieldEnable = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldEnable))');
            Setting_FieldChecked = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldChecked))');
            Setting_FieldValue = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldValue))');

            PopulateSetting(divMode, "#divEPM_Modal", "#SettingFormLoad", Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue);
            //PopulateSetting(divMode, divMain, LogDiv, Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue)

        }

        LoadFormConfiguration();

    });

    function AllowRefresh_CurrentEmployment(btn, FormAction) {
        btn.disabled = false;

        $("#divEPM_Modal #Email2").val("@Model.Item1.Email2");
        $("#divEPM_Modal #OfficeNo").val("@Model.Item1.OfficeNo");
        $("#divEPM_Modal #OfficeExtension").val("@Model.Item1.OfficeExtension");
        $("#divEPM_Modal #OfficeHPNo").val("@Model.Item1.OfficeHPNo");
        $("#divEPM_Modal #OfficeFaxNo").val("@Model.Item1.OfficeFaxNo");
    }

</script>


