@model List<ESS.Employee.Models.TrainingInfo>
@using ESS.Employee;
@{
    string ID = "";
    string module = "Training";
}
<div class="form-body">
    <div class="form-horizontal">
        <div class="table-toolbar">

            <table id="tblResultTrainingInfo" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Course Title</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Venue</th>
                        <th>Provider</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in @Model)
                    {
                        <tr>
                            <td>
                                @item.TrainingCategoryDesc
                            </td>
                            <td>@item.TrainingTypeDesc</td>
                            <td>@item.CourseName</td>
                            <td>@Service.FormatDateInNumber(item.TrainingStartDate, "dd/MM/yyyy")</td>
                            <td>@Service.FormatDateInNumber(item.TrainingEndDate, "dd/MM/yyyy")</td>
                            <td>@item.CourseVenue</td>
                            <td>@item.CourseOrganizer</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script type="text/javascript">
    transformTable("#tblResultTrainingInfo");
</script>

