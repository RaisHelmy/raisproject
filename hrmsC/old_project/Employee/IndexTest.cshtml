        <script type="text/javascript">
        function BackToHistory() {
            window.location.href = '@ViewBag.BackUrl';
        }
    function ExpendAll() {
        $('.EmployeePortlet  .form').show();
        $('.EmployeePortlet  a.expand').removeClass('expand').addClass('collapse');
    }

    function CollapseAll() {
        $('.EmployeePortlet  .form').hide();
        $('.EmployeePortlet  a.collapse').removeClass('collapse').addClass('expand');
    }
    function SearchGetPersonalInfo()
    {
        $("#SearchGetPersonalInfo").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Employee/GetPersonalInfo")',
            cache: false,
            dataType: "html",
            data: { EmployeeID: '@Model.EmployeeID', EmployeeCode: '@Model.EmployeeCode', PhotoID: '@Model.PhotoID' },
            success: function (content) {
                $("#SearchGetPersonalInfo").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function SearchGetFamilyInfo() {
        var CheckFamily = "@CheckFamily";
		console.log(CheckFamily);
        if (CheckFamily.toUpperCase() == "TRUE")
        {
            $("#FamilyInfo").removeClass("hidden");
            $("#SearchGetFamilyInfo").html("LOADING...");

            $.ajax({
                type: "GET",
                url: '@Url.Content("~/Employee/GetFamilyInfo")',
                cache: false,
                dataType: "html",
                data: { EmployeeID: '@Model.EmployeeID', EmployeeCode: '@Model.EmployeeCode' },
                success: function (content) {
                    $("#SearchGetFamilyInfo").html(content);
                },
                error: function (e) {
                    console.log(e);
                }
            });
        }
        else
        {
            $("#SearchGetFamilyInfo").html("Access is denied");
            $("#FamilyInfo").addClass("hidden");
        }

    }

    function SearchGetEmergencyContactInfo() {
        var CheckEmergency = "@CheckEmergency";

        if (CheckEmergency.toUpperCase() == "TRUE")
        {
            $("#EmergencyContactInfo").removeClass("hidden");
            $("#SearchGetEmergencyContactInfo").html("LOADING...");

            $.ajax({
                type: "GET",
                url: '@Url.Content("~/Employee/GetEmergencyContactInfo")',
                cache: false,
                dataType: "html",
                data: { EmployeeID: '@Model.EmployeeID', EmployeeCode: '@Model.EmployeeCode' },
                success: function (content) {
                    $("#SearchGetEmergencyContactInfo").html(content);
                },
                error: function (e) {
                    console.log(e);
                }
            });
        }
        else {
            $("#SearchGetEmergencyContactInfo").html("Access is denied");
            $("#EmergencyContactInfo").addClass("hidden");
        }
    }

    function SearchGetAddressInfo() {
        var CheckAddress = "@CheckAddress";

