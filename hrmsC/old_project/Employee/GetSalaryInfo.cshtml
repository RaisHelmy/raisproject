@model Tuple<ESS.Employee.Models.PayrollInfo, ESS.Employee.Models.Setting>
@using ESS.Employee
@{
    Layout = null;

    string Employee_SalaryPayslip = Url.Action("Index", "EPayslip"); //ViewBag.Employee_SalaryPayslip + "";
    string Employee_SalaryEAArchived = Url.Action("Index", "EPayslip"); //ViewBag.Employee_SalaryEAArchived + "";
    string Employee_SalaryEA = ViewBag.Employee_SalaryEA + "";
    string Employee_SalaryPCB = ViewBag.Employee_SalaryPCB + "";

}
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4 ">
                        EPF No.
                    </label>
                    <div class="col-md-8 form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.EPFNo)) ? "-" : Model.Item1.EPFNo)</label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-4 ">
                        Socso No.
                    </label>
                    <div class="col-md-8 form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.SocsoNo)) ? "-" : Model.Item1.SocsoNo)</label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-4">
                        Income Tax No.
                    </label>
                    <div class="col-md-8 form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.TaxNo)) ? "-" : Model.Item1.TaxNo)</label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-4 ">
                        Bank Name
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label>@((string.IsNullOrEmpty(Model.Item1.BankName)) ? "-" : Model.Item1.BankName)</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4 ">
                        Payslip
                    </label>
                    <div class="col-md-8  form-control-static">
                        @*<label><a href="@Employee_SalaryPayslip" target="_blank"> <u>View</u></a></label>*@ 
                        <label><a href="@Url.Action("Index", "EPayslip")?Year=@DateTime.Now.Year" target="_blank"> <u>View</u></a></label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-4 ">
                        EA Form
                    </label>
                    <div class="col-md-8  form-control-static">
                        @*<label><a href="@Employee_SalaryEA" target="_blank"> <u>View</u></a></label>*@
                        <label><a href="@Url.Action("Index", "EPayslip")?Year=@DateTime.Now.Year" target="_blank"> <u>View</u></a></label>
                    </div>
                </div>
                @*<div class="form-group">
                    <label class="control-label col-md-4 ">
                        EA Form (Archived)
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label><a href="javascript:openWindow('/_layouts/TNBESS/Payroll/ViewEAForm.aspx?Source=EmployeeProfile', 'EA', 500, 200)">View</a></label>
                    </div>
                </div>*@
                @*<div class="form-group">
                    <label class="control-label col-md-4 ">
                        PCB Form
                    </label>
                    <div class="col-md-8  form-control-static">
                        <label><a href="javascript:openWindow('PayrollPCB.aspx', 'PCB', 500, 200)">View</a></label>
                    </div>
                </div>*@
            </div>
        </div>
    </div>
</div>