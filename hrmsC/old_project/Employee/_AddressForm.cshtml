@model Tuple<ESS.Employee.Models.AddressInfo, ESS.Employee.Models.Setting>
@using ESS.Employee;
@{
    #region
    string module = "Address";

    Layout = null;
    bool ReadOnly = false;
    bool EditReadOnly = false;
    bool Create = false;

    string classViewReadOnly = "";
    string EmployeeCategory_Address = ViewBag.EmployeeCategory_Address + "";

    string Mode = ViewBag.Mode + "";
    string divMode = "";
    if (String.Equals(Mode, "View", StringComparison.OrdinalIgnoreCase))
    {
        ReadOnly = true;
        classViewReadOnly = "disabled = 'disabled' ";
        divMode = "";
    }
    else if (String.Equals(Mode, "Edit", StringComparison.OrdinalIgnoreCase))
    {
        ReadOnly = false;
        EditReadOnly = true;
        classViewReadOnly = "";
        divMode = "Edit";
    }
    else
    {
        Create = true;
        divMode = "Insert";
    }

    bool runFieldVisible = false;
    if (Model.Item2 != null)
    {
        runFieldVisible = true;
    }
    #endregion
}

<div id="_AddressInfo" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Address Info
                </div>
            </div>
            <div class="portlet-body form" id="SearchGet_AddressInfo">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group divAddressType">
                                    <label class="control-label col-md-2">
                                        Address Type
                                        @if (Create)
                                        {
                                            <span class="required">*</span>
                                        }
                                    </label>
                                    <div class="col-md-10 form-control-static">
                                        <input type="hidden" name="AddressTypeCode" id="AddressTypeCode" value="@Model.Item1.AddressTypeCode" />
                                        @if (EditReadOnly || ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="AddressTypeName" name="AddressTypeName" value="@Model.Item1.AddressType" readonly="readonly" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="AddressTypeName" id="AddressTypeName" value="@Model.Item1.AddressType" />
                                            <select tabindex="0" id="ddlAddressType" class="form-control" @classViewReadOnly></select>
                                        }
                                        <input type="hidden" class="form-control"
                                               name="HiddenAddressType" id="HiddenAddressType" value="@Model.Item1.AddressType">
                                    </div>
                                </div>

                                @if (Model.Item1.AddressTypeCode == "OO")
                                {
                                    <div class="form-group divBuilding">
                                        <label class="control-label col-md-2 ">
                                            Building
                                        </label>
                                        <div class="col-md-10 form-control-static">
                                            <input type="text" class="form-control" MaxLength="60"
                                                   name="Building" value="@Model.Item1.Building" id="Building" @classViewReadOnly>
                                            <input type="hidden" class="form-control"
                                                   name="HiddenBuilding" value="@Model.Item1.Building" id="HiddenBuilding">
                                        </div>
                                    </div>
                                    <div class="form-group divBuildingLevel">
                                        <label class="control-label col-md-2 ">
                                            Building Level
                                        </label>
                                        <div class="col-md-10 form-control-static">
                                            <input type="text" class="form-control" MaxLength="60"
                                                   name="BuildingLevel" value="@Model.Item1.BuildingLevel" id="BuildingLevel" @classViewReadOnly>
                                            <input type="hidden" class="form-control"
                                                   name="HiddenBuildingLevel" value="@Model.Item1.BuildingLevel" id="HiddenBuildingLevel">
                                        </div>
                                    </div>
                                }

                                <div class="form-group divAddressLine1">
                                    <label class="control-label col-md-2 ">
                                        Address Line 1
                                    </label>
                                    <div class="col-md-10 form-control-static">
                                        <input type="text" class="form-control" MaxLength="60"
                                               name="AddressLine1" value="@Model.Item1.AddressLine1" id="AddressLine1" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenAddressLine1" value="@Model.Item1.AddressLine1" id="HiddenAddressLine1">
                                    </div>
                                </div>
                                <div class="form-group divAddressLine2">
                                    <label class="control-label col-md-2 ">
                                        Address Line 2
                                    </label>
                                    <div class="col-md-10 form-control-static">
                                        <input type="text" class="form-control" MaxLength="40"
                                               name="AddressLine2" value="@Model.Item1.AddressLine2" id="AddressLine2" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenAddressLine2" value="@Model.Item1.AddressLine2" id="HiddenAddressLine2">
                                    </div>
                                </div>

                                @if (Model.Item1.AddressTypeCode == "OO")
                                { }
                                else
                                {
                                    <div class="form-group divAddressLine3">
                                        <label class="control-label col-md-2 ">
                                            Address Line 3
                                        </label>
                                        <div class="col-md-10 form-control-static">
                                            <input type="text" class="form-control" MaxLength="40"
                                                   name="AddressLine3" value="@Model.Item1.AddressLine3" id="AddressLine3" @classViewReadOnly>
                                            <input type="hidden" class="form-control"
                                                   name="HiddenAddressLine3" value="@Model.Item1.AddressLine3" id="HiddenAddressLine3">
                                        </div>
                                    </div>
                                }

                                <div class="form-group divCity">
                                    <label class="control-label col-md-2">
                                        City<span class="required">*</span>
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" MaxLength="40"
                                               name="City" value="@Model.Item1.City" id="City" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenCity" value="@Model.Item1.City" id="HiddenCity">
                                    </div>
                                    <label class="control-label col-md-2">
                                        Postcode<span class="required">*</span>
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control"
                                               name="Postcode" value="@Model.Item1.Postcode" id="Postcode" @classViewReadOnly>
                                        <input type="hidden" class="form-control"
                                               name="HiddenPostcode" value="@Model.Item1.Postcode" id="HiddenPostcode">
                                    </div>

                                </div>
                                <div class="form-group divCountry">
                                    <label class="control-label col-md-2 ">
                                        State
