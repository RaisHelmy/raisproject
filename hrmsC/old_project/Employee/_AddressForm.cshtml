                                               name="HiddenState" id="HiddenState" value="@Model.Item1.State">
                                        <input type="hidden" name="StateCode" id="StateCode" value="@Model.Item1.StateCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="StateName" name="StateName" value="@Model.Item1.State" readonly="readonly" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="StateName" id="StateName" value="@Model.Item1.State" />
                                            <select tabindex="0" id="ddlState" class="form-control" @classViewReadOnly></select>
                                        }
                                    </div>
                                    <label class="control-label col-md-2 ">
                                        Country<span class="required">*</span>
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenCountry" id="HiddenCountry" value="@Model.Item1.Country">
                                        <input type="hidden" name="CountryCode" id="CountryCode" value="@Model.Item1.CountryCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="CountryName" name="CountryName" value="@Model.Item1.Country" readonly="readonly" @classViewReadOnly />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="CountryName" id="CountryName" value="@Model.Item1.Country" />
                                            <select tabindex="0" id="ddlCountry" class="form-control" @classViewReadOnly></select>
                                        }
                                    </div>
                                </div>

                                @if (Model.Item1.AddressTypeCode == "OO")
                                { }
                                else
                                {
                                    <div class="form-group divPhoneNo1">
                                        <label class="control-label col-md-2 ">
                                            Phone No. 1
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <input type="text" class="form-control" MaxLength="20"
                                                   name="PhoneNo1" value="@Model.Item1.PhoneNo1" id="PhoneNo1" @classViewReadOnly>
                                            <input type="hidden" class="form-control"
                                                   name="HiddenPhoneNo1" value="@Model.Item1.PhoneNo1" id="HiddenPhoneNo1">
                                        </div>
                                        <label class="control-label col-md-2 ">
                                            Phone No. 2
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <input type="text" class="form-control" MaxLength="20"
                                                   name="PhoneNo2" value="@Model.Item1.PhoneNo2" id="PhoneNo2" @classViewReadOnly>
                                            <input type="hidden" class="form-control"
                                                   name="HiddenPhoneNo2" value="@Model.Item1.PhoneNo2" id="HiddenPhoneNo2">
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div id="AddressSecretInformation" class="hidden">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Attach Man
                                        </label>
                                        <div class="col-md-4">
                                            <input id="AddressAttachMandatory" class="form-control" type="text" disabled value="false" />
                                        </div>
                                        <label class="control-label col-md-2">
                                            Attach Man (Default)
                                        </label>
                                        <div class="col-md-4">
                                            <input type="text" id="HiddenAddressAttachMandatory" class="form-control" disabled value="false" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Address Type
                                        </label>
                                        <div class="col-md-4">
                                            <input id="HiddenAddressType2" class="form-control" type="text" disabled value="@Model.Item1.AddressType" />
                                        </div>
                                        <label class="control-label col-md-2">
                                            AddressLine1
                                        </label>
                                        <div class="col-md-4">
                                            <input id="HiddenAddressLine12" class="form-control" type="text" disabled value="@Model.Item1.AddressLine1" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            AddressLine2
                                        </label>
                                        <div class="col-md-4">
                                            <input type="text" id="HiddenAddressLine22" class="form-control" disabled value="@Model.Item1.AddressLine2" />
                                        </div>
                                        <label class="control-label col-md-2">
                                            AddressLine3
                                        </label>
                                        <div class="col-md-4">
                                            <input id="HiddenAddressLine32" class="form-control" type="text" disabled value="@Model.Item1.AddressLine3" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Country
                                        </label>
                                        <div class="col-md-4">
                                            <input type="text" id="HiddenCountry2" class="form-control" disabled value="@Model.Item1.Country" />
                                        </div>
                                        <label class="control-label col-md-2">
                                            State
                                        </label>
                                        <div class="col-md-4">
                                            <input id="HiddenState2" class="form-control" type="text" disabled value="@Model.Item1.State" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            City
                                        </label>
                                        <div class="col-md-4">
                                            <input id="HiddenCity2" class="form-control" type="text" disabled value="@Model.Item1.City" />
                                        </div>
                                        <label class="control-label col-md-2">
                                            Postcode
                                        </label>
                                        <div class="col-md-4">
                                            <input type="text" id="HiddenPostcode2" class="form-control" disabled value="@Model.Item1.Postcode" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            PhoneNo1
                                        </label>
                                        <div class="col-md-4">
                                            <input type="text" id="HiddenPhone12" class="form-control" disabled value="@Model.Item1.PhoneNo1" />
                                        </div>
                                        <label class="control-label col-md-2">
                                            PhoneNo2
                                        </label>
                                        <div class="col-md-4">
                                            <input id="HiddenPhone22" class="form-control" type="text" disabled value="@Model.Item1.PhoneNo2" />
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
