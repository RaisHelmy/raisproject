</div>

@*script Main Function *@
<script type="text/javascript">
    function LoadFormConfiguration()
    {
        $("#divEPM_Modal #AttachmentSessionName").val("@ViewBag.AttachmentSessionName");
        $("#divEPM_Modal #AttachmentSourceType").val("@ViewBag.AttachmentSourceType");

        //$('#divEPM_Modal #ddlAddressType').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#divEPM_Modal #ddlCountry').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});

        //$('#divEPM_Modal #ddlState').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});
        
        @if (Create)
        {
             @Html.Raw("RetrieveAddressTypeOptions();");
        }

        @Html.Raw("RetrieveCountryOptions();");
        @Html.Raw("RetrieveStateOptions();");

    }

    function LoadFormOnChange() {

        $('#divEPM_Modal #ddlAddressType').change(function () {
            // if changed to, for example, the last option, then
            // $(this).find('option:selected').text() == D
            // $(this).val() == 4
            // get whatever value you want into a variable
            var HiddenAddressTypeValue = $("#divEPM_Modal #ddlAddressType option:selected").val() + "";
            var HiddenAddressTypeText = $("#divEPM_Modal #ddlAddressType option:selected").text() + "";

            // and update the hidden input's value
            $('#divEPM_Modal #AddressTypeName').val(HiddenAddressTypeText);
            $('#divEPM_Modal #AddressTypeCode').val(HiddenAddressTypeValue);
        });

        $('#divEPM_Modal #ddlCountry').change(function () {
            // if changed to, for example, the last option, then
            // $(this).find('option:selected').text() == D
            // $(this).val() == 4
            // get whatever value you want into a variable
            var HiddenCountryValue = $("#divEPM_Modal #ddlCountry option:selected").val() + "";
            var HiddenCountryText = $("#divEPM_Modal #ddlCountry option:selected").text() + "";

            // and update the hidden input's value
            $('#divEPM_Modal #CountryName').val(HiddenCountryText);
            $('#divEPM_Modal #CountryCode').val(HiddenCountryValue);

            RetrieveStateOptions();
            $('#divEPM_Modal #StateCode').val("");
            $('#divEPM_Modal #StateName').val("");
        });

        $('#divEPM_Modal #ddlState').change(function () {
            // if changed to, for example, the last option, then
            // $(this).find('option:selected').text() == D
            // $(this).val() == 4
            // get whatever value you want into a variable
            var HiddenStateValue = $("#divEPM_Modal #ddlState option:selected").val() + "";
            var HiddenStateText = $("#divEPM_Modal #ddlState option:selected").text() + "";

            // and update the hidden input's value
            $('#divEPM_Modal #StateName').val(HiddenStateText);
            $('#divEPM_Modal #StateCode').val(HiddenStateValue);
        });
    }
</script>

@*script Sub Function -->Get DDL Value *@
<script type="text/javascript">
    function RetrieveAddressTypeOptions() {
        var EmployeeCode = $("#divEPM_Modal #EmployeeCode").val() + "";
        var url = '@Url.Action("GetAddressTypeOptions", "Employee")?employeeCode=' + EmployeeCode;
        $.get(url, function (result) {
            AddressType = result;
            PopulateAddressType();
        });
    }

    function RetrieveCountryOptions() {
        $.get('@Url.Action("GetCountryOptions", "Employee")', function (result) {
            Country = result;
            PopulateCountry();
        });
    }

    function RetrieveStateOptions() {
        var CountryCode = $("#divEPM_Modal #CountryCode").val() + "";
        var url = '@Url.Action("GetStateOptions", "Employee")?countryCode=' + CountryCode;
        $.get(url, function (result) {
            State = result;
            PopulateState();
        });
    }

    // Populate Address Type dropdown
    function PopulateAddressType() {
        var ddlAddressType = $('#divEPM_Modal #ddlAddressType');

        var i = 0;
        ddlAddressType.empty();
        ddlAddressType.append('<option value="" selected="selected"> - Please Select - </option>');
        for (i = 0; i < AddressType.length; i++) {
            ddlAddressType.append('<option value="' + AddressType[i].Value + '">' + AddressType[i].Text + '</option>');
        }

        var selectedAddressTypeCode = $('input[name="AddressTypeCode"]');
        var selectedAddressTypeName = $('input[name="AddressTypeName"]');

        // Set dropdown value if has previous value available
        if (selectedAddressTypeCode.val()) {
            ddlAddressType.val(selectedAddressTypeCode.val());
        }

        //$('#divEPM_Modal #ddlAddressType').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});
    }

    // Populate Country dropdown
    function PopulateCountry() {
        var ddlCountry = $('#divEPM_Modal #ddlCountry');

        var i = 0;
        ddlCountry.empty();
        ddlCountry.append('<option value="" selected="selected"> - Please Select - </option>');
        for (i = 0; i < Country.length; i++) {
            ddlCountry.append('<option value="' + Country[i].Value + '">' + Country[i].Text + '</option>');
        }

        var selectedCountryCode = $('input[name="CountryCode"]');
        var selectedCountryName = $('input[name="CountryName"]');

        // Set dropdown value if has previous value available
        var checkSelectedCountryCode = "";
        // Check if has previous value available in DDL
        $('#divEPM_Modal #ddlCountry option').each(function () {
            if (this.value == selectedCountryCode.val()) {
                checkSelectedCountryCode = selectedCountryCode.val();
                return false;
            }
        });
        ddlCountry.val(checkSelectedCountryCode).change();

        //$('#divEPM_Modal #ddlCountry').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});
    }

    // Populate State dropdown
    function PopulateState() {
        var ddlState = $('#divEPM_Modal #ddlState');

        var i = 0;
        ddlState.empty();
        ddlState.append('<option value="" selected="selected"> - Please Select - </option>');
        for (i = 0; i < State.length; i++) {
            ddlState.append('<option value="' + State[i].Value + '">' + State[i].Text + '</option>');
        }

        var selectedStateCode = $('input[name="StateCode"]');
        var selectedStateName = $('input[name="StateName"]');

        // Set dropdown value if has previous value available
        if (selectedStateCode.val()) {
            ddlState.val(selectedStateCode.val());
        }

        //$('#divEPM_Modal #ddlState').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});
    }

</script>

@*script Submission Activity *@
<script type="text/javascript">

    function FormValidation(btn) {
        btn.disabled = true;

        var _ValidationMsg = '';
        var AddressTypeCode = $("#divEPM_Modal #AddressTypeCode").val() + ""; 
        var CountryCode = $("#divEPM_Modal #CountryCode").val() + ""; 
        var City = $("#divEPM_Modal #City").val() + ""; 
        var Postcode = $("#divEPM_Modal #Postcode").val() + "";
        var PhoneNo1 = $("#divEPM_Modal #PhoneNo1").val() + "";
        var PhoneNo2 = $("#divEPM_Modal #PhoneNo2").val() + "";

        var AddressAttachMandatory = $("#divEPM_Modal #AddressAttachMandatory").val() + "";
        var CreateONLY = "@Create";

        var CountTotal_Attachment = "";
        if (AddressAttachMandatory == "true") {
            CountTotal_Attachment = $("#divEPM_Modal #CountTotal_Attachment").val() + ""; 
        }
        // SubAttachment/_AttachmentListing

        if (AddressTypeCode == "") {
            _ValidationMsg += '- Address Type is required.\n';
        }

        if (PhoneNo1 != "") {

            var re = /^\d*$/;
            if (!re.test(PhoneNo1)) {
                // Wrong
                _ValidationMsg += '- Phone No. 1 is invalid.\n';
            }

        }

        if (PhoneNo2 != "") {

            var re = /^\d*$/;

            if (!re.test(PhoneNo2)) {
                // Wrong
                _ValidationMsg += '- Phone No. 2 is invalid.\n';
            }

        }

        if (CountryCode == "") {
            _ValidationMsg += '- Country is required.\n';
        }

        if (City == "") {
            _ValidationMsg += '- City is required.\n';
        }

        if (Postcode == "") {
            _ValidationMsg += '- Postcode is required.\n';
        }

        if (AddressAttachMandatory.toUpperCase() == "TRUE" && CreateONLY.toUpperCase() == "TRUE") {
            if (CountTotal_Attachment == "0") {
                _ValidationMsg += '- Attachment is required.\n';
            }
        }

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application. If you want to make changes, click Close.');
            $("#divLoading2").show();
            $("#ConfirmUpdate").modal('show');

        }
        btn.disabled = false;
    }

    function ConfirmAction_Address(btn, FormAction) {

        //at index page
        var _EmployeeID = $("#divEPM_Modal #EmployeeID").val() + "";
        var _createdBy = $("#divEPM_Modal #ActionerID").val() + "";

        var _AddressTypeSelectedValue = $("#divEPM_Modal #AddressTypeCode").val() + "";
        var _AddressTypeSelectedText = $("#divEPM_Modal #AddressTypeName").val() + "";
        var _AddressLine1 = $("#divEPM_Modal #AddressLine1").val() + "";
        var _AddressLine2 = $("#divEPM_Modal #AddressLine2").val() + "";
        var _AddressLine3 = $("#divEPM_Modal #AddressLine3").val() + "";
        var _CountrySelectedValue = $("#divEPM_Modal #CountryCode").val() + "";
        var _CountrySelectedText = $("#divEPM_Modal #CountryName").val() + "";
        var _StateSelectedValue = $("#divEPM_Modal #StateCode").val() + "";
        var _StateSelectedText = $("#divEPM_Modal #StateName").val() + "";
        var _City = $("#divEPM_Modal #City").val() + "";
        var _Postcode = $("#divEPM_Modal #Postcode").val() + "";
        var _PhoneNo1 = $("#divEPM_Modal #PhoneNo1").val() + "";
        var _PhoneNo2 = $("#divEPM_Modal #PhoneNo2").val() + "";

        var _AddressAttachMandatory = $("#divEPM_Modal #AddressAttachMandatory").val() + "";
        var _AttachmentSessionName = $("#divEPM_Modal #AttachmentSessionName").val() + "";
        var _AttachmentSourceType = $("#divEPM_Modal #AttachmentSourceType").val() + "";
        var _AttachmentCategory = "@EmployeeCategory_Address" + "";

        var _HiddenAddressType = $("#divEPM_Modal #HiddenAddressType").val() + "";
        var _HiddenAddress1 = $("#divEPM_Modal #HiddenAddressLine1").val() + "";
        var _HiddenAddress2 = $("#divEPM_Modal #HiddenAddressLine2").val() + "";
        var _HiddenAddress3 = $("#divEPM_Modal #HiddenAddressLine3").val() + "";
        var _HiddenCountry = $("#divEPM_Modal #HiddenCountry").val() + "";
        var _HiddenState = $("#divEPM_Modal #HiddenState").val() + "";
        var _HiddenCity = $("#divEPM_Modal #HiddenCity").val() + "";
        var _HiddenPostcode = $("#divEPM_Modal #HiddenPostcode").val() + "";
        var _HiddenPhoneNo1 = $("#divEPM_Modal #HiddenPhoneNo1").val() + "";
        var _HiddenPhoneNo2 = $("#divEPM_Modal #HiddenPhoneNo2").val() + "";

        var Url = "";

        if (FormAction.toUpperCase() == "INSERT") {
            var form = {
                EmployeeID: _EmployeeID,
                AddressTypeSelectedValue: _AddressTypeSelectedValue,
                AddressTypeSelectedText: _AddressTypeSelectedText,
                Address1: _AddressLine1,
                Address2: _AddressLine2,
                Address3: _AddressLine3,
                CountrySelectedValue: _CountrySelectedValue,
                CountrySelectedText: _CountrySelectedText,
                StateSelectedValue: _StateSelectedValue,
                StateSelectedText: _StateSelectedText,
                City: _City,
                Postcode: _Postcode,
                PhoneNo1: _PhoneNo1,
                PhoneNo2: _PhoneNo2,
                createdBy: _createdBy
            };
            ResultMsg = "The request (Add Address Information) has been successfully submitted.";
            Url = '@Url.Content("~/Employee/SubmitAddressForm")';
        }
        else if (FormAction.toUpperCase() == "EDIT") {
            var form = {
                EmployeeID: _EmployeeID,
                AddressTypeSelectedValue: _AddressTypeSelectedValue,
                AddressTypeSelectedText: _AddressTypeSelectedText,
                Address1: _AddressLine1,
                Address2: _AddressLine2,
                Address3: _AddressLine3,
                CountrySelectedValue: _CountrySelectedValue,
                CountrySelectedText: _CountrySelectedText,
                StateSelectedValue: _StateSelectedValue,
                StateSelectedText: _StateSelectedText,
                City: _City,
                Postcode: _Postcode,
                PhoneNo1: _PhoneNo1,
                PhoneNo2: _PhoneNo2,
                createdBy: _createdBy,
                HiddenAddress1: _HiddenAddress1,
                HiddenAddress2: _HiddenAddress2,
                HiddenAddress3: _HiddenAddress3,
                HiddenCountry: _HiddenCountry,
                HiddenState: _HiddenState,
                HiddenCity: _HiddenCity,
                HiddenPostcode: _HiddenPostcode,
                HiddenPhoneNo1: _HiddenPhoneNo1,
                HiddenPhoneNo2: _HiddenPhoneNo2
            };

            ResultMsg = "The request (Edit Address Information) has been successfully submitted.";
            Url = '@Url.Content("~/Employee/UpdateAddressForm")';
        }

        if ($('#divLoading').is(':visible')) {

            $.ajax({
                type: "POST",
                url: Url,
                cache: false,
                async: false,
                dataType: "json",
                data: form,
                success: function (result) {
                    if (result.Success) {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").show();

                        ResultMsg += "<br/><br/>Request No: <label class='refno'>" + result.RequestNo + "</label>";
                        $(".Success-body .well").html(ResultMsg);
                        $("#SuccessSubmit").modal();

                        $("#btnOK").click(function () { RedirectTo(FormAction.toUpperCase()); });
                    }
                    else {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $("#divLoading2").hide();
                        btn.disabled = false;

                        alert(result.ErrorMsg);

                    }
                },
                error: function (e) {

                }
            });
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "INSERT":
                location.reload();
                break;
            case "EDIT":
                location.reload();
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }

    function AllowEdit_Address(btn, FormAction) {

        var EmployeeCode = "@Model.Item1.EmployeeCode";
        var EmployeeID = "@Model.Item1.EmployeeID";

        var AddressType = "@Model.Item1.AddressTypeCode";
        var Action = 'Edit';



        $("#divEPM_Modal #FormCategory").val("@module");
        $("#divEPM_Modal #FormAction").val(Action);
        var url = "@Url.Content("~/Employee/_AddressForm")";
        var data = {
            EmployeeCode: EmployeeCode,
            EmployeeID: EmployeeID,
            AddressType: AddressType,
            Mode: Action
        };
        btn.disabled = false;
        OpenEditPanel('Edit Address Info', Action, url, data)
    }


</script>

@*Script Load Form Function*@
<script type="text/javascript">
    function ReformatDate(edate, Type) {
        try {
            if (edate.length > 0)
            {
                var myDate = $.datepicker.parseDate("dd/mm/yy", edate);
                var d = myDate.getDate();
                var m = myDate.getMonth();
                m += 1;
                var y = myDate.getFullYear();

                var newdate = (y + "-" + m + "-" + d);
                return newdate;
            }
            return "";
        }

        catch (e) {
            var Error = "ERROR";
            //alert('Invalid Date Format ('+Type+')' + e);
            //alert(e);
            return Error;
        }

    }

</script>

