@model ESS.Core.EmployeeDetailsSummary

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Employee Details
                </div>
                <div class="tools">
                    <a href="javascript:;" class="collapse" id="hidePersonalInfo"></a>
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Employee No.
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_EmployeeCodeRO">@Model.EmployeeCode</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Company
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_CompanyRO">@Model.CompanyCode - @Model.Company</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Employee Name
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_EmployeeNameRO">@Model.EmployeeName</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Division / Department
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_DepartmentRO">@Model.Department</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Position
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_PositionRO">@Model.Position</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Unit / Section
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_UnitSectionRO">@Model.UnitSection</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Payscale Group
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_ManagerRO">@Model.PayScaleGroup</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>