@model List<ESS.Employee.Models.Report>
@using ESS.Employee.Models;
@using atQuest.Utilities;
@using ESS.Employee;
@{
	Layout = null;
	string StatusCSS = "green";
}
<div class="portlet box blue">
	<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
	<div class="portlet-title">
		<div class="caption">
			<i class="fa fa-reorder"></i>Report Result
		</div>
		<input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />
		<div class="tools">
		</div>
	</div>
	<div class="portlet-body form">
		<div class="form-body">
			<div class="form-horizontal">
				<div class="table-toolbar">
					<table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
						<thead>
							<tr>
								<th></th>
								<th>Reference No</th>
								<th>Employee</th>
								<th>Category</th>
								<th>Type</th>
								<th>Status</th>
								<th>Created Date</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in @Model)
							{
								<tr>
									<td>
										<a class="btn blue btn-sm" href="@Url.Content("~/Employee/HistoryDetail")?RequestID=@item.RequestID">
											<i class="fa fa-search"></i>
										</a>
									</td>
									<td>@item.ReferenceNo</td>
									<td>@item.Employee</td>
									<td>@item.CategoryCode</td>
									<td>@item.TypeCode</td>
									@{
										string CheckStatus = item.StatusCode;
										StatusCSS = "green";
										if (CheckStatus == RequestStatus.Declined.ToString() ||
																	CheckStatus == Helper.SplitText(RequestStatus.SystemError.ToString()) ||
																	CheckStatus == RequestStatus.Withdrawn.ToString() ||
																	CheckStatus == RequestStatus.Failed.ToString())
										{
											StatusCSS = "red";
										}
									}
									<td style="color:@StatusCSS;"><b>@Helper.SplitText(item.StatusCode)</b></td>
									<td>
										@Service.FormatDateInNumber(item.CreatedDate, "dd/MM/yyyy")
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<script type="text/javascript">
	transformTable("#tblResult");
</script>



