<script>
    $('.ViewAttachment').click(function (e) {
        e.preventDefault();
        var DetailID = $(this).attr('data-DetailID');

        var EmployeeID = $("#EmployeeID").val();

        var Action = 'View';

        $("#FormCategory").val("@module");
        $("#FormAction").val(Action);
        var url="@Url.Content("~/Employee/GetAttachment")";
        var data = {
            EmployeeID: EmployeeID,
            DetailID: DetailID,
        };

        $('#FormModal').modal();
        $("#ConfirmationDialog_Title").html("View Supporting Document");
        $("#_Form").html("LOADING...");

        $("#divLoading").show();

        $.ajax({
            type: "GET",
            url: url,
            //   link.NavigateUrl = "javascript:openWindow('ProfileEmergency.aspx?EmployeeID=" + profileID + "&FamilyNo=" + familyNo + "', 'ProfileEmergency', '700', '370')";
            cache: false,
            dataType: "html",
            data: data,
            success: function (content) {
                $("#_Form").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });

        setTimeout(function () { $("#divLoading").hide(); }, 1000);
    });
</script>