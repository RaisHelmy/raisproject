@model List<ESS.Employee.Models.EmployeeRequestDetail>
@using ESS.Employee;
@{
    string ID = "";
    string module = "EmployeeRequestDetail";
}
<div class="form-body">
    <div class="form-horizontal">
        <div class="table-toolbar">

            <table id="tblResultRequestDetails" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th>Field Name</th>
                        <th>Old Value</th>
                        <th>New Value</th>
                        <th>Supporting Doc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in @Model)
                    {
                        <tr>
                            <td>
                                @((string.IsNullOrEmpty(item.FieldName)) ? "-" : item.FieldName)
                            </td>
                           
                            <td>
                                @{ 
                                    string OldValue = item.OldValue;
                                    if (item.FieldName.Contains("Date"))
                                    {

                                        DateTime isOldValue = DateTime.Now;
                                        if (!String.IsNullOrEmpty(OldValue + ""))
                                        {
                                            isOldValue = DateTime.ParseExact(OldValue + "", "yyyy/MM/dd",
                                              System.Globalization.CultureInfo.InvariantCulture);
                                            OldValue = isOldValue.ToString("dd/MM/yyyy");
                                        }

                                    }
                                }

                                @((string.IsNullOrEmpty(OldValue)) ? "-" : OldValue)
                                
                            </td>
                            <td>
                                @{
                                    string NewValue = item.NewValue;
                                    if (item.FieldName.Contains("Date"))
                                    {

                                        DateTime isNewValue = DateTime.Now;
                                        if (!String.IsNullOrEmpty(NewValue + ""))
                                        {
                                            isNewValue = DateTime.ParseExact(NewValue + "", "yyyy/MM/dd",
                                              System.Globalization.CultureInfo.InvariantCulture);
                                            NewValue = isNewValue.ToString("dd/MM/yyyy");
                                        }

                                    }
                                }

                                @((string.IsNullOrEmpty(NewValue)) ? "-" : NewValue)
                            </td>
                            <td>
                                @if (item.Documents == 0)
                                {
                                    @item.Documents;
                                }
                                else
                                {
                                    <a href="#HistoryDetail" class="ViewAttachment"
                                       data-DetailID="@item.DetailID">
                                        @item.Documents
                                    </a>
                                }
                                
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

