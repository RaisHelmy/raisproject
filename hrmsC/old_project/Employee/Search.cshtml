@*script Retrieve DDL AJAX *@
<script type="text/javascript">
    function RetrieveGroupOptions() {
        $.get('@Url.Action("GetGroupOptions", "Employee")', function (result) {
            Group = result;
            PopulateGroup();
        });
    }

    function RetrieveSubGroupOptions() {
        //Code and Text same value.
        var GroupCode = $("#GroupCode").val() + "";
        var url = '@Url.Action("GetSubGroupOptions", "Employee")?GroupName=' + GroupCode;
        $.get(url, function (result) {
            SubGroup = result;
            PopulateSubGroup();
        });
    }


    function RetrieveDivisionOptions() {
        $.get('@Url.Action("GetCompanyOptions", "Employee")', function (result) {
            Division = result;
            PopulateDivision();
        });
    }

    function RetrieveDepartmentOptions() {
        var CompanyCode = $("#DivisionCode").val() + "";
        var url = '@Url.Action("GetDepartmentOptions", "Employee")?CompanyCode=' + CompanyCode;
        $.get(url, function (result) {
            Department = result;
            PopulateDepartment();
        });
    }

    function RetrieveUnitSectionOptions() {
        var DepartmentCode = $("#DepartmentCode").val() + "";
        var url = '@Url.Action("GetUnitSectionOptions", "Employee")?DepartmentCode=' + DepartmentCode;
        $.get(url, function (result) {
            UnitSection = result;
            PopulateUnitSection();
        });
    }

    function RetrieveEducationOptions() {
        $.get('@Url.Action("GetEducationEstablishmentOptions", "Employee")', function (result) {
            Education = result;
            PopulateEducation();
        });
    }
</script>

@*script Populate DDL *@
<script type="text/javascript">
    // Populate Group dropdown
    function PopulateGroup() {
        var ddlGroup = $('#ddlGroup');

        var i = 0;
        ddlGroup.empty();
        ddlGroup.append('<option value="" selected="selected"> - All - </option>');
        for (i = 0; i < Group.length; i++) {
            ddlGroup.append('<option value="' + Group[i].Value + '">' + Group[i].Text + '</option>');
        }

        var selectedGroupCode = $('input[name="GroupCode"]');
        var selectedGroupName = $('input[name="GroupName"]');

        // Set dropdown value if has previous value available
        if (selectedGroupCode.val()) {
            ddlGroup.val(selectedGroupCode.val());
        }

        //$('#ddlGroup').select2({
        //    showSearchInput: false,
        //    minimumResultsForSearch: -1
        //});
    }

