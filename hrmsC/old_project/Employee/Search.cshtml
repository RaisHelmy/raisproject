@model List<ESS.Core.DropDownObject>
@{
    ViewBag.Title = "TNB Employee Search";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");

    bool employeeSearchVisible = ViewBag.EmployeeSearch;
}
 

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Employee Search<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee No.</label>
