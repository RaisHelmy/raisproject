                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee Group</label>
                    <div class="col-md-8 form-control-static">
                        <input type="hidden" name="GroupCode" id="GroupCode" value="" />
                        <input type="hidden" name="GroupName" id="GroupName" value="" />
                        <select tabindex="0" id="ddlGroup" class="form-control"></select>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-md-6">
