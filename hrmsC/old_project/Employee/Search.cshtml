@*script Clear Filter and get listing *@
<script type="text/javascript">
    function SearchListing() {
        var _EmployeeCode = $('#EmployeeNo').val();
        var _EmployeeName = $('#EmployeeName').val();
        var _GroupName = $('#GroupCode').val();
        var _SubGroupName = $('#SubGroupCode').val();
        var _PayScaleGroup = $('#PayScaleGroup').val();
        var _CompanyCode = $('#DivisionCode').val();
        var _AreaCode = $('#DepartmentCode').val();
        var _SubAreaCode = $('#UnitSectionCode').val();
        var _PassportNo = $('#PassportNo').val();
        var _NewIC = $('#NewIC').val();
        var _OldIC = $('#OldIC').val();
        var _JobKeyName = $('#Duty').val();
        var _PositionName = $('#Position').val();
        var _Education = $('#EducationName').val();
        var _EducationCode = $('#EducationCode').val();
        var _BirthdayMonth = $('#MonthName').val();
        var _BirthdayMonthCode = $('#MonthCode').val();
        var _OfficeMobile = $('#OfficialHPNo').val();

        if (_BirthdayMonthCode == "")
        {
            _BirthdayMonth = "";
        }

        if (_EducationCode == "") {
            _Education = "";
        }

        var form = {
            EmployeeCode: _EmployeeCode,
            EmployeeName: _EmployeeName,
            GroupName: _GroupName,
            SubGroupName: _SubGroupName,
            PayScaleGroup: _PayScaleGroup,
            CompanyCode: _CompanyCode,
            AreaCode: _AreaCode,
            SubAreaCode: _SubAreaCode,
            PassportNo: _PassportNo,
            NewIC: _NewIC,
            OldIC: _OldIC,
            JobKeyName: _JobKeyName,
            PositionName: _PositionName,
            Education: _Education,
            OfficeMobile: _OfficeMobile,
            BirthdayMonth: _BirthdayMonth

        };

        $("#divLoading").show();

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Employee/_SearchResult")',
            cache: false,
            dataType: "html",
            data: form,
            success: function (content) {
                $("#divLoading").hide();
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
                $("#divLoading").hide();
            }
        });
    }


    function ClearFilter() {
        $('#EmployeeNo').val("");
        $('#EmployeeName').val("");
        $('#ddlGroup').val("").change();
        $('#ddlSubGroup').val("").change();
        $('#PayScaleGroup').val("");
        $('#ddlDivision').val("").change();
        $('#ddlDepartment').val("").change();
        $('#ddlUnitSection').val("").change();
        $('#PassportNo').val("");
        $('#NewIC').val("");
        $('#OldIC').val("");
        $('#Duty').val("");
        $('#Position').val("");
        $('#ddlEducation').val("").change();
        $('#ddlMonth').val("").change();
        $('#OfficialHPNo').val("");
        SearchListing();
    }
</script>

