@model List<SEP.RoutingManagement.Models.GetApprovalAuditLog>
@{
    Layout = null;
}

<div class="row" id="trAuditLog">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>
                    Audit Log
                </div>
                <div class="tools">
                    <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="table-toolbar">
                            <table id="tblAuditLog" class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        <th style="width:15%;">Action By</th>
                                        <th style="width:15%;">Date</th>
                                        <th style="width:15%;">Activity</th>
                                        <th style="width:15%;">Action</th>
                                        <th style="width:40%;">Comment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model)
                                    {
                                        <tr>
                                            <td>@log.EmployeeName</td>
                                            <td>@log.FormattedDate</td>
                                            <td>@log.ActivityName</td>
                                            <td>@log.ActivityAction</td>
                                            <td style="white-space:pre-line;">@log.Comment</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    $(function () {
        $('#tblAuditLog').DataTable({
            "bLengthChange": false,
            "bFilter": false,
            "bPaginate": false,
            "bInfo": false,
            "bSort": false
        });
    });
</script>

