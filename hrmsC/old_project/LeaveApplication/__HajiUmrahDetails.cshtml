@model LeaveApplication.Models.LeaveApplicationVM

@*Brand new form*@
@if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR")
    && Model.LeaveID == Guid.Empty)
{
    <div class="row haji umrah">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Departure Airport <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="DepartureAirport">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Return Airport <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="ReturnAirport">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row haji umrah">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Departure Flight No. <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="DepartureFlightNo">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Return Flight No. <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="ReturnFlightNo">
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@*Opening a draft*@
else if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR" ||
          Model.LeaveStatus == "Cancelled" || Model.LeaveStatus == "CA" ||
          Model.LeaveStatus == "Withdrawn" || Model.LeaveStatus == "WD")
          && Model.LeaveID != Guid.Empty)
{
    <div class="row haji umrah">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Departure Airport <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="DepartureAirport" value="@Model.DepartureAirport">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Return Airport <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="ReturnAirport" value="@Model.ReturnAirport">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row haji umrah">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Departure Flight No. <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="DepartureFlightNo" value="@Model.DepartureFlightNo">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Return Flight No. <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="ReturnFlightNo" value="@Model.ReturnFlightNo">
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row haji umrah">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Departure Airport</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="DepartureAirport" value="@Model.DepartureAirport">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Return Airport</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="ReturnAirport" value="@Model.ReturnAirport">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row haji umrah">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Departure Flight No.</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="DepartureFlightNo" value="@Model.DepartureFlightNo">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Return Flight No.</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="ReturnFlightNo" value="@Model.ReturnFlightNo">
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    $(function () {
        InitializeCommonControls();
    });
</script>