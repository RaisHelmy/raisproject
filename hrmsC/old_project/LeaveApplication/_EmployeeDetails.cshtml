@model ESS.Core.EmployeeDetailsSummary

@{
    ViewBag.Title = "_EmployeeDetails";
    Layout = "";
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Employee Details
                </div>
                <div class="tools">
                    <a id="subtypeToggle" title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div class="portlet-body form">
				<div class="form-body" id="ct00_CustomFieldFormView">
					<div class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5">
										Date of Birth
									</label>
									<div class="col-md-7 form-control-static">
										<label id="EmployeeDateOfBirth">@Model.BirthDate.ToString("dd/MM/yyyy")</label>
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5">
										Last Promo
									</label>
									<div class="col-md-7 form-control-static">
										<label id="EmployeeLastPromo">@(string.IsNullOrEmpty(Model.LastPromotionDate + "")?"-":Model.LastPromotionDate.Value.ToString("dd/MM/yyyy"))</label>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5 ">
										Joined Date (Contract)
									</label>
									<div class="col-md-7  form-control-static">
										@if (Model.ContractJoinDate != DateTime.MinValue)
										{
											@Model.ContractJoinDate.ToString("dd/MM/yyyy");
										}
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5">
										Position
									</label>
									<div class="col-md-7 form-control-static">
										<label id="EmployeePosition">@Model.Position</label>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5 ">
										Joined Date (Permanent)
									</label>
									<div class="col-md-7  form-control-static">
										@if (Model.PermanentJoinDate != DateTime.MinValue)
										{
											@Model.PermanentJoinDate.ToString("dd/MM/yyyy");
										}
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5">
										Job
									</label>
									<div class="col-md-7 form-control-static">
										<label id="EmployeeJob">@Model.JobKeyName</label>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5">
										Retirement Date
									</label>
									<div class="col-md-7 form-control-static">
										<label id="EmployeeRetirementDate">@Model.RetirementDate.ToString("dd/MM/yyyy")</label>
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5">
										Pay scale group
									</label>
									<div class="col-md-7 form-control-static">
										<label id="EmployeePayScaleGroup">@Model.PayScaleGroup</label>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5">
										Retirement Age
									</label>
									<div class="col-md-7 form-control-static">
										<label id="EmployeeRetirementAge">@Model.RetirementAge</label>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
            </div>
        </div>
    </div>
</div>

