@model List<LeaveApplication.Models.HRSSCReportViewModel>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>HRSSC SLA Report
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel">
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Division</th>
                                <th>Leave Subtype</th>
                                <th>Submission Date</th>
                                <th>Receive Date</th>
                                <th>Completed Date</th>
                                <th>Status</th>
                                <th>Number of Working Days</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Action("Index", "LeaveApplication", new { LeaveID = item.LeaveID, Source = "History" })">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                    <td>@item.LeaveNo</td>
                                    <td>@item.EmployeeCode - @item.EmployeeName</td>
                                    <td>@item.Division</td>
                                    <td>@item.LeaveSubtypeName</td>
                                    <td>@item.SubmissionDate</td>
                                    <td>@item.HRSSCReceiveDate</td>
                                    <td>@item.CompletedDate</td>
                                    @if (@item.LeaveStatus == "Declined" || @item.LeaveStatus == "Withdrawn" || @item.LeaveStatus == "Cancelled" ||
                                         @item.LeaveStatus == "DE"       || @item.LeaveStatus == "WD"        || @item.LeaveStatus == "CA")
                                    {
                                        <td style="color:red;"><b>@item.LeaveStatus</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.LeaveStatus</b></td>
                                    }

                                    <td>@item.NumberOfWorkingDays</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<table id="tblExport" border="1" style="display: none;">
    <thead>
        <tr>
            <th>Reference No.</th>
            <th>Employee</th>
            <th>Leave Subtype</th>
            <th>Submission Date</th>
            <th>Receive Date</th>
            <th>Completed Date</th>
            <th>Status</th>
            <th>Number of Working Days</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>@item.LeaveNo</td>
            <td>@item.EmployeeCode - @item.EmployeeName</td>
            <td>@item.LeaveSubtypeName</td>
            <td>@item.SubmissionDate</td>
            <td>@item.HRSSCReceiveDate</td>
            <td>@item.CompletedDate</td>
            <td>@item.LeaveStatus</td>
            <td>@item.NumberOfWorkingDays</td>
        </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
    $(function () {
        $('#tblResult').dataTable({
            "bDestroy": true,
            //"aLengthMenu": [
            //    [10, 15, 20, -1],
            //    [10, 15, 20, "All"]
            //],
            //// set the initial value
            //"iDisplayLength": 10,

            "sPaginationType": "bootstrap",
            "oLanguage": {
                "sLengthMenu": "_MENU_ records",
                "oPaginate": {
                    "sPrevious": "Prev",
                    "sNext": "Next"
                }
            },
            "aoColumnDefs": [
                { "sType": "date-dmy", "aTargets": [4, 5] }],
            //disable init sorting
            "aaSorting": []


        });
    });

    $(function () {
        BindExport();
    });
</script>
