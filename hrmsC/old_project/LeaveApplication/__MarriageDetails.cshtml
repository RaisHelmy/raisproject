@model LeaveApplication.Models.LeaveApplicationVM

@*Brand new form*@
@if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR")
    && Model.LeaveID == Guid.Empty)
{
    <div class="row Marriage">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Register / Nikah Date <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control RegisterDate" id="RegisterDate" name="RegisterDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row Marriage">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Spouse Name <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="SpouseName">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Spouse IC <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="SpouseIC">
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@*Opening a draft*@
else if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR" ||
          Model.LeaveStatus == "Cancelled" || Model.LeaveStatus == "CA" ||
          Model.LeaveStatus == "Withdrawn" || Model.LeaveStatus == "WD")
          && Model.LeaveID != Guid.Empty)
{
    <div class="row Marriage">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Register / Nikah Date <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control RegisterDate" id="RegisterDate" name="RegisterDate" value="@Model.RegisterDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row Marriage">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Spouse Name <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="SpouseName" value="@Model.SpouseName">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Spouse IC <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="SpouseIC" value="@Model.SpouseIC">
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row Marriage">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Register / Nikah Date</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control RegisterDate" readonly
                               id="RegisterDate" name="RegisterDate" value="@Model.RegisterDate" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row Marriage">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Spouse Name</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="SpouseName" value="@Model.SpouseName">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Spouse IC</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="SpouseIC" value="@Model.SpouseIC">
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    $(function () {
        InitializeCommonControls();
    });
</script>