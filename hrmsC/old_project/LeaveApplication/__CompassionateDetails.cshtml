@model LeaveApplication.Models.LeaveApplicationVM

@*Brand new form*@
@if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR")
    && Model.LeaveID == Guid.Empty)
{
    <div class="row Compassionate">
        <div class="col-md-12">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-2">
                        Date of Death <span style="color:red;"> *</span>
                    </label>
                    <div class="col-md-4 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control DeathDate" id="DeathDate" name="DeathDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                    <label class="control-label col-md-2">Relationship <span style="color:red;"> *</span></label>
                    <input type="hidden" name="Relationship" />
                    <div class="col-md-4 form-control-static">
                        <select id="ddlRelationship" class="form-control" onchange="_CompassionateDetails_RelationshipChanged()">
                            <option value="" selected="selected">- Please Select -</option>
                            <option value="Pasangan (Suami/Isteri)">Pasangan (Suami/Isteri)</option>
                            <option value="Anak">Anak</option>
                            <option value="Ibu/Bapa">Ibu/Bapa</option>
                            <option value="Ibu/Bapa Mertua">Ibu/Bapa Mertua</option>
                            <option value="Adik beradik">Adik beradik</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
    @*Opening a draft*@
else if ((Model.LeaveStatus == "Draft"      || Model.LeaveStatus == "DR" ||
          Model.LeaveStatus == "Cancelled"  || Model.LeaveStatus == "CA" ||
          Model.LeaveStatus == "Withdrawn"  || Model.LeaveStatus == "WD") 
          && Model.LeaveID != Guid.Empty)
{
    <div class="row Compassionate">
        <div class="col-md-12">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-2">
                        Date of Death <span style="color:red;"> *</span>
                    </label>
                    <div class="col-md-4 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control DeathDate" id="DeathDate" name="DeathDate" value="@Model.DeathDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>

                    <label class="control-label col-md-2">Relationship <span style="color:red;"> *</span></label>
                    <input type="hidden" name="Relationship" value="@Model.Relationship" />
                    <div class="col-md-4 form-control-static">
                        <select id="ddlRelationship" class="form-control" onchange="_CompassionateDetails_RelationshipChanged()">
                            <option value="" selected="selected">- Please Select -</option>
                            <option value="Pasangan (Suami/Isteri)">Pasangan (Suami/Isteri)</option>
                            <option value="Anak">Anak</option>
                            <option value="Ibu/Bapa">Ibu/Bapa</option>
                            <option value="Ibu/Bapa Mertua">Ibu/Bapa Mertua</option>
                            <option value="Adik beradik">Adik beradik</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row Compassionate">
        <div class="col-md-12">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-2">
                        Date of Death
                    </label>
                    <div class="col-md-4 form-control-static">
                        <input type="text" class="form-control" readonly
                               id="DeathDate" name="DeathDate" value="@Model.DeathDate">
                    </div>

                    <label class="control-label col-md-2">Relationship</label>
                    <div class="col-md-4 form-control-static">
                        <input type="text" class="form-control" readonly
                               id="Relationship" name="Relationship" value="@Model.Relationship">
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function _CompassionateDetails_RelationshipChanged() {
        $('input[name="Relationship"]').val($('#ddlRelationship').val());
    }

    $(function () {
        InitializeCommonControls();
        $('#ddlRelationship').val($('input[name="Relationship"]').val());
    });
</script>