@model LeaveApplication.Models.LeaveApplicationVM

@*Brand new form*@
@if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR")
    && Model.LeaveID == Guid.Empty)
{
    <div class="row Outstation-Transfer">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Old Office Location <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="OldOfficeLoc">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">New Office Location <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="NewOfficeLoc">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row iring-keluarga-sakit">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Report to Duty Date <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control ReportToDutyDate" id="ReportToDutyDate" name="ReportToDutyDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Distance (KM) <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control number-only"
                               name="Distance">
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@*Opening a draft*@
else if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR" ||
          Model.LeaveStatus == "Cancelled" || Model.LeaveStatus == "CA" ||
          Model.LeaveStatus == "Withdrawn" || Model.LeaveStatus == "WD")
          && Model.LeaveID != Guid.Empty)
{
    <div class="row Outstation-Transfer">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Old Office Location <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="OldOfficeLoc" value="@Model.OldOfficeLoc">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">New Office Location <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="NewOfficeLoc" value="@Model.NewOfficeLoc">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row iring-keluarga-sakit">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Report to Duty Date <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control ReportToDutyDate" id="ReportToDutyDate" name="ReportToDutyDate" 
                                    value="@Model.ReportToDutyDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Distance (KM) <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" 
                               name="Distance" value="@Model.Distance">
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row Outstation-Transfer">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Old Office Location</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="OldOfficeLoc" value="@Model.OldOfficeLoc">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">New Office Location</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="NewOfficeLoc" value="@Model.NewOfficeLoc">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row iring-keluarga-sakit">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Report to Duty Date</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control ReportToDutyDate" readonly
                               id="ReportToDutyDate" name="ReportToDutyDate" value="@Model.ReportToDutyDate" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Distance (KM)</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="Distance" value="@Model.Distance">
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    $(function () {
        InitializeCommonControls();
    });
</script>