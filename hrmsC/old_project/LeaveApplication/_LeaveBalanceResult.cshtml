@model List<LeaveApplication.Models.LeaveBalance>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My Leave Balance
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th>Leave Type</th>
                                <th>Entitlement</th>
                                <th>Opsyen</th>
                                <th>Leave Taken</th>
                                <th>Leave Approved</th>
                                <th>Balance</th>
                                <th>Leave Pending</th>
                                <th>Available</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.LeaveTypeName</td>
                                    <td>@item.Entitlement</td>
                                    <td>
                                        @if (item.IsOpsyenValid)
                                        {
                                            @item.Opsyen
                                        }
                                        else{
                                            @(" - ")
                                        }
                                    </td>
                                    <td>@item.LeaveTaken</td>
                                    <td>@item.LeaveApproved</td>
                                    <td>@item.Balance</td>
                                    <td>@item.LeavePending</td>
                                    <td>@item.Available</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>
