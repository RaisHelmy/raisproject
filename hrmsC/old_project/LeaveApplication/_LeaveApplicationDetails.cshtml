@model LeaveApplication.Models.LeaveApplicationVM
@{
    Layout = null;
    string MinResubmitDay = Model.StartDate;
    string MaxResubmitDay = Model.EndDate;

    string CurrentUserID = ViewBag.CurrentUserID;
    string CurrentApprovalID = string.IsNullOrEmpty(Model.ApproverID) ? "" : Model.ApproverID;
    string IsCurrentApproval = CurrentApprovalID.Contains(ViewBag.CurrentUserID) ? "true" : "false";
    bool IsSubmitter = CurrentUserID == Model.EmployeeID;
}

<style>
    .leave-fullwidth-dropdown {
        width: 100%;
    }

    input[name=LeaveStatusDescription] {
        font-weight: bold;
    }

    .ulLeaveSubtype li {
        cursor: pointer;
        padding: 5px 10px;
        min-width: 150px;
        list-style-type: none;
    }

    .ulLeaveSubtype {
        border-left: 1px solid #999999;
        border-right: 1px solid #999999;
        border-bottom: 1px solid #999999;
        padding: 0;
        position: absolute;
        background-color: white;
        z-index: 9;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Application Details
                    <a href="#" onclick="window.open('http://livewire.tnb.com.my/sites/ghr/downloads/Pages/BorangPekeliling.aspx')" title="Link to Pekeliling">
                        <img src="../../images/info16by16.gif" />
                    </a>
                </div>
                <div class="tools">
                    <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div class="portlet-body form">
                @*Brand new form*@
                @if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR") && Model.IsNewRecord)
                {
                    <div class="form-body">
                        <div class="row" style="display : none;">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Reference No.</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control" readonly style="font-weight:bold; color:blue;"
                                                   name="LeaveNo" value="@Model.LeaveNo">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Leave Status</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="LeaveStatus" value="@Model.LeaveStatus" />

                                            @if (Model.LeaveStatus == "Declined" || Model.LeaveStatus == "Withdrawn" || Model.LeaveStatus == "Cancelled" ||
                                                 Model.LeaveStatus == "DE" || Model.LeaveStatus == "WD" || Model.LeaveStatus == "CA")
                                            {
                                                <input type="text" class="form-control" readonly style="color: red;"
                                                       name="LeaveStatusDescription" value="@Model.LeaveStatusDescription">
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" readonly style="color:green;"
                                                       name="LeaveStatusDescription" value="@Model.LeaveStatusDescription">
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Leave Type <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="LeaveTypeCode" />
                                            <input type="hidden" name="LeaveTypeName" />
                                            <select tabindex="0" id="ddlLeaveType" class="form-control" onchange="OnLeaveTypeChanged(); PopulateLeaveSubtype(); TransitionFocus('ddlLeaveSubtype');"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Leave Subtype <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="LeaveSubtypeCode" />
                                            <input type="hidden" name="LeaveSubtypeName" />
                                            <select tabindex="0" id="ddlLeaveSubtype" class="form-control">
                                                <option value=""> - Please Select - </option>
                                            </select>
                                            <div class="ulLeaveSubtypeDiv" style="display:none">
                                                <ul class="ulLeaveSubtype">
                                                    <li data-value=""> - Please Select - </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row EmployeePicker" style="display : none;">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee</label>
                                        <div class="col-md-8 form-control-static">
                                            @Html.Action("_PeoplePickerExt", "PeoplePicker", new { CurrEmpID = Model.Submiter.ID, SearchType = "TwoLevelSubordinates" })
                                            @*PeoplePicker hiddenfieldid = hfEmpID, textboxid =txtEmpName*@

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Start Date & End Date-->
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Start Date <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <div class="input-group date start-date-picker" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control StartDate" id="StartDate" name="StartDate" onchange="UpdateTotalDays(event);TransitionFocus('btnEndDate');" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnStartDate" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </div>

                                        <label class="control-label col-md-2">
                                            End Date <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <div class="input-group date end-date-picker" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control EndDate" id="EndDate" name="EndDate" onchange="UpdateTotalDays(event);TransitionFocus('ddlLeaveReason');" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnEndDate" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Available / Balance</label>
                                        <div class="col-md-8 form-control-static">
                                            @*<input type="text" id="LeaveBalanceInfo" class="form-control" readonly
                                                style="background: white url('@Url.Content("/_layouts/15/images/info16by16.gif")') right no-repeat; cursor: pointer; background-position: 95%;">*@
                                            <label name="LeaveBalanceInfo" id="LeaveBalanceInfo" style="padding: 5px 15px;"></label>
                                            <img id="imgBalanceInfo" src="/_layouts/15/images/info16by16.gif" alt="leaveInfo" title="">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Total Days</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" id="TotalDay" class="form-control" readonly
                                                   name="TotalDay" value="@Model.TotalDay">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="divExtraFields">
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Reason <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="Reason" />
                                            <select id="ddlLeaveReason" class="form-control" onchange="OnLeaveReasonChanged();"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Description/Comment <span style="color: red; display: none" id='spanComment'> *</span></label>
                                        <div class="col-md-10 form-control-static">
                                            @Html.TextAreaFor(m => m.Comment, new { @class = "form-control", rows = "5", maxlength = 2000 })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @*Opening a draft/ withdrawn or cancelled leave*@
                else if (Model.IsEditable && !Model.IsNewRecord && IsSubmitter)
                {
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Reference No.</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control" readonly style="font-weight:bold; color:blue"
                                                   name="LeaveNo" value="@Model.LeaveNo">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Leave Status</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="LeaveStatus" value="@Model.LeaveStatus" />
                                            @if (Model.LeaveStatus == "Declined" || Model.LeaveStatus == "Withdrawn" || Model.LeaveStatus == "Cancelled" ||
                                                 Model.LeaveStatus == "DE" || Model.LeaveStatus == "WD" || Model.LeaveStatus == "CA")
                                            {
                                                <input type="text" class="form-control" readonly style="color: red;"
                                                       name="LeaveStatusDescription" value="@Model.LeaveStatusDescription">
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" readonly style="color:green;"
                                                       name="LeaveStatusDescription" value="@Model.LeaveStatusDescription">
                                            }


                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR")
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Leave Type <span style="color:red;"> *</span> </label>
                                            <div class="col-md-8 form-control-static">
                                                <input type="hidden" name="LeaveTypeCode" value="@Model.LeaveTypeCode" />
                                                <input type="hidden" name="LeaveTypeName" value="@Model.LeaveTypeName" />
                                                <select tabindex="0" id="ddlLeaveType" class="form-control" onchange="OnLeaveTypeChanged();PopulateLeaveSubtype();TransitionFocus('ddlLeaveSubtype');"></select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Leave Subtype <span style="color:red;"> *</span> </label>
                                            <div class="col-md-8 form-control-static">
                                                <input type="hidden" name="LeaveSubtypeCode" value="@Model.LeaveSubtypeCode" />
                                                <input type="hidden" name="LeaveSubtypeName" value="@Model.LeaveSubtypeName" />
                                                <select tabindex="0" id="ddlLeaveSubtype" class="form-control">
                                                    <option value=""> - Please Select - </option>
                                                </select>
                                                <div class="ulLeaveSubtypeDiv" style="display:none">
                                                    <ul class="ulLeaveSubtype">
                                                        <li data-value=""> - Please Select - </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Leave Type</label>
                                            <div class="col-md-8 form-control-static">
                                                <input type="hidden" name="LeaveTypeCode" value="@Model.LeaveTypeCode" />
                                                <input type="hidden" name="LeaveTypeName" value="@Model.LeaveTypeName" />
                                                <input type="text" class="form-control" readonly
                                                       value="@Model.LeaveTypeName">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Leave Subtype</label>
                                            <div class="col-md-8 form-control-static">
                                                <input type="hidden" name="LeaveSubtypeCode" value="@Model.LeaveSubtypeCode" />
                                                <input type="hidden" name="LeaveSubtypeName" value="@Model.LeaveSubtypeName" />
                                                <input type="text" class="form-control" readonly
                                                       value="@Model.LeaveSubtypeName">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }


                        <div class="row EmployeePicker" style="display : none;">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee</label>
                                        <div class="col-md-8 form-control-static">
                                            @Html.Action("_PeoplePickerExt", "PeoplePicker", new { CurrEmpID = Model.Submiter.ID, SearchType = "TwoLevelSubordinates" })
                                            @*PeoplePicker hiddenfieldid = hfEmpID, textboxid =txtEmpName*@

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Start Date & End Date-->
                        <input type="hidden" value="@Model.StartDate" id="MinResubmitDate" />
                        <input type="hidden" value="@Model.EndDate" id="MaxResubmitDate" />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Start Date <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <div class="input-group date start-date-picker" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control StartDate"
                                                       id="StartDate" name="StartDate" value="@Model.StartDate" onchange="UpdateTotalDays(event);TransitionFocus('btnEndDate');" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnStartDate" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </div>

                                        <label class="control-label col-md-2">
                                            End Date <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <div class="input-group date end-date-picker" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control EndDate"
                                                       id="EndDate" name="EndDate" value="@Model.EndDate" onchange="UpdateTotalDays(event);TransitionFocus('ddlLeaveReason');" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnEndDate" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Available / Balance</label>
                                        <div class="col-md-8 form-control-static">
                                            @*<input type="text" id="LeaveBalanceInfo" class="form-control" readonly
                                                style="background: white url('@Url.Content("/_layouts/15/images/info16by16.gif")') right no-repeat; cursor: pointer; background-position: 95%;">*@
                                            <label name="LeaveBalanceInfo" id="LeaveBalanceInfo" style="padding: 5px 15px;"></label>
                                            <img id="imgBalanceInfo" src="/_layouts/15/images/info16by16.gif" alt="leaveInfo" title="">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Total Days</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" id="TotalDay" class="form-control" readonly
                                                   name="TotalDay" value="@Model.TotalDay">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="divExtraFields">
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Reason <span style="color:red;"> *</span> </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="Reason" value="@Model.Reason" />
                                            <select id="ddlLeaveReason" class="form-control" onchange="OnLeaveReasonChanged();"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Description/Comment <span style="color: red; display: none" id='spanComment'> *</span></label>
                                        <div class="col-md-10 form-control-static">
                                            @Html.TextAreaFor(m => m.Comment, new { @Value = Model.Comment, @class = "form-control", rows = "5", maxlength = 2000 })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                // View Mode
                else
                {
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Reference No.</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control" readonly style="font-weight:bold; color:blue"
                                                   name="LeaveNo" value="@Model.LeaveNo">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Leave Status</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="LeaveStatus" value="@Model.LeaveStatus" />
                                            @if (Model.LeaveStatus == "Declined" || Model.LeaveStatus == "Withdrawn" || Model.LeaveStatus == "Cancelled" ||
                                                 Model.LeaveStatus == "DE" || Model.LeaveStatus == "WD" || Model.LeaveStatus == "CA")
                                            {
                                                <input type="text" class="form-control" readonly style="color: red;"
                                                       name="LeaveStatusDescription" value="@Model.LeaveStatusDescription">
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" readonly style="color:green;"
                                                       name="LeaveStatusDescription" value="@Model.LeaveStatusDescription">
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                        @if (!String.IsNullOrEmpty(Model.ApproverName))
                        {

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Current Approver</label>
                                            <div class="col-md-8 form-control-static">
                                                <input type="hidden" name="ApproverID" value="@Model.ApproverID" />
                                                <input type="hidden" name="ApproverName" value="@Model.ApproverName" />
                                                <input type="text" class="form-control" readonly
                                                       value="@Model.ApproverName" title="@Model.ApproverName">

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Leave Type</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="LeaveTypeCode" value="@Model.LeaveTypeCode" />
                                            <input type="hidden" name="LeaveTypeName" value="@Model.LeaveTypeName" />
                                            <input type="text" class="form-control" readonly
                                                   value="@Model.LeaveTypeName">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Leave Subtype</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="LeaveSubtypeCode" value="@Model.LeaveSubtypeCode" />
                                            <input type="hidden" name="LeaveSubtypeName" value="@Model.LeaveSubtypeName" />
                                            <input type="text" class="form-control" readonly
                                                   value="@Model.LeaveSubtypeName">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row EmployeePicker" style="display : none;">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Employee
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <input type="text" class="form-control" readonly
                                                   id="txtEmpName" value="@(Model.Submiter.EmployeeCode + " - " + Model.Submiter.EmployeeName)">
                                            <input type="hidden" name="EmployeeID" value="@Model.EmployeeID" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (IsCurrentApproval == "false" ||
                                                                            (Model.LeaveStatus == "PC" || Model.LeaveStatus == "Pending Cancellation"))
                        {
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">
                                                Start Date
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <input type="text" class="form-control" readonly
                                                       id="StartDate" name="StartDate" value="@Model.StartDate">
                                            </div>

                                            <label class="control-label col-md-2">
                                                End Date
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <input type="text" class="form-control" readonly
                                                       id="EndDate" name="EndDate" value="@Model.EndDate">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">
                                                Start Date
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <div class="input-group date start-date-picker" data-date-format="dd/mm/yyyy">
                                                    <input type="text" class="form-control StartDate"
                                                           id="StartDate" name="StartDate" value="@Model.StartDate" onchange="UpdateTotalDays(event);" />
                                                    <span class="input-group-btn">
                                                        <button type="button" id="btnStartDate" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </div>

                                            <label class="control-label col-md-2">
                                                End Date
                                            </label>
                                            <div class="col-md-4 form-control-static">
