                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Description/Comment</label>
                                        <div class="col-md-10 form-control-static">
                                            @Html.TextAreaFor(m => m.Comment, new { @Value = @Model.Comment, @class = "form-control", rows = "5", maxlength = 2000, @readonly = "readonly" })
