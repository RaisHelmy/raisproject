                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Available / Balance</label>
                                        <div class="col-md-8 form-control-static">
                                            @*<input type="text" id="LeaveBalanceInfo" class="form-control" readonly
                                                style="background: white url('@Url.Content("/_layouts/15/images/info16by16.gif")') right no-repeat; cursor: pointer; background-position: 95%;">*@
                                            <label name="LeaveBalanceInfo" id="LeaveBalanceInfo" style="padding: 5px 15px;"></label>
                                            <img id="imgBalanceInfo" src="/_layouts/15/images/info16by16.gif" alt="leaveInfo" title="">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Total Days</label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" id="TotalDay" class="form-control" readonly
                                                   name="TotalDay" value="@Model.TotalDay">
                                        </div>
