@model LeaveApplication.Models.LeaveApplicationVM

@*Brand new form*@
@if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR")
    && Model.LeaveID == Guid.Empty)
{
    <div class="row Paternity">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Date of Birth <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control DateOfBirth" id="DateOfBirth" name="DateOfBirth" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Place of Birth <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="PlaceOfBirth">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row Paternity">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">State of Birth <span style="color:red;"> *</span></label>
                    <input type="hidden" name="StateOfBirth" />
                    <div class="col-md-8 form-control-static">
                        <select id="ddlStateOfBirth" class="form-control" onchange="_PaternityDetails_StateOfBirthChanged()">
                            <option value="" selected="selected">- Please Select -</option>
                            <option value="Kuala Lumpur">Kuala Lumpur</option>
                            <option value="Selangor">Selangor</option>
                            <option value="Sarawak">Sarawak</option>
                            <option value="Johor">Johor</option>
                            <option value="Sabah">Sabah</option>
                            <option value="Penang">Penang</option>
                            <option value="Perak">Perak</option>
                            <option value="Pahang">Pahang</option>
                            <option value="Negeri Sembilan">Negeri Sembilan</option>
                            <option value="Kedah">Kedah</option>
                            <option value="Melaka">Melaka</option>
                            <option value="Terengganu">Terengganu</option>
                            <option value="Kelantan">Kelantan</option>
                            <option value="Perlis">Perlis</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@*Opening a draft*@
else if ((Model.LeaveStatus == "Draft" || Model.LeaveStatus == "DR" ||
          Model.LeaveStatus == "Cancelled" || Model.LeaveStatus == "CA" ||
          Model.LeaveStatus == "Withdrawn" || Model.LeaveStatus == "WD")
          && Model.LeaveID != Guid.Empty)
{
    <div class="row Paternity">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Date of Birth <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input type="text" class="form-control DateOfBirth" id="DateOfBirth" name="DateOfBirth" value="@Model.DateOfBirth" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Place of Birth <span style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control"
                               name="PlaceOfBirth" value="@Model.PlaceOfBirth">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row Paternity">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">State of Birth <span style="color:red;"> *</span></label>
                    <input type="hidden" name="StateOfBirth" value="@Model.StateOfBirth" />
                    <div class="col-md-8 form-control-static">
                        <select id="ddlStateOfBirth" class="form-control" onchange="_PaternityDetails_StateOfBirthChanged()">
                            <option value="" selected="selected">- Please Select -</option>
                            <option value="Kuala Lumpur">Kuala Lumpur</option>
                            <option value="Selangor">Selangor</option>
                            <option value="Sarawak">Sarawak</option>
                            <option value="Johor">Johor</option>
                            <option value="Sabah">Sabah</option>
                            <option value="Penang">Penang</option>
                            <option value="Perak">Perak</option>
                            <option value="Pahang">Pahang</option>
                            <option value="Negeri Sembilan">Negeri Sembilan</option>
                            <option value="Kedah">Kedah</option>
                            <option value="Melaka">Melaka</option>
                            <option value="Terengganu">Terengganu</option>
                            <option value="Kelantan">Kelantan</option>
                            <option value="Perlis">Perlis</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row Paternity">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Date of Birth</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="DateOfBirth" value="@Model.DateOfBirth">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Place of Birth</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="PlaceOfBirth" value="@Model.PlaceOfBirth">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row Paternity">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">State of Birth</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" readonly
                               name="StateOfBirth" value="@Model.StateOfBirth">
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function _PaternityDetails_StateOfBirthChanged() {
        $('input[name="StateOfBirth"]').val($('#ddlStateOfBirth').val());
    }

    $(function () {
        InitializeCommonControls();
        $('#ddlStateOfBirth').val($('input[name="StateOfBirth"]').val());
    });
</script>