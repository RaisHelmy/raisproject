@using ESS.Core;

@model ESS.Core.EmployeeDetailsSummary

@{
    string RequestID = Request.QueryString["ID"];

    <div class="portlet box blue">
        <div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-reorder"></i>Employee Details
            </div>
        </div>
        <div class="portlet-body form">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Employee No.</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.DisplayFor(x => x.EmployeeCode)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Division</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.DisplayFor(x => x.Division)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Employee Name</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.DisplayFor(x => x.EmployeeName)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Department</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.DisplayFor(x => x.Department)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Position</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.DisplayFor(x => x.Position)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Unit/Section</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.DisplayFor(x => x.UnitSection)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Immediate Manager</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.DisplayFor(x => x.ImmediateManager)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Current Approver</label>
                                <div class="col-md-8 form-control-static">
                                    @*@Common.GetCurrentApproverName(RequestID)*@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}