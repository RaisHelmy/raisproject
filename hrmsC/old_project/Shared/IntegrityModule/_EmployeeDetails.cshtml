@model Integrity.Models.EmployeeDetails
@{
    Layout = null;
}

<input type="hidden" name="EmployeeID" value="@Model.EmployeeID" />
<input type="hidden" name="EmployeeDetails.EmployeeCode" value="@Model.EmployeeCode" />
<input type="hidden" name="EmployeeDetails.EmployeeName" value="@Model.EmployeeName" />
<input type="hidden" name="EmployeeDetails.AreaCode" value="@Model.AreaCode" />
<input type="hidden" name="EmployeeDetails.AreaName" value="@Model.AreaName" />
<input type="hidden" name="EmployeeDetails.Age" value="@Model.Age" />
<input type="hidden" name="EmployeeDetails.Duty" value="@Model.Duty" />
<input type="hidden" name="EmployeeDetails.ManagerCode" value="@Model.ManagerCode" />
<input type="hidden" name="EmployeeDetails.ManagerName" value="@Model.ManagerName" />
<input type="hidden" name="EmployeeDetails.PayScaleGroup" value="@Model.PayScaleGroup" />
<input type="hidden" name="EmployeeDetails.PositionCode" value="@Model.PositionCode" />
<input type="hidden" name="EmployeeDetails.PositionName" value="@Model.PositionName" />
<input type="hidden" name="EmployeeDetails.SubAreaCode" value="@Model.SubAreaCode" />
<input type="hidden" name="EmployeeDetails.SubAreaName" value="@Model.SubAreaName" />

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Employee Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Profile Picture
                                    </label>
                                    <div class="col-md-2 form-control-static">
                                        <img src="@(String.IsNullOrEmpty(Model.PhotoID) ? 
                                                    Url.Content("~/Assets/img/fb-profile.jpg") : 
                                                    Url.Content("~/Api/FileWebApi?id=" + Model.PhotoID))" 
                                             class="img-thumbnail" style="padding: 0px;" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Number
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.EmployeeCode
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.EmployeeName

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Position
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.PositionName
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Duty
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.Duty
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Department
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.AreaName
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Unit/Section
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.SubAreaName
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Joined Date
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @{
                                            if (Model.JoinDate != null)
                                            {
                                                @Model.JoinDate.Value.ToString("dd/MM/yyyy")
                                            }
                                            else
                                            {
                                                <text> - </text>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Manager
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.ManagerName
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Current Grade
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.PayScaleGroup
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Age
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.Age
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




