
@{
    Layout = null;

    string CategoryCode = ViewData["CategoryCode"] + "";
    string CategoryDesc = ViewData["CategoryDesc"] + "";
    string PickMode = ViewData["Mode"] + "";
    string TrainingType = ViewData["Type"] + "";
    string paramCategoryTypeCode = ViewData["paramCategoryTypeCode"] + "";
}
@if (string.IsNullOrEmpty(PickMode) || PickMode == "Draft")
{
    if (paramCategoryTypeCode != "I")
    {
        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-4 ">
                            Course Title <span id="lvTypeMan" style="color:red;"> *</span>
                        </label>
                        <div class="col-md-8 form-control-static">
                            <div class="input-group">
                                <input type="text" class="form-control" id="txtCourseSessionID" placeholder="BE Number" title="BE Number" />
                                <span class="input-group-btn" id="btnSearch" style="">
                                    <btn data-toggle="modal" class="btn default" onclick="GetCourseDetailByCourseSessionID()"><i class="fa fa-search"></i></btn>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12 form-control-static">
                            <div class="input-group">
                                <input type="text" class="form-control" id="CPCourseTitle" readonly />
                                <span class="input-group-btn" id="btnLookUp" style="">
                                    <btn data-toggle="modal" class="btn default" onclick="clearCoursePickerResult()"><i class="fa fa-search"></i></btn>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-4 ">
                            Course Title <span id="lvTypeMan" style="color:red;"> *</span>
                        </label>
                        <div class="col-md-8 form-control-static">
                            <div class="input-group">
                                <input type="text" class="form-control" id="CPCourseTitle" readonly />
                                <span class="input-group-btn" id="btnLookUp" style="">
                                    <btn data-toggle="modal" class="btn default" onclick="clearCoursePickerResult()"><i class="fa fa-search"></i></btn>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-2">
                        Course Title <span id="lvTypeMan" style="color:red;"> *</span>
                    </label>
                    <div class="col-md-10 form-control-static">
                        <input type="text" class="form-control" id="CPCourseTitle" readonly />
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<input type="hidden" id="hfCourseID" name="hfCourseID" />
<input type="hidden" id="hfCourseSessionID" name="hfCourseSessionID" />

