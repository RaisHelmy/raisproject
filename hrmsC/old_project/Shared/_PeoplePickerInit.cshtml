
@{
    string SearchType = string.Empty;
    if (ViewData["SearchType"] != null)
    {
        SearchType = ViewData["SearchType"].ToString();
    }
}

<div class="modal fade" id="PeoplePicker" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">People Picker - Select By Employee Number or Name</h4>
            </div>
            <div class="modal-body">
                <div>
                    @Html.Action("Index", "PeoplePicker", new { SearchType = SearchType })
                </div>
            </div>
            <div class="modal-footer">
                <button id="PPSelect" type="button" class="btn default green" onclick="">Select</button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

