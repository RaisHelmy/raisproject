@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Word Document</title>
        
    <style> 

        body, form {
            margin: 0; 
        }

        textarea {
            font-size: 11px;
            font-family: verdana,arial,helvetica,sans-serif;
        }

        select {
            font-size: 11px;
            font-family: verdana,arial,helvetica,sans-serif;
        }

        input {
            font-size: 11px;
            font-family: verdana,arial,helvetica,sans-serif;
        }

        body {
            background-color: #FFFFFF;
            font-family: verdana,arial,helvetica,sans-serif;
            font-size: 11px;
            color: #000000;
        }

        .FormSection {
            width: 100%;
            padding: 4px;
            border: solid 1px #888888;
            /*text-align: center;*/
        }

        .FormSectionHeader {
            font-size: 11px;
            width: 100%;
            padding: 4px;
            color: black;
            /* background-image: url("/_layouts/images/calnumBttn.gif"); */
            /*background-image: url("/_layouts/images/calnumBttn_green.gif");*/
            font-weight: bold;
        }

            .FormSectionHeader A {
                font-weight: bold;
            }


        .FormSectionInfo, .FormSectionWarning, .FormSectionError, .FormSectionQuestion {
            font-size: 11px;
            width: 100%;
            color: #000000;
            border: solid 1px #000000;
            background-color: #f0f0f0;
        }

            .FormSectionInfo td, .FormSectionWarning td, .FormSectionError td, .FormSectionQuestion td {
                font-size: 11px;
                color: #000000;
                padding: 4px;
            }

        .FormLabel {
            font-size: 11px;
            font-weight: bold;
            vertical-align: top;
            /*width:25%;*/
            padding: 2px;
        }

        .FormText {
            font-size: 11px;
            font-weight: normal;
            vertical-align: top;
            padding: 2px;
            /*width:35%;*/
        }

        .required {
            padding-left: 3px;
            color: Red;
        }

        .status {
            color: #22BB22;
            font-weight: bold;
        }

        .refno {
            color: #0000CC;
            font-weight: bold;
        }

        .red {
            color: #DD0000;
            font-weight: bold;
        }

        .blue {
            color: Blue;
            font-weight: bold;
        }

        TABLE .List {
            border: solid 1px #888888;
        }

        .List .Header {
            font-size: 11px;
            padding: 4px;
            font-weight: bold;
            background-color: #006600;
            color: White;
            text-align: center;
        }

            .List .Header A {
                font-size: 11px;
                padding: 4px;
                font-weight: bold;
                background-color: transparent;
                color: white;
                text-align: center;
            }

        .List .Item {
            font-size: 11px;
            background-color: White;
            color: black;
        }

        .List .Alternate {
            font-size: 11px;
            background-color: #EFF3FB;
            color: black;
        }

        .List .Alternate2 {
            font-size: 11px;
            background-color: #CED8F6;
            color: black;
        }


        .List .Pager {
            font-size: 11px;
            background-color: #006600;
            color: white;
            text-align: center;
        }

            .List .Pager SELECT {
                font-size: 11px;
            }

            .List .Pager A {
                font-size: 11px;
                color: white;
                font-weight: bold;
                text-decoration: none;
            }

        .List .Footer {
            font-size: 11px;
            color: White;
            font-weight: bold;
            background-color: Silver;
        }

            .List .Footer TD {
                padding: 4px;
            }

        .atQuest_CalendarBackColor {
            background-color: red;
        }

        .TableFooter {
            background-color: Silver;
            color: black;
            font-size: 11px;
            font-weight: bold;
            vertical-align: top;
            padding: 2px;
        }

        .TextAlignRight {
            text-align: right;
        }
         
    </style>

    <style type="text/css" media="print">
        .page {
            -webkit-transform: rotate(-90deg);
            -moz-transform: rotate(-90deg);
            filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);
        }
    </style>
     
</head>
<body>
    <div>
        @RenderBody()
    </div>
</body>
</html>