@model List<ESS.Core.PeoplePickerObject>
@{
    Layout = null;
}
<div class="table-toolbar">
    <table id="tblRoleEmployeePicker" class="table table-striped table-bordered table-hover table-full-width">
        <thead>
            <tr>
                <th></th>
                <th>Employee Number</th>
                <th>Employee Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in @Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="MultiPeoplePickerCheckbox form-control"
                               empID="@item.EmployeeID"
                               empname="@item.EmployeeName"
                               empcode="@item.EmployeeCode" />
                    </td>
                    <td class="EmployeeCode">@item.EmployeeCode</td>
                    <td class="EmployeeName">@item.EmployeeName</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    var tblRoleEmployeePicker = null;

    $(function () {
        tblRoleEmployeePicker = $('#tblRoleEmployeePicker').dataTable();
        tblRoleEmployeePicker.find('input[type=checkbox]').uniform();
        tblRoleEmployeePicker.on('draw.dt', function () {
            tblRoleEmployeePicker.find('input[type=checkbox]').uniform();
        });

        UpdatePickerCheckboxes();
    });

    function UpdatePickerCheckboxes() {
        //var selectedEmployees = getSelectedEmployees();

        //tblRoleEmployeePicker.fnGetNodes().forEach(function (val, index) {
        //    var empID = $(val).find('.MultiPeoplePickerCheckbox').attr('empID');

        //    if (selectedEmployees.indexOf(empID) >= 0) {
        //        $(val).find('.MultiPeoplePickerCheckbox').prop('checked', true);
        //        $(val).find('.MultiPeoplePickerCheckbox').prop('readonly', true);
        //    }
        //    else {
        //        $(val).find('.MultiPeoplePickerCheckbox').prop('checked', false);
        //        $(val).find('.MultiPeoplePickerCheckbox').prop('readonly', false);
        //    }
        //});

        tblRoleEmployeePicker.find('input[type=checkbox]').uniform();
    }
</script>
