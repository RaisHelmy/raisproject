@model Tuple<bool, List<DateTime> >
@*model.Item1 - ReadOnly*@
@*model.Item1 - SelectedDates*@

@{
    Layout = null;
    int DateCount = 0;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Overtime Planning In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var date in @Model.Item2)
                            {
                                <tr>
                                    <td>
                                        @DateCount.ToString()
                                    </td>
                                    <td>
                                        Selected Date
                                    </td>
                                    <td>
                                        Remove Date
                                    </td>
                                    
                                </tr>

                                @DateCount += 1;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>