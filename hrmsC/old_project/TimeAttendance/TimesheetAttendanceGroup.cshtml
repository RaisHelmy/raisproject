    function GetAccOTHours(EmployeeID, StartDate, Subtype, row)
    {
        if (Subtype === 'Overtime')
        {
            $.ajax({
                url: '../TimeAttendance/GetAccOTHours',
                type: 'POST',
                data: {
                    EmployeeID: EmployeeID,
                    StartDate: StartDate
                },
                success: function (result) {
                    if (result != undefined && result != '') {
                        totalHours = parseFloat(result);
                        var Hour = parseFloat(Math.round(totalHours * 100) / 100).toFixed(2);
                        $(row).find(".AccumulatedOTHours").val(Hour);
                    }
                }
            });
        }
        else {
            $(row).find(".AccumulatedOTHours").val('0.00');
        }
    }

    function GetTotalHours(EmployeeID, StartDate, EndDate, StartTime, EndTime, Subtype, row) {
        var totalHours = 0;

        $.ajax({
            url: '../TimeAttendance/GetTimesheetTotalHours',
            type: 'POST',
            data: {
                EmployeeID: EmployeeID,
                StartDate: StartDate,
                EndDate: EndDate,
                StartTime: StartTime,
                EndTime: EndTime,
                Subtype: Subtype
            },
            success: function (result) {
                if (result != undefined && result != '') {
                        totalHours = parseFloat(result);
                        var Hour = parseFloat(Math.round(totalHours * 100) / 100).toFixed(2);
                        $(row).find(".TotalHour").val(Hour);

                }
                else {
                    var StartDateTime = moment(StartDate + ' ' + StartTime, 'DD/MM/YYYY HH:mm');
                    var EndDateTime = moment(EndDate + ' ' + EndTime, 'DD/MM/YYYY HH:mm');

                    var duration = moment.duration(EndDateTime.diff(StartDateTime));
                    var diffHours = duration.asHours();
                    var Hour = parseFloat(Math.round(diffHours * 100) / 100).toFixed(2);
                    $(row).find(".TotalHour").val(Hour);
                    //the calculation above doesnt matter, just display 0 if no result from JSON
                    $(row).find(".TotalHour").val('0.00');
                }
            },
            error: function () {
                var StartDateTime = moment(StartDate + ' ' + StartTime, 'DD/MM/YYYY HH:mm');
                var EndDateTime = moment(EndDate + ' ' + EndTime, 'DD/MM/YYYY HH:mm');

                var duration = moment.duration(EndDateTime.diff(StartDateTime));
                var diffHours = duration.asHours();
                var Hour = parseFloat(Math.round(diffHours * 100) / 100).toFixed(2);
                $(row).find(".TotalHour").val(Hour);
            }
        });

    }

