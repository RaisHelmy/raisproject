            if (AttendanceSubtype == "Overtime") {
                $(row).find(".TCSNoDisplayText").siblings('.input-group-btn').css("pointer-events", "auto");
                $(row).find(".OTCodeDisplayText").siblings('.input-group-btn').css("pointer-events", "auto");
                $(row).find(".NoOfMeal").removeAttr('disabled');
            }
            else {
                $(row).find(".TCSNoDisplayText").siblings('.input-group-btn').css("pointer-events", "none");
                $(row).find(".TCSNoDisplayText").val('');
                $(row).find(".TCSNoPickerValue").val('');
                $(row).find(".OTCodeDisplayText").siblings('.input-group-btn').css("pointer-events", "none");
                $(row).find(".OTCodeDisplayText").val('');
                $(row).find(".OTCodePickerValue").val('');
                $(row).find(".NoOfMeal").attr('disabled', 'disabled');
                $(row).find(".NoOfMeal").val('');
            }
        });
    }

    function GetDDLInputValues() {
		$("#tblTimesheetEntry td input[type=checkbox].TimesheetCheckBox").each(function (i, value) {
            var row = $(this).closest("tr");
            var hfAttendanceSubType = row.find('.hfAttendanceSubtype');
            var AttendanceSubType = row.find('.AttendanceSubType');
            if (hfAttendanceSubType.val() != '' && hfAttendanceSubType.val() != undefined) {
                AttendanceSubType.val(hfAttendanceSubType.val());
            }

            var hfPremiumNo = row.find('.hfPremiumNo');
            var NoOfMeal = row.find('.NoOfMeal');
            if (hfPremiumNo.val() != '' && hfPremiumNo.val() != undefined) {
                NoOfMeal.val(hfPremiumNo.val());
            }
        });
    }

    function EASyNavigation(x) {
		var row = $($("#tblTimesheetEntry td input[type=checkbox].TimesheetCheckBox").get(x)).closest("tr");
        var StartDate = $(row).find(".StartDate").val();
        var EndDate = $(row).find(".EndDate").val();
        var EmployeeCode = $(row).find(".TSPeoplePickerCode").val();

        var DateTimeStartDate = moment(StartDate, "DD/MM/YYYY").add(-1, 'days');
        var DateTimeEndDate = moment(EndDate, "DD/MM/YYYY").add(+1, 'days');
        var newStartDate = DateTimeStartDate.format('YYYY-MM-DD');
        var newEndDate = DateTimeEndDate.format('YYYY-MM-DD');

        if ((newStartDate != '' && newStartDate != undefined) &&
            (newEndDate != '' && newEndDate != undefined) &&
            (EmployeeCode != '' && EmployeeCode != undefined)) {
            var EAsyPath = '../TimeAttendance/EASyDoorAccess' + '?employeeCode=' + EmployeeCode + '&StartDate=' + newStartDate + '&EndDate=' + newEndDate;
            window.open(EAsyPath);
        }
    }

    function loadRowTooltip($row) {

        var _Employee = $row.find(".TSPeoplePickerDisplay").val();
        var _StartDate = $row.find(".StartDate").val();
        var _StartTime = $row.find(".StartTime").val();
        var _EndDate = $row.find(".EndDate").val();
        var _EndTime = $row.find(".EndTime").val();
        var _Subtype = $row.find(".AttendanceSubType").val();

        if ((_StartDate != '' && _StartDate != undefined) &&
            (_StartTime != '' && _StartTime != undefined) &&
            (_EndDate != '' && _EndDate != undefined) &&
            (_EndTime != '' && _EndTime != undefined) &&
            (_Employee != '' && _Employee != undefined)) {

            $($row).qtip({
                content: createRowTooltips($row),
                position: {
                    target: 'mouse',
                    adjust: {
                        mouse: true
                    }
                },
                style: {
                    width: " + this.Width + ",
                    border: {
                        width: 2,
                        radius: 5,
                        color: '#CECECE'
                    },
                    padding: 5,
                    tip: true,
                    name: 'light'
                },
                show: {
                    event: 'mouseover'
                },
                hide: {
                    event: 'mouseout'
                }
            });

        }

    }


    function createRowTooltips($row) {

        var _ID = $row.find(".TimesheetID").val();
        var _Employee = $row.find(".TSPeoplePickerDisplay").val();
        var _StartDate = $row.find(".StartDate").val();
        var _StartTime = $row.find(".StartTime").val();
        var _EndDate = $row.find(".EndDate").val();
        var _EndTime = $row.find(".EndTime").val();
        var _Subtype = $row.find(".AttendanceSubType").val();

        var returnContent = '<table align="center">';
        //if (_StartDate != '' && _StartDate != undefined)
        //    returnContent += '<tr><td>Start Date    :   </td><td align=right>' + _StartDate + '</td></tr>'
        //if (_StartTime != '' && _StartTime != undefined)
        //    returnContent += '<tr><td>Start Time    :   </td><td align=right>' + _StartTime + '</td></tr>'
        //if (_EndDate != '' && _EndDate != undefined)
        //    returnContent += '<tr><td>End Date    :   </td><td align=right>' + _EndDate + '</td></tr>'
        //if (_EndTime != '' && _EndTime != undefined)
        //    returnContent += '<tr><td>End Time    :   </td><td align=right>' + _EndTime + '</td></tr>'
        //if (_Subtype != '' && _Subtype != undefined)
        //    returnContent += '<tr><td>SubType    :   </td><td align=right>' + _Subtype + '</td></tr>'
        returnContent += '<tr><td><input type="hidden" class="qtipID' + _ID +'"/>Employee    :   </td><td align=right>' + _Employee + '</td></tr>'
        returnContent += '<tr><td>Start Date    :   </td><td align=right>' + _StartDate + '</td></tr>'
        returnContent += '<tr><td>Start Time    :   </td><td align=right>' + _StartTime + '</td></tr>'
        returnContent += '<tr><td>End Date    :   </td><td align=right>' + _EndDate + '</td></tr>'
        returnContent += '<tr><td>End Time    :   </td><td align=right>' + _EndTime + '</td></tr>'
        returnContent += '<tr><td>SubType    :   </td><td align=right>' + _Subtype + '</td></tr>'
        returnContent += '</table > ';

        return returnContent;

    }

    function RowDisplayInfo() {
        var $row = $(this).closest("tr");
        loadRowTooltip($row);
    }

    function TableRowDisplayInfo() {
        $(".qtip").remove();
		$("#tblTimesheetEntry td input[type=checkbox].TimesheetCheckBox").each(function (i, value) {
            var $row = $(this).closest("tr");
            loadRowTooltip($row);
        });
    }

    function OnChangeRowDisplayInfo() {
        var row = $(this).closest("tr");
        var TimesheetID = row.find('.TimesheetID').val();
        $("input[class='qtipID" + TimesheetID + "']").closest('.qtip').remove();
        loadRowTooltip(row);
    }

    function InitiateRowDisplayInfo() {
        TableRowDisplayInfo();
        $('.RowTooltipDisplay').on('change', OnChangeRowDisplayInfo);
        $('.TSPeoplePickerDisplay').on('change', OnChangeRowDisplayInfo);
    }

