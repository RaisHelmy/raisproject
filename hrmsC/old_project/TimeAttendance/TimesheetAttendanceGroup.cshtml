                //console.log("Key is " + k + ", value is" + Message[k]);

				$("#tblTimesheetEntry td input[type=checkbox].TimesheetCheckBox").each(function (i, value) {
                    var row = $(this).closest("tr");
                    var EntryID = row.find('.TimesheetID').val()
                    if (k == EntryID) {
                        row.find('.ErrorMsg').attr('title', Message[k]);
                        row.find('.ErrorMsg').show();

                        return;
                    }
                });
            }
        }
    }

    function HandleValidOTCheckBox(Message) {
        $('#tblTimesheetEntry input[type="checkbox"].ValidOTCheckBox').each(function () {
            var elem = $(this);
            elem.prop('disabled', true);
            elem.parents('div.checker').addClass('disabled')
            elem.parents('td').removeAttr('style');
        });

        for (var k in Message) {
            if (Message.hasOwnProperty(k)) {
                var elem = $('#tblTimesheetEntry input[val2=' + k + '].ValidOTCheckBox')
                elem.prop('disabled', false);
                elem.parents('div.checker').removeClass('disabled')
                elem.parents('td').css('background-color', 'yellow');
            }
        }
    }

