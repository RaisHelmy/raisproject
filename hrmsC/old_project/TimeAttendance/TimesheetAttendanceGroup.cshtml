@model Tuple<List<TimeAttendance.Models.TimesheetAttendanceVM>, TimeAttendance.Models.EmployeeDetails, List<ESS.Core.DropDownObject>>
@{
    ViewBag.Title = "Timesheet Entry (Group)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string IsSupervisorMessage = ViewBag.IsSupervisor;
}

<style>
    .timeinput::-ms-clear {
        width: 0;
        height: 0;
    }
</style>

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                @ViewBag.Title
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>

@using (Html.BeginForm("TimesheetAttendanceGroup", "TimeAttendance", FormMethod.Post))
{

    <div id="tab_1" class="tab-pane active">
        @if (!string.IsNullOrEmpty(IsSupervisorMessage))
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="note note-danger">
                        <h4 class="block">
                            @IsSupervisorMessage
                        </h4>

                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle">@*<img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" />*@</div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Requestor Details
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Employee</label>
                                            <div class="col-md-8 form-control-static">
                                                @Model.Item2.EmployeeCode - @Model.Item2.EmployeeName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Division / Department</label>
                                            <div class="col-md-8 form-control-static">
                                                @Model.Item2.AreaName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Unit / Section</label>
                                            <div class="col-md-8 form-control-static">
                                                @Model.Item2.SubAreaName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Cost Center</label>
                                            <div class="col-md-8 form-control-static">
                                                @Model.Item2.CostCenterCode - @Model.Item2.CostCenterName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Immediate Manager</label>
                                            <div class="col-md-8 form-control-static">
                                                @Model.Item2.ManagerName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <input type="hidden" name="TimesheetSubAction" id="TimesheetSubAction" value="" />
        <input type="hidden" name="DeleteRow" value="" />
        <input type="hidden" name="AddRow" value="" />
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle">@*<img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" />*@</div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Timesheet Entry
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="row text-left form-body">
                                <div class="col-md-12">

                                    <div class="col-md-4">
                                        <label class="control-label col-md-4" style="padding-left:0px;">Subtype</label>
                                        <div class="form-control-static col-md-8" style="padding-top: 0; padding-left:0px;">
                                            <select class="form-control AttendanceSubTypeQuery" name="wsAttendanceSubType">
                                                <option value="">- All -</option>
                                                <option value="Normal Hour">Normal Hour</option>
                                                <option value="Overtime">Overtime</option>
                                            </select>
                                        </div>
                                        @*<input type="button" class="btn green" value="Reload" id="btnReload" onclick="$('form').submit();" />*@
                                    </div>
                                    <div class="col-md-4">
                                        <label class="control-label col-md-4">Start Date</label>
                                        <div class="input-group date date-picker col-md-8 wsDate" data-date-format="dd MM yyyy">
                                            <input type="text" class="form-control Date" id="WorkScheduleFromDate" name="WorkScheduleFromDate" value="@ViewBag.WorkScheduleFromDate" onchange="ReloadForm()" />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="control-label col-md-4">End Date</label>
                                        <div class="input-group date date-picker col-md-8 wsDate" data-date-format="dd MM yyyy">
                                            <input type="text" class="form-control Date" id="WorkScheduleToDate" name="WorkScheduleToDate" value="@ViewBag.WorkScheduleToDate" onchange="ReloadForm()" />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row  text-left form-body">
                                <div class="col-md-12">
                                    <div class="col-md-10">
                                        <input type="button" class="btn green" value="Bulk Overtime Entry" id="btnBulkOvertimeEntry" data-toggle="modal" href="#BulkOvertimeEntry" onclick="ClearBulkEntrySearch()" />
                                        <input type="button" class="btn green" value="Populate Normal Hours" id="btnPopulateNormalHours" data-toggle="modal" href="#PopulateWorkingHour" onclick="ClearNHSearch()" />
                                        <input type="button" class="btn green" value="Get Approved OT Planning" id="btnGetApprovedOTPlanning" data-toggle="modal" href="#GetApprovedOTPlanning" onclick="ClearOTPlanningSearch()" />
                                    </div>
                                    @*<div class="col-md-2">
                                        </div>
                                        <div class="col-md-2">
                                        </div>
                                        <div class="col-md-4">
                                        </div>*@
                                    <div class="col-md-2">
                                        <a href="@Url.Action("MyCalendar", "LeaveApplication")" target="_blank" style="float:right; padding-top:16px;">Show Working Hours</a>
                                    </div>
                                    @*<input type="button" class="btn green col-md-3" value="Bulk Charge Code Entry" id="btnBulkCCEntry" onclick="" />
                                        <input type="button" class="btn green col-md-3" value="Populate Normal Hours" id="btnPopulateNH" onclick="" />
                                        <input type="button" class="btn green col-md-3" value="Get Approved OT Planning" id="btnGetAppOTPlanning" onclick="" />*@
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="portlet-body form">
                                        <div class="form-body">
                                            <div class="form-horizontal">
                                                <div class="table-toolbar">
                                                    <table class="table table-striped table-bordered table-hover table-full-width" id="tblTimesheetEntry">
                                                        <thead>
                                                            <tr>
                                                                <th scope="col" width="5%"></th>
                                                                <th scope="col" width="5%">
                                                                    <input type="checkbox" name="SelectAll" id="SelectAll" onchange="SelectUnselectAll(this);" />
                                                                </th>
                                                                <th scope="col">Valid OT</th>
                                                                <th scope="col">Subtype *</th>
                                                                <th scope="col">Employee *</th>
                                                                <th scope="col">Start Date *</th>
                                                                <th scope="col">End Date *</th>
                                                                <th scope="col">EASy</th>
                                                                <th scope="col">Start Time *</th>
                                                                <th scope="col">End Time *</th>
                                                                <th scope="col">Total Hours</th>
                                                                <th scope="col">Accumulated OT Hours</th>
                                                                <th scope="col">No. of Meal</th>
                                                                <th scope="col">Charge Code *</th>
                                                                <th scope="col">Verifier / Approver *</th>
                                                                <th scope="col">Description</th>
                                                                <th scope="col">Booking No.</th>
                                                                <th scope="col">TCS No.</th>
                                                                <th scope="col">Original OT Planning</th>
                                                                <th scope="col">Attachment</th>
                                                                <th scope="col">Copy Row</th>



                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @*foreach(var Entry in Model.TimesheetID.ToString())*@
                                                            @for (int x = 0; x < Model.Item1.Count; x++)
                                                            {

                                                                <tr>
                                                                    <td>
                                                                        <div>
                                                                            <i class="fa fa-exclamation-circle ErrorMsg" name="ErrorMsg"
                                                                               style="font-size:24px;color:red;display: none"
                                                                               data-toggle="tooltip" title=""></i>
                                                                        </div>
                                                                    </td>
                                                                    <td style="min-width:30px">
                                                                        <input type="hidden" name="@x" value="@x">
                                                                        <input type="hidden" class="hfAttendanceSubtype" name="Entries[@x].hfAttendanceSubType" value="@Model.Item1[x].AttendanceSubType" />
                                                                        <input type="hidden" class="hfPremiumNo" id="hfPremiumNo" name="hfPremiumNo" value="@Model.Item1[x].PremiumNo" />
                                                                        <input type="hidden" class="TimesheetID" name="Entries[@x].EntryID" value="@Model.Item1[x].EntryID" />
                                                                        <input type="checkbox" class="TimesheetCheckBox" name="Entries[@x].TimesheetEntryCheckBox" value="@Model.Item1[x].EntryID" />
                                                                    </td>
                                                                    @{
                                                                        string chkBoxYellow = string.Empty;
                                                                        string chkBoxDisabled = "disabled";
                                                                        if (Model.Item1[x].ValidOTCheckBoxRequired)
                                                                        {
                                                                            chkBoxYellow = "style='background-color: yellow;'";
                                                                            chkBoxDisabled = string.Empty;
                                                                        }
                                                                    }
                                                                    <td @(chkBoxYellow)>
                                                                        <input type="checkbox" class="ValidOTCheckBox" name="Entries[@x].ValidOTCheckBox" value="true" val2="@Model.Item1[x].EntryID" @(chkBoxDisabled) />
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("Entries[" + @x + "].AttendanceSubType", new SelectList(Model.Item3, "Value", "Text"), null, new { @class = "bs-select form-control AttendanceSubType RowTooltipDisplay", @name = "Entries[" + @x + "].AttendanceSubType", @style = "min-width:150px", @onchange = "ToggleOvertimeEntryControl(this)" })
                                                                        @*<select class="bs-select form-control AttendanceSubType" style="min-width:150px" name="Entries[@x].AttendanceSubType" value="@Model.Item1[x].AttendanceSubType" onchange="ToggleOvertimeEntryControl(this)"></select>*@
                                                                    </td>

                                                                    <td>
                                                                        <div class="form-control-static" style="min-width:150px">
                                                                            @Html.Partial("TSPeoplePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string, string>(@x, @Model.Item1[x], "Employee", ""))
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="input-group date date-picker eDate" data-date-format="dd MM yyyy" style="min-width:150px">
                                                                            <input type="text" class="form-control Date StartDate RowTooltipDisplay" name="Entries[@x].StartDate" value='@Model.Item1[x].sDate' onchange="CalculateDateTime(@x)" />
                                                                            <span class="input-group-btn">
                                                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                            </span>
                                                                        </div>
                                                                    </td>
                                                                    <td>

                                                                        <div class="input-group date date-picker eDate" data-date-format="dd MM yyyy" style="min-width:150px">
                                                                            <input type="text" class="form-control Date EndDate RowTooltipDisplay" name="Entries[@x].EndDate" value='@Model.Item1[x].eDate' onchange="CalculateDateTime(@x)" />
                                                                            <span class="input-group-btn">
                                                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                            </span>
                                                                        </div>
                                                                    </td>

                                                                    <td>
                                                                        <a class="btn blue btn-sm" onclick="EASyNavigation(@x)">
                                                                            <i class="fa fa-search"></i>
                                                                        </a>
                                                                    </td>
                                                                    <td>
                                                                        <div class="col-md-8 form-control-static" style="min-width:150px">
                                                                            <input type="text" class="form-control timeinput StartTime RowTooltipDisplay" name="Entries[@x].StartTime" placeholder="HH:MM"
                                                                                   value='@Model.Item1[x].sTime' onchange="CalculateDateTime(@x)" />
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="col-md-8 form-control-static" style="min-width:150px">
                                                                            <input type="text" class="form-control timeinput EndTime RowTooltipDisplay" name="Entries[@x].EndTime" placeholder="HH:MM"
                                                                                   value='@Model.Item1[x].eTime' onchange="CalculateDateTime(@x)" />
                                                                        </div>
                                                                    </td>
                                                                    <td><input class="form-control TotalHour" style="min-width:50px" name="Entries[@x].TotalHours" value="@Model.Item1[x].TotalHours" readonly="readonly" /> </td>
                                                                    @{
                                                                        string AccOTHours = "0";

                                                                        if (!string.IsNullOrEmpty(@Model.Item1[x].AccumulatedOTHours))
                                                                        {
                                                                            AccOTHours = @Model.Item1[x].AccumulatedOTHours;
                                                                        }

                                                                        string AccOTHoursColor = "Black";

                                                                        if (Convert.ToDouble(AccOTHours) > 51)
                                                                        {
                                                                            AccOTHoursColor = "Orange";
                                                                        }

                                                                        if (Convert.ToDouble(AccOTHours) > 104)
                                                                        {
                                                                            AccOTHoursColor = "Red";
                                                                        }
                                                                    }
                                                                    <td><input class="form-control AccumulatedOTHours" style="min-width:50px;color:@AccOTHoursColor" name="Entries[@x].AccumulatedOTHours" value="@AccOTHours" readonly="readonly" /></td>
                                                                    <td>
                                                                        <select class="form-control NoOfMeal" style="min-width:130px" name="Entries[@x].NoOfMeal" value="@Model.Item1[x].PremiumNo">
                                                                            <option value="00">0</option>
                                                                            <option value="91">1</option>
                                                                            <option value="92">2</option>
                                                                            <option value="93">3</option>
                                                                            <option value="94">4</option>
                                                                            <option value="95">5</option>
                                                                        </select>
                                                                    </td>
                                                                    <td>
                                                                        <div class="form-control-static" style="min-width:150px">
                                                                            @Html.Partial("TSChargeCodePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string>(@x, @Model.Item1[x], ""))
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="form-control-static" style="min-width:150px">
                                                                            @Html.Partial("TSPeoplePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string, string>(@x, @Model.Item1[x], "Approver", ""))
                                                                        </div>
                                                                    </td>
                                                                    <td><input type="text" class="form-control Description" name="Entries[@x].Description" value="@Model.Item1[x].Description" /></td>
                                                                    <td>
                                                                        <div class="form-control-static" style="min-width:150px">
                                                                            @Html.Partial("IFMSBookingNoPicker", new Tuple<int?, string, string>(@x, "", Model.Item1[x].BookingNo))
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="form-control-static" style="min-width:150px">
                                                                            @Html.Partial("TCSSearchPicker", new Tuple<int?, string, string>(@x, "", Model.Item1[x].TCSNo))
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="form-control-static" style="min-width:150px">
                                                                            @Html.Partial("OTPlanningCodePicker", new Tuple<int?, string, string>(@x, "", Model.Item1[x].OTPlanningCode))
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        @*<input type="file" class="form-control Attachment" name="" style="min-width:150px" />*@

                                                                        <div class="form-control-static text-center">
                                                                            @Html.Partial("TSAttachmentPicker", new Tuple<string, string, string, string>("Add", Model.Item1[x].EntryID.ToString(), "Multi", Model.Item1[x].AttachmentCount.ToString() + "_" + x.ToString()))
                                                                        </div>
                                                                    </td>
                                                                    <td><input type="button" class="btn green" value="Copy" id="btnCopy" onclick="CopyRow(@x)" /> </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row text-right">
                                <div class="col-md-12">
                                    <div class="btn-group">
                                        <a class="BtnPlus btn green" title="dTable_BusOutstationEquivalentNoGST" href="javascript:TimesheetAttendance_addRow();">
                                            Add Row
                                            <i class="fa fa-plus"></i>
                                        </a>
                                    </div>
                                    <div class="btn-group">
                                        <a class="BtnPlus5 btn green" title="dTable_BusOutstationEquivalentNoGST" href="javascript:TimesheetAttendance_add5Row();">
                                            Add 5 Rows
                                            <i class="fa fa-plus"></i>
                                        </a>
                                    </div>
                                    <div class="btn-group">
                                        <a class="deleteall btn red" title="dTable_BusOutstationEquivalentNoGST" href="javascript:TimesheetAttendance_removeRow();">
                                            Delete Row
                                            <i class="fa fa-minus"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @Html.Action("TSPeoplePickerIndex", "TimeAttendance", new { CurrEmpID = "CurrEmpID", SearchType = "Subordinates" })
        @Html.Action("TSMultiPeoplePickerIndex", "TimeAttendance", new { CurrEmpID = "CurrEmpID", SearchType = "Subordinates" })
        @Html.Action("TSChargeCodeIndex", "TimeAttendance", new { CurrEmpID = ViewBag.EmployeeID, SearchType = "" })
        @Html.Partial("_PopulateWorkingHours", "Group")
        @Html.Partial("_BulkOvertimeTSEntry")
        @Html.Partial("TCSSearchIndex")
        @Html.Partial("IFMSBookingNoSearchIndex")
        @Html.Partial("OTPlanningCodeSearchIndex")
        @Html.Action("_GetApprovedOTPlanning", new { Type = "Group" })
        @Html.Partial("TSAttachmentIndex")
        @Html.Partial("_includeDataTableScripts")

        @*<div class="form-horizontal">
                <div class="table-toolbar">
                </div>
            </div>*@
    </div>

    <div class="row">

        @*<div class="col-md-12">
                <div class="col-md-8" style="border-color:black; border-style:solid; border-width:thin; padding:10px; margin-bottom:5px;">
                    <div class="row">
                        <div class="col-md-1">
                            <input type="checkbox" name="BatchNo" value="true" onclick="ToggleBatchRemarks();" />
                        </div>
                        <label class="control-label col-md-7">Batch Submission</label>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <p>
                                The selected timesheets above will be submitted as a batch.
                            </p>
                            <p>
                                You may include a brief note for this batch submission below:
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <input class="col-md-10 form-control BatchRemarks" type="text" name="BatchRemarks" readonly />
                        </div>
                    </div>
                </div>
            </div>*@

        <div class="col-md-12">
            <p>
                <b>
                    Adalah menjadi tanggungjawab semua penyelia untuk memastikan OT yang dihantar bagi setiap pekerja adalah OT yang sah yang dijalankan oleh pekerja tersebut.
                </b>
            </p>
            <p>
                <b>
                    Supervisors need to ensure OT that will be submitted is a valid OT, executed by the employee.
                </b>
            </p>
        </div>
    </div>

    if (string.IsNullOrEmpty(IsSupervisorMessage))
    {
        <div id="TimesheetActionDiv">
            <div class="row">
                <div class="col-md-12">
                    <input type="button" class="btn green" value="Save as Draft" id="btnDraft" onclick="SubmitTS('Draft'); " />
                    <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="SubmitTS('PerformActionOnSubmit'); " />
                </div>
            </div>
        </div>
    }

    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well" id="SuccessMessage">
                        Claims has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <a class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmSubmit" tabindex="-1" role="basic" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body warning-msg">
                    <div class="well" id="ConfirmMessage">
                        Submit entry(s) with Warning?

                        Press Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmitWarning" onclick="SubmitTS('SubmitWithWarning'); ">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

        </p>
    </div>

}
<script>
    var TimesheetAttendanceTable = $('#tblTimesheetEntry').dataTable({
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false
    });

    function TimesheetAttendance_addRow() {
        $('input[name="AddRow"]').val('1');
        $('form').submit();
    }

    function TimesheetAttendance_add5Row() {
        $('input[name="AddRow"]').val('5');
        $('form').submit();
    }

    function TimesheetAttendance_removeRow()
    {

        $('input[name="DeleteRow"]').val('true');
        $('form').submit();

        //$("#tblTimesheetEntry td input[type=checkbox]:checked").each(function (i, value) {
