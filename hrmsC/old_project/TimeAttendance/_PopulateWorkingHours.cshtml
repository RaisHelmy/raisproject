@model  string

<div class="modal fade" id="PopulateWorkingHour" tabindex="-1" aria-hidden="true" >
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">
                    <p>Populate Normal Hours</p>
                </h4>
            </div>
            <div class="modal-body">
                <div>
                    <div class="row" onkeypress="return event.keyCode!=13;">
                        <div class="col-md-12">
                            <div class="form-body">
                                <div class="form-horizontal">
                                    <div class="row">
                                        <div class="form-group">
                                            <label class="control-label col-md-2 ">
                                                Start Date *
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <div class="date date-picker input-group eDate" data-date-format="dd MM yyyy">
                                                    <input type="text" class="form-control Date" name="wsSearchStartDate"/>
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                            <label class="control-label col-md-2 ">
                                                End Date *
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <div class="date date-picker input-group eDate" data-date-format="dd MM yyyy">
                                                    <input type="text" class="form-control Date" name="wsSearchEndDate" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @if (Model == "Group")
                                    {
                                        <div class="row">
                                            <div class="form-group ">
                                                <label class="control-label col-md-2 ">
                                                    Employee *
                                                </label>
                                                <div class="col-md-4 form-control-static">
                                                    @Html.Partial("TSMultiPeoplePeoplePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string, string>(-1, null, "wsEmployee", ""))
                                                    @*@Html.Partial("TSPeoplePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string, string>(-1, null, "wsEmployee", ""))*@
                                                </div>
                                                <label class="control-label col-md-2 ">
                                                    Charge Code *
                                                </label>
                                                <div class="col-md-4 form-control-static">
                                                    @Html.Partial("TSChargeCodePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string>((int?)-1, null, "ws"))
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="form-group ">
                                                <label class="control-label col-md-2 ">
                                                    Charge Code *
                                                </label>
                                                <div class="col-md-4 form-control-static">
                                                    @Html.Partial("TSChargeCodePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string>((int?)-1, null, "ws"))
                                                </div>

                                            </div>
                                        </div>
                                    }

                                    <div class="row">
                                        <div class="form-group ">
                                            <label class="control-label col-md-2 ">
                                                Description
                                            </label>
                                            <div class="col-md-10 form-control-static">
                                                <textarea class="form-control" style="width:100%; height:100px;" name="wsDescription"></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default green" onclick="PopulateWorkSchedule()">Generate</button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>

    function PopulateWorkSchedule() {
        var startDate = $('input[name="wsSearchStartDate"]').val();
        var endDate = $('input[name="wsSearchEndDate"]').val();
        var ChargeType = $('input[name="wsChargeType"]').val();
        var ChargeCode = $('input[name="wsChargeCode"]').val();

        if (!(startDate != '' && startDate != undefined) ||
            !(endDate != '' && endDate != undefined))
        {
            alert('Start/End Date is required.');
        }
        else if (!(ChargeType != '' && ChargeType != undefined) ||
                 !(ChargeCode != '' && ChargeCode != undefined) )
        {
            alert('Charge Code is required.');
        }
        else if ('@Model' == 'Group' &&
                  !($('input[name="wsEmployeeID"]').val() != '' && $('input[name="wsEmployeeID"]').val() != undefined))
        {
            //condition checking of employeeID for group populate normal hours
            alert('Employee is required.');
        }
        else {
            $('input[name="TimesheetSubAction"]').val('PopulateNormalHour');
            $('form').submit();
        }

        
