@model TimeAttendance.Models.OTPlanningEntryVM
@{
    Layout = "";
}
<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
    <h4 class="modal-title">
        <p>Original OT Planning</p>
    </h4>
</div>
<div class="modal-body">
    <div>
        <div class="row" onkeypress="return event.keyCode!=13;">
            <div class="col-md-12">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Code
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.EntryCode
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Employee No.
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.EmployeeCode
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Employee Name
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.EmployeeName
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Start Date
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.sDate
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                End Date
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.eDate
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Start Time
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.sTime
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                End Time
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.eTime
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Total Hours
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.TotalHours
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Charge Code
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.ChargeCode
                            </div>
                        </div>

                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Description
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.Description
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn default" data-dismiss="modal">Close</button>
</div>
