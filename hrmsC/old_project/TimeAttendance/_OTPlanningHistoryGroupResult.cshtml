    function loadRowTooltip($row) {

        var _StartDate = $row.find(".StartDate").text();
        var _EndDate = $row.find(".EndDate").text();
        //var _Employee = $row.find(".Employee").text();
        //var _StartTime = $row.find(".StartTime").text();
        //var _EndTime = $row.find(".EndTime").text();

        if (
            (_StartDate != '' && _StartDate != undefined)
            //&& (_StartTime != '' && _StartTime != undefined)
            && (_EndDate != '' && _EndDate != undefined)
            //&& (_EndTime != '' && _EndTime != undefined)
            //&& (_Employee != '' && _Employee != undefined)
        ) {

            $($row).qtip({
                content: createRowTooltips($row),
                position: {
                    target: 'mouse',
                    adjust: {
                        mouse: true
                    }
                },
                style: {
                    width: " + this.Width + ",
                    border: {
                        width: 2,
                        radius: 5,
                        color: '#CECECE'
                    },
                    padding: 5,
                    tip: true,
                    name: 'light'
                },
                show: {
                    event: 'mouseover'
                },
                hide: {
                    event: 'mouseout'
                }
            });

        }

    }


    function createRowTooltips($row) {

        //var _SubType = $row.find(".SubType").text();
        var _Employee = $row.find(".Employee").text();
        var _StartDate = $row.find(".StartDate").text();
        var _StartTime = $row.find(".StartTime").text();
        var _EndDate = $row.find(".EndDate").text();
        var _EndTime = $row.find(".EndTime").text();

        var returnContent = '<table align="center">';

        returnContent += '<tr><td>Employee : </td><td align=right>' + _Employee + '</td></tr>'
        //returnContent += '<tr><td>Subtype    :   </td><td align=right>' + _SubType + '</td></tr>'
        returnContent += '<tr><td>Start Date : </td><td align=right>' + _StartDate + '</td></tr>'
        returnContent += '<tr><td>Start Time : </td><td align=right>' + _StartTime + '</td></tr>'
        returnContent += '<tr><td>End Date : </td><td align=right>' + _EndDate + '</td></tr>'
        returnContent += '<tr><td>End Time : </td><td align=right>' + _EndTime + '</td></tr>'
        returnContent += '</table > ';

        return returnContent;

    }

    function RowDisplayInfo() {
        var $row = $(this).closest("tr");
        loadRowTooltip($row);
    }

    function TableRowDisplayInfo() {
        $(".qtip").remove();

        $.each($('#tblResult').dataTable().fnGetNodes(), function (i, e) {
            var $row = $(this).closest("tr");
            loadRowTooltip($row);
            //$row.attr('title', _StartDate + ' &#010;' + _StartTime + _EndDate + _EndTime);
        });
    }

    function InitiateRowDisplayInfo() {
        //$('.RowTooltipDisplay').on('change', TableRowDisplayInfo);
        //$('.TSPeoplePickerDisplay').on('change', TableRowDisplayInfo);
        TableRowDisplayInfo();
    }

    var tblResult = $('#tblResult').dataTable({
        "fnDrawCallback": function (settings) {
            $('input[type="checkbox"]').uniform();
        },
        aoColumnDefs: [
        {
            bSortable: false,
            aTargets: [1]
        }]

    });

    $(function () {
        $('input[type="checkbox"]').uniform();
        InitiateRowDisplayInfo();
    });

