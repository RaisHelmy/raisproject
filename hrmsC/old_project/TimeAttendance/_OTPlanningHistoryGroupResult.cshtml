@using TimeAttendance.Services

@model List<TimeAttendance.Models.OTPlanningEntryVM>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Overtime Planning History
        </div>
        @*<input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />*@
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th width="5%"></th>
                                <th width="5%">
                                    <input type="checkbox" name="SelectAll" id="SelectAll" onchange="SelectUnselectAll(this);" />
                                </th>
                                <th></th>
                                <th>Status</th>
                                <th>Employee</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Total Hours</th>
                                <th>Acc OT Hours</th>
                                <th>Charge Type</th>
                                <th>Charge Code</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int x=0; x<Model.Count; x++)
                            {
                                <tr>
                                    <td>
                                        <div>
                                            <i class="fa fa-exclamation-circle ErrorMsg" name="ErrorMsg"
                                               style="font-size:24px;color:red;display: none"
                                               data-toggle="tooltip" title=""></i>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="hidden" class="TimesheetID" name="EntryID" value="@Model[x].EntryID" />
                                        <input type="hidden" class="EmployeeID" name="EmployeeID" value="@Model[x].EmployeeID" />
                                        <input type="checkbox" class="OTPlanningCheckBox" name="OTPlanningCheckBox" value="@Model[x].EntryID" />
                                    </td>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/TimeAttendance/OTDetails")?ID=@Model[x].EntryID&Source=OTplanningHistoryGroup">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                    
                                        @if (@Model[x].StatusDesc == "Withdrawn" ||
                                             @Model[x].StatusDesc == "Declined" ||
                                             @Model[x].StatusDesc == "Error"   ||
                                             @Model[x].StatusDesc == "Failed"   )
                                        {
                                            <td class="Status" style="color:red;"><b>@Model[x].StatusDesc</b></td>
                                        }
                                        else
                                        {
                                            <td class="Status" style="color:green;"><b>@Model[x].StatusDesc</b></td>
                                        }
                                    <td class="Employee">@Model[x].EmployeeCode - @Model[x].EmployeeName</td>
                                    <td class="StartDate">@Model[x].sDate</td>
                                    <td class="EndDate">@Model[x].eDate</td>
                                    <td class="StartTime">@Model[x].sTime</td>
                                    <td class="EndTime">@Model[x].eTime</td>
                                    <td>@Model[x].TotalHours</td>
                                    <td>@Model[x].ValidAccumulatedOTHours</td>
                                    <td>@Model[x].ChargeType</td>
                                    <td>@Model[x].ChargeCode</td>

                                    @*@if (@Model[x].Status == "Returned" || @Model[x].Status == "Withdrawn")
                                        {
                                            <td style="color:red;"><b>@Model[x].Status</b></td>
                                        }
                                        else
                                        {
                                            <td style="color:green;"><b>@Model[x].Status</b></td>
                                        }*@

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_includeDataTableScripts")


