						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-md-12">
						<div class="text-left">
							Last modified at @Model.ModifiedDate by @Model.ModifiedByName
						</div>
					</div>
				</div>
			</div>

		}

	</div>
}

<!-- Success Message -->
<div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header Success-header">
				@*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
				<h4 class="Success-title">Action Successfully Completed</h4>
			</div>
			<div class="modal-body Success-body">
				<div class="well" id="SuccessMessage">
					Standby has been successfully submitted.
				</div>
			</div>
			<div class="modal-footer Success-footer">
				<a class="btn default blue" id="btnOK">
					<i class="fa fa-check"></i>
					OK
				</a>
			</div>
		</div>
	</div>
</div>



<script>

    function updateDates(ArrDates)
    {
        var datesArr = [new Date(2017, 11, 02), new Date(2017, 11, 03)];
        $('#MultiDatePicker').datepicker('setDates', ArrDates);
        setSeletedDates();
    }

    function setDates(ArrDates)
    {
        var datesArr = [new Date(2017, 11, 02), new Date(2017, 11, 03)];
        $('#MultiDatePicker').datepicker('setDates', ArrDates);
        setHiddenInputSelectedDate();
    }

    function clearDates()
    {
        $('#MultiDatePicker').datepicker('clearDates');
    }

    function setSeletedDates()
    {
        $("#tblStandbySelectedDate").find("tr:gt(0)").remove();

        var selectedDates = $('#MultiDatePicker').datepicker('getDates');

        if (selectedDates.length != 0)
        {
            if (selectedDates.length > 1)
            {
                selectedDates.sort(function (a, b) {
                    return a - b;
                });
                //var arrDates = selectedDates.split(',');
                var count = 0;
                selectedDates.forEach(function (current_value) {
                    var date = moment(current_value).format('DD/MM/YYYY');
                    var markup = "<tr> <td>" + (count + 1) + ".</td><td>" + date + "</td><td><a onclick='RemoveDate(event);'>Remove</a></td></tr>";
                    $("#tblStandbySelectedDate tbody").append(markup);
                    count = count + 1;
                });
            } else {
                var date = moment(selectedDates[0]).format('DD/MM/YYYY');
                var markup = "<tr> <td>" + 1. + ".</td><td>" + date + "</td><td><a onclick='RemoveDate(event);'>Remove</a></td></tr>";
                $("#tblStandbySelectedDate tbody").append(markup);
            }
        }
        setHiddenInputSelectedDate();
    }

    function RemoveDate(event)
    {
        var Dates = [];
        var row = $(event.target).closest("tr");
        row.remove();
        $("#tblStandbySelectedDate tr").each(function (i, value) {
            var $row = $(this).closest("tr");
            var strDate = $row.children('td:eq(1)').text().split('/');
            var date = new Date(parseInt(strDate[2]), parseInt(strDate[1]) - 1, parseInt(strDate[0]));
            Dates.push(date);
        });
        updateDates(Dates);
    }

    function setDateRange()
    {
        var DateFrom = $('input[name="dateFrom"]').datepicker("getDate");
        var DateTo = $('input[name="dateTo"]').datepicker("getDate");
        var between = [];
        var DateToUpdate = [];
        if (DateFrom != '' && DateFrom != null && DateTo != '' && DateTo != null)
        {
            var currentDate = new Date(DateFrom.getTime());
            while (currentDate <= DateTo) {
                between.push(new Date(currentDate));
                currentDate.setDate(currentDate.getDate() + 1);
            }

            $("#tblStandbySelectedDate tr").each(function (i, value) {
                var $row = $(this).closest("tr");
                var strDate = $row.children('td:eq(1)').text().split('/');
                var date = new Date(parseInt(strDate[2]), parseInt(strDate[1]) - 1, parseInt(strDate[0]));
                if (date != 'Invalid Date') {
                    if (!isInSelectedDateRange(between, date)) {
                        between.push(date);
                    }
                }
            });
            clearDates();
            updateDates(between);
        }

    }

    function setHiddenInputSelectedDate()
    {
        var selectedDates = "";
        $("#tblStandbySelectedDate tr").each(function (i, value) {
            var $row = $(this).closest("tr");
            var strDate = $row.children('td:eq(1)').text();
            if (strDate != '')
            {
                arrDate = strDate.split('/');
                var strMomentDate = arrDate[2] + arrDate[1] + arrDate[0];
                var date = moment(strMomentDate, "YYYYMMDD").format("YYYY/MM/DD");
                selectedDates += date + ',';
            }
        });

        $('input[name="StandByDate"]').val(selectedDates);
    }

    function isInSelectedDateRange(array, value) {
        var returnValue = false;
        $.each(array, function (i, val) {
            if (value.getTime() == val.getTime())
            {
                returnValue = true;
            }
        });
        return returnValue;
    }

    function formInsertValidation()
    {
        var errorMessage = "";
        var Employee = $('input[name="EmployeeID"]').val();
        var standbyDate = $('input[name="StandByDate"]').val()
        var Year = $('select[name="StandByYear"]').val();
		var Description = $('input[name="Description"]').val();
		var ChargeCode = $('input[name="ChargeCode"]').val();
		
        if(Employee == '')
        {
            errorMessage = "Please select Employee to proceed.";
		}
		else if (ChargeCode == '')
		{
			errorMessage = "Please select Charge Code to proceed.";
		}
        else if(standbyDate == '')
        {
            errorMessage = "Please select Date to proceed.";
        }
        else if (Year == '') {
            errorMessage = "Please select Year to proceed.";
        }

        return errorMessage;
    }

    function InsertStandBy()
    {
        var validation = formInsertValidation();
        if (validation == "")
        {
            var data = $('form').serializeArray();
            $.ajax({
                url: '../TimeAttendance/InsertStandBy',
                type: 'POST',
                data: data,
                success: function (result) {

                    $('#divLoading').hide();
                    if (result.result == true) {


                        window.alert("Standby has been successfully Submitted");
                        window.location.href = "../TimeAttendance/StandByList";
                        //$('#SuccessSubmit').modal();
                        //$('#SuccessMessage').html("Standby has been successfully submitted");
                        //$('#btnOK').attr('href', '../TimeAttendance/StandByList');
                    }
                    else if (!result.result) {
                        alert(result.ErrorMessage);

                    }
                    // ... Process the result ...
                }
            });
        }
        else
        {
            alert(validation);
        }

    }

    function UpdateStandBy()
    {
        var validation = formInsertValidation();
        if (validation == "") {
            var disabled = $('form').find(':input:disabled').removeAttr('disabled');
            var data = $('form').serializeArray();
            disabled.attr('disabled', 'disabled')
            $.ajax({
                url: '../TimeAttendance/UpdateStandBy',
                type: 'POST',
                data: data,
                success: function (result) {

                    $('#divLoading').hide();
                    if (result.result == true) {

                        window.alert("Standby has been successfully Updated");
                        window.location.href = "../TimeAttendance/StandByList";
                        //$('#SuccessSubmit').modal();
                        //$('#SuccessMessage').html("Standby has been successfully Updated");
                        //$('#btnOK').attr('href', '../TimeAttendance/StandByList');
                    }
                    else if (!result.result) {
                        alert(result.ErrorMessage);
                    }
                    // ... Process the result ...
                }
            });
        }
        else {
            alert(validation);
        }
    }

    function editStandBy(ID)
    {
        $.ajax({
            url: '../TimeAttendance/_Standby',
            type: 'GET',
            data: {
                ID: ID,
                Mode: "Edit"
            },
            success: function (result) {
                $("#StandByResult").html(result);
                $('#StandByModal').modal({
                    backdrop: 'static',
                    keyboard: true
                }, 'show');
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function setToInactive()
    {
        var standbyID = $('input[name="StandByID"]').val();
        if (standbyID != '' && standbyID != 'undefined')
        {
            $.ajax({
                url: '../TimeAttendance/SetInactive',
                type: 'POST',
                data: {
                    StandbyID: standbyID
                },
                success: function (result) {

                    $('#divLoading').hide();
                    if (result.result == true) {

                        $('#SuccessSubmit').modal();
                        $('#SuccessMessage').html("Standby has been successfully Deactivated");
                        $('#btnOK').attr('href', '../TimeAttendance/StandByList');
                    }
                    else if (!result.result) {
                        alert(result.ErrorMessage);
                    }
                    // ... Process the result ...
                },
                error: function (e) {
                    console.log(e);
                }
            });
        }
        else
        {
            alert('StandBy not found.');
        }
    }

    function PrintPage()
    {
        PrintStandBy();
        //window.print();
    }

    function dateToNumber(d)
    {
        d = d.split("/"); return Number(d[2] + d[1] + d[0]);
    }


    function PrintStandBy()
    {
        window.open("@Url.Action("_Standby", "TimeAttendance", new {ID = Model.StandByID, Mode = "Print" })");
    }

    function setYearDateRange()
    {
        var year = $('select[name="StandByYear"]').val();
        var startdate = '01 01 ' + year;
        var enddate = '12 31 ' + year;
        $('#MultiDatePicker').datepicker('setStartDate', startdate);
        $('#MultiDatePicker').datepicker('setEndDate', enddate);

        startdate = '01 01 ' + year;
        enddate = '31 12 ' + year;
        $('input[name="dateFrom"]').datepicker('setStartDate', startdate);
        $('input[name="dateFrom"]').datepicker('setEndDate', enddate);
        $('input[name="dateTo"]').datepicker('setStartDate', startdate);
        $('input[name="dateTo"]').datepicker('setEndDate', enddate);

        $('input[name="dateFrom"]').val('');
        $('input[name="dateTo"]').val('');
        setDates([]);
    }

    $(function () {

        $('#MultiDatePicker').datepicker({
            multidate: true
        });
        $('#MultiDatePicker').on('changeDate', setSeletedDates);
        $('.input-daterange input').each(function () {
            $(this).datepicker({
                autoclose: true,
                format: 'dd/mm/yyyy'
            });
        });
        $('input[name="dateFrom"]').on('changeDate', setDateRange);
        $('input[name="dateTo"]').on('changeDate', setDateRange);

        setYearDateRange();
        if(('@ViewBag.Mode') == 'Edit')
        {
            var dates = '@Model.StandByDate';
            if(dates.indexOf(',') != -1){
                var splitDates = dates.split(',');
                var arrDate = [];
                $.each(splitDates, function (i, val) {
                    if (val != '' && val != null)
                    {
                        var strDate = val.split('/');
                        var date = new Date(parseInt(strDate[2]), parseInt(strDate[1]) - 1, parseInt(strDate[0]));
                        if (date != 'Invalid Date') {
                            arrDate.push(date);
                        }
                    }
                });
                setDates(arrDate);
            }
            else{
                var dates = '@Model.StandByDate';
                var arrDate = [];
                if (dates.indexOf('/') != -1) {
                    var strDate = dates.split('/');
                    var date = new Date(parseInt(strDate[2]), parseInt(strDate[1]) - 1, parseInt(strDate[0]));
                    if (date != 'Invalid Date') {
                        arrDate.push(date);
                    }
                }
                setDates(arrDate);
            }

        }

        if(('@ViewBag.Mode') == 'Print')
        {
            window.print();
        }
        //$('.date-picker').datepicker({
        //    format: 'dd/mm/yyyy',
        //    autoclose: true
        //});
    })

</script>
