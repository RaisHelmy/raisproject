@model List<TimeAttendance.Models.TCS>

@{
    Layout = "";

}



<table id="tblTCSSearch" class="table table-striped table-bordered table-hover table-full-width">
    <thead>
        <tr>
            <th scope="col" width="5%"></th>
            <th scope="col">TCS No.</th>
            <th scope="col">Remarks</th>
            <th scope="col">Dispatch Date/Time</th>
            <th scope="col">Normalised Date/Time</th>
            <th scope="col">State</th>
            <th scope="col">Location</th>
            <th scope="col">Branch</th>
            <th scope="col">PPB</th>

        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td><input type="radio" name="AddTCS" value="@Model[i].TCSNo" /></td>
                    <td class="TCSNo">@Model[i].TCSNo</td>
                    <td class="Remarks">@Model[i].Remarks</td>
                    <td class="DispatchDateTime">@Model[i].strDispatchDateTime </td>
                    <td class="NormalisedDateTime">@Model[i].strNormalisedDateTime </td>
                    <td class="State">@Model[i].State </td>
                    <td class="Location">@Model[i].Location </td>
                    <td class="Branch">@Model[i].Branch </td>
                    <td class="PBB">@Model[i].PPB </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9">
                    No record available.
                </td>
            </tr>
        }

    </tbody>
</table>


<script>
 //   transformtable("#tblChargeCodeSearch");
    $('#tblTCSSearch').dataTable()
    var tableWrapper = "#tblTCSSearch_wrapper";

    jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
    jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
    jQuery(tableWrapper + ' .dataTables_length select').select2({
        showSearchInput: false //hide search box with special css class
    });
</script>