}
<script>
    var Path = '/_layouts/15/ESSV2'; //local
    //var Path = '/_layouts/15/TNBESS'; //STG & PRD

    var TimesheetAttendanceTable = $('#tblTimesheetEntry').dataTable({
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false
    });



    function ConfirmAction(_Action)
    {
        if (_Action == 'Draft') {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').removeClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Save this Timesheet Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Draft'); });
            $('#ConfirmSubmit').modal('show');
        }
        else if (_Action == 'Submit') {
            $('#btnSubmitForm').removeClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Submit this Timesheet Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Submit'); });
            $('#ConfirmSubmit').modal('show');
            $('#ConfirmSubmit').modal();
            if ($('#tblAttachment .dataTables_empty').length == 1) {
                alert("Submit this claim without attachment?");
            }
        }
    }

    function SubmitOTPlanning(Type) {
        DisableActionButton();
        var data = '';
        if (Type == 'Draft' || Type == 'PerformActionOnSubmit')
        {
            ToggleFieldForSubmit(true);
            data = $('form').serializeArray();
            ToggleFieldForSubmit(false);
            data.push(
                { name: 'SubmitType', value: Type }
            );
        }
        else {
            var _entryIDs = $('#EntryID').val() + ',';
            data = {
                SubmitType: Type,
                EntryIDs: _entryIDs
            };
        }

        PerformOTPlanningSubmission(data, Type);
    }

    function PerformOTPlanningSubmission(data, Type) {

        var Action = Type;
        switch (Type) {
            case 'PerformActionOnSubmit':
                Action = 'Submitted';
                break;
            case 'Cancel':
                Action = 'Cancelled';
            case 'Delete':
                Action = 'Deleted';
                break;
            case 'Submit':
                Action = 'Submitted';
                break;
            case 'Draft':
                Action = 'Saved as Draft';
                break;
            default:
        }
        $.ajax({
            url: '../TimeAttendance/SubmitOTPlanningAction',
            type: 'POST',
            data: data,
            success: function (result) {

                $('#divLoading').hide();
                if (result.result == true) {


                    $('#SuccessSubmit').modal();
                    $('#SuccessMessage').html("Timesheet has been successfully " + Action);
                    if ('@ViewBag.Source' != '') {
                        $('#btnOK').attr('href', '../TimeAttendance/' + '@ViewBag.Source');
                    }
                    else {
                        $('#btnOK').attr('href', '../TimeAttendance/OTplanningHistoryGroup');
                    }
                }
                else if (!result.result) {
                    if (CheckEmptyKeyValueMessage(result.EntryErrorMessage)) {
                        ShowErrorWarningMessage(result.EntryErrorMessage);

                    } else if (CheckEmptyKeyValueMessage(result.EntryWarningMessage)) {
                        ShowErrorWarningMessage(result.EntryErrorMessage);
                    } else if(result.ErrorMessage != '' & result.ErrorMessage != undefined){
                        alert(result.ErrorMessage);
                    }
                    EnableActionButton();
                }
                // ... Process the result ...
            }
        });
    }

    function PostApproverAction(Action) {
        DisableActionButton();
        var _TaskIDs = '@ViewBag.TaskID' + ',';
        var _ApproverAction = Action;
        var _ApproverComment = $('#txtAppComment').val();
        var MatchApproverAction = true;


        //field to update during approval
        var _StartTime = $('input[name="StartTime"]').val()
        var _EndTime = $('input[name="EndTime"]').val()
        var _ChargeCode = $('input[name="ChargeCode"]').val()
        var _ChargeType = $('input[name="ChargeType"]').val()
        var _ChargeCodeDesc = $('input[name="ChargeCodeDesc"]').val()
        var _Description = $('textarea[name="Description"]').val()
        var _TotalHours = $('input[name="TotalHours"]').val()

        var JsonObjectParam = {
            "StartTime": _StartTime,
            "EndTime": _EndTime,
            "ChargeCode": _ChargeCode,
            "ChargeType": _ChargeType,
            "ChargeCodeDesc": _ChargeCodeDesc,
            "Description": _Description,
            "TotalHours": _TotalHours
        }
        var Param = JSON.stringify(JsonObjectParam);

        if (!(_ApproverComment === '' && Action === 'Decline')) {
            if (_TaskIDs != "") {
                if (MatchApproverAction) {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Content("~/TimeAttendance/OTPostApproverAction")',
                        data: {
                            TaskIDs: _TaskIDs,
                            ApproverAction: _ApproverAction,
                            ApproverComment: _ApproverComment,
                            UpdateFields: Param
                        },
                        success: function (result) {
                            EnableActionButton();
                            if (result.result == true) {

                                $('#SuccessSubmit').modal();
                                var ActionMessage = Action;
                                if (Action === "Approve") ActionMessage = "Approved";
                                if (Action === "Decline") ActionMessage = "Declined";
                                if (Action === "Verify") ActionMessage = "Verified";
                                if (Action === "ConvertToDraft") ActionMessage = "Convert To Draft";
                                $('#SuccessMessage').html("Overtime Planning has been successfully " + ActionMessage);
                                $('#btnOK').attr('href', '../TimeAttendance/OvertimePlanningInTray');
                            } else {
                                //alert(result.EntryErrorMessage);
                                ShowErrorWarningMessage(result.EntryErrorMessage);
                                EnableActionButton();
                            }
                        },
                        error: function (e) {
                            console.log(e);
                            EnableActionButton();
                        }
                    });
                }
                else {
                    alert('Approval action is not allow.');
                    EnableActionButton();
                }
            }
            else {
                alert('Workflow not found. Please contact your system administrator.');
                EnableActionButton();
            }
        }
        else {
            alert('Please fill in the comments.');
            EnableActionButton();
        }

        
    }

    function WithdrawOTPlanning() {
        DisableActionButton();
        var _EntryIDs = $('#EntryID').val();
        if (_EntryIDs != "")
        {
            _EntryIDs = _EntryIDs + ',';
        }

        if (_EntryIDs != "") {
            $.ajax({
                type: "POST",
                url: '@Url.Content("~/TimeAttendance/WithdrawOTPlanning")',
                data: {
                    EntryIDs: _EntryIDs
                },
                success: function (result) {
                    if (result.result == true) {

                        EnableActionButton();
                        $('#SuccessSubmit').modal();
                        $('#SuccessMessage').html("Overtime Planning has been successfully " + "Withdrawn.");
                        if ('@ViewBag.Source' != '') {
                            $('#btnOK').attr('href', '../TimeAttendance/' + '@ViewBag.Source');
                        }
                        else {
                            $('#btnOK').attr('href', '../TimeAttendance/OTplanningHistoryGroup');
                        }
                    } else {
                        if (CheckEmptyKeyValueMessage(result.EntryErrorMessage)) {
                            ShowErrorWarningMessage(result.EntryErrorMessage);
                        } else {
                            alert('Request action failed.');
                        }
                        EnableActionButton();
                    }
                },
                error: function (e) {
                    console.log(e);
                    EnableActionButton();
                }
            });
        }
        else {
            alert('Please select entry to proceed.');
            EnableActionButton();
        }
    }

    function CancelOTPlanning() {
        DisableActionButton();
        var _EntryIDs = $('#EntryID').val();
        if (_EntryIDs != "") {
            _EntryIDs = _EntryIDs + ',';
        }

        if (_EntryIDs != "") {
            $.ajax({
                type: "POST",
                url: '@Url.Content("~/TimeAttendance/CancelOTPlanning")',
                data: {
                    EntryIDs: _EntryIDs
                },
                success: function (result) {
                    if (result.result == true) {

                        EnableActionButton();
                        $('#SuccessSubmit').modal();
                        $('#SuccessMessage').html("Overtime Planning has been successfully " + "Cancelled.");
                        if ('@ViewBag.Source' != '') {
                            $('#btnOK').attr('href', '../TimeAttendance/' + '@ViewBag.Source');
                        }
                        else {
                            $('#btnOK').attr('href', '../TimeAttendance/OTplanningHistoryGroup');
                        }
                    } else {
                        if (CheckEmptyKeyValueMessage(result.EntryErrorMessage)) {
                            ShowErrorWarningMessage(result.EntryErrorMessage);
                        } else {
                            alert('Request action failed.');
                        }
                        EnableActionButton();
                    }
                },
                error: function (e) {
                    console.log(e);
                    EnableActionButton();
                }
            });
        }
        else {
            alert('Please select entry to proceed.');
            EnableActionButton();
        }
    }


    function CalculateDateTime() {

        var EmployeeID = $('input[name="EmployeeID"]').val();
        var StartDate = $('input[name="StartDate"]').val();
        var EndDate = $('input[name="EndDate"]').val();
        var StartTime = $('input[name="StartTime"]').val();
        var EndTime = $('input[name="EndTime"]').val();

        if (StartDate != '' && EndDate != '' && StartTime != '' && EndTime != '') {

            var workingHours = GetWorkingHours(EmployeeID, StartDate, EndDate, StartTime, EndTime);
            //var diffHours = duration.asHours() - workingHours;
            //var Hour = parseFloat(Math.round(workingHours * 100) / 100).toFixed(2);
            //$row.find(".TotalHour").val(workingHours);
        } else {

            $('input[name="TotalHours"]').val('0.00');
        }

        //$("#tblOTPlanningEntry td input[type=checkbox]").each(function (i, value) {
        //    if (rowNumber == i) {
        //        var $row = $(this).closest("tr");

        //    }
        //});
    }

    function GetWorkingHours(EmployeeID, StartDate, EndDate, StartTime, EndTime) {
        var totalHours = 0;

        $.ajax({
            url: '../TimeAttendance/OTPGetWorkingHours',
            type: 'POST',
            data: {
                EmployeeID: EmployeeID,
                StartDate: StartDate,
                EndDate: EndDate,
                StartTime: StartTime,
                EndTime: EndTime
            },
            success: function (result) {
                if (result != undefined && result != '') {
                        totalHours = parseFloat(result);
                        var Hour = parseFloat(Math.round(totalHours * 100) / 100).toFixed(2);
                        $('input[name="TotalHours"]').val(Hour);
                }
                else {
                    var StartDateTime = moment(StartDate + ' ' + StartTime, 'DD/MM/YYYY HH:mm');
                    var EndDateTime = moment(EndDate + ' ' + EndTime, 'DD/MM/YYYY HH:mm');

                    var duration = moment.duration(EndDateTime.diff(StartDateTime));
                    var diffHours = duration.asHours();
                    var Hour = parseFloat(Math.round(diffHours * 100) / 100).toFixed(2);
                    $('input[name="TotalHours"]').val(Hour);
                    //the calculation above doesnt matter, just display 0 if no result from JSON
                    $('input[name="TotalHours"]').val('0.00');
                    //$row.find(".TotalHour").val(Hour);
                }
            },
            error: function () {
                var StartDateTime = moment(StartDate + ' ' + StartTime, 'DD/MM/YYYY HH:mm');
                var EndDateTime = moment(EndDate + ' ' + EndTime, 'DD/MM/YYYY HH:mm');

                var duration = moment.duration(EndDateTime.diff(StartDateTime));
                var diffHours = duration.asHours();
                var Hour = parseFloat(Math.round(diffHours * 100) / 100).toFixed(2);
                $('input[name="TotalHours"]').val(Hour);
            }
        });

    }

    function GetApprover()
    {
        var _EmployeeID = $('input[name="EmployeeID"]').val();
        var _StartDate = $('input[name="StartDate"]').val();
        var _ChargeTypeCode = $('input[name="ChargeType"]').val();
        var _Approver = $('input[name="ApproverID"]').val();


        $(".ApproverPeoplePicker.TSPeoplePickerDisplay").siblings('.input-group-btn').css("pointer-events", "auto");
        $('.TSPeoplePickerDisplay.ApproverPeoplePicker').val('');
        $('.TSPeoplePickerID.ApproverPeoplePicker').val('');
        $('.TSPeoplePickerCode.ApproverPeoplePicker').val('');
        $('.TSPeoplePickerName.ApproverPeoplePicker').val('');
        
        if ((_EmployeeID != '' && _EmployeeID != undefined &&
            _StartDate != '' && _StartDate != undefined &&
            _ChargeTypeCode != '' && _ChargeTypeCode != undefined) &&
            '@Model.Item1.StatusCode' == "DR") {

            $.ajax({
                url: '../TimeAttendance/GetApprover',
                type: 'POST',
                data: {
                    EmployeeID: _EmployeeID,
                    StartDate: _StartDate,
                    ChargeTypeCode: _ChargeTypeCode,
                    Subtype: "OTPlanning",
                    EntryType: "OT Planning"
                },
                success: function (result) {
                    if (result != undefined) {
                        if (result != '') {
                            if (result.ErrorMessage != '' && result.ErrorMessage != undefined)
                            {
                                $('input[name="ApproverDisplayText"]').val('');
                                $('input[name="ApproverID"]').val('');
                                $('input[name="ApproverCode"]').val('');
                                $('input[name="ApproverName"]').val('');
                                $('input[name="ApproverDisplayText"]').siblings('.input-group-btn').css("pointer-events", "auto");
                                alert(result.ErrorMessage);

                            } else {

                                var ApproverID = result.ApproverID;
                                var ApproverCode = result.ApproverCode;
                                var ApproverName = result.ApproverName;
                                if (ApproverID != '' && ApproverID != undefined &&
                                    ApproverCode != '' && ApproverCode != undefined &&
                                    ApproverName != '' && ApproverName != undefined) {
                                    $('input[name="ApproverDisplayText"]').val(ApproverCode + ' - ' + ApproverName);
                                    $('input[name="ApproverID"]').val(ApproverID);
                                    $('input[name="ApproverCode"]').val(ApproverCode);
                                    $('input[name="ApproverName"]').val(ApproverName);
                                }
                                $('input[name="ApproverDisplayText"]').siblings('.input-group-btn').css("pointer-events", "none");
                            }
                        }
                    }
                    else {

                    }
                }
            });
        }

    }

