    function ShowErrorWarningMessage(Message) {

        for (var k in Message) {
            if (Message.hasOwnProperty(k)) {
                //console.log("Key is " + k + ", value is" + Message[k]);
                if (Message[k] != '' && Message[k] != undefined)
                {
                    alert(Message[k]);
                }
            }
        }

    }

    function CheckEmptyKeyValueMessage(Message) {
        var count = 0;
        for (var key in Message) {
            count++;
            break;
        }
        if (count == 0) {
            return false;
        } else {
            return true;
        }
    }

    function DisableActionButton() {
        $('#OTPlanningActionDiv').children().children().children('.btn').attr('disabled', true);
        $('#divLoading').show();
    }

    function EnableActionButton() {
        $('#divLoading').hide();
        $('#OTPlanningActionDiv').children().children().children('.btn').attr('disabled', false);
    }

    function ToggleFieldForSubmit(Flag)
    {
        var bool = false;
        if (!Flag)
        {
            bool = true;
        }
        $('input[name="StartDate"]').prop("disabled", bool);
        $('input[name="EndDate"]').prop("disabled", bool);

    }

    function InitiateDateTimeSetting() {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            minDate: new Date(2017, 8, 1),
            maxDate: new Date(2017, 9, 6)
        });
        $('.date-picker').datepicker('setStartDate', '@ViewBag.MinDate');
        $('.date-picker').datepicker('setEndDate', '@ViewBag.MaxDate');
        //$('.date-picker').datepicker();

        $('.timepicker-24').timepicker({
