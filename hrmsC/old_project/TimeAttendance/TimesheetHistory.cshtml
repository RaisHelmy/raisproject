
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Timesheet History (Self)";

    DateTime d3 = DateTime.Now;
    string dtStart = d3.AddDays(-7).ToString("dd/MM/yyyy");
    string dtDefault = d3.ToString("dd/MM/yyyy");

}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title <span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Start Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="StartDate" name="StartDate" value="@dtStart" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">End Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="EndDate" name="EndDate" value="@dtDefault" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="AttendanceType" onchange="changeAttendanceType(this)">
                            <option selected value="">- All -</option>
                            <option value="Attendance">Attendance</option>
                            <option value="Availability">Availability</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Subtype</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLAttendanceSubtype", "TimeAttendance", new { })
                        @*<select class="form-control" id="AttendanceSubType">
                            <option selected value="">- All -</option>
                        </select>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option selected value="">- All -</option>
                            <option value="0">Draft</option>
                            <option value="1">Pending</option>
                            <option value="2">Verified</option>
                            <option value="3">Approved</option>
                            <option value="4">Declined</option>
                            <option value="5">Withdrawn</option>
                            <option value="6">Pending Void</option>
                            <option value="7">Void</option>
                            <option value="8">Error</option>
                            <option value="9">Failed</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Charge Code</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="ChargeCode"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Charge Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="ChargeType">
                            <option selected value="">- All -</option>
                            <option value="Cost Center">Cost Center</option>
                            <option value="Order Number (Plant Maintenance)">Order Number (Plant Maintenance)</option>
                            <option value="Order Number (Job Order)">Order Number (Job Order)</option>
                            <option value="WBS Element">WBS Element</option>
                            <option value="Network Number And Operation Activity Number">Network Number And Operation Activity Number</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label"> </label>
                </div>
            </div>
        </div>
    </div>

    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>

<div id="TimesheetActionDiv">
    <div class="row">
        <div class="col-md-12">
            <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="SubmitTS('PerformActionOnSubmit'); " />
            <input type="button" class="btn green" value="Withdraw" id="btnWithdraw" onclick="WithdrawTS();" />
            <input type="button" class="btn green" value="Delete" id="btnDelete" onclick="SubmitTS('Delete');" />
        </div>
    </div>
</div>

<!-- Success Message -->
<div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well" id="SuccessMessage">
                    Claims has been successfully submitted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <a class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </a>
            </div>
        </div>
    </div>
</div>

 <!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

    </p>
</div>

<script type="text/javascript">

    function SearchListing() {
        var _DateFrom = $('#StartDate').val();
        var _DateTo = $('#EndDate').val();
        var _AttendanceType = $('#AttendanceType').val();
        var _AttendanceSubType = $('#AttendanceSubType').val();
        var _Status = $('#Status').val();
        var _ChargeCode = $('#ChargeCode').val();
        var _ChargeType = $('#ChargeType').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TimeAttendance/_TimesheetHistoryResult")',
            cache: false,
            dataType: "html",
            data: {
                StartDate: _DateFrom,
                EndDate: _DateTo,
                AttendanceType: _AttendanceType,
                AttendanceSubtype: _AttendanceSubType,
                Status: _Status,
                ChargeCode: _ChargeCode,
                ChargeType: _ChargeType
            },
            success: function (content) {
                $("#SearchResult").html(content);
                //ExportToExcel();
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function ClearFilter() {
        $('#StartDate').val('');
        $('#EndDate').val('');
        $('#ClaimCategory').val('');
        $('#Status').val('');
        $('#txtEmpName').val('');
        $('#hfEmpID').val('');
        $('#ReferenceNo').val('');
    }

    function SubmitTS(Type) {
        DisableActionButton();
        HideErrorWarningMessage();
        var _EntryIDs = "";
        var MatchAction = true;

        $("#tblResult td input[type=checkbox]:checked").each(function (i, value) {
            var row = $(this).closest("tr");
            _EntryIDs += row.find('.TimesheetHistoryCheckBox').val() + ',';
            var Status = (row.find('.Status').text()).trim();
            var CheckAction = CheckAllowedAction(Type, Status);
            if (CheckAction != '') {
                row.find('.ErrorMsg').attr('title', CheckAction);
                row.find('.ErrorMsg').show();
                MatchAction = false;
            }
        });

        switch (Type) {
            case 'PerformActionOnSubmit':
                Action = 'Submitted';
                break;
            case 'Cancel':
                Action = 'Cancelled';
                break;
            case 'Submit':
                Action = 'Submitted';
                break;
            case 'Draft':
                Action = 'Saved as Draft';
                break;
            case 'Delete':
                Action = 'Deleted';
                break;
            default:
        }

        if (_EntryIDs != "") {
            if (MatchAction) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Content("~/TimeAttendance/SubmitTimesheetAction")',
                    data: {
                        EntryIDs: _EntryIDs,
                        SubmitType: Type
                    },
                    success: function (result) {
                        if (result.result == true) {

                            $('#SuccessSubmit').modal();
                            $('#SuccessMessage').html("Timesheet has been successfully " + Action);
                            $('#btnOK').attr('href', '../TimeAttendance/TimesheetHistory');
                        } else {
                            if (CheckEmptyKeyValueMessage(result.EntryErrorMessage)) {
                                ShowErrorWarningMessage(result.EntryErrorMessage);
                            }
                            else if (result.ErrorMessage != '') {
                                alert(result.ErrorMessage);
                            }
                            else {
                                alert('Unknown error occurs. Please contact your system administrator.');
                            }
                        }
                    },
                    error: function (e) {
                        console.log(e);
                    }
                });
            }
            else {
                alert('Action is not allow.');
            }
        }
        else {
            alert('Please select entry to proceed.');
        }
        EnableActionButton();
    }

    function WithdrawTS() {
        DisableActionButton();
        HideErrorWarningMessage();
        var _EntryIDs = "";
        var MatchWithdrawnAction = true;

        $("#tblResult td input[type=checkbox]:checked").each(function (i, value) {
            var row = $(this).closest("tr");
            _EntryIDs += row.find('.TimesheetHistoryCheckBox').val() + ',';
            var Status = (row.find('.Status').text()).trim();
            if (Status != 'Pending' && Status != 'Verified') {
                row.find('.ErrorMsg').attr('title', 'Unsuccessful. Only Pending/Verified record can be withdrawn.');
                row.find('.ErrorMsg').show();
                MatchWithdrawnAction = false;
            }
        });


        if (_EntryIDs != "") {
            if (MatchWithdrawnAction) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Content("~/TimeAttendance/WithdrawTS")',
                    data: {
                        EntryIDs: _EntryIDs
                    },
                    success: function (result) {
                        if (result.result == true) {

                            $('#SuccessSubmit').modal();
                            $('#SuccessMessage').html("Timesheet has been successfully " + "Withdrawn.");
                            $('#btnOK').attr('href', '../TimeAttendance/TimesheetHistory');
                        } else {
                            if (CheckEmptyKeyValueMessage(result.EntryErrorMessage)) {
                                ShowErrorWarningMessage(result.EntryErrorMessage);
                            } else {
                                alert('Unknown error occurs. Please contact your system administrator.');
                            }
                        }
                    },
                    error: function (e) {
                        console.log(e);
                    }
                });
            }
            else {
                alert('Action is not allow.');
            }
        }
        else {
            alert('Please select entry to proceed.');
        }
        EnableActionButton();
    }

    function CheckAllowedAction(Action, Status) {
        if (Action == 'PerformActionOnSubmit') {
            if (Status != 'Draft') {
                return 'Unsuccesful. Please submit draft record only.';
            }
        }
        if (Action == 'Withdraw') {
            if (Status != 'Pending') {
                return 'Unsuccesful. Only Pending record can be withdrawn.';
            }
        }
        if (Action == 'Cancel') {
            if (Status != 'Approved') {
                return 'Unsuccesful. Only Approved record can be cancelled.';
            }
        }
        if (Action == 'Delete') {
            if (Status != 'Draft') {
                return 'Unsuccesful. Only Draft record can be deleted.';
            }
        }

        return '';
    }

    function ShowErrorWarningMessage(Message) {

        for (var k in Message) {
            if (Message.hasOwnProperty(k)) {
                //console.log("Key is " + k + ", value is" + Message[k]);

                $("#tblResult td input[type=checkbox]:checked").each(function (i, value) {
                    var row = $(this).closest("tr");
                    var EntryID = row.find('.TimesheetHistoryCheckBox').val();
                    if (k == EntryID) {
                        row.find('.ErrorMsg').attr('title', Message[k]);
                        row.find('.ErrorMsg').show();

                        return;
                    }
                });
            }
        }

    }

    function HideErrorWarningMessage() {
        $('.ErrorMsg').attr('title', '');
        $('.ErrorMsg').hide();
    }

    function CheckEmptyKeyValueMessage(Message) {
        var count = 0;
        for (var key in Message) {
            count++;
            break;
        }
        if (count == 0) {
            return false;
        } else {
            return true;
        }
    }

    function SelectUnselectAll(element) {
        $('#tblResult .TimesheetHistoryCheckBox').prop('checked', element.checked);
        $.uniform.update();
    }


    function DisableActionButton() {
        $('#TimesheetActionDiv').children().children().children('.btn').attr('disabled', true);
        $('#divLoading').show();
    }

    function EnableActionButton() {
        $('#divLoading').hide();
        $('#TimesheetActionDiv').children().children().children('.btn').attr('disabled', false);
    }


    function changeAttendanceType(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TimeAttendance/_DDLAttendanceSubtype")',
            cache: false,
            dataType: "html",
            data: { AttendanceType: e.value },
            success: function (content) {
                $("#AttendanceSubtypeResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        SearchListing();

        $('#SelectAll').on('change', SelectUnselectAll);
    });



</script>

