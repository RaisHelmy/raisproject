@model Tuple<int?, string, string>
@{
    Layout = null;
    string IFMSBookingNoName = "";
    string entries = "";
    string Type = "";

    if (Model.Item1 != null)
    {
        if (Model.Item1 >= 0)
        {
            entries = "Entries[" + Model.Item1 + "].";
        }
    }

    Type = (!string.IsNullOrEmpty(Model.Item2)) ? Model.Item2 : "";

    IFMSBookingNoName = entries + Type + "IFMSBookingNo";

    string IFMSBookingNoValue = string.IsNullOrEmpty(Model.Item3) ? "" : Model.Item3;
}

<div>
    <div class="input-group">
        <input type="text" class="form-control IFMSBookingNoDisplayText" name="IFMSBookingNoDisplayText" value="@IFMSBookingNoValue" readonly />
        <span class="input-group-btn" style="">
            <a data-toggle="modal" href="#SearchIFMSBookingNo" class="btn default IFMSBookingNoPicker"><i class="fa fa-list-alt"></i></a>
        </span>
        <input class="IFMSBookingNoPickerValue" type="hidden" name="@IFMSBookingNoName" value="@IFMSBookingNoValue"/>
    </div>
</div>