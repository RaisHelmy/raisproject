@model List<TimeAttendance.Models.OTPlanningEntryVM>

@{
    Layout = "";

}

<table id="tblApprovedOTPlanningSearch" class="table table-striped table-bordered table-hover table-full-width">
    <thead>
        <tr>
            <th scope="col" width="5%">
                <input type="checkbox" name="SelectAllApproverOTPlanning" id="SelectAllApproverOTPlanning" onchange="SelectUnselectAllApproverOTPlanning(this);" />
            </th>
            <th scope="col">Code</th>
            <th scope="col">Employee</th>
            <th scope="col">Start Date</th>
            <th scope="col">End Date</th>
            <th scope="col">Start Time</th>
            <th scope="col">End Time</th>
            <th scope="col">Total Hours</th>
            <th scope="col">Charge Code</th>
            <th scope="col">Description</th>

        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td><input type="checkbox" class="AddOTCode" name="AddOTCode" value="@Model[i].EntryID" /></td>
                    <td class="EntryCode">@Model[i].EntryCode</td>
                    <td class="Remarks">@Model[i].EmployeeCode - @Model[i].EmployeeName </td>
                    <td class="StartDate">@Model[i].sDate </td>
                    <td class="EndDate">@Model[i].eDate </td>
                    <td class="StartTime">@Model[i].sTime </td>
                    <td class="EndTime">@Model[i].eTime </td>
                    <td class="TotalHours">@Model[i].TotalHours.ToString() </td>
                    <td class="ChargeCode">@Model[i].ChargeCode </td>
                    <td class="Description">@Model[i].Description </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9">
                    No record available.
                </td>
            </tr>
        }

    </tbody>
</table>


<script>
    //   transformtable("#tblOTPlanningCodeSearch");
    $('#tblApprovedOTPlanningSearch').dataTable()
    var tableWrapper = "#tblApprovedOTPlanningSearch_wrapper";

    jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
    jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
    jQuery(tableWrapper + ' .dataTables_length select').select2({
        showSearchInput: false //hide search box with special css class
    });



    function SelectUnselectAllApproverOTPlanning(element) {
        $('#tblApprovedOTPlanningSearch .AddOTCode').prop('checked', element.checked);
        $.uniform.update();
    }
</script>