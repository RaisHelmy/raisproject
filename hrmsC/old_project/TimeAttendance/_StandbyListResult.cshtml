@using TimeAttendance.Services

@model List<TimeAttendance.Models.StandByListVM>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Standby Planning
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Company</th>
                                <th>Department</th>
                                <th>Unit / Section</th>
                                <th>Employee</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                    decimal Number = 1;
                                    foreach (var item in @Model)
                                    {
                                        <tr>
                                            <td>
                                                @Number. @{Number = Number + 1;}
                                            </td>
                                            <td>
                                                @item.CompanyName
                                            </td>
                                            <td>
                                                @item.AreaName
                                            </td>
                                            <td>
                                                @item.SubAreaName
                                            </td>
                                            <td>
                                                @item.EmployeeCode - @item.EmployeeName
                                            </td>
                                            @if (@item.Status == "0")
                                            {
                                                <td style="color:red;" class="Status" name="Status"><b>Inactive</b></td>@*@item.Status*@
                                            }
                                            else
                                            {
                                                <td style="color:green;" class="Status" name="Status"><b>Active</b></td>@*@item.Status*@
                                            }
                                            <td>
                                                <a class="btn blue btn-sm" onclick="ViewStandBy('@item.StandByID');">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        
                                    }
                                
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>