                                        <a class="BtnPlus btn green" title="dTable_BusOutstationEquivalentNoGST" href="javascript:OTPlanningEntry_addRow();">
                                            Add Row
                                            <i class="fa fa-plus"></i>
                                        </a>
                                    </div>
                                    <div class="btn-group">
                                        <a class="BtnPlus5 btn green" title="dTable_BusOutstationEquivalentNoGST" href="javascript:OTPlanningEntry_add5Row();">
