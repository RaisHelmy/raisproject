        if ((StartDate != "" || StartDate != null) && (EndDate != "" || EndDate != null)) {

            var rowCopied = false;
            $("#tblOTPlanningEntry td input[type=checkbox]").each(function (i, value) {
                var tgtRow = $($("#tblOTPlanningEntry td input[type=checkbox]").get(i)).closest("tr");
                var tgtStartDate = $(tgtRow).find(".StartDate");
