                var tgtEmployeeDisplayText = $(tgtRow).find('input[name="EmployeeDisplayText"]');
                var tgtEmployeeID = $(tgtRow).find('input[name="Entries[' + i + '].EmployeeID"]');
                var tgtEmployeeName = $(tgtRow).find('input[name="Entries[' + i + '].EmployeeName"]');
                var tgtEmployeeCode = $(tgtRow).find('input[name="Entries[' + i + '].EmployeeCode"]');

                var tgtApproverDisplayText = $(tgtRow).find('input[name="ApproverDisplayText"]');
                var tgtApproverID = $(tgtRow).find('input[name="Entries[' + i + '].ApproverID"]');
                var tgtApproverName = $(tgtRow).find('input[name="Entries[' + i + '].ApproverName"]');
                var tgtApproverCode = $(tgtRow).find('input[name="Entries[' + i + '].ApproverCode"]');

                tgtEmployeeID.val(EmployeeID);
                tgtStartDate.val(StartDate);
                tgtEndDate.val(EndDate);
                tgtStartTime.val(StartTime);
                tgtEndTime.val(EndTime);
                tgtTotalHour.val(TotalHour);
