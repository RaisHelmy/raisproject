    function loadRowTooltip($row) {

        var _Employee = $row.find(".TSPeoplePickerDisplay").val();
        var _StartDate = $row.find(".StartDate").val();
        var _StartTime = $row.find(".StartTime").val();
        var _EndDate = $row.find(".EndDate").val();
