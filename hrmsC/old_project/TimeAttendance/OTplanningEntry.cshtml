        if ((_StartDate != '' && _StartDate != undefined) &&
            (_StartTime != '' && _StartTime != undefined) &&
            (_EndDate != '' && _EndDate != undefined) &&
            (_EndTime != '' && _EndTime != undefined) &&
            (_Employee != '' && _Employee != undefined)) {

            $($row).qtip({
                content: createRowTooltips($row),
                position: {
                    target: 'mouse',
                    adjust: {
                        mouse: true
                    }
                },
                style: {
                    width: " + this.Width + ",
                    border: {
                        width: 2,
                        radius: 5,
                        color: '#CECECE'
                    },
                    padding: 5,
                    tip: true,
                    name: 'light'
                },
                show: {
                    event: 'mouseover'
                },
                hide: {
                    event: 'mouseout'
                }
            });

        }

    }


