                var tgtAccumulatedOTHours = $(tgtRow).find(".AccumulatedOTHours");

                var tgtchargeCodeDisplayText = $(tgtRow).find(".TSChargeCodePickerName");
                var tgtChargeType = $(tgtRow).find(".TSChargeCodePickerType");
                var tgtChargeCode = $(tgtRow).find(".TSChargeCodePickerCC");
