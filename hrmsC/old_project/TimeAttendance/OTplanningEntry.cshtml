    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well" id="SuccessMessage">
                        Overtime Planning has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <a class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmSubmit" tabindex="-1" role="basic" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well" id="ConfirmMessage">
                        Are you sure you want to Submit this Claim?\n\rPress Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmitForm" submitvalue="">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

        </p>
    </div>

}
<script>
    var TimesheetAttendanceTable = $('#tblOTPlanningEntry').dataTable({
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false
    });

    function OTPlanningEntry_addRow() {
        $('input[name="AddRow"]').val('1');
        $('form').submit();
    }

    function OTPlanningEntry_add5Row() {
        $('input[name="AddRow"]').val('5');
        $('form').submit();
    }

    function OTPlanningEntry_removeRow()
    {

        $('input[name="DeleteRow"]').val('true');
        $('form').submit();

        //$("#tblOTPlanningEntry td input[type=checkbox]:checked").each(function (i, value) {
        //    var row = $(this).closest("tr");
        //    row.remove();
        //});
    }

    function ConfirmAction(_Action)
    {
        if (_Action == 'Draft') {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').removeClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Save this Timesheet Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Draft'); });
            $('#ConfirmSubmit').modal('show');
        }
        else if (_Action == 'Submit') {
            $('#btnSubmitForm').removeClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Submit this Timesheet Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Submit'); });
            $('#ConfirmSubmit').modal('show');
            $('#ConfirmSubmit').modal();
            if ($('#tblAttachment .dataTables_empty').length == 1) {
                alert("Submit this claim without attachment?");
            }
        }
    }

    function SubmitOTPlanning(Type) {
        HideErrorWarningMessage();
        DisableActionButton();
        var checkCount = 0;
        $("#tblOTPlanningEntry td input[type=checkbox]:checked").each(function (i, value) {
            checkCount += 1;
        });
        //if (checkCount <= 0 && Type != "Draft") {
        if (checkCount <= 0) {

            alert('Please select entry to proceed.');
            EnableActionButton();
        } else {

            var data = $('form').serializeArray();
            data.push(
                { name: 'SubmitType', value: Type }
            );

            PerformOTPlanningSubmission(data, Type);
        }
    }

    function PerformOTPlanningSubmission(data, Type)
    {
        HideErrorWarningMessage();
        var Action = Type;
        switch(Type)
        {
            case 'PerformActionOnSubmit':
                Action = 'Submitted';
                break;
            case 'Cancel':
                Action = 'Cancelled';
                break;
            case 'Submit':
                Action = 'Submitted';
                break;
            case 'Draft':
                Action = 'Saved as Draft';
                break;
            default:
        }

        $.ajax({
            url: '../TimeAttendance/SubmitOTPlanningAction',
            type: 'POST',
            data:  data,
            success: function (result) {

                $('#divLoading').hide();
                if (result.result == true) {


                    $('#SuccessSubmit').modal();
                    $('#SuccessMessage').html("Overtime Planning has been successfully " + Action);
                    $('#btnOK').attr('href', '../TimeAttendance/OTPlanningEntry');
                }
                else if (!result.result)
                {
                    if (CheckEmptyKeyValueMessage(result.EntryErrorMessage)) {
                        ShowErrorWarningMessage(result.EntryErrorMessage);

                    } else if (CheckEmptyKeyValueMessage(result.EntryWarningMessage)) {
                        ShowErrorWarningMessage(result.EntryErrorMessage);
                    }
                    else if (result.ErrorMessage != ''){
                        alert(result.ErrorMessage);
                    }
                    else{
                        alert('Unable to perform the requested action.');
                    }

                    EnableActionButton();
                }
                // ... Process the result ...
            }
        });
    }

    function SaveOTPlanningEntries(data, Type) {
        $.ajax({
            url: '../TimeAttendance/SaveOTEntries',
            type: 'POST',
            data: data,
            success: function (result) {

                $('#divLoading').hide();

                if (result.result == true) {
                    if(Object.keys(result.EntryWarningMessage).length === 0){
                        ShowErrorMessage(result.EntryWarningMessage);
                    }
                    $('#SuccessSubmit').modal();
                    $('#SuccessMessage').html("Overtime Planning has been successfully " + Type + 'ed');
                    $('#btnOK').attr('href', '../Claims/ClaimsHistory');
                } else {
                    if (Object.keys(result.EntryErrorMessage).length === 0) {
                        ShowErrorMessage();
                    }else {
                        alert(result.ErrorMessage);
                    }
                }
                // ... Process the result ...
            }
        });
    }

    function CalculateDateTime(rowNumber)
    {
        $("#tblOTPlanningEntry td input[type=checkbox]").each(function (i, value) {
            if (rowNumber == i)
            {
                var $row = $(this).closest("tr");
                var EmployeeID = $row.find(".TSPeoplePickerID").val();
                var StartDate = $row.find(".StartDate").val();
                var EndDate = $row.find(".EndDate").val();
                var StartTime = $row.find(".StartTime").val();
                var EndTime = $row.find(".EndTime").val();
                var TotalHour = $row.find(".TotalHour").val();

                if (StartDate != '' && EndDate != '' && StartTime != '' && EndTime != '') {

                    var workingHours = GetWorkingHours(EmployeeID, StartDate, EndDate, StartTime, EndTime, $row);
                    //var diffHours = duration.asHours() - workingHours;
                    //var Hour = parseFloat(Math.round(workingHours * 100) / 100).toFixed(2);
                    //$row.find(".TotalHour").val(workingHours);
                }
                else {
                    $($row).find(".TotalHour").val('0.00');
                }
            }
        });
    }

    function GetApprover()
    {
        var $row = $(this).closest("tr");
        $row.find('.ErrorMsg').attr('title', '');
        $row.find('.ErrorMsg').hide();
        var _EmployeeID = $row.find(".TSPeoplePickerID").val();
        var _StartDate = $row.find(".StartDate").val();
        var _ChargeTypeCode = $row.find(".TSChargeCodePickerType").val();
        var _Approver = $row.find(".ApproverPeoplePicker.TSPeoplePickerDisplay").val();


        $row.find(".ApproverPeoplePicker.TSPeoplePickerDisplay").siblings('.input-group-btn').css("pointer-events", "auto");
        $row.find('.TSPeoplePickerDisplay.ApproverPeoplePicker').val('');
        $row.find('.TSPeoplePickerID.ApproverPeoplePicker').val('');
        $row.find('.TSPeoplePickerCode.ApproverPeoplePicker').val('');
        $row.find('.TSPeoplePickerName.ApproverPeoplePicker').val('');

        if ((_EmployeeID != '' && _EmployeeID != undefined &&
            _StartDate != '' && _StartDate != undefined &&
            _ChargeTypeCode != '' && _ChargeTypeCode != undefined) ) {

            $.ajax({
                url: '../TimeAttendance/GetApprover',
                type: 'POST',
                data: {
                    EmployeeID: _EmployeeID,
                    StartDate: _StartDate,
                    ChargeTypeCode: _ChargeTypeCode,
                    Subtype: "OTPlanning",
                    EntryType: "OT Planning"
                },
                success: function (result) {
                    if (result != undefined) {
                        if (result != '') {
                            if (result.ErrorMessage != '' && result.ErrorMessage != undefined)
                            {
                                $row.find('.TSPeoplePickerDisplay.ApproverPeoplePicker').val('');
                                $row.find('.TSPeoplePickerID.ApproverPeoplePicker').val('');
                                $row.find('.TSPeoplePickerCode.ApproverPeoplePicker').val('');
                                $row.find('.TSPeoplePickerName.ApproverPeoplePicker').val('');
                                $row.find(".ApproverPeoplePicker.TSPeoplePickerDisplay").siblings('.input-group-btn').css("pointer-events", "auto");
                                alert(result.ErrorMessage);
                                $row.find('.ErrorMsg').attr('title', result.ErrorMessage);
                                $row.find('.ErrorMsg').show();
                            } else {

                                var ApproverID = result.ApproverID;
                                var ApproverCode = result.ApproverCode;
                                var ApproverName = result.ApproverName;
                                if (ApproverID != '' && ApproverID != undefined &&
