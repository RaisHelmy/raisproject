    if (string.IsNullOrEmpty(IsSupervisorMessage))
    {
        <div id="TimesheetActionDiv">
            <div class="row">
                <div class="col-md-12">
                    <input type="button" class="btn green" value="Save as Draft" id="btnDraft" onclick="SubmitOTPlanning('Draft'); " />
                    <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="SubmitOTPlanning('PerformActionOnSubmit'); " />
                </div>
            </div>
        </div>
