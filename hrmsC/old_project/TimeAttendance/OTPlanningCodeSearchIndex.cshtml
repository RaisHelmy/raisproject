

<div class="modal fade" id="SearchOTCode" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">
                    <p>OT Planning Search</p>
                </h4>
            </div>
            <div class="modal-body">
                <div>

                    <div class="row" onkeypress="return event.keyCode!=13;">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-body">
                                    <div class="row">
                                        <label class="control-label col-md-2 ">
                                            Start Date
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <div class="date date-picker input-group" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control Date" id="OTCodeStartDateSearch" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                        <label class="control-label col-md-2 ">
                                            End Date
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <div class="date date-picker input-group" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control Date" id="OTCodeEndDateSearch" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <label class="control-label col-md-2 ">
                                            Employee
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <input type="text" id="OTCodeEmployeeSearch" class="form-control" />
                                        </div>
                                        <label class="control-label col-md-2 ">
                                            Charge Code
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <input type="text" id="OTCodeChargeCodeSearch" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-group ">
                                        <div class="text-right">
                                            <input id="btn-Search" type="button" value="Search" class="btn green btn-Search" onclick="SearchOTCode();">
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div id="OTCodeResult">

                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default green" onclick="setSelectedOTCode()">Select</button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>



    function SearchOTCode()
    {
        var _StartDate = $('#OTCodeStartDateSearch').val();
        var _EndDate = $('#OTCodeEndDateSearch').val();
        var _OTCodeEmployeeSearch = $('#OTCodeEmployeeSearch').val();
        var _OTCodeChargeCodeSearch = $('#OTCodeChargeCodeSearch').val();

        $.ajax({
            url: '@Url.Content("~/TimeAttendance/_OTPlanningCodeSearchResult")',
            type: 'POST',
            data: {
                StartDate: _StartDate,
                EndDate: _EndDate,
                EmployeeSearch: _OTCodeEmployeeSearch,
                ChargeCodeSearch: _OTCodeChargeCodeSearch
            },
            success: function (result) {

                $('#OTCodeResult').html(result);
                // ... Process the result ...
            }
        });
    }

    var currentSelectedOTCode = null

    function setSelectedOTCode() {
        $.each($('input[name="AddOTCode"]:checked'), function (i, val) {
            var OTPlanningCode = $(this).parent().parent().find('.EntryCode').text().trim();

            $(currentSelectedOTCode).parent().siblings('.OTCodePickerValue').val(OTPlanningCode);
            $(currentSelectedOTCode).parent().siblings('.OTCodeDisplayText').val(OTPlanningCode);
        });

        $('#SearchOTCode').modal('toggle');
        currentSelectedOTCode = null;
    }

    function SetCurrentSelectedOTCode() {

        currentSelectedOTCode = $(this);
        $('#OTCodeResult').empty();
        //$('#chargecodedll').val('ALL');
    }

    $(function () {
        $('.OTCodePicker').on("click", SetCurrentSelectedOTCode);
    })

</script>