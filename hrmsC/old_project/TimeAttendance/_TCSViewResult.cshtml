@model TimeAttendance.Models.TCS
@{
    Layout = "";
}
<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
    <h4 class="modal-title">
        <p>TCS View</p>
    </h4>
</div>
<div class="modal-body">
    <div>
        <div class="row" onkeypress="return event.keyCode!=13;">
            <div class="col-md-12">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                TCS No.
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.TCSNo
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                PBB Description
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.PPBDesc
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Remarks
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.Remarks
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Dispatch Date/Time
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.strDispatchDateTime
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Normalised Date/Time
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.strNormalisedDateTime
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                State
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.State
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Location
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.Location
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Branch
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.Branch
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                PBB
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.PPB
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>


    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn default" data-dismiss="modal">Close</button>
</div>
