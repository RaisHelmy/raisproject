    function SearchListing() {
        var _DateFrom = $('#StartDate').val();
        var _DateTo = $('#EndDate').val();
        var _ChargeType = $('#ChargeType').val();
        var _Status = $('#Status').val();
        var _ChargeCode = $('#ChargeCode').val();
        var _EmployeeSearch = $('#EmployeeSearch').val();
        var _OTPlanningCode = $('#OTPlanningCode').val();

        if (_DateFrom === '' || _DateTo === '')
        {
            alert("Please enter Start Date & End Date");
        }
        else {
            $("#SearchResult").html("LOADING...");

            $.ajax({
                type: "GET",
                url: '@Url.Content("~/TimeAttendance/_OvertimePlanningReportResult")',
                cache: false,
                dataType: "html",
                data: {
                    StartDate: _DateFrom,
                    EndDate: _DateTo,
                    ChargeType: _ChargeType,
                    Status: _Status,
                    ChargeCode: _ChargeCode,
                    Employee: _EmployeeSearch,
                    OTPlanningCode: _OTPlanningCode
                },
                success: function (content) {
                    $("#SearchResult").html(content);
                    //ExportToExcel();
                    //BindExport();
                },
                error: function (e) {
                    console.log(e);
                }
            });
        }
        
    }


    function ClearFilter() {

        $('#StartDate').val('');
        $('#EndDate').val('');
        $('#ChargeType').val('');
        $('#Status').val('');
        $('#ChargeCode').val('');
        $('#EmployeeSearch').val('');
        $('#OTPlanningCode').val('');
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        });

        //SearchListing();

        //$('input[type=checkbox]').uniform();
    });



</script>

