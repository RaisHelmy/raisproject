@model  TimeAttendance.Models.IFMSResponse
@{
    Layout = "";
}
<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
    <h4 class="modal-title">
        <p>Booking No. View</p>
    </h4>
</div>
<div class="modal-body">
    <div>
        <div class="row" onkeypress="return event.keyCode!=13;">
            <div class="col-md-12">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Booking No.
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.BookingNo
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Emp No.
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.EmpNo
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Start Date
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.StartDate
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                End Date
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.EndDate
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Remark
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.Remark
                            </div>
                        </div>
                        <div class="row">
                            <label class="control-label col-md-3 ">
                                Vehicle No.
                            </label>
                            <div class="col-md-9 form-control-static">
                                @Model.VehicleNo
                            </div>
                        </div>
                        

                    </div>
                </div>
            </div>
        </div>


    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn default" data-dismiss="modal">Close</button>
</div>
