@model Tuple<int?, string, string>
@{
    Layout = null;
    string OTCodeName = "";
    string entries = "";
    string Type = "";

    if (Model.Item1 != null)
    {
        if (Model.Item1 >= 0)
        {
            entries = "Entries[" + Model.Item1 + "].";
        }
    }

    Type = (!string.IsNullOrEmpty(Model.Item2)) ? Model.Item2 : "";

    OTCodeName = entries + Type + "OTPlanningCode";

    string OTCodeValue = string.IsNullOrEmpty(Model.Item3) ? "" : Model.Item3;
}

<div>
    <div class="input-group">
        <input type="text" class="form-control OTCodeDisplayText" name="OTCodeDisplayText" value="@OTCodeValue" readonly />
        <span class="input-group-btn" style="">
            <a data-toggle="modal" href="#SearchOTCode" class="btn default OTCodePicker"><i class="fa fa-list-alt"></i></a>
        </span>
        <input class="OTCodePickerValue" type="hidden" name="@OTCodeName" value="@OTCodeValue"/>
    </div>
</div>