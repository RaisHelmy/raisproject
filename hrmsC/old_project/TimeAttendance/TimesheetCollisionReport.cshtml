@model List<ESS.Core.DropDownObject>

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	//to load as modal for claims particular
	if (ViewBag.TimePartial != null) { Layout = null; }
	ViewBag.Title = "Timesheet VS Leave - Collision Report";


	DateTime d3 = DateTime.Now;
	string dtStart = d3.AddDays(-7).ToString("dd/MM/yyyy");
	string dtEnd = d3.ToString("dd/MM/yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title <span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Start Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="StartDate" name="StartDate" value="@dtStart" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">End Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="EndDate" name="EndDate" value="@dtEnd" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Type</label>
                    <div class="col-md-8 form-control-static">

                        @*@Html.DropDownList("AttendanceType", new SelectList(Model, "Value", "Text"), "- All -", new { @class = "bs-select form-control" })*@
                        <select class="form-control" id="AttendanceType" onchange="changeAttendanceType(this)">
                            <option selected value="">- All -</option>
                            <option value="Attendance">Attendance</option>
                            <option value="Availability">Availability</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Subtype</label>
                    <div class="col-md-8 form-control-static">

                        @Html.Action("_DDLAttendanceSubtype", "TimeAttendance", new { })
                        @*<select class="form-control" id="AttendanceSubType">
                                <option selected value="">- All -</option>
                            </select>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option selected value="">- All -</option>
                            <option value="0">Draft</option>
                            <option value="1">Pending</option>
                            <option value="2">Verified</option>
                            <option value="3">Approved</option>
                            <option value="4">Declined</option>
                            <option value="5">Withdrawn</option>
                            <option value="6">Pending Void</option>
                            <option value="7">Void</option>
                            <option value="8">Error</option>
                            <option value="9">Failed</option>
                            <option value="10">Processed</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Charge Code</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="ChargeCode" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Charge Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="ChargeType">
                            <option selected value="">- All -</option>
                            <option value="CC">Cost Center</option>
                            <option value="PM">Order Number (Plant Maintenance)</option>
                            <option value="JO">Order Number (Job Order)</option>
                            <option value="WB">WBS Element</option>
                            <option value="NT">Network Number And Operation Activity Number</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="Employee" />
                    </div>
                    @*<div class="col-md-8 form-control-static">
                        @Html.Partial("TSPeoplePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string, string>(null, null, "Employee", ""))
                        @Html.Action("TSPeoplePickerIndex", "TimeAttendance", new { CurrEmpID = ViewBag.EmployeeID, SearchType = "" })*@
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Batch</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="Batch" />
                    </div>
                    @*<div class="col-md-8 form-control-static">

                            @Html.Action("_DDLBatchNo", "TimeAttendance", new { })
                            <select class="form-control" id="Batch">
                                <option selected value="">- All -</option>
                            </select>
                        </div>*@
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">

                </div>
            </div>
        </div>
        <div class="row">&nbsp;</div>
        <div class="row">
            <div class="col-md-12">
                <div class="text-right">
                    <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                    <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
                </div>
            </div>
        </div>
        <div class="row">&nbsp;</div>
        <div class="row">
            <div class="col-md-12">
                <div id="SearchResult">

                </div>
            </div>
        </div>
    </div>

    @{
        if (ViewBag.TimePartial != null)
        {
        @:</div>
    }
    }

    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

        </p>
    </div>

    @Html.Partial("_ExcelExport")

    <script type="text/javascript">
    function ExportToExcel() {
        // EXPORT TO EXCEL
        var ua = window.navigator.userAgent;
        var msie = ua.indexOf("MSIE ");

        // Internet Explorer
        if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {
            var _btn = document.getElementById('btn-Export');
            _btn.onclick = fnExcelReport;
        }
        else {
            $("#btn-Export").click(function (e) {
                //getting values of current time for generating the file name
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                //creating a temporary HTML link element (they support setting file names)
                var a = document.createElement('a');
                //getting data from our div that contains the HTML table
                var data_type = 'data:application/vnd.ms-excel';
                var table_div = document.getElementById('tbl_Index_DetailsResult');
                var table_html = table_div.outerHTML.replace(/ /g, '%20');
                a.href = data_type + ', ' + table_html;
                //setting the file name
                a.download = 'Timesheet_Report_' + postfix + '.xls';
                //triggering the function
                a.click();
                //just in case, prevent default behaviour
                e.preventDefault();
            });
        }
    }

    function fnExcelReport() {
        var dt = new Date();
        var day = dt.getDate();
        var month = dt.getMonth() + 1;
        var year = dt.getFullYear();
        var hour = dt.getHours();
        var mins = dt.getMinutes();
        var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
        var _fileName = 'Timesheet_VS_Leave_Collision_Report_' + postfix + '.xls';

        var tab_text = "<table border='2px'><tr bgcolor='#87AFC6'>";
        var textRange; var j = 0;
        tab = document.getElementById('tbl_Index_DetailsResult'); // id of table

        for (j = 0; j < tab.rows.length; j++) {
            tab_text = tab_text + tab.rows[j].innerHTML + "</tr>";
            //tab_text=tab_text+"</tr>";
        }

        tab_text = tab_text + "</table>";


        //var ua = window.navigator.userAgent;
        //var msie = ua.indexOf("MSIE ");

        //if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./))      // If Internet Explorer
        //{
        txtArea1.document.open("txt/html", "replace");
        txtArea1.document.write(tab_text);
        txtArea1.document.close();
        txtArea1.focus();
        sa = txtArea1.document.execCommand("SaveAs", true, _fileName);
        //}
        //else //other browser not tested on IE 11
        //    sa = window.open('data:application/vnd.ms-excel,filename=aaa.xlsx' + encodeURIComponent(tab_text));
        return (sa);
    }


    function SearchListing() {
        var _DateFrom = $('#StartDate').val();
        var _DateTo = $('#EndDate').val();
        var _AttendanceType = $('#AttendanceType').val();
        var _AttendanceSubType = $('#AttendanceSubType').val();
        var _Status = $('#Status').val();
        var _ChargeCode = $('#ChargeCode').val();
        var _ChargeType = $('#ChargeType').val();
        //var _SelectedEmployeeID = $('input[name="EmployeeID"]').val();
        var _SelectedEmployeeID = $('#Employee').val();
        var _BatchNo = $('#Batch').val();

        if (_DateFrom === '' || _DateTo === '') {

            alert("Please enter Start Date & End Date");
        }
        else {

            $("#SearchResult").html("LOADING...");

            $.ajax({
                type: "GET",
                url: '@Url.Content("~/TimeAttendance/_TimesheetCollisionReportResult")',
                cache: false,
                dataType: "html",
                data: {
                    StartDate: _DateFrom,
                    EndDate: _DateTo,
                    AttendanceType: _AttendanceType,
                    AttendanceSubtype: _AttendanceSubType,
                    Status: _Status,
                    ChargeCode: _ChargeCode,
                    ChargeType: _ChargeType,
                    Employee: _SelectedEmployeeID,
                    BatchNo: _BatchNo
                },
                success: function (content) {
                    $("#SearchResult").html(content);
                    //BindExport();
                },
                error: function (e) {
                    console.log(e);
                }
            });
        }



    }

    function ClearFilter() {

        $('#StartDate').val('');
        $('#EndDate').val('');
        $('#AttendanceType').val('');
        $('#AttendanceSubType').val('');
        $('#Status').val('');
        $('#ChargeCode').val('');
        $('#ChargeType').val('');
        $('#Employee').val('');
        $('#Batch').val('');

    }

    function changeAttendanceType(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TimeAttendance/_DDLAttendanceSubtype")',
            cache: false,
            dataType: "html",
            data: { AttendanceType: e.value },
            success: function (content) {
                $("#AttendanceSubtypeResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        //SearchListing();
    });



    </script>

