
@{ 
    Layout = "";
}
<div class="modal fade" id="OriOTPlanningViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div id="OriOTPlanningViewResult">

            </div>
        </div>
    </div>
</div>

<script>

    function ViewOriOTPlanningDetails(EntryCode) {
        $.ajax({
            url: '../TimeAttendance/_OriOTPlanningViewResult',
            type: 'GET',
            data: {
                EntryCode: EntryCode
            },
            success: function (result) {
                $("#OriOTPlanningViewResult").html(result);
                $('#OriOTPlanningViewModal').modal({
                    backdrop: 'static',
                    keyboard: true
                }, 'show');
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>