
@{ 
    Layout = "";
}
<div class="modal fade" id="TCSViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div id="TCSViewResult">

            </div>
        </div>
    </div>
</div>

<script>

    function ViewTCSDetails(TCSNo) {
        $.ajax({
            url: '../TimeAttendance/_TCSViewResult',
            type: 'GET',
            data: {
                TCSNo: TCSNo
            },
            success: function (result) {
                $("#TCSViewResult").html(result);
                $('#TCSViewModal').modal({
                    backdrop: 'static',
                    keyboard: true
                }, 'show');
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>