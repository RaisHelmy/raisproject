@model Tuple<int?, string, string>
@{
    Layout = null;
    string BookingNoName = "";
    string entries = "";
    string Type = "";
    string DisplayText = "";

    if (Model.Item1 != null)
    {
        if (Model.Item1 >= 0)
        {
            entries = "Entries[" + Model.Item1 + "].";
        }
    }

    Type = (!string.IsNullOrEmpty(Model.Item2)) ? Model.Item2 : "";
    BookingNoName = entries + Type + "BookingNo";
    DisplayText = Type + "BookingNoDisplayText";

    string BookingNoValue = string.IsNullOrEmpty(Model.Item3) ? "" : Model.Item3;

}

<div>
    <div class="input-group">
        <input type="text" class="form-control BookingNoDisplayText" name="@DisplayText" value="@BookingNoValue" readonly />
        <span class="input-group-btn" style="">
            <a data-toggle="modal" href="#SearchBookingNo" class="btn default BookingNoPicker" onclick="BookingNoPickerSetDate(this)"><i class="fa fa-list-alt"></i></a>
        </span>
        <input class="BookingNoPickerValue" type="hidden" name="@BookingNoName" value="@BookingNoValue" />
    </div>
</div>
