
@{
    Layout = "";
}
<div class="modal fade" id="BookingNoViewDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div id="BookingNoViewDetailResult">

            </div>
        </div>
    </div>
</div>

<script>

    function ViewBookingNoDetails(BookingNo) {
        $.ajax({
            url: '../TimeAttendance/_IFMSBookingNoViewDetailResult',
            type: 'GET',
            data: {
                BookingNo: BookingNo
            },
            success: function (result) {
                $("#BookingNoViewDetailResult").html(result);
                $('#BookingNoViewDetailModal').modal({
                    backdrop: 'static',
                    keyboard: true
                }, 'show');
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>