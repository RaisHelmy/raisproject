        {
            <!-- Attachment -->
            @Html.Action("TSAttachmentControl", "TimeAttendance", new { EmployeeID = ViewBag.CurrentUserID, Mode = "Add", SourceType = "Time Attendance", RequestID = Model.Item1.EntryID.ToString(), Type = "" })
        }
        else
        {
            @Html.Action("TSAttachmentControl", "TimeAttendance", new { EmployeeID = ViewBag.CurrentUserID, Mode = "View", SourceType = "Time Attendance", RequestID = Model.Item1.EntryID.ToString(), Type = "" })
        }

        @{
            if (Model.Item1.EntryStatus != "0" || DisplayAuditLog)
            {
                @Html.Action("_AuditLog", "TimeAttendance", new { SourceID = Model.Item1.EntryID.ToString() })
            }

            if (showUpdateChargeCode)
            {
                @Html.Action("_ChargeCodeUpdate", "TimeAttendance")
            }
        }


        <input type="hidden" name="TimesheetSubAction" id="TimesheetSubAction" value="" />


        @Html.Action("TSPeoplePickerIndex", "TimeAttendance", new { CurrEmpID = ViewBag.EmployeeID, SearchType = "" })
