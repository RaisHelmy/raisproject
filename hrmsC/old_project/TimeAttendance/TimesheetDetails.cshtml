@using TimeAttendance.Services

@model Tuple<TimeAttendance.Models.TimesheetAttendanceVM, List<SEP.RoutingManagement.Service.AllowAction>>

@{
    bool DisplayAuditLog = ViewBag.DisplayAuditLog;
    ViewBag.Title = (!string.IsNullOrEmpty(ViewBag.TaskID) && (Model.Item2[0].CanApprove == "1" || Model.Item2[0].CanVerify == "1")) ?
                    "Timesheet Approval" :
                    "Timesheet Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime FirstMondayOfLastWeek = DateTime.Now;
    while (FirstMondayOfLastWeek.DayOfWeek != DayOfWeek.Monday)
    {
        FirstMondayOfLastWeek = FirstMondayOfLastWeek.AddDays(-1);
    }
    FirstMondayOfLastWeek = FirstMondayOfLastWeek.AddDays(-7);
    DateTime WorkScheduleFromDate = FirstMondayOfLastWeek;
    DateTime WorkScheduleToDate = DateTime.Now;

    DateTime prevMonth = DateTime.Today.AddMonths(-1);
    DateTime MinDate = new DateTime(prevMonth.Year, prevMonth.Month, 1);
    DateTime MaxDate = DateTime.Now;

    string dtStrStart = MinDate.ToString("dd MM yyyy");
    string dtStrEnd = MaxDate.ToString("dd MM yyyy");

    bool UpdateChargeCode = ViewBag.UpdateChargeCode;
    bool showUpdateChargeCode = Model.Item1.EntryStatus == "1" && UpdateChargeCode && Model.Item1.AttendanceSubType != "Standby"; //Model.Item1.EntryStatus != "0" && Model.Item1.EntryStatus != "1" && Model.Item1.EntryStatus != "3" && UpdateChargeCode;
}

<style>
    .timeinput::-ms-clear {
        width: 0;
        height: 0;
    }
</style>

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                @ViewBag.Title
                <span style="padding-left:20px;">
                    <small></small>
                </span>
                <input type="hidden" id="showUpdateChargeCode" value="@showUpdateChargeCode" />
                <input type="hidden" id="EntrySource" value="@ViewBag.Source" />
            </h1>
        </div>
    </div>
</div>

@using (Html.BeginForm("TimesheetAttendance", "TimesheetDetails", FormMethod.Post))
{
    <div id="tab_1" class="tab-pane active">

        @Html.Partial("_EmployeeDetails", Model.Item1.EmployeeDetail)
        @Html.Action("_SubmissionDetails", "TimeAttendance", new
        {
            TSModel = Model.Item1,
            OTModel = ""
        })
        @*new Tuple<string, string, string, string>(Model.Item1.EntryID.ToString(),
            ((Timesheet.EntryStatus)(Convert.ToInt32(Model.Item1.EntryStatus))).ToString(),
            "Timesheet",
            Model.Item1.BatchNo))*@
        <div class="row text-right form-body" style="padding-top:0px">
            <div style="margin-right:10px">
                <a href="javascript:EASyNavigation()" style="padding-top:16px;">EASy Entries</a>
                <a href="@Url.Action("WorkSchedule", "TimeAttendance", new { EmployeeID = Model.Item1.EmployeeDetail.EmployeeID.ToString()})" target="_blank" style="padding-top:16px;">Show Working Hours</a>
            </div>
        </div>
        @Html.Partial("_TimesheetEntryDetails", Model.Item1)

