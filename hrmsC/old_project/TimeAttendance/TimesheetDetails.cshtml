    function ConfirmSubmitWithWarning(WarningMsg) {
        $('#ConfirmSubmit').modal('show');
    }

    function SubmitTS(Type) {
        $('#ConfirmSubmit').modal('hide');
        DisableActionButton();
        //$('#TimesheetActionDiv').children().children().children('.btn').attr('disabled', true);
        //$('#divLoading').show();
        var disabled = $('form').find(':input:disabled').removeAttr('disabled');
        var data = $('form').serializeArray();
        disabled.attr('disabled', 'disabled')
        data.push(
            { name: 'SubmitType', value: Type }
        );

        //var _EndDate = $('input[name="EndDate"]').val();
        //var _StartTime = $('input[name="StartTime"]').val();

        //if (_EndDate >= _StartDate) {
            PerformTSSubmission(data, Type);
        //}
        //else {
        //    alert('Please select end date after the date of start date');
        //}
    }

    function PerformTSSubmission(data, Type) {
        var Action = Type;
        var SubmitWithWarning = false;
        switch (Type) {
            case 'PerformActionOnSubmit':
                Action = 'Submitted';
                break;
            case 'SubmitWithWarning':
                Action = 'Submitted';
                SubmitWithWarning = true;
            case 'Cancel':
                Action = 'Cancelled';
                break;
            case 'Submit':
                Action = 'Submitted';
                break;
            case 'Delete':
                Action = 'Deleted';
                break;
            case 'Draft':
                Action = 'Saved as Draft';
                break;
            case 'ConvertToDraft':
                Action = 'convert to Draft';
                break;
            default:
        }
        $.ajax({
            url: '../TimeAttendance/SubmitTimesheetAction',
            type: 'POST',
            data: data,
            success: function (result) {

                $('#divLoading').hide();
                if (result.result == true) {

                    EnableActionButton();
                    if (!SubmitWithWarning && CheckEmptyKeyValueMessage(result.EntryWarningMessage)) {
                        ShowErrorWarningMessage(result.EntryErrorMessage);
                        ConfirmSubmitWithWarning();
                    }
                    else {
                        $('#SuccessSubmit').modal();
                        $('#SuccessMessage').html("Timesheet has been successfully " + Action);
                        if (Action == 'convert to Draft') {
                            $('#btnOK').attr('href', '../TimeAttendance/TimesheetHistoryBulk');
                        }
                        else if ('@ViewBag.Source' != '') {
                            $('#btnOK').attr('href', '../TimeAttendance/' + '@ViewBag.Source');
                        }
                        else {
                            $('#btnOK').attr('href', '../TimeAttendance/TimesheetHistoryBulk');
                        }
                    }
                }
                else if (!result.result) {

                    if (CheckEmptyKeyValueMessage(result.EntryErrorMessage)) {
                        //alert('error routing');
                        ShowErrorWarningMessage(result.EntryErrorMessage);

                    } else if (CheckEmptyKeyValueMessage(result.EntryWarningMessage)) {
                        //alert('error routing');
                        ShowErrorWarningMessage(result.EntryWarningMessage);
                    }
                    else if (result.ErrorMessage != '' && result.ErrorMessage != undefined) {

                        alert(result.ErrorMessage);
                    }

                    EnableActionButton();
                }
                // ... Process the result ...
            }
        });

    }

