    function ToggleOvertimeEntryControl() {
        var AttendanceSubtype = $('select[name="AttendanceSubType"]').val();

        if (AttendanceSubtype == "@Timesheet.AttendanceSubtype.Overtime.ToString()") {
            $(".TCSNoDisplayText").siblings('.input-group-btn').css("pointer-events", "auto");
            $(".OTCodeDisplayText").siblings('.input-group-btn').css("pointer-events", "auto");
            $(".NoOfMeal").removeAttr('disabled');
        }
        else {
            $(".TCSNoDisplayText").siblings('.input-group-btn').css("pointer-events", "none");
            $(".TCSNoDisplayText").val('');
            $(".TCSNoPickerValue").val('');
            $(".OTCodeDisplayText").siblings('.input-group-btn').css("pointer-events", "none");
            $(".OTCodeDisplayText").val('');
            $(".OTCodePickerValue").val('');
            $(".NoOfMeal").attr('disabled', 'disabled');
            $(".NoOfMeal").val('');
        }
    }

    function EASyNavigation() {
        var StartDate = $('input[name="StartDate"]').val();
        var EndDate = $('input[name="EndDate"]').val();
        if ((StartDate == '' || StartDate == undefined)) {
            StartDate = $('input[name="hfStartDate"]').val();
        }
        if ((EndDate == '' || EndDate == newEndDate)) {
            EndDate = $('input[name="hfEndDate"]').val();
        }
        var EmployeeCode = '@Model.Item1.EmployeeDetail.EmployeeCode';

        var DateTimeStartDate = moment(StartDate, "DD/MM/YYYY").add(-1, 'days');
        var DateTimeEndDate = moment(EndDate, "DD/MM/YYYY").add(+1, 'days');
        var newStartDate = DateTimeStartDate.format('YYYY-MM-DD');
        var newEndDate = DateTimeEndDate.format('YYYY-MM-DD');

        if ((newStartDate != '' && newStartDate != undefined) &&
            (newEndDate != '' && newEndDate != undefined) &&
            (EmployeeCode != '' && EmployeeCode != undefined)) {
            var EAsyPath = '../TimeAttendance/EASyDoorAccess' + '?employeeCode=' + EmployeeCode + '&StartDate=' + newStartDate + '&EndDate=' + newEndDate;
            window.open(EAsyPath);
        }
    }


