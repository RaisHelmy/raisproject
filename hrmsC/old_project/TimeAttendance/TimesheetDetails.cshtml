    function WithdrawTS() {
        DisableActionButton();
        var _EntryIDs = $('#EntryID').val();
        if (_EntryIDs != "") {
            _EntryIDs = _EntryIDs + ',';
        }

        if (_EntryIDs != "") {
            $.ajax({
                type: "POST",
                url: '@Url.Content("~/TimeAttendance/WithdrawTS")',
                data: {
                    EntryIDs: _EntryIDs
                },
                success: function (result) {
                    if (result.result == true) {

                        EnableActionButton();
                        $('#SuccessSubmit').modal();
                        $('#SuccessMessage').html("Timesheet has been successfully " + "Withdrawn.");

                        if ('@ViewBag.Source' != '') {
                            $('#btnOK').attr('href', '../TimeAttendance/' + '@ViewBag.Source');
                        }
                        else {
                            $('#btnOK').attr('href', '../TimeAttendance/TimesheetHistoryBulk');
                        }


                    } else {
                        if (CheckEmptyKeyValueMessage(result.EntryErrorMessage)) {
                            ShowErrorWarningMessage(result.EntryErrorMessage);
                        } else {
                            alert('Request action failed.');
                        }
                        EnableActionButton();
                    }
                },
                error: function (e) {
                    console.log(e);
                    EnableActionButton();
                }
            });
        }
        else {
            alert('Please select entry to proceed.');
            EnableActionButton();
        }
    }

