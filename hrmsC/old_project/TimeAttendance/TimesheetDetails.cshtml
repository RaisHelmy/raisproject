    <div id="TimesheetActionDiv">
        <div class="row">
            <div class="col-md-12">
                @if (Model.Item1.CanEdit)
                {
                    <input type="button" class="btn green" value="Edit" id="btnEdit" onclick="SubmitTS('ConvertToDraft');" />
                }
                @if (Model.Item1.CanSave)
                {
                    <input type="button" class="btn green" value="Save as Draft" id="btnDraft" onclick="SubmitTS('Draft'); " />
                }
                @if (Model.Item1.CanSubmit)
                {
                    <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="SubmitTS('PerformActionOnSubmit'); " />
                }
                @if (Model.Item1.CanDelete)
                {
                    <input type="button" class="btn green" value="Delete" id="btnDelete" onclick="SubmitTS('Delete');" />
                }
                @if (Model.Item1.CanWithdraw)
                {
                    <input type="button" class="btn green" value="Withdraw" id="btnWithdraw" onclick="WithdrawTS();" />
                }
                @if (Model.Item2[0].CanCancel == "1")
                {
                    <input type="button" class="btn green" value="Cancel" id="btnCancel" onclick="CancelTS();" />
                }
                @{
                    if (!string.IsNullOrEmpty(ViewBag.TaskID))
                    {
                        @*if (Model.Item2[0].CanSubmit == "1")
                            {
                                <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="PostApproverAction('Submit'); " />
                            }*@
                        if (Model.Item2[0].CanApprove == "1")
                        {
