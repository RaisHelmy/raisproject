@using ESS.Core;

@{
    ViewBag.Title = "";
    Layout = null;

    string EmployeeID = ViewBag.EmployeeID;
    string EmployeeName = ViewBag.EmployeeName;
    string EmployeeCode = ViewBag.EmployeeCode;
    string EntryType = ViewBag.EntryType;
    string BatchNo = ViewBag.BatchNo;
    string Status = ViewBag.Status;
    string OTPlanningCode = ViewBag.OTPlanningCode;
}


<div id="tab_1" class="tab-pane active">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle">@*<img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" />*@</div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Submission Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Verifier / Approver</label>
                                        <div class="col-md-8 form-control-static">
                                            @*@Common.GetCurrentApproverName(@Model.Item1)*@
                                            @if (!string.IsNullOrEmpty(EmployeeID))
                                            {
                                                <a href="@Url.Action("Index", "Employee", new {EmployeeID = EmployeeID })" target="_blank">@EmployeeCode</a><span> - @EmployeeName</span>
                                            }
                                            else
                                            {

                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Status</label>
                                        @if (Status == "Withdrawn" ||
                                             Status == "Declined" ||
                                             Status == "Error" ||
                                             Status == "Failed")
                                        {
                                            <div class="col-md-8 form-control-static" style="color:red; font-weight:bold;">
                                                @Status
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-8 form-control-static" style="color:green; font-weight:bold;">
                                                @Status
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (EntryType == "Timesheet")
                        {

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Batch No.</label>

                                            @if (!string.IsNullOrEmpty(BatchNo))
                                            {
                                                <div class="col-md-8 form-control-static">
                                                    @BatchNo
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-md-8 form-control-static">
                                                    -
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (EntryType == "OT Planning")
                        {

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">OT Planning Code</label>

                                            @if (!string.IsNullOrEmpty(OTPlanningCode))
                                            {
                                                <div class="col-md-8 form-control-static">
                                                    @OTPlanningCode
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-md-8 form-control-static">
                                                    -
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>