@model List<ESS.Core.DropDownObject>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Standby Planning";
    DateTime Today = DateTime.Now;
    Decimal Year = Convert.ToDecimal(Today.ToString("yyyy")) +  1;

    //if (Model.Count <= 0)
    if (!RoleMaintenance.RoleService.IsInRole("Time Attendance", "StandByStaff"))
    {
        Response.Redirect("~/AccessControl/ErrorPermission");
    }
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title <span style="padding-left:20px;"><small></small></span>
            <input type="hidden" value="@Year"/>
        </h1>
    </div>
</div>
<br />
<div class="form-body">

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Year</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Year">

                            <option value="@Year">@Year @{Year = Year - 1;}</option>
                            <option selected value="@Year">@Year @{Year = Year - 1;}</option>
                            <option value="@Year">@Year @{Year = Year - 1;}</option>
                            <option value="@Year">@Year @{Year = Year - 1;}</option>
                            <option value="@Year">@Year</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option selected value="">- All -</option>
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Company</label>
                    <div class="col-md-8 form-control-static">
                            @Html.DropDownList("Company", new SelectList(Model, "Value", "Text"), "- All -", new { @class = "bs-select form-control", @onchange = "changeCompany(this)"})
                          
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Department</label>
                    <div class="col-md-8 form-control-static">

                        @Html.Action("_DDLDepartment", "TimeAttendance", new { })
                      
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Unit / Section</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLUnitSection", "TimeAttendance", new { })
                    
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Partial("TSPeoplePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string, string>(null, null, "SearchEmployee", ""))
                    </div>
                </div>
            </div>
        </div>
    </div>
