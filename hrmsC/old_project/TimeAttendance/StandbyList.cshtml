    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                @*<input type="button" id="btn-Clear" class="btn btn-Search" value="Clear" onclick="ClearFilter();">*@
            </div>
