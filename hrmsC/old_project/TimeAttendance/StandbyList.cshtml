<script>

    function SearchListing() {

        var _Year = $('#Year').val();
        var _Status = $('#Status').val();

        var _CompanyCode = $('#Company option:selected').val();
        var _DepartmentCode = $('#Department option:selected').val();
        var _UnitSectionCode = $('#UnitSection option:selected').val();
        var _SearchEmpID = $('input[name="SearchEmployeeID"]').val();

        if (_CompanyCode == '' && _SearchEmpID == '') {
            alert('Please specific either Company or Employee.');
        }
        else {
            $("#SearchResult").html("LOADING...");

            $.ajax({
                type: "GET",
                url: '@Url.Content("~/TimeAttendance/_StandByListResult")',
                cache: false,
                dataType: "html",
                data: {
                    Year: _Year,
                    Status: _Status,
                    Division: _CompanyCode,
                    Department: _DepartmentCode,
                    Section: _UnitSectionCode,
                    EmployeeID: _SearchEmpID
                },
                success: function (content) {
                    $("#SearchResult").html(content);
                },
                error: function (e) {
                    console.log(e);
                }
            });
        }
        
    }

    function ViewStandBy(ID)
    {
        $.ajax({
            url: '../TimeAttendance/_Standby',
            type: 'GET',
            data: {
                ID: ID,
                Mode: "View"
            },
            success: function (result) {
                $("#StandByResult").html(result);
                $('#StandByModal').modal({
                    backdrop: 'static',
                    keyboard: true
                }, 'show');
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function changeCompany(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TimeAttendance/_DDLDepartment")',
            cache: false,
            dataType: "html",
            data: { CompanyCode: e.value },
            success: function (content) {
                $("#DepartmentResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function changeDepartment(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TimeAttendance/_DDLUnitSection")',
            cache: false,
            dataType: "html",
            data: { DepartmentCode: e.value },
            success: function (content) {
                $("#UnitSectionResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function AddNew()
    {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TimeAttendance/_StandBy")',
            cache: false,
            dataType: "html",
            data: {
                ID: "",
                Mode: "Insert"
            },
            success: function (result) {
                $("#StandByResult").html(result);
                $('#StandByModal').modal({
                    backdrop: 'static',
                    keyboard: true
                }, 'show');
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function ClearFilter() {
        $('#Status').val('');

        $('#Company').val('');
        $('#Department').val('');
        $('#UnitSection').val('');
        $('input[name="SearchEmployeeID"]').val('');
        $('input[name="SearchEmployeeDisplayText"]').val('');

    }

    $(document).ready(function () {
        //$('select[name="Company"]').val('@ViewBag.CompanyCode');
        //$('select[name="Company"]').change();
        //SearchListing();
    });

</script>
