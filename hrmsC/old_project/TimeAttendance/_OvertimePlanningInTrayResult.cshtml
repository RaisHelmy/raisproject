@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Overtime Planning In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th width="5%"></th>
                                <th width="5%">
                                    <input type="checkbox" name="SelectAll" id="SelectAll" onchange="SelectUnselectAll(this);" />
                                </th>
                                <th></th>
                                <th>Action</th>
                                <th>Status</th>
                                <th>Employee</th>
                                <th>Description</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Total Hours</th>
                                <th>Acc OT Hours</th>
                                <th>Charge Code</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <div>
                                            <i class="fa fa-exclamation-circle ErrorMsg" name="ErrorMsg" 
                                               style="font-size:24px;color:red;display: none" 
                                               data-toggle="tooltip" title="" ></i>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="checkbox" class="OTPlanningCheckBox" name="OTPlanningCheckBox" value="@item.ID" />
                                        <input type="hidden" class="EntryID" name="EntryID" value="@item.SourceID" />
                                    </td>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/TimeAttendance/OTDetails")?ID=@item.SourceID&TaskID=@item.ID&Source=OvertimePlanningInTray">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td class="YesAction" name="YesAction"> @item.YesAction </td>
                                    @if (@item.DisplayText6 == "Declined" || @item.DisplayText6 == "Withdrawn")
                                    {
                                        <td style="color:red;" class="Status" name="Status"><b>@item.DisplayText6</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;" class="Status" name="Status"><b>@item.DisplayText6</b></td>
                                    }
                                    <td>@item.DisplayText9 - @item.DisplayText8</td>
                                    <td>@item.DisplayText15</td>
                                    <td>@item.DisplayText2</td>
                                    <td>@item.DisplayText3</td>
                                    <td>@item.DisplayText4</td>
                                    <td>@item.DisplayText5</td>
                                    <td>@item.DisplayText10</td>
                                    <td>@item.DisplayText11</td>
                                    <td>@item.DisplayText12</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_includeDataTableScripts")

<script type="text/javascript">

    var tblResult = $('#tblResult').dataTable({
        "fnDrawCallback": function (settings) {
            $('input[type="checkbox"]').uniform();
        },
        aoColumnDefs: [
        {
            bSortable: false,
            aTargets: [1]
        }]

    });

    $(function () {
        $('input[type="checkbox"]').uniform();
    });
</script>