
<div class="modal fade" id="BulkChargeCodeEntry" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">
                    <p>Bulk Charge Code Entry</p>
                </h4>
            </div>
            <div class="modal-body">
                <div>
                    <div class="row" onkeypress="return event.keyCode!=13;">
                        <div class="col-md-12">
                            <div class="form-body">
                                <div class="form-horizontal">
                                    <div class="row">
                                        <div class="form-group">
                                            <label class="control-label col-md-2 ">
                                                Subtype
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <select class="bs-select form-control" name="BulkAttendanceSubType">
                                                    <option value="NormalHour">Normal Hour</option>
                                                    <option value="Overtime">Overtime</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <label class="control-label col-md-2 ">
                                                Start Date
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <div class="date date-picker input-group eDate" data-date-format="dd MM yyyy">
                                                    <input type="text" class="form-control Date" name="BulkStartDate" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                            <label class="control-label col-md-2 ">
                                                End Date
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <div class="date date-picker input-group eDate" data-date-format="dd MM yyyy">
                                                    <input type="text" class="form-control Date" name="BulkEndDate" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <label class="control-label col-md-2 ">
                                                Start Time
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <input type="text" class="form-control timeinput " name="BulkStartTime" placeholder="HH:MM" />
                                            </div>
                                            <label class="control-label col-md-2 ">
                                                End Time
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                <input type="text" class="form-control timeinput" name="BulkEndTime" placeholder="HH:MM" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group ">
                                            <label class="control-label col-md-2 ">
                                                Charge Code*
                                            </label>
                                            <div class="col-md-4 form-control-static">
                                                @Html.Partial("TSChargeCodePicker", new Tuple<int?, List<TimeAttendance.Models.TimesheetAttendanceVM>, string>((int?)-1, null,"Bulk"))
                                            </div>

                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group ">
                                            <label class="control-label col-md-2 ">
                                                Description*
                                            </label>
                                            <div class="col-md-8 form-control-static">
                                                <textarea class="form-control" style="width:100%;" name="BulkDescription"></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default green" onclick="PopulateBulkChargeCodeEntry()">Generate</button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function PopulateBulkChargeCodeEntry()
    {
        $('input[name="TimesheetSubAction"]').val('BulkChargeCodeEntry');
        $('form').submit();
    }
</script>

