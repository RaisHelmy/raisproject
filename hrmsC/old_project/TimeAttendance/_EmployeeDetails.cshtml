@model TimeAttendance.Models.EmployeeDetails

@{
    ViewBag.Title = "";
    Layout = null;
}


<div id="tab_1" class="tab-pane active">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle">@*<img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" />*@</div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Employee Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee Number</label>
                                        <div class="col-md-8 form-control-static">
                                            @Model.EmployeeCode
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Division / Department</label>
                                        <div class="col-md-8 form-control-static">
                                            @Model.AreaName
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee Name</label>
                                        <div class="col-md-8 form-control-static">
                                            @Model.EmployeeName
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Unit / Section</label>
                                        <div class="col-md-8 form-control-static">
                                            @Model.SubAreaName
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Cost Center</label>
                                        <div class="col-md-8 form-control-static">
                                            @Model.CostCenterCode - @Model.CostCenterName
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Immediate Manager</label>
                                        <div class="col-md-8 form-control-static">
                                            @Model.ManagerName
                                            @*@Common.GetCurrentApproverName(@Model.EntryID.ToString())*@
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>