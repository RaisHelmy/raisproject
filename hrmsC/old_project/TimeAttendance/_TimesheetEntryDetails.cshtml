                                                    <label class="control-label col-md-4">No. of Meal</label>
                                                    <div class="col-md-8 form-control-static">

                                                        @{
                                                            string strNoOfMeal = Model.PremiumNo;
                                                            string NoOfMeal = !string.IsNullOrEmpty(strNoOfMeal) ? strNoOfMeal.Substring(strNoOfMeal.Length - 1) : "";
                                                        }
                                                        @NoOfMeal

                                                    </div>
                                                </div>
                                            </div>
                                        </div>*@
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Call Out</label>
                                                <div class="col-md-8 form-control-static">
                                                    @if (Model.CallOut == true)
                                                    {
                                                        <input type="checkbox" class="CallOut" name="CallOut" checked="checked" value="true" disabled />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" class="CallOut" name="CallOut" value="true" disabled />
                                                    }
                                                    @*@Model.CallOut*@
                                                    @*<input type="checkbox" class="form-control" name="CallOut" value="@Model.CallOut" />*@
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            }
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Description</label>
                                            <div class="col-md-10 form-control-static">
                                                @Html.TextAreaFor(m => m.Description, new { @class = "form-control Description", @name = "Description", rows = "5", @maxlength = "1000", @readonly = "readonly" })
                                                @*<textarea class="form-control" style="width:100%;" name="Description" value="@Model.Description"></textarea>*@
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>

    $(document).ready(function () {

        if ('@Model.AttendanceType' == '@Timesheet.TimesheetEntryType.Availability.ToString()') {
            $('.DivStandbyHide').hide();
        }

    });


</script>