@using TimeAttendance.Services

@model TimeAttendance.Models.TimesheetAttendanceVM

@{
    ViewBag.Title = "";
    Layout = null;
    bool IsExecEmp = false;

    IsExecEmp = Timesheet.IsExecutive(Model.EmployeeID.ToString());
}


<input type="hidden" class="EntryID" id="EntryID" name="EntryID" value="@Model.EntryID" />
<input type="hidden" class="TimesheetEntryCheckBox" name="TimesheetEntryCheckBox" value="@Model.EntryID" />
<input type="hidden" class="TaskID" id="TaskID" name="TaskID" value="@Model.TaskID" />
<input type="hidden" class="EmployeeID" id="EmployeeID" name="EmployeeID" value="@Model.EmployeeID" />
<input type="hidden" class="hfAttendanceSubtype" id="hfAttendanceSubtype" name="hfAttendanceSubtype" value="@Model.AttendanceSubType" />
<input type="hidden" class="hfNoOfMeal" id="hfNoOfMeal" name="hfNoOfMeal" value="@Model.NoOfMeal" />
<input type="hidden" class="hfPremiumNo" id="hfPremiumNo" name="hfPremiumNo" value="@Model.PremiumNo" />
<input type="hidden" class="hfStartDate" id="hfStartDate" name="hfStartDate" value="@Model.sDate" />
<input type="hidden" class="hfEndDate" id="hfEndDate" name="hfEndDate" value="@Model.eDate" />
@*<input type="hidden" class="SupervisorID" id="SupervisorID" name="SupervisorID" value="@Model.SupervisorID" />*@



@if (Model.EditMode)
{
    <div id="tab_1" class="tab-pane active">
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle">@*<img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" />*@</div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Timesheet Details
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Type</label>
                                            <div class="col-md-8 form-control-static">
                                                <input type="text" class="form-control" name="AttendanceType" value="@Model.AttendanceType" readonly />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Charge Code *</label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.Partial("TSChargeCodePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string>(null, @Model, ""))
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                @if (Model.AttendanceType == Timesheet.TimesheetEntryType.Attendance.ToString())
                                {
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Subtype</label>
                                                <div class="col-md-8 form-control-static">
                                                    <select class="form-control" name="AttendanceSubType" value="@Model.AttendanceSubType" onchange="ToggleOvertimeEntryControl()" disabled>
                                                        <option value="Normal Hour">Normal Hour</option>
                                                        <option value="Overtime">Overtime</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (Model.AttendanceType == Timesheet.TimesheetEntryType.Availability.ToString())
                                {
                                    <input type="hidden" name="StandBy" value="true" />
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Subtype</label>
                                                <div class="col-md-8 form-control-static">
                                                    <select class="form-control" name="AttendanceSubType" value="@Model.AttendanceSubType" disabled>
                                                        <option selected value="Standby">Standby</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            @if (Model.EntryStatus == (((int)Timesheet.EntryStatus.Draft).ToString()))
                                            {
                                                <label class="control-label col-md-4">Verifier / Approver *</label>
                                                <div class="col-md-8 form-control-static">
                                                    @Html.Partial("TSPeoplePicker", new Tuple<int?, TimeAttendance.Models.TimesheetAttendanceVM, string, string>(null, @Model, "Approver", ""))
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Start Date *</label>
                                            <div class="col-md-8 form-control-static">
                                                <div class="input-group date date-picker eDate" data-date-format="dd MM yyyy" style="min-width:150px">
                                                    <input type="text" class="form-control Date StartDate" name="StartDate" value='@Model.sDate' onchange="CalculateDateTime()" disabled />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 DivStandbyHide">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">TCS No.</label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.Partial("TCSSearchPicker", new Tuple<int?, string, string>(null, "", Model.TCSNo))
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">End Date *</label>
                                            <div class="col-md-8 form-control-static">
                                                <div class="input-group date date-picker eDate" data-date-format="dd MM yyyy" style="min-width:150px">
                                                    <input type="text" class="form-control Date EndDate" name="EndDate" value='@Model.eDate' onchange="CalculateDateTime()" disabled />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 DivStandbyHide">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Original OT Planning</label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.Partial("OTPlanningCodePicker", new Tuple<int?, string, string>(null, "", Model.OTPlanningCode))
                                                @*<input type="text" class="form-control" name="OTPlanningCode" value='@Model.OTPlanningCode' readonly/>*@
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @{
                                string AccOTHoursColor = "Black";

                                if (Convert.ToDouble(Model.AccumulatedOTHours) > 51)
                                {
                                    AccOTHoursColor = "Orange";
                                }

                                if (Convert.ToDouble(Model.AccumulatedOTHours) > 104)
                                {
                                    AccOTHoursColor = "Red";
                                }
                            }
                            @if (Model.AttendanceType == Timesheet.TimesheetEntryType.Attendance.ToString())
                            {
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Start Time *</label>
                                                <div class="col-md-8 form-control-static">
                                                    <input type="text" class="form-control timeinput StartTime" name="StartTime" placeholder="HH:MM"
                                                           value='@Model.sTime' onchange="CalculateDateTime()" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Booking No.</label>
                                                <div class="col-md-8 form-control-static">
                                                    @Html.Partial("IFMSBookingNoPicker", new Tuple<int?, string, string>(null, "", Model.BookingNo))
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">End Time *</label>
                                                <div class="col-md-8 form-control-static">
                                                    <input type="text" class="form-control timeinput EndTime" name="EndTime" placeholder="HH:MM"
                                                           value='@Model.eTime' onchange="CalculateDateTime()" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 DivStandbyHide">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">No. of Meal</label>
                                                <div class="col-md-8 form-control-static">
                                                    <select class="form-control NoOfMeal" name="NoOfMeal" value="@Model.PremiumNo">
                                                        <option selected value="00">0</option>
                                                        <option value="91">1</option>
                                                        <option value="92">2</option>
                                                        <option value="93">3</option>
                                                        <option value="94">4</option>
                                                        <option value="95">5</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Total Hours</label>
                                                <div class="col-md-8 form-control-static">
                                                    <input type="text" class="form-control TotalHour" style="min-width:50px" name="TotalHours" value="@Model.TotalHours" readonly="readonly" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Accumulated OT Hours</label>
                                                <div class="col-md-8 form-control-static">
                                                    <input type="text" class="form-control AccumulatedOTHours" name="ValidAccumulatedOTHours" value="@Model.AccumulatedOTHours" readonly="readonly" style="color:@AccOTHoursColor" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (Model.AttendanceType == Timesheet.TimesheetEntryType.Availability.ToString())
                            {

                                <div class="row">
                                    <div class="col-md-6 DivStandbyHide">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">No. of Meal</label>
                                                <div class="col-md-8 form-control-static">
                                                    <select class="form-control NoOfMeal" name="NoOfMeal" value="@Model.PremiumNo">
                                                        <option selected value="00">0</option>
                                                        <option value="91">1</option>
                                                        <option value="92">2</option>
                                                        <option value="93">3</option>
                                                        <option value="94">4</option>
                                                        <option value="95">5</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Call Out</label>
                                                <div class="col-md-8 form-control-static">

                                                    @if (IsExecEmp)
                                                    {

                                                        if (Model.CallOut == true)
                                                        {
                                                            <input type="checkbox" class="CallOut" name="CallOut" checked="checked" value="true" />
                                                        }
                                                        else
                                                        {
                                                            <input type="checkbox" class="CallOut" name="CallOut" value="true" />
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" class="CallOut" name="CallOut" value="true" disabled />
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-horizontal">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">Attachment</label>
                                                <div class="col-md-8 form-control-static">

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Description</label>
                                            <div class="col-md-10 form-control-static">
                                                @Html.TextAreaFor(m => m.Description, new { @class = "form-control Description", @name = "Description", rows = "5", @maxlength = "1000" })
                                                @*<textarea class="form-control" style="width:100%;" name="Description" value="@Model.Description"></textarea>*@
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
