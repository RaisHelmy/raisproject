@model Tuple<int?, string, string>
@{
    Layout = null;
    string TCSNoName = "";
    string entries = "";
    string Type = "";
    string DisplayText = "";

    if (Model.Item1 != null)
    {
        if (Model.Item1 >= 0)
        {
            entries = "Entries[" + Model.Item1 + "].";
        }
    }

    Type = (!string.IsNullOrEmpty(Model.Item2)) ? Model.Item2 : "";
    TCSNoName = entries + Type + "TCSNo";
    DisplayText = Type + "TCSNoDisplayText";

    string TCSValue = string.IsNullOrEmpty(Model.Item3) ? "" : Model.Item3;

}

<div>
    <div class="input-group">
        <input type="text" class="form-control TCSNoDisplayText" name="@DisplayText" value="@TCSValue" readonly/>
        <span class="input-group-btn" style="">
            <a data-toggle="modal" href="#SearchTCS" class="btn default TCSNoPicker" onclick="TCSPickerSetDate(this)"><i class="fa fa-list-alt"></i></a>
        </span>
        <input class="TCSNoPickerValue" type="hidden" name="@TCSNoName" value="@TCSValue"/>
    </div>
</div>
