    function FormValidation() {
        var _Employeee = document.getElementById('hfEmployeeID');
        var _DeductionType = document.getElementById('HiddenPayrollDeductionTypeDDL');
        var _StartDate = document.getElementById('ct01_DeductionStartDate');
        var _EndDate = document.getElementById('ct01_DeductionEndDate');
        var _DeductionAmount = document.getElementById('ct01_DeductionAmount');
        var _DeductionReason = document.getElementById('HiddenPayrollDeductionReasonDDL');
        var _PayeeKey = document.getElementById('HiddenPayeeKeyDDL');

        var _Attachment = document.getElementById('ct_Attachment');
        var _Disclaimer = document.getElementById('ct_Disclaimer');
        var _Disclaimer2 = $('#ct_Disclaimer').parent().hasClass('checked');

        var currentValue = parseFloat($("#ct01_DeductionAmount").val().replace(/,/g, ''));
        var currentAvailableValue = parseFloat($("#ct01_AmountToBeDeducted").val().replace(/,/g, ''));

        var HiddenPayrollDeductionTypeDDL = document.getElementById("HiddenPayrollDeductionTypeDDL");
        var _HiddenPayrollDeductionTypeDDLValue = HiddenPayrollDeductionTypeDDL.options[HiddenPayrollDeductionTypeDDL.selectedIndex].value;
        var _MembershipNo = document.getElementById('ct01_MembershipAccountNo');

        var _ValidationMsg = '';

        if (_Employeee.value == '')
            _ValidationMsg += '- Employee field is required.\n';

        if (_DeductionType.value == '0')
        {
            _ValidationMsg += '- Deduction Type field is required.\n';
        }
        else if (_DeductionType.value == 'D020')
        {
            if (_PayeeKey.value == '0')
            {
                _ValidationMsg += '- Payee Key field is required.\n';
            }
        }

        if (_HiddenPayrollDeductionTypeDDLValue == '8600' || _HiddenPayrollDeductionTypeDDLValue == '8620' || _HiddenPayrollDeductionTypeDDLValue == '8571') {
            if (_MembershipNo.value == '')
                _ValidationMsg += '- Membership No/Account No field is required.\n';
        }

        if (_DeductionAmount.value == '')
            _ValidationMsg += '- Deduction Amount field is required.\n';

        if (_DeductionReason.value == '0')
            _ValidationMsg += '- Deduction Reason field is required.\n';

        if (_HiddenPayrollDeductionTypeDDLValue != '9999') {
            if (_StartDate.value == '')
                _ValidationMsg += '- Start Date field is required.\n';
        }

        if (!_Disclaimer.checked && !_Disclaimer2)
            _ValidationMsg += '- Please read and check the Disclaimer section before proceeding to submit.\n';

        //remove checking for available value
        //if (currentValue > currentAvailableValue) {
        //    _ValidationMsg += '- You are not allowed to enter Deduction Amount that is larger than Available Amount to be Deducted.\n';
        //}

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            if (_EndDate.value != '') {
                var _StartParts = _StartDate.value.split('/');
                var _Start = new Date(_StartParts[2], _StartParts[1] - 1, _StartParts[0]);
                var _EndParts = _EndDate.value.split('/');
                var _End = new Date(_EndParts[2], _EndParts[1] - 1, _EndParts[0]);

                if (_Start > _End) {
                    _ValidationMsg += '- Start Date cannot be greater than End Date.';
                }
            }

            if (_ValidationMsg != null && _ValidationMsg != '') {
                alert(_ValidationMsg);
            }
            else {
                document.getElementById('AttachMandatory').value = 'false';
                $("#btnSubmitForm").removeClass("hidden_1");
                $("#btnSubmitDraft").addClass("hidden_1");
                $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application for Approval. If you want to make changes, click Close.');
                $("#ConfirmUpdate").modal('show');
            }
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "Submit":
                window.location.href = '@Url.Action("PayrollHistory", "Payroll")';
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }

    function ApproverAction(btn, _Action) {
        btn.disabled = true;
        $("#divLoading").show();
        var myVar = setTimeout(function () { ConfirmAction(btn, _Action); }, 3000);
    }

    function SaveAsDraft() {
        $("#btnSubmitDraft").removeClass("hidden_1");
        $("#btnSubmitForm").addClass("hidden_1");
        $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will Save the form As Draft . If you want to make changes, click Close.');
        $("#ConfirmUpdate").modal('show');
        document.getElementById('AttachMandatory').value = 'false';
    }

    function ConfirmAction(btn, SubmitType) {
        //$("input[type=button]").attr("disabled", "disabled");
        var _EntryID = '@Model.EntryID';
        var _SubmitterID = document.getElementById('hfEmployeeID').value;
        var _DeductionTypeCode = document.getElementById('HiddenPayrollDeductionTypeDDL').value;
        var e = document.getElementById('HiddenPayrollDeductionTypeDDL');
        var _DeductionName = e.options[e.selectedIndex].text;
        var _DeductionDescription = document.getElementById('ct01_DeductionDescription').value;
        var _lblCurrentDeductedAmount = document.getElementById('ct01_CurrentDeductedAmount').value;
        var _lblAmountToBeDeducted = document.getElementById('ct01_AmountToBeDeducted').value;
        var _txtDeductionAmount = document.getElementById('ct01_DeductionAmount').value;
        var _dpStartDate = document.getElementById('ct01_DeductionStartDate').value;
        var _dpEndDate = document.getElementById('ct01_DeductionEndDate').value;
        var _ReasonCode = document.getElementById('HiddenPayrollDeductionReasonDDL').value;
        var _Comment = document.getElementById('ct01_comment').value;
        var _MembershipNo = document.getElementById('ct01_MembershipAccountNo').value;
        var _ddlPayeeKey = document.getElementById('HiddenPayeeKeyDDL').value;
        var f = document.getElementById('HiddenPayeeKeyDDL');
        var _ddlPayeeName = '';
        if (_ddlPayeeKey != '0')
        {
            _ddlPayeeName = f.options[f.selectedIndex].text;
        }
        var _AttachMandatory = document.getElementById('AttachMandatory').value;


        var ResultMsg = "Your Payroll Deduction Application has been successfully saved.";
        if (SubmitType == "Submit") {
            ResultMsg = "Your Payroll Deduction Application has been successfully submitted.";
        }

        var form = {
            EntryID: _EntryID,
            SubmissionType: SubmitType,
            SubmitterID: _SubmitterID,
            DeductionTypeCode: _DeductionTypeCode,
            DeductionName: _DeductionName,
            DeductionDescription: _DeductionDescription,
            lblCurrentDeductedAmount: _lblCurrentDeductedAmount,
            lblAmountToBeDeducted: _lblAmountToBeDeducted,
            txtDeductionAmount: _txtDeductionAmount,
            dpStartDate: _dpStartDate,
            dpEndDate: _dpEndDate,
            ReasonCode: _ReasonCode,
            Comment: _Comment,
            MembershipNo: _MembershipNo,
            ddlPayeeKey: _ddlPayeeKey,
            ddlPayeeName: _ddlPayeeName,
            AttachMandatory: _AttachMandatory,
        };
        if ($('#divLoading').is(':visible')) {


            $.ajax({
                type: "POST",
                url: '@Url.Content("~/Payroll/SubmitForm")',
                cache: false,
                async: false,
                dataType: "json",
                data: form,
                success: function (result) {
                    if (result.Success) {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        $(".Success-body .well").html(ResultMsg);
                        $("#SuccessSubmit").modal();

                        $("#btnOK").click(function () { RedirectTo('Submit'); });
                    }
                    else {
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").hide();
                        btn.disabled = false;

                        alert(result.ErrorMsg);
                    }
                },
                error: function (e) {

                }
            });
        }
    }
</script>

<script>
//New function based on emergency CR - 06 June 2021
//Update also done to FormValidation for the start date
function toggleTabungPrihatinTNB() {

	//if DDL == Tabung Warga TNB Prihatin
	if ($('#HiddenPayrollDeductionTypeDDL').val() == '9999') {
		//toggle the Amount
		$('#TabungPriharinAmount').show();
		$('#ct01_DeductionAmount').hide();

		//default the deduction amount;
		updateDeductionAmountFromTabungPriharinDeduction();

		//toggle Current Deduction Amount
		$('#ct01_CurrentDeductedAmount').closest('.form-horizontal').hide();

		//toggle Membership No./ Account No.
		$('#ct01_MembershipAccountNo').closest('.form-horizontal').hide();

		//toggle Deduction Start Date
		$('#divDeductionStartDate').closest('.form-horizontal').hide();
		//update Deduction Start Date
		$('#ct01_DeductionStartDate').val('@Model.startDateMin.Value.ToString("dd MMMM yyyy")');

		//toggle Deduction End Date
		$('#ct01_DeductionEndDate').closest('.form-horizontal').hide();

		//toggle Comment
		$('#ct01_comment').closest('.form-horizontal').hide();

		//set to default reason
		$('#HiddenPayrollDeductionReasonDDL').prop('selectedIndex', 1)

		//toggle Reason
		$('#HiddenPayrollDeductionReasonDDL').closest('.form-horizontal').hide();

		//toggle Attachment
		$('#AttachmentControl').hide();

		//note first line
		//$('div#AttachmentControl').siblings('div').eq(3).find('li').eq(0).text('Tabung Warga TNB prihatin akan dibuka sehingga 31.12.2021.');

		//note second line
		//$('div#AttachmentControl').siblings('div').eq(3).find('li').eq(1).text('Permohonan pemotongan gaji yang dibuat pada satu-satu bulan akan diproses pada bulan yang berikutnya. //(Contoh: Bagi permohonan gaji yang dibuat pada bulan Ogos 2021, pemotongan sebenar akan berlaku pada bulan September).');

		//note first line
		$('div#AttachmentControl').siblings('div').eq(3).find('li').eq(0).text('Tabung Warga TNB Prihatin Bantuan Mangsa Banjir telah dibuka.');

		//note second line
		$('div#AttachmentControl').siblings('div').eq(3).find('li').eq(1).text('Permohonan pemotongan gaji yang dibuat pada satu-satu bulan akan diproses pada bulan yang berikutnya. (Contoh: Bagi permohonan gaji yang dibuat pada bulan Disember 2021, pemotongan sebenar akan berlaku pada bulan Januari 2022).');

	} else {

		$('#TabungPriharinAmount').hide();
		$('#ct01_DeductionAmount').show();

		//default the deduction amount;
		$('#ct01_DeductionAmount').val('');

		//toggle Current Deduction Amount
		$('#ct01_CurrentDeductedAmount').closest('.form-horizontal').show();

		//toggle Membership No./ Account No.
		$('#ct01_MembershipAccountNo').closest('.form-horizontal').show();

		//toggle Deduction Start Date
		$('#divDeductionStartDate').closest('.form-horizontal').show();
		//update Deduction Start Date
		$('#ct01_DeductionStartDate').val('');

		//toggle Deduction End Date
		$('#ct01_DeductionEndDate').closest('.form-horizontal').show();

		//toggle Comment
		$('#ct01_comment').closest('.form-horizontal').show();

		//toggle Reason
		$('#HiddenPayrollDeductionReasonDDL').closest('.form-horizontal').show();

		//set to default reason
		$('#HiddenPayrollDeductionReasonDDL').prop('selectedIndex', 0)

		//toggle Attachment
		$('#AttachmentControl').show();

		//note first line
		$('div#AttachmentControl').siblings('div').eq(3).find('li').eq(0).text('Please attach request form only.');

		//note second line
		$('div#AttachmentControl').siblings('div').eq(3).find('li').eq(1).text('This Payroll Deduction Application will be processed depending on monthly payroll run date.');
	}
}

function updateDeductionAmountFromTabungPriharinDeduction() {
	var tabungPriharinAmount = $('#TabungPriharinAmount').val();
	var tabungPriharinOtherAmount = $('#otherDeductionAmount').val();

	if (tabungPriharinAmount != 'OTHERS') {
		$('#otherDeductionAmount').hide();
		$('#otherDeductionAmount').val('');
		$('#ct01_DeductionAmount').val(tabungPriharinAmount);
	} else {
		$('#ct01_DeductionAmount').val('');
		$('#otherDeductionAmount').show();
		if (parseInt(tabungPriharinOtherAmount) > 0) {
			$('#ct01_DeductionAmount').val(tabungPriharinOtherAmount);
		}
	}
}

function addTabungPriharinDeduction() {
	var selectPrihatinDeductionAmountHtml = '<select class="bs-select form-control" id="TabungPriharinAmount" name="TabungPriharinAmount" style="display: none; width: 110px;"><option value="10">RM 10</option><option value="30">RM 30</option><option value="50">RM 50</option><option value="100" selected>RM 100</option><option value="300">RM 300</option><option value="500">RM 500</option><option value="1000">RM 1000</option><option value="2000">RM 2000</option><option value="3000">RM 3000</option><option value="5000">RM 5000</option><option value="OTHERS">Others</option></select>';
	var otherAmountHtml = '<input class="form-control" type="text" maxlength="5" id="otherDeductionAmount" style="margin-left: 5px; display: none; width: 98px;" placeholder="Min RM 1" onkeypress="return isNumberKey(event)" onkeyup="this.value = fnc(this.value, 1, 50000);" onchange="updateDeductionAmountFromTabungPriharinDeduction();">';
	var existingHtml = $('#ct01_DeductionAmount').parent().html();
	$('#ct01_DeductionAmount').parent().html(existingHtml + '<div class="input-group">' + selectPrihatinDeductionAmountHtml + otherAmountHtml + '</div>');
}

function updateForTabungPrihatinTNB() {
	addTabungPriharinDeduction();

	$('#TabungPriharinAmount').change(function() {
  		updateDeductionAmountFromTabungPriharinDeduction();
	});

	$('#HiddenPayrollDeductionTypeDDL').change(function() {
  		toggleTabungPrihatinTNB();
	});
}

function isNumberKey(evt) {
    	var charCode = (evt.which) ? evt.which : event.keyCode
    	if (charCode > 31 && (charCode < 48 || charCode > 57)) {
		return false;
	}
    	return true;
}

function fnc(value, min, max) {
    	if (parseInt(value) < min || isNaN(value)) {
        	return min;
	} else if (parseInt(value) > max) {
        	return max;
	} else {
		return value;
	}
}

</script>



@if (Model.EntryID == null)
{

    <script>
        //New entry
        $(window).load(function () {
            updateForTabungPrihatinTNB();
        });
    </script>

}
else
{

    <script>
        //Existing entry
        $(window).load(function () {
            addTabungPriharinDeduction();

            $('#TabungPriharinAmount').change(function () {
                updateDeductionAmountFromTabungPriharinDeduction();
            });

            toggleTabungPrihatinTNB();

            updateForTabungPrihatinTNB();

            if ($('#HiddenPayrollDeductionTypeDDL').val() == '9999') {
                if ($('#ct01_DeductionAmount').val() != '') {
                    $('#TabungPriharinAmount').val(parseInt($('#ct01_DeductionAmount').val()));
                }
            }
        });
    </script>
}
