    // Helper function
    function convertDate(inputFormat) {
        function pad(s) { return (s < 10) ? '0' + s : s; }
        var monthNames = ["January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
        ];

        var d = new Date(inputFormat);
        return [pad(d.getDate()), monthNames[d.getMonth()], d.getFullYear()].join(' ');
    }

    function parseISO8601(dateStringInRange) {
        var isoExp = /^\s*(\d{4})-(\d\d)-(\d\d)\s*$/,
            date = new Date(NaN), month,
            parts = isoExp.exec(dateStringInRange);

        if (parts) {
            month = +parts[2];
            date.setFullYear(parts[1], month - 1, parts[3]);
            if (month != date.getMonth() + 1) {
                date.setTime(NaN);
            }
        }
        return date;
    }

    // On Change event function
    function DeductionTypeChange() {
        var HiddenPayrollDeductionTypeDDL = document.getElementById("HiddenPayrollDeductionTypeDDL");
        var _HiddenPayrollDeductionTypeDDL = HiddenPayrollDeductionTypeDDL.options[HiddenPayrollDeductionTypeDDL.selectedIndex].innerHTML;
        var _HiddenPayrollDeductionTypeDDLValue = HiddenPayrollDeductionTypeDDL.options[HiddenPayrollDeductionTypeDDL.selectedIndex].value;

        var e = document.getElementById('HiddenPayrollDeductionTypeDDL');
        var _DeductionName = e.options[e.selectedIndex].text;

        if (_HiddenPayrollDeductionTypeDDLValue == 'D020') {

            $(".hidePayeeKey").removeClass("hidden_1");
            document.getElementById('HiddenPayeeKeyDDL').value = '0';
        }
        else {
            $(".hidePayeeKey").addClass("hidden_1");
        }

        if (_HiddenPayrollDeductionTypeDDLValue == '8600' || _HiddenPayrollDeductionTypeDDLValue == '8620' || _HiddenPayrollDeductionTypeDDLValue == '8571') {
            $("#lblMembershipNo").removeClass("hidden_1");
        }
        else {
            $("#lblMembershipNo").addClass("hidden_1");
        }

        jQuery.support.cors = true;

        var ddlTarget = "#HiddenPayrollDeductionReasonDDL";

        var form2 = {
            EmployeeID: document.getElementById('hfEmployeeID').value,
            DeductionCode: _HiddenPayrollDeductionTypeDDLValue,
            DeductionName: _DeductionName
        };

        $.ajax({
            type: "POST",
            url: '@Url.Content("~/Payroll/GetDeductionTypeChange")',
            cache: false,
            async: false,
            dataType: "json",
            data: form2,
            success: function (data) {
                document.getElementById('ct01_CurrentDeductedAmount').value = data.CurrentAmount;
                document.getElementById('ct01_DeductionDescription').value = data.DeductionDescription;
                document.getElementById('ct01_MembershipAccountNo').value = data.MembershipNo;
                $(ddlTarget).empty();
                $.each(data.ListOfDeductionReason, function (index, optionData) {
                    $(ddlTarget).append("<option value='" + optionData.Value + "'>" + optionData.Text + "</option>");
                });
            },
            error: function (x, y, z) {
                console.log("error");
                alert(x + '1_1\n' + y + '1\n' + z);
            }
        });

    }

