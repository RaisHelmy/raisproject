@model ESS.Core.EmployeeDetailsSummary
@{
    Layout = null;
}

<div id="EmployeeDetails" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Employee Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Number
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="ct00_EmployeeCodeRO">@Model.EmployeeCode</label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="ct00_EmployeeNameRO">@Model.EmployeeName</label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Department
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="ct00_DepartmentRO">@Model.Department</label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Unit / Section
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_UnitSectionRO">@Model.UnitSection</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Position
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_PositionRO">@Model.Position</label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Joined Date
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_JoinedDateRO">@Model.JoinedDate.ToString("dd/MM/yyyy")</label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Duty
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_UnitSectionRO">@Model.Job</label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Manager
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_ManagerRO">@Model.ImmediateManager</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="hdEmpInfo">
                        <input type="hidden" name="Submiter.ID" value="@Model.ID" />
                        <input type="hidden" name="Submiter.EmployeeCode" value="@Model.EmployeeCode" />
                        <input type="hidden" name="Submiter.EmployeeName" value="@Model.EmployeeName" />
                        <input type="hidden" name="Submiter.EmailAddress" value="@Model.EmailAddress" />
                        <input type="hidden" name="Submiter.EmployeeSubGroup" value="@Model.EmployeeSubGroup" />
                        <input type="hidden" name="Submiter.EmployeeGroup" value="@Model.EmployeeGroup" />
                        <input type="hidden" name="Submiter.NewIC" value="@Model.NewIC" />

                        <input type="hidden" name="Submiter.PayScaleGroup" value="@Model.PayScaleGroup" />
                        <input type="hidden" name="Submiter.CostCenterCode" value="@Model.CostCenterCode" />
                        <input type="hidden" name="Submiter.CostCenterName" value="@Model.CostCenterName" />
                        <input type="hidden" name="Submiter.CompanyCode" value="@Model.CompanyCode" />
                        <input type="hidden" name="Submiter.CompanyName" value="@Model.Company" />
                        <input type="hidden" name="Submiter.AreaCode" value="@Model.DepartmentCode" />
                        <input type="hidden" name="Submiter.AreaName" value="@Model.Department" />
                        <input type="hidden" name="Submiter.SubAreaCode" value="@Model.UnitSectionCode" />
                        <input type="hidden" name="Submiter.SubAreaName" value="@Model.UnitSection" />
                        <input type="hidden" name="Submiter.PositionCode" value="@Model.PositionCode" />
                        <input type="hidden" name="Submiter.PositionName" value="@Model.Position" />
                        <input type="hidden" name="Submiter.ImmediateManager" value="@Model.ImmediateManager" />
                        <input type="hidden" name="Submiter.ManagerID" value="@Model.ManagerID" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
