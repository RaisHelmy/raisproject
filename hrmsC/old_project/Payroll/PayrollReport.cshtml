@using ESS.Core
@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Payroll Report";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd/MM/yyyy");
    string dtStrEnd = d2.ToString("dd/MM/yyyy");

    string defaultStartDate = DateTime.Today.AddDays(-60).ToString("dd/MM/yyyy");
    string defaultEndDate = DateTime.Today.ToString("dd/MM/yyyy");

    List<DropDownObject> PayrollStatus = ViewBag.PayrollStatus;
    List<DropDownObject> PayrollDeductionType = ViewBag.PayrollDeductionType;
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Payroll Report<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divSubmissionDateFrom" data-date-format="dd/MM/yyyy">
                            <input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divSubmissionDateTo" data-date-format="dd/MM/yyyy">
                            <input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Request Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="ddlRequestType">
                            <option value="">- All -</option>
                            <option value="Payroll">Payroll Deduction Request Form</option>
                            <option value="Tax">Tax Exemption Request</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Deduction Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="DeductionType">
                            <option value="">- All -</option>
                            @*<option value="Pending">Pending</option>
                            <option value="Successful">Successful</option>
                            <option value="Declined">Declined</option>
                            <option value="Withdrawn">Withdrawn</option>*@
                            @foreach (var ddl in PayrollDeductionType)
                            {
                                <option value="@ddl.Value">@ddl.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
        
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Partial("_PeoplePicker")
                        @*PeoplePicker hiddenfieldid = hfEmpID, textboxid =txtEmpName*@
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option value="">- All -</option>
                            @*<option value="Pending">Pending</option>
                            <option value="Successful">Successful</option>
                            <option value="Declined">Declined</option>
                            <option value="Withdrawn">Withdrawn</option>*@
                            @foreach (var ddl in PayrollStatus)
                            {
                                <option value="@ddl.Value">@ddl.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            @*<input type="button" id="btn-Export" class="btn green" value="Export To Excel" />*@
        </div>
    </div>
</div>

<iframe id="txtArea1" style="display:none"></iframe>


<script type="text/javascript">
    function SearchListing() {
        var _DateFrom = $('#SubDateFrom').val();
        var _DateTo = $('#SubDateTo').val();
        var _Type = $('#ddlRequestType').val();
        var _Status = $('#Status').val();
        var _EmpID = $('#hfEmpID').val();
        var _DeductypeCode = $('#DeductionType').val();


        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Payroll/_PayrollReportResult")',
            cache: false,
            dataType: "html",
            data: { DateFrom: _DateFrom, DateTo: _DateTo, Status: _Status, Type: _Type, SearchEmpID: _EmpID, DeductionTypeCode: _DeductypeCode},
            success: function (content) {
                $("#SearchResult").html(content);
                ExportToExcel();
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function ConvertDate(_date) {
        var mnth = ("0" + (_date.getMonth() + 1)).slice(-2),
            day = ("0" + _date.getDate()).slice(-2);

        return [mnth, day, _date.getFullYear()].join("/");
    }

    function convertDate2(inputFormat) {
        function pad(s) { return (s < 10) ? '0' + s : s; }
        var monthNames = ["January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
        ];

        var d = new Date(inputFormat);
        return [pad(d.getDate()), monthNames[d.getMonth()], d.getFullYear()].join(' ');
    }


    jQuery(document).ready(function () {
        var _Today = new Date();
        _Today.setDate(_Today.getDate() - 60);
        var _Start = ConvertDate(_Today);

        $('#SubDateFrom').val(convertDate2(_Start));
        $('#SubDateTo').val(convertDate2(new Date()));

        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        $('#divSubmissionDateFrom').datepicker('setStartDate', '@dtStrStart');
        $('#divSubmissionDateFrom').datepicker('setEndDate', '@dtStrEnd');

        $('#divSubmissionDateTo').datepicker('setStartDate', '@dtStrStart');
        $('#divSubmissionDateTo').datepicker('setEndDate', '@dtStrEnd');

        $('#divSubmissionDateFrom').datepicker('setDate', '@defaultStartDate');
        $('#divSubmissionDateTo').datepicker('setDate', '@defaultEndDate');


        $("#divSubmissionDateFrom").datepicker().on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());

            minDate.setDate(minDate.getDate() + 1);
            $('#divSubmissionDateTo').datepicker('setStartDate', minDate);
        });

        $("#divSubmissionDateTo").datepicker().on('changeDate', function (selected) {
                var minDate = new Date(selected.date.valueOf());
                minDate.setDate(minDate.getDate() - 1);
                $('#divSubmissionDateFrom').datepicker('setEndDate', minDate);
            });

        $("#SubDateFrom").on("blur", function (e) {
            if($('#SubDateFrom').val() =="")
            {
                $('#divSubmissionDateTo').datepicker('setStartDate', '@dtStrStart');
            }

        });

        $("#SubDateTo").on("blur", function (e) {
            if ($('#SubDateTo').val() == "") {
                $('#divSubmissionDateFrom').datepicker('setEndDate', '@dtStrEnd');
            }

        });
        //SearchListing();
    });

    function ExportToExcel()
    {
        // EXPORT TO EXCEL
        var ua = window.navigator.userAgent;
        var msie = ua.indexOf("MSIE ");

        // Internet Explorer
        if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {
            var _btn = document.getElementById('btn-Export');
            _btn.onclick = fnExcelReport;
        }
        else {
            $("#btn-Export").click(function (e) {
                //getting values of current time for generating the file name
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                //creating a temporary HTML link element (they support setting file names)
                var a = document.createElement('a');
                //getting data from our div that contains the HTML table
                var data_type = 'data:application/vnd.ms-excel';
                var table_div = document.getElementById('tblResult');
                var table_html = table_div.outerHTML.replace(/ /g, '%20');
                a.href = data_type + ', ' + table_html;
                //setting the file name
                a.download = 'Payroll_Report_' + postfix + '.xls';
                //triggering the function
                a.click();
                //just in case, prevent default behaviour
                e.preventDefault();
            });
        }
    }

    function ClearFilter() {
        $('#SubDateFrom').val('');
        $('#SubDateTo').val('');
        $('#Status').val('');
        $('#txtEmpName').val('');
        $('#hfEmpID').val('');
        SearchListing();
    }

    function fnExcelReport() {
        var dt = new Date();
        var day = dt.getDate();
        var month = dt.getMonth() + 1;
        var year = dt.getFullYear();
        var hour = dt.getHours();
        var mins = dt.getMinutes();
        var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
        var _fileName = 'Payroll_Report_' + postfix + '.xls';

        var tab_text = "<table border='2px'><tr bgcolor='#87AFC6'>";
        var textRange; var j = 0;
        tab = document.getElementById('tblResult'); // id of table

        for (j = 0 ; j < tab.rows.length ; j++) {
            tab_text = tab_text + tab.rows[j].innerHTML + "</tr>";
            //tab_text=tab_text+"</tr>";
        }

        tab_text = tab_text + "</table>";


        //var ua = window.navigator.userAgent;
        //var msie = ua.indexOf("MSIE ");

        //if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./))      // If Internet Explorer
        //{
        txtArea1.document.open("txt/html", "replace");
        txtArea1.document.write(tab_text);
        txtArea1.document.close();
        txtArea1.focus();
        sa = txtArea1.document.execCommand("SaveAs", true, _fileName);
        //}
        //else //other browser not tested on IE 11
        //    sa = window.open('data:application/vnd.ms-excel,filename=aaa.xlsx' + encodeURIComponent(tab_text));
        return (sa);
    }
</script>

