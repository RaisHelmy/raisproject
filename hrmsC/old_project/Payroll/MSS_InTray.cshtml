@model List<ESS.Core.DropDownObject>
@using ESS.Core
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "MSS - Payroll";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");

    List<DropDownObject> PayrollStatus = ViewBag.PayrollStatus;
    List<DropDownObject> PayrollDeductionType = ViewBag.PayrollDeductionType;
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            MSS - Payroll<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divSubmissionDateFrom" data-date-format="dd/MM/yyyy">
                            <input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divSubmissionDateTo" data-date-format="dd/MM/yyyy">
                            <input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Request Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="ddlRequestType">
                            <option value="">- All -</option>
                            <option value="Payroll Deduction Request">Payroll Deduction Request</option>
                            <option value="Tax Exemption Request">Tax Exemption Request</option>
                        </select>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Deduction Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="DeductionType">
                            <option value="">- All -</option>
                            @*<option value="Pending">Pending</option>
                                <option value="Successful">Successful</option>
                                <option value="Declined">Declined</option>
                                <option value="Withdrawn">Withdrawn</option>*@
                            @foreach (var ddl in PayrollDeductionType)
                            {
                                <option value="@ddl.Value">@ddl.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Partial("_PeoplePicker")
                        @*PeoplePicker hiddenfieldid = hfEmpID, textboxid =txtEmpName*@
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option value="">- All -</option>
                            <option value="Pending">Pending</option>
                            <option value="Verified">Verified</option>
                            <option value="Successful">Successful</option>
                            <option value="Declined">Declined</option>
                            <option value="Withdrawn">Withdrawn</option>
                            <option value="Approved">Approved</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>

    <div id="btnBarApproval" class="row">
        <div class="col-md-12">
            <input type="button" class="btn green" value="Verify" id="btnVerify" onclick="BatchApprove('Verified')" />
            <input type="button" class="btn red" value="Decline" id="btnDecline" onclick="BatchApprove('Declined')" />

        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        $("#divSubmissionDateFrom").datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());

            minDate.setDate(minDate.getDate() + 1);
            $('#divSubmissionDateTo').datepicker('setStartDate', minDate);
        });

        $("#divSubmissionDateTo").datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        }).on('changeDate', function (selected) {
                var minDate = new Date(selected.date.valueOf());
                minDate.setDate(minDate.getDate() - 1);
                $('#divSubmissionDateFrom').datepicker('setEndDate', minDate);
            });

        $("#SubDateFrom").on("blur", function (e) {
            if ($('#SubDateFrom').val() == "") {
                $('#divSubmissionDateTo').datepicker('setStartDate', '@dtStrStart');
            }
        });

        $("#SubDateTo").on("blur", function (e) {
            if ($('#SubDateTo').val() == "") {
                $('#divSubmissionDateFrom').datepicker('setEndDate', '@dtStrEnd');
            }
        });

        SearchListing();
    });

    function SearchListing() {
        var _DateFrom = $('#SubDateFrom').val();
        var _DateTo = $('#SubDateTo').val();
        var _EmpID = $('#hfEmpID').val();
        var _Type = $('#ddlRequestType').val();
        var _Status = $('#Status').val();
        var _DeductypeCode = $('#DeductionType').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Payroll/_InTrayResult")',
            cache: false,
            dataType: "html",
            data: {
                DateFrom: _DateFrom,
                DateTo: _DateTo,
                Status: _Status,
                Type: _Type,
                SearchEmpID: _EmpID,
                DeductionTypeCode: _DeductypeCode
            },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function ClearFilter() {
        $('#SubDateFrom').val('');
        $('#SubDateTo').val('');
        $('#hfEmpID').val('');
        $('#txtEmpName').val('');
        $('#TransferType').val('');
        $('#Status').val('');
        SearchListing();
    }

    function BatchApprove(action) {
        var _ApproverInfo = {};
        var _ApproverAction = "";
        var _ApproverComment = "";
        var _DeclineReason = "";
        var _RedirectUrl = "";
        var tasks = GetSelectedTasks();

        if (tasks == "") {
            alert("No tasks is selected.");
            return;
        }

        switch (action) {
            case "Verified":
                _ApproverAction = "Verified";
                break;

            case "Declined":
                _ApproverAction = "Declined";
                break;

        }

        var promptMessage = "Are you sure you want to " + action + " these Payroll Applications?\n\r" +
                            "Press Confirm to proceed";
        var notifyMessage = "";

        notifyMessage = "These Payroll Applications was " + _ApproverAction + " successfully.";
        

        _ApproverInfo = {
            EntryID: GetSelectedTasks(),
            TaskID: '',
            CurrentUserID: '',
            Status: _ApproverAction,
            ApproverComment: _ApproverComment + "\n " + _DeclineReason,
            ApprovalLevel: ''
        };

        ShowConfirmationDialog({
            message: promptMessage,
            positiveCallback: function () {
                HideConfirmationDialog();
                ShowLoadingScreen();

                $.post('@Url.Action("MultiPostApproverAction", "Payroll")',
                    {
                        info: _ApproverInfo,
                        ApproverAction: _ApproverAction,
                        Target: ""
                    },
                    function (result) {
                        HideLoadingScreen();

                        if (result.Success) {
                            if (result.ErrorMsg != "") {
                                alert(result.ErrorMsg);
                                SearchListing();
                            }
                            else {
                                ShowDialog({
                                message: notifyMessage,
                                okCallback: function () {
                                    SearchListing();
                                }
                            });
                            }
                        }
                        else {
                            ShowDialog({
                                title: "Action not completed.",
                                message: "Error Message : " + result.ErrorMsg,
                                okCallback: function () {
                                    HideDialog();
                                }
                            });
                        }
                    });
            }
        });
    }

    function GetSelectedTasks() {
        var tasks = "";

        var tableRows = document.getElementById('tblResult').getElementsByTagName('tbody')[0].getElementsByTagName('tr');
        var tasks = '';

        for (var i = 0; i < tableRows.length; i++) {
            var row = tableRows[i];

            // Assuming BatchApprovalCheckbox, PayrollID, TaskID, and RefID are classes of your elements
            var checkbox = row.querySelector('.BatchApprovalCheckbox');

            if (checkbox && checkbox.checked) {
                var payrollID = row.querySelector('.PayrollID').value;
                var taskID = row.querySelector('.TaskID').value;
                var refID = row.querySelector('.RefID').value;

                tasks += payrollID + "," + taskID + "," + refID + ":";
            }
        }

        return tasks.slice(0, tasks.length - 1);
    }

</script>

<!-- Confirmation Message -->
<div class="modal fade" id="ConfirmationDialog" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 id="ConfirmationDialog_Title" class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div id="ConfirmationDialog_Message" class="well">
                </div>
            </div>
            <div class="modal-footer">
                <button id="ConfirmationDialog_PositiveButton" type="button" class="btn default blue">
                    <i class="fa fa-check"></i>
                </button>
                <button id="ConfirmationDialog_NegativeButton" type="button" class="btn default" data-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Success Message -->
<div class="modal fade" id="SuccessDialog" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                <h4 id="SuccessDialog_Title" class="Success-title">
                    Action Successfully Completed
                </h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well" id="SuccessDialog_Message">
                    Claims has been successfully submitted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <a class="btn default blue" id="SuccessDialog_OkButton" data-dismiss="modal">
                    <i class="fa fa-check"></i>
                    OK
                </a>
            </div>
        </div>
    </div>
</div>

<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed;
    right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
    </p>
</div>

<script>
    // Dialog with Confirm/Close
    function ShowConfirmationDialog(data) {
        if (!data) {
            data = {};
        }

        var dialog = $('#ConfirmationDialog'),
            title = data.title || "Confirmation",
            message = data.message || "Are you sure you want to submit this Payroll Application?\n\r Press Confirm to proceed, or Close to stay on the current page.",
            positiveButtonText = data.positiveButtonText || "Confirm",
            positiveCallback = data.positiveCallback,
            negativeButtonText = data.negativeButtonText || "Close",
            negativeCallback = data.negativeCallback;

        dialog.find("#ConfirmationDialog_Title").html(title);
        dialog.find("#ConfirmationDialog_Message").html(message);
        var ePositiveButton = dialog.find("#ConfirmationDialog_PositiveButton");
        var eNegativeButton = dialog.find("#ConfirmationDialog_NegativeButton");

        ePositiveButton.html(positiveButtonText);
        ePositiveButton.off('click');
        ePositiveButton.one('click', function () {
            if (positiveCallback)
                positiveCallback(dialog);
        });

        eNegativeButton.html(negativeButtonText);
        eNegativeButton.off('click');
        eNegativeButton.one('click', function () {
            if (negativeCallback)
                negativeCallback(dialog);
        });

        dialog.modal();
    }

    function HideConfirmationDialog() {
        var dialog = $('#ConfirmationDialog');
        dialog.modal("hide");
    }

    // Dialog with OK
    function ShowDialog(data) {
        if (!data) {
            data = {};
        }

        var dialog = $('#SuccessDialog'),
            title = data.title,
            message = data.message || "The operation was success.",
            okCallback = data.okCallback;

        var okButton = dialog.find("#SuccessDialog_OkButton");

        dialog.find("#SuccessDialog_Title").html(title);
        dialog.find("#SuccessDialog_Message").html(message);

        okButton.off('click');
        okButton.one('click', function () {
            if (okCallback)
                okCallback();
        });

        dialog.modal();
    }

    function HideDialog() {
        var dialog = $('#SuccessDialog');
        dialog.modal("hide");
    }

    function ShowLoadingScreen() {
        $("#divLoading").show();
    }

    function HideLoadingScreen() {
        $('#divLoading').hide();
    }
</script>