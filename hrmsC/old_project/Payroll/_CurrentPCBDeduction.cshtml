@using ESS.Payroll.Models
@model PCBCalculatorReport
@{
    Layout = null;
}
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Current PCB Deduction
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-6">
                                        Current PCB Deduction (RM)
                                    </label>
                                    <div class="col-md-6 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.PCBDeduction" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>