@model List<SEP.RoutingManagement.Models.GetMyIntray>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee Number</th>
                                <th>Employee Name</th>
                                <th>Submission Date</th>
                                <th>Status</th>
                                <th>PayscaleGroup</th>
                                <th>Deduction Type</th>
                                <th>Phone Number</th>
                                <th>Deduction Amount (RM)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                            <tr>
                                <th>
                                    <input type="checkbox" class="form-control BatchApprovalCheckbox" />
                                    <input type="hidden" class="PayrollID" value="@item.SourceID" />
                                    <input type="hidden" class="TaskID" value="@item.ID" />
                                    <input type="hidden" class="RefID" value="@item.ApplicationRefNo" />
                                </th>
                                <td>
                                    @if (item.DisplayText1 == "Payroll Deduction Request")
                                    {
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Payroll/PayrollViewForm")?RequestID=@item.SourceID&TaskID=@item.ID&Source=InTray">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Payroll/TaxExemptionViewForm")?EntryID=@item.SourceID&TaskID=@item.ID&Source=InTray">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    }
                                </td>
                                <td>@item.ApplicationRefNo</td>
                                <td>@item.ApplicantCode</td>
                                <td>@item.ApplicantName</td>
                                @if (!String.IsNullOrEmpty(item.DisplayText2))
                                {
                                    <td>@Convert.ToDateTime(item.DisplayText2).ToString("dd-MM-yyyy")</td>
                                }
                                else
                                {
                                    <td>-</td>
                                }

                                <td style="color:green;"><b>@item.DisplayText3</b></td>
                                <td>@item.PayScaleGroup</td>
                                <td>@item.DisplayText5</td>
                                <td>@item.PhoneNumber</td>
                                <td>@item.DisplayText10</td>

                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>
