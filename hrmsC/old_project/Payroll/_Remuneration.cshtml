@using ESS.Payroll.Models
@model PCBCalculatorReport
@{
    Layout = null;
}
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Current Remuneration
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Remuneration
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.Remuneration" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        EPF and Other Approved Funds [not exceeding RM6000 per year]
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.EPF_OtherApprovedFunds" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Benefit In Kind (BIK)
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.BIK" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Value Of Living Accomodation (VOLA)
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.VOLA" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Additional Remuneration
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Bonus
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.Bonus" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8 ">
                                        Arrears
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.Arrears" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Commission (not paid monthly)
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.Commissions" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Gratuity
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.Gratuity" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Compensation
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.Compensation" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Director's fee (not paid monthly)
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.DirectorFee" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Income tax paid by employers on behalf of employees
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.IncomeTaxPaidByEmployer" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-8">
                                        Others
                                    </label>
                                    <div class="col-md-4 form-control-static">
                                        <input type="text" class="form-control" readonly="readonly"
                                               value="@Model.Others" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
</script>