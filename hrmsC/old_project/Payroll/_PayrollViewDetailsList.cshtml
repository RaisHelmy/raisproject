@model Tuple<ESS.Payroll.Models.PayrollDeductionVM, SEP.RoutingManagement.Models.RoutingRule>
@{
    Layout = null;
    string TaskID = (string)ViewData["TaskID"];
    string RequestID = (string)ViewData["RequestID"];
    string ApprovalLevel = (string)ViewData["ApprovalLevel"];
    string Source = (string)ViewData["Source"];
    int applvl = String.IsNullOrEmpty(ApprovalLevel) ? 0 : Convert.ToInt32(ApprovalLevel);
    string PaySlipUrl = (string)ViewData["PaySlipUrl"];
}
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Payroll  Deduction Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct01_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Deduction Type</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" id="txtDeductionType" name="DeductionType" class="form-control" value="@Model.Item1.DeductionName" readonly="readonly" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="col-md-8 form-control-static">
                                        @*<a href="@PaySlipUrl" target="_blank"> <u>View Payslip</u></a>*@
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Deduction Description</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="txtDeductionDescription" readonly value="@Model.Item1.DeductionDescription" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 hidePayeeKey">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Payee Key</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" id="txtPayeeKey" name="PayeeKey" class="form-control" value="@Model.Item1.PayeeName" readonly="readonly" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group hidden_1">
                                    <label class="control-label col-md-4">Available Amount to be Deducted</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="txtAmountToBeDeducted" readonly value="@Model.Item1.AvailableAmountToBeDeducted" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">Current Deducted Amount</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="txtCurrentDeductedAmount" readonly value="@Model.Item1.CurrentDeductedAmount" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Membership No./ Account No.</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="txtMembershipNo" readonly value="@Model.Item1.MembershipNo" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                @*<div class="form-group">
            <label class="control-label col-md-4">Current Deducted Amount</label>
            <div class="col-md-8 form-control-static">
                <input class="form-control" type="text" id="txtCurrentDeductedAmount" readonly value="@Model.Item1.CurrentDeductedAmount" />
            </div>
        </div>*@
                                <div class="form-group">
                                    <label class="control-label col-md-4">Deduction Amount<span class="mandatory"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="txtDeductionAmount" readonly value="@Model.Item1.DeductionAmount" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Deduction Start Date</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="txtDeductionStartDate" name="DeductionStartDate" readonly value="@Model.Item1.StartDate.Value.ToString("dd MMMM yyyy")" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                @*<div class="form-group">
            <label class="control-label col-md-4">Deduction Amount<span class="mandatory"> *</span></label>
            <div class="col-md-8 form-control-static">
                <input class="form-control" type="text" id="txtDeductionAmount" readonly value="@Model.Item1.DeductionAmount" />
            </div>
        </div>*@
                                <div class="form-group">
                                    <label class="control-label col-md-4">Reason</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="txtReason" name="Reason" readonly value="@Model.Item1.Reason" />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Deduction End Date</label>
                                    <div class="col-md-8 form-control-static">
                                        
                                        <input class="form-control" type="text" id="txtDeductionEndDate" name="DeductionEndDate" readonly value="@Model.Item1.EndDate.Value.ToString("dd MMMM yyyy")" />
                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*<div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Reason</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="txtReason" name="Reason" readonly value="@Model.Item1.Reason" />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">

                                </div>
                            </div>
                        </div>
                    </div>*@
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-2">Comment</label>
                                    <div class="col-md-10 form-control-static">
                                        <textarea name="ct01_comment" id="ct01_comment" class="form-control" form="usrform" rows="5" readonly>@Model.Item1.Comment</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>