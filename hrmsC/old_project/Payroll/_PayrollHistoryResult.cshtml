@model List<ESS.Payroll.Models.PayrollHistory>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My Payroll Deduction History
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Deduction Type</th>
                                <th>Status</th>
                                <th>Submission Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        @if (item.RequestType == "Payroll Deduction Request")
                                        {
                                            if (item.StatusCode == "DR" || item.StatusCode == "DE")
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/Payroll/PayrollDeductionForm")?EntryID=@item.EntryID">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/Payroll/PayrollViewForm")?RequestID=@item.EntryID&Source=History">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            if (item.StatusCode == "DR" || item.StatusCode == "DE")
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/Payroll/TaxExemptionForm")?EntryID=@item.EntryID">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/Payroll/TaxExemptionViewForm")?EntryID=@item.EntryID&Source=History">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                        }
                                    </td>
                                    <td>@item.ReferenceNo</td>
                                    <td>@item.RequestType</td>

                                    @if (item.StatusName == "Declined" || item.StatusName == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.StatusName</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.StatusName</b></td>
                                    }
                                    @if (item.CreatedDate.HasValue)
                                    {
                                        <td>@item.CreatedDate.Value.ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>
