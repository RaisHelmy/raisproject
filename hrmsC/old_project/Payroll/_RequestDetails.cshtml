@model ESS.Payroll.Models.TaxExemptionVM
@{
    Layout = null;
    String CurrentApprover = ViewBag.CurrentApproverName;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Request Details
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Reference No</label>
                            <div class="col-md-8 form-control-static">
                                <input type="text" class="form-control RequestNo" name="RequestNo"
                                       readonly="readonly" value="@Model.ReferenceNo" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Status</label>
                            <div class="col-md-8 form-control-static">
                                <input type="hidden" name="StatusCode" value="@Model.StatusCode" />
                                <input type="text" class="form-control Status" name="StatusName"
                                       readonly="readonly" value="@Model.StatusName" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!String.IsNullOrEmpty(CurrentApprover))
            {
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Request Type</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control RequestType" name="RequestType"
                                           readonly="readonly" value="Tax Exemption" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Agreer / Approver</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control" name="ApproverName"
                                           readonly="readonly" value="@CurrentApprover" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>