<script>
    function DeleteTrainingRequest() {
        $('#btnSubmitSave').css("display", "initial");
        $('#btnSubmitDraft').css("display", "none");
        $("#btnSubmitSave").attr("onclick", "SaveForm('Deleted')");
        $('.modal-body .well').html('Are you sure you want to Delete this Training Request Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
