@model ESS.Core.CoursePickerList
@{
    ViewBag.Title = "Summary Details";
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Training Summary Details
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Training Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    @*@Html.Partial("_CoursePicker", new ViewDataDictionary { { "CategoryCode", ViewBag.CategoryCode }, { "CategoryDesc", ViewBag.CategoryDesc }, { "Mode", Model.Status }, { "Type", TrainingType }, { "paramCategoryTypeCode", paramCategoryTypeCode } })*@

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Start Date <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="StartDate" value="@Model.StrStartDate" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">End Date <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="EndDate" value="@Model.StrEndDate" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-2 ">
                                        Course Venue <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span>
                                    </label>
                                    <div class="col-md-10 form-control-static">
                                        <input class="form-control" id="CourseVenue" value="@Model.Venue" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-2 ">
                                        Course Provider <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span>
                                    </label>
                                    <div class="col-md-10 form-control-static">
                                        <input class="form-control" id="CourseProvider" value="@Model.Provider" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Division
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" id="Division" value="@Model.Division" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Grade
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" id="Grade" value="@Model.Grade" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Course Application Status
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Pending Request
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" id="PendingRequest" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Maximum Capacity
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" id="MaxCapacity" value="@Model.MaxCapacity" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Approved Request
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" id="ApprovedRequest" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Estimated Cost
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Cost
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Html.DropDownList("TrainingCostList", new SelectList(ViewBag.TrainingCostList, "Value", "Text"), "", new { @class = "form-control", @id = "TrainingCost", @disabled = "disabled" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Training Fee
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @{
                                            string Fee = (string.IsNullOrEmpty(Model.TrainingFee)) ? "" : (decimal.Parse(Model.TrainingFee)).ToString("###,###,##0.00");
                                        }
                                        <input class="form-control" id="DisplayTrainingFee" value="@Model.CurrencyCode @Fee @ViewBag.CostItemDesc" readonly />
                                        <input class="form-control hide" id="TrainingFee" value="@Model.TrainingFee" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
       
        //var startDate = new Date($("#StartDate").val());
        //var endDate = new Date($("#EndDate").val());
        //$("#StartDate").val($.datepicker.formatDate('dd/mm/yy', startDate));
        //$("#EndDate").val($.datepicker.formatDate('dd/mm/yy', endDate));


        if ('@Model.CourseID' != "") {
            GetCourseCapacity('@Model.CourseID', '@Model.CourseSessionID');
        } else {
            $("#DivisionGrade").addClass("hide");
        }

        var TC = '@Model.Cost' + "";
        if (TC != "") {
            $("#TrainingCost").val(TC);
        }
    });

    function GetCourseCapacity(CourseID, CourseSessionID) {
        $.ajax({
            url: '@Url.Content("~/Training/GetCourseCapacity")',
            type: 'POST',
            cache: false,
            dataType: "json",
            data: { 'CourseID': CourseID, 'CourseSessionID': CourseSessionID },
            success: function (result) {
                //console.log(result);
                if (result.Success) {
                    $("#PendingRequest").val(result.PendingRequests);
                    $("#ApprovedRequest").val(result.ApprovedRequests);
                } else {
                    alert(result.ErrorMsg);
                }
            },
            error: function (x, y, z) {
                console.log(x + '\n' + y + '\n' + z);
            }
        });
    }


</script>