@model Tuple<ESS.Core.TrainingForm, List<SEP.RoutingManagement.Service.AllowAction>>
@{
    ViewBag.Title = "Training Course Application";
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Training Request Application - Replace
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>


@using (Html.BeginForm("", "Training", FormMethod.Post, new { @class = "form-horizontal", @id = "MainForm" }))
{
    <input id="hfTrainingID" type="hidden" value="@Model.Item1.TrainingID" />
    <input id="hfEmpID" type="hidden" value="@ViewBag.EmployeeID" />
    <input id="hfTaskID" type="hidden" value="@ViewBag.TaskID" />

    //Training Details
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Training Course Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct00_CustomFieldFormView">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4 ">
                                            Request Reference No.
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" id="CourseName" value="@Model.Item1.ReferenceNo" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4 ">
                                            Course Status
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            @{ 
                                                var color = "";
                                                if(Model.Item1.Status == "Declined"){
                                                    color = "red";
                                                }
                                                else
                                                {
                                                    color = "green";
                                                }
                                            }
                                            <input class="form-control" id="CourseName" value="@Model.Item1.Status" style="color:@color;font-weight:bold;" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2 ">
                                            Course Title
                                        </label>
                                        <div class="col-md-10 form-control-static">
                                            <input class="form-control" id="CourseName" value="@Model.Item1.CourseTitle" readonly/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Course ID</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="CourseID" value="@Model.Item1.CourseID" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Course Session ID</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="CourseSessionID" value="@Model.Item1.CourseSessionID" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Start Date</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="StartDate" value="@Model.Item1.StartDate" readonly/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">End Date</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="EndDate" value="@Model.Item1.EndDate" readonly/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2 ">
                                            Course Venue
                                        </label>
                                        <div class="col-md-10 form-control-static">
                                            <input class="form-control" id="CourseVenue" value="@Model.Item1.CourseVenue" readonly/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2 ">
                                            Course Provider
                                        </label>
                                        <div class="col-md-10 form-control-static">
                                            <input class="form-control" id="CourseProvider" value="@Model.Item1.CourseProvider" readonly/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4 ">
                                            Currency
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" id="CourseCurrency" value="@Model.Item1.CurrencyCode" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4 ">
                                            Course Fee
                                        </label>
                                        <div class="col-md-8 form-control-static">

                                            @{
                                                string Fee = (string.IsNullOrEmpty(Model.Item1.TrainingFee)) ? "" : (decimal.Parse(Model.Item1.TrainingFee)).ToString("###,###,##0.00") + ViewBag.CostItemDesc;

                                            }

                                            <input class="form-control" id="CourseFee" value="@Model.Item1.CurrencyCode @Fee" readonly />

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    //Requestor List
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Attendee Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct00_CustomFieldFormView">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4 ">
                                            Original Attendee
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" id="OriAttendee" value="@ViewBag.Employee" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4 ">
                                            Replace to
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            @if (ViewBag.Mode == "View" || Model.Item1.Status == "Pending")
                                            {
                                                <input class="form-control" id="ReplaceByEmployee" value="@ViewBag.ReplaceByEmployee" readonly />
                                            }
                                            else
                                            {
                                                @Html.Partial("_PeoplePicker", new ViewDataDictionary { { "SearchType", "Subordinates" } })
                                            }
                                           
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2 ">
                                            Remarks
                                        </label>
                                        <div class="col-md-10 form-control-static">
                                            @if (ViewBag.Mode == "View" || Model.Item1.Status == "Pending")
                                            {
                                                <textarea class="form-control" id="Comment" readonly>@Model.Item1.ReplacementRemarks</textarea>
                                                
                                            }
                                            else
                                            {
                                                <textarea class="form-control" id="Comment"></textarea>
                                            }
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    //Attachment
    @*if (Model.Item1.Status == "Draft")
    {
        @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "New", SourceType = "Training Replacement" })
    }
    else
    {
        @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "View", SourceType = "Training Replacement", RequestID = Model.Item1.TrainingID })

    }*@

    //Workflow History
    if (Model.Item1.Status == "Pending" || Model.Item1.Status == "Agreed" || Model.Item1.Status == "Approved" || Model.Item1.Status == "Declined" || Model.Item1.Status == "Withdrawn" || Model.Item1.Status == "Recommended" || Model.Item1.Status == "Endorsed")
    {
        @Html.Action("_TrainingRequestWorkflowHistory", "Training", new { ID = Model.Item1.TrainingID })
    }


    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmUpdate" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Replace this Attendee?\n\rPress Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmitSave" value="Submit" onclick="javascript: SaveForm('Pending');">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well">
                        Your Application has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <button type="button" class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
        </p>
    </div>




    if (string.IsNullOrEmpty(Model.Item1.Status) || Model.Item1.Status == "Draft")
    {
        <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="SubmitApproval()" />
    }
    else
    {
        if (!string.IsNullOrEmpty(ViewBag.TaskID))
        {
            foreach (var m in Model.Item2)
            {
                if (m.CanWithdraw == "1")
                {
                    <input type="button" class="btn green" value="Withdraw" id="btnWithdraw" onclick="Validation('Withdrawn')" />
                }

                if (m.CanApprove == "1")
                {
                    <input type="button" class="btn green" value="Approve" id="btnApprove" onclick="Validation('Approved')" />
                }

                if (m.CanDecline == "1")
                {
                    <input type="button" class="btn green" value="Decline" id="btnReject" onclick="Validation('Declined')" />
                }

            }
        }

    }


    <input type="button" class="btn green" value="Back" id="btnClose" onclick="window.history.back()"/>

}
<script>

    var SubmitStatus = "";

    transformTable("#AttendeeTable");


    function SubmitApproval(_Status) {
        $('.modal-body .well').html('Are you sure you want to Replace this Attendee?\n\rPress Confirm to proceed, or Close to stay on the current page.');
        $('#ConfirmUpdate').modal('show');
        $('#btnOK').click(function () { RedirectTo(); }); 
    }

    function SaveForm(_Status) {
        $("#ConfirmUpdate").modal('toggle');
        $("#divLoading").css("display", "block");
        SubmitStatus = _Status;
        var myVar = setTimeout(SubmitFormAction, 1000);
    }

    function SubmitFormAction() {
    
        if (SubmitStatus == 'Draft') {
            $(".Success-body .well").html('Your Training Request Application has been successfully saved.');
        }
        else if (SubmitStatus == 'Approved') {
            $(".Success-body .well").html('Your Training Request Application has been successfully approved.');
        }
        else if (SubmitStatus == 'Declined') {
            $(".Success-body .well").html('Your Training Request Application has been successfully Declined.');
        }
        else if (SubmitStatus == 'Agreed') {
            $(".Success-body .well").html('Your Training Request Application has been successfully submitted.');
        }
        else if (SubmitStatus == 'Withdrawn') {
            $(".Success-body .well").html('Your Training Request Application has been successfully withdrawn.');
        }
        else if (SubmitStatus == 'Recommended') {
            $(".Success-body .well").html('Your Training Request Application has been successfully recommended.');
        }
        else if (SubmitStatus == 'Endorsed') {
            $(".Success-body .well").html('Your Training Request Application has been successfully endorsed.');
        }
        else if (SubmitStatus == 'Deleted') {
            $(".Success-body .well").html('Your Training Request Application has been successfully deleted.');
        }
        else {
            $(".Success-body .well").html('Your Training Request Application has been successfully submitted.');
        }

        var _TrainingID = $("#hfTrainingID").val();
        var _Comments = $("#Comment").val();
        var _EmpID = $("#hfEmpID").val();

        if (SubmitStatus == 'Draft' || SubmitStatus == 'Pending') {
            $.ajax({
                url: '@Url.Content("~/Training/PerformReplaceAttendee")',
                type: 'POST',
                cache: false,
                async: false,
                dataType: "json",
                data: { 'TrainingID': _TrainingID, 'ReplaceTo': _EmpID, 'Comments': _Comments },
                success: function (result) {
                    if (result.Success) {
                        $("#divLoading").css("display", "none");
                        $("#SuccessSubmit").modal();
                    } else {
                        $("#divLoading").css("display", "none");
                        alert(result.ErrorMsg);
                    }

                },
                error: function (x, y, z) {
                    $("#divLoading").css("display", "none");
                    console.log(x + '\n' + y + '\n' + z);
                }
            });
        }
        else if (SubmitStatus == "Approved" || SubmitStatus == "Recommended" || SubmitStatus == "Endorsed" || SubmitStatus == "Declined" || SubmitStatus == "Withdrawn")
        {

            var form = {
                ID: $("#hfTrainingID").val(),
                TaskID: $("#hfTaskID").val(),
                CurrentUserID: $("#hfEmpID").val(),
                Status: "",
                ApproverComment: $("#Comment").val(),
                ActivityName: "",
                OptionalApprover: false

            };

            $.ajax({
                url: '@Url.Content("~/Training/PostApproverActionForReplacement")',
                type: 'POST',
                cache: false,
                async: false,
                dataType: "json",
                //data: form,
                data: { 'info': form, 'ApproverAction': SubmitStatus },
                //contentType: "application/json;charset=utf-8",
                success: function (result) {
                    console.log(result);
                    if (result.Success) {
                        //alert('success');
                        //$("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").css("display", "none");
                        $("#SuccessSubmit").modal();
                    } else {
                        //alert('error');
                        $("#ConfirmUpdate").modal('toggle');
                        $("#divLoading").css("display", "none");
                        //btnSubmitForm.disabled = false;
                        alert(result.ErrorMsg);
                    }

                },
                error: function (x, y, z) {
                    //alert('asdas');
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").css("display", "none");
                    console.log(x + '\n' + y + '\n' + z);
                }
            });
        }


    }

    function Validation(_Status) {
        var ValidationMsg = '';

        if (_Status == 'Draft') {
            $('#btnSubmitSave').css("display", "none");
            $('#btnSubmitDraft').css("display", "initial");
            $('.modal-body .well').html('Are you sure you want to Save this Training Request Application For Replacement?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Draft'); });
            $('#ConfirmUpdate').modal('show');
        } else if (_Status == 'Pending') {
            $('#btnSubmitSave').css("display", "initial");
            $('#btnSubmitDraft').css("display", "none");
            $('.modal-body .well').html('Are you sure you want to Submit this Training Request Application For Replacement?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Submit'); });
            $('#ConfirmUpdate').modal('show');
        } else if (_Status == "Approved") {
            $('#btnSubmitSave').css("display", "initial");
            $('#btnSubmitDraft').css("display", "none");
            $("#btnSubmitSave").attr("onclick", "SaveForm('" + _Status + "')");
            $('.modal-body .well').html('Are you sure you want to Approve this Training Request Application For Replacement?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Approve'); });
            $('#ConfirmUpdate').modal('show');
        } else if (_Status == "Declined") {
            $('#btnSubmitSave').css("display", "initial");
            $('#btnSubmitDraft').css("display", "none");
            $("#btnSubmitSave").attr("onclick", "SaveForm('" + _Status + "')");
            $('.modal-body .well').html('Are you sure you want to Decline this Training Request Application For Replacement?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Approve'); });
            $('#ConfirmUpdate').modal('show');
        } else if (_Status == "Withdrawn") {
            $('#btnSubmitSave').css("display", "initial");
            $('#btnSubmitDraft').css("display", "none");
            $("#btnSubmitSave").attr("onclick", "SaveForm('" + _Status + "')");
            $('.modal-body .well').html('Are you sure you want to Withdraw this Training Request Application For Replacement?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Submit'); });
            $('#ConfirmUpdate').modal('show');
        }
    }


    function RedirectTo() {
        window.location.href = '@Url.Content("~/Training/TrainingReplacementSearch")';
    }
</script>


