@model Tuple<ESS.Core.CoursePickerList, List<string>>

@{
    ViewBag.Title = "Course Session Info";
    int CountDown = Model.Item1.StartDate.Value.Subtract(DateTime.Now).Days;
    string BENumber = "BE" + Model.Item1.CourseSessionID;
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Course Session Details
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Course Session Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Course Title <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" value="@Model.Item1.CourseTitle" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">BE Number <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" value="@BENumber" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Start Date <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" value="@Model.Item1.StrStartDate" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Today Date <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="TodayDate" value="@DateTime.Now.ToString("dd/MM/yyyy")" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Count Down (days)<span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" value="@CountDown" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Participant List
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th width="1%">No</th>
                                <th>Employee</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 1; i <= Model.Item2.Count; i++)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@Model.Item2[i - 1]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Update Course
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Action <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="DestroyUniform" type="radio" name="action" value="Update" checked /> Update <br />
                                        <input class="DestroyUniform" type="radio" name="action" value="Postpone" /> Postpone <br />
                                        <input class="DestroyUniform" type="radio" name="action" value="Cancel" /> Cancel Course <br />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Reason <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="DestroyUniform" type="radio" name="reason" value="SME Not available" checked /> SME Not available <br />
                                        <input class="DestroyUniform" type="radio" name="reason" value="Public holiday" /> Public holiday <br />
                                        <input class="DestroyUniform" type="radio" name="reason" value="Need extra time for preparation" /> Need extra time for preparation <br />
                                        <input class="DestroyUniform" type="radio" name="reason" value="Other reasons" /> Other reasons <br />

                                        <textarea id="otherReason" class="form-control" cols="30" rows="6" style="display:none"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Start Date <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control date-picker" type="text" id="StartDate" readonly value="@Model.Item1.StrStartDate" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">End Date <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control date-picker" type="text" id="EndDate" readonly value="@Model.Item1.StrEndDate" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Course Fee <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="CourseFee" value="@Model.Item1.TrainingFee.Trim()" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Comment <span id="lvTypeMan_2" class="hide" style="color:red;"> *</span></label>
                                    <div class="col-md-8 form-control-static">
                                        <textarea id="comment" class="form-control" cols="30" rows="6"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4"></label>
                                    <div class="col-md-8 form-control-static">
                                        <a class="btn btn-primary" id="btnSubmit">Submit</a>
                                        <a class="btn btn-primary" id="btnBack">Back</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="ConfirmUpdate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Confirmation</h4>
            </div>
            <div class="modal-body">
                <div class="well">
                    Are you sure you want to <span id="spanAction">Update</span> this course?<br />Press Confirm to proceed, or Close to stay on the current page. <br />
                    <span id="wariningDaysLeft" style="display:none; color:red">There are still @CountDown days left before the event. Do you still want to proceed?</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default blue" value="Draft" onclick="javascript: SubmitForm();">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well">
                    Course information updated successfully.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <button type="button" class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
    </p>
</div>

<script>

    $(window).load(function () {
        $.uniform.restore(".DestroyUniform");
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            enableOnReadonly: false,
            minDate: '0'
        });
        //$('.date-picker').datepicker('setStartDate', '@Model.Item1.StartDate');
    });

    $(document).ready(function () {
        transformTable("#tblResult");
    });

    $('input[type=radio][name=reason]').change(function () {
        if ($(this).val() == "Other reasons") {
            $("#otherReason").show();
        }
        else
            $("#otherReason").hide();
    });

    $('input[type=radio][name=action]').change(function () {
        if ($(this).val() == "Cancel") {
            $("#StartDate, #EndDate, #CourseFee").attr('readonly', true);
            $('.date-picker').datepicker('remove');
        }
        else if ($(this).val() == "Update") {
            $("#StartDate, #EndDate").attr('readonly', true);
            $('.date-picker').datepicker('remove');
            $("#CourseFee").removeAttr('readonly');
        }
        else if ($(this).val() == "Postpone") {
            $("#StartDate, #EndDate").attr('readonly', false);
            $('.date-picker').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                enableOnReadonly: false,
                minDate: '0'
            });
            $("#CourseFee").attr('readonly', true);
        }
    });

    $(document).on('blur', '#CourseFee', function () {
        var x = $(this);
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                //$(x).val(myNumeric.toFixed(2));
                $(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }
    });

    function ThousandSeparator(x) {
        x = x.replace(',', '');
        var sRegExp = new RegExp('(-?[0-9]+)([0-9]{3})'),
            sValue = x + '';

        while (sRegExp.test(sValue)) {
            sValue = sValue.replace(sRegExp, '$1,$2');
        }

        return sValue;
    }

    function Validate() {

        var action = $('input[type=radio][name=action]:checked').val();
        var reason = $('input[type=radio][name=reason]:checked').val();
        var comment = $("#comment").val();
        var message = "";

        if (action == "Postpone") {
            var startDateValue = $("#StartDate").val();
            var endDateValue = $("#EndDate").val();
            if (startDateValue != "") {
                var startDate = moment(startDateValue, 'DD/MM/YYYY').toDate();
                var endDate = moment(endDateValue, 'DD/MM/YYYY').toDate();

                var difference = moment().diff(startDate, 'days');
                var result = Math.abs(difference);
                if (Number(difference) > 0)
                    message += "- Start date must be later than today \n";

                if (moment(endDate).isBefore(startDate))
                    message += "- End date must be later than start date \n";
            }
        }
        if (reason == "Other reasons")
        {
            var otherReason = $("#otherReason").val();
            if (otherReason == "")
                message += "- Reason is required when chosen Other Reasons \n";
        }
        if (comment == "")
            message += "- Comment is required \n";
        if (message != "") {
            alert("Please check the following errors: \n" + message);
            return false;
        }

        return true;
    }

    $(document).on('click', '#btnSubmit', function () {
        var action = $('input[name=action]:checked').val();
        $("#spanAction").text(action);

        var action = $('input[name=action]:checked').val();
        if (action == "Postpone" || action == "Cancel")
            $("#wariningDaysLeft").show();
        else
            $("#wariningDaysLeft").hide();

        //validate the start date only if the action is update or postpone
        if (Validate())
            $("#ConfirmUpdate").modal();
    });

    function SubmitForm() {
        $("#divLoading").show();
        var action = $('input[name=action]:checked').val();
        var reason = $('input[name=reason]:checked').val();
        var otherReason = "";
        if (reason == "Other reasons")
            reason = $("#otherReason").val();

        var form = {
            Action: action,
            Reason: reason,
            StartDate: $("#StartDate").val(),
            EndDate: $("#EndDate").val(),
            CourseFee: $("#CourseFee").val(),
            Comment: $("#comment").val(),
            CourseSessionID: '@Model.Item1.CourseSessionID'
        }

        $.ajax({
            url: '@Url.Content("~/Training/PostCourseCancellation")',
            type: "POST",
            dataType: "json",
            data: form,
            success: function (response) {
                if (response.Success) {
                    $("#divLoading").css("display", "none");
                    $("#ConfirmUpdate").modal('hide');
                    $("#SuccessSubmit").modal();
                } else {
                    $("#divLoading").css("display", "none");
                    alert(response.ErrorMsg);
                }
            },
            error: function (x, y, z) {
                $("#divLoading").css("display", "none");
                console.log(x + '\n' + y + '\n' + z);
            }
        });
    }

    $(document).on('click', '#btnOK, #btnBack', function () {
        window.location.href = '@Url.Content("~/Training/PostponementAndCancellation")';
    });
</script>