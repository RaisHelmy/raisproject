@model ESS.Core.EmployeeDetailsSummary

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Requestor Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Employee Number
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="EmployeeCode">@Model.EmployeeCode</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Company
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="Company">@Model.Company</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Employee Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="EmployeeName">@Model.EmployeeName</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Division / Department
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="DivisionDepartment">@Model.Department</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Position
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="Position">@Model.Position</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Unit / Section
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="UnitSection">@Model.UnitSection</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Job Grade
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="JobGrade">@Model.PayScaleGroup</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Manager
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="Manager">@Model.ImmediateManager</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Current Approval
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="CurrentApproval">
                                            @if (string.IsNullOrEmpty(ViewBag.CurrentApproval))
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                @ViewBag.CurrentApproval
                                            }
                                            @*@ViewBag.CurrentApproval*@
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>