@model List<ESS.Core.TrainingApplicationReplacement>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Training Replacement 
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Requst Ref. No</th>
                                <th>Employee</th>
                                <th>BE Number</th>
                                <th>Course Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Training/TrainingApplicationReplacement")?TrainingID=@item.TrainingID">
                                            <i class="fa fa-search"></i>
                                        </a>  
                                    </td>
                                    <td>@item.TrainingRequestNo</td>
                                    <td>@item.EmployeeCode - @item.EmployeeName</td>
                                    <td>@item.CourseSessionID</td>
                                    <td>@item.CourseName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>