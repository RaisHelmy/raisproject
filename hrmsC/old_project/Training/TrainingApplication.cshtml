    function GetCourseCapacity(CourseID, CourseSessionID) {
        $.ajax({
            url: '@Url.Content("~/Training/GetCourseCapacity")',
            type: 'POST',
            cache: false,
            async: false,
            dataType: "json",
            data: { 'CourseID': CourseID, 'CourseSessionID': CourseSessionID },
            success: function (result) {
                //console.log(result);
                if (result.Success) {
                    $("#PendingRequest").val(result.PendingRequests);
                    $("#ApprovedRequest").val(result.ApprovedRequests);
                } else {
                    alert(result.ErrorMsg);
                }
            },
            error: function (x, y, z) {
                console.log(x + '\n' + y + '\n' + z);
            }
        });
    }

