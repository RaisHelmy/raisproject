function MultiPeoplePickerEmployeeCleared() {
        enableActionButton();
        $('#TrainingUserBlocking').hide();
    }

    function MultiPeoplePickerEmployeeSelected() {
        var hfEmpID = $('#hfEmpID').val();
        if (hfEmpID == null || hfEmpID.length < 1)
            return;

        var data = {
            Attendees: hfEmpID.split(","),
            Target: "@Target"
        };

        $.post('@Url.Action("CheckTrainingSubordinateBlocking", "TrainingApplication")',
            data,
            function (result) {
                var validatedList = result.Results;
                var popupMessage = result.PopupMessage;
                var topPageMessage = result.TopPageMessage;
                var uneligibleEmployees = "Uneligible Employees :";

                var count = 1;
                $.each(validatedList, function (i, val) {
                    if (val.IsAllowed == false) {
                        uneligibleEmployees += "\n" + count++ + ". " + val.EmpDetails.EmployeeCode + " - " + val.EmpDetails.EmployeeName;
                    }
                });

                if (count > 1) {
                    alert(popupMessage + "\n" + uneligibleEmployees);
                    disableActionButton();
                    $('#TrainingUserBlocking').show();
                    $('#TrainingUserBlocking').find('h4').html(topPageMessage + "<br /> <br />" + uneligibleEmployees.replace(/\n/g, "<br />"));
                }
                else {
                    enableActionButton();
                    $('#TrainingUserBlocking').hide();
                }
            });
    }
</script>

