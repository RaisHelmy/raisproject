@*@model Tuple<ESS.Core.TrainingForm, List<ESS.Core.DropDownObject>, List<ESS.Core.DropDownObject>, List<ESS.Core.DropDownObject>>*@
@model Tuple<ESS.Core.TrainingForm, List<SEP.RoutingManagement.Service.AllowAction>>
@{
    ViewBag.Title = "Training Request (" + ViewBag.Target + ")";

    string url = HttpContext.Current.Request.Url.AbsoluteUri;
    string[] array = url.Split('?');
    string parameters = array[1];
    parameters = parameters.Replace("&amp;", "&");

    DateTime dtStart = DateTime.Now.AddDays(30);
    string dtStrStart = dtStart.ToString("dd/MM/yyyy");
    var TrainingType = "";
    string Target = ViewBag.Target;

    Uri myUri = new Uri(HttpContext.Current.Request.Url.AbsoluteUri);

    string paramTitle = HttpUtility.ParseQueryString(myUri.Query).Get("Title");
    string paramCategoryTypeCode = HttpUtility.ParseQueryString(myUri.Query).Get("CategoryType");
    string _Title = "";

    if(paramCategoryTypeCode == "I")
    {
        if (ViewBag.CategoryCode == "01")
        {
            _Title = "ILSAS";
        }

    }else if(paramCategoryTypeCode == "NI")
    {
        _Title = "Non ILSAS";
    }

    //List of status for different purpose
    string[] addAttachmentStatus = { "Draft", "Postponed"};
    string[] workflowHistory = { "Pending", "Accepted", "Agreed", "Approved", "Declined", "Withdrawn", "Recommended", "Endorsed" };
    string[] editableStatus = { "Draft", null};
    string[] approvalComments = {"Pending", "Recommended", "Agreed"};
    string[] submittable = { };
    string[] viewModeOrPending = { "Pending", "View"};
    string[] redColor = { "Declined", "Withdrawn"};
    string[] approvalActions = { "Agree", "Approve", "Endrose", "Decline"};

    //if the user can perform any of the approvalActions, then they can see the comment section
    bool canSeeApprovalCommentSection = false;
    if(Model.Item2 != null)
    {
        foreach (var item in Model.Item2)
        {
            if (item.CanAgree == "1" || item.CanApprove == "1" || item.CanEndorse == "1" || item.CanDecline == "1")
            {
                canSeeApprovalCommentSection = true;
                break;
            }
        }
    }

    //Postpone is essentially similar to Draft. They can edit and submit again.
    if(Model.Item1.Status == "Postponed")
    {
        ViewBag.Mode = "Edit";
        if(!string.IsNullOrEmpty(ViewBag.TaskID))
        {
            editableStatus = new string[] { "Draft", "Postponed", null }; //add Postponed status
        }
    }

    TrainingUserBlocking.TrainingUserBlockingResult TrainingUserBlocking = ViewBag.TrainingUserBlocking;
    string PopupMessage = ViewBag.PopupMessage;
    string PageMessage = ViewBag.TopPageMessage;
}

@if (!string.IsNullOrEmpty(paramTitle))
{
    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
                    Training Request - @paramTitle (@ViewBag.Target)
                    <span style="padding-left:20px;">
                        <small></small>
                    </span>
                </h1>
            </div>
        </div>
    </div>
}
else
{
    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
                    Training Request - @ViewBag.CategoryDesc @_Title (@ViewBag.Target)
                    <span style="padding-left:20px;">
                        <small></small>
                    </span>
                </h1>
            </div>
        </div>
    </div>
}

<div id="TrainingUserBlocking" class="row TrainingUserBlocking" style="display: none;">
    <div class="col-md-12">
        <div class="note note-danger">
            <h4>
                @PageMessage
            </h4>
        </div>
    </div>
</div>

@using (Html.BeginForm("", "Training", FormMethod.Post, new { @class = "form-horizontal", @id = "MainForm" }))
