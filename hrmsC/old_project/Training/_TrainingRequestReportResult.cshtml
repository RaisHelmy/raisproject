@model List<ESS.Core.TrainingRequestReport>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Training Request Report
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>No</th>
                                <th>Employee</th>
                                <th>Email</th>
                                <th>Company</th>
                                <th>Division</th>
                                <th>Unit/Section</th>
                                <th>IM</th>
                                <th>Request Reference No</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Course Title</th>
                                <th>Provider</th>
                                <th>Venue</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    
                                    <td>
                                        @if (item.CategoryCode != "06")
                                        {
                                            <a class="btn blue btn-sm" target="_blank" href="@Url.Content("~/Training/TrainingApplication")?ID=@item.TrainingID&Category=@item.CategoryCode&Mode=View&Target=@item.Target">
                                                <i class="fa fa-search"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn blue btn-sm" target="_blank" href="@Url.Content("~/TrainingApplication/Application")?ID=@item.TrainingID&Category=@item.CategoryCode&Mode=View&Target=@item.Target">
                                                <i class="fa fa-search"></i>
                                            </a>
                                        }

                                    </td>
                                    <td>@item.Number</td>
                                    <td>@item.Employee</td>
                                    <td>@item.EmailAddress</td>
                                    <td>@item.Company</td>
                                    <td>@item.Division</td>
                                    <td>@item.UnitSection</td>
                                    <td>@item.IM</td>
                                    <td>@item.ReferenceNo</td>
                                    <td>@item.CategoryDesc</td>
                                    <td>@item.TypeDesc</td>
                                    <td>@item.CourseTitle</td>
                                    <td>@item.Provider</td>
                                    <td>@item.Venue</td>
                                    <td>@item.StartDate</td>
                                    <td>@item.EndDate</td>
                                    @if (item.Status == "Declined" || item.Status == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.Status</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.Status</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div>Note: The list display up to a maximum of 1000 records. Click on "Export to Excel" to view more.</div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    //transformTable("#tblResult");
    $('#tblResult').dataTable({
        "aLengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]]
    });

    var tableWrapper = "#tblResult_wrapper";

    jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
    jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
    jQuery(tableWrapper + ' .dataTables_length select').select2({
        showSearchInput: false //hide search box with special css class
    });
</script>