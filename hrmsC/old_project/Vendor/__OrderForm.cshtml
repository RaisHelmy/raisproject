    function RedirectTo(_Action) {
        switch (_Action) {
            case "Verify":
            case "PRCreated":
            case "Process":
            case "Decline":
                window.location.href = '/_layouts/15/TNBESS/MSS/VendorInTray'; // '/_layouts/15/ESSV2/MSS/VendorInTray';
                break;
            case "Draft":
            case "Submit":
            case "Delete":
            case "Withdraw":
                window.location.href = '/_layouts/15/TNBESS/Vendor/VendorHistory'; // '/_layouts/15/ESSV2/Vendor/VendorHistory';
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }

    function InitializeForm() {
        EmployeeID = document.getElementById('hfEmployeeID').value;
        var TaskID = GetParameterByName("TaskID");

        @if (Model.Editable)
        {
            <text>
            GetDispensary();
            GetVendor();
            AllowEditRequired();
            document.getElementById('tr_Disclaimer').style.display = 'block';
            </text>
        }
        else
        {
            <text>
            GetCurrentApprover('@Model.VendorID');
            DisallowEdit()
            EnableButtons();
            </text>
        }

        @if (!String.IsNullOrEmpty(Model.CreatedBy))
        {
            <text>
            GetEmployeeDetails('@Model.CreatedBy');
            </text>
        }
        else
        {
            <text>
            GetEmployeeDetails(EmployeeID);
            </text>
        }

        @if (Model.Status != "Draft")
        {
            <text>
            GetButtonConfiguration('@Model.VendorID');
            GetAuditLog('@Model.VendorID')
            </text>
        }
    }

    function AllowEditRequired() {
        $('#tblProductList tbody tr').each(function () {
            var _QuantityRequired = $(this).children('td:eq(5)').children('input[type=text]');
            var _QuantityApproved = $(this).children('td:eq(6)').children('input[type=text]');

            _QuantityRequired.prop('readonly', false);
            _QuantityApproved.prop('readonly', true);
        });
    }

    function AllowEditApproved() {
        $('#tblProductList tbody tr').each(function () {
            var _QuantityRequired = $(this).children('td:eq(5)').children('input[type=text]');
            var _QuantityApproved = $(this).children('td:eq(6)').children('input[type=text]');

            _QuantityRequired.prop('readonly', true);
            _QuantityApproved.prop('readonly', false);
        });
    }

    function DisallowEdit() {
        $('#tblProductList tbody tr').each(function () {
            var _QuantityRequired = $(this).children('td:eq(5)').children('input[type=text]');
            var _QuantityApproved = $(this).children('td:eq(6)').children('input[type=text]');

            _QuantityRequired.prop('readonly', true);
            _QuantityApproved.prop('readonly', true);
        });
    }

    $(document).ready(function () {
        InitializeForm();
    });

    /*** Helper Function ***/
    function GetParameterByName(name) {
        name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
        var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
            results = regex.exec(location.search);
        return results === null ? "" : decodeURIComponent(results[1].replace(/\+/g, " "));
    }

    function NumberOnly(evt) {
        var theEvent = evt || window.event;
        var key = theEvent.keyCode || theEvent.which;
        key = String.fromCharCode(key);
        var regex = /[0-9]/;
        if (!regex.test(key)) {
            theEvent.returnValue = false;
            if (theEvent.preventDefault) theEvent.preventDefault();
        }
    }

    function ThousandSeparator(x) {
        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    function ConvertDate(_date) {
        var mnth = ("0" + (_date.getMonth() + 1)).slice(-2),
            day = ("0" + _date.getDate()).slice(-2);

        return [day, mnth, _date.getFullYear()].join("-");
    }
