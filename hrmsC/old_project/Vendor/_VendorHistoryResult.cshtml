@model List<ESS.Core.VendorHistory>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My Order History
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Dispensary</th>
                                <th>Vendor</th>
                                <th>Total Amount</th>
                                <th>Submitted By</th>
                                <th>Submission Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Vendor/Application")?VendorID=@item.ID&Source=History">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.ReferenceNo</td>
                                    <td>@item.Dispensary</td>
                                    <td>@item.Vendor</td>
                                    <td>@item.TotalCost</td>
                                    <td>@item.SubmittedByCode - @item.SubmittedBy</td>
                                    @if (@item.SubmissionDate.HasValue)
                                    {
                                        <td>@item.SubmissionDate.Value.ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (@item.Status == "Declined" || @item.Status == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.Status</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.Status</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>