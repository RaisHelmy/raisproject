@model LeaveQuota.Models.ExamLeave
@{
    var SubmitterID = ViewData["CurrentEmployeeID"];
    string Status = ViewData["Status"] == null ? "Draft" : ViewData["Status"].ToString();
    var ApplicantDescription = ViewData["Description"];
    var ReferenceNo = ViewData["ReferenceNo"];

    string[] editTableStatus = new string[] { "Draft" };
    List<SelectListItem> attachmentDropdownItems = new List<SelectListItem>()
    {
        new SelectListItem()
        {
            Value = "SSC Training Approval Letter",
            Text = "SSC Training Approval Letter"
        },
        new SelectListItem()
        {
            Value = "Email verification from HRSSC",
            Text = "Email verification from HRSSC"
        },
        new SelectListItem()
        {
            Value = "Other",
            Text = "Other"
        }
    };
    var attachmentMode = "View";
    if (string.IsNullOrEmpty(Model.RequestID))
    {
        attachmentMode = "New";
    }
    else if (Status.ToString() == "Draft")
    {
        attachmentMode = "Add";
    }

    var readStatus = "readonly";
    var disabledStatus = "disabled";
    if (Status == "Draft")
    {
        readStatus = "";
        disabledStatus = "";
    }

}

<div id="divMainForm" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Application Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Reference No</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" id="ReferenceNo" class="form-control" value="@ReferenceNo" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Status</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" id="Status" class="form-control" value="@Status" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Year</label>
                                    <div class="col-md-8 form-control-static">
                                        <select id="Year" class="form-control" @disabledStatus>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">&nbsp;</div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-2">Description/Comment</label>
                                    <div class="col-md-8">
                                        <textarea maxlength="500" rows="5" class="form-control" @readStatus id="ApplicantDescription">@ApplicantDescription</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Attachment -->

    </div>

</div>

<div class="row">
    <div class="col-md-12">
        @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = SubmitterID, Mode = attachmentMode, SourceType = Model.GetDisplayName(), RequestID = Model.RequestID, ShowOptionField = "true", ControlType = "dropdown", DropdownList = attachmentDropdownItems, CustomTextLabel1 = "Checklist", Mandatory = "true" })
    </div>
</div>

<script>
    $(document).ready(function () {
        setYear();
    });

    function setYear() {
        var optionsAsString = "";
        var currentYear = new Date().getFullYear();

        for (var i = 0; i < 5; i++) {
            optionsAsString += "<option value='" + (currentYear + i) + "'>" + (currentYear + i) + "</option>";
        }
        $('select[id="Year"]').append(optionsAsString);
        var modelYear = '@Model.Year';
        if (modelYear != "" && modelYear != null)
            $("#Year").val(modelYear);
    }

    function applyReadOnlyOnStatus()
    {
        var status = '@Status';
        var editable = ["Draft"];
        console.log(status);
        if ($.inArray(status, editable) == -1) {

            //disable form inputs
            $("#divMainForm input:text").each(function () {
                $(this).attr('readonly', true);
            });

            //disabled dropdowns
            $("#divMainForm select").each(function () {
                $(this).attr('disabled', true);
            });
        }
    }

    function validate() {
        var year = $("#Year").val();

        var message = "";

        if (year == "") {
            message += "- Year is required \n";
        }
            
        if (message != "") {
            alert("Please correct the following errors. \n" + message);
            return false;
        }
        return true;
    }

    function GetData() {

        return {
            Year: $("#Year").val()
        }
    }
</script>