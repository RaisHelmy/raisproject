            success: function (response) {
                $('#divLoading').hide();
                if (response.Success != null && response.Success == false) {
                    $("#EASYModalBody").html(response.TechnicalError);
                    $("#EASYModalBody").addClass("well");
                    $("#EASYModalBody").css('color', 'red');
                }
                else {
                    $("#EASYModalBody").html(response);
                    $("#EASYModalBody").removeClass("well");
                    $("#EASYModalBody").css('color', 'black');
                }
                $("#EASYModal").modal();
            },
            error: function (err) {
                console.log(err);
            }
        });
    });

    $(document).on('mouseenter mouseleave', '.description', function () {
        $(this).prop('title', $(this).val());
    });

    function pad(n, width, z) {
        z = z || '0';
        n = n + '';
        return n.length >= width ? n : new Array(width - n.length + 1).join(z) + n;
    }
</script>