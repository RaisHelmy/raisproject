@model LeaveQuota.Models.OILLeaveQuotaReportVM
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>SLA Report (OIL Leave Quota)
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel">
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Company</th>
                                <th>Business Area</th>
                                <th>PayScale Group</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Submission Date</th>
                                <th class="IMAG">IM Agree</th>
                                <th class="IMAG">IM Agree Date</th>
                                <th class="HRAP">HR Approval</th>
                                <th class="HRAP">HR Approval Date</th>
                                <th class="IMAP">IM Approval</th>
                                <th class="IMAP">IM Approval Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OILLeaveQuotaDetails)
                            {
                                string statusType = "green";
                                if (@item.Status == "Declined" || @item.Status == "Withdrawn" || @item.Status == "Cancelled" ||
                                    @item.Status == "DE" || @item.Status == "WD" || @item.Status == "CA") { statusType = "red"; }
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Action("EditRequest", "LeaveQuota", new { ID = item.ReferenceID, Source = "OILLeaveQuotaReport" })">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                    <td>@item.ReferenceNo</td>
                                    <td>@item.EmployeeCode - @item.EmployeeName</td>
                                    <td>@item.CompanyCode - @item.CompanyName</td>
                                    <td>@item.BusinessAreaCode - @item.BusinessAreaName</td>
                                    <td>@item.PayScaleGroup</td>
                                    <td>@item.Type</td>
                                    <td style="color:@statusType;"><b>@item.Status</b></td>
                                    <td>@item.SubmissionDate</td>
                                    <td class="HRV">@item.IM_AgreeAction</td>
                                    <td class="HRV">@item.IM_AgreeDate</td>
                                    <td class="IMAC">@item.HR_ApprovalAction</td>
                                    <td class="IMAC">@item.HR_ApprovalDate</td>
                                    <td class="IMAP">@item.IM_ApprovalAction</td>
                                    <td class="IMAP">@item.IM_ApprovalDate</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<table id="tblExport" border="1" style="display: none;">
    <thead>
        <tr>
            <th>Reference No.</th>
            <th>Employee</th>
            <th>Company</th>
            <th>Business Area</th>
            <th>PayScale Group</th>
            <th>Type</th>
            <th>Status</th>
            <th>Submission Date</th>
            <th class="IMAG">IM Agree</th>
            <th class="IMAG">IM Agree Date</th>
            <th class="HRAP">HR Approval</th>
            <th class="HRAP">HR Approval Date</th>
            <th class="IMAP">IM Approval</th>
            <th class="IMAP">IM Approval Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OILLeaveQuotaDetails)
        {
            <tr>
                <td>@item.ReferenceNo</td>
                <td>@item.EmployeeCode - @item.EmployeeName</td>
                <td>@item.CompanyCode - @item.CompanyName</td>
                <td>@item.BusinessAreaCode - @item.BusinessAreaName</td>
                <td>@item.PayScaleGroup</td>
                <td>@item.Type</td>
                <td>@item.Status</td>
                <td>@item.SubmissionDate</td>
                <td class="HRV">@item.IM_AgreeAction</td>
                <td class="HRV">@item.IM_AgreeDate</td>
                <td class="IMAC">@item.HR_ApprovalAction</td>
                <td class="IMAC">@item.HR_ApprovalDate</td>
                <td class="IMAP">@item.IM_ApprovalAction</td>
                <td class="IMAP">@item.IM_ApprovalDate</td>
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
    function remTblCols() {
        var columnsToHide = [
        @{
            if (Model.HideColumns.ColumnNames != null && Model.HideColumns.ColumnNames.Count > 0)
            {
                foreach (var item in Model.HideColumns.ColumnNames)
                {
                    @:"@item",
                }
            }
        }
        ];

        $('#tblExport th').each(function () {
            var className = $(this).attr('class');
            if (typeof className !== 'undefined') {
                if (columnsToHide.findIndex(x => x === className) < 0) {
                    $('th.' + className).remove();
                    $('td.' + className).remove();
                }
            }
        });
    }

    $(function () {


        $('#tblResult').dataTable({
            "bDestroy": true,
            //"aLengthMenu": [
            //    [10, 15, 20, -1],
            //    [10, 15, 20, "All"]
            //],
            //// set the initial value
            //"iDisplayLength": 10,
            "sPaginationType": "bootstrap",
            "oLanguage": {
                "sLengthMenu": "_MENU_ records",
                "oPaginate": {
                    "sPrevious": "Prev",
                    "sNext": "Next"
                }
            },
            "aoColumnDefs": [
                {
                    "sType": "date-dmy",
                    "aTargets": [8, 9, 10, 11, 12, 13, 14]
                }],
            //disable init sorting
            "aaSorting": []
        });

        remTblCols();
    });

    $(function () {
        BindExport();
    });
</script>
