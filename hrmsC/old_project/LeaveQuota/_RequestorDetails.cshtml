@model ESS.Core.EmployeeDetailsSummary

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Requestor Details
                </div>
                <div class="tools">
                    <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Employee Number
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_EmployeeCodeRO">@Model.EmployeeCode</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5 ">
										Joined Date (Contract)
									</label>
									<div class="col-md-7  form-control-static">
										@if (Model.ContractJoinDate != DateTime.MinValue)
										{
											@Model.ContractJoinDate.ToString("dd/MM/yyyy");
										}
									</div>
								</div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Employee Name
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_EmployeeNameRO">@Model.EmployeeName</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5 ">
										Joined Date (Permanent)
									</label>
									<div class="col-md-7  form-control-static">
										@if (Model.PermanentJoinDate != DateTime.MinValue)
										{
											@Model.PermanentJoinDate.ToString("dd/MM/yyyy");
										}
									</div>
								</div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Department
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_DepartmentRO">@Model.Department</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Duty
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_DutyRO">@Model.JobKeyName</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Unit / Section
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_UnitSectionRO">@Model.UnitSection</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Manager
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="ct00_ManagerRO">@Model.ImmediateManager</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-5">
										Position
									</label>
									<div class="col-md-7 form-control-static">
										<label id="ct00_PositionRO">@Model.Position</label>
									</div>
								</div>
							</div>
						</div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Current Approval
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label id="CurrentApproval">
                                            @if (string.IsNullOrEmpty(ViewBag.CurrentApproval))
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                @ViewBag.CurrentApproval
                                            }
                                            @*@ViewBag.CurrentApproval*@
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

