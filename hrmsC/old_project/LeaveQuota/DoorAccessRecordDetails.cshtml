@model IEnumerable<LeaveQuota.Models.DoorAccessDetails>
@{
    Layout = null;
}
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Door Access Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-horizontal">
                            <div class="form-body">
                                <table id="tblDoorAccess" class="table table-striped table-bordered table-hover table-full-width">
                                    <thead>
                                        <tr>
                                            <th>No</th>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Description</th>
                                            <th>Work shift</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null)
                                        {
                                            for (int i = 0; i < Model.Count(); i++)
                                            {
                                                var item = Model.ElementAt(i);
                                                <tr>
                                                    <td>@(i + 1)</td>
                                                    <td>@item.Date</td>
                                                    <td>@item.Time</td>
                                                    <td>@item.Description</td>
                                                    <td>@item.Workshift</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
