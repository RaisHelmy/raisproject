@model LeaveQuota.Models.LeaveQuotaModel
@{
    ViewBag.Title = "Leave Quota - Request";
    string[] editTableStatus = new string[] { "Draft", "Withdrawn" };

    bool canWithdraw = Model.IsOwner && ViewBag.IsCurrentApprover != null && !ViewBag.IsCurrentApprover;
    bool canDelete = Model.IsOwner && Model.RequestStatus == "Draft";
    string[] nonWithdrawableStatus = { "Draft", "Approved", "Withdrawn", "Declined" };

    //All Status in editableStatus will allow the user to edit the form and resubmit
    string Status = editTableStatus.Contains(Model.RequestStatus) ? "Draft" : Model.RequestStatus;
    List<DateTime> Holidays = ViewBag.EmployeeHolidays;

    bool HasApprover = !String.IsNullOrEmpty(Model.CurrentEmployee.ManagerID);

    if (Model != null)
    {
        string ssrsReportUrl = System.Configuration.ConfigurationManager.AppSettings["SSRSReportServerUrl"];
        string ssrsReportFolder = System.Configuration.ConfigurationManager.AppSettings["SSRSReportFolder"];

        ViewBag.PrintLeaveDetails = String.Format(@"{0}?/{1}/{2}&rs:Command=Render&rs:Format=PDF&RequestID={3}",
                                                     ssrsReportUrl, ssrsReportFolder, "LeaveQuotaApplication", Model.RequestID);
    }
}
<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                @Model.Leave.GetDisplayName() Application
            </h1>
        </div>
        <div class="col-md-12 ">
            <div class="pull-right">
                <a href="@ViewBag.PrintLeaveDetails">Print</a>
            </div>
        </div>
    </div>
</div>

@if (Model.IsOwner && editTableStatus.Contains(Model.RequestStatus) && !HasApprover)
{
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    @Html.Raw(ViewBag.NoApproverMessage)
                </h4>
                @*<p>

                    </p>*@
            </div>
        </div>
    </div>
}

@Html.Action("_RequestorDetails", "LeaveQuota", new { ID = Model.RequestID })

<!--LOAD THE LEAVE TYPE-->
@Html.Partial(Model.Leave.GetPartialViewName(),
    Model.Leave,
    new ViewDataDictionary() {
            {"CurrentEmployeeID", Model.CurrentEmployee.ID },
            { "Status", Model.RequestStatus },
            { "Description", Model.ApplicantDescription },
            { "ReferenceNo", Model.RequestNo } })

<!--For the approval process-->
<input type="hidden" id="RequestID" value="@Model.RequestID" />


<!-- Display this only when the status is not draft-->
@if (Model.RequestStatus != "Draft")
{

    @Html.Action("_ApproverSection", new { ID = Model.RequestID })

}

<div class="row" style="padding-top:20px;">
    <div class="col-md-12">
        @if (editTableStatus.Contains(Model.RequestStatus) && HasApprover && Model.IsOwner)
        {
            if (Model.RequestStatus != "Withdrawn")
            {
                <a class="btn green" onclick="javascript: Submit('Draft')">Save as Draft</a>
            }

            <a class="btn green" onclick="javascript: Submit('Pending')">Submit</a>

            if (canDelete)
            {
                <a class="btn red" onclick="javascript:Delete()">Delete</a>
            }
        }

        @if (!nonWithdrawableStatus.Contains(Model.RequestStatus) && canWithdraw)
        {
            <a class="btn red" onclick="javascript: Withdraw()">Withdraw</a>
        }

        @if (ViewBag.BackUrl != null)
        {
            <a class="btn green" href="@ViewBag.BackUrl">Back</a>
        }
    </div>
</div>




<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
    </p>
</div>

<div class="modal fade" id="LeaveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Confirmation</h4>
            </div>
            <div class="modal-body">
                <div class="well">
                    Are you sure you want to <p id="modalAction" style="display:inline">submit</p> this Leave Quota Application? <br />Press Confirm to proceed, or Close to stay on the current page.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default blue" id="btnConfirm" value="Submit">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="button" id="btnClose" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Message -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well">
                    <p id="resultModalBody"></p>
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <button type="button" class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

@Html.Partial("__EmployeeHolidays", Holidays)

<script>
