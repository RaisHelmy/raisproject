    function displayModal() {
        var deferred = $.Deferred();

        if (validate == "undefined") {
            deferred.reject();
            alert("Validate function for form not found");
            return deferred;
        }

        if (!validate()) {
            deferred.reject();
            return deferred;
        }

        $('#LeaveModal').modal();

        $('#btnConfirm').click(function () {
            deferred.resolve();
        });
        $('#btnClose').click(function () {
            deferred.reject();
        });
        return deferred;
    }

    function Submit(Status) {
        if (Status == 'Draft')
            $("#modalAction").text('save');
        else
            $("#modalAction").text('submit');
        displayModal().done(function () {

            $('#LeaveModal').modal('hide');
            $('#divLoading').show();

            var subtypeDetails = GetData();
            //var model = new Object();

            var model = {
                RequestID: '@Model.RequestID',
                RequestNo: '@Model.RequestNo',
                ModelType: '@Model.Leave.GetType()',
                CurrentStatus: '@Model.RequestStatus',
                RequestStatus: Status,
                ModifiedBy: '@Model.CurrentEmployee.ID',
                QuotaTypeName: '@Model.QuotaTypeName',
                LeaveSubtypeCode: '@Model.LeaveSubtypeCode',
                QuotaNo: '@Model.QuotaNo',
                ApplicantDescription: $("#ApplicantDescription").val(),
                Leave: subtypeDetails
            };

            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateLeave", "LeaveQuota")',
                data: model,
                content: "application/json",
                success: function (response) {
                    $('#divLoading').hide();


                    if (response.Success) {
                        $("#resultModal").modal();
                        $("#resultModalBody").html(response.Message);
                        $("#btnOK").click(function () {
                            //redirect to the request history page
                            location.href = '@Url.Action("RequestHistory", "LeaveQuota")';
                        });
                    }
                    else {
                        alert(response.TechnicalError);
                        for (var i = 0; i < response.Positions.length; i++) {
                            var pos = response.Positions[i];
                            console.log(pos);
                            $("#tblOIL>tbody>tr:eq(" + pos + ")").css('background-color', '#EB7D70');
                        }
                        $("#btnOK").click(function () {
                            //redirect to the request history page
                            $("#resultModal").modal('hide');
                            console.log("Technical error: " + response.TechnicalError);
                        });
                    }
                },
                error: function (err) {
                    console.log(err.responseText);
                    $('#divLoading').hide();
                }
            });

        }).fail(function () { });
    }

    function Withdraw() {

        $("#modalAction").text("withdraw");
        displayModal().done(function () {

            $('#LeaveModal').modal('hide');
            $('#divLoading').show();

            $.ajax({
                type: "POST",
                url: '@Url.Action("Withdraw", "LeaveQuota")',
                data: { SourceID: '@Model.RequestID' },
                content: "application/json",
                success: function (response) {
                    $('#divLoading').hide();
                    $("#resultModal").modal();
                    $("#resultModalBody").html(response.Message);

                    if (response.Success) {
                        $("#btnOK").click(function () {
                            location.href = '@Url.Action("RequestHistory", "LeaveQuota")';
                        });
                    }
                    else {
                        $("#btnOK").click(function () {
                            $("#resultModal").modal('hide');
                            console.log("Technical error: " + response.TechnicalError);
                        });
                    }
                },
                error: function (err) {
                    console.log(err.responseText);
                    $('#divLoading').hide();
                }
            });

        }).fail(function () { });
    }

    function Delete() {
        $("#modalAction").text("delete");
        displayModal().done(function () {

            $('#LeaveModal').modal('hide');
            $('#divLoading').show();

            $.ajax({
                type: "POST",
                url: '@Url.Action("Delete", "LeaveQuota")',
                data: { SourceID: '@Model.RequestID' },
                content: "application/json",
                success: function (response) {
                    $('#divLoading').hide();
                    $("#resultModal").modal();
                    $("#resultModalBody").html(response.Message);

                    if (response.Success) {
                        $("#btnOK").click(function () {
                            location.href = '@Url.Action("RequestHistory", "LeaveQuota")';
                        });
                    }
                    else {
                        $("#btnOK").click(function () {
                            $("#resultModal").modal('hide');
                            console.log("Technical error: " + response.TechnicalError);
                        });
                    }
                },
                error: function (err) {
                    console.log(err.responseText);
                    $('#divLoading').hide();
                }
            });

        }).fail(function () { });
    }

