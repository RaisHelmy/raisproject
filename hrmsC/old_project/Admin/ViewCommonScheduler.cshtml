@model Admin.Models.CommonScheduler
@{
    ViewBag.Title = "Integration Scheduler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-group {
        padding-top: 3px;
    }
</style>

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Integration Scheduler : @Model.Name
            </h1>
        </div>
    </div>
</div>

<div id="commonScheduler">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Integration Scheduler Details
                    </div>
                    @*<div class="tools">
                            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                        </div>*@
                </div>
                <div class="portlet-body form">
                    <div class="form-horizontal">
                        <div class="position-form">
                            <div class="form-body">
                                <div class="form-group">
                                    <label class="control-label col-md-2">
                                        Scheduler Name
                                    </label>
                                    <div class="col-md-4">
                                        <input type="hidden" class="form-control" id="SchedulerID" name="SchedulerID" value="@Model.SchedulerID" readonly="" />
                                        <input type="text" class="form-control" id="SchedulerName" name="SchedulerName" value="@Model.Name" readonly="" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-2">
                                        Scheduler Description
                                    </label>
                                    <div class="col-md-10">
                                        <textarea type="text" class="form-control" id="Description" name="Description" value="@Model.Description" readonly=""></textarea>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-2">
                                        Schedule Start
                                    </label>
                                    <div class="col-md-4">
                                        <input type="text" class="form-control" id="ScheduleStart" name="ScheduleStart" value="@Model.ScheduleStart" readonly="" />
                                    </div>
                                    <label class="control-label col-md-2">
                                        Schedule End
                                    </label>
                                    <div class="col-md-4">
                                        <input type="text" class="form-control" id="ScheduleEnd" name="ScheduleEnd" value="@Model.ScheduleEnd" readonly="" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-2" for="form-group-input">
                                        SEP Query
                                    </label>
                                    <div class="col-md-10">
                                        <textarea class="form-control" maxlength="500" rows="5" name="SEPQuery" id="SEPQuery" readonly="">@Model.SEP_Query</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.Action("_CommonSchedulerBlock", "Admin", new { SchedulerID = Model.SchedulerID })

    <input type="button" class="btn green" value="Back" id="btnBack" onclick="window.history.back()">

</div>