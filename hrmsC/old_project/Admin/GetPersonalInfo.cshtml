                                    Marital Status
                                </label>
                                <div class="col-md-8  form-control-static">
                                    <label>@((string.IsNullOrEmpty(Model.Item1.MaritalStatus)) ? "-" : Model.Item1.MaritalStatus)</label>
                                </div>
                            </div>
                            <div class="form-group divMaritalStatusDate">
                                <label class="control-label col-md-4 ">
                                    Marital Status Date
                                </label>
                                <div class="col-md-8  form-control-static">
                                    @if (!string.IsNullOrEmpty(Model.Item1.MaritalStatusDate + ""))
                                    {
                                        <label>
                                            @Service.FormatDateInNumber(@Model.Item1.MaritalStatusDate, "dd/MM/yyyy")
                                        </label>
                                    }
                                    else
                                    {
                                        <label>-</label>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-9" id="EmployeeMasterData" hidden="hidden">
                <div class="clearfix">
                    <div class="row left">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <table id="MasterDataTable" border="1">
                                    <tbody>
                                        @{
                                            if (dt != null)
                                            {
                                                DataRow firstRow = dt.Rows[0];
                                                foreach (DataColumn col in dt.Columns)
                                                {
                                                    <tr>
                                                        <td> @col.ColumnName </td>
                                                        <td> @firstRow[col] </td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    </tbody>

                                </table>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@*script Main Function *@
<script type="text/javascript">
    $(document).ready(function () {

        App.initAjax();

        var x = "@ViewBag.Base64String";
        $('#imgProfile').css('background-image', 'url( ' + x + ') ');

        var divMode = "@divMode";
        var runFieldVisible = "@runFieldVisible";

        if (runFieldVisible.toUpperCase() == "TRUE") {
            Setting_FieldVisible = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldVisible))');
            Setting_FieldEnable = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldEnable))');
            Setting_FieldChecked = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldChecked))');
            Setting_FieldValue = JSON.parse('@Html.Raw(Json.Encode(Model.Item2.FieldValue))');

            //locate it at Employe/index page
            //PopulateSetting(divMode, "#SearchGetPersonalInfo", "#SettingSection", Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue);
            //PopulateSetting(divMode, divMain, LogDiv, Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue)
        }
    });
</script>
@*Script Load Click Function*@
<script type="text/javascript">

    $('#btnGeneralInfo').click(function () {
        $('#btnGeneralInfo').prop("disabled", "disabled");
        $('#btnMasterData').removeAttr('disabled');
        $('#EmployeeGeneralInfo').removeAttr('hidden');
        $('#EmployeeMasterData').prop("hidden", "hidden");
    });

    $('#btnMasterData').click(function () {
        $('#btnGeneralInfo').removeAttr('disabled');
        $('#btnMasterData').prop("disabled", "disabled");
        $('#EmployeeGeneralInfo').prop("hidden", "hidden");
        $('#EmployeeMasterData').removeAttr('hidden');
    });

</script>


