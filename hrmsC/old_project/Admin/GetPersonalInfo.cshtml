<style>
    .boxFormViewGeneralInfo_Photo2 img {
        display: block;
        margin: 0 auto;
    }

    .divProfileImage {
        text-align: center;
    }

    .boxFormViewGeneralInfo_Photo {
        padding: 7px;
        width: 150px;
        border: 1px solid #ffffff;
        /*border-radius: 50% !important;*/
        background-size: cover;
        margin: 0 auto;
    }

    .imgProfile {
        /*background-image: url("/_layouts/15/ESS/Assets/img/fb-profile.jpg") !important; */
        /*border-radius: 50% !important;*/
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
    }

    .left {
        float: left;
        width: 50%;
    }

    .clearfix::after {
        clear: both;
        display: table;
    }

    .right {
        float: right;
        width: 50%;
    }

    @@media only screen and (max-width: 768px) {
        .container {
            flex-direction: column-reverse;
        }

        .left, .right {
            width: 100%;
        }
    }

    #MasterDataTable th, #MasterDataTable td {
        padding-right: 2em;
        padding-left: 5px;
        white-space: nowrap;
    }
</style>
