            <div class="col-md-12">
                <input class="btn" type="submit" name="btnGeneralInfo" value="View General Info" id="btnGeneralInfo" disabled="disabled">
                <input class="btn" type="submit" name="btnMasterData" value="View Master Data" id="btnMasterData">
            </div>
            <div class="col-md-9" id="EmployeeGeneralInfo">
                <div class="clearfix">
                    <div class="row right">
                        <div class="col-md-8">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="col-md-12 form-control-static boxFormViewGeneralInfo_Photo2">
                                        <div class="boxFormViewGeneralInfo_Photo">
                                            <div id="imgProfile" class="imgProfile">
