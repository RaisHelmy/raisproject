                                <div class="form-group divEmployeeNo">
                                    <label class="control-label col-md-4 ">
                                        Employee No.
                                    </label>
                                    <div class="col-md-8 form-control-static leftPading">
                                        <label>@((string.IsNullOrEmpty(Model.Item1.EmployeeCode)) ? "-" : Model.Item1.EmployeeCode)</label>
                                    </div>
                                </div>
                                <div class="form-group divEmployeeName">
                                    <label class="control-label col-md-4 ">
                                        Employee Name
                                    </label>
                                    <div class="col-md-8 form-control-static leftPading">
                                        <label>@((string.IsNullOrEmpty(Model.Item1.EmployeeName)) ? "-" : Model.Item1.EmployeeName)</label>
                                    </div>
                                </div>
                                <div class="form-group divTitle">
                                    <label class="control-label col-md-4">
                                        Title
                                    </label>
                                    <div class="col-md-8 form-control-static leftPading">
                                        <label>@((string.IsNullOrEmpty(Model.Item1.Title)) ? "-" : Model.Item1.Title)</label>
                                    </div>
                                </div>
                                <div class="form-group divDateOfBirth">
                                    <label class="control-label col-md-4 ">
                                        Date of Birth
                                    </label>
                                    <div class="col-md-8  form-control-static leftPading">
                                        @if (!string.IsNullOrEmpty(Model.Item1.DateOfBirth + ""))
                                        {
                                            <label>
                                                @Service.FormatDateInNumber(Model.Item1.DateOfBirth, "dd/MM/yyyy")
                                            </label>
                                        }
                                        else
                                        {
                                            <label>-</label>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divAge">
                                    <label class="control-label col-md-4 ">
                                        Age
                                    </label>
                                    <div class="col-md-8  form-control-static leftPading">
                                        <label>@((string.IsNullOrEmpty(Model.Item1.Age)) ? "-" : Model.Item1.Age)</label>
                                    </div>
                                </div>
                                <div class="form-group divNewICNo">
                                    <label class="control-label col-md-4 ">
                                        New IC No.
                                    </label>
                                    <div class="col-md-8  form-control-static leftPading">
                                        <label>@((string.IsNullOrEmpty(Model.Item1.NewICNo)) ? "-" : Model.Item1.NewICNo)</label>
                                    </div>
                                </div>

                            </div>
