<script>
    function QuickLinkFilter(target)
    {
        var targeturl = "";
        if (target == "ProfileMaintenanceReport") {
            targeturl = '@Url.Content("~/Employee/ProfileMaintenanceReport")';
        }
        else if (target == "Claimsreport") {
            targeturl = '@Url.Content("~/ClaimsReport/Claimsreport")';
        }
        else if (target == "FlexiBenefitsReport") {
            targeturl = '@Url.Content("~/Claims/FlexiBenefitsReport")';
        }
        else if (target == "OutstationFormReport") {
            targeturl = '@Url.Content("~/ClaimsReport/OutstationFormReport")';
        }
        else if (target == "LeaveQuotaRequestReport") {
            targeturl = '@Url.Content("~/LeaveQuota/RequestReport")';
        }
        else if (target == "LeaveReport") {
            targeturl = '@Url.Content("~/LeaveApplication/LeaveReport")';
        }
        else if (target == "TrainingRequestReport") {
            targeturl = '@Url.Content("~/Training/TrainingRequestReport")';
        }
        else if (target == "TrainingEvaluationReport") {
            targeturl = '@Url.Content("~/TrainingEvaluation/TrainingEvaluationReport")';
        }
        else if (target == "TrainingSummaryTrackingReport") {
            targeturl = '@Url.Content("~/Training/TrainingSummaryTrackingReport")';
        }
        else if (target == "AdminSearch") {
            targeturl = '@Url.Content("~/TemporaryPosition/AdminSearch")';
        }
        else if (target == "OfferAcceptanceReport") {
            targeturl = '@Url.Content("~/LTIP/OfferAcceptanceReport")';
        }
        else if (target == "CDSMaintenanceReport") {
            targeturl = '@Url.Content("~/LTIP/CDSMaintenanceReport")';
        }
        else if (target == "PayrollReport") {
            targeturl = '@Url.Content("~/Payroll/PayrollReport")';
        }
        else if (target == "OJARequestReport") {
            targeturl = '@Url.Content("~/OJA/RequestReport")';
        }
        else if (target == "OJARequestReportByVacancy") {
            targeturl = '@Url.Content("~/OJA/RequestReportByVacancy")';
        }
        else if (target == "AllowanceReport") {
            targeturl = '@Url.Content("~/Allowance/AllowanceReport")';
        }
        else if (target == "VendorReport") {
            targeturl = '@Url.Content("~/Vendor/VendorReport")';
        }
        else if (target == "LoanReport") {
            targeturl = '@Url.Content("~/Loan/LoanReport")';
        }
        else if (target == "MedicalBoardReport") {
            targeturl = '@Url.Content("~/MedicalBoard/MedicalBoardReport")';
        }
        else if (target == "WorkScheduleReport") {
            targeturl = '@Url.Content("~/WorkSchedule/WorkScheduleReport")';
        }
        else if (target == "AssetSearch") {
            targeturl = '@Url.Content("~/Asset/AssetSearch")';
        }
        else if (target == "ReportMemo") {
            targeturl = '@Url.Content("~/EPOP/ReportMemo")';
        }
        else if (target == "ReportStatus") {
            targeturl = '@Url.Content("~/EPOP/ReportStatus")';
        }
        else if (target == "EmployeeSchedule") {
            targeturl = '@Url.Content("~/Admin/EmployeeScheduleSearch")';
        }
        else if (target == "WorkingSchedule") {
            targeturl = '@Url.Content("~/Admin/EmployeeWorkingScheduleSearch")';
        }

        $("#QuickLinkFilter").html("LOADING...");

        $.ajax({
            type: "GET",
            url: targeturl + '?CallFromAdminQuickLink=1' + '&EmployeeID=' + '@Model.EmployeeID' + '&EmployeeCode=' + '@Model.EmployeeCode' + '&EmployeeName=' + '@Model.EmployeeName' , //+'?CallFromAdminQuickLink=1' ,//'Url.Content("")', //targeturl + "?CallFromAdminQuickLink=1" + "&EmployeeID=" + "Model.EmployeeID",
            cache: false,
            dataType: "html",
            success: function (content) {
                //document.getElementById("QuickLinkFilter").innerHTML = content;
                //$("#QuickLinkFilter").html(content);
                var dom = $(content);
                var appendScript = "";
                dom.filter('script').each(function () {
                    if (this.src) {
                        var script = document.createElement('script'), i, attrName, attrValue, attrs = this.attributes;
                        for (i = 0; i < attrs.length; i++) {
                            attrName = attrs[i].name;
                            attrValue = attrs[i].value;
                            script[attrName] = attrValue;
                        }
                        document.body.appendChild(script);
                    } else {
                        appendScript += this.text || this.textContent || this.innerHTML || '';
                        appendScript += " ";
                    }
                });
                dom.find('script').each(function () {
                    if (this.src) {
                        var script = document.createElement('script'), i, attrName, attrValue, attrs = this.attributes;
                        for (i = 0; i < attrs.length; i++) {
                            attrName = attrs[i].name;
                            attrValue = attrs[i].value;
                            script[attrName] = attrValue;
                        }
                        document.body.appendChild(script);
                    } else {
                        appendScript += this.text || this.textContent || this.innerHTML || '';
                        appendScript += " ";
                    }
                });
                document.getElementById("QuickLinkFilter").innerHTML = content;
                $.globalEval(appendScript);
                $('#txtEmpName').val('@Model.EmployeeCode' + ' - ' + '@Model.EmployeeName');
                $('#hfEmpID').val('@Model.EmployeeID');
                $('#txtEmployeeID').val('@Model.EmployeeCode' + ' - ' + '@Model.EmployeeName');
                $('#EmployeeID').val('@Model.EmployeeID');
                $('#SubmittedBy').val('@Model.EmployeeCode');
                $('#EmployeeName').val('@Model.EmployeeName');
                $('#EmployeeNo').val('@Model.EmployeeCode');
                $('#employeeSearch').val('@Model.EmployeeCode');
                $('#EmployeeSearch').val('@Model.EmployeeCode');
                $('#EmployeeCode').val('@Model.EmployeeCode');
                $('#EmpName').val('@Model.EmployeeName');
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>
