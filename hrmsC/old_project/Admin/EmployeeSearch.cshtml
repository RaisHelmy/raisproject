@using Admin
@{
    ViewBag.Title = "Employee Search";
    string empCode = ViewBag.EmployeeCode;
    string empName = ViewBag.EmployeeName;
    string empEmailAddress = ViewBag.EmployeeEmailAddress;
    string empMobileNo = ViewBag.EmployeeMobileNumber;
    string imCode = ViewBag.IMCode;
    string imName = ViewBag.IMName;
    string subHODCode = ViewBag.SubHODCode;
    string subHODName = ViewBag.SubHODName;
    string hodCode = ViewBag.HODCode;
    string hodName = ViewBag.HODName;
    string hodivCode = ViewBag.HODivCode;
    string hodivName = ViewBag.HODivName;
}

<style>
    .position-form .form-group {
        margin-bottom: 6px;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Employee Search<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="portlet box blue">
    @*<div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>*@
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Employee Search
        </div>
        <div class="tools">
            <a href="javascript:;" class="collapse" id="hideEmployeeSearch">
            </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <form id="filterFormEmployeeSearch">
                        <div class="form-horizontal">
                            <div class="form-body position-form">
                                <div class="form-group">
                                    <label class="col-md-2 control-label">Employee Code</label>
                                    <div class="col-md-4 form-control-static">
                                        <input class="form-control" id="EmployeeCode1" name="EmployeeCode" value="@ViewBag.EmployeeCode" />
                                    </div>
                                    <label class="col-md-2 control-label">Employee Name</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="EmployeeName1" name="EmployeeName" value="@ViewBag.EmployeeName" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-2 control-label">Employee Email Address</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="EmployeeEmailAddress" name="EmployeeEmailAddress" value="@ViewBag.EmployeeEmailAddress" />
                                    </div>
                                    <label class="col-md-2 control-label">Employee Mobile Number</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="EmployeeMobileNumber" name="EmployeeMobileNumber" value="@ViewBag.EmployeeMobileNumber" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-2 control-label">IM Code</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="IMCode" name="IMCode" value="@ViewBag.IMCode" />
                                    </div>
                                    <label class="col-md-2 control-label">IM Name</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="IMName" name="IMName" value="@ViewBag.IMName" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-2 control-label">SubHOD Code</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="SubHODCode" name="SubHODCode" value="@ViewBag.SubHODCode" />
                                    </div>
                                    <label class="col-md-2 control-label">SubHOD Name</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="SubHODName" name="SubHODName" value="@ViewBag.SubHODName" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-2 control-label">HOD Code</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="HODCode" name="HODCode" value="@ViewBag.HODCode" />
                                    </div>
                                    <label class="col-md-2 control-label">HOD Name</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="HODName" name="HODName" value="@ViewBag.HODName" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-2 control-label">HODiv Code</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="HODivCode" name="HODivCode" value="@ViewBag.HODivCode" />
                                    </div>
                                    <label class="col-md-2 control-label">HODiv Name</label>
                                    <div class="col-md-4">
                                        <input class="form-control" id="HODivName" name="HODivName" value="@ViewBag.HODivName" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="text-right">
                        <a id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchEmployee();">Search</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
    <div class="col-md-12">
        <div id="AdminSearchResult">

        </div>
    </div>
</div>

<script>

    $(function(){
        if ($("#EmployeeCode1").val() != "" || $("#EmployeeName1").val() != ""
            || $("#EmployeeEmailAddress").val() != "" || $("#EmployeeMobileNumber").val() != ""
            || $("#IMCode").val() != "" || $("#IMName").val() != ""
            || $("#SubHODCode").val() != "" || $("#SubHODName").val() != ""
            || $("#HODCode").val() != "" || $("#HODName").val() != ""
            || $("#HODivCode").val() != "" || $("#HODivName").val() != "") {
            SearchEmployee();
        }
        $('input').change(function () {
            this.value = $.trim(this.value);
        });
    });

    function SearchEmployee() {
        $("#AdminSearchResult").html("LOADING...");
        $.ajax({
            type: "GET",
            cache: false,
            url: '@Url.Content("~/Admin/_EmployeeSearchResult")',
            data: $("#filterFormEmployeeSearch").serialize(),
            success: function (listingContent) {
                $("#AdminSearchResult").empty().append(listingContent);
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
</script>
