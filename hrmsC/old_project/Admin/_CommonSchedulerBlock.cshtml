@model List<Admin.Models.CommonSchedulerBlock>
@{
    Layout = null;
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");
    string CheckBoxName = "CheckBox";
    int chkBoxCount = 0;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png"></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Integration Scheduler Block
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div id="tblSchedulerBlockContainer">
                <table id="tblSchedulerBlock" class="table table-striped table-bordered table-hover table-full-width">
                    <thead>
                        <tr>
                            <th>
                                <input id="RemoveCommonSchedulerBlockCheckboxHeader" type="checkbox" onchange="SelectAll(this)" />
                            </th>
                            <th>Start Date</th>
                            <th>Start Time</th>
                            <th>End Date</th>                            
                            <th>End Time</th>
                            <th>Duplicate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" name="ID" value="@item.ID" />
                                    <input type="checkbox" class="RemoveSchedulerBlockCheckbox" name="SchedulerBlock" />
                                </td>
                                <td class="blockStartDate"><input type="hidden" name="BlockStartDate" value="@item.StartDate">@item.StartDate</td>
                                <td class="blockStartTime"><input type="hidden" name="BlockStartTime" value="@item.StartTime">@item.StartTime</td>
                                <td class="blockEndDate"><input type="hidden" name="BlockEndDate" value="@item.EndDate">@item.EndDate</td>
                                <td class="blockEndTime"><input type="hidden" name="BlockEndTime" value="@item.EndTime">@item.EndTime</td>
                                <td><input id="btn-Copy" type="button" class="btn default " value="Copy" onclick="CopyDateTime('@item.StartDate', '@item.StartTime', '@item.EndDate', '@item.EndTime');"></td>
                            </tr>
                        }
                        <tr>
                            <td></td>
                            <td>
                                <div class="col-md-12 form-control-static">
                                    <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                                        <input type="text" class="form-control" data-date-format="dd/mm/yyyy" value="" id="addStartDate">
                                        <span class="input-group-btn">
                                            <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="col-md-12 form-control-static">
                                    <input type="text" class="form-control timeinput" value="" placeholder="HH:MM (e.g 12:30)" id="addStartTime">
                                </div>

                            </td>
                            <td>
                                <div class="col-md-12 form-control-static">
                                    <div class="input-group date date-picker" data-date-format="dd/mm/yyyy">
                                        <input type="text" class="form-control" data-date-format="dd/mm/yyyy" value="" id="addEndDate">
                                        <span class="input-group-btn">
                                            <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="col-md-12 form-control-static">
                                    <input type="text" class="form-control timeinput" value="" placeholder="HH:MM (e.g 12:30)" id="addEndTime">
                                </div>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn blue" id="btnSubmitBlock" onclick="AddSchedulerBlock(); return false;">
                                        <i class="fa fa-plus"></i>
                                        Add
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="form-horizontal">
                    <div class="table-toolbar">
                        <div class="row">
                            <div class="col-md-12">                                
                                <div class="btn-group">
                                    <button type="button" class="btn red" id="btnSubmitBlock" onclick="DeleteSchedulerBlock(); return false;">
                                        <i class="fa fa-minus"></i>
                                        Delete
                                    </button>
                                </div>
                                @*<div class="btn-group">
                                    <a class="btn red" href="javascript:RemoveSchedulerBlock();">
                                        Delete
                                        <i class="fa fa-minus"></i>
                                    </a>
                                </div>*@
                                @*<div class="btn-group">
                                    <a class="btn green" href="javascript:SubmitBlock();">
                                        Submit
                                        <i class="fa"></i>
                                    </a>
                                </div>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        });
        $('.time-picker').timepicker({
            autoclose: true,
        });

        $('.timeinput').inputmask("h:s", {
            //"mask" : "__:__",
            "placeholder": "__/__",
            onincomplete: function () {
                // replace placeholder with zero
                $(this).val($(this).val().replace(/_/g, '0'));

                if ($(this).get(0).onblur) {
                    $(this).get(0).onblur();
                }

                if ($(this).get(0).onchange) {
                    $(this).get(0).onchange();
                }
            }
        });
    });
        
    var mytable = $('#tblSchedulerBlock').DataTable({
        "bLengthChange": false,
        "bFilter": false
    });

    function CombineDateAndTime(date, time) {

        //var datec = date + ' ' + time;
        //var combined = new Date(datec);
        //return combined;
        var newDate = date.split("/");
        var newTime = time.split(":");
        var retDateTime = new Date(newDate[2], newDate[1] - 1, newDate[0], newTime[0], newTime[1]);
        //console.log(retDateTime);
        return retDateTime;
        
    };

    function AddSchedulerBlock() {
        var data = [];
        var id = $('[name=SchedulerID]').val();
        var addStartDate = $('#addStartDate').val();
        var addEndDate = $('#addEndDate').val();
        var addStartTime = $('#addStartTime').val();
        var addEndTime = $('#addEndTime').val();
        var startDateTime = CombineDateAndTime(addStartDate, addStartTime);
        var endDateTime = CombineDateAndTime(addEndDate, addEndTime);

        if (addStartDate != '' && addStartTime != '' && addEndDate != '' && addEndTime != '') {
            if (startDateTime < endDateTime) {
                mytable.fnAddData(['<input type="hidden" name="ID" value="" /><input name="SchedulerBlock" type="checkbox" class="RemoveSchedulerBlockCheckbox"  />',
                    '<label class="blockStartDate" name="StartDate"><input type="hidden" name="BlockStartDate" value="' + addStartDate + '">' + addStartDate + '</label>',
                    '<label class="blockStartTime" name="StartTime"><input type="hidden" name="BlockStartTime" value="' + addStartTime + '">' + addStartTime + '</label>',
                    '<label class="blockEndDate"><input type="hidden" name="BlockEndDate" value="' + addEndDate + '">' + addEndDate + '</label>',
                    '<label class="blockEndTime"><input type="hidden" name="BlockEndTime" value="' + addEndTime + '">' + addEndTime + '</label>',
                    '<label></label>'
                ])
                //console.log(id + addStartDate + addEndDate + addStartTime + addEndTime);
                data.push({
                    SchedulerID: id,
                    StartDate: addStartDate,
                    EndDate: addEndDate,
                    StartTime: addStartTime,
                    EndTime: addEndTime
                });
                //console.log(data);

                var postData = { asb: data };
                //console.log(postData);
                $.post('@Url.Action("AddSchedulerBlock", "Admin")', postData, function (result) {
                    if (result.Success) {
                        alert("Scheduler Block Date/Time added.");
                    }
                    else {
                        alert(result.ErrorMsg);
                    }
                    window.location.reload();
                });

                $('#addStartDate').val('');
                $('#addEndDate').val('');
                $('#addStartTime').val('');
                $('#addEndTime').val('');

                $('.RemoveSchedulerBlockCheckbox').uniform();
                //window.location.reload();
            }
            else if (startDateTime > endDateTime) {
                alert('End Date/Time should not earlier than Start Date/Time.');
            }
            else {
                alert('Error on Start Date/Time or End Date/Time.');
            }
            
        }
        else {
            alert('Please insert Start Date/Time and End Date/Time.');
        }       
        
    }

    //delete schedulerblock from db and remove from interface
    function DeleteSchedulerBlock() {
        var data = [];

        var selectedChargeCodeSearch = mytable.fnGetNodes()
            .filter(function (val) { return $(val).find('input[name="SchedulerBlock"]:checked').val(); });

        $('input[name="SchedulerBlock"]:checked').each(function () {
            var $row = $(this).closest('tr');
            data.push({
                SchedulerID: $('[name=SchedulerID]').val(),
                StartDate: $row.find('[name=BlockStartDate]').val(),
                EndDate: $row.find('[name=BlockEndDate]').val(),
                StartTime: $row.find('[name=BlockStartTime]').val(),
                EndTime: $row.find('[name=BlockEndTime]').val(),
                ID: $row.find('[name=ID]').val(),
            });

        });

        if (data.length < 1) {
            alert("No date time selected.");
            return;
        }

        var postData = { dsb: data };
        //console.log(postData);
        $.post('@Url.Action("DeleteSchedulerBlock", "Admin")', postData, function (result) {
                if (result.Success) {
                    alert("Scheduler Block Date/Time deleted.");
                }
                else {
                    alert(result.ErrorMsg);
                }
            });

        $.each(selectedChargeCodeSearch, function (i, val) {
            var row = val;
            mytable.fnDeleteRow(mytable.fnGetPosition(row));
        });

    }

