    function SelectAll(element) {
        $('#tblSchedulerBlock .RemoveSchedulerBlockCheckbox').attr('checked', element.checked);
        $.uniform.update();
    }

    function CopyDateTime(StartDate, StartTime, EndDate, EndTime) {
        $('#addStartDate').val(StartDate);
        $('#addStartTime').val(StartTime);
        $('#addEndDate').val(EndDate);
        $('#addEndTime').val(EndTime);

    }


</script>