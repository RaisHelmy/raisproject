@using Admin.Models
@using System.Linq
@model List<Admin.Models.WorkingSchedule>
@{
    Layout = null;
}

<div class="portlet box blue">
    @*<div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>*@
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Employee Working Schedule Listing
        </div>
        <div class="tools">
            <a href="javascript:;" class="collapse" id="hideWorkingSchedule">
            </a>
        </div>
    </div>

    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <table id="tblWorkingScheduleResult" class="table table-striped table-bordered table-hover table-full-width">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Start Date/Time</th>
                            <th>End Date/Time</th>
                            <th>Working Type</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                         {
                            <tr>
                                <td>
                                    <a class="text" href="@Url.Action("EmployeeSearch", "Admin")?EmployeeCode=@item.EmployeeCode"> @((string.IsNullOrEmpty(item.EmployeeCode)) ? "" : item.EmployeeCode)</a> - @((string.IsNullOrEmpty(item.EmployeeName)) ? "" : item.EmployeeName)
                                </td>
                                @if (item.StartDateTime.HasValue)
                                {
                                    <td>@item.StartDateTime.Value.ToString("dd-MM-yyyy HH:mm:ss")</td>
                                }
                                else
                                {
                                    <td>-</td>
                                }
                                @if (item.EndDateTime.HasValue)
                                {
                                    <td>@item.EndDateTime.Value.ToString("dd-MM-yyyy HH:mm:ss")</td>
                                }
                                else
                                {
                                    <td>-</td>
                                }
                                <td>
                                    @((string.IsNullOrEmpty(item.WorkingType)) ? "-" : item.WorkingType)
                                </td>
                                @if (item.CreatedDate.HasValue)
                                {
                                    <td>@item.CreatedDate.Value.ToString("dd-MM-yyyy")</td>
                                }
                                else
                                {
                                    <td>-</td>
                                }
                            </tr>
                         }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>


<script>

    jQuery.extend(jQuery.fn.dataTableExt.oSort, {
        "date-time-pre": function (a) {
            if (a == null || a == "") {
                return 0;
            }
            //var date = a.split('-');            
            //return (date[2] + date[1] + date[0]) * 1;

            var datetime = a.split(' ');
            var date = datetime[0].split('-');
            var time = datetime[1].split(':');
            //var day = date[0];
            //var month = date[1];
            //var year = date[2];
            //var hour = time[0];
            //var minute = time[1];
            //console.log(year + month + day + hour + minute);
            return (date[2] + date[1] + date[0] + time[0] + time[1]) * 1;
        },

        "date-time-asc": function (a, b) {
            return ((a < b) ? -1 : ((a > b) ? 1 : 0));
        },

        "date-time-desc": function (a, b) {
            return ((a < b) ? 1 : ((a > b) ? -1 : 0));
        },

        "date-dmy-pre": function (a) {
            if (a == null || a == "") {
                return 0;
            }
            var date = a.split('-');
            return (date[2] + date[1] + date[0]) * 1;
        },

        "date-dmy-asc": function (a, b) {
            return ((a < b) ? -1 : ((a > b) ? 1 : 0));
        },

        "date-dmy-desc": function (a, b) {
            return ((a < b) ? 1 : ((a > b) ? -1 : 0));
        }

    });

    $('#tblWorkingScheduleResult').dataTable({
        "aLengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]],
        "aoColumnDefs": [
            { "sType": "date-time", "aTargets": [1] },
            { "sType": "date-time", "aTargets": [2] },
            { "sType": "date-dmy", "aTargets": [4] }
        ]
	});

    var tableWrapper = "#tblWorkingScheduleResult_wrapper";

	jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
	jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
	jQuery(tableWrapper + ' .dataTables_length select').select2({
		showSearchInput: false //hide search box with special css class
    });


</script>