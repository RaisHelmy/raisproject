<div id="SearchGetPersonalInfo">

</div>
<div id="DisplayQuickLink">

</div>





<script>
    $('#tblAdminResult').dataTable({
		"aLengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]]
	});

    var tableWrapper = "#tblAdminResult_wrapper";

	jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
	jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
	jQuery(tableWrapper + ' .dataTables_length select').select2({
		showSearchInput: false //hide search box with special css class
    });

    $(function () {
        if (@CountList == 1) {
            SearchGetPersonalInfo();
            DisplayQuickLink();
        }
    });

    @if (EmployeeInfo != null) {
        <text>
        function SearchGetPersonalInfo()
        {
        //if (@EmployeeInfo.EmployeeID != null ) {
        $("#SearchGetPersonalInfo").html("LOADING...");

        $.ajax({
                    type: "GET",
            url: '@Url.Content("~/Admin/GetPersonalInfo")',
            cache: false,
            dataType: "html",
            data: { EmployeeID: '@EmployeeInfo.EmployeeID', EmployeeCode: '@EmployeeInfo.EmployeeCode', PhotoID: '@EmployeeInfo.PhotoID' },
            success: function (content) {
                $("#SearchGetPersonalInfo").html(content);
                    },
            error: function (e) {
                        console.log(e);
                    }
                });
            //}
        }

    function DisplayQuickLink()
    {
        $("#DisplayQuickLink").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Admin/QuickLinkChoice")',
            cache: false,
            dataType: "html",
            data: { EmployeeID: '@EmployeeInfo.EmployeeID', EmployeeCode: '@EmployeeInfo.EmployeeCode', IMCode: '@EmployeeInfo.IMCode', SubHODCode: '@EmployeeInfo.SubHODCode', HODCode: '@EmployeeInfo.HODCode' },
            success: function (content) {
                $("#DisplayQuickLink").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
        </text>
    }

    function ShortQuickLinkPP(target, empID, empCode, empName) {
        var targeturl = "";
        if (target == "EP") {
            targeturl = '@Url.Content("~/Employee/ProfileMaintenanceReport")';
        }
        else if (target == "CL") {
            targeturl = '@Url.Content("~/ClaimsReport/ClaimsReport")';
        }
        else if (target == "FB") {
            targeturl = '@Url.Content("~/Claims/FlexiBenefitsReport")';
        }
        else if (target == "OF") {
            targeturl = '@Url.Content("~/ClaimsReport/OutstationFormReport")';
        }
        else if (target == "PY") {
            targeturl = '@Url.Content("~/Payroll/PayrollReport")';
        }
        else if (target == "OE") {
            targeturl = '@Url.Content("~/OJA/RequestReport")';
        } 
        else if (target == "AW") {
            targeturl = '@Url.Content("~/Allowance/AllowanceReport")';
        } 
        else if (target == "ID") {
            targeturl = '@Url.Content("~/Vendor/VendorReport")';
        }
        else if (target == "LO") {
            targeturl = '@Url.Content("~/Loan/LoanReport")';
        }
        else if (target == "MB") {
            targeturl = '@Url.Content("~/MedicalBoard/MedicalBoardReport")';
        }
        else if (target == "WS") {
            targeturl = '@Url.Content("~/WorkSchedule/WorkScheduleReport")';
        }
        else if (target == "HT") {
            targeturl = '@Url.Content("~/Asset/AssetSearch")';
        }
        $.ajax({
            type: "GET",
            url: targeturl + '?CallFromShortQuickLinkPP=1' + '&EmployeeID=' + empID + '&EmployeeCode=' + empCode + '&EmployeeName=' + empName , //+'?CallFromAdminQuickLink=1' ,//'Url.Content("")', //targeturl + "?CallFromAdminQuickLink=1" + "&EmployeeID=" + "Model.EmployeeID",
            cache: false,
            dataType: "html",
            success: function (content) {
                window.open(targeturl + '?CallFromShortQuickLinkPP=1' + '&EmployeeID=' + empID + '&EmployeeCode=' + empCode + '&EmployeeName=' + empName);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
    function ShortQuickLinkFT(target, empID, empCode, empName) {
        var targeturl = "";
        if (target == "LR") {
            targeturl = '@Url.Content("~/LeaveApplication/LeaveReport")';
        }
        else if (target == "LQ") {
            targeturl = '@Url.Content("~/LeaveQuota/RequestReport")';
        }
        else if (target == "TR") {
            targeturl = '@Url.Content("~/Training/TrainingRequestReport")';
        }
        else if (target == "TE") {
            targeturl = '@Url.Content("~/TrainingEvaluation/TrainingEvaluationReport")';
        }
        else if (target == "TS") {
            targeturl = '@Url.Content("~/Training/TrainingSummaryTrackingReport")';
        }
        else if (target == "TP") {
            targeturl = '@Url.Content("~/TemporaryPosition/AdminSearch")';
        }
        else if (target == "LA") {
            targeturl = '@Url.Content("~/LTIP/OfferAcceptanceReport")';
        }
        else if (target == "LM") {
            targeturl = '@Url.Content("~/LTIP/CDSMaintenanceReport")';
        }
        else if (target == "EM") {
            targeturl = '@Url.Content("~/EPOP/ReportMemo")';
        }
        else if (target == "ES") {
            targeturl = '@Url.Content("~/EPOP/ReportStatus")';
        }
        else if (target == "SC") {
            targeturl = '@Url.Content("~/Admin/EmployeeScheduleSearch")';
        }
        else if (target == "EW") {
            targeturl = '@Url.Content("~/Admin/EmployeeWorkingScheduleSearch")';
        }
        $.ajax({
            type: "GET",
            url: targeturl + '?CallFromShortQuickLinkFT=1' + '&EmployeeID=' + empID + '&EmployeeCode=' + empCode + '&EmployeeName=' + empName, //+'?CallFromAdminQuickLink=1' ,//'Url.Content("")', //targeturl + "?CallFromAdminQuickLink=1" + "&EmployeeID=" + "Model.EmployeeID",
            cache: false,
            dataType: "html",
            success: function (content) {
                window.open(targeturl + '?CallFromShortQuickLinkFT=1' + '&EmployeeID=' + empID + '&EmployeeCode=' + empCode + '&EmployeeName=' + empName );
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

</script>