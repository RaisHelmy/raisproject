@using System.Configuration;

@model ESS.ContractAbsorption.Models.EmployeeSubmitterDetailsSummary

@{
	Layout = null;
}

<div id="EmployeeDetails" class="row">
	<div class="col-md-12">
		<div class="portlet box blue">
			<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-reorder"></i>Employee Details
				</div>
			</div>
			<div class="portlet-body form">
				<div class="form-body" id="ct00_CustomFieldFormView">
					<div class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Employee Number
									</label>
									<div class="col-md-8 form-control-static">
										@Model.EmployeeCode
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Employee Name
									</label>
									<div class="col-md-8 form-control-static">
										@Model.EmployeeName
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4">
										Position
									</label>
									<div class="col-md-8 form-control-static">
										@Model.PositionName
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Duty
									</label>
									<div class="col-md-8  form-control-static">
										@Model.JobKeyName
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Department
									</label>
									<div class="col-md-8  form-control-static">
										@Model.AreaName
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Unit/ Section
									</label>
									<div class="col-md-8  form-control-static">
										@Model.SubAreaName
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Immediate Manager
									</label>
									@if (!String.IsNullOrEmpty(Model.ManagerName.ToString()))
									{
										<div class="col-md-8  form-control-static">
											@Model.ManagerName
										</div>
									}
									else
									{
										<div class="col-md-8  form-control-static">
											<span>-</span>
										</div>
									}
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Payscale Grade
									</label>
									<div class="col-md-8  form-control-static">
										@Model.PayScaleGroup
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Current Position Grade
									</label>
									<div class="col-md-8  form-control-static">
										@Model.PositionGrade
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Joined Date
									</label>
									<div class="col-md-8  form-control-static">
										@Model.JoinDate.ToString("dd/MM/yyyy")
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Age
									</label>
									<div class="col-md-8  form-control-static">
										<span id="EmployeeAge">

										</span>
									</div>
								</div>
							</div>
						</div>
					</div>
					<br />
				</div>
			</div>
		</div>
	</div>
</div>


<script>
    function getAge(birthday) {
        var today = new Date();
        var thisYear = 0;
        if (today.getMonth() < birthday.getMonth()) {
            thisYear = 1;
        } else if ((today.getMonth() == birthday.getMonth()) && today.getDate() < birthday.getDate()) {
            thisYear = 1;
        }
        var age = today.getFullYear() - birthday.getFullYear() - thisYear;
        return age;
    }

	var birthdayDate = new Date(Date.parse("@Model.BirthDate.ToString("MM/dd/yyyy")"));

    $("#EmployeeAge").text(getAge(birthdayDate));
</script>
