@model ESS.ContractAbsorption.Models.OnlineAssessmentModel

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewBag.Title = "Assessment Criteria Table";
}

<!DOCTYPE html>

<html>
<head>
	<meta name="viewport" content="width=device-width" />
	<title>AssessmentCriteriaTable</title>
</head>
<body>
	<h2>Assessment Criteria Definition</h2>
	<div class="table-toolbar">
		<table id="tblResult1" class="table table-striped table-bordered table-hover table-full-width">
			<thead>
				<tr>
					<th style="width:1%">Bil</th>
					<th style="width:50%">Faktor Penilaian</th>
					<th style="width:50%">Takrifan</th>
				</tr>
			</thead>
			<tbody>
				@for (int i = 0; i < Model.AssessmentCriteriaTable.Count(); i++)
				{
					<tr>
						<td class="WrapTextColumn" style="min-width:50px;"><label class="reqAssessment WrapTextColumn">@Model.AssessmentCriteriaTable[i].OrderNo</label></td>
						<td class="WrapTextColumn" style="min-width:200px;"><label class="reqAssessment WrapTextColumn">@Model.AssessmentCriteriaTable[i].Factor</label></td>
						<td class="WrapTextColumn" style="min-width:200px;"><label class="reqAssessment WrapTextColumn">@Html.Raw(@Model.AssessmentCriteriaTable[i].Definition)</label></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</body>
</html>
