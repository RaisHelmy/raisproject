@model Tuple<ESS.ContractAbsorption.Models.EContractAbsorptionVM, SEP.RoutingManagement.Models.RoutingRule>

@using ESS.Core

@{
	Layout = null;

	string TaskID = (string)ViewData["TaskID"];
	string RequestID = (string)ViewData["RequestID"];
	string ApprovalLevel = (string)ViewData["ApprovalLevel"];
	string Source = (string)ViewData["Source"];
	string EmployeeID = (string)ViewData["EmployeeID"];
	string OnlineAssessmentDefinitionURL = (string)ViewData["OnlineAssessmentDefinitionURL"];

	var data = new ViewDataDictionary
{
		new KeyValuePair<string, object>("TaskID", TaskID),
		new KeyValuePair<string, object>("RequestID", RequestID),
		new KeyValuePair<string, object>("ApprovalLevel", ApprovalLevel),
		new KeyValuePair<string, object>("Source", Source),
		new KeyValuePair<string, object>("EmployeeID", EmployeeID),
		new KeyValuePair<string, object>("OnlineAssessmentDefinitionURL", OnlineAssessmentDefinitionURL)
	};

	int applvl = String.IsNullOrEmpty(ApprovalLevel) ? 0 : Convert.ToInt32(ApprovalLevel);
}

<!-- Employee Details -->
@Html.Partial("_EmployeeSubmitterInfo", Model.Item1.Submiter)

<div class="row">
	<div class="col-md-12">
		<div class="portlet box blue">
			<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-reorder"></i>Request Details
				</div>
			</div>
			<div class="portlet-body form">
				<div class="form-body">
					<div id="trRefNo" class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">Reference No.</label>
									<div class="col-md-8 form-control-static">
										<input type="text" id="txtReferenceNo" name="ReferenceNo" class="form-control" value="@Model.Item1.ReferenceNo" readonly="readonly" />
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">Status</label>
									<div class="col-md-8 form-control-static">
									@if (new Guid(Common.GetEmployeeID()) != Model.Item1.Submiter.EmployeeID || Model.Item1.StatusName == "Pending Staff")
									{
										<input type="text" id="txtStatusName" name="StatusName" class="form-control" value="@Model.Item1.StatusName" readonly="readonly" />
									}
									else
									{ 
										<input type="text" id="txtStatusName" name="StatusName" class="form-control" value="" readonly="readonly" />
									}
									</div>
								</div>
							</div>
						</div>
					</div>
					<div id="trRefNo" class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">First Contract Start Date</label>
									<div class="col-md-8 form-control-static">
										<input type="text" id="txtFirstContractStartDate" name="FirstContractStartDate" class="form-control" value="@Model.Item1.FirstContractStartDate" readonly="readonly" />
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">First Contract End Date</label>
									<div class="col-md-8 form-control-static">
										<input type="text" id="txtFirstContractEndDate" name="FirstContractEndDate" class="form-control" value="@Model.Item1.FirstContractEndDate" readonly="readonly" />
									</div>
								</div>
							</div>
						</div>
					</div>
					<div id="trRefNo" class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">Current Contract Start Date</label>
									<div class="col-md-8 form-control-static">
										<input type="text" id="txtLastContractStartDate" name="LastContractStartDate" class="form-control" value="@Model.Item1.LastContractStartDate" readonly="readonly" />
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">Current Contract End Date</label>
									<div class="col-md-8 form-control-static">
										<input type="text" id="txtLastContractEndDate" name="LastContractEndDate" class="form-control" value="@Model.Item1.LastContractEndDate" readonly="readonly" />
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="row" style="">
						<div id="divCurrentApprover" class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">Current Approver</label>
									<div class="col-md-8 form-control-static">
										<input type="text" id="txtCurrentApprover" name="CurrentApprover" class="form-control" value="@Model.Item1.CurrentApproverCode" readonly="readonly" />
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">

								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<input class="hidden" value="SameForm_Details" />

@Html.Partial("_OnlineAssessmentFormDetailsPMSList", Model, data)

@Html.Partial("_OnlineAssessmentFormDetailsMedicalList", Model, data)

@Html.Partial("_OnlineAssessmentFormDetailsList", Model, data)

@Html.Partial("_OnlineAssessmentFormDetailsDisciplinaryCase", Model, data)

@Html.Partial("_OnlineAssessmentFormDetailsAcceptance", Model, data)

