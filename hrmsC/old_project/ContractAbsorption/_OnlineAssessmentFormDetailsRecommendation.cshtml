@model Tuple<ESS.ContractAbsorption.Models.EContractAbsorptionVM, SEP.RoutingManagement.Models.RoutingRule>

@using ESS.Core

@{
	Layout = null;

	string TaskID = (string)ViewData["TaskID"];
	string RequestID = (string)ViewData["RequestID"];
	string ApprovalLevel = (string)ViewData["ApprovalLevel"];
	string Source = (string)ViewData["Source"];
	string EmployeeID = (string)ViewData["EmployeeID"];
	string OnlineAssessmentDefinitionURL = (string)ViewData["OnlineAssessmentDefinitionURL"];

	int applvl = String.IsNullOrEmpty(ApprovalLevel) ? 0 : Convert.ToInt32(ApprovalLevel);

	string Checked2_1 = "";
	string Checked2_2 = "";

	switch (Model.Item1.Acknowledgement)
	{
		case "R":
			Checked2_1 = "checked";
			break;
		case "NR":
			Checked2_2 = "checked";
			break;
	}
}
<style>
	.padding-left-20 {
		padding-left: 20px;
	}

	.padding-left-5px {
		padding-left: 5px;
	}
</style>

<div class="row">
	<div class="col-md-12">
		<div class="portlet box blue">
			<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-reorder"></i>Recommendation
				</div>
			</div>
			<div class="portlet-body form">
				<div class="form-body" id="ct01_CustomFieldFormView">
					<div class="EdittableContent">
						<div class="row">
							<div class="col-md-12">
								<div class="form-horizontal">
									<div class="form-group">
										<label class="control-label col-md-12 ">
											<b>Recommendation <span class="required">*</span></b>
										</label>
									</div>
								</div>
							</div>
						</div>
						<div class="row" id="radio_RecommendedDiv">
							<div class="col-md-12">
								<div class="form-horizontal">
									<div class="form-group">
										<div class="radio-list padding-left-20">
											<label class="radio-inline">
												<span class="Divradio_Recommended"><input type="radio" name="rblAcknowledgement" @Checked2_1 class="reqAcknowledge" id="radio_Recommended" value="R"></span> Recommended
											</label>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="row" id="radio_NotRecommendedDiv">
							<div class="col-md-12">
								<div class="form-horizontal">
									<div class="form-group">
										<div class="radio-list padding-left-20">
											<label class="radio-inline">
												<span class="radio_NotRecommended"><input type="radio" @Checked2_2 class="reqAcknowledge" name="rblAcknowledgement" id="radio_NotRecommended" value="NR"></span> Not Recommended
											</label>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="NonEdittableContent">
						<div class="row">
							<div class="col-md-12">
								<div class="form-horizontal">
									<div class="form-group">
										<label class="control-label col-md-12 ">
											Recommendation <span class="required">*</span>
										</label>
									</div>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-md-12">
								<div class="form-horizontal">
									<div class="form-group">
										<label class="col-md-12 ">
											@(Model.Item1.Acknowledgement == "R" ? "Recommended" : (Model.Item1.Acknowledgement == "NR" ? "Not Recommended" : ""))
										</label>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>