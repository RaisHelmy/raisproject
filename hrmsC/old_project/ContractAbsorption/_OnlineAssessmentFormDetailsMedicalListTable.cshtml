@model List<ESS.Core.MedicalLeaveInfo>

@{
	Layout = null;

	List<ESS.Core.MedicalLeaveInfo> MedicalLeaveInfos = Model.OrderByDescending(x => x.LeaveYear).ToList();
}
<div class="form-horizontal">
	<div class="table-toolbar">
		<table id="tblMedical" class="table table-striped table-bordered table-hover table-full-width">
			<thead>
				<tr>
					<th style="width:15%; text-align: center">Leave Type</th>
					<th style="width:30%; text-align: center">@(MedicalLeaveInfos[2].LeaveYear)</th>
					<th style="width:30%; text-align: center">@(MedicalLeaveInfos[1].LeaveYear)</th>
					<th style="width:30%; text-align: center">@(MedicalLeaveInfos[0].LeaveYear)</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td>Medical Leave - Warded</td>
					@if (Model != null)
					{
						<td style="text-align: center;">@MedicalLeaveInfos[2].Warded</td>
						<td style="text-align: center;">@MedicalLeaveInfos[1].Warded</td>
						<td style="text-align: center;">@MedicalLeaveInfos[0].Warded</td>
					}
					else
					{
						<td style="text-align: center;">N/A</td>
						<td style="text-align: center;">N/A</td>
						<td style="text-align: center;">N/A</td>
					}

				</tr>

				<tr>
					<td>Medical Leave - Non-Warded</td>
					@if (Model != null)
					{
						<td style="text-align: center;">@MedicalLeaveInfos[2].NonWarded</td>
						<td style="text-align: center;">@MedicalLeaveInfos[1].NonWarded</td>
						<td style="text-align: center;">@MedicalLeaveInfos[0].NonWarded</td>
					}
					else
					{
						<td style="text-align: center;">N/A</td>
						<td style="text-align: center;">N/A</td>
						<td style="text-align: center;">N/A</td>
					}
				</tr>
			</tbody>
		</table>
	</div>
</div>

<script>
	$('#tblMedical').dataTable(
		{
			"bLengthChange": false,
			"bFilter": false,
			"bPaginate": false,
			"bInfo": false,
			"bSortable": false,
		});
</script>


