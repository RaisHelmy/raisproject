@using System.Configuration;

@model TimeAttendance.Models.EmployeeDetails

@{
	Layout = null;
}

<div id="EmployeeDetails" class="row">
	<div class="col-md-12">
		<div class="portlet box blue">
			<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-reorder"></i>Employee Details
				</div>
			</div>
			<div class="portlet-body form">
				<div class="form-body" id="ct00_CustomFieldFormView">
					<div class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Employee Number
									</label>
									<div class="col-md-8 form-control-static">
										@Model.EmployeeCode
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Employee Name
									</label>
									<div class="col-md-8 form-control-static">
										@Model.EmployeeName
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4">
										Cost Center
									</label>
									<div class="col-md-8 form-control-static">
										@Model.CostCenterCode - @Model.CostCenterName
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Division / Department
									</label>
									<div class="col-md-8  form-control-static">
										@Model.AreaName
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Unit / Section
									</label>
									<div class="col-md-8  form-control-static">
										@Model.SubAreaName
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-4 ">
										Immediate Manager
									</label>
									<div class="col-md-8  form-control-static">
										@Model.ManagerName
									</div>
								</div>
							</div>
						</div>
					</div>
					<br />
				</div>
			</div>
		</div>
	</div>
</div>
