@model Tuple<ESS.StandbyPlanning.Models.StandbyPlanningVM, SEP.RoutingManagement.Models.RoutingRule>

@{
	Layout = null;
}

@if (Model.Item1.btnSubmit == true)
{
	<div class="row EditContent">
		<div class="col-md-12">
			<div class="portlet box blue">
				<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
				<div class="portlet-title">
					<div class="caption">
						<i class="fa fa-reorder"></i>
						Approval Comments
					</div>
				</div>
				<div class="portlet-body form">
					<div class="form-body">
						<div class="row">
							<div class="col-md-12">
								<div class="form-horizontal">
									<div class="form-group">
										<label class="control-label col-md-2 col-sm-4 col-xs-4">Comments <span class="required">*</span></label>
										<div class=" col-md-10 col-sm-8 col-xs-8">
											<textarea id="txtApprovalComment" name="Comments" class="form-control" rows="3" cols="60" @(Model.Item1.btnSubmit ? "" : "readonly")></textarea>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}