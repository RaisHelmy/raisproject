@using TimeAttendance.Services

@{
    Layout = null;

    string CurrEmpID = string.Empty;
    string SearchType = string.Empty;

    if (!string.IsNullOrEmpty(ViewBag.CurrEmpID) && ViewBag.CurrEmpID == "CurrEmpID")
    {
        CurrEmpID = Timesheet.GetCurrentEmployeeID();
    }

    if (!string.IsNullOrEmpty(ViewBag.SearchType))
    {
        SearchType = ViewBag.SearchType;
    }
}

<div class="modal fade" id="PeoplePicker" tabindex="-1" aria-hidden="true" style="z-index:10060 !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">
					<p>People Picker - Select By Employee Number or Name </p>
                </h4>
            </div>
            <div class="modal-body">
                <div>
                    <div class="row" onkeypress="return event.keyCode!=13;">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-body">
                                    @if (SearchType != "")
                                    {
                                        <div class="form-group">
                                            <label class="control-label col-md-2 ">
                                                Search Type
                                            </label>
                                            @if (SearchType == "Subordinates")
                                            {
                                                <div class="col-md-4 form-control-static">
                                                    <select class="form-control" id="SearchType">
                                                        <option value="Favourite">Favourite</option>
                                                        <option selected value="Subordinates">Subordinates</option>
                                                        <option value="">All</option>
                                                    </select>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="form-group">
                                        <label class="control-label col-md-2 ">
                                            Employee Number
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            <input type="text" class="form-control" name="txtEmpCodeSearch" id="txtEmpCodeSearch" />
                                        </div>
                                        <label class="control-label col-md-2 ">
                                            Employee Name
                                        </label>
                                        <div class="col-md-4  form-control-static">
                                            <input type="text" class="form-control" name="txtEmpNameSearch" id="txtEmpNameSearch" />
                                        </div>
                                    </div>
                                    <div class="form-group ">
                                        <div class="text-right">
                                            <input id="btn-Search" type="button" value="Search" class="btn green btn-Search" onclick="SearchPP();">
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div id="PeoplePickerResult">

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default green" onclick="SetSelectedEmployee()">Select</button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var CurrentSelectedElement = null;

	$(function () { })

    function SetCurrentSelectedID(el) {
		CurrentSelectedElement = $(el);
		$('#PeoplePickerResult').empty();
		$('#txtEmpNameSearch').val('');
        $('#txtEmpCodeSearch').val('');
	}

    function SearchPP() {
        var _EmpCode = $('#txtEmpCodeSearch').val();
        var _EmpName = $('#txtEmpNameSearch').val();
        var _SearchType = $('#SearchType').val();
        var _CurrEmpID = '@CurrEmpID';

        $("#PeoplePickerResult").html("LOADING...");
		
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/StandbyPlanning/_SPPeoplePickerSearchResult")',
            cache: false,
            dataType: "html",
            data: { EmpCode: _EmpCode, EmpName: _EmpName, SearchType: _SearchType, CurrEmpID: _CurrEmpID,},
            success: function (content) {
                $("#PeoplePickerResult").html(content);
            },
            error: function (e) {
            }
        });
    }

    function SetSelectedEmployee() {
        $("#tblPeoplePicker td input[type=radio]").each(function () {
            var _selected = $(this).prop("checked");

            if (_selected) {
                var _empDisplayName = $(this).attr("empcode") + ' - ' + $(this).attr("empName");
                var _empID = $(this).val();
                var _empCode = $(this).attr("empcode");
                var _empName = $(this).attr("empName");

                $(CurrentSelectedElement).parent().siblings('.SPPeoplePickerDisplay').val(_empDisplayName);
				$(CurrentSelectedElement).parent().siblings('.SPPeoplePickerID').val(_empID);
				$(CurrentSelectedElement).parent().siblings('.SPPeoplePickerCode').val(_empCode);
				$(CurrentSelectedElement).parent().siblings('.SPPeoplePickerName').val(_empName);
				$(CurrentSelectedElement).parent().siblings('.SPPeoplePickerDisplay').change();

                $('#PeoplePicker').modal('toggle');

                CurrentSelectedElement = null;
            }
        });
    }
</script>