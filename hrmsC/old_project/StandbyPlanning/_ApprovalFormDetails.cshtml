@model Tuple<ESS.StandbyPlanning.Models.StandbyPlanningVM, SEP.RoutingManagement.Models.RoutingRule>

@{
	Layout = null;
}

<!-- Employee Details -->
@Html.Partial("_EmployeeRequestorInfo", Model.Item1.Requestor)

<div class="row">
	<div class="col-md-12">
		<div class="portlet box blue">
			<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-reorder"></i>Submission Details
				</div>
			</div>
			<div class="portlet-body form">
				<div class="form-body">
					<div id="trRefNo" class="row">
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">Reference No.</label>
									<div class="col-md-8 form-control-static">
										@Model.Item1.ReferenceNo
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">Status</label>
									<div class="col-md-8 form-control-static">
										<span style="color:green">@Model.Item1.StatusName</span>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="row" style="">
						<div id="divCurrentApprover" class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">
									<label class="control-label col-md-4">Current Approver</label>
									<div class="col-md-8 form-control-static">
										@Model.Item1.CurrentApproverCode
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-horizontal">
								<div class="form-group">

								</div>
							</div>
						</div>
					</div>
				</div>
				<br />
			</div>
		</div>
	</div>
</div>