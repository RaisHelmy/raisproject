@model Tuple<List<ESS.StandbyPlanning.Models.StandbyPlanningVM>, TimeAttendance.Models.EmployeeDetails>
@{
    ViewBag.Title = "Standby Planning Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string IsSupervisorMessage = ViewBag.IsSupervisor;
}

<style>
    .timeinput::-ms-clear {
        width: 0;
        height: 0;
    }
</style>

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                @ViewBag.Title
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>

@using (Html.BeginForm("StandbyPlanningGroup", "StandbyPlanning", FormMethod.Post))
{

    <div id="tab_1" class="tab-pane active">
        @if (!string.IsNullOrEmpty(IsSupervisorMessage))
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="note note-danger">
                        <h4 class="block">
                            @IsSupervisorMessage
                        </h4>

                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle">@*<img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" />*@</div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Requestor Details
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Employee</label>
                                            <div class="col-md-8 form-control-static">
                                                @Model.Item2.EmployeeCode - @Model.Item2.EmployeeName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Division / Department</label>
                                            <div class="col-md-8 form-control-static">
                                                @Model.Item2.AreaName
                                            </div>
                                        </div>
                                    </div>
