                                                @Model.Item2.CostCenterCode - @Model.Item2.CostCenterName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Immediate Manager</label>
                                            <div class="col-md-8 form-control-static">
                                                @Model.Item2.ManagerName
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
