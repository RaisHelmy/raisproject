@model List<ESS.Core.PeoplePickerObject>

@{
    Layout = null;
}

<div class="table-toolbar">
    <table id="tblMultiPeoplePicker" class="table table-striped table-bordered table-hover table-full-width">
        <thead>
            <tr>
                <th>
                    <input type="checkbox" name="SelectAllMultiPeoplePicker" id="SelectAllMultiPeoplePicker" onchange="SelectUnselectAllMultiPeoplePicker(this);" />
                </th>
                <th>Employee Number</th>
                <th>Employee Name</th>
                <th>Department</th>
                <th>Unit/Section</th>
                <th>Position</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in @Model)
            {
                <tr>
                    <td><input type="checkbox" name="pp" class="MultiPeoplePickerCheckBox" value="@item.EmployeeID" empname="@item.EmployeeName" empcode="@item.EmployeeCode" /></td>
                    <td>@item.EmployeeCode</td>
                    <td>@item.EmployeeName</td>
                    <td>@item.Department</td>
                    <td>@item.UnitSection</td>
                    <td>@item.Position</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@Html.Partial("_includeDataTableScripts")

<script>
    $(function () {
        $('#tblMultiPeoplePicker .MultiPeoplePickerCheckBox').change(function () {
            $('#SelectAllMultiPeoplePicker').prop('checked', IsALLCheckBoxCheckedMultiPeoplePicker());
        });
    });

    $('#tblMultiPeoplePicker').dataTable({
        "fnDrawCallback": function (settings) {
            $('#SelectAllMultiPeoplePicker').prop('checked', IsALLCheckBoxCheckedMultiPeoplePicker());
        },
        "aoColumnDefs": [
            { 'bSortable': false, 'aTargets': [0] }
        ]
    });

    function IsALLCheckBoxCheckedMultiPeoplePicker() {
        if ($('#tblMultiPeoplePicker .MultiPeoplePickerCheckBox:checked').length == $('#tblMultiPeoplePicker .MultiPeoplePickerCheckBox').length) {
            return true;
        }
        else {
            return false;
        }
    }

    function SelectUnselectAllMultiPeoplePicker(element) {
        $('#tblMultiPeoplePicker .MultiPeoplePickerCheckBox').prop('checked', element.checked);

        $.uniform.update();
    }
</script>
