@model List<ESS.StandbyPlanning.Models.StandbyPlanningDetails>

@{
	Layout = null;
	int CountRow = 0;

}

<div class="portlet box blue">
	<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
	<div class="portlet-title">
		<div class="caption">
			<i class="fa fa-reorder"></i>Standby Planning Report
		</div>
		<input type="button" id="ExportExcel" class="btn btn-xs green pull-right" value="Export To Excel" onclick="ExportExcel()" />
		<div class="tools">
		</div>
	</div>
	<div class="portlet-body form">
		<div class="form-body">
			<div class="form-horizontal">
				<div class="table-toolbar">
					<table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
						<thead>
							<tr>
								<th></th>
								<th>Employee</th>
								<th>Standby Date</th>
								<th>Description</th>
								<th>Charge Code</th>
								<th>Submitted By</th>
								<th>Submitted Date</th>
								<th>Approved By</th>
								<th>Approved Date</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td>
										@if (item.StandByID != Guid.Empty)
										{
										<a class="btn blue btn-sm" href="@Url.Content("~/StandbyPlanning/ApprovalForm")?StandByID=@item.StandByID&TaskID=">
											<i class="fa fa-search"></i>
										</a>
										}
										else
										{ 
										<a class="btn dark btn-sm" disabled>
											<i class="fa fa-search"></i>
										</a>
										}
									</td>
									<td>@item.EmployeeName - @item.EmployeeCode</td>
									<td>@item.StandByDate.ToString("dd-MM-yyyy")</td>
									<td>@item.Description</td>
									<td>@item.ChargeCode</td>
									<td>@item.SubmitterName - @item.SubmitterCode</td>
									<td>@(item.SubmissionDate == DateTime.MinValue ? "" : item.SubmissionDate.ToString("dd-MM-yyyy"))</td>
									@if (item.StatusCode == "AP")
									{
										<td>@item.ApproverName - @item.ApproverCode</td>
										<td>@(item.ApprovedDate == DateTime.MinValue ? "" : item.ApprovedDate.ToString("dd-MM-yyyy"))</td>
									}
									else
									{
										<td> - </td>
										<td></td>
									}
								</tr>
								CountRow++;
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>



<script type="text/javascript">
	//transformTable("#tblResult");
	$('#tblResult').dataTable({
		"aLengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]]
	});

	var tableWrapper = "#tblResult_wrapper";

	jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
	jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
	jQuery(tableWrapper + ' .dataTables_length select').select2({
		showSearchInput: false //hide search box with special css class
	});
</script>