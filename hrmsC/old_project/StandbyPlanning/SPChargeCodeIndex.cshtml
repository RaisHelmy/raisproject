@{
    Layout = "";
}

<div class="modal fade" id="SearchChargeCode" tabindex="-1" role="basic" aria-hidden="true"  style="z-index:10060 !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Select Charge Code</h4>
            </div>
            <div class="modal-body">
                @Html.Action("SPChargeCodeSearch", "StandbyPlanning")
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default green btnSubmitChargeCode" id="btnSubmitChargeCode" onclick="setSelectedChargeCode();" > @*onclick="AddChargeCodeToMain(); return false;"*@
                    Select
                </button>
                <button type="button" class="btn default green" id="btnAddFavCC" onclick="InsertFavCC()">Add to Favourite</button>
                <button type="button" class="btn default green" id="btnDeleteFavCC" onclick="DeleteFavCC()">Delete Favourite</button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>