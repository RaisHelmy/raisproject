@using ESS.Claim.Models
@model IEnumerable<EquivalentGradeMaintenanceViewModel>

<div class="form-body">
    <div class="form-horizontal">
        <div class="table-toolbar">
            <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th></th>
                        <th>Employee</th>
                        <th>Actual Grade</th>
                        @*<th>Equivalent Grade</th>
                        <th>Valid From</th>
                        <th>Valid To</th>*@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a class="btn blue btn-sm"
                                   href="@Url.Action("EquivalentGradeMaintenance", "ClaimsMaintenance", new { EmployeeID = item.EmployeeID })">
                                    <i class="fa fa-edit"></i>
                                </a>
                            </td>
                            <td>@item.EmployeeCode - @item.EmployeeName</td>
                            <td>@item.ActualGrade</td>
                            @*<td>@item.EquivalentGrade</td>
                            <th>@item.FormattedValidFrom</th>
                            <th>@item.FormattedValidTo</th>*@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    transformTable("#tblResult");
</script>