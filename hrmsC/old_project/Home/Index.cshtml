@model ESS.Core.EmployeeInfo

@{
    Layout = null;
    
    DateTime now = DateTime.Now;
    string greeting = "Good Morning";

    if (now.Hour >= 18)
    {
        greeting = "Good Evening";
    }
    else if (now.Hour >= 12)
    {
        greeting = "Good Afternoon";
    }
    else if (now.Hour >= 5)
    {
        greeting = "Good Morning";
    }
    else
    {
        greeting = "Good Day";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>Employee Self Service Portal - Home</title>
    <meta content="" name="description">
    <meta content="" name="keywords">

    <!-- Favicons -->
    <link href="~/Assets/img/favicon.png" rel="icon">
    <link href="~/Assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Montserrat:300,300i,400,400i,500,500i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/Assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/Assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    @*<link href="~/Assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />*@
    @*<link href="~/Assets/vendor/bootstrap/css/bootstrap-utilities.min.css" rel="stylesheet">*@
    <link href="~/Assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="~/Assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/Assets/vendor/remixicon/remixicon.css" rel="stylesheet">
    <link href="~/Assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Template Main CSS File -->
    <link href="~/Assets/css/style-bootslander.css" rel="stylesheet">
    <link href="~/Assets/css/style-bootslander-navbar.css" rel="stylesheet">

    <!-- =======================================================
    * Template Name: Bootslander - v4.8.2
    * Template URL: https://bootstrapmade.com/bootslander-free-bootstrap-landing-page-template/
    * Author: BootstrapMade.com
    * License: https://bootstrapmade.com/license/
    ======================================================== -->
</head>

<body>
    @Html.Partial("_Menu", false)

    <!-- ======= Hero Section ======= -->
    <section id="hero">
        <div class="container">
            <div class="row justify-content-between">
                <div class="col-lg-7 pt-5 pt-lg-0 order-2 order-lg-1 d-flex align-items-center">
                    @if (string.IsNullOrEmpty(Model.ImageContent))
                    {
                        @*<img class="profileimg" id="imgProfile" src="~/Assets/img/default_profile_pic.jpg">*@
                        <div class="profileimg" id="imgProfile" style="background-image: url('TNBESS/Assets/img/default_profile_pic.jpg') "></div>
                    }
                    else
                    {
                        @*<img class="profileimg" id="imgProfile1" src="data:image/jpeg;base64,@Model.ImageContent">*@
                        <div class="profileimg" id="imgProfile1" style="background-image: url(data:image/jpeg;base64,@Model.ImageContent)"></div>
                    }
                    <div data-aos="zoom-out" class="EmployeeDescription">
                        <h1>
                            @greeting<br>
                            <span>@Model.EmployeeName</span>&nbsp;<span style="border-bottom:0px; font-size:medium;">(@Model.EmployeeNo)</span>
                        </h1>
                        <h5>
                            <span style="color:#fff; font-size:small;">@Model.UnitSection | @Model.Department | @Model.Division | @Model.Grade</span>
                        </h5>
                    </div>
                </div>
            </div>
        </div>

        <svg class="hero-waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28 " preserveAspectRatio="none">
            <defs>
                <path id="wave-path" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z">
            </defs>
            <g class="wave1">
                <use xlink:href="#wave-path" x="50" y="3" fill="rgba(255,255,255, .1)">
            </g>
            <g class="wave2">
                <use xlink:href="#wave-path" x="50" y="0" fill="rgba(255,255,255, .2)">
            </g>
            <g class="wave3">
                <use xlink:href="#wave-path" x="50" y="6" fill="#fff">
            </g>
        </svg>

    </section><!-- End Hero -->

    <main id="main">

        <!-- ======= Features Section ======= -->
        <section id="features" class="features">
            <div class="container halfsize" data-aos="fade-up">

                <div class="section-title" data-aos="fade-up">
                    <h2>Announcement</h2>
                    <p>Check The Announcements</p>
                </div>

                <div class="testimonials-slider swiper" data-aos="fade-up" data-aos-delay="50">
                    <div class="swiper-wrapper" style="height: max-content">
                        @foreach (TNB_ESS_MVC.Controllers.Announcement announcement in ViewBag.Announcements)
                        {
                            <div class="swiper-slide">
                                <div class="announce-item">
                                    <img src="@announcement.Image" title="@announcement.Title" class="announce-img" alt="" data-toggle="modal" data-target="#myModal@(announcement.ID)">
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="container halfsize">

                <div class="section-title" data-aos="fade-up">
                    <h2>Features</h2>
                    <p>Check The Features</p>
                </div>

                <div class="row" data-aos="fade-left">
                    @foreach (TNB_ESS_MVC.Controllers.Feature feature in ViewBag.Features)
                    {
                        <div class="col-lg-6 col-md-6">
                            <div class="icon-box" data-aos="zoom-in" data-aos-delay="50">
                                <i class="@(string.IsNullOrEmpty(feature.Icon) ? "ri-file-list-3-line" : feature.Icon)" style="color: #ffbb2c;"></i>
                                <h3><a href="@feature.Path">@feature.Title</a></h3>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section><!-- End Section -->
    </main><!-- End #main -->

    @Html.Partial("_Footer")

    <!-- Modal -->
    @foreach (TNB_ESS_MVC.Controllers.Announcement announcement in ViewBag.Announcements)
    {
        <div class="modal fadeIn" id="myModal@(announcement.ID)" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false">
            <div class="modal-dialog modal-dialog-centered" role="document" style="min-width: 80%;">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="myModalLabel">@Html.Raw(announcement.Title)</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="border:1px solid #d0d0d0; border-radius:25px; width:26px; color:#3d3d3d; background-color: #fff;"><span aria-hidden="true">&times;</span></button>
                    </div>
                    <div class="modal-body" style="overflow: auto">
                        @Html.Raw(announcement.BodyMessage)
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div id="preloader"></div>

    <script src="~/Assets/plugins/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script src="~/Assets/plugins/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>

    <!-- Vendor JS Files -->
    <script src="~/Assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/Assets/vendor/aos/aos.js"></script>
    @*<script src="~/Assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>*@
    <script src="~/Assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/Assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/Assets/vendor/php-email-form/validate.js"></script>

    <!-- Template Main JS File -->
    <script src="~/Assets/scripts/custom/main.js"></script>
</body>

</html>

<script type="text/javascript">
    $(document).ready(function () {
        $('#header').addClass('header-transparent');
    });
</script>
