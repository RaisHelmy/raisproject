@using ServiceAcceptance.Models
@model ServiceAcceptanceVM

@{
    string MinDate = DateTime.Today.ToString("dd/MM/yyyy");
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="@Url.Content("~/Assets/img/menu-red-triangle.png")" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Entry Sheet Details
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Entry Sheet</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.EntrySheetNo</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Currency</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.Currency</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">For Purchase Order</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.PurchaseOrderNo  @Model.EntrySheet.PurchaseOrderItem</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Entry Sheet Net Value</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.NetValue</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Release Code</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.ReleaseCode</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Short Text</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.ShortText</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Created by</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.CreatedBy</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Changed by</label>
                            <div class="col-md-8 form-control-static">
                                <label>
                                    @if (Model.EntrySheet.ChangedBy == "ERP_PI" || Model.EntrySheet.ChangedBy == "ESS_RFC")
                                    {
                                        if (Model.History != null && Model.History.Count > 0)
                                        {
                                            @Model.History.FirstOrDefault().StaffNo
                                        }
                                        else
                                        {
                                            @Model.EntrySheet
                                        }
                                    }
                                    else
                                    {
                                        @Model.EntrySheet.ChangedBy
                                    }
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Created on</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.CreatedOn</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Changed on</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.ChangedOn</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Score for Quality</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.ScoreForQuality</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Document date</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.DocumentDate</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Score for Timeliness</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.EntrySheet.ScoreForTimeliness</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Posting Date</label>
                            <div class="col-md-8 form-control-static">
                                <div class="input-group date date-picker" id="ct_PostDate_DatePicker" data-date-format="dd MM yyyy">
                                    <input type="text" class="form-control" id="ct_PostDate" name="ct_PostDate"
                                           value="@MinDate" />
                                    <span class="input-group-btn">
                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblEntrySheetDetails" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th style="width:25%;">Line Number</th>
                                <th style="width:30%;">Short Text</th>
                                <th style="width:15%;">Quantity</th>
                                <th style="width:15%;">Base UoM</th>
                                <th style="width:15%;">Net Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (@Model.EntrySheet.EntrySheetDetails != null && @Model.EntrySheet.EntrySheetDetails.Count > 0)
                            {
                                foreach (var item in @Model.EntrySheet.EntrySheetDetails)
                                {
                                    <input type="hidden" value="@item.LineNumber" />
                                    if (item.LineNumber == "0000000000")
                                    {
                                        continue;
                                    }
                                    
                                    <tr>
                                        <td>@item.LineNumber</td>
                                        <td>@item.ShortText</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.BaseUoM</td>
                                        <td>@item.NetValue</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        $('#ct_PostDate_DatePicker').datepicker('setStartDate', '@MinDate');
    });
</script>