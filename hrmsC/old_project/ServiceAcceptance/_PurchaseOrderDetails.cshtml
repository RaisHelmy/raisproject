@using ServiceAcceptance.Models
@model ServiceAcceptanceVM

<div class="portlet box blue">
    <div class="mini-triangle"><img src="@Url.Content("~/Assets/img/menu-red-triangle.png")" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Purchase Order Details
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body"> 
            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Vendor</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.PurchaseOrder.VendorNo  @Model.PurchaseOrder.VendorName</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Purchasing Org</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.PurchaseOrder.PurchaseOrg</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Document Date</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.PurchaseOrder.DocumentDate</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Purchasing Group</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.PurchaseOrder.PurchaseGroup</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Currency</label>
                            <div class="col-md-8 form-control-static">
                                <label>@Model.PurchaseOrder.Currency</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblPurchaseOrderDetails" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th style="width:15%;">Comp.Code</th>
                                <th style="width:5%;">Plant</th>
                                <th style="width:10%;">PO No.</th>
                                <th style="width:10%;">PO Item</th>
                                <th style="width:25%;">Short Text</th>
                                <th style="width:10%;">Changed On</th>
                                <th style="width:10%;">Quantity</th>
                                <th style="width:5%;">UoM</th>
                                <th style="width:10%;">Net Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (@Model.PurchaseOrder.PurchaseOrderDetails != null && @Model.PurchaseOrder.PurchaseOrderDetails.Count > 0)
                            {
                                foreach (var item in @Model.PurchaseOrder.PurchaseOrderDetails)
                                {
                                    <tr>
                                        <td>@item.CompanyCode</td>
                                        <td>@item.Plant</td>
                                        <td>@item.PurchaseOrderNo</td>
                                        <td>@item.PurchaseOrderItem</td>
                                        <td>@item.ShortText</td>
                                        <td>@item.ChangedOn</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.Unit</td>
                                        <td>@item.NetValue</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    //transformTable("#tblPuchaseOrderDetails");
    $(function () {
        $('#tblPurchaseOrderDetails').dataTable({
            "bLengthChange": false,
            "bFilter": false,
            "bPaginate": false,
            "bInfo": false,
            "bSortable": false,
        });
    });
</script>