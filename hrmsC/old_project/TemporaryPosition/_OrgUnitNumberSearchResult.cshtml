@model List<TemporaryPosition.Models.OrgUnitNumberObject>
@{
	Layout = null;
}

<div class="table-toolbar">
	<table id="tblOrgUnitNumber" class="table table-striped table-bordered table-hover table-full-width">
		<thead>
			<tr>
				<th></th>
				<th>Org Unit Number</th>
				<th>Division</th>
				<th>Personnel Area</th>
				<th>Personnel Sub Area</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td><input type="radio" name="orgUnitNo" value="@item.OrgUnitNumber" divisionCode="@item.DivisionCode" division="@item.Division" personnelAreaCode="@item.PersonnelAreaCode" personnelArea="@item.PersonnelArea" personnelSubAreaCode="@item.PersonnelSubAreaCode" personnelSubArea="@item.PersonnelSubArea" /></td>
					<td>@item.OrgUnitNumber</td>
					<td>@item.DivisionCode - @item.Division</td>
					<td>@item.PersonnelAreaCode - @item.PersonnelArea</td>
					<td>@item.PersonnelSubAreaCode - @item.PersonnelSubArea</td>
				</tr>
			}
		</tbody>
	</table>
</div>
@Html.Partial("_includeDataTableScripts")
<script>
	transformTable("#tblOrgUnitNumber");
</script>


