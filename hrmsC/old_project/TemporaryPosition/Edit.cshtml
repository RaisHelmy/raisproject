    function submitPosition(action) {
        var url = '';
        var actionPerform = '';
        if (action) {
            actionPerform = "Add";
            url = '@Url.Action("Add", "TemporaryPosition")';
            var promise = displaySubmitModal(true);
        } else {
            actionPerform = "Draft";
            url = '@Url.Action("Draft", "TemporaryPosition")';
            var promise = displaySaveModal(true);
        }

        var btnClicked = $(this);
        promise.done(function () {
            btnClicked.attr('disabled', true);

            $("#SubmitPositionModal").modal('hide');
            $("#SavePositionModal").modal('hide');
            var form = $('#positionForm');
			var data = form.serialize();

            $('#divLoading').show();
            $.ajax({
                type: "POST",
                url: url,
                data: data,
                success: function (response) {
                    if (actionPerform == "Add") {
                        if (response.Success) {
                            $("#submitResultModal").modal();
                            $("#submitResultModalBody").html(response.Message);
                            $("#btnOKSubmit").click(function () {
                                location.href = '@Url.Action("RequestHistory", "TemporaryPosition")';
                            });
                        }
                        else {
                            alert(response.TechnicalError);
                        }
                    }
                    else if (actionPerform == "Draft") {
                        if (response.Success) {
                            $("#saveResultModal").modal();
                            $("#saveResultModalBody").html(response.Message);
                            $("#btnOKSave").click(function () {
                                location.href = '@Url.Action("RequestHistory", "TemporaryPosition")';
                            });
                        }
                        else {
                            alert(response.TechnicalError);
                        }
                    }
                },
                error: function (err) {

                }
            }).done(function () {
                $('#divLoading').hide();
            });
        });
    }

    function displaySubmitModal(shouldValidate) {
        var deferred = $.Deferred();

        if (IsValid == "undefined") {
            deferred.reject();
            alert("Validate function for form not found");
            return deferred;
        }

        //if (shouldValidate && !IsValid("Submit")) {
        //    deferred.reject();
        //    return deferred;
        //}
        //$('#SubmitPositionModal').modal();

		if (shouldValidate) {
			IsValid("Submit").fail(function () { deferred.reject(); }).done(function () { $('#SubmitPositionModal').modal(); });
		}

        $('#btnConfirmSubmit').click(function () {
            deferred.resolve();
        });
        $('#btnCloseSubmit').click(function () {
            deferred.reject();
        });
        return deferred;
    }

    function displaySaveModal(shouldValidate) {
        var deferred = $.Deferred();

        if (IsValid == "undefined") {
            deferred.reject();
            alert("Validate function for form not found");
            return deferred;
        }

        //if (shouldValidate && !IsValid("Save")) {
        //    deferred.reject();
        //    return deferred;
        //}
        //$('#SavePositionModal').modal();

		if (shouldValidate) {
			IsValid("Save").fail(function () { deferred.reject(); }).done(function () { $('#SavePositionModal').modal(); });
		}

        $('#btnSave').click(function () {
            deferred.resolve();
        });
        $('#btnCloseSave').click(function () {
            deferred.reject();
        });
        return deferred;
    }

    function Withdraw() {
        var promise = displayWithdrawModal();

        var btnClicked = $(this);
        promise.done(function () {
            btnClicked.attr('disabled', true);

            $("#DeletePositionModal").modal('hide');
            var url = '@Url.Action("Withdraw", "TemporaryPosition")';
            $('#divLoading').show();
            $.ajax({
                type: "POST",
                url: url,
                data: { 'PositionID': '@Model.PositionID', 'statusToBeUpdate': 'WD' },
                success: function (response) {
                    if (response.Success) {
                        $("#withdrawResultModal").modal();
                        $("#withdrawResultModalBody").html(response.Message);
                        $("#btnOKWithdraw").click(function () {
                            location.href = '@Url.Action("RequestHistory", "TemporaryPosition")';
                        });
                    }
                    else {
                        alert(response.TechnicalError);
                    }
                },
                error: function (err) {

                }
            }).done(function () {
                $('#divLoading').hide();
            });
        });
    }

