@model TemporaryPosition.Models.TemporaryPositionForm
@{
    ViewBag.Title = "Temporary Position Form";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string color = "green";
    if (Model.StatusText == "Declined")
    {
        color = "red";
    }
}

<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
    </p>
</div>

<style>
    #positionForm .form-group {
        margin-bottom: 5px;
    }
</style>

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Temporary Position Form
            </h1>
        </div>
    </div>
</div>
@using (Html.BeginForm("Add", "TemporaryPosition", FormMethod.Post, new { @id = "positionForm" }))
{
    <input type="hidden" name="PositionID" value="@Model.PositionID" />
    if (Model.IsEditable)
    {
        <!--Edit Position Details-->
        @Html.Partial("EditForm", Model)
    }
    else
    {
        <!--View Position Details-->
        @Html.Partial("ViewForm", Model)
    }
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            @if (Model.IsSubmitter)
            {
                if (Model.StatusText == "Withdrawn" || Model.StatusText == "Draft" || Model.StatusText == "Declined")
                {
                    <button class="btn btn-primary submit" id="btnSubmit" onclick="javascript: submitPosition(true); return false;">Submit</button>
                }
                if (Model.StatusText == "Draft")
                {
                    <button class="btn btn-primary submit" id="btnDraft" onclick="javascript: submitPosition(false); return false;">Save</button>
                }
                if (Model.StatusText == "Pending")
                {
                    <button class="btn btn-primary red withdraw" id="btnWithdraw" onclick="javascript: Withdraw(); return false;">Withdraw</button>
                }
                if (Model.StatusText == "Draft")
                {
                    <button class="btn btn-primary red delete" id="btnDelete" onclick="javascript: Delete(); return false;">Delete</button>
                }
                <button class="btn btn-primary" id="btnBack" onclick="javascript: GoBack(); return false;">Back</button>
            }

        </div>
    </div>
}
@*</form>*@
