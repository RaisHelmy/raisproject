    function Delete() {
        var promise = displayDeleteModal();

        var btnClicked = $(this);

        promise.done(function () {
            btnClicked.attr('disabled', true);

            $("#DeletePositionModal").modal('hide');

            var url = '@Url.Action("Delete", "TemporaryPosition")';
            $('#divLoading').show();
            $.ajax({
                type: "POST",
                url: url,
                data: { 'PositionID': '@Model.PositionID', 'actionTaken': 'Delete' },
                success: function (response) {
                    if (response.Success) {
                        $("#deleteResultModal").modal();
                        $("#deleteResultModalBody").html(response.Message);
                        $("#btnOKDelete").click(function () {
                            location.href = '@Url.Action("RequestHistory", "TemporaryPosition")';
                        });
                    }
                    else {
                        alert(response.TechnicalError);
                    }
                },
                error: function (err) {

                }
            }).done(function () {
                $('#divLoading').hide();
            });
        });
    }
    function displayDeleteModal() {
        var deferred = $.Deferred();

        $('#DeletePositionModal').modal();

        $('#btnConfirmDelete').click(function () {
            deferred.resolve();
        });
        $('#btnCloseDelete').click(function () {
            deferred.reject();
        });
        return deferred;
    }
    function displayWithdrawModal() {
        var deferred = $.Deferred();

        $('#WithdrawPositionModal').modal();

        $('#btnConfirmWithdraw').click(function () {
            deferred.resolve();
        });
        $('#btnCloseWithdraw').click(function () {
            deferred.reject();
        });
        return deferred;
    }
