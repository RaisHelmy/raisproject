	$('input:radio[name="PositionCategory"]').change(
		function () {
			if ($(this).is(':checked')) {
				$('#note').html($(this).attr("note").replace(/\n/g, "<br />"));
			}
	});

	function AppendAttachmentLabel() {
		var note = $('input:radio[name="PositionCategory"]:checked').attr("note");
		note = note.replace(/\n/g, "<br />");

		var label = $('<div class="form-group"><label class="control-label col-md-3">Note</label><div class="col-md-5"><label id="note">' + note +'</label></div ></div>');
		label.insertAfter($('#divAddAttach .form-group').get(0));
	}

	function IsValid(saveOrSubmit) {
		var deferred = $.Deferred();
		var errorMessage = "";
		var effectiveDate = $("#EffectiveDate").val();
		var delimitDate = $("#DelimitDate").val();
        var category = $('input:radio[name=PositionCategory]:checked').attr("category");

		errorMessage += $("#OrgUnitNumber").val() == "" ? "- Org Unit Number (EHRMS) is required. \n" : "";
		errorMessage += !$('input:radio[name=PositionCategory]:checked').val() ? "- Position Category is required. \n" : "";
		errorMessage += $("#OrgUnitNumber").val() != "" && $("#OrgUnitNumber").val().length != 8 ? "- Invalid Org Unit Number (EHRMS) length. \n" : "";

		if (effectiveDate != "" && delimitDate != "") {
			errorMessage += moment(effectiveDate, "DD/MM/YYYY").isAfter(moment(delimitDate, 'DD/MM/YYYY')) ? "- Effective Date must be earlier than Delimit Date \n" : "";
		}

		if (saveOrSubmit == "Submit") {
			errorMessage += $("#PositionText").val() == "" ? "- Position Text is required. \n" : "";
			errorMessage += $("#JobText").val() == "" ? "- Job Text is required. \n" : "";
			errorMessage += $("#EffectiveDate").val() == "" ? "- Effective Date is required. \n" : "";
			errorMessage += $("#DelimitDate").val() == "" ? "- Delimit Date is required. \n" : "";
			errorMessage += $("#Reason").val() == "" ? "- Reason for Creation of Position is required. \n" : "";
            errorMessage += $("#SupervisorID").val() == "" ? "- IM Details is required. \n" : "";

            if (category != "B" && $('[name=Employee]').serializeArray().length < 1) {
                errorMessage +=  "- Employee is required. \n";
            }
		}

		if (($("#OrgUnitNumber").val() == "" || $("#OrgUnitNumber").val().length != 8) && errorMessage != "") {
			alert(errorMessage);
			deferred.reject();
			return deferred;
		}
		else {
			$.ajax({
				type: "POST",
				url: "@Url.Action("CheckOrgUnitDetails", "TemporaryPosition")?OrgUnitNumber=" + $("#OrgUnitNumber").val(),
				success: function (content) {
					if (content.orgUnitNo.OrgUnitNumber != null) {
						$("#OrgUnitNumber").val(content.orgUnitNo.OrgUnitNumber);
						$("#Division").val(content.orgUnitNo.DivisionCode + " - " + content.orgUnitNo.Division);
						$("#PersonnelArea").val(content.orgUnitNo.PersonnelAreaCode + " - " + content.orgUnitNo.PersonnelArea);
						$("#PersonnelSubArea").val(content.orgUnitNo.PersonnelSubAreaCode + " - " + content.orgUnitNo.PersonnelSubArea);
						$("#DivisionCode").val(content.orgUnitNo.DivisionCode);
						$("#PersonnelAreaCode").val(content.orgUnitNo.PersonnelAreaCode);
						$("#PersonnelSubAreaCode").val(content.orgUnitNo.PersonnelSubAreaCode);
						$("#btnOrgUnitNumber").prop("disabled", false);
					}
					else {
						errorMessage += "- Org Unit Number (EHRMS) is invalid. \n";
						console.log(errorMessage);
					}

					if (errorMessage != "") {
						alert(errorMessage);
						deferred.reject();
					}
					else {
						deferred.resolve();
					}
				},
				error: function (err) {
					console.log(err);
					alert("Error in the ajax call.");
				}
			});
		}
		return deferred;
	}

