@using TemporaryPosition
@model LeaveQuota.Models.FilterModel
@{
    ViewBag.Title = "Temporary Position Intray";
}
 
<style>
    #filterForm .form-group {
        margin-bottom: 5px;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Temporary Position: My In Tray Listing
        </h1>
    </div>
</div>
<br />

<div class="row">
    <div class="col-md-12">
        <form id="filterForm">
            <div class="form-horizontal">
                <div class="form-body position-form">
                    <div class="form-group">
                        <label class="col-md-2 control-label">Position Category</label>
                        <div class="col-md-4 form-control-static">
                            <select id="PositionCategory" name="PositionCategory" class="form-control">
                                <option value="">ALL</option>
                            @foreach (var position in Service.GetTemporaryPositionCategory())
							{
								string value = position.TitleValue;
                                <option value="@value">@position.Title </option>
							}
                                </select>
                            @*<select id="PositionCategory" name="PositionCategory" class="form-control">
                                <option value="">ALL</option>
                                <option value="TP-As">Assignment (TP-As)</option>
                                <option value="TP-EC">End of Contract (TP-EC)</option>
                                <option value="TP-IS">Interim Structure (TP-IS)</option>
                                <option value="TP-LD">Light Duty (TP-LD)</option>
                                <option value="TP-Rs">Resignation (TP-Rs)</option>
                                <option value="TP-Rt">Retirement (TP-Rt)</option>
                                <option value="TP-Sc">Secondment (TP-Sc)</option>
                                <option value="TP-SL">Study Leave (TP-SL)</option>
                                <option value="TP-Tf">Transfer (TP-Tf)</option>
                            </select>*@
                        </div>
                        <label class="col-md-2 control-label">Status</label>
                        <div class="col-md-4">
                            <select class="form-control" name="Status">
                                    <option value="">ALL</option>
                                @foreach(var status in Service.GetTemporaryPositionStatus())
                                {
                                    string value = status.StatusCode;
                                    <option value="@value">@status.StatusName</option>
                                }                                
                            </select>

                            @*<select class="form-control" name="Status">
                                <option value="">ALL</option>
                                <option value="PE">Pending</option>
                                <option value="AG">Agreed</option>
                                <option value="AP">Approved</option>
                                <option value="DE">Declined</option>
                                <option value="PU">Position Created</option>
                            </select>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-2 control-label">Employee</label>
                        <div class="col-md-4">
                            <input class="form-control" id="Employee" name="Employee" />
                        </div>
                        <label class="col-md-2 control-label">Job Text</label>
                        <div class="col-md-4">
                            <input class="form-control" id="JobText" name="JobText" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-2 control-label">Position Text</label>
                        <div class="col-md-4">
                            <input class="form-control" id="PositionText" name="PositionText" />
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
    <div class="col-md-12">
        <div class="text-right">
            <a id="btn-Search" class="btn green btn-Search" value="Search" onclick="GetIntray();">Search</a>
        </div>
    </div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
    <div class="col-md-12">
        <div id="SearchResult">

        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        GetIntray();
    });

    function GetIntray() {

        $("#SearchResult").html("LOADING...");
        $.ajax({
            type: "GET",
            cache: false,
            url: '@Url.Content("~/TemporaryPosition/_RequestIntrayResult")',
            data: $("#filterForm").serialize(),
            success: function (listingContent) {

                $("#SearchResult").empty().append(listingContent);
            },
            error: function (err) {

                console.log(err);
            }
        });
    }
</script>