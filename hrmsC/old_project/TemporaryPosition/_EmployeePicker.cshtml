@{
	Layout = null;
}

<div class="row" onkeypress="return event.keyCode!=13;">
	<div class="col-md-12">
		<div class="form-horizontal">
			<div class="form-body">
				<div class="form-group">
					<label class="control-label col-md-2 ">
						Employee Number
					</label>
					<div class="col-md-4 form-control-static">
						<input type="text" id="txtEmpCodeSearchEmployee" />
					</div>
					<label class="control-label col-md-2 ">
						Employee Name
					</label>
					<div class="col-md-4  form-control-static">
						<input type="text" id="txtEmpNameSearchEmployee" />
					</div>
				</div>
				<div class="form-group ">
					<div class="text-right">
						<input id="btn-Search" type="button" value="Search" class="btn green btn-Search" onclick="SearchPPForEmployee();">
					</div>
				</div>
			</div>
			<br />
			<div id="EmployeePeoplePickerResult">

			</div>
		</div>
	</div>
</div>
<script type="text/javascript">
	function SearchPPForEmployee() {
        var _EmpCode = $('#txtEmpCodeSearchEmployee').val();
        var _EmpName = $('#txtEmpNameSearchEmployee').val();
 
        var data = {
            EmpCode: _EmpCode,
			EmpName: _EmpName,
			Employee: GetEmployee()
        };

        $("#EmployeePeoplePickerResult").html("LOADING...");
        $.post('@Url.Action("_EmployeePickerResult", "TemporaryPosition")', data, function (content) {
			$("#EmployeePeoplePickerResult").html(content);
        });
    }
</script>
