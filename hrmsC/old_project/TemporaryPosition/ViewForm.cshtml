@model TemporaryPosition.Models.TemporaryPositionForm
@{
	string color = "green";
	if (Model.StatusText == "Declined")
	{
		color = "red";
	}
}
<!--Position Details-->

<div id="positionForm">
	<div class="row">
		<div class="col-md-12">
			<div class="portlet box blue">
				<div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>
				<div class="portlet-title">
					<div class="caption">
						<i class="fa fa-reorder"></i>Application Details
					</div>
					<div class="tools">
						<a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
					</div>
				</div>

				<div class="portlet-body form">
					<div class="form-horizontal">
						<div class="position-form">
							<div class="form-body">
								<!--Current Status-->
								<div class="form-group">
									<label class="control-label col-md-2">
										Reference No
									</label>
									<div class="col-md-4 form-control-static">
										<label>@Model.ReferenceNo</label>
									</div>
									<label class="control-label col-md-2">
										Current Status
									</label>
									<div class="col-md-4 form-control-static">
										<label style="color: @color; font-weight: bold">@Model.StatusText</label>
									</div>
								</div>
								<div class="form-group">
									<label class="control-label col-md-2">
										Agreer/Approver
									</label>
									<div class="col-md-4 form-control-static">
										<label>@ViewBag.Approver</label>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-md-12">
			<div class="portlet box blue">
				<div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>
				<div class="portlet-title">
					<div class="caption">
						<i class="fa fa-reorder"></i>Position Details
					</div>
					<div class="tools">
						<a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
					</div>
				</div>
				<div class="portlet-body form">
					<div class="form-horizontal">
						<div class="position-form">
							<div class="form-body">
								@Html.Partial("_OrgUnitNumberInit", Model)

								<!--Position Category-->
								<div class="form-group">
									<label class="control-label col-md-2">
										Position Category
										<span style="color:red">*</span>
									</label>
									<div class="col-md-4">
										<input type="text" class="form-control" id="PositionCategory" name="PositionCategory" value="@Model.PositionCategoryText (@Model.PositionCategory)" readonly="" />
									</div>

									@if (Model.StatusText == "Position Created" || Model.StatusCode == "PU")
									{
										<label class="control-label col-md-2">
											Position No
										</label>
										<div class="col-md-4">
											<input type="text" class="form-control" id="PositionNo" name="PositionNo" value="@Model.NewPositionNo" readonly="" />
										</div>
									}
								</div>

								<!--Position Text-->
								<div class="form-group">
									<label class="control-label col-md-2">
										Position Text
										<span style="color:red">*</span>
									</label>
									<div class="col-md-4">
										<input type="text" class="form-control" id="PositionText" name="PositionText" value="@Model.PositionText" readonly="" />
									</div>
									<label class="control-label col-md-2">
										Effective Date
										<span style="color:red">*</span>
									</label>
									<div class="col-md-4">
										<input type="text" class="form-control" id="EffectiveDate" name="EffectiveDate" value="@Model.EffectiveDate" readonly="" />
									</div>
								</div>

								<!--Job Text-->
								<div class="form-group">
									<label class="control-label col-md-2">
										Job Text
										<span style="color:red">*</span>
									</label>
									<div class="col-md-4">
										<input type="text" class="form-control" id="JobText" name="JobText" value="@Model.JobText" readonly="" />
									</div>
									<label class="control-label col-md-2">
										Delimit Date
										<span style="color:red">*</span>
									</label>
									<div class="col-md-4">
										<input type="text" class="form-control" id="DelimitDate" name="DelimitDate" value="@Model.DelimitDate" readonly="" />
									</div>
								</div>

								<!--Reason for Creation-->
								<div class="form-group">
									<label class="control-label col-md-2" for="form-group-input">
										Reason for Creation of Position
										<span style="color:red">*</span>
									</label>
									<div class="col-md-10">
										<textarea class="form-control" maxlength="500" rows="5" name="Reason" id="Reason" readonly="">@Model.Reason</textarea>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!--Employee-->
	@Html.Partial("_Employee")

	<!--Supervisor Details-->
	<div class="row">
		<div class="col-md-12">
			<div class="portlet box blue">
				<div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>
				<div class="portlet-title">
					<div class="caption">
						<i class="fa fa-reorder"></i>IM Details
					</div>
					<div class="tools">
						<a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
					</div>
				</div>
				<div class="portlet-body form">
					<div class="form-horizontal">
						<div class="position-form">
							<div class="form-body">
								<div class="form-group">
									<label class="control-label col-md-2">
										IM
										<span style="color:red">*</span>
									</label>
									<div class="col-md-4">
										<input class="form-control" id="txtSupervisorID" value="@(Model.SupervisorDetails != null ? Model.SupervisorDetails.EmployeeCode + " - " + Model.SupervisorDetails.EmployeeName : "")" name="txtSupervisorID" readonly="" />
										<input class="form-control" type="hidden" id="SupervisorID" value="@Model.SupervisorID" name="SupervisorID" />
									</div>

									<label class="control-label col-md-2">
										Position
										<span style="color:red">*</span>
									</label>
									<div class="col-md-4">
										<input class="form-control" id="Position" value="@Model.SupervisorDetails.PositionCode - @Model.SupervisorDetails.Position" name="Position" readonly="" />
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	@Html.Action("AttachmentControl", "Attachment", new { EmployeeID = Model.EmployeeID, Mode = "View", SourceType = "TemporaryPosition", RequestID = Model.PositionID })

	@if (Model.StatusText != "Draft")
	{
		@Html.Action("_ApproverSection", "TemporaryPosition")
	}

</div>

