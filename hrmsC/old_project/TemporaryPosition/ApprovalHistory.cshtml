@using TemporaryPosition
@{
    ViewBag.Title = "Temporary Position Approval History";


    string defaultStartDate = DateTime.Today.AddDays(-90).ToString("dd/MM/yyyy");
    string defaultEndDate = DateTime.Today.ToString("dd/MM/yyyy");

    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");
}
<style>
	.position-form .form-group {
		margin-bottom: 6px;
	}
</style>
<div class="row">
	<div class="col-md-12">
		<br />
		<h1 class="page-title">
			Temporary Position: My Approval History
		</h1>
	</div>
</div>
<br />

<div class="row">
	<div class="col-md-12">
		<form id="filterForm">
			<div class="form-horizontal">
                <div class="form-body position-form">
                    <div class="form-group">
                        <label class="col-md-2 control-label">Action Date (From)</label>
                        <div class="col-md-4 form-control-static">
                            <div id="StartDatePicker" class="input-group date date-picker" data-date-format="dd MM yyyy">
                                <input type="text" class="form-control" id="DateFrom" name="DateFrom" />
                                <span class="input-group-btn">
                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                </span>
                            </div>
                        </div>
                        <label class="col-md-2 control-label">Action Date (To)</label>
                        <div class="col-md-4 form-control-static">
                            <div id="EndDatePicker" class="input-group date date-picker toDate" data-date-format="dd MM yyyy">
                                <input type="text" class="form-control" id="DateTo" name="DateTo" />
                                <span class="input-group-btn">
                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-2 control-label">Position Category</label>
                        <div class="col-md-4 form-control-static">
                            <select id="PositionCategory" name="PositionCategory" class="form-control">
                                <option value="">ALL</option>
                                @foreach (var position in Service.GetTemporaryPositionCategory())
                                {
                                    string value = position.DisplayTitle;
                                    <option value="@value">@position.DisplayTitle</option>
                                }
                            </select>
                        </div>
                        <label class="col-md-2 control-label">Action</label>
                        <div class="col-md-4">
                            <select class="form-control" name="ApproverAction">
                                <option value="">ALL</option>
                                <option value="Verified">Verified</option>
                                <option value="Approved">Approved</option>
                                <option value="Declined">Declined</option>
                                <option value="Position Created">Position Created</option>
                            </select>
                        </div>
                        @*<label class="col-md-2 control-label">Status</label>
                        <div class="col-md-4">
                            <select class="form-control" name="Status">
                                <option value="">ALL</option>
                                @foreach (var status in Service.GetTemporaryPositionStatus())
                                {
                                    string value = status.StatusCode;
                                    <option value="@value">@status.StatusName</option>
                                }
                            </select>
                        </div>*@
                    </div>
                    <div class="form-group">
                        <label class="col-md-2 control-label">Employee</label>
                        <div class="col-md-4">
                            <input class="form-control" id="Employee" name="Employee" />
                        </div>
                        <label class="col-md-2 control-label">Job Text</label>
                        <div class="col-md-4">
                            <input class="form-control" id="JobText" name="JobText" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-2 control-label">Position Text</label>
                        <div class="col-md-4">
                            <input class="form-control" id="PositionText" name="PositionText" />
                        </div>
                        
                    </div>
                </div>
			</div>
		</form>
	</div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
	<div class="col-md-12">
		<div class="text-right">
			<a id="btn-Search" class="btn green btn-Search" value="Search" onclick="GetIntray();">Search</a>
		</div>
	</div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
	<div class="col-md-12">
		<div id="SearchResult">

		</div>
	</div>
</div>
<script>

    $(document).ready(function () {
        GetIntray();
    });

    function GetIntray() {

        $("#SearchResult").html("LOADING...");
        $.ajax({
            type: "GET",
            cache: false,
            url: '@Url.Content("~/TemporaryPosition/_ApprovalHistoryResult")',
            data: $("#filterForm").serialize(),
            success: function (listingContent) {

                $("#SearchResult").empty().append(listingContent);
            },
            error: function (err) {

                console.log(err);
            }
        });
    }

        jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
            });
        $('#StartDatePicker').datepicker("setDate", '@defaultStartDate');
        $('#EndDatePicker').datepicker("setDate", '@defaultEndDate');
        });
</script>