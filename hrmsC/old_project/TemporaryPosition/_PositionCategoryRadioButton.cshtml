@using TemporaryPosition.Models
@model Tuple<TemporaryPositionForm, PositionCategory>
@{
	Layout = null;
	var form = Model.Item1;
	var position = Model.Item2;
}
<style>
	.subtype-info-icon {
		font-size: 15px !important;
		position: relative !important;
		float: right !important;
		margin-left: 20px !important;
	}

	.popover {
		max-width: 800px !important;
	}
</style>
<div class="col-md-12">
	<label class="popovers" style="display : inline-block;" ;
		   data-trigger="hover"
		   data-html="true"
		   data-container="body"
		   data-placement="right"
		   data-content="@position.TitleDescription">
		<input type="radio" name="PositionCategory"
			   value="@position.TitleValue" @(Model != null && position.TitleValue == form.PositionCategory ? "checked=checked" : "")
			   category ="@position.Category"
			   note="@position.AttachmentDescription" @(Model != null && form.IsEditable ? "" : "disabled=disabled")> @position.DisplayTitle
		</label>
	</div>