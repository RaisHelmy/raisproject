@model List<TemporaryPosition.Models.Employee>
@{
	Layout = null;
}
<div class="table-toolbar">
	<table id="tblEmployeePicker" class="table table-striped table-bordered table-hover table-full-width">
		<thead>
			<tr>
				<th></th>
				<th>Employee</th>
				<th>Employee Grade</th>
				<th>IM</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in @Model)
			{
				<tr>
					<td><input type="checkbox" class="MultiPeoplePickerCheckbox" value="@item.EmployeeID" emp="@item.EmployeeDisplayName" empGrade="@item.EmployeeGrade" manager="@item.ManagerDisplayName" /></td>
					<td class="Employee">@item.EmployeeDisplayName</td>
					<td class="EmployeeGrade">@item.EmployeeGrade</td>
					<td class="IM">@item.ManagerDisplayName</td>
				</tr>
			}
		</tbody>
	</table>
</div>
@Html.Partial("_includeDataTableScripts")
<script>
	transformTable("#tblEmployeePicker");
</script>

