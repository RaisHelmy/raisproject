@model IEnumerable<TemporaryPosition.Models.TemporaryPositionForm>
@using TemporaryPosition.Models
@{
	Layout = null;
}

<style>
    td.wordWrap {
        white-space: normal !important;
        word-break: break-word !important;
        min-width: 300px;
    }
</style>

<div class="portlet box blue">
	<div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>
	<div class="portlet-title">
		<div class="caption">
			<i class="fa fa-reorder"></i>Request Listing
		</div>
	</div>

	<div class="portlet-body form">
		<div class="form-body">
			<div class="form-horizontal">
				<table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
					<thead>
						<tr>
							<th></th>
							<th>Request Ref. No</th>
							<th>Position Category</th>
							<th>Position Text</th>
							<th>Job Text</th>
							@*<th>Job Grade</th>*@
							<th>Employee</th>
							<th>Effective Date</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							string color = "green";
							if (item.StatusText == "Declined" || item.StatusText == "Withdrawn")
							{
								color = "red";
							}
							<tr>
								<td>
									<a class="btn btn-primary" href="@Url.Action("Edit", "TemporaryPosition")?ID=@item.PositionID">
										<i class="fa fa-edit"></i>
									</a>
								</td>
								<td>@item.ReferenceNo</td>
								<td>@item.PositionCategoryText (@item.PositionCategory)</td>
								<td>@item.PositionText</td>
								<td class="wordWrap">@item.JobText</td>
								@*<td>@item.JobGrade</td>*@
								<td>
									@if (!string.IsNullOrEmpty(item.Employees))
									{
										var split_string = item.Employees.Split('*');
										foreach (var emp in split_string)
										{
											@emp <br />
										}
									}
								</td>
								<td>@item.EffectiveDate</td>
								<td style="color: @color; font-weight: bold">@item.StatusText</td>
							</tr>
						}
					</tbody>
				</table>

			</div>
		</div>
	</div>
</div>

<script>
	$('#tblResult').dataTable({
		"aLengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]]
	});

	var tableWrapper = "#tblResult_wrapper";

	jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
	jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
	jQuery(tableWrapper + ' .dataTables_length select').select2({
		showSearchInput: false //hide search box with special css class
	});
</script>