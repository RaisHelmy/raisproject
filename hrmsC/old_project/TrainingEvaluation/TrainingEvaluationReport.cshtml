@model List<ESS.Core.DropDownObject>
@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Training Evaluation Report";
}
<script src="~/Assets/jquery-unified-export-file-1.0.min.js" type="text/javascript"></script>
<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Training Evaluation Report<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
@*Search*@
<div class="form-body" id="hello">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Form Ref. No. <span id="lvTypeMan" style="color:red;"> *</span></label>
                    <div class="col-md-8 form-control-static">
                        <div class=" input-group ">
                            <input type="text" class="form-control" id="FormReferenceNo" readonly />
                            <input type="hidden" class="form-control" id="EvaluationID" readonly />
                            <span class="input-group-btn" style="">
                                <a data-toggle="modal" href="#FormPicker" class="btn default"><i class="fa fa-files-o"></i></a>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Assessment By</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="AssessmentBy">
                            <option value="1">Attendee</option>
                            <option value="2">IM</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" id="EmployeeName" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Start Date</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" id="StartDate" readonly/>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">End Date</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" id="EndDate" readonly/>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Course Title</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" id="CourseTitle" readonly/>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="View Report" onclick="SearchListing();">
                <input type="button" id="btn-Export" class="btn green btn-Export" value="Export To Excel" onclick="ExportToExcel();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="FormPicker" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Form Picker</h4>
            </div>
            <div class="modal-body">
                <div>
                    @Html.Action("FormPicker", "TrainingEvaluation")
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default green" onclick="SetSelectedForm()">Select</button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function ExportToExcel() {
        var _AssessmentBy = $('#AssessmentBy').val();
        var _EvaluationID = $('#EvaluationID').val();
        var _EmployeeName = $('#EmployeeName').val();
        window.open("../TrainingEvaluation/ExportToExcel?Assessment=" + _AssessmentBy + "&EvaluationID=" + _EvaluationID + "&EmployeeName=" + _EmployeeName);
    }

    function SearchListing() {
        var _AssessmentBy = $('#AssessmentBy').val();
        var _EvaluationID = $('#EvaluationID').val();
        var _EmployeeName = $('#EmployeeName').val();

        if (_EvaluationID == "") {
            alert('Form Reference No is required.');
            return false;
        }

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TrainingEvaluation/GenerateEvaluationReport")',
            cache: false,
            dataType: "html",
            data: { Assessment: _AssessmentBy, EvaluationID: _EvaluationID, EmployeeName: _EmployeeName },
            success: function (content) {
                content += "<script>$('.table1').dataTable({";
                content += "\"bLengthChange\": false,";
                content += "\"bFilter\": false,";
                content += "\"bPaginate\": false,";
                content += "\"bInfo\": false,";
                content += "\"scrollX\": true,";
                content += "\"bSortable\": false,});";
                content += "<\/script>";
                //content += "<script>transformTable(\".table\");<\/script>";
                $("#SearchResult").html(content);

                if (content != "no record found.") {
                    GenerateChart();
                }
            },
            error: function (e) {
                console.log(e);
            }
        });
        //transformTable("#tblResult");
    }
    function SetSelectedForm() {
        $("#tblFormPickerResult td input[type=radio]").each(function () {
            var _selected = $(this).prop("checked");

            if (_selected) {
                $("#FormReferenceNo").val($(this).val());
                $("#EvaluationID").val($(this).attr("EvalID"));
                $("#StartDate").val($(this).attr("EvalStartDt"));
                $("#EndDate").val($(this).attr("EvalEndDt"));
                $("#CourseTitle").val($(this).attr("EvalCourseNm"));
             
                $('#FormPicker').modal('toggle');
            }
        });
    }

    function GenerateChart() {
        //window.open("../TrainingEvaluation/Chart?EvaluationID=" + $('#EvaluationID').val());
        var _EvaluationID = $('#EvaluationID').val();

        $("#Chart").html("");
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TrainingEvaluation/_TrainingEvaluationReportResultChart")',
            //url: '@Url.Content("~/TrainingEvaluation/Chart")',
            cache: false,
            dataType: "html",
            data: { EvaluationID: _EvaluationID  },
            success: function (content) {
                $("#Chart").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>