@model Tuple<List<ESS.Core.DropDownObject>, ESS.Core.EvaluationForm_1>  
@{
    ViewBag.Title = "Evaluation Form";
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Evaluation Form
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>

@using (Html.BeginForm("", "TrainingEvaluation", FormMethod.Post, new { @class = "form-horizontal", @id = "MainForm" }))
{
    <input id="hfEmployeeID" type="hidden" value="@ViewBag.EmployeeID" />
    
    @*<input id="hfEmployeeID" type="hidden" value="211084BA-1F90-4A6C-A710-070C29844A48" />*@
    <input id="hfEvaluationID" type="hidden" value="@Model.Item2.EvaluationID" />

    //Step 1 to Step 4
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-2 col-sm-2 col-xs-2">
                <b>Training Details </b>
            </div>
            <div class="col-md-1 col-sm-1 col-xs-1">
                <img src="/_layouts/tnbess/ui/silver_arrow.png" />
            </div>
            <div class="col-md-2 col-sm-2 col-xs-2">
                Select Questions
            </div>
            <div class="col-md-1 col-sm-1 col-xs-1">
                <img src="/_layouts/tnbess/ui/silver_arrow.png" />
            </div>
            <div class="col-md-2 col-sm-2 col-xs-2">
                Select Attendees
            </div>
            <div class="col-md-1 col-sm-1 col-xs-1">
                <img src="/_layouts/tnbess/ui/silver_arrow.png" />
            </div>
            <div class="col-md-1 col-sm-1 col-xs-1">
                Preview
            </div>
        </div>
    </div>
    <br/>

    //Training Course Details
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Training Course Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct01_CustomFieldFormView">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Evaluation Category <span id="lvTypeMan" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            @Html.DropDownList("EvaluationCategory", new SelectList(Model.Item1, "Value", "Text"), "- Select One -", new { @class = "bs-select form-control" })
                                            @*<select class="bs-select form-control" id="EvaluationCategory" name="EvaluationCategory">
                                                <option value="">- Select One -</option>
                                                <option value="1">Executive Development Programme (EDP)</option>
                                                <option value="2">Management Courses</option>
                                                <option value="3">Technical Courses</option>
                                                <option value="4">Talent Programme</option>
                                                <option value="5">New Executive Program</option>
                                                <option value="6">Specialist</option>
                                            </select>*@
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Title <span id="lvTypeMan" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            @Html.Partial("_CoursePickerEvaluation", new ViewDataDictionary { { "Mode", "" }, { "CourseTitle", Model.Item2.CourseTitle } })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Session ID
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            @Html.TextBoxFor(m => m.Item2.CourseSessionID, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Training Category
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            @Html.TextBoxFor(m => m.Item2.TrainingCategoryDesc, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Training Type
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            @Html.TextBoxFor(m => m.Item2.TrainingTypeDesc, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            Start Date
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            @Html.TextBoxFor(m => m.Item2.StartDate, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            End Date
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            @Html.TextBoxFor(m => m.Item2.EndDate, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Venue
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            @Html.TextBoxFor(m => m.Item2.CourseVenue, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Provider
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            @Html.TextBoxFor(m => m.Item2.CourseProvider, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Evaluation Form Name <span id="lvTypeMan" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-9 form-control-static">
                                            @Html.TextBoxFor(m => m.Item2.EvaluationTitle, new { @class = "form-control" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <input type="button" class="btn green" value="Save as Draft" id="btnSaveAsDraft" onclick="Validation('Draft')" />
    <input type="button" class="btn green" value="Next" id="btnAttach" onclick="Validation('Next')" />
    if (!string.IsNullOrEmpty(Model.Item2.EvaluationID))
    {
        <input type="button" class="btn green" value="Delete" id="btnDelete" onclick="Validation('Delete')" />
    }
    <input type="button" class="btn green" value="Close" id="btnClose" onclick="Validation('Close')" />

     <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmUpdate" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Submit this Evaluation Form?\n\rPress Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmitDraft" value="Draft" onclick="javascript: SaveForm('Draft');">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well">
                        Your Evaluation Form has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <button type="button" class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
        </p>
    </div>
}

<script>
    var SubmitStatus = "";

    $(document).ready(function () {
        $("#EvaluationCategory").val('@Model.Item2.EvaluationCategoryCode');
        $("#hfCourseID").val('@Model.Item2.CourseID');
        $("#hfCourseSessionID").val('@Model.Item2.CourseSessionID');
    });

    function Validation(_Action) {
        var TrainingCategory;
        var EvaluationFormTitle;
        var CPCourseTitle;
        var ErrorMsg = "";

        TrainingCategory = $("#EvaluationCategory").val();
        EvaluationFormTitle = $("#Item2_EvaluationTitle").val();
        CPCourseTitle = $("#CPCourseTitle").val();

        if (TrainingCategory == "" && (_Action == "Next" || _Action == "Draft")) {
            ErrorMsg += "Please select an evaluation category\n";
        }

        if (CPCourseTitle == "" && _Action == "Next") {
            ErrorMsg += "Please select a course\n";
        }

        if (EvaluationFormTitle == "" && _Action == "Next") {
            ErrorMsg += "Evaluation Form Name is required\n";
        }



        if (ErrorMsg != "") {
            alert(ErrorMsg);
        } else {
            if (_Action == "Draft") {
                $('.modal-body .well').html('Are you sure you want to Save this Evaluation Form?\n\rPress Confirm to proceed, or Close to stay on the current page.');
                $('#btnOK').click(function () { RedirectTo('Draft'); });
                $('#ConfirmUpdate').modal('show');
            }
            else if (_Action == "Next") {
                $("#divLoading").css("display", "block");
                var myVar = setTimeout(SubmitNext, 1000);
            }
            else if (_Action == "Delete") {
                $("#btnSubmitDraft").attr("onclick", "SaveForm('" + _Action + "')");
                $('.modal-body .well').html('Are you sure you want to Delete this Evaluation Form?\n\rPress Confirm to proceed, or Close to stay on the current page.');
                $('#btnOK').click(function () { RedirectTo('Delete'); });
                $('#ConfirmUpdate').modal('show');
            }
            else if (_Action == "Close") {
                window.location.replace("/_layouts/15/essv2/TrainingEvaluation/EvaluationFormHistory");
            }
        }
    }

    function SaveForm(_Status) {
        $("#ConfirmUpdate").modal('toggle');
        $("#divLoading").css("display", "block");
        SubmitStatus = _Status;
        var myVar = setTimeout(SubmitFormAction, 1000);
    }

    function SubmitNext() {
        var form = {
            EvaluationCategoryCode: $("#EvaluationCategory").val(),
            EvaluationCategoryDesc: $( "#EvaluationCategory option:selected" ).text(),
            CourseID: $("#hfCourseID").val(),
            CourseSessionID: $("#hfCourseSessionID").val(),
            EvaluationTitle: $("#Item2_EvaluationTitle").val(),
            EmployeeID: $("#hfEmployeeID").val(),
            EvaluationID: $("#hfEvaluationID").val()
        };
        $.ajax({
            url: '@Url.Content("~/TrainingEvaluation/PerformInsertEvaluationForm")',
            type: 'POST',
            cache: false,
            async: false,
            dataType: "json",
            data: form,
            success: function (result) {
                if (result.Success) {
                    //$("#divLoading").css("display", "none");
                    window.location.replace("/_layouts/15/essv2/TrainingEvaluation/EvaluationForm2?EvaluationID=" + result.EvaluationID);
                } else {
                    $("#divLoading").css("display", "none");
                    alert(result.ErrorMsg);
                }
            },
            error: function (x, y, z) {
                $("#divLoading").css("display", "none");
                console.log(x + '\n' + y + '\n' + z);
            }
        });
    }

    function SubmitDelete() {
        $.ajax({
            url: '@Url.Content("~/TrainingEvaluation/PerformDeleteEvaluationForm")',
            type: 'POST',
            cache: false,
            async: false,
            dataType: "json",
            data: { EvaluationID: $("#hfEvaluationID").val() },
            success: function (result) {
                if (result.Success) {
                    $("#divLoading").css("display", "none");
                    $("#SuccessSubmit").modal();
                } else {
                    $("#divLoading").css("display", "none");
                    alert(result.ErrorMsg);
                    console.log(result.ErrorMsg);
                }
            },
            error: function (x, y, z) {
                $("#divLoading").css("display", "none");
                console.log(x + '\n' + y + '\n' + z);
            }
        });
    }

    function SubmitFormAction() {
        if (SubmitStatus == 'Draft') {
            $(".Success-body .well").html('Your Evaluation Form has been successfully saved.');
        }
        else if (SubmitStatus == 'Delete') {
            $(".Success-body .well").html('Your Evaluation Form  has been successfully Deleted.');
        }
        else {
            $(".Success-body .well").html('Your Evaluation Form  has been successfully submitted.');
        }

        if (SubmitStatus == 'Draft') {
            var form = {
                EvaluationCategoryCode: $("#EvaluationCategory").val(),
                EvaluationCategoryDesc: $("#EvaluationCategory option:selected").text(),
                CourseID: $("#hfCourseID").val(),
                CourseSessionID: $("#hfCourseSessionID").val(),
                EvaluationTitle: $("#Item2_EvaluationTitle").val(),
                EmployeeID: $("#hfEmployeeID").val(),
                EvaluationID: $("#hfEvaluationID").val()
            };
            $.ajax({
                url: '@Url.Content("~/TrainingEvaluation/PerformInsertEvaluationForm")',
                type: 'POST',
                cache: false,
                async: false,
                dataType: "json",
                data: form,
                success: function (result) {
                    if (result.Success) {
                        $("#divLoading").css("display", "none");
                        $("#SuccessSubmit").modal();
                    } else {
                        $("#divLoading").css("display", "none");
                        alert(result.ErrorMsg);
                    }
                },
                error: function (x, y, z) {
                    $("#divLoading").css("display", "none");
                    console.log(x + '\n' + y + '\n' + z);
                }
            });
        }
        else if (SubmitStatus == "Delete") {
            SubmitDelete();
        }
    }


    function RedirectTo(_Action) {

        switch (_Action) {
            case "Draft":
                window.location.href = '/_layouts/15/essv2/TrainingEvaluation/EvaluationForm';
                break;
            case "Submit":
                window.location.href = '/_layouts/15/essv2/TrainingEvaluation/EvaluationFormHistory';
                break;
            case "Delete":
                window.location.href = '/_layouts/15/essv2/TrainingEvaluation/EvaluationForm';
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }
</script>

