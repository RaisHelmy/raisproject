@model Tuple<ESS.Core.EvaluationForm_1, List<ESS.Core.EvaluationForm_2_Section>, List<SEP.RoutingManagement.Service.AllowAction>>  
@{
    ViewBag.Title = "Training Evaluation Form";
    var showTotal = "false";
    if(Model.Item1.StatusCode == "Completed")
    {
        showTotal = "true";
    }
    var FromSource = ViewBag.FromSource;
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Evaluation Form
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
@using (Html.BeginForm("", "TrainingEvaluation", FormMethod.Post, new { @class = "form-horizontal", @id = "MainForm" }))
{
    <input id="hfEvaluationID" type="hidden" value="@Model.Item1.EvaluationID" />
    <input id="hfEvaluationRecipientID" type="hidden" value="@ViewBag.EvaluationRecipientID"/>
    <input id="hfTaskID" type="hidden" value="@ViewBag.TaskID"/>

    //Requestor Details
    @Html.Action("_RequestorDetails", "TrainingEvaluation", new { RequestorID = ViewBag.RecipientID })

    //Training Course Details
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Training Course Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct01_CustomFieldFormView">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            Form Reference No.
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            <input class="form-control" type="text" id="ReferenceNo" value="@Model.Item1.EvaluationFormNo" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            Form Status
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            <input class="form-control" type="text" id="Status" value="@Model.Item1.StatusCode" style="color:#22BB22;font-weight: bold;" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Evaluation Category 
                                        </label>
                                        <div class="col-md-9 form-control-static">
                                            <input class="form-control" type="text" id="EvaluationCategory" value="@Model.Item1.EvaluationCategoryDesc" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Title
                                        </label>
                                        <div class="col-md-9 form-control-static">
                                            <input class="form-control" type="text" id="CourseTitle" value="@Model.Item1.CourseTitle" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Session ID
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="SessionID" value="@Model.Item1.CourseSessionID" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Training Category
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="TrainingCategory" value="@Model.Item1.TrainingCategoryDesc" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Training Type
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="TrainingType" value="@Model.Item1.TrainingTypeDesc" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            Start Date
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            <input class="form-control" type="text" id="StartDate" value="@Model.Item1.StartDate" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            End Date
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            <input class="form-control" type="text" id="EndDate" value="@Model.Item1.EndDate" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Venue
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="CourseVenue" value="@Model.Item1.CourseVenue" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Provider
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="CourseProvider" value="@Model.Item1.CourseProvider" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Evaluation Form Name
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="EvaluationFormName" value="@Model.Item1.EvaluationTitle" readonly/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    //Audit Trail
    @Html.Action("_TrainingEvaluationWorkflowHistory", "TrainingEvaluation", new { ID = ViewBag.EvaluationRecipientID })

    //Description
    @Html.Action("_ScaleRating", "TrainingEvaluation", new { EvaluationID = Model.Item1.EvaluationID })

    //View Question
    foreach (var m in Model.Item2)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Section: @m.EvaluationCategoryDesc
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body" id="ct00_CustomFieldFormView">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-1">
                                                Remarks:
                                            </label>
                                            <div class="col-md-11 form-control-static">
                                                @m.Remarks
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <div class="col-md-12" id="SectionQuestionListResult">
                                                @Html.Action("_EvaluationSectionQuestionListRadio", "TrainingEvaluation", new { EvaluationID = m.EvaluationID, EvaluationSectionID = m.EvaluationSectionID, EvaluationCategoryDesc = m.EvaluationCategoryDesc, EvaluationRecipientID = ViewBag.EvaluationRecipientID, IsShowTotal = showTotal })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Remarks
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct00_CustomFieldFormView">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Remarks
                                        </label>
                                        <div class="col-md-10 form-control-static">
                                            <textarea class="form-control" id="Comment" rows="10" @ViewBag.ReadOnly>@Model.Item1.Remarks</textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    if (!string.IsNullOrEmpty(ViewBag.TaskID))
    {
        foreach (var m in Model.Item3)
        {
            if (m.CanApprove == "1")
            {
                <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="NextPreviousStep('Submit')" />
            }
        }
    }

    <input type="button" class="btn green" value="Close" id="btnClose" onclick="NextPreviousStep('Close')" />


    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmUpdate" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Delete this Evaluation Form?\n\rPress Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmit" value="Submit" onclick="javascript: ConfirmSubmit();">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well">
                        Your Evaluation Form has been successfully deleted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <button type="button" class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
        </p>
    </div>
}

<script>
    var SubmitStatus = "";

    function NextPreviousStep(_Action) {
        if (_Action == "Submit") {
            SubmitStatus = _Action;
            $('#btnOK').click(function () { RedirectTo('Submit'); });
            $('.modal-body .well').html('Are you sure you want to Submit this Evaluation Form?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#ConfirmUpdate').modal('show');
        }
        else if (_Action == "Close") {
            if ('@FromSource' == "MyTrainingEvaluation") {
                window.location.href = '/_layouts/15/essv2/TrainingEvaluation/MyTrainingEvaluation';
            } else if ('@FromSource' == "EvaluationFormTracking"){
                window.location.href = '/_layouts/15/essv2/TrainingEvaluation/EvaluationFormTracking';
            } else if ('@FromSource' == "MyInTray") {
                window.location.href = '/_layouts/15/essv2/MSS/TrainingEvaluationInTray';
            } else if ('@FromSource' == "FormTracking") {
                window.location.href = '/_layouts/15/essv2/TrainingEvaluation/FormTracking?EvaluationID=' + $("#hfEvaluationID").val();
            } else if ('@FromSource' == "EvalReport") {
                window.close();
            }
        }

    }

    function ConfirmSubmit() {
        $("#ConfirmUpdate").modal('toggle');
        $("#divLoading").css("display", "block");
        var myVar = setTimeout(Action, 1000);
    }

    function Action() {
        if (SubmitStatus == 'Submit') {
            $(".Success-body .well").html('Your Evaluation Form has been successfully submitted.');
        }
        //else if (SubmitStatus == 'Publish') {
        //    $(".Success-body .well").html('Your Evaluation Form  has been successfully published.');
        //}


        var _TotalQuestion = 0;
        var _TotalAnsweredQuestion=0;
        var _Remarks = $("#Comment").val();
        var _QuestionInfo = "";
        var _EvaluationRecipientID = $("#hfEvaluationRecipientID").val();
        var _TaskID = $("#hfTaskID").val();

        //get Total Question
        $(".hfTotalQuestion").each(function () {
            _TotalQuestion += parseInt($(this).val());
        });

        //get Total Answered Question
        $("input[type=radio]:checked").each(function () {
            //alert("here");
            _TotalAnsweredQuestion += 1;
            _QuestionInfo += $(this).attr("name") + "," + $(this).val() + ";";
        });

        _QuestionInfo = _QuestionInfo.slice(0, -1);

        if (_TotalQuestion != _TotalAnsweredQuestion) {
            $("#divLoading").css("display", "none");
            alert("Please select your rating.");
            return false;
        }

        //string QuestionInfo, string EvaluationRecipientID, string EvaluationID
        if (SubmitStatus == "Submit") {
            $.ajax({
                url: '@Url.Content("~/TrainingEvaluation/PerformSubmitEvaluationForm")',
                type: 'POST',
                cache: false,
                async: false,
                dataType: "json",
                data: { QuestionInfo: _QuestionInfo, EvaluationRecipientID: _EvaluationRecipientID, EvaluationID: $("#hfEvaluationID").val(), Remarks: _Remarks, TaskID: _TaskID },
                success: function (result) {
                    if (result.Success) {
                        $("#divLoading").css("display", "none");
                        $("#SuccessSubmit").modal();
                    } else {
                        $("#divLoading").css("display", "none");
                        alert(result.ErrorMsg);
                        console.log(result.ErrorMsg);
                    }
                },
                error: function (x, y, z) {
                    $("#divLoading").css("display", "none");
                    console.log(x + '\n' + y + '\n' + z);
                }
            });
        }
        @*else if (SubmitStatus == "Publish")
        {
            $.ajax({
                url: '@Url.Content("~/TrainingEvaluation/PerformPublishEvaluationForm")',
                type: 'POST',
                cache: false,
                async: false,
                dataType: "json",
                data: { EvaluationID: $("#hfEvaluationID").val() },
                success: function (result) {
                    if (result.Success) {
                        $("#divLoading").css("display", "none");
                        $("#SuccessSubmit").modal();
                    } else {
                        $("#divLoading").css("display", "none");
                        alert(result.ErrorMsg);
                        console.log(result.ErrorMsg);
                    }
                },
                error: function (x, y, z) {
                    $("#divLoading").css("display", "none");
                    console.log(x + '\n' + y + '\n' + z);
                }
            });
        }*@

    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "Submit":
                if ('@FromSource' == "MyTrainingEvaluation") {
                    window.location.href = '/_layouts/15/essv2/TrainingEvaluation/MyTrainingEvaluation';
                    break;
                }
                else if ('@FromSource' == "MyInTray")
                {
                    window.location.href = '/_layouts/15/essv2/MSS/TrainingEvaluationInTray';
                    break;
                }else {
                    window.location.href = '/_layouts/15/essv2/TrainingEvaluation/EvaluationForm';
                    break;
                }

            default:
                window.location.href = '/Pages/default.aspx';
        }
    }
</script>

