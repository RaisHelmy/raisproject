@model List<ESS.Core.CourseAttendeeSAP>
@{
    Layout = null;
}

<div class="table-toolbar">
    <table id="tblResult2" class="table table-striped table-bordered table-hover table-full-width">
        <thead>
            <tr>
                <th style="width:5%;">
                    <input class="DestroyUniform" type="checkbox" ID="chkSelectAllQuestion" name="chkSelectAllQuestion" value="" onclick="javascript: SelectMultiPplCheckboxes(this)">
                </th>
                <th>Attendees</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="DestroyUniform" ID="chkSelect" name="chkSelect" value="@item.EmployeeID" checked>
                    </td>
                    <td>@item.Employee</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function SelectMultiPplCheckboxes(headerchk) {
        var gvcheck = $("#tblResult2");
        var i;
        //Condition to check header checkbox selected or not if that is true checked all checkboxes
        if (headerchk.checked) {
            $.each(gvcheck.find('tbody tr'), function (index, value) {
                $(this).find('input').attr("checked","checked");
            });
        }
            //if condition fails uncheck all checkboxes in gridview
        else {
            $.each(gvcheck.find('tbody tr'), function (index, value) {
                $(this).find('input').removeAttr("checked");
            });
        }
    }
</script>
