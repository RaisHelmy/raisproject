@model Tuple<ESS.Core.EvaluationForm_1, List<ESS.Core.EvaluationForm_2_Section>>  
@{
    ViewBag.Title = "Evaluation Form";
    int x1 = 0;
    int x2 = 0;
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Evaluation Form
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
@using (Html.BeginForm("", "TrainingEvaluation", FormMethod.Post, new { @class = "form-horizontal", @id = "MainForm" }))
{
    <input id="hfEvaluationID" type="hidden" value="@Model.Item1.EvaluationID" />

    //Step 1 to Step 2
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-2 col-sm-2 col-xs-2">
                <b>Preview</b>
            </div>
            <div class="col-md-1 col-sm-1 col-xs-1">
                <img src="/_layouts/tnbess/ui/silver_arrow.png" />
            </div>
            <div class="col-md-2 col-sm-2 col-xs-2">
                Form Tracking
            </div>
        </div>
    </div>
    <br />

    //Training Course Details
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Training Course Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct01_CustomFieldFormView">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            Form Reference No.
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            <input class="form-control" type="text" id="ReferenceNo" value="@Model.Item1.EvaluationFormNo" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            Form Status
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            <input class="form-control" type="text" id="Status" value="@Model.Item1.StatusCode" style="color:#22BB22;font-weight: bold;" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Evaluation Category <span id="lvTypeMan" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-9 form-control-static">
                                            <input class="form-control" type="text" id="EvaluationCategory" value="@Model.Item1.EvaluationCategoryDesc" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Title <span id="lvTypeMan" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-9 form-control-static">
                                            <input class="form-control" type="text" id="CourseTitle" value="@Model.Item1.CourseTitle" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Session ID
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="SessionID" value="@Model.Item1.CourseSessionID" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Training Category
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="TrainingCategory" value="@Model.Item1.TrainingCategoryDesc" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Training Type
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="TrainingType" value="@Model.Item1.TrainingTypeDesc" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            Start Date
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            <input class="form-control" type="text" id="StartDate" value="@Model.Item1.StartDate" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-6">
                                            End Date
                                        </label>
                                        <div class="col-md-6 form-control-static">
                                            <input class="form-control" type="text" id="EndDate" value="@Model.Item1.EndDate" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Venue
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="CourseVenue" value="@Model.Item1.CourseVenue" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Course Provider
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="CourseProvider" value="@Model.Item1.CourseProvider" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Evaluation Form Name
                                        </label>
                                        <div class="col-md-3 form-control-static">
                                            <input class="form-control" type="text" id="EvaluationFormName" value="@Model.Item1.EvaluationTitle" readonly/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    //Description
    if (ViewBag.IsRecipientListEmpty == "False")
    {
        @Html.Action("_ScaleRating", "TrainingEvaluation", new { EvaluationID = Model.Item1.EvaluationID })
        @*<div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-12">
                        Please tick the rating that best describes you in your current working environment. Just remember that there is no right or wrong answer. Be honest to yourself when giving the feedback.
                    </div>
                    <div class="col-md-12">
                        <div class="table-toolbar">
                            <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        <th>Scale</th>
                                        <th>1 (<=25%)</th>
                                        <th>2 (26% - 50%)</th>
                                        <th>3 (51% - 75%)</th>
                                        <th>4 (76% - 100%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Scale Rating</td>
                                        <td>Rarely</td>
                                        <td>Occasionally</td>
                                        <td>Most of the Time</td>
                                        <td>All the Time</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>*@
    }

    //View Question
    if (Model.Item2 != null)
    {
        //View Attendee Question
        foreach (var m in Model.Item2)
        {
            if (m.AssessmentBy == "Attendee" || m.AssessmentBy == "Attendee & IM")
            {
                <div class="row">
                    @if (x1 == 0)
                    {
                        <div class="col-md-12" style="margin-bottom:15px;">
                            <label class="form-control control-label" style="background-color:darkgrey">
                                For Assessment By: Attendee
                            </label>
                        </div>
                        x1 = x1 + 1;
                    }
                    <div class="col-md-12">
                        <div class="portlet box blue">
                            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                            <div class="portlet-title">
                                <div class="caption">
                                    <i class="fa fa-reorder"></i>Section: @m.EvaluationCategoryDesc
                                </div>
                            </div>
                            <div class="portlet-body form">
                                <div class="form-body" id="ct00_CustomFieldFormView">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-horizontal">
                                                <div class="form-group">
                                                    <label class="control-label col-md-1">
                                                        Remarks:
                                                    </label>
                                                    <div class="col-md-11 form-control-static">
                                                        @m.Remarks
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-horizontal">
                                                <div class="form-group">
                                                    <div class="col-md-12" id="SectionQuestionListResult">
                                                        @Html.Action("_EvaluationSectionQuestionListRadio", "TrainingEvaluation", new { EvaluationID = m.EvaluationID, EvaluationSectionID = m.EvaluationSectionID, EvaluationCategoryDesc = m.EvaluationCategoryDesc, IsShowTotal = "false" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        }

        //View IM Question
        foreach (var m in Model.Item2)
        {
            if (m.AssessmentBy == "IM" || m.AssessmentBy == "Attendee & IM")
            {
                <div class="row">
                    @if (x2 == 0)
                    {
                        <div class="col-md-12" style="margin-bottom:15px;">
                            <label class="form-control control-label" style="background-color:darkgrey">
                                For Assessment By: IM
                            </label>
                        </div>
                        x2 = x2 + 1;
                    }
                    <div class="col-md-12">
                        <div class="portlet box blue">
                            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                            <div class="portlet-title">
                                <div class="caption">
                                    <i class="fa fa-reorder"></i>Section: @m.EvaluationCategoryDesc
                                </div>
                            </div>
                            <div class="portlet-body form">
                                <div class="form-body" id="ct00_CustomFieldFormView">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-horizontal">
                                                <div class="form-group">
                                                    <label class="control-label col-md-1">
                                                        Remarks:
                                                    </label>
                                                    <div class="col-md-11 form-control-static">
                                                        @m.Remarks
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-horizontal">
                                                <div class="form-group">
                                                    <div class="col-md-12" id="SectionQuestionListResult">
                                                        @Html.Action("_EvaluationSectionQuestionListRadio", "TrainingEvaluation", new { EvaluationID = m.EvaluationID, EvaluationSectionID = m.EvaluationSectionID, EvaluationCategoryDesc = m.EvaluationCategoryDesc, IsShowTotal = "false" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        }
    }



    if (Model.Item1.StatusCode == "Published")
    {
        <input type="button" class="btn green" value="Next" id="btnNext" onclick="NextPreviousStep('Next')" />
    }
    else
    {
        <input type="button" class="btn green" value="Edit" id="btnBack" onclick="NextPreviousStep('Edit')" />
        <input type="button" class="btn green" value="Delete" id="btnDelete" onclick="NextPreviousStep('Delete')" />
    }
    <input type="button" class="btn green" value="Close" id="btnClose" onclick="NextPreviousStep('Close')" />


    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmUpdate" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Delete this Evaluation Form?\n\rPress Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmit" value="Submit" onclick="javascript: ConfirmSubmit();">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well">
                        Your Evaluation Form has been successfully deleted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <button type="button" class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
        </p>
    </div>
}

<script>
    var SubmitStatus = "";

    function NextPreviousStep(_Action) {
        if (_Action == "Edit") {
            location.href = '/_layouts/15/essv2/trainingEvaluation/EvaluationForm?EvaluationID=' + $("#hfEvaluationID").val();
        }
        else if (_Action == "Close") {
            location.href = '/_layouts/15/essv2/trainingEvaluation/EvaluationFormHistory';
        }
        else if (_Action == "Delete") {
            SubmitStatus = _Action;
            $('#btnOK').click(function () { RedirectTo('Delete'); });
            $('.modal-body .well').html('Are you sure you want to Delete this Evaluation Form?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#ConfirmUpdate').modal('show');
        } else if (_Action == "Next") {
            location.href = '/_layouts/15/essv2/trainingEvaluation/FormTracking?EvaluationID=' + $("#hfEvaluationID").val();
        }
    }

    function ConfirmSubmit() {
        $("#ConfirmUpdate").modal('toggle');
        $("#divLoading").css("display", "block");
        var myVar = setTimeout(Action, 1000);
    }

    function Action() {
        if (SubmitStatus == 'Delete') {
            $(".Success-body .well").html('Your Evaluation Form has been successfully deleted.');
        }
        else if (SubmitStatus == 'Publish') {
            $(".Success-body .well").html('Your Evaluation Form  has been successfully published.');
        }

        if (SubmitStatus == "Delete") {
            $.ajax({
                url: '@Url.Content("~/TrainingEvaluation/PerformDeleteEvaluationForm")',
                type: 'POST',
                cache: false,
                async: false,
                dataType: "json",
                data: { EvaluationID: $("#hfEvaluationID").val() },
                success: function (result) {
                    if (result.Success) {
                        $("#divLoading").css("display", "none");
                        $("#SuccessSubmit").modal();
                    } else {
                        $("#divLoading").css("display", "none");
                        alert(result.ErrorMsg);
                        console.log(result.ErrorMsg);
                    }
                },
                error: function (x, y, z) {
                    $("#divLoading").css("display", "none");
                    console.log(x + '\n' + y + '\n' + z);
                }
            });
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "Delete":
                window.location.href = '/_layouts/15/essv2/TrainingEvaluation/EvaluationFormHistory';
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }
</script>

