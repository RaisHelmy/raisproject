@model List<SEP.RoutingManagement.Models.GetApprovalAuditLog>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Audit Log
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width AuditLogTable">
                        <thead>
                            <tr>
                                <th>Action By</th>
                                <th>Date</th>
                                <th>Activity</th>
                                <th>Action</th>
                                <th>Comment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ 
                                var x = 0;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @if (x == 0)
                                    {
                                        <td>@ViewBag.CreatedBy</td>
                                        x += 1;
                                    }
                                    else
                                    {
                                        <td>@item.EmployeeName</td>
                                    }
                                    
                                    <td>@item.FormattedDate</td>
                                    <td>@item.ActivityName</td>
                                    <td>@item.ActivityAction</td>
                                    <td>@item.Comment</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    //transformTable(".AuditLogTable");
    $('.AuditLogTable').dataTable(
      {
          "bLengthChange": false,
          "bFilter": false,
          "bPaginate": false,
          "bInfo": false,
          "bSortable": false,
          //"aoColumnDefs": [{
          //    "targets": 0,
          //    "orderable": false
          //}]
      });
</script>