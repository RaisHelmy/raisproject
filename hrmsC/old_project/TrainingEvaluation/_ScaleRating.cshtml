@model List<ESS.Core.EvaluationScaleRating>

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                Please tick the rating that best describes you in your current working environment. Just remember that there is no right or wrong answer. Be honest to yourself when giving the feedback.
            </div>
            <div class="col-md-12">
                <div class="table-toolbar">
                    <table id="ScaleRating" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th>Scale</th>
                                @foreach (var header in Model)
                                {
                                    <th>@header.Rating</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    Scale Rating
                                </td>
                                @foreach (var item in Model)
                                {
                                    <td>
                                        @item.RatingDesc
                                    </td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>




<script type="text/javascript">
    $('.ScaleRating').dataTable({
         "bLengthChange": false,
         "bFilter": false,
         "bPaginate": false,
         "bInfo": false,
         "bSortable": false,
         "bRetrieve": true,
         "bDestroy": true
     });
</script>