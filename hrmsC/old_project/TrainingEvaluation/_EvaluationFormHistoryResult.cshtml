@model List<ESS.Core.EvaluationForm_1>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Evaluation Form History
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Course Title</th>
                                <th>Evaluation Category</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Evaluation Form Name</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/TrainingEvaluation/EvaluationFormPreview")?EvaluationID=@item.EvaluationID">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.EvaluationFormNo</td>
                                    <td>@item.TrainingCategoryDesc</td>
                                    <td>@item.TrainingTypeDesc</td>
                                    <td>@item.CourseTitle</td>
                                    <td>@item.EvaluationCategoryDesc</td>
                                    <td>@item.StartDate</td>
                                    <td>@item.EndDate</td>
                                    <td>@item.EvaluationTitle</td>
                                    <td style="color:#22BB22;font-weight: bold;">@item.StatusCode</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>