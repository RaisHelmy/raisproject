@model Tuple<List<ESS.Core.DropDownObject>, List<ESS.Core.DropDownObject>>  
@{
    ViewBag.Title = "Evaluation Form History";
}
<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Evaluation Form Tracking<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">Start Date</label>
                    <div class="col-md-7 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">End Date</label>
                    <div class="col-md-7 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">Training Category</label>
                    <div class="col-md-7 form-control-static">
                        @Html.DropDownList("TrainingCategory", new SelectList(Model.Item1, "Value", "Text"), "- All -", new { @class = "bs-select form-control", @onchange = "changeType(this)" })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">Evaluation Category</label>
                    <div class="col-md-7 form-control-static">
                        @Html.DropDownList("EvaluationCategory", new SelectList(Model.Item2, "Value", "Text"), "- All -", new { @class = "bs-select form-control" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">Training Type</label>
                    <div class="col-md-7 form-control-static">
                        @Html.Action("_DDLTrainingType", "Training", new { ID = ViewBag.TrainingID })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">Status</label>
                    <div class="col-md-7 form-control-static">
                        <select class="form-control" id="Status">
                            <option value="">- All -</option>
                            <option value="PE">Pending</option>
                            <option value="CO">Completed</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">Course Title</label>
                    <div class="col-md-7 form-control-static">
                        <input class="form-control" id="CourseTitle" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">Evaluation Ref. No</label>
                    <div class="col-md-7 form-control-static">
                        <input class="form-control" id="EvaluationRefNo" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-5 control-label">Employee</label>
                    <div class="col-md-7 form-control-static">
                        @Html.Partial("_PeoplePicker")
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>

<script>
    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        SearchListing();
    });

    function changeType(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Training/_DDLTrainingType")',
            cache: false,
            dataType: "html",
            data: { CategoryCode: e.value }, //$("#TrainingCategory").val() },
            success: function (content) {
                $("#TrainingTypeResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function SearchListing() {
        var _DateFrom = $('#SubDateFrom').val();
        var _DateTo = $('#SubDateTo').val();
        var _TrainingCategory = $('#TrainingCategory option:selected').val();
        var _EvaluationCategory = $('#EvaluationCategory option:selected').val();
        var _Status = $('#Status').val();
        var _TrainingType = $('#TrainingType option:selected').val();
        var _CourseTitle = $('#CourseTitle').val();
        var _EmpId = $("#hfEmpID").val();
        var _ReferenceNo = $("#EvaluationRefNo").val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/TrainingEvaluation/_EvaluationFormTrackingResult")',
            cache: false,
            dataType: "html",
            data: {
                DateFrom: _DateFrom, DateTo: _DateTo, TrainingCategory: _TrainingCategory, EvaluationCategory: _EvaluationCategory,
                Status: _Status, TrainingType: _TrainingType, CourseTitle: _CourseTitle, EmpId: _EmpId, ReferenceNo: _ReferenceNo
            },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>
