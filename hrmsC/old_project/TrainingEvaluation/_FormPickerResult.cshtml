@model List<ESS.Core.EvaluationTrackingForm>

@{
    Layout = null;
}


                <div class="table-toolbar">
                    <table id="tblFormPickerResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Form Ref. No.</th>
                                <th>Evaluation Form Name</th>
                                <th>Evaluation Category</th>
                                <th>Course Title</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><input type="radio" name="FormPick" EvalID="@item.EvaluationID" EvalStartDt="@item.StartDate" EvalEndDt="@item.EndDate" EvalCourseNm="@item.CourseName" value="@item.EvaluationReferenceNo" /></td>
                                    <td>@item.EvaluationReferenceNo</td>
                                    <td>@item.EvaluationTitle</td>
                                    <td>@item.EvaluationCategoryDesc</td>
                                    <td>@item.CourseName</td>
                                    <td>@item.StartDate</td>
                                    <td>@item.EndDate</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

<script type="text/javascript">
    transformTable("#tblFormPickerResult");
</script>