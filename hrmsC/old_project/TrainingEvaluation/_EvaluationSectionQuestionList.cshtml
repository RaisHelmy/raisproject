@model List<ESS.Core.EvaluationForm_2_SectionQuestion>
@{
    Layout = null;
}


<div class="table-toolbar">
    <table id="@ViewBag.EvaluationSectionID" class="table table-striped table-bordered table-hover table-full-width SectionQuestionTable">
        <thead>
            <tr>
                <th style="width:5%;"><input class="DestroyUniform" type="checkbox" ID="chkSelectAllQuestion" name="chkSelectAllQuestion" value="" onclick="javascript: SelectheaderCheckboxes2(this, '@ViewBag.EvaluationSectionID')"></th>
                <th>Question</th>
                <th style="width:10%;">No.</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="DestroyUniform" ID="chkSelect" name="chkSelect" value="@item.QuestionID">
                    </td>
                    <td>@item.Question</td>
                    <td>
                        <input class="form-control QuestionOrderNo" type="text" ID="QuestionOrder" name="QuestionOrder" value="@item.QuestionOrder" readonly>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script type="text/javascript">
    
    $('.SectionQuestionTable').dataTable(
     {
         "bLengthChange": false,
         "bFilter": false,
         "bPaginate": false,
         "bInfo": false,
         "bSortable": false,
         "bRetrieve": true,
         "bDestroy": true
     });

    $(window).load(function () {
        $.uniform.restore(".DestroyUniform");
    });

    function SelectheaderCheckboxes2(headerchk, ID) {
        var gvcheck = document.getElementById(ID);
        var i;
        //Condition to check header checkbox selected or not if that is true checked all checkboxes
        if (headerchk.checked) {
            for (i = 0; i < gvcheck.rows.length; i++) {

                var inputs = gvcheck.rows[i].getElementsByTagName('input');

                inputs[0].checked = true;
            }
        }
        //if condition fails uncheck all checkboxes in gridview
        else {
            for (i = 0; i < gvcheck.rows.length; i++) {
                var inputs = gvcheck.rows[i].getElementsByTagName('input');
                inputs[0].checked = false;
            }
        }
    }
</script>