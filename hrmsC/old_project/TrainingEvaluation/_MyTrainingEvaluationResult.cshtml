@model List<ESS.Core.EvaluationTrackingForm>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My Training Evaluation
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Evaluation Ref. No.</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Course Title</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (item.StatusDesc != "Completed")
                                        {
                                            <a class="btn blue btn-sm" href="@Url.Content("~/TrainingEvaluation/AttendeeEvaluationForm")?EvaluationID=@item.EvaluationID&EvaluationRecipientID=@item.EvaluationRecipientID&TaskID=@item.TaskID&FromSource=MyTrainingEvaluation">
                                                <i class="fa fa-search"></i>
                                            </a>
                                        }
                                    </td>
                                    <td>@item.EvaluationReferenceNo</td>
                                    <td>@item.TrainingCategoryDesc</td>
                                    <td>@item.TrainingTypeDesc</td>
                                    <td>@item.CourseName</td>
                                    <td>@item.StartDate</td>
                                    <td>@item.EndDate</td>
                                    <td style="color:#22BB22;font-weight: bold;">@item.StatusDesc</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>