@model List<ETKEMS.Models.EmployeePositionPicker>
@{
    Layout = null;
    String selection = ViewBag.Selection;
    bool PositionOnly = ViewBag.PositionOnly;
}
<div class="table-toolbar">
    @if (PositionOnly)
    {
        <table id="tblCodPositionPicker" class="table table-striped table-bordered table-hover table-full-width">
            <thead>
                <tr>
                    <th></th>
                    <th>Position Code</th>
                    <th>Position</th>
                    <th>Position Abbr.</th>
                    <th>Vacancy Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in @Model)
                {
                    <tr>
                        <td>
                            <input type="radio" class="PositionPickerSelection"
                                   name="PositionPickerSelection"
                                   value="@item.EmployeeID"
                                   PositionID="@item.ID"
                                   Position="@(item.PositionCode + " - " + item.PositionName)"
                                   PositionCode="@item.PositionCode"
                                   PositionName="@item.PositionName"
                                   VacancyStatus="@item.VacancyStatus"
                                   EmployeeID="@item.EmployeeID"
                                   EmployeeName="@item.EmployeeName"
                                   EmployeeCode="@item.EmployeeCode"
                                   SalaryGrade="@item.SalaryGrade"
                                   Job="@item.Job"
                                   PositionGrade="@item.PositionGrade" />
                        </td>
                        <td class="PositionCode">@item.PositionCode</td>
                        <td class="PositionName">@item.PositionName</td>
                        <td class="PositionGrade">@item.PositionGrade</td>
                        <td class="VacancyStatus">@item.VacancyStatus</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <table id="tblCodPositionPicker" class="table table-striped table-bordered table-hover table-full-width">
            <thead>
                <tr>
                    <th></th>
                    <th>Position Code</th>
                    <th>Position</th>
                    <th>Employee Number</th>
                    <th>Employee Name</th>
                    <th>Division/Department</th>
                    <th>Unit/Section</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in @Model)
                {
                    <tr>
                        <td>
                            <input type="radio" class="PositionPickerSelection"
                                   name="PositionPickerSelection"
                                   value="@item.EmployeeID"
                                   PositionID="@item.ID"
                                   Position="@(item.PositionCode + " - " + item.PositionName)"
                                   PositionCode="@item.PositionCode"
                                   PositionName="@item.PositionName"
                                   EmployeeID="@item.EmployeeID"
                                   EmployeeName="@item.EmployeeName"
                                   EmployeeCode="@item.EmployeeCode"
                                   SalaryGrade="@item.SalaryGrade"
                                   Job="@item.Job"
                                   PositionGrade="@item.PositionGrade" />
                        </td>
                        <td class="PositionCode">@item.PositionCode</td>
                        <td class="PositionName">@item.PositionName</td>
                        <td class="EmployeeCode">@item.EmployeeCode</td>
                        <td class="EmployeeName">@item.EmployeeName</td>
                        <td class="Department">@item.Department</td>
                        <td class="UnitSection">@item.UnitSection</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<script>
    transformTable("#tblCodPositionPicker");
</script>
