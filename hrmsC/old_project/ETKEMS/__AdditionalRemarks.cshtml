@model ETKEMS.Models.ETKEMSViewModel
@{
    List<string> ReasonsForVacancy = ViewBag.ReasonsForVacancy;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Additional Remarks
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"></a>
        </div>
    </div>
    <div class="portlet-body form">
        @if (Model.EStatus == ETKEMS.Status.Draft || Model.EStatus == ETKEMS.Status.Declined)
        {
            <div class="form-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-2">Remarks</label>
                                <div class="col-md-10 form-control-static">
                                    <textarea rows="5" style="width: 100%;" name="Remarks"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="form-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-2">Remarks</label>
                                <div class="col-md-10 form-control-static">
                                    <textarea rows="5" style="width: 100%;"
                                              readonly="readonly">@Model.Remarks</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>