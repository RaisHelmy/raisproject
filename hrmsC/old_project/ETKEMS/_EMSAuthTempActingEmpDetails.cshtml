@model ETKEMS.Models.ETKEMSViewModel
@{
    Layout = "";
    ETKEMS.Models.AuthorizedEmployee authEmp = Model.AuthorizedEmployees == null ? 
                    new ETKEMS.Models.AuthorizedEmployee() : Model.AuthorizedEmployees[0];
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Authorized Temporary Acting Employee Details
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        @if (Model.EStatus == ETKEMS.Status.Draft || Model.EStatus == ETKEMS.Status.Declined)
        {
            <input type="hidden" name="AuthEmpID" value="@authEmp.AuthEmpID" />
            <div class="form-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">
                                    Employee <span style="color:red;"> *</span>
                                </label>
                                <div class="col-md-8 form-control-static">
                                    <div class=" input-group ">
                                        <input type="text" class="form-control EmpNo_EmpName" value="@authEmp.AuthEmp" readonly />
                                        <span class="input-group-btn">
                                            <a data-toggle="modal" class="btn default" 
                                               onclick="OpenAuthEmpsPickerPanel(SelectEmployee);">
                                                <i class="fa fa-user"></i>
                                            </a>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Salary Grade</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempSalaryGrade" 
                                           value="@authEmp.AuthSalaryGrade" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Position</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempPosition" 
                                           value="@authEmp.AuthPosition" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Job</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempJob" 
                                           value="@authEmp.AuthDuty" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Position No.</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempPositionNo" 
                                           value="@authEmp.AuthPositionNo" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Position Grade</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempPositionGrade"
                                           value="@authEmp.AuthJobGrade" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" name="AuthEmpID" value="@authEmp.AuthEmpID" />
            <div class="form-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Employee</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempSalaryGrade" 
                                           readonly="readonly" value="@authEmp.AuthEmp" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Salary Grade</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempSalaryGrade" 
                                           readonly="readonly" value="@authEmp.AuthSalaryGrade" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Position</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempPosition" 
                                           readonly="readonly" value="@authEmp.AuthPosition" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Job</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempJob" 
                                           readonly="readonly" value="@authEmp.AuthDuty" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Position No.</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempPositionNo" 
                                           readonly="readonly" value="@authEmp.AuthPositionNo" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Position Grade</label>
                                <div class="col-md-8 form-control-static">
                                    <input type="text" class="form-control AuthTempPositionGrade"
                                           readonly="readonly" value="@authEmp.AuthJobGrade" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@Html.Action("__AuthEmpPicker", "ETKEMS", new
{
    Selection = "single"
})

<script>
    function SelectEmployee(selectedEmployees) {
        var v = selectedEmployees[0];

        $('input[name="AuthEmpID"]').val(v.AuthEmpID);

        $('.EmpNo_EmpName').val(v.AuthEmp);
        $('.AuthTempSalaryGrade').val(v.AuthSalaryGrade);
        $('.AuthTempPosition').val(v.AuthPosition);
        $('.AuthTempJob').val(v.AuthDuty);
        $('.AuthTempPositionNo').val(v.AuthPositionNo);
        $('.AuthTempPositionGrade').val(v.AuthJobGrade);

        return true;
    }
</script>