@model List<ETKEMS.Models.AuthorizedEmployeePicker>
@{
    Layout = null;
    string Selection = ViewBag.Selection;
}
<div class="table-toolbar">
    <table id="tblAuthEmpPicker" class="table table-striped table-bordered table-hover table-full-width">
        <thead>
            <tr>
                <th></th>
                <th>Employee Number</th>
                <th>Employee Name</th>
                <th>Division / Department</th>
                <th>Unit / Section</th>
                <th>PositionCode</th>
                <th>Position</th>
                <th>Duty</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in @Model)
            {
                <tr>
                    <td>
                        @if (Selection == "multiple")
                        {
                            <input type="checkbox" class="AuthEmpPickerSelection"
                                   name="AuthEmpPickerSelection"
                                   value="@item.EmployeeID"
                                   empname="@item.EmployeeName"
                                   empcode="@item.EmployeeCode"
                                   AuthEmp="@item.AuthEmp"
                                   AuthPosition="@item.AuthPosition"
                                   AuthPositionNo="@item.AuthPositionNo"
                                   AuthSalaryGrade="@item.AuthSalaryGrade"
                                   AuthDuty="@item.AuthDuty"
                                   AuthJobGrade="@item.AuthJobGrade"
                                   AuthEmpID="@item.AuthEmpID" />
                        }
                        else
                        {
                            <input type="radio" class="AuthEmpPickerSelection"
                                   name="AuthEmpPickerSelection"
                                   value="@item.EmployeeID"
                                   empname="@item.EmployeeName"
                                   empcode="@item.EmployeeCode"
                                   AuthEmp="@item.AuthEmp"
                                   AuthPosition="@item.AuthPosition"
                                   AuthPositionNo="@item.AuthPositionNo"
                                   AuthSalaryGrade="@item.AuthSalaryGrade"
                                   AuthDuty="@item.AuthDuty"
                                   AuthJobGrade="@item.AuthJobGrade"
                                   AuthEmpID="@item.AuthEmpID" />
                        }              
                    </td>
                    <td class="EmployeeCode">@item.EmployeeCode</td>
                    <td class="EmployeeName">@item.EmployeeName</td>
                    <td class="Department">@item.Department</td>
                    <td class="UnitSection">@item.UnitSection</td>
                    <td class="PositionCode">@item.PositionCode</td>
                    <td class="Position">@item.Position</td>
                    <td class="Duty">@item.JobKeyName</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@Html.Partial("_includeDataTableScripts")
<script>
    transformTable("#tblAuthEmpPicker");
</script>
