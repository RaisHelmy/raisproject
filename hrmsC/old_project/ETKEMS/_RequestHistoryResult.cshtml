@model List<ETKEMS.Models.ETKEMSViewModel>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>ETKEMS Request History
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Type</th>
                                <th>Position</th>
                                <th>Position No</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (item.RequestType == "ETK")
                                        {
                                            <a class="btn blue btn-sm" href="@Url.Action("ETKForm", "ETKEMS", new { RequestID = item.RequestID, Source = "History" })">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn blue btn-sm" href="@Url.Action("EMSForm", "ETKEMS", new { RequestID = item.RequestID, Source = "History" })">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        }
                                    </td>
                                    <td>@item.RequestNo</td>
                                    <td>@item.RequestType</td>
                                    <td>@item.Position</td>
                                    <td>@item.PositionNo</td>
                                    @if (item.EStatus == ETKEMS.Status.Declined || 
                                         item.EStatus == ETKEMS.Status.ExtensionRequest_Declined || 
                                         item.EStatus == ETKEMS.Status.PaymentProcessing_Declined)
                                    {
                                        <td style="color:red;"><b>@item.Status</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.Status</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>
