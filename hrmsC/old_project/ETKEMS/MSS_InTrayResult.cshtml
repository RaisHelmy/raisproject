@model List<SEP.RoutingManagement.Models.GetMyIntray>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Type</th>
                                <th>Employee</th>
                                <th>Status</th>
                                <th>Submission Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                var Status = ETKEMS.Service.GetStatus(item.DisplayText12);
                                <tr>
                                    <td>
                                        @if (item.DisplayText19 == "ETK")
                                        {
                                            <a class="btn blue btn-sm" href="@Url.Action("ETKForm", "ETKEMS", new { RequestID = item.SourceID, TaskID = item.ID, Source = "InTray" })">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        }
                                        else
                                        {                                        
                                            <a class="btn blue btn-sm" href="@Url.Action("EMSForm", "ETKEMS", new { RequestID = item.SourceID, TaskID = item.ID, Source = "InTray" })">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        }
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.DisplayText19</td>
                                    <td>@item.DisplayText1 - @item.DisplayText2</td>
                                    @if (Status == "Declined" || Status == "Cancelled" || Status == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@Status</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@Status</b></td>
                                    }

                                    @if (!String.IsNullOrEmpty(item.DisplayText20))
                                    {
                                        <td>@item.DisplayText20</td>
                                    }
                                    else
                                    {
                                        <td style="text-align : center">-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>