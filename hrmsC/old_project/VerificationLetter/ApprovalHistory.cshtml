@model LeaveQuota.Models.FilterModel
@{
    ViewBag.Title = "Verification Letter Approval History";
}
<style>
    .form-group {
        margin-bottom: 6px;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Verification Letter: My Approval History
        </h1>
    </div>
</div>
<br />

<div class="row">
    <div class="col-md-12">
        <form id="filterForm">
            <div class="form-horizontal">
                <div class="form-body verification-form">
                    <div class="form-group">
                        <label class="control-label col-md-2">
                            Form Type
                        </label>
                        <div class="col-md-4">
                            @Html.DropDownList("FormType", new SelectList(ViewBag.FormType, "Value", "Text"), "- All -", new { @class = "bs-select form-control" })
                        </div>
                        <label class="col-md-2 control-label">Submitted By</label>
                        <div class="col-md-4">
                            <input class="form-control" id="SubmittedBy" name="SubmittedBy" placeholder="Name or ID" />
                        </div>
                    </div> 
                    <div class="form-group">
                        <label class="col-md-2 control-label">Submission Start Date</label>
                        <div class="col-md-4">
                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                <input type="text" class="form-control" id="FromDate" name="FromDate" />
                                <span class="input-group-btn">
                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                </span>
                            </div>
                        </div>
                        <label class="col-md-2 control-label">Submission End Date</label>
                        <div class="col-md-4">
                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                <input type="text" class="form-control" id="ToDate" name="ToDate" />
                                <span class="input-group-btn">
                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
    <div class="col-md-12">
        <div class="text-right">
            <a id="btn-Search" class="btn green btn-Search" value="Search" onclick="GetApprovalHistory();">Search</a>
        </div>
    </div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
    <div class="col-md-12">
        <div id="SearchResult">

        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        GetApprovalHistory();
    });

    function GetApprovalHistory() {

        $("#SearchResult").html("LOADING...");
        $.ajax({
            type: "GET",
            cache: false,
            url: '@Url.Content("~/VerificationLetter/_ApprovalHistoryResult")',
            data: $("#filterForm").serialize(),
            success: function (listingContent) {

                $("#SearchResult").empty().append(listingContent);
            },
            error: function (err) {

                console.log(err);
            }
        });
    }
</script>