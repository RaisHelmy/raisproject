@{
    ViewBag.Title = "Request Listing";
    SelectListItem no = new SelectListItem() { Value = "0", Text = "No" };
    SelectListItem yes = new SelectListItem() { Value = "1", Text = "Yes" };

    List<SelectListItem> list = new List<SelectListItem>();
    list.Add(no);
    list.Add(yes);
    SelectList signatureDDL = new SelectList(list, "Value", "Text");
}

<style>
    .form-group {
        margin-bottom: 6px;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Verification Letter Report Listing<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />

<div class="row">
    <div class="col-md-12">
        <form id="filterForm">
            <div class="form-horizontal">
                <div class="form-body verification-form">
                    <div class="form-group">
                        <label class="control-label col-md-2">
                            Form Type
                        </label>
                        <div class="col-md-4">
                            @Html.DropDownList("FormType", new SelectList(ViewBag.FormType, "Value", "Text"), "- All -", new { @class = "bs-select form-control" })
                        </div>
                        <label class="col-md-2 control-label">Status</label>
                        <div class="col-md-4">
                            <select id="Status" name="Status" class="form-control">
                                <option value>All</option>
                                <option value="Completed">Completed</option>
                                <option value="Declined">Declined</option>
                                <option value="Pending">Pending</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        @*<label class="col-md-2 control-label">Require Signature</label>
                        <div class="col-md-4">
                            @Html.DropDownList("RequireSignature", signatureDDL, "- All -", new { @class = "bs-select form-control" })
                        </div>*@
                        <label class="col-md-2 control-label">Submitted By</label>
                        <div class="col-md-4">
                            <input class="form-control" id="SubmittedBy" name="SubmittedBy" placeholder="Name or ID" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-2 control-label">Submission Start Date</label>
                        <div class="col-md-4">
                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                <input type="text" class="form-control" id="FromDate" name="FromDate" />
                                <span class="input-group-btn">
                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                </span>
                            </div>
                        </div>
                        <label class="col-md-2 control-label">Submission End Date</label>
                        <div class="col-md-4">
                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                <input type="text" class="form-control" id="ToDate" name="ToDate" />
                                <span class="input-group-btn">
                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-2 control-label">Reference No.</label>
                        <div class="col-md-4">
                            <input class="form-control" id="ReferenceNo" name="ReferenceNo" />
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="text-right">
            <a id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">Search</a>
        </div>
    </div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
    <div class="col-md-12">
        <div id="SearchResult">

        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        }); 
    });

    function SearchListing() {

        $("#SearchResult").html("LOADING...");
        $.ajax({
            type: "GET",
            cache: false,
            url: '@Url.Content("~/VerificationLetter/_RequestHistoryResult")',
            data: $("#filterForm").serialize(),
            success: function (listingContent) {
                $("#SearchResult").empty().append(listingContent);
            },
            error: function (err) {

            }
        });
    }

    $('#SubmittedBy').keydown(function (evt) {
        if (evt.keyCode == '13') {
            evt.preventDefault();
            SearchListing();
        }
    });
</script>