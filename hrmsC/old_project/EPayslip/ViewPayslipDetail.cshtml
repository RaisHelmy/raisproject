@model ESS.EPayslip.Models.EPayslipResult
@{
    ViewBag.Title = "EPayslip";
    Layout = "~/Views/Shared/_Layout.cshtml";


}

<style type="text/css">
    .hidden_1 {
        display: none;
    }
</style>

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                E-Payslip
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>

@if (Model.ShowTableMessage)
{
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    @Html.Raw(Model.Subject)
                </h4>
                <p>
                    Detail Message:
                    <div class="well" style="font-family: 'Courier New';">
                        @Html.Raw(Model.Message)
                        <br /><br />
                        <i>Date: @TNB_ESS_MVC.Helpers.GeneralHelper.FormatDateTime(DateTime.Now)</i>
                    </div>
                </p>
            </div>
        </div>
    </div>
}
