@model List<ESS.EPayslip.Models.EPayslipVM>
@{
    Layout = null;
}

<table id="tblResultDetail" class="table table-striped table-bordered table-hover table-full-width">
    <thead>
        <tr>
            <th></th>
            <th>Month</th>
            <th>Pay Date</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in @Model)
        {
            <tr>
                <td>
                    <a href="@Url.Action("ViewPayslipDetail", "EPayslip", new { EmployeeID = item.EmployeeID, payslipID = item.PayslipID, month = item.PayMonth, seqNo = item.SequenceNumber })"
                       class=" btn yellow btn-sm" title="Click to View Payslip">
                        <i class="fa fa-search"></i>
                    </a>
                </td>
                <td>@item.PayMonth</td>

                @if (item.PayDate.HasValue)
                {
                    <td>@item.PayDate.Value.ToString("dd-MM-yyyy")</td>
                }
                else
                {
                    <td>-</td>
                }
            </tr>
        }
    </tbody>
</table>

