@{
    Layout = null;
}

<div id="PayslipSpecial">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>View Special Payslip
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct00_CustomFieldFormView">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">Year</label>
                                        <div class="col-md-6 form-control-static">
                                            @Html.DropDownList("YearPayslipSpecial", new SelectList(Enumerable.Range((DateTime.Today.AddYears(-4).Year), 5).Reverse().ToList()), "-Select One-", new { @class = "form-control" })
                                        </div>
                                        @*<div class="col-md-6 form-control-static">
                                                <select class="form-control" id="YearDLL" onchange="YearDLLChange()">
                                                    <option value="0">-Select One-</option>
                                                    <option value="2017">2017</option>
                                                    <option value="2016">2016</option>
                                                    <option value="2015">2015</option>
                                                    <option value="2014">2014</option>
                                                    <option value="2014">2013</option>
                                                </select>
                                            </div>*@
                                        <div class="control-label col-md-3">
                                            <input type="button" id="btn-SearchPayslipSpecial" class="btn green btn-Search" value="View" onclick="SearchDetail('PayslipSpecial');">
                                        </div>
                                    </div>
                                </div>
                                <br />
                            </div>
                        </div>
                        <div class="row">&nbsp;</div>
                        <div class="row">
                            <div class="col-md-12">
                                <div id="SearchPayslipSpecialResult">

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
