@using ESS.Core;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Payslip Release Date Admin";
}


<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            E-Payslip Release Date
        </h1>
        <!-- END PAGE TITLE & BREADCRUMB-->
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="form-horizontal">
            <div class="form-body">
                <div class="form-body">
                    <div class="form-group">

                        <div class="col-md-2">
                            <select id="SelectYear" class="form-control bs-select">
                                @{var currentYear = DateTime.Today.AddYears(5).Year;}
                                @for (int i = 15; i >= 0; i--)
                                {
                                    var year = @currentYear - @i;
                                    // Now just add an entry that's the current year minus the counter
                                    var selected = "";
                                    // Now just add an entry that's the current year minus the counter
                                    if (year == DateTime.Today.Year) @selected = "selected";
                                    <option @selected>@year</option>



                                }

                            </select>
                        </div>
                        <div class="col-md-4">
                            <select id="SelectType" class="form-control bs-select">
                                <option>Normal</option>
                                <option>Special</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            @if (ESS.EPayslip.Service.IsPayslipAdmin(Common.GetEmployeeID()))
                            {
                                <input type="button" value="Search" class="btn blue btn-Search" onclick="Search();">
                                <input type="button" value="Add" class="btn blue btn-Search" onclick="Add()">
                            }
                            <a class="btn blue btn-Search" href="~/EPayslip/Admin">Back</a>

                        </div>


                    </div>

                    <div class="form-group ">
                        <div class="col-md-12">

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="PayslipResult">



        </div>

    </div>
</div>


<div class="modal fade bs-modal-lg in" id="AddConfiguration" tabindex="-1" role="dialog" aria-hidden="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Update Release Date Configuration</h4>
            </div>
            <div class="modal-body">
                <div class="form-body">
                    <div class="form-body">
                        <div class="row" id="AddControl">
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-2">
                                        Year :
                                    </div>
                                    <div class="col-md-4">
                                        <select id="AddYear" class="form-control bs-select">
                                            @{var addYear = DateTime.Today.AddYears(5).Year;}
                                            @for (int i = 15; i >= 0; i--)
                                            {
                                                var year = @addYear - @i;
                                                // Now just add an entry that's the current year minus the counter
                                                var selected = "";
                                                // Now just add an entry that's the current year minus the counter
                                                if (year == DateTime.Today.Year) @selected = "selected";
                                                <option @selected>@year</option>



                                            }
                                        </select>
                                    </div>
                                </div>


                            </div>

                            <div class="form-group ">
                                <div class="row">
                                    <div class="col-md-2">
                                        Month :
                                    </div>
                                    <div class="col-md-4">
                                        <select id="AddMonth" class="form-control">
                                            <option value="1">January</option>
                                            <option value="2">February</option>
                                            <option value="3">March</option>
                                            <option value="4">April</option>
                                            <option value="5">May</option>
                                            <option value="6">June</option>
                                            <option value="7">July</option>
                                            <option value="8">August</option>
                                            <option value="9">September</option>
                                            <option value="10">October</option>
                                            <option value="11">November</option>
                                            <option value="12">December</option>
                                        </select>
                                    </div>
                                </div>

                            </div>

                            <div class="form-group ">
                                <div class="row">
                                    <div class="col-md-2">
                                        Type :
                                    </div>
                                    <div class="col-md-4">
                                        <select id="AddType" class="form-control">
                                            <option>Normal</option>
                                            <option>Special</option>
                                        </select>
                                    </div>
                                </div>

                            </div>
                            <div class="form-group ">
                                <div class="row">
                                    <div class="col-md-2">
                                        Release Date :
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-group date form_datetime">
                                            <input id="AddReleaseDate" type="text" size="16" readonly="" class="form-control">
                                            <span class="input-group-btn">
                                                <button class="btn default date-set" type="button"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div id="AddResult">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
                <button id="AddConfigurationBtn" type="button" class="btn blue" onclick="AddConfiguration()">Update</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>


<div class="modal fade bs-modal-lg in" id="DeleteConfiguration" tabindex="-1" role="dialog" aria-hidden="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Delete Date Configuration</h4>
            </div>
            <div class="modal-body">
                <div class="form-body">
                    <div class="form-body">
                        <div class="row" id="DeleteControl">
                            <input hidden id="hdnDeleteID" value="" />
                            <div class="alert alert-info">
                                <strong>Alert!</strong> Do you want to delete this Release Date Configuration?
                            </div>

                        </div>

                        <div id="DeleteResult">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
                <button id="DeleteConfigurationBtn" type="button" class="btn Red" onclick="DeleteConfiguration()">Delete</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<script>
    $("#StartDate, #EndDate").datepicker({

        autoclose: true
    });

    $(".form_datetime").datetimepicker({
        autoclose: true,
        isRTL: App.isRTL(),
        //format: "dd mm yyyy - hh:ii",
        pickerPosition: (App.isRTL() ? "bottom-right" : "bottom-left")
    });



    function Delete(deleteID)
    {
        console.log(deleteID);
        $('#hdnDeleteID').val(deleteID);
        $('#DeleteConfiguration').modal();
        $("#DeleteControl").show();
        $("#DeleteResult").hide();
        $("#DeleteConfigurationBtn").show();
    }

    function DeleteConfiguration() {

        var DeleteID = $('#hdnDeleteID').val();

        console.log(DeleteID);

        $("#DeleteControl").hide();
        $("#DeleteResult").show();
        $("#DeleteResult").html("LOADING...");
        $("#DeleteConfigurationBtn").hide();
        $.ajax({
            type: "POST",
            cache: false,
            url: '@Url.Content("DeleteReleaseDateConfiguration")',
            data: { ID: DeleteID },
            success: function (content) {
                //console.log(content);

                $("#DeleteResult").html(content);
                Search();

            },
            error: function (err) {
                console.log(err);
            }
        });

        //$('#AddConfiguration').modal()
    }

    function Add()
    {


        $('#AddConfiguration').modal()
        $("#AddControl").show();
        $("#AddResult").hide();
        $("#AddConfigurationBtn").show();
    }

    function AddConfiguration()
    {
        var AddMonth = $('#AddMonth').val();
        var AddYear = $('#AddYear').val();
        var AddType = $('#AddType').val();
        var AddReleaseDate = $('#AddReleaseDate').val();

        console.log(AddMonth);
        console.log(AddYear);
        console.log(AddType);
        console.log(AddReleaseDate);

        if (AddReleaseDate == "") {
            alert("Please Choose Release Date");
            return;
        }
        $("#AddControl").hide();
        $("#AddResult").show();
        $("#AddResult").html("LOADING...");
        $("#AddConfigurationBtn").hide();
        $.ajax({
            type: "POST",
            cache: false,
            url: '@Url.Content("AddReleaseDateConfiguration")',
            data: { Year: AddYear, Month: AddMonth, Type: AddType, DateTime: AddReleaseDate },
            success: function (content) {
                //console.log(content);

                $("#AddResult").html(content);
                Search();
            },
            error: function (err) {
                console.log(err);
            }
        });


    }

    function Search()
    {
        var SelectYear = $("#SelectYear").val();
        var SelectType = $("#SelectType").val();
        $("#PayslipResult").html("LOADING...");
        $.ajax({
            type: "GET",
            cache: false,
            url: '@Url.Content("_ReleaseDateConfiguration")',
            dataType: "html",
            data: { Year: SelectYear, Type: SelectType },
            success: function (content) {
                $("#PayslipResult").html(content);
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
</script>