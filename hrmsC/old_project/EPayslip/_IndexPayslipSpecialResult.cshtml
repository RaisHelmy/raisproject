@model List<ESS.EPayslip.Models.EPayslipBonusVM>
@{
    Layout = null;
}

<table id="tblResultSpecial" class="table table-striped table-bordered table-hover table-full-width">
    <thead>
        <tr>
            <th></th>
            <th>Month</th>
            <th>Pay Date</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in @Model)
        {
            <tr>
                <td>
                    <a class="btn blue btn-sm" href="@Url.Content("~/EPayslip/ViewDetail")?RequestID=@item.PayslipBonusID">
                        <i class="fa fa-search"></i>
                    </a>
                </td>
                <td>@item.PayMonth</td>

                @if (item.PayDate.HasValue)
                {
                    <td>@item.PayDate.Value.ToString("dd-MM-yyyy")</td>
                }
                else
                {
                    <td>-</td>
                }
            </tr>
        }
    </tbody>
</table>

@*<script type="text/javascript">
    transformTable("#tblResultSpecial");
</script>*@
