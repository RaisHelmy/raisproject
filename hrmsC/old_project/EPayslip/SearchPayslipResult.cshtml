@model List<ESS.EPayslip.Models.Payslip>

@{
    Layout = null;
}
<div class="portlet box blue">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Payslip Listing
        </div>
        <a href="javascript:DeleteAll()" class="btn red btn-xs pull-right">Delete All</a>
        @*<a href="javascript:Update()" class="btn dark btn-xs pull-right" style="margin-right:10px;">Year Configuration</a>*@
        <a href="javascript:ReleaseAll()" class="btn dark btn-xs pull-right" style="margin-right:10px;">Release All</a>
        <div class="tools">

        </div>
    </div>
    <div class="portlet-body form">

        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblNotificationResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Payslip</th>
                              
                                <th>Type</th>
                               
                                <th>Override Release Date</th>
                                <th>Import Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {

                                    <tr>
                                        <td>
                                            <a href="~/EPayslip/DownloadDocument/@item.ID">@item.EmployeeUserId - @item.EmployeeName</a>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Month) @Html.DisplayFor(modelItem => item.Year)
                                        </td>
                                        <td>
                                           @Html.DisplayFor(modelItem => item.Type)
                                        </td>
                                     
                                       
                                        <td>
                                            @if (item.ReleaseDate == DateTime.MinValue)
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                @item.ReleaseDate.ToString("dd/MM/yyyy HH:mm")
                                            }

                                        </td>
                                        <td>
                                            @if (item.CreatedDate == DateTime.MinValue)
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                            }

                                        </td>

                                        <td>
                                            <button class="btn blue" onclick="Add('@item.ID')">Release</button>
                                            <button class="btn red" onclick="Delete('@item.ID')">Delete</button>
                                            @*@Html.DisplayFor(modelItem => item.ID)*@
                                        </td>

                                    </tr>

                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        $("#tblNotificationResult").dataTable();
        var tableWrapper = "#tblNotificationResult_wrapper";
        jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
        jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
        jQuery(tableWrapper + ' .dataTables_length select').select2({
            showSearchInput: false //hide search box with special css class
        });
        jQuery(tableWrapper + ' .dataTables_filter').addClass("pull-right");

    });


</script>