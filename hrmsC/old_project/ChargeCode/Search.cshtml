<script>

    

    $("#chargecodesearchtype").change(function () {
        var selected = $("#chargecodesearchtype").val();

        if (selected == "Favorite")
        {
            $('#favoriterow').show();
            $('#chargecoderow').hide();
            GetFavGroup();
        }
        else
        {
            $('#favoriterow').hide();
            $('#chargecoderow').show();
        }
       
    });

    function SearchChargeCode(value)
    {
        var ChargeType = $('#chargecodedll').val();
        var CCValue = $('#chargecodevalue').val();
        var CurrentCC = $('#ChargeCodeList').val();

        if (value == 'EMPTY') {
            ChargeType = 'EMPTY';
        }

        $('#ChargeCodeResult').html('<h2>Loading...</h2>');

        $.ajax({
            url: '@Url.Content("~/ChargeCode/ChargeCodeSearchResult")',
            type: 'POST',
            data: { Type: ChargeType, Value: CCValue, CurrentChargeCode : CurrentCC},
            success: function (result) {

                $('#ChargeCodeResult').html(result);
                // ... Process the result ...
            }
        });
    }

    function SearchFavGroupChargeCode() {
        var GroupID = $('#favGroup').val();
        var CurrentCC = $('#ChargeCodeList').val();
        $.ajax({
            url: '@Url.Content("~/ChargeCode/FavGroupChargeCodeSearchResult")',
            type: 'POST',
            data: { GroupID: GroupID, CurrentChargeCode: CurrentCC },
            success: function (result) {

                $('#ChargeCodeResult').html(result);
                // ... Process the result ...
            }
        });
    }

    function GetFavGroup(callback)
    {
        var mySelect = $('#favGroup');
        mySelect.html('');
        mySelect.append(
            $('<option></option>').val('null').html('- Select One -')
        );
        $.ajax({
            url: '@Url.Content("~/ChargeCode/GetFavChargeCode")',
            type: 'POST',
            async: false,
            success: function (result) {
                //console.log(result);

                $.each(result, function (i, val) {
                  
                    mySelect.append(
                        $('<option></option>').val(this.ID).html(this.GroupName)
                    );
                });
                $('#favGroup option').eq(1).prop('selected', true).trigger('change');
                if (typeof callback == "function") {
                    callback();
                }
            }
        });
    }
</script>