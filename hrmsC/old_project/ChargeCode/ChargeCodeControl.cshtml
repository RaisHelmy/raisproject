    function RemoveChargeCodeFromMain() {
        var hasDICChargeCode = false;
        var selectedChargeCodeSearch = mytable.fnGetNodes()
                                        .filter(function (val) { return $(val).find('input[name="RemoveChargeCode"]:checked').val(); });


        $.each(selectedChargeCodeSearch, function (i, val) {
            var row = val;
            var id = $(val).attr("id");
            mytable.fnDeleteRow(mytable.fnGetPosition(row));
        });

        //$.each($('input[name="RemoveChargeCode"]:checked'), function (i, val) {
