@model List<ESS.ChargeCode.Models.ChargeCode>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Charge Code
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <input type="hidden" name="ChargeCodeList" id="ChargeCodeList" value="@ViewBag.ChargeCodeList" />
            <table id="sourcechargecode" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th scope="col" width="5%"></th>
                        <th scope="col">Charge Type</th>
                        <th scope="col">Charge Code</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr class="chargecoderow">
                            <td>
                                <input type="checkbox" name="RemoveChargeCode" 
                                        value="@Model[i].ID" class="checkbox" />
                                <input type="hidden" name="SelectedChargeCodes" value="@Model[i].ChargeCodes" />
                            </td>
                            
                            <td class="selectedChargeType">@Model[i].ChargeType</td>
                            <td class="selectedChargeCode">@Model[i].ChargeCodes</td>
                            <td class="selectedChargeDesc">@Model[i].ChargeCodeDesc</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="btn green" href="javascript:OpenSearchChargeCode();">
                                    Add
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="btn red" href="javascript:RemoveChargeCodeFromMain();">
                                    Delete
                                    <i class="fa fa-minus"></i>
                                </a>

                            </div>
                            <div class="btn-group">
                                <a class="btn green" data-toggle="modal" data-target="#AddToFavouriteModal">
                                    Add To Favourite <i class="fa fa-check">
                                    </i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="SearchChargeCode" tabindex="-1" role="basic" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Add Charge Code</h4>
            </div>
            <div class="modal-body">
                @Html.Action("Search", "ChargeCode")
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default blue" id="btnSubmitChargeCode" onclick="AddChargeCodeToMain(); return false;">
                    <i class="fa fa-plus"></i>
                    Add
                </button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="AddToFavouriteModal" tabindex="-1" role="basic" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Add Charge Codes To Favourite Group</h4>
            </div>
            <div class="modal-body">
                @Html.Action("AddToFavouriteView", "ChargeCode")
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default blue" id="btnAddToFavourite" onclick="AddToFavourite(); return false;">
                    <i class="fa fa-pencil"></i>
                    Add
                </button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

