        //    }

        //    // pre change
        //    //chargecodestring += $(this).find('.selectedChargeCode').html() + ',';
        //});

        if ($('#sourcechargecode tbody tr .dataTables_empty').length > 0) {
            chargecodestring = "";
        }
        // console.log(chargecodestring);
        $('#ChargeCodeList').val(chargecodestring);

        $(function () {
            if (chargecodestring.indexOf("DI") < 0) {
                $("#divDICText").css("visibility", "hidden");
            }
            else {
                $("#divDICText").css("visibility", "visible");
            }
        });

        BindtoDDL();

        $('input[name="RemoveChargeCode"]').uniform();
    }

    function OpenSearchChargeCode() {
        $("#chargecodesearchtype").val('Favorite');
        $('#SearchChargeCode').modal();
        $('#favoriterow').show();
        $('#chargecoderow').hide();
        //SearchChargeCode('EMPTY');
        GetFavGroup(SearchFavGroupChargeCode);

    }

    function GetSelectedChargeCode() {
        var ListChargeCode = [];
        $.each($('#sourcechargecode tbody tr'), function (i, val) {
            var IndChargeCode = [];
            if ($(this).find('.selectedChargeCode').text() != "") {
                IndChargeCode.push($(this).find('.selectedChargeCode').text());
                IndChargeCode.push($(this).find('.selectedChargeDesc').text());
                ListChargeCode.push(IndChargeCode);
            }
        });

        return ListChargeCode;
    }

    function BindtoDDL() {

    }

    function AddToFavourite() {
        var chargecodelist = $("#ChargeCodeList").val();
        if (chargecodelist == '') {
            alert("There are no charge codes in the list.");
            return false;
        }

        var errorMessage = '';
        var groupName = $("#groupName").val();
        var description = $("#groupDescription").val();
        if (groupName == '')
            errorMessage += 'Group Name \n';
        if (description == '')
            errorMessage += 'Description \n';
        if (errorMessage != '') {
            alert("Please fill up the following fields. \n" + errorMessage);
            return false;
        }
        $("#AddToFavouriteModal").modal('hide');
        $.ajax({
            type: "POST",
            url: '@Url.Action("AddToFavourite", "ChargeCode")',
            data: { ChargeCodeList: chargecodelist, groupName: groupName, description: description },
            success: function (content) {
                if (content.Success == true) {
                    alert("Charge codes added to new favourite group: " + groupName);
                }
                else {
                    alert("An error occurred when adding charge codes to new favourite group. \n Please try again.");
                }
            },
            error: function (err) {

            }
        });
    }

    $(function () {
        updateChargeCode();
    });
</script>