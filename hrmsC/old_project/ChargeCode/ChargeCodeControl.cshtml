        //    mytable.fnDeleteRow(mytable.fnGetPosition(row));
        //});

        updateChargeCode();
    }

    function updateChargeCode() {
        var chargecodestring = "";
        gCurrentChargeCode = {};

        $.each(mytable.fnGetNodes(), function (i, val) {
            var chargeType = $(val).find('.selectedChargeType').text();
            var chargeCode = $(val).find('.selectedChargeCode').text();
            var chargeDesc = $(val).find('.selectedChargeDesc').text();

            if (chargeType == "DI") {
                // clear all previous selection and add nly DIC type harge code
                chargecodestring = "";
                gCurrentChargeCode = {};

                chargecodestring += chargeCode + ',';
                gCurrentChargeCode[chargeCode] = chargeCode.trim() + " (" + chargeDesc + ")";
                return false;
            }
            else {
                chargecodestring += chargeCode + ',';
                gCurrentChargeCode[chargeCode] = chargeCode.trim() + " (" + chargeDesc + ")";
            }

            // pre change
            //chargecodestring += $(this).find('.selectedChargeCode').html() + ',';
        });

        //$.each($('#sourcechargecode tbody tr'), function (i, val) {
        //    var chargeType = $(this).find('.selectedChargeType').html() + ',';

        //    if (chargeType == "DI") {
        //        // clear all previous selection and add nly DIC type harge code
