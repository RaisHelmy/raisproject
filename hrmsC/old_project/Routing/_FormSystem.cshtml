@model SEP.RoutingManagement.Models.Sy
@{
    string Disabled = "";
    if (ViewBag.Disabled == true)
    {
        Disabled = "disabled = 'disabled' ";
    }
}
<div class="portlet box blue">
    <div class="portlet-title">

    </div>
    <div class="portlet-body">
        <form class="form-horizontal" role="form">
            <div class="form-body">
                <div class="form-group">
                    <label class="col-md-2 control-label">System Name<span class="required">*</span></label>
                    <div class="col-md-10 SystemNameDiv">
                        @Html.TextBoxFor(m => m.SystemName,
                                                            ViewBag.Disabled ? (object)new
                                                            {
                                                                @class = "form-control requiredFields",
                                                                @placeholder = "System Name",
                                                                readOnly = true
                                                            }
                                                            : new
                                                            {
                                                                @class = "form-control requiredFields",
                                                                @placeholder = "System Name"
                                                            })
                    </div>
                </div>
                @if (Model.ID != Guid.Empty)
                {
                    <div class="form-group">
                        <label class="col-md-2 control-label">Active</label>
                        <div class="col-md-10">
                            <div class="checkbox-list">
                                <label class="checkbox-inline">
                                    <input type="checkbox"
                                           id="Active"
                                           name="Active"
                                           value="true"
                                           checked="@Model.Active"
                                           string.empty"
                                           @Disabled />
                                </label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    </div>
</div>

