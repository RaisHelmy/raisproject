@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Routing Application Types";
}
<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Routing Application Types
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>

<div class="portlet box blue">
    <div class="portlet-title">
        <div class="caption" style="float:right;">
            <a href="@Url.Action("CreateAppType", "Routing")"
               class="btn green btn-sm">
                Create
            </a>
        </div>
    </div>
    <div class="portlet-body">
        <form class="form-horizontal" role="form">
            <div class="form-body">
                <div class="form-group">
                    <div>
                        <div class="col-md-4">
                            <select class="form-control" id="SearchParameter">
                                <option value="ApplicationName">
                                    Application Name
                                </option>
                                <option value="ApplicationTypeName">
                                    Application Type Name
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input type="text" id="SearchKey"
                                   class="form-control">
                        </div>
                        <div class="col-md-4">
                            <input id="btn-Search"
                                   type="button"
                                   value="Search"
                                   class="btn blue pull-left">
                        </div>

                    </div>
                </div>

                <div id="SearchTableResult">

                </div>

            </div>
        </form>
    </div>
</div>
<script>
    function runAjax() {
        callAjax("GET",
                "@Url.Action("_IndexAppType_DetailsResult", "Routing")",
                "html",
                {
                    SearchParam: $('#SearchParameter').val(),
                    SearchKey: $('#SearchKey').val(),
                },
                "#SearchTableResult");
    }

    $(function () {
        runAjax();
        $("#btn-Search").click(function (e) {
            runAjax();
        });
    });
</script>
