@model SEP.RoutingManagement.Models.App
@{
    ViewBag.Title = "Routing Application";
    ViewBag.Description = "Edit Routing Application: " + Model.ApplicationName;
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Edit Routing Application
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
<!-- /.modal -->
@using (Html.BeginForm("PerformEditApp", "Routing", FormMethod.Post, new { @class = "form-horizontal" }))
{
    <div class="WorkOder_Edit">
        @Html.HiddenFor(m => m.ID)
        @Html.Partial("_FormApp")
        <div class="form-actions right">
            <button type="button" class="btn default" onclick="location.href= '@Url.Action("IndexApp", "Routing")' ">
                Back
            </button>
            <a class="btn blue" data-toggle="modal" href="#ConfirmUpdate" onclick="editURL(this)">
                <i class="fa fa-check"></i>
                Update
            </a>
        </div>
        <div id="ConfirmUpdate" class="modal fade PopUpModal" tabindex="-1" data-focus-on="input:first">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" data-number="" aria-hidden="true"></button>
                        <h4 class="modal-title">Confirmation - Update This Record</h4>
                    </div>
                    <div class="modal-body">
                        <div class="well">
                            Clicking Update will update this record into the database with the latest information. If you want to discard the changes, click Close.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" data-dismiss="modal" data-number="5" class="btn default">Close</button>
                        <button class="btn blue ControlMultipleClickSubmit" data-toggle="modal" data-number="2" id="btnModalUpdateConfirmation">Update</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function editURL(element) {
        validation(element, "ConfirmUpdate");
    }
</script>

