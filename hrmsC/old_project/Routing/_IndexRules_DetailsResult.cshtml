@model List<SEP.RoutingManagement.Models.RoutingRule>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Approval
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th>

                                </th>
                                <th>
                                    Approval Name
                                </th>
                                <th>
                                    Activity Name
                                </th>
                                <th>
                                    Approval Step
                                </th>
                                <th>
                                    Assign To
                                </th>
                                <th>
                                    Last Modified Date
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Routing/PreviewRules")?ID=@item.ID">
                                            <i class="fa fa-search"></i>
                                        </a>
                                        <a class="btn yellow btn-sm" href="@Url.Content("~/Routing/EditRules")?ID=@item.ID">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    </td>
                                    <td>@item.Routing.RoutingName</td>
                                    <td>@item.ApprovalTitle</td>
                                    <td>@item.ApprovalLevel</td>
                                    <td>@item.ApprovalRole</td>
                                    <td>@TNB_ESS_MVC.Helpers.GeneralHelper.FormatDateTime(item.ModifiedDate)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>