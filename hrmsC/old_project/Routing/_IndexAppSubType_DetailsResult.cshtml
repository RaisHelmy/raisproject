@model List<SEP.RoutingManagement.Models.AppSubType>
@{
    Layout = "";
}

<table id="tbl_result" class="table table-striped table-bordered table-hover table-full-width">
    <thead>
        <tr>
            <th>

            </th>
            <th>
                Application Type Name
            </th>
            <th>
                Application Sub Type Name
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in @Model)
        {
            <tr>
                <td>
                    <a href="@Url.Action("PreviewAppSubType", "Routing", new { id = @item.ID })" class=" btn default btn-sm">
                        View
                    </a>
                    <a href="@Url.Action("EditAppSubType", "Routing", new { id = @item.ID })" class="btn blue btn-sm">
                        Edit
                    </a>
                    <a href=# onclick="showDeleteField('@item.ID');" class="btn red btn-sm ControlMultipleClick">
                        Delete
                    </a>
                </td>
                <td>@item.AppType.ApplicationTypeName</td>
                <td>@item.ApplicationSubTypeName</td>
            </tr>
        }
    </tbody>
</table>
<div id="ModalResultPopUp"></div>
<script>
    transformTable("#tbl_result");
    function showDeleteField(ID) {
        callAjax("GET",
                       "@Url.Action("DeleteAppSubType", "Routing")",
                        "html",
                        {
                            ID: ID
                        },
                        "#ModalResultPopUp");
    }

</script>
