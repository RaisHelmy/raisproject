@model SEP.RoutingManagement.Models.Sy
@{
    ViewBag.Title = "Routing System";
    ViewBag.Description = "Preview Routing System: " + Model.SystemName;
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Preview Routing System
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
<!-- /.modal -->

<div class="WorkOder_Create">
    @Html.HiddenFor(m => m.ID)
    @Html.Partial("_FormSystem")

    <div class="form-actions right">
        <button type="button" class="btn default" onclick="location.href= '@Url.Action("Index", "Routing")' ">
            Back
        </button>
        
    </div>
</div>


