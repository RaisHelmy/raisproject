@model SEP.RoutingManagement.Models.GetEmailTemplate
@{
    ViewBag.Title = "Notification Template";
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Notification Template: @Model.RoutingName
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
<!-- /.modal -->

<div class="WorkOder_Create">
    @Html.HiddenFor(m => m.EmailTemplateID)
    @Html.Partial("_FormEmail")

    <div class="row">
        <div class="col-md-12">
            <input type="button" class="btn green" value="Edit" id="btnEdit" onclick="location.href= '@Url.Action("EditEmail", "Routing", new {ID = Model.EmailTemplateID })'" />
            @*<input type="button" class="btn green" value="Back" id="btnBack" onclick="location.href= '@Url.Action("IndexEmail", "Routing")'" />*@
            <input type="button" class="btn green" value="Back" id="btnBack" onclick="window.history.back()" />
        </div>
    </div>
</div>


