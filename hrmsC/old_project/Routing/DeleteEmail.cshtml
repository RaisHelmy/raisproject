@model SEP.RoutingManagement.Models.EmailTemplate
@{
    Layout = "";
}
@using (Html.BeginForm("PerformDeleteEmail",
                            "Routing",
                            FormMethod.Post,
                            new { @class = "form-horizontal" }))
{
    <input type="hidden" id="ID" name="id" value="@Model.ID" />

    <div id="ConfirmDelete" class="modal fade PopUpModal" tabindex="-1" data-focus-on="input:first">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Click "Confirm" to delete the record.
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn red ControlMultipleClickSubmit" data-toggle="modal" id="btnModalDeleteConfirmation">Confirm</button>
                    <button type="submit" data-dismiss="modal" class="btn default">Cancel</button>
                </div>
            </div>
        </div>
    </div>


}
<script type="text/javascript">
    $(function () {
        $('#ConfirmDelete').modal('show');
    });
</script>

