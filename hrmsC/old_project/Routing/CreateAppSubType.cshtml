@model SEP.RoutingManagement.Models.AppSubType
@{
    ViewBag.Title = "Routing Application Sub Type";
    ViewBag.Description = "Create New Routing Application Sub Type";

}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Create Routing Application Sub Type
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
<!-- /.modal -->
@using (Html.BeginForm("PerformCreateAppSubType", "Routing", FormMethod.Post, new { @class = "form-horizontal" }))
{
    <div class="WorkOder_Create">
        @Html.HiddenFor(m => m.ID)
        @Html.Partial("_FormAppSubType")

        <div class="form-actions right">
            <button type="button" class="btn default" onclick="location.href= '@Url.Action("IndexAppSubType", "Routing")' ">
                Back
            </button>
            <a class="btn blue" data-toggle="modal" href="#ConfirmCreate" onclick="addURL(this)">
                <i class="fa fa-check"></i>
                Create
            </a>
        </div>
        <div class="modal fade" id="ConfirmCreate" tabindex="-1" role="basic" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                        <h4 class="modal-title">Confirmation - Create New Record</h4>
                    </div>
                    <div class="modal-body">
                        <div class="well">
                            Clicking Create will save this new record into the database. If you want to discard the changes, click Close.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn default blue" id="btnUpdateAccount">
                            <i class="fa fa-check"></i>
                            Create
                        </button>
                        <button type="button" class="btn default" data-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
}
<script>
    function addURL(element) {
        validation(element, "ConfirmCreate");
    }
</script>
