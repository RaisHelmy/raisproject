@model SEP.RoutingManagement.Models.AppType
@{
    string Disabled = "";
    bool DisabledDDL = false;
    if (ViewBag.Disabled == true)
    {
        Disabled = "disabled = 'disabled' ";
    }
    if (Model.ID != Guid.Empty)
    {
        DisabledDDL = true;
    }
}
<div class="portlet box blue">
    <div class="portlet-title">

    </div>
    <div class="portlet-body">
        <form class="form-horizontal" role="form">
            <div class="form-body">
                <div class="form-group">
                    <label class="col-md-2 control-label">Select Application</label>
                    <div class="col-md-10 ApplicationIDDiv">
                        @Html.DropDownListFor(m => m.ApplicationID,
                                (SelectList)ViewBag.ListOfApplication,
                            DisabledDDL ? (object)new
                            {
                                @class = "form-control requiredFields",
                                @id = "ApplicationID",
                                disabled = true
                            }
                            : new
                            {
                                @class = "form-control requiredFields",
                                @id = "ApplicationID"
                            })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-md-2 control-label">Application Type Name<span class="required">*</span></label>
                    <div class="col-md-10 ApplicationTypeNameDiv">
                        @Html.TextBoxFor(m => m.ApplicationTypeName,
                                ViewBag.Disabled ? (object)new
                                {
                                    @class = "form-control requiredFields",
                                    @placeholder = "Application Type Name",
                                    readOnly = true
                                }
                                : new
                                {
                                    @class = "form-control requiredFields",
                                    @placeholder = "Application Type Name"
                                })
                    </div>
                </div>
                @if (Model.ID != Guid.Empty)
                {
                    <div class="form-group">
                        <label class="col-md-2 control-label">Active</label>
                        <div class="col-md-10">
                            <div class="checkbox-list">
                                <label class="checkbox-inline">
                                    <input type="checkbox"
                                           id="Active"
                                           name="Active"
                                           value="true"
                                           checked="@Model.Active"
                                           string.empty"
                                           @Disabled />
                                </label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    </div>
</div>
