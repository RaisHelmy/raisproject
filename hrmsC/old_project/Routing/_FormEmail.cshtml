@model SEP.RoutingManagement.Models.GetEmailTemplate
@{
    string Disabled = "";
    string PeoplePicker = "PeoplePicker";
    
    if (ViewBag.Disabled == true)
    {
        Disabled = "disabled = 'disabled' ";
        PeoplePicker = "";
    }
}
<div id="HtmlBody">
    <style type="text/css">
        .hidden_1 {
            display: none;
        }
    </style>
    <div id="tab_1" class="tab-pane active">
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                    @*<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>*@
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>@Model.ApprovalTitle - @Model.NotificationType
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="row hidden">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Notification Type</label>
                                            <div class="col-md-10 form-control-static">
                                                @Html.TextBoxFor(m => m.NotificationType,
                                                    ViewBag.Disabled ? (object)new
                                                    {
                                                        @class = "form-control",
                                                        @placeholder = "Notification Type",
                                                        readOnly = true
                                                    }
                                                    : new
                                                    {
                                                        @class = "form-control",
                                                        @placeholder = "Notification Type"
                                                    })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Subject <span class="required">*</span></label>
                                            <div class="col-md-10 form-control-static SubjectDiv">
                                                @Html.TextBoxFor(m => m.Subject,
                                                    ViewBag.Disabled ? (object)new
                                                    {
                                                        @class = "form-control requiredFields",
                                                        @placeholder = "Subject",
                                                        readOnly = true
                                                    }
                                                    : new
                                                    {
                                                        @class = "form-control requiredFields",
                                                        @placeholder = "Subject"
                                                    })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">To <span class="required">*</span></label>
                                            <div class="col-md-10 form-control-static EmailToDiv">
                                                <div>
                                                    <div class=" input-group ">
                                                        <input type="text" class="form-control" id="EmailTo" name="EmailTo" readonly value="@Model.EmailTo" />
                                                        <span class="input-group-btn" style="">
                                                            <a data-toggle="modal" href="#PeoplePicker" onclick="GetActiveLink('EmailTo')" class="btn default"><i class="fa fa-user"></i></a>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">CC</label>
                                            <div class="col-md-10 form-control-static">
                                                <div>
                                                    <div class=" input-group ">
                                                        <input type="text" class="form-control" id="EmailCC" name="EmailCC" readonly value="@Model.EmailCC" />
                                                        <span class="input-group-btn" style="">
                                                            <a data-toggle="modal" href="#PeoplePicker" onclick="GetActiveLink('EmailCC')" class="btn default"><i class="fa fa-user"></i></a>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">BCC</label>
                                            <div class="col-md-10 form-control-static">
                                                <div>
                                                    <div class=" input-group ">
                                                        <input type="text" class="form-control" id="EmailBCC" name="EmailBCC" readonly value="@Model.EmailBCC" />
                                                        <span class="input-group-btn" style="">
                                                            <a data-toggle="modal" href="#PeoplePicker" onclick="GetActiveLink('EmailBCC')" class="btn default"><i class="fa fa-user"></i></a>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Body Message</label>
                                            <div class="col-md-10 form-control-static">
                                                @Html.TextAreaFor(m => m.ContentTemplate,
                                                    ViewBag.Disabled ? (object)new
                                                    {
                                                        @class = "form-control",
                                                        @placeholder = "Content Template",
                                                        readOnly = true,
                                                        @rows = 10
                                                    }
                                                    : new
                                                    {
                                                        @class = "form-control",
                                                        @placeholder = "Content Template",
                                                        @rows = 10
                                                    })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Enable Notification</label>
                                            <div class="col-md-10 form-control-static">
                                                <div class="checkbox-list">
                                                    <label class="checkbox-inline">
                                                        <input type="checkbox"
                                                               id="SendEmail"
                                                               name="SendEmail"
                                                               value="true"
                                                               checked="@Model.SendEmail"
                                                               string.empty"
                                                               @Disabled />
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
   
</div>

