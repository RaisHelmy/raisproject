@model SEP.RoutingManagement.Models.RoutingRule
@{
    ViewBag.Title = "Approval Routing";
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Activity: @Model.ApprovalTitle
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
<!-- /.modal -->

<div class="WorkOder_Create">
    @Html.HiddenFor(m => m.ID)
    @Html.Partial("_FormRules")

    <div class="row">
        <div class="col-md-12">
            <input type="button" class="btn green" value="Edit" id="btnEdit" onclick="location.href= '@Url.Action("EditRules", "Routing", new {ID = Model.ID })'" />
            @*<input type="button" class="btn green" value="Back" id="btnBack" onclick="location.href= '@Url.Action("IndexRules", "Routing")'"  />*@
            <input type="button" class="btn green" value="Back" id="btnBack" onclick="window.history.back()" />
        </div>
    </div>
</div>


