@model SEP.RoutingManagement.Models.GetEmailTemplate
@{
    ViewBag.Title = "Notification Template";
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Notification Template: @Model.RoutingName
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
<!-- /.modal -->

<div class="WorkOder_Edit">
        @Html.HiddenFor(m => m.EmailTemplateID)
        @Html.Partial("_FormEmail")


    <div class="row">
        <div class="col-md-12">
            <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="RoutingEmailValidation();" />
            @*<input type="button" class="btn green" value="Back" id="btnBack" onclick="location.href= '@Url.Action("IndexEmail", "Routing")'" />*@
            <input type="button" class="btn green" value="Back" id="btnBack" onclick="window.history.back()" />
        </div>
    </div>
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

        </p>
    </div>

    <div class="modal fade" id="ConfirmUpdate" tabindex="-1" role="basic" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Submit this Notification Template application?\n\rPress Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn default blue" id="btnSubmitForm" onclick="javascript: SubmitForm()">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well">
                        Your Medical Board application has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <button type="submit" class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
    </div>
<script>
    //office server
    //var Path = '/_layouts/15/essv2';
    //tnb server
    //var Path = '/_layouts/15/TNBESS';
    //local server
    var Path = 'http://localhost:49773';
    function RoutingEmailValidation() {

        var ValidationMsg = '';


        // Consolidate Message
        if (ValidationMsg != null && ValidationMsg != '') {
            alert(ValidationMsg);
        }
        else {
            $(".modal-body .well").html('Clicking Confirm will submit this application. If you want to make changes, click Close.');
            $("#btnOK").click(function () { RedirectTo('Submit'); });
            $("#ConfirmUpdate").modal();
        }
    }

    function SubmitForm() {
        btnSubmitForm.disabled = true;
        $("#divLoading").css("display", "block");
        var myVar = setTimeout(SubmitFormAction, 3000);
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "Submit":
                window.location.href = Path + '/Routing/IndexEmail';
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }
    function SubmitFormAction() {
        jQuery.support.cors = true;

        var _ID = document.getElementById('EmailTemplateID').value;
        var _NotificationType = document.getElementById('NotificationType').value;
        var _Subject = document.getElementById('Subject').value;
        var _EmailTo = document.getElementById('EmailTo').value;
        var _EmailCC = document.getElementById('EmailCC').value;
        var _EmailBCC = document.getElementById('EmailBCC').value;
        var _ContentTemplate = document.getElementById('ContentTemplate').value;
        var _SendEmail = document.getElementById('SendEmail').checked;

        var form = {
            ID: _ID,
            NotificationType: _NotificationType,
            Subject: _Subject,
            EmailTo: _EmailTo,
            EmailCC: _EmailCC,
            EmailBCC: _EmailBCC,
            ContentTemplate: _ContentTemplate,
            SendEmail: _SendEmail,
        };

        $.ajax({
            type: "POST",
            url: '@Url.Content("~/Routing/PerformEditEmail")',
            cache: false,
            async: false,
            dataType: "json",
            data: form,
            success: function (result) {
                if (result.Success) {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    $(".Success-body .well").html('Your Notification Template Application has been successfully submitted.');
                    $("#SuccessSubmit").modal();

                }
                else {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    btnSubmitForm.disabled = false;
                    alert(result.ErrorMsg);
                }
            },
            error: function (e) {

            }
        });

    }
</script>

