@model SEP.RoutingManagement.Models.Routing
@{
    ViewBag.Title = "Routing Route";
    ViewBag.Description = "Preview Routing Route: " + Model.RoutingName;
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Preview Routing Route
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
<!-- /.modal -->

<div class="WorkOder_Create">
    @Html.HiddenFor(m => m.ID)
    @Html.Partial("_FormRoute")

    <div class="form-actions right">
        <button type="button" class="btn default" onclick="location.href= '@Url.Action("IndexRoute", "Routing")' ">
            Back
        </button>

    </div>
</div>


