@model SEP.RoutingManagement.Models.AppSubType
@{
    string Disabled = "";
    bool DisabledDDL = false;
    if (ViewBag.Disabled == true)
    {
        Disabled = "disabled = 'disabled' ";
    }
    if (Model.ID != Guid.Empty)
    {
        DisabledDDL = true;
    }
}
<div class="portlet box blue">
    <div class="portlet-title">

    </div>
    <div class="portlet-body">
        <form class="form-horizontal" role="form">
            <div class="form-body">
                <div class="form-group">
                    <label class="col-md-2 control-label">Select Application Type</label>
                    <div class="col-md-10 ApplicationTypeIDDiv">
                        @Html.DropDownListFor(m => m.ApplicationTypeID,
                                         (SelectList)ViewBag.ListOfApplicationType,
                            DisabledDDL ? (object)new
                            {
                                @class = "form-control requiredFields",
                                @id = "Application Type ID",
                                disabled = true
                            }
                            : new
                            {
                                @class = "form-control requiredFields",
                                @id = "Application Type ID"
                            })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-md-2 control-label">Application Sub Type Name<span class="required">*</span></label>
                    <div class="col-md-10 ApplicationTypeNameDiv">
                        @Html.TextBoxFor(m => m.ApplicationSubTypeName,
                                ViewBag.Disabled ? (object)new
                                {
                                    @class = "form-control requiredFields",
                                    @placeholder = "Application Sub Type Name",
                                    readOnly = true
                                }
                                : new
                                {
                                    @class = "form-control requiredFields",
                                    @placeholder = "Application Sub Type Name",
                                })
                    </div>
                </div>
                @if (Model.ID != Guid.Empty)
                {
                    <div class="form-group">
                        <label class="col-md-2 control-label">Active</label>
                        <div class="col-md-10">
                            <div class="checkbox-list">
                                <label class="checkbox-inline">
                                    <input type="checkbox"
                                           id="Active"
                                           name="Active"
                                           value="true"
                                           checked="@Model.Active"
                                           string.empty"
                                           @Disabled />
                                </label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    </div>
</div>
