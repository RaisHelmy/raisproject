<input type="hidden" id="hiddenTextID" />
<script type="text/javascript">
    function SetSelectedEmployee() {
        var selectedValue = "";
        var hiddenTextID = $("#hiddenTextID").val();
        $(".SelectEmployeeRole input[type=checkbox]").each(function () {
            var _selected = $(this).prop("checked");

            if (_selected) {
                var a = $("#" + $(this).attr("id")).val();
                selectedValue += a + ", ";

            }
        });
        $("#" + hiddenTextID).val(selectedValue.slice(0, -2));
        $('#PeoplePicker').modal('toggle');
    }
    function GetActiveLink(textID) {
        $("#hiddenTextID").val(textID);

        $(".SelectEmployeeRole input[type=checkbox]").each(function () {
            //   $(this).prop('checked', false);
            var _selected = $(this).attr("id");
            $('#' + _selected).parent().removeClass("checked");
            $('#' + _selected).prop('checked', false);

        });
        if ($("#" + textID).val() != "") {
            var array = $("#" + textID).val().split(",");
            for (i = 0; i < array.length; ++i) {
                var _selected = 'Enable' + $.trim(array[i]);
                $('#' + _selected).parent().addClass("checked");
                $('#' + _selected).prop('checked', true);
            }
        }
    }
