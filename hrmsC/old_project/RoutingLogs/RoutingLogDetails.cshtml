@model RoutingLogs.Models.RoutingLog
@using RoutingLogs.Controllers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Routing Logs Details";

}

<div class="row">&nbsp;</div>
<div id="RoutingLogsDetails" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Routing Log Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-10">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        System Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.SystemName)
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Application Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.ApplicationName)
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Application Type Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.ApplicationTypeName)

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Application SubType Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.ApplicationSubTypeName)
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Reference No.
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <a href="@Url.Content(Model.FormLink)">
                                            @RoutingLogsController.DisplayHelper(Model.ReferenceNo)
                                        </a>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Created Date
                                    </label>
                                    @if (Model.CreatedDate.HasValue)
                                    {
                                        <div class="col-md-8  form-control-static">
                                            @RoutingLogsController.DisplayHelper(Model.CreatedDate.Value.ToString("dd-MM-yyyy hh:mm:ss tt"))
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-8  form-control-static">
                                            <span>-</span>
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Routing Element Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">
                                        Result
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.Result.Value.ToString())
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">
                                        Routing Created
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.RoutingCreated.ToString())
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5 ">
                                        Routing Rule Created
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.RoutingRuleCreated.ToString())

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Email Enabled
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.EmailEnabled.ToString())
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Email Sent
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.EmailSent.ToString())
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Approver Found
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.ApproverFound.ToString())
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Status
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.Status)
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Current Stage Completed
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.CurrentStageCompleted.ToString())
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Next Approval Level
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.NextApprovalLevel.ToString())
                                    </div>
                                </div>
                                @*<div class="form-group">
                                    <label class="control-label col-md-4">
                                        Next Routing Rule ID
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.NextRoutingRuleID.ToString()
                                    </div>
                                </div>*@
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Next Yes Status
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.NextYesStatus)
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Next No Status
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @RoutingLogsController.DisplayHelper(Model.NextNoStatus)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            <label class="control-label col-md-2">
                                Error Message
                            </label>
                            <div class="col-md-10 form-control-static">
                                <textarea readonly="readonly" style="width: 880px; height:100px; ">
                                    @if (!String.IsNullOrEmpty(Model.ErrMessage))
                                    {
                                        @Model.ErrMessage
                                    }
                                </textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        @if (Model.Result == false && Model.Restarted == false)
        {
            <input type="button" class="btn green" value="Restart Routing" id="btnSubmit" onclick="SubmitForm();" />
        }
        <a class="btn green" value="Back" id="btnBack" href="@Url.Action("Index","RoutingLogs")">Back</a>
    </div>
</div>

<!-- Success Message -->
<div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well" id="SuccessMessage">
                    Routing has been successfully restarted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <a class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Message -->
<div class="modal fade" id="ConfirmSubmit" tabindex="-1" role="basic" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Confirmation</h4>
            </div>
            <div class="modal-body">
                <div class="well" id="ConfirmMessage">
                    Are you sure you want to restart this Route?
                    <br />
                    Press Confirm to proceed, or Close to stay on the current page.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn default blue" id="btnSubmitForm" submitvalue="" onclick="RestartRouting();"> <!--RestartRouting();-->
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed;
    right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
    </p>
</div>

<script>


    function SubmitForm() {
        $('#ConfirmSubmit').modal();
    }

    function RestartRouting() {
        var RestartRoutingID = '@Model.RoutingRestartID';

        $('#ConfirmSubmit').modal('hide');
        $('#divLoading').show();
        $.ajax({
            url: '@Url.Content("~/RoutingLogs/RestartRouting")',
            type: 'POST',
            data: {
                RoutingRestartID: RestartRoutingID
            },
            success: function (result) {
                $('#divLoading').hide();

                if (result.Result == true) {

                    $('#actionText').html('Routing has been successfully restarted.');
                    $('#SuccessSubmit').modal();
                    $('#btnOK').attr('href', '@Url.Content(Model.FormLink)');
                } else {
                    alert(result.ErrMessage || "Failed to restart routing.");
                }
            }
        });
    }
</script>