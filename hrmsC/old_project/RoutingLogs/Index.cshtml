
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Routing Logs";

    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");

    DateTime d3 = DateTime.Now;
    string dtStart = d3.AddMonths(-2).ToString("dd/MM/yyyy");
    string dtDefault = d3.ToString("dd/MM/yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Routing Logs<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Start Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="StartDate" name="StartDate" value="@dtStart" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">End Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="EndDate" name="EndDate" value="@dtDefault" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Reference No.</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" id="RefNo" name="RefNo" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Result" name="Result">
                            <option value="0" selected="selected">Not Resolved</option>
                            <option value="1">Resolved</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @*<div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Result</label>
                        <div class="col-md-8 form-control-static">
                            <select class="form-control" id="Result" name="Result">
                                <option value="0" selected="selected">Failed</option>
                                <option value="1">Completed</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>*@
    </div>

    <div class="row">

    </div>

    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>

<script>

    function SearchListing() {
        var _DateFrom = $('#StartDate').val();
        var _DateTo = $('#EndDate').val();
        var _RefNo = $('#RefNo').val();
        var _Result = $('#Result').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Action("_RoutingLogsListingResult", "RoutingLogs")',
            cache: false,
            dataType: "html",
            data: {
                StartDate: _DateFrom,
                EndDate: _DateTo,
                RefNo: _RefNo,
                Result: _Result
            },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        });
    });

    function ClearFilter() {
        $('#StartDate').val('');
        $('#EndDate').val('');
        $('#RefNo').val('');
        //$('#Result').val('');
        SearchListing();
    }
</script>