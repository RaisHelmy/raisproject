@model List<ESS.Core.PeoplePickerObject>

@{
    Layout = null;
}

<div class="table-toolbar">
    <table id="tblPeoplePicker" class="table table-striped table-bordered table-hover table-full-width">
        <thead>
            <tr>
                <th></th>
                <th>Employee Number</th>
                <th>Employee Name</th>
                <th>Department</th>
                <th>Unit/Section</th>
                <th>Position</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in @Model)
            {
                <tr>
                    <td><input type="radio" name="pp" value="@item.EmployeeID" 
                                             empname="@item.EmployeeName" 
                                             empcode="@item.EmployeeCode" 
                                             emp_position="@item.PositionCode - @item.Position" /></td>
                    <td>@item.EmployeeCode</td>
                    <td>@item.EmployeeName</td>
                    <td>@item.Department</td>
                    <td>@item.UnitSection</td>
                    <td>@item.Position</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@Html.Partial("_includeDataTableScripts")
<script>
    transformTable("#tblPeoplePicker");
</script>
