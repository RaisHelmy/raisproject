@model IEnumerable<ESS.ChargeCode.Models.ChargeCode>

@{
    ViewBag.Title = "Charge Code Favourite Group";
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            View Charge Codes<span style="padding-left:20px;"><small></small></span>
        </h1>

    </div>
</div>

<div class="portlet box green">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Charge Code Favourite Groups
        </div>s
    </div>

    <div class="portlet-body form">
        <div class="form-horizontal">
            <div class="form-body">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.ChargeType)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ChargeCodes)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ChargeCodeDesc)
                            </th>
                            <th></th>
                        </tr>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ChargeType)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ChargeCodes)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ChargeCodeDesc)
                                </td>
                                <td>
                                    @*@Html.ActionLink("Edit", "Edit", new { id=item.ID }) |
                                        @Html.ActionLink("Details", "Details", new { id=item.ID }) |
                                        @Html.ActionLink("Delete", "Delete", new { id=item.ID })*@
                                </td>
                            </tr>
                        }

                    </table>

                    @*  *@
                </div>
            </div>
        </div>
    </div>
</div>