@model Integrity.IntegrityPledge.Models.PledgeVM

<div id="declarationBox" class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Declarations
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <input type="hidden" name="Declaration"  value="@Model.Declaration" />
                <div id="declarationContent" class="col-md-12">
                    @Html.Raw(Model.Declaration)
                </div>
            </div>
        </div>
    </div>
</div>