@model Integrity.IntegrityPledge.Models.PledgeVM
@{
    Layout = null;
}

<style>
    .col-radio-left {
        padding-right: 0px;
    }

    .col-radio-both {
        padding-left: 0px;
        padding-right: 0px;
    }
</style>
<input type="hidden" name="DeclarationID" value="@Model.DeclarationID" />

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Request Details
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Reference No</label>
                            <div class="col-md-8 form-control-static">
                                <input type="text" class="form-control ReferenceNo" name="ReferenceNo"
                                       readonly="readonly" value="@Model.ReferenceNo" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Status</label>
                            <div class="col-md-8 form-control-static">
                                <input type="text" class="form-control Status" name="Status"
                                       readonly="readonly"
                                       value="@Model.Status" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Category</label>
                            <div class="col-md-8 form-control-static">
                                @*<select class="form-control Category" name="Category"
                                            onchange="OnCategoryChanged()"
                                            @(Model.CanEdit ? "" : "disabled")>
                                        <option value="" @(Model.Category == "" ? "selected='selected'" : "")>- Select Category -</option>
                                        @{
                                            var options = Integrity.IntegrityPledge.PledgeService.SPGetPledgeCategory();
                                            foreach (var opt in options)
                                            {
                                                <option value="@opt"
                                                        @(Model.Category == opt ? "selected='selected'" : "")>@opt</option>
                                            }
                                        }
                                    </select>*@
                                <input type="text" class="form-control" name="Category"
                                       readonly="readonly" value="@Model.Category" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Current Approver</label>
                            <div class="col-md-8 form-control-static">
                                <input type="text" class="form-control"
                                       readonly="readonly" value="@Model.GetCurrentApprover()" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-offset-6 col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Email Address</label>
                            <div class="col-md-8 form-control-static">
                                <input type="text" class="form-control" name="EmailAddress"
                                       value="@Model.EmployeeDetails.EmailAddress"
                                       readonly="readonly" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">Contact No</label>
                            <div class="col-md-8 form-control-static">
                                <input type="text" class="form-control" name="ContactNo"
                                       value="@Model.EmployeeDetails.ContactNo"
                                       readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var _allDeclarations = @Html.Raw(Json.Encode(Model.AllDeclarations));

    $(function () {
        OnCategoryChanged();
    });

    function OnCategoryChanged() {
        var declarationObj = _allDeclarations[$('[name="Category"]').val()];
        var language = $('[name=Language]').val();
        var declaration = language == 'BI' ? declarationObj.DeclarationBI : declarationObj.DeclarationBM;

        if (declaration) {
            $('#declarationBox').show();
            $('input[name="Declaration"]').val(declaration)
            $('#declarationContent').html(declaration);
        }
        else {
            $('#declarationBox').hide();
            $('input[name="Declaration"]').val("")
            $('#declarationContent').html("");
        }
    }
</script>