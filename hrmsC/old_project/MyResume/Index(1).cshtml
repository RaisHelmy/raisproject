<script>

    function confirmationModal(confirmationText, callback) {

        var promise = $.Deferred();
        $("#confirmationAction").text(confirmationText);
        $("#ResumeConfirmationModal").modal();

        $("#btnConfirmAction").on('click', function () {

            if (callback != "undefined" && callback != null)
                callback(true);
            promise.resolve();
            $("#ResumeConfirmationModal").modal('hide');
        });

        $("#btnCloseAction").on('click', function () {
            if (callback != "undefined" && callback != null)
                callback(false);
            promise.reject();
            $("#ResumeConfirmationModal").modal('hide');
        });

        return promise;
    }

    function displaySuccessModal(successMessage) {
        if (successMessage) {
            $("#SuccessResultModalBody").text(successMessage);
        }

        $("#SuccessResultModal").modal();

        $("#btnSuccessOK").on('click', function () {
            ShowLoading();
            location.reload();
        });
    }

    $(document).ready(function () {
        $('.arrow-down:not(:first)').removeClass('collapse').addClass('expand');
        $('.portlet-body:not(:first)').hide();
    });

    $(document).on('click', '.partial-show', function () {
        var portlet = $(this).closest('.portlet');
        onPartialViewLoad(portlet);
    });

    function onPartialViewLoad(portlet) {
        if (portlet.data('loaded') == 'true')
            return;

        var url = portlet.data('url');
        var container = portlet.find('.portlet-body');
        LoadPartialView(container, url);
        portlet.data('loaded', 'true');
    }

    function LoadPartialView(container, url) {
        container.html("LOADING...");
        $.ajax({
            type: "GET",
            url: url,
            cache: false,
            dataType: "html",
            success: function (content) {
                container.html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }


    function ShowLoading() {
        $("#divLoading").show();
    }

    function HideLoading() {
        $("#divLoading").hide();
    }

    $(document).ajaxStop(HideLoading);
    $(document).ajaxComplete(HideLoading);
    $(document).ajaxError(HideLoading);
    $(document).ajaxSuccess(HideLoading);

    function UpdateSpecialization(data) {
        console.log(data);
        ShowLoading();
        $.ajax({
            url: '@Url.Action("UpdateSpecialization")',
            data: data,
            success: function (response) {
                if (response.Success) {
                    displaySuccessModal(response.Message);
                }
                else {
                    alert(response.Message);
                }
            }
        });
    }

    function DeleteSpecialization(Id) {
        var promise = confirmationModal('delete this item', null);
        promise.done(function () {
             ShowLoading();
             $.ajax({
                 url: '@Url.Action("DeleteSpecialization")',
                 data: { Id: Id },
                success: function (response) {
                    if (response.Success) {
                        displaySuccessModal(response.Message);
                    }
                    else {
                        alert(response.Message);
                    }
                }
            });
        });
    }

    function PopulateTreeView(location, source, nodeSelectedCallback, jsonData) {
        if (jsonData == "undefined" || jsonData == null) {
            //setTimeout(ShowLoading, 500); 
            $.ajax({
            url: '@Url.Action("GetSpecializationTreeView")',
            data: { Source : source},
            success: function (result) {
                $(location).jstree({
                    'types': {
                        "root": {
                            "icon": "glyphicon glyphicon-plus"
                        },
                        "child": {
                            "icon": "glyphicon glyphicon-book"
                        }
                    },
                    'core': {
                        'data': result.Data,
                        "themes": {
                            "variant": "large"
                        }
                    },
                    "plugins": ["search", "themes", "types"]
                }).on('changed.jstree', function (e, data) {

                    if (data.node.type == "child") {
                        nodeSelectedCallback(data);
                    }
                });
            },
            error: function (err) {
                alert(error);
            }
            }).always(HideLoading);
        }
        else {
            console.log('data passed to tree view');
            $(location).jstree({
                'types': {
                    "root": {
                        "icon": "glyphicon glyphicon-plus"
                    },
                    "child": {
                        "icon": "glyphicon glyphicon-book"
                    }
                },
                'core': {
                    'data': jsonData,
                    "themes": {
                        "variant": "large"
                    }
                },
                "plugins": ["search", "themes", "types"]
            }).on('changed.jstree', function (e, data) {

                if (data.node.type == "child") {
                    nodeSelectedCallback(data);
                }
            });
        }

    }

