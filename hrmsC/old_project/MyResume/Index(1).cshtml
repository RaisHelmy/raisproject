    function PopulateSetting(divMode, divMain, LogDiv, Setting_FieldVisible, Setting_FieldEnable, Setting_FieldChecked, Setting_FieldValue) {

        divMain = $.trim(divMain);
        divMode = $.trim(divMode);
        var PopulateSettingLog = "";
        PopulateSettingLog += "DivMode: " + divMode + "; ";
        PopulateSettingLog += "DivMain: " + divMain + "; ";
        PopulateSettingLog += "Log: " + LogDiv + "; " + "\n";

        //var ddlRelationshipType = $('#ddlRelationshipType');
        if (Setting_FieldVisible != null) {
            var i = 0;
            PopulateSettingLog += "Setting: Setting_FieldVisible" + "\n";
            PopulateSettingLog += "-----------Start---------------" + "\n";
            for (i = 0; i < Setting_FieldVisible.length; i++) {

                var checkdivMode = divMode;
                var checkConfirmation = Setting_FieldVisible[i].ConfirmationButton + "";
                var checkVisible = Setting_FieldVisible[i].Visible + "";
                var checkVisibleName = Setting_FieldVisible[i].Name;
                checkVisibleName = $.trim(checkVisibleName);

                PopulateSettingLog += "No: " + i + "; "
                PopulateSettingLog += "Name: " + Setting_FieldVisible[i].Name + "; "
                PopulateSettingLog += "Visible: " + Setting_FieldVisible[i].Visible + "; ";
                PopulateSettingLog += "ConfirmationButton: " + Setting_FieldVisible[i].ConfirmationButton + "; ";

                if (checkConfirmation.toUpperCase() == "TRUE") {
                    checkdivMode = "";
                }

                PopulateSettingLog += "Final divMode: " + checkdivMode + "; ";
                PopulateSettingLog += "Final Name: " + divMain + " ." + checkVisibleName + checkdivMode + "; ";

                if (checkVisible.toUpperCase() == "TRUE") {
                    //show it
                    // check if the hidden properties is added before
                    // if yes, remove hidden class
                    PopulateSettingLog += "Check Visible: TRUE" + "; ";

                    $(divMain + " ." + checkVisibleName + checkdivMode).each(function (i, obj) {
                        PopulateSettingLog += "HAS CLASS HIDDEN: " + $(this).hasClass("hidden") + "; ";
                        if ($(this).hasClass("hidden")) {
                            $(this).removeClass("hidden");
                            PopulateSettingLog += "Remove Hidden Class" + "; ";
                        }
                    });


                }
                else {
                    //hide it.

                    PopulateSettingLog += "Check Visible: False" + "; ";
                    // check if the hidden properties is added before
                    // if not, add hidden class
                    $(divMain + " ." + checkVisibleName + checkdivMode).each(function (i, obj) {
                        PopulateSettingLog += "DO NOT HAS CLASS HIDDEN: " + $(this).hasClass("hidden") + "; ";
                        if (!($(this).hasClass("hidden"))) {
                            $(this).addClass("hidden");
                            //alert("False-OK");
                            PopulateSettingLog += "Add Hidden Class" + "; ";
                        }
                    });

                }

                PopulateSettingLog += "\n";
            }

            PopulateSettingLog += "\n" + "-----------End------------------" + "\n \n";
        }

        if (Setting_FieldEnable != null) {
            var j = 0;
            PopulateSettingLog += "Setting: Setting_FieldEnable" + "\n";
            PopulateSettingLog += "-----------Start---------------" + "\n";
            for (j = 0; j < Setting_FieldEnable.length; j++) {

                var checkdivMode = divMode;
                var checkEnable = Setting_FieldEnable[j].Enable + "";
                var checkEnableName = Setting_FieldEnable[j].Name;
                checkEnableName = $.trim(checkEnableName);
                var FinalName1 = divMain + " #" + checkEnableName;
                var FinalName2 = divMain + " #uniform-" + checkEnableName;

                PopulateSettingLog += "No: " + j + "; "
                PopulateSettingLog += "Name: " + Setting_FieldEnable[j].Name + "; "
                PopulateSettingLog += "Enable: " + Setting_FieldEnable[j].Enable + "; ";

                PopulateSettingLog += "Final divMode: " + checkdivMode + "; ";
                PopulateSettingLog += "Final Name1: " + FinalName1 + "; ";
                PopulateSettingLog += "Final Name2: " + FinalName2 + "; ";

                if (checkEnable.toUpperCase() == "TRUE") {
                    //enable it
                    // check if the enable properties is added before
                    // if yes, remove enable class
                    PopulateSettingLog += "Check Enable: TRUE" + "; ";

                    PopulateSettingLog += "Check Has Disabled Attribute (YES):" + $(FinalName1).is(':disabled') + "; ";

                    if ($(FinalName1).is(':disabled')) {
                        $(FinalName1).removeAttr("disabled");
                        PopulateSettingLog += "Remove Main Disabled Attribute" + "; ";
                    }

                    if ($(FinalName2).hasClass("disabled")) {
                        $(FinalName2).removeClass("disabled");
                        PopulateSettingLog += "Remove Sub Disabled Attribute" + "; ";
                    }
                }
                else {
                    //hide it.

                    PopulateSettingLog += "Check Enable: False" + "; ";
                    PopulateSettingLog += "Check Has Disabled Attribute (NO):" + $(FinalName1).is(':disabled') + "; ";
                    // check if the enable properties is added before
                    // if not, add enable class
                    if (!$(FinalName1).is(':disabled')) {
                        $(FinalName1).attr('disabled', 'disabled');
                        PopulateSettingLog += "Add Main Disabled Attribute" + "; ";
                    }

                    if (!$(FinalName2).hasClass("disabled")) {
                        $(FinalName2).addClass("disabled");
                        PopulateSettingLog += "Add Sub Disabled Attribute" + "; ";
                    }
                }

                PopulateSettingLog += "\n";
            }

            PopulateSettingLog += "\n" + "-----------End------------------" + "\n \n";
        }



        if (Setting_FieldChecked != null) {
            var k = 0;

            for (k = 0; k < Setting_FieldChecked.length; k++) {
                var checkChecked = Setting_FieldChecked[k].Checked + "";
                var checkCheckedName = Setting_FieldChecked[k].Name;
                checkCheckedName = $.trim(checkCheckedName);

                if (checkChecked.toUpperCase() == "TRUE") {
                    //is checked

                    // check if the checked properties is added before
                    // if not, checked it
                    if (!$(divMain + " #" + checkCheckedName).is(":checked")) {
                        $(divMain + " #" + checkCheckedName).attr('checked');
                    }
                    else {
                        // is not checked
                        // check if the checked properties is added before
                        // if yes, remove enable class
                        if ($(divMain + " #" + checkCheckedName).is(":checked")) {
                            $(divMain + " #" + checkCheckedName).removeAttr("checked");
                        }
                    }
                }
            }
        }

        if (Setting_FieldValue != null) {
            var m = 0;
            PopulateSettingLog += "Setting: Setting_FieldValue" + "\n";
            PopulateSettingLog += "-----------Start---------------" + "\n";
            for (m = 0; m < Setting_FieldValue.length; m++) {

                var checkName = Setting_FieldValue[m].Name;
                var checkValue = Setting_FieldValue[m].Value + "";
                var checkType = Setting_FieldValue[m].Type + "";

                checkName = $.trim(checkName);
                var FinalName = divMain + " #" + checkName;
                PopulateSettingLog += "No: " + m + "; "
                PopulateSettingLog += "Name: " + checkName + "; "
                PopulateSettingLog += "Value: " + checkValue + "; ";
                PopulateSettingLog += "Type: " + checkType + "; ";
                PopulateSettingLog += "Final Name: " + FinalName + "; ";

                if (checkType.toUpperCase() == "DROPDOWNLIST") {
                    PopulateSettingLog += "DROPDOWNLIST : TRUE" + "; ";

                    $(FinalName).val(checkValue).change();
                }
                else if (checkType.toUpperCase() == "TEXTBOX") {
                    PopulateSettingLog += "TEXTBOX : TRUE" + "; ";

                    $(FinalName).val(checkValue);
                }

                PopulateSettingLog += "\n";
            }

            PopulateSettingLog += "\n" + "-----------End------------------" + "\n \n";
        }

        $(LogDiv).val(PopulateSettingLog);
    }

    function makeDataTable(tableId) {
        var oTable =  $("#" +tableId).dataTable({
            "aLengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]],
            "bPaginate": false
        });

        var tableWrapper = "#" + tableId + "_wrapper";

        jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
        jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
        jQuery(tableWrapper + ' .dataTables_length select').select2({
            showSearchInput: false //hide search box with special css class
        });

        return oTable;
    }

    $("#btnSendCV").click(function () {
        confirmationModal('send CV to EHRMS', sendCV);
    });

    function sendCV(confirmed) {
        if (!confirmed)
            return;

        $.ajax({
            url: '@Url.Action("SendCV", "MyResume")',
            success: function (response) {
                if (response.Success) {
                    displaySuccessModal(response.Message);
                }
                else {
                    alert(response.Message);
                }
                console.log(response.TechnicalError);
            }
        });
    }
