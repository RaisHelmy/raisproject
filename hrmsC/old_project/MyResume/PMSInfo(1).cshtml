@model List<OJA.Models.PMS>
@{
    Layout = null;
}



<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>PMS Info
                </div>
                <div class="tools">
                    <a style="margin-left:10px" href="javascript:;" class="expand arrow-down">
                    </a>
                </div>
            </div>

            <div class="portlet-body form" style="display:none">
                <div class="form-horizontal">
                    <div class="form-body">
                        <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                            <thead>
                                <tr>
                                    @foreach (var item in Model)
                                    {
                                        <th>@item.Year</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Count == 0)
                                {
                                    <tr>
                                        No history available.
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        @foreach (var item in Model)
                                        {
                                            @*<td>@(string.IsNullOrEmpty(item.PMSRating) ? "N/A" : item.PMSRating)</td>*@
                                            <td>

                                                @if (string.IsNullOrEmpty(item.PMSRating))
                                                {
                                                    @: N/A
                                            }
                                                else
                                                {
                                                    var PMSRating = item.PMSRating;
                                                    var kpi_index = PMSRating.IndexOf("Competency");

                                                    var kpi = string.Empty;
                                                    var competency = string.Empty;
                                                    string[] split = PMSRating.Split('\n');
                                                    if(split.Length == 2)
                                                    {
                                                        kpi = split[0];
                                                        competency = split[1];
                                                    }
                                                    else if(split.Length == 1 && split[0].Contains("KPI"))
                                                    {
                                                        kpi = split[0];
                                                    }
                                                    else if(split.Length == 1 && split[0].Contains("Competency"))
                                                    {
                                                        competency = split[0];
                                                    }


                                                    //if (PMSRating.Contains("KPI"))
                                                    //{
                                                    //    kpi = PMSRating.Substring(0, PMSRating.IndexOf("Competency"));
                                                    //}

                                                    //if (PMSRating.Contains("Competency"))
                                                    //{
                                                    //    competency = PMSRating.Substring(PMSRating.IndexOf("Competency"), PMSRating.Length - PMSRating.IndexOf("Competency"));
                                                    //}

                                                    @kpi <br />
                                                    @competency
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>