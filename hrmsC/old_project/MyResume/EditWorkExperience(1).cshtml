@model OJA.Models.WorkExperience
@{ 
    Layout = null;
    var ReadMode = ViewBag.ReadMode;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Edit Work Experience
                </div>
            </div>

            <div class="portlet-body form">
                <div class="form-body">
                    <div class="form-horizontal" id="workExperienceForm">
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Position (Job)
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.PositionName" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Position Grade
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.PositionGrade" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Pay Scale Group
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.PayscaleGroup" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Company
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.CompanyCode - @Model.CompanyName" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Division / Department
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.AreaName" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Unit / Section
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.SubAreaName" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Action
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.Action" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Start Date
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.StartDate" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                End Date
                            </label>
                            <div class="col-md-6 form-control-static">
                                <input class="form-control" value="@Model.EndDate" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Task
                            </label>
                            <div class="col-md-6 form-control-static">
                                <textarea class="form-control editable" id="Task" name="Task" @ReadMode>@Model.Task</textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                Management/Leadership Experience
                            </label>
                            <div class="col-md-6 form-control-static">
                                <textarea class="form-control editable" id="LeadershipExperience" name="LeadershipExperience" @ReadMode>@Model.LeadershipExperience</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn blue" id="btnEditWorkExperience">Edit</button>
    <button type="button" class="btn blue hidden" id="btnUpdateWorkExperience">Update</button>
    <button type="button" class="btn default" data-dismiss="modal">Close</button>
</div>