@model ESS.Employee.Models.FamilyInfo
@using ESS.Employee.Models;
@using OJA.Models;
@using ESS.Employee;
@{
    Layout = null;
    var ReadOnly = true;
}
<div id="_FamilyInfo" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Family Info
                </div>
            </div>
            <div class="portlet-body form" id="SearchGet_FamilyInfo">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group divRelationshipType">
                                    <label class="control-label col-md-4 ">
                                        Relationship Type<span class="required spanRelationshipTypeRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" name="RelationshipTypeCode" id="RelationshipTypeCode" value="@Model.RelationshipTypeCode" />
                                        
                                            <input type="text" class="form-control" id="RelationshipTypeName" name="RelationshipTypeName" value="@Model.RelationshipType" readonly="readonly" />
                                         

                                    </div>
                                </div>
                                <div class="form-group divGender">
                                    <label class="control-label col-md-4 ">
                                        Gender
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenGender" id="HiddenGender" value="@Model.Gender">
                                        <input type="hidden" name="GenderCode" id="GenderCode" value="@Model.GenderCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="GenderName" name="GenderName" value="@Model.Gender"  />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="GenderName" id="GenderName" value="@Model.Gender" />
                                            <select tabindex="0" id="ddlGender" class="form-control" ></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divName">
                                    <label class="control-label col-md-4 ">
                                        Name <span class="required spanFamilyNameRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" MaxLength="80"
                                               name="FamilyName" value="@Model.Name" pattern="\d{1,5}" id="FamilyName" >
                                        <input type="hidden" class="form-control"
                                               name="HiddenFamilyName" value="@Model.Name" id="HiddenFamilyName">
                                    </div>
                                </div>
                                <div class="form-group divNewICNo">
                                    <label class="control-label col-md-4 ">
                                        New IC/ Police/ Military No.
                                        <span class="required spanNewICNoRequired" id="spanNewICNoRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" MaxLength="12"
                                               name="NewICNo" value="@Model.NewICNo" id="NewICNo" >
                                        <input type="hidden" class="form-control"
                                               name="HiddenNewICNo" id="HiddenNewICNo" value="@Model.NewICNo">

                                        <input type="hidden" class="form-control"
                                               name="HiddenNewICNo_Name" id="HiddenNewICNo_Name" value="New IC No">
                                    </div>
                                </div>
                                <div class="form-group divOldICNo">
                                    <label class="control-label col-md-4 ">
                                        Old IC No
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" MaxLength="20"
                                               name="OldICNo" value="@Model.OldICNo" id="OldICNo" >
                                        <input type="hidden" class="form-control"
                                               name="HiddenOldICNo" id="HiddenOldICNo" value="@Model.OldICNo">
                                    </div>
                                </div>
                                <div class="form-group divPassportNo">
                                    <label class="control-label col-md-4 ">
                                        Passport No.
                                        <span class="required spanPassportNoRequired" id="spanPassportNoRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" MaxLength="20"
                                               name="PassportNo" value="@Model.PassportNo" id="PassportNo" >
                                        <input type="hidden" class="form-control"
                                               name="HiddenPassportNo" id="HiddenPassportNo" value="@Model.PassportNo">
                                    </div>
                                </div>
                                <div class="form-group divNationality divNationalityEdit">
                                    <label class="control-label col-md-4 ">
                                        Nationality <span class="required spanNationalityRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenNationality" id="HiddenNationality" value="@Model.Nationality">
                                        <input type="hidden" name="NationalityCode" id="NationalityCode" value="@Model.NationalityCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="NationalityName" name="NationalityName" value="@Model.Nationality"  />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="NationalityName" id="NationalityName" value="@Model.Nationality" />
                                            <select tabindex="0" id="ddlNationality" class="form-control" onchange="Checking('');" ></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divDateOfDeath">
                                    <label class="control-label col-md-4 ">
                                        Date of Death
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="DateOfDeath" name="DateOfDeath" value="@Service.FormatDateInNumber(Model.DateOfDeath, "dd/MM/yyyy")" readonly="readonly" />
                                        }
                                        else
                                        {
                                            <div class="input-group date date-picker" id="boxDateOfDeath" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control DateOfDeath"
                                                       id="DateOfDeath" name="DateOfDeath" value="@Service.FormatDateInNumber(Model.DateOfDeath, "dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnDateOfDeath" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        }
                                        <input type="hidden" class="form-control"
                                               name="HiddenDateOfDeath" id="HiddenDateOfDeath" value="@Service.FormatDateInNumber(Model.DateOfDeath, "dd/MM/yyyy")">

                                    </div>
                                </div>
                                
                                @if (Model.RelationshipType == RelationshipType.Child.ToString())
                                {
                                    <div class="form-group divDateOfAdoption divDateOfAdoptionInsert divDateOfAdoptionEdit">
                                        <label class="control-label col-md-4 ">
                                            Date of Adoption
                                        </label>
                                        <div class="col-md-8  form-control-static">
                                            @if (ReadOnly)
                                            {
                                                <input type="text" class="form-control" id="DateOfAdoption" name="DateOfAdoption" value="@Service.FormatDateInNumber(Model.DateOfAdoption, "dd/MM/yyyy")" readonly="readonly" />
                                            }
                                            else
                                            {
                                                <div class="input-group date date-picker" id="boxDateOfAdoption" data-date-format="dd/mm/yyyy">
                                                    <input type="text" class="form-control DateOfAdoption"
                                                           id="DateOfAdoption" name="DateOfAdoption" value="@Service.FormatDateInNumber(Model.DateOfAdoption, "dd/MM/yyyy")" />
                                                    <span class="input-group-btn">
                                                        <button type="button" id="btnDateOfAdoption" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            }
                                            <input type="hidden" class="form-control"
                                                   name="HiddenDateOfAdoption" id="HiddenDateOfAdoption" value="@Service.FormatDateInNumber(Model.DateOfAdoption, "dd/MM/yyyy")">
                                        </div>
                                    </div>
                                }

                                <div class="form-group divEligibleForMedical divEligibleForMedicalInsert divEligibleForMedicalEdit">
                                    <label class="control-label col-md-4 ">
                                        Eligible For Medical
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <div class="checkbox-list">
                                            @{
                                                string CheckMedical = "";
                                                string boolMedical = "false";
                                                if (Model.EligibleForMedical.HasValue)
                                                {
                                                    if (Model.EligibleForMedical.Value)
                                                    {
                                                        CheckMedical = "Checked";
                                                    }
                                                    boolMedical = Model.EligibleForMedical + "";
                                                }
                                            }
                                            <input type="checkbox" id="chkMedical" @CheckMedical disabled>
                                        </div>


                                        <input type="hidden" class="form-control"
                                               name="HiddenMedical" id="HiddenMedical" value="@boolMedical">
                                    </div>
                                </div>
                                @if (Model.RelationshipType == RelationshipType.Spouse.ToString())
                                {
                                    <div class="form-group divEmployerName divEmployerNameInsert divEmployerNameEdit">
                                        <label class="control-label col-md-4 ">
                                            Employer Name
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            @if (ReadOnly)
                                            {
                                                <input type="text" class="form-control" id="EmployerName" name="EmployerName" value="@Model.EmployerName" />
                                            }
                                            else
                                            {
                                                <div class="radio-list">
                                                    <label>
                                                        <input type="radio" name="EmployerName" id="EmployerName_0" value="0"> TNB / TNB Subsidiaries
                                                    </label>
                                                    <label>
                                                        <input type="radio" name="EmployerName" id="EmployerName_1" value="1"> Others <span id="SpanOtherEmployerName" class="divOtherEmployerName divOtherEmployerNameInsert divOtherEmployerNameEdit">:</span> <input type="text" class="form-control divOtherEmployerName divOtherEmployerNameInsert divOtherEmployerNameEdit" width="150" name="OtherEmployerName" value="@Model.EmployerName" id="OtherEmployerName">
                                                    </label>

                                                </div>
                                            }
                                            @*<br>
                                                Others<br>*@
                                            <input type="hidden" class="form-control"
                                                   name="HiddenOtherEmployerName" id="HiddenOtherEmployerName" value="@Model.EmployerName">
                                        </div>
                                    </div>

                                    <div class="form-group divSpouseEmployeeNo divSpouseEmployeeNoInsert divSpouseEmployeeNoEdit hidden">
                                        <label class="control-label col-md-4 ">
                                            Spouse Employee No.<span class="required spanSpouseEmployeeNoRequired hidden">*</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control"
                                                   name="SpouseEmployeeNo" id="SpouseEmployeeNo" value="@Model.SpouseEmployeeNo" maxlength="8">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenSpouseEmployeeNo" id="HiddenSpouseEmployeeNo" value="@Model.SpouseEmployeeNo">
                                        </div>
                                    </div>
                                    <div class="form-group divJobTitle divJobTitleInsert divJobTitleEdit">
                                        <label class="control-label col-md-4 ">
                                            Job Title
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control"
                                                   name="JobTitle" id="JobTitle" value="@Model.JobTitle">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenJobTitle" id="HiddenJobTitle" value="@Model.JobTitle">
                                        </div>
                                    </div>
                                }
                                
                            </div>
                        </div>
                        @if (Model.RelationshipType.IsType(RelationshipType.Child) || Model.RelationshipType.IsType(RelationshipType.Spouse))
                        {
                            <div class="col-md-6">
                            <div class="form-horizontal">
                                @if (Model.RelationshipType.IsType(RelationshipType.Child) || Model.RelationshipType.IsType(RelationshipType.Spouse))
                                {
                                    <div class="form-group divFamilyNo divFamilyNoEdit divFamilyNoInsert">
                                        <label class="control-label col-md-4 ">
                                            Family No.
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control"
                                                   name="FamilyNo" id="FamilyNo" value="@Model.FamilyNo">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenFamilyNo" id="HiddenFamilyNo" value="@Model.FamilyNo">
                                        </div>
                                    </div>
                                }
                                @if (Model.RelationshipType.IsType(RelationshipType.Child))
                                {
                                    <div class="form-group divRelChild divRelChildInsert divRelChildEdit hidden">
                                        <label class="control-label col-md-4 ">
                                            Rel/Child<span class="required spanRelChildRequired">*</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenRelChild" id="HiddenRelChild" value="@Model.RelChild">
                                            <input type="hidden" name="RelChildCode" id="RelChildCode" value="@Model.RelChildCode" />
                                            @if (ReadOnly)
                                            {
                                                <input type="text" class="form-control" id="RelChildName" name="RelChildName" value="@Model.RelChild" />
                                            }
                                            else
                                            {
                                                <input type="hidden" name="RelChildName" id="RelChildName" value="@Model.RelChild" />
                                                <select tabindex="0" id="ddlRelChild" class="form-control"></select>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (Model.RelationshipType.IsType(RelationshipType.Child))
                                {
                                    <div class="form-group divChildSpouseNo divChildSpouseNoInsert divChildSpouseNoEdit hidden">
                                        <label class="control-label col-md-4 ">
                                            Child Spouse Name
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenChildSpouseNo" id="HiddenChildSpouseNo" value="@Model.ChildSpouseNo">
                                            <input type="hidden" name="ChildSpouseNoCode" id="ChildSpouseNoCode" value="@Model.ChildSpouseNo" />
                                            @if (ReadOnly)
                                            {
                                                <input type="text" class="form-control" id="ChildSpouseNoName" name="ChildSpouseNoName" value="" />
                                            }
                                            else
                                            {
                                                <input type="hidden" name="ChildSpouseNoName" id="ChildSpouseNoName" value="" />
                                                <select tabindex="0" id="ddlChildSpouseNo" class="form-control"></select>
                                            }
                                            <input type="hidden" class="form-control"
                                                   name="HiddenChildSpouseName" id="HiddenChildSpouseName" value="">
                                        </div>
                                    </div>
                                }
                                <div class="form-group divCountryOfBirth">
                                    <label class="control-label col-md-4 ">
                                        Country of Birth
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenCountryOfBirth" id="HiddenCountryOfBirth" value="@Model.CountryOfBirth">
                                        <input type="hidden" name="CountryOfBirthCode" id="CountryOfBirthCode" value="@Model.CountryOfBirthCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="CountryOfBirthName" name="CountryOfBirthName" value="@Model.CountryOfBirth" />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="CountryOfBirthName" id="CountryOfBirthName" value="@Model.CountryOfBirth" />
                                            <select tabindex="0" id="ddlCountryOfBirth" class="form-control" onchange="Checking('');"></select>
                                        }
                                    </div>
                                </div>
                                @if (Model.RelationshipType.IsType(RelationshipType.Spouse))
                                {
                                    <div class="form-group divBirthPlace divBirthPlaceInsert divBirthPlaceEdit">
                                        <label class="control-label col-md-4 ">
                                            Birth Place
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control"
                                                   name="BirthPlace" id="BirthPlace" value="@Model.BirthPlace" MaxLength="25">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenBirthPlace" id="HiddenBirthPlace" value="@Model.BirthPlace">
                                        </div>
                                    </div>
                                }
                                <div class="form-group divDateOfBirth">
                                    <label class="control-label col-md-4 ">
                                        Date of Birth <span class="required spanDateOfBirthRequired">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="DateOfBirth" name="DateOfBirth" value="@Service.FormatDateInNumber(Model.DateOfBirth, "dd/MM/yyyy")" readonly="readonly" />
                                        }
                                        else
                                        {
                                            <div class="input-group date date-picker" id="boxDateOfBirth" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control DateOfBirth"
                                                       id="DateOfBirth" name="DateOfBirth" value="@Service.FormatDateInNumber(Model.DateOfBirth, "dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnDateOfBirth" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        }

                                        <input type="hidden" class="form-control"
                                               name="HiddenDateOfBirth" id="HiddenDateOfBirth" value="@Service.FormatDateInNumber(Model.DateOfBirth, "dd/MM/yyyy")" />
                                    </div>
                                </div>
                                <div class="form-group divBirthCertNo">
                                    <label class="control-label col-md-4 ">
                                        Birth Cert No.<span class="required spanBirthCertNoRequired" id="spanBirthCertNoRequired">*</span>
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <input type="text" class="form-control"
                                               name="BirthCertNo" id="BirthCertNo" value="@Model.BirthCertNo">
                                        <input type="hidden" class="form-control"
                                               name="HiddenBirthCertNo" id="HiddenBirthCertNo" value="@Model.BirthCertNo">
                                        <input type="hidden" class="form-control"
                                               name="HiddenBirthCertNo_Name" id="HiddenBirthCertNo_Name" value="Birth Cert No">
                                    </div>
                                </div>
                                @if (Model.RelationshipType.IsType(RelationshipType.Child))
                                {
                                    <div class="form-group divStudent divStudentInsert divStudentEdit">
                                        <label class="control-label col-md-4 ">
                                            Student
                                        </label>
                                        <div class="col-md-8  form-control-static">
                                            @{
                                                string CheckStudent = "";
                                                string boolStudent = "false";
                                                if (Model.Student.HasValue)
                                                {
                                                    if (Model.Student.Value)
                                                    {
                                                        CheckStudent = "Checked";
                                                    }
                                                    boolStudent = Model.Student + "";
                                                }
                                            }
                                            <input type="checkbox" id="chkStudent" @CheckStudent>
                                            <input type="hidden" class="form-control"
                                                   name="HiddenStudent" id="HiddenStudent" value="@boolStudent">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenStudent_Name" id="HiddenStudent_Name" value="Surat Pengesahan Institusi/Kad Pelajar">
                                        </div>
                                    </div>
                                                }
                                @if (Model.RelationshipType.IsType(RelationshipType.Child))
                                {
                                    <div class="form-group divEducationEndDate divEducationEndDateInsert divEducationEndDateEdit">
                                        <label class="control-label col-md-4 ">
                                            Education End Date <span class="required spanEducationEndDateRequired hidden">*</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            @if (ReadOnly)
                                            {
                                                <input type="text" class="form-control" id="EducationEndDate" name="EducationEndDate" value="@Service.FormatDateInNumber(Model.EducationEndDate, "dd/MM/yyyy")" readonly="readonly" />
                                            }
                                            else
                                            {
                                                <div class="input-group date date-picker" id="boxEducationEndDate" data-date-format="dd/mm/yyyy">
                                                    <input type="text" class="form-control EducationEndDate"
                                                           id="EducationEndDate" name="EducationEndDate" value="@Service.FormatDateInNumber(Model.EducationEndDate, "dd/MM/yyyy")" />
                                                    <span class="input-group-btn">
                                                        <button type="button" id="btnEducationEndDate" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            }
                                            <input type="hidden" class="form-control"
                                                   name="HiddenEducationEndDate" id="HiddenEducationEndDate" value="@Service.FormatDateInNumber(Model.EducationEndDate, "dd/MM/yyyy")">
                                        </div>
                                    </div>
                                }
                                @if (Model.RelationshipType.IsType(RelationshipType.Child))
                                {
                                    <div class="form-group divInstitutionName divInstitutionNameInsert divInstitutionNameEdit">
                                        <label class="control-label col-md-4 ">
                                            Institution Name<span class="required spanInstitutionNameRequired hidden">*</span>
                                        </label>
                                        <div class="col-md-8  form-control-static">
                                            <input type="text" class="form-control"
                                                   name="InstitutionName" id="InstitutionName" value="@Model.InstitutionName">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenInstitutionName" id="HiddenInstitutionName" value="@Model.InstitutionName">
                                        </div>
                                    </div>
                                }
                                @if (Model.RelationshipType.IsType(RelationshipType.Child))
                                {
                                    <div class="form-group divHandicapped divHandicappedInsert divHandicappedEdit">
                                        <label class="control-label col-md-4 ">
                                            Handicapped
                                        </label>
                                        <div class="col-md-8  form-control-static">
                                            @{
                                                string CheckHandicapped = "";
                                                string boolHandicapped = "false";
                                                if (Model.Handicapped.HasValue)
                                                {
                                                    if (Model.Handicapped.Value)
                                                    {
                                                        CheckHandicapped = "Checked";
                                                    }
                                                    boolHandicapped = Model.Handicapped + "";
                                                }
                                            }
                                            <input type="checkbox" id="chkHandicapped" @CheckHandicapped>
                                            <input type="hidden" class="form-control"
                                                   name="HiddenHandicapped" id="HiddenHandicapped" value="@boolHandicapped">
                                        </div>
                                    </div>
                                                }
                                @if (Model.RelationshipType.IsType(RelationshipType.Child))
                                {
                                    <div class="form-group divDisabilityType divDisabilityTypeInsert divDisabilityTypeEdit">
                                        <label class="control-label col-md-4 ">
                                            Disability Type<span class="required spanDisabilityTypeRequired hidden">*</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" class="form-control"
                                                   name="HiddenDisabilityType" id="HiddenDisabilityType" value="@Model.DisabilityType">
                                            <input type="hidden" name="DisabilityTypeCode" id="DisabilityTypeCode" value="@Model.DisabilityTypeCode" />
                                            @if (ReadOnly)
                                            {
                                                <input type="text" class="form-control" id="DisabilityTypeName" name="DisabilityTypeName" value="@Model.DisabilityType" />
                                            }
                                            else
                                            {
                                                <input type="hidden" name="DisabilityTypeName" id="DisabilityTypeName" value="@Model.DisabilityType" />
                                                <select tabindex="0" id="ddlDisabilityType" class="form-control"></select>
                                            }

                                        </div>
                                    </div>
                                }
                                <div class="form-group divDisabilityDate divDisabilityDateInsert divDisabilityDateEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Disability Date<span class="required spanDisabilityDateRequired hidden">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="DisabilityDate" name="DisabilityDate" value="@Service.FormatDateInNumber(Model.DisabilityDate, "dd/MM/yyyy")" readonly="readonly" />
                                        }
                                        else
                                        {
                                            <div class="input-group date date-picker" id="boxDisabilityDate" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control DisabilityDate"
                                                       id="DisabilityDate" name="DisabilityDate" value="@Service.FormatDateInNumber(Model.DisabilityDate, "dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnDisabilityDate" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        }
                                        <input type="hidden" class="form-control"
                                               name="HiddenDisabilityDate" id="HiddenDisabilityDate" value="@Service.FormatDateInNumber(Model.DisabilityDate, "dd/MM/yyyy")">
                                    </div>
                                </div>
                                <div class="form-group divEmployed divEmployedInsert divEmployedEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Employed
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @{
                                            string CheckEmployed = "";
                                            string boolEmployed = "false";
                                            if (Model.Employed.HasValue)
                                            {
                                                if (Model.Employed.Value)
                                                {
                                                    CheckEmployed = "Checked";
                                                }
                                                boolEmployed = Model.Employed + "";
                                            }
                                        }
                                        <input type="checkbox" id="chkEmployed" @CheckEmployed>
                                        <input type="hidden" class="form-control"
                                               name="HiddenEmployed" id="HiddenEmployed" value="@boolEmployed">
                                    </div>
                                </div>
                                <div class="form-group divMarried divMarriedInsert divMarriedEdit hidden">
                                    <label class="control-label col-md-4 ">
                                        Married
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @{
                                            string CheckMarried = "";
                                            string boolMarried = "false";
                                            if (Model.Married.HasValue)
                                            {
                                                if (Model.Married.Value)
                                                {
                                                    CheckMarried = "Checked";
                                                }
                                                boolMarried = Model.Married + "";
                                            }
                                        }
                                        <input type="checkbox" id="chkMarried" @CheckMarried>
                                        <input type="hidden" class="form-control"
                                               name="HiddenMarried" id="HiddenMarried" value="@boolMarried">
                                    </div>
                                </div>
                                <div class="form-group divMaritalStatus divMaritalStatusInsert divMaritalStatusEdit">
                                    <label class="control-label col-md-4 ">
                                        Marital Status<span class="required spanMaritalStatusRequired hidden">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" class="form-control"
                                               name="HiddenMaritalStatus" id="HiddenMaritalStatus" value="@Model.MaritalStatus">
                                        <input type="hidden" name="MaritalStatusCode" id="MaritalStatusCode" value="@Model.MaritalStatusCode" />
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="MaritalStatusName" name="MaritalStatusName" value="@Model.MaritalStatus" />
                                        }
                                        else
                                        {
                                            <input type="hidden" name="MaritalStatusName" id="MaritalStatusName" value="@Model.MaritalStatus" />
                                            <select tabindex="0" id="ddlMaritalStatus" class="form-control"></select>
                                        }
                                    </div>
                                </div>
                                <div class="form-group divMaritalStatusDate divMaritalStatusDateInsert divMaritalStatusDateEdit">
                                    <label class="control-label col-md-4 ">
                                        Marital Status Date<span class="required spanMaritalStatusDateRequired hidden">*</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @if (ReadOnly)
                                        {
                                            <input type="text" class="form-control" id="MaritalStatusDate" name="MaritalStatusDate" value="@Service.FormatDateInNumber(Model.MaritalStatusDate, "dd/MM/yyyy")" readonly="readonly" />
                                        }
                                        else
                                        {
                                            <div class="input-group date date-picker" id="boxMaritalStatusDate" data-date-format="dd/mm/yyyy">
                                                <input type="text" class="form-control MaritalStatusDate"
                                                       id="MaritalStatusDate" name="MaritalStatusDate" value="@Service.FormatDateInNumber(Model.MaritalStatusDate, "dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" id="btnMaritalStatusDate" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        }
                                        <input type="hidden" class="form-control"
                                               name="HiddenMaritalStatusDate" id="HiddenMaritalStatusDate" value="@Service.FormatDateInNumber(Model.MaritalStatusDate, "dd/MM/yyyy")">
                                    </div>
                                </div>
                            </div>
                        </div>}
                    </div>
                    <div class="row divCommentInsert hidden divCommentEdit">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-2 ">
                                        Comment
                                    </label>
                                    <div class="col-md-10  form-control-static">
                                        <textarea id="Comment" class="form-control" name="Comment" Rows="4" >@Model.Comment</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>