@model List<OJA.Models.Specialization>
@{
    Layout = null;
}
<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Skills & Expertise
        </div>
        <div class="tools">
            <a style="margin-left:10px" href="javascript:;" class="expand arrow-down">
            </a>
        </div>
    </div>

    <div class="portlet-body form" style="display:none">
        <div class="form-body">
            <div class="form-horizontal">
                <table id="tblList" class="table table-striped table-bordered table-hover table-full-width">
                    <thead>
                        <tr>
                            <th>Skills & Expertise</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Years of Experience / Proficiency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a href="javascript: EditSkillsInfo('@item.SpecializationID')">@item.SpecializationName</a>
                                </td>
                                <td>@item.StartDate</td>
                                <td>@item.EndDate</td>
                                <td>@item.ProficiencyName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

           @if (ViewBag.CanEdit)
           {
                <div class="row">
                    <div class="col-md-12">
                        <a class="btn btn-primary" onclick="ShowSkillsList()">Add <i class="fa fa-plus"></i></a>
                    </div>
                </div>
           }
        </div>
    </div>
</div>

<script>
    function ShowSkillsList() {
        ShowLoading();
         
        $.ajax({ 
            url: '@Url.Action("AddSpecializationFromList")',
            data: {SpecializationType: "SKILLS"},
            success: function (content) {
                $("#skillsDiv #EducationInfoBody").html(content);
                $("#skillsDiv #AddEducationInfoModal").modal();
            },
            error: function (err) {
                alert('Unable to retrieve skills list');
            }
        });
    }

     function EditSkillsInfo(specId) {
        ShowLoading();
        $.ajax({
            url: '@Url.Action("EditSpecializationFromList")',
            data: { Id: specId, specializationType: 'SKILLS' },
            success: function (responseHtml) {
                $("#skillsDiv #EducationInfoBody").html(responseHtml);
                $("#skillsDiv #AddEducationInfoModal").modal();
            },
            error: function (err) {
                alert('Unable to get skills details')
            }
        }).always(HideLoading);
    }
     

     $(document).on('click', '#skillsDiv #btnUpdateEducation', function () {
         var data = $('#skillsDiv #updateEducationForm').serialize();

         var errorMessage = "";
         errorMessage += $("#skillsDiv #StartDate").val() == "" ? "Start Date is required \n" : "";
         errorMessage += $("#skillsDiv #EducationGrade").val() == "" ? "Grade is required \n" : "";
         errorMessage += $("#skillsDiv #SpecializationName").val() == "" ? "Please select at least one education type \n" : "";

         if (errorMessage != "") {
             alert(errorMessage);
             return false;
         }

         UpdateSpecialization(data);
     });



</script>