@model List<OJA.Models.Specialization>
@{ 
    Layout = null;
}
<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Additional Education Info
        </div>
        <div class="tools">
            <a style="margin-left:10px" href="javascript:;" class="expand arrow-down">
            </a>
        </div>
    </div>

    <div class="portlet-body form" style="display:none">
        <div class="form-body">
            <div class="form-horizontal">
                <table id="tblList" class="table table-striped table-bordered table-hover table-full-width">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Grade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a href="javascript: EditEducationInfo('@item.SpecializationID')">@item.SpecializationName</a>
                                </td>
                                <td>@item.StartDate</td>
                                <td>@item.EndDate</td>
                                <td>@item.ProficiencyName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewBag.CanEdit)
            {
                <div class="row">
                    <div class="col-md-12">
                        <a class="btn btn-primary" onclick="ShowEducationList()">Add <i class="fa fa-plus"></i></a>
                    </div>
                </div>
            } 
        </div>
    </div>
</div>

<script>

    function ShowEducationList() {
        ShowLoading();
        $.ajax({
            type: 'GET',
            url: '@Url.Action("_AdditionalEducationList")',
            success: function (content) {
                $("#educationInfoDiv #EducationInfoBody").html(content);
                $("#educationInfoDiv #AddEducationInfoModal").modal();
            },
            error: function (err) {
                alert('Unable to retrieve education list');
            }
        });
    }

    $(document).on('click', "#educationInfoDiv #btnSubmitEducationInfo", function () { 
        var specializationArray = getSpecializationArray();
        var errorMessage = "";
        errorMessage += $('#educationInfoDiv #StartDate').val() == "" ? "Start date is required \n" : "";
        var gradeChosen = true;
        for (var i = 0; i < specializationArray.length; i++) {
            if (!specializationArray[i].ProficiencyCode) {
                gradeChosen = false;
                break;
            }
        }

        if (specializationArray.length > 0) {
            var startDate = specializationArray[0].StartDate;
            var endDate = specializationArray[0].EndDate;

            if (startDate != "" && endDate != "") {
                errorMessage += moment(startDate, "DD/MM/YYYY").isAfter(moment(endDate, 'DD/MM/YYYY')) ? "Start Date must be earlier than End Date" : "";
            }
        }

        errorMessage += specializationArray.length < 1 ? "Please select at least one education \n" : "";
        errorMessage += !gradeChosen ? "Grade is required \n" : "";

        if (errorMessage != "") {
            alert(errorMessage);
            return;
        }
        confirmationModal('submit additional education info', submitEducationInfo);
    });

    function submitEducationInfo(confirm) {
        if (!confirm)
            return;

        var specializationArray = getSpecializationArray();

        var data = JSON.stringify({ 'SpecializationList': specializationArray });
        ShowLoading();
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'POST',
            url: '@Url.Action("AddSpecialization")',
            data: data,
            success: function (response) {
                if (response.Success) {
                    displaySuccessModal("Specialization added successfully");
                }
                else {
                    alert("Error in adding specialization");
                }
            }
        });
    }

    function getSpecializationArray() {
        var specializationArray = [];
        $("#educationInfoDiv #tblAdditionalEducationList>tbody>tr").each(function (i, val) {
            var checkbox = $(this).find('.checkboxEducation');
            if (checkbox.is(':checked')) {
                var education = $(this).find('.education').text();
                var subject = $(this).find('.subject').text();
                var ddlGrade = $(this).find('.grade').find('select');

                specializationArray.push({
                    SpecializationCode: $(this).find('.objectId').val(),
                    SpecializationName: education + " - " + subject,
                    ProficiencyCode: ddlGrade.val(),
                    ProficiencyName: ddlGrade.children('option').filter(':selected').text(),
                    StartDate: $('#educationInfoDiv #StartDate').val(), // shared textbox
                    EndDate: $('#educationInfoDiv #EndDate').val(), // shared textbox,
                    Category: 'Additional Education Info'
                });
            }
        });

        return specializationArray;
    }

     function EditEducationInfo(specId) {
        ShowLoading();
        $.ajax({
            url: '@Url.Action("EditEducationInfo")',
            data: { Id: specId },
            success: function (responseHtml) {
                $("#educationInfoDiv #EducationInfoBody").html(responseHtml);
                $("#educationInfoDiv #AddEducationInfoModal").modal();
            },
            error: function (err) {
                alert('Unable to get specialization details')
            }
        });
    }

     $(document).on('click', '#educationInfoDiv #btnUpdateEducation', function () {
         var data = $('#educationInfoDiv #updateEducationForm').serialize();

         var errorMessage = "";
         errorMessage += $("#educationInfoDiv #StartDate").val() == "" ? "Start Date is required \n" : "";
         errorMessage += $("#educationInfoDiv #EducationGrade").val() == "" ? "Grade is required \n" : "";
         errorMessage += $("#educationInfoDiv #SpecializationName").val() == "" ? "Please select at least one education type \n" : "";

         var startDate = $("#educationInfoDiv #StartDate").val();
         var endDate = $("#educationInfoDiv #EndDate").val();

         if (startDate != "" && endDate != "") {
             errorMessage += moment(startDate, "DD/MM/YYYY").isAfter(moment(endDate, 'DD/MM/YYYY')) ? "Start Date must be earlier than End Date" : "";
         }

         if (errorMessage != "") {
             alert(errorMessage);
             return false;
         }
         confirmationModal('update additional education info', UpdateEducation);
     });

     function UpdateEducation(confirm) {
         if (!confirm)
             return;

         var data = $('#educationInfoDiv #updateEducationForm').serialize();
         UpdateSpecialization(data);
     }

      $(document).on('click', '#educationInfoDiv #btnEditEducation', function () {
        $('.editable').removeAttr('readonly');
        $('#educationInfoDiv #EducationTree, .EducationTree').removeClass('hidden');
        $('#educationInfoDiv #btnUpdateEducation').removeClass('hidden');
        $('#educationInfoDiv #EducationGrade').removeAttr('disabled');
        $("#educationInfoDiv #btnDeleteEducation").addClass('hidden');
        $(this).addClass('hidden');
     });

      $(document).on('click', '.checkAllEducation', function () {

          var allPages = oTableEducation.fnGetNodes();

          var mainCheck = $(this);
          $('.checkboxEducation', allPages).prop('checked', mainCheck.is(':checked'));
          //$('.checkboxEducation').each(function (i, val) {
          //    $(this, allPages).prop('checked', mainCheck.is(':checked'));
          //});
      });

</script>