@{
    ViewBag.Title = "Curriculum Vitae Search";
}

<style>
    .position-form .form-group {
        margin-bottom: 6px;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Curriculum Vitae Search
        </h1>
    </div>
</div>
<br />

<div class="row">
    <div class="col-md-12">
        <form id="filterForm">
            <div class="form-horizontal">
                <div class="form-body position-form">
                    <div class="form-group">
                        <label class="col-md-2 control-label">Employee Number</label>
                        <div class="col-md-4 form-control-static">
                           <input name="EmployeeCode" class="form-control" />
                        </div> 
                    </div>
                    <div class="form-group">
                        <label class="col-md-2 control-label">Employee Name</label>
                        <div class="col-md-8">
                            <input name="EmployeeName" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="text-right">
            <a id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">Search</a>
        </div>
    </div>
</div>
<div class="row">&nbsp;</div>
<div class="row">
    <div class="col-md-12">
        <div id="SearchResult">

        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });
         
    });

    function SearchListing() {

        $("#SearchResult").html("LOADING...");
        $.ajax({
            type: "GET",
            cache: false,
            url: '@Url.Content("~/MyResume/_CVSearchResult")',
            data: $("#filterForm").serialize(),
            success: function (listingContent) {
                $("#SearchResult").empty().append(listingContent);
            },
            error: function (err) {

                console.log(err);
            }
        });
    }
</script>