@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Flexi Benefits In Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Year</th>
                                <th>Submission Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Claims/FlexiBenefitsViewForm")?RequestID=@item.SourceID&TaskID=@item.ID&Source=InTray">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.ApplicationRefNo</td>

                                    <td>@item.DisplayText2 - @item.ApplicantName</td>

                                    <td>@item.DisplayText3</td>

                                    @if (!String.IsNullOrEmpty(@item.DisplayText1))
                                    {
                                        <td>@Convert.ToDateTime(@item.DisplayText1).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }



                                    @if (@item.DisplayText4 == "Declined")
                                    {
                                        <td style="color:green;"><b>Returned</b></td>
                                    }
                                    else if (@item.DisplayText4 == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.DisplayText4</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.DisplayText4</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>
