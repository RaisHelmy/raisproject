@using ESS.Core

@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{

    Layout = null;
    int CountRow = 0;

    bool isHRBP = false;

    if (ESS.ContractAbsorption.Service.isApprover(Common.GetEmployeeID(), "SSC") || ESS.ContractAbsorption.Service.isApprover(Common.GetEmployeeID(), "HRBP"))
    {
        isHRBP = true;
    }
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="hidden">AssessmentID</th>
                                <th class="hidden">RequestID</th>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Status</th>
                                <th>Employee</th>
                                <th>Payscale Group</th>
                                <th>Submission Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <span class="DivcheckItem" id="DivchkSelectAssessment_@CountRow"><input type="checkbox" id="chkSelectAssessment_@CountRow" class="checkItem" name="chkSelectAssessment" value="@item.ID"></span>
                                    </td>
                                    <td class="hidden">
                                        <label id="LabelchkSelectAssessment_@CountRow">@item.DisplayText6.Trim()</label>
                                    </td>
                                    <td class="hidden">
                                        <label id="Label1chkSelectAssessment_@CountRow">@item.DisplayText5.Trim()</label>
                                    </td>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/ContractAbsorption/OnlineAssessmentForm")?AssessmentID=@item.DisplayText6.Trim()&RequestID=@item.DisplayText5.Trim()&TaskID=@item.ID.ToString().Trim()">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.DisplayText3</td>
                                    <td>@item.ApplicantCode - @item.ApplicantName</td>
                                    <td>@item.DisplayText18</td>
                                    <td>@DateTime.Parse(item.DisplayText2).ToString("dd-MM-yyyy")</td>
                                </tr>
                                CountRow++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");

    jQuery(document).ready(function () {
        $(".DivBAUserOnly").addClass("hidden");

        $('.checkItem').click(function () {
            var name = $(this).attr('id');

            var _Chk = $('#Div' + name).hasClass('checked');

            if (_Chk) {
                $("#Div" + name).addClass('checked');
            }
            else {
                $("#Div" + name).removeClass('checked');
            }
        });
    });

</script>

@if (Model.Count > 0 && isHRBP)
{
    <script type="text/javascript">
        jQuery(document).ready(function () {
            $(".DivBAUserOnly").removeClass("hidden");
        });
    </script>
}
