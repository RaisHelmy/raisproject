@model List<SEP.RoutingManagement.Models.GetMyApprovalHistory>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Leave Subtype</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Total Days</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Action("Index", "LeaveApplication", new { LeaveID = item.SourceID, TaskID = item.ID, Source = "ApprovalHistory" })">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.ApplicantCode - @item.ApplicantName</td>
                                    <td>@item.DisplayText7</td>
                                    <td>@item.DisplayText8</td>
                                    <td>@item.DisplayText9</td>
                                    <td>@item.DisplayText10</td>
                                    @{
                                        var Status = LeaveApplication.Service.ConvertStatus(item.LeaveStatus);
                                        if (Status == "Declined" || Status == "Cancelled" || Status == "Withdrawn")
                                        {
                                            <td style="color:red;">
                                                <b>
                                                    @Status
                                                </b>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="color:green;">
                                                <b>
                                                    @Status
                                                </b>
                                            </td>
                                        }
                                    }
                                </tr>
                                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $('#tblResult').dataTable({
            "bDestroy": true,
            //"aLengthMenu": [
            //    [10, 15, 20, -1],
            //    [10, 15, 20, "All"]
            //],
            //// set the initial value
            //"iDisplayLength": 10,

            "sPaginationType": "bootstrap",
            "oLanguage": {
                "sLengthMenu": "_MENU_ records",
                "oPaginate": {
                    "sPrevious": "Prev",
                    "sNext": "Next"
                }
            },
            "aoColumnDefs": [
                { "sType": "date-dmy", "aTargets": [4, 5] }],
            //disable init sorting
            "aaSorting": []
        });
    });
</script>