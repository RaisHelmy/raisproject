@model List<SEP.RoutingManagement.Models.GetMyApprovalHistory>

@using ESS.StandbyPlanning;

@{
	Layout = null;
}

<div class="portlet box blue">
	<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
	<div class="portlet-title">
		<div class="caption">
			<i class="fa fa-reorder"></i>My Approval History
		</div>
		<div class="tools">
		</div>
	</div>
	<div class="portlet-body form">
		<div class="form-body">
			<div class="form-horizontal">
				<div class="table-toolbar">
					<table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
						<thead>
							<tr>
								<th></th>
								<th>Reference No.</th>
								<th>Employee</th>
								<th>Description</th>
								<th>ChargeCode</th>
								<th>Submitted Date</th>
								<th>Action</th>
								<th>Action Date</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in @Model)
							{
							<tr>
								<td>
									<a class="btn blue btn-sm" href="@Url.Content("~/StandbyPlanning/ApprovalForm")?StandByID=@item.SourceID.ToString().Trim()&TaskID=@item.ID.ToString().Trim()">
										<i class="fa fa-search"></i>
									</a>
								</td>
								<td>@item.ApplicationRefNo</td>
								<td>@item.DisplayText10 - @item.DisplayText9</td>
								<td>@item.DisplayText18</td>
								<td>@item.DisplayText14</td>
								<td>@DateTime.Parse(item.DisplayText2).ToString("dd-MM-yyyy")</td>
								<td>@item.ApproverAction</td>
								<td>@item.ActionDate.Value.ToString("dd-MM-yyyy")</td>
								@if (item.ApproverAction == "Reworked")
								{
									<td>@Service.GetStatusName("RW")</td>
								}
								else if (item.ApproverAction == "Approved")
								{
									<td>@Service.GetStatusName("AP")</td>
								}
								else if (item.ApproverAction == "Declined")
								{
									<td>@Service.GetStatusName("DC")</td>
								}
								else
								{
									<td>@Service.GetStatusName("VR")</td>
								}
							</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

<script type="text/javascript">
	transformTable("#tblResult");
</script>