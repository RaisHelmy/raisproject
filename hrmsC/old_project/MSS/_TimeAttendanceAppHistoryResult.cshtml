@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Dispensary</th>
                                <th>Vendor</th>
                                <th>Total Amount</th>
                                <th>Submitted By</th>
                                <th>Submission Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Vendor/VendorDetails")?ID=@item.SourceID&TaskID=@item.ID&Source=InTray">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.DisplayText1</td>
                                    <td>@item.DisplayText10</td>
                                    <td>@item.DisplayText9</td>
                                    <td>@item.DisplayText7 - @item.DisplayText4</td>
                                    @if (!String.IsNullOrEmpty(@item.DisplayText5))
                                    {
                                        <td>@Convert.ToDateTime(@item.DisplayText5).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (@item.DisplayText6 == "Declined" || @item.DisplayText6 == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.DisplayText6</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.DisplayText6</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>