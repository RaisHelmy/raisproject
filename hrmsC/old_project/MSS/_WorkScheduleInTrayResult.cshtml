@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee Number</th>
                                <th>Employee Name</th>
                                <th>Work Schedule Type</th>
                                <th>Effective Date From</th>
                                <th>Status</th>
                                @*<th>Action Type</th>*@
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="DestroyUniform" ID="chkSelect" name="chkSelect" value="@item.SourceID,@item.ID">
                                    </td>
                                    <td>
                                        
                                        <a class="btn blue btn-sm" href="@Url.Content("~/WorkSchedule/WorkScheduleApplication")?ID=@item.SourceID&TaskID=@item.ID">
                                            <i class="fa fa-search"></i>
                                        </a>

                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.DisplayText1</td>
                                    <td>@item.DisplayText3</td>
                                    <td>@item.DisplayText4</td>
                                    @if (!String.IsNullOrEmpty(item.DisplayText8))
                                    {
                                        <td>@Convert.ToDateTime(item.DisplayText8).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (item.DisplayText7 == "Declined" || item.DisplayText7 == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.DisplayText7</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.DisplayText7</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @*Submit Button*@
                    <input type="button" class="btn green" value="Approve" id="btnApprove" onclick="ConfirmAction('Approved')" />
                    <input type="button" class="btn red" value="Decline" id="btnReject" onclick="ConfirmAction('Declined')" />
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    transformTable("#tblResult");
</script>