@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Employee</th>
                                <th>Course Title</th>
                                <th>Provider</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr>
                                    <td>
                                        @if (item.ApplicationRefNo.Contains("TR06"))
                                        {
                                            if (item.DisplayText14 == "TC" || item.DisplayText5.Equals("Endorsed"))
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/TrainingApplication/TrainingCourseApplication")?SourceID=@item.SourceID&TaskID=@item.ID&CategoryType=@item.DisplayText8">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                            else if (item.DisplayText14 == "TR")
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/TrainingApplication/Application")?ID=@item.SourceID&TaskID=@item.ID&Category=@item.DisplayText6&Mode=View&CategoryType=@item.DisplayText8">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            if (item.DisplayText14 == "TR")
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/Training/TrainingApplication")?ID=@item.SourceID&TaskID=@item.ID&Category=@item.DisplayText6&Mode=View&CategoryType=@item.DisplayText8">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                            else if (item.DisplayText14 == "TC")
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/Training/TrainingCourseApplication")?SourceID=@item.SourceID&TaskID=@item.ID&CategoryType=@item.DisplayText8">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                            else if (item.DisplayText14 == "RA")
                                            {
                                                <a class="btn blue btn-sm" href="@Url.Content("~/Training/TrainingApplicationReplacement")?TrainingID=@item.SourceID&TaskID=@item.ID&Mode=View&CategoryType=@item.DisplayText8">
                                                    <i class="fa fa-search"></i>
                                                </a>
                                            }
                                        }
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.DisplayText7</td>
                                    <td>@item.DisplayText9</td>
                                    @if (item.DisplayText14 == "TR")
                                    {
                                        <td>@item.DisplayText1 - @item.DisplayText3</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    <td>@item.DisplayText12</td>
                                    <td>@item.DisplayText13</td>
                                    @if (!String.IsNullOrEmpty(item.DisplayText10))
                                    {
                                        <td>@Convert.ToDateTime(item.DisplayText10).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (!String.IsNullOrEmpty(item.DisplayText11))
                                    {
                                        <td>@Convert.ToDateTime(item.DisplayText11).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (item.DisplayText5 == "Declined" || item.DisplayText5 == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.DisplayText5</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.DisplayText5</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>