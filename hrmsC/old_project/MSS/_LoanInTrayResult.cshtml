@model List<SEP.RoutingManagement.Models.GetMyIntray>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee No.</th>
                                <th>Employee Name</th>
                                <th>Loan Type</th>
                                <th>Submission Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                                {
                                    <tr>
                                        <td>
                                            <a class="btn blue btn-sm" href="@Url.Content("~/Loan/LoanDetails")?LoanID=@item.SourceID&TaskID=@item.ID">
                                                <i class="fa fa-search"></i>
                                            </a>
                                        </td>
                                        <td>@item.ApplicationRefNo</td>
                                        <td>@item.ApplicantCode</td>
                                        <td>@item.ApplicantName</td>
                                        <td>@item.DisplayText4</td>
                                        @if (!String.IsNullOrEmpty(item.DisplayText6))
                                        {
                                            <td>@Convert.ToDateTime(item.DisplayText6).ToString("dd-MM-yyyy")</td>
                                        }
                                        else
                                        {
                                            <td>-</td>
                                        }

                                        <td style="color:green;"><b>@item.DisplayText5</b></td>
                                       
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>