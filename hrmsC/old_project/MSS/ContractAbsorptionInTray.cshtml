@using ESS.Core

@model List<ESS.Core.DropDownObject>

@{
	Layout = "~/Views/Shared/_Layout.cshtml";

	ViewBag.Title = "MSS - Absorption of Contract Staff";

	DateTime d1 = DateTime.Now.AddYears(-20);
	DateTime d2 = DateTime.Now.AddYears(20);
	string dtStrStart = d1.ToString("dd MMM yyyy");
	string dtStrEnd = d2.ToString("dd MMM yyyy");

	bool isHRBP = false;

	if (ESS.ContractAbsorption.Service.isApprover(Common.GetEmployeeID(), "SSC") || ESS.ContractAbsorption.Service.isApprover(Common.GetEmployeeID(), "HRBP"))
	{
		isHRBP = true;
	}
}

<div class="row">
	<div class="col-md-12">
		<br />
		<h1 class="page-title">
			MSS - Absorption of Contract Staff<span style="padding-left:20px;"><small></small></span>
		</h1>
	</div>
</div>
<br />
<div class="form-body">
	<div class="row">
		<div class="col-md-6">
			<div class="form-horizontal">
				<div class="form-group">
					<label class="col-md-5 control-label">Submission Date (From)</label>
					<div class="col-md-7 form-control-static">
						<div class="input-group date date-picker" id="divSubmissionDateFrom" data-date-format="dd MM yyyy">
							<input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
							<span class="input-group-btn">
								<button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="form-horizontal">
				<div class="form-group">
					<label class="col-md-5 control-label">Submission Date (To)</label>
					<div class="col-md-7 form-control-static">
						<div class="input-group date date-picker" id="divSubmissionDateTo" data-date-format="dd MM yyyy">
							<input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
							<span class="input-group-btn">
								<button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-md-6">
			<div class="form-horizontal">
				<div class="form-group">
					<label class="col-md-5 control-label">Employee</label>
					<div class="col-md-7 form-control-static">
						@Html.Partial("_PeoplePicker")
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="form-horizontal">
				<div class="form-group">
					<label class="col-md-5 control-label">Status</label>
					<div class="col-md-7 form-control-static">
						<select class="form-control" id="Status">
							<option value="">- All -</option>
							<option value="Pending">Pending</option>
							<option value="IM Submitted">IM Submitted</option>
							<option value="HOD Submitted">HOD Submitted</option>
							<option value="HOU Submitted">HOU Submitted</option>
							<option value="HODiv Submitted">HODiv Submitted</option>
							<option value="Rework">Rework</option>
							<option value="HRBP Recommended">HRBP Recommended</option>
							<option value="Staff Submitted">Staff Submitted</option>
						</select>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">&nbsp;</div>
	<div class="row">
		<div class="col-md-12">
			<div class="text-right">
				<input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
				<input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
			</div>
		</div>
	</div>
	<div class="row">&nbsp;</div>
	<div class="row">
		<div class="col-md-12">
			<div id="SearchResult">

			</div>
		</div>
	</div>
	@if (isHRBP)
	{
		<div class="row">
			<div class="col-md-12">
				<div class="text-left">
					<input type="button" id="btn-Recommended" class="btn green DivBAUserOnly" value="Recommended" onclick="javascript: FormValidation('R')">
					<input type="button" id="btn-NotRecommended" class="btn green DivBAUserOnly" value="Not Recommended" onclick="javascript: FormValidation('NR')">
				</div>
			</div>
		</div>
	}
</div>

<div class="modal fade" id="SuccessRecommend" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header Success-header">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
				<h4 class="Success-title">Action Successfully Completed</h4>
			</div>
			<div class="modal-body Success-body">
				<div class="well">
					The selected record is updated.
				</div>
			</div>
			<div class="modal-footer Success-footer">
				<button type="submit" class="btn default blue" id="btnOKRecommend">
					<i class="fa fa-check"></i>
					OK
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Confirmation Message -->
<div class="modal fade" id="ConfirmUpdate" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
				<h4 class="modal-title">Confirmation</h4>
			</div>
			<div class="modal-body">
				<div class="well">
					Are you sure you want to Submit this Absorption of Contract Staff Form application?\n\rPress Confirm to proceed, or Close to stay on the current page.
				</div>
			</div>
			<div class="modal-footer">
				<button type="submit" class="btn default blue" id="btnRecommendedForm" onclick="javascript: RecommendAction(this, 'R')">
					<i class="fa fa-check"></i>
					Submit
				</button>
				<button type="submit" class="btn default blue" id="btnNotRecommendedForm" onclick="javascript: RecommendAction(this, 'NR')">
					<i class="fa fa-check"></i>
					Submit
				</button>
				<button type="button" class="btn default" data-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
			top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
			opacity: .8; filter: alpha(opacity=70);display:none">
	<p style="position: absolute; top: 30%; left: 30%; color: black;">
		Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

	</p>
</div>

<script type="text/javascript">
    function SearchListing() {
        var _DateFrom = $('#SubDateFrom').val();
        var _DateTo = $('#SubDateTo').val();
        var _EmpID = $('#hfEmpID').val();
        var _Status = $('#Status').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/MSS/_ContractAbsorptionInTrayResult")',
            cache: false,
            dataType: "html",
            data: { DateFrom: _DateFrom, DateTo: _DateTo, Status: _Status, SearchEmpID: _EmpID },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    jQuery(document).ready(function () {
        $('#divSubmissionDateFrom').datepicker('setStartDate', '@dtStrStart');
        $('#divSubmissionDateFrom').datepicker('setEndDate', '@dtStrEnd');

        $('#divSubmissionDateTo').datepicker('setStartDate', '@dtStrStart');
        $('#divSubmissionDateTo').datepicker('setEndDate', '@dtStrEnd');

        $("#divSubmissionDateFrom").datepicker({
            autoclose: true,
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());

            minDate.setDate(minDate.getDate() + 1);
            $('#divSubmissionDateTo').datepicker('setStartDate', minDate);
        });

        $("#divSubmissionDateTo").datepicker({
            autoclose: true,
        })
            .on('changeDate', function (selected) {
                var minDate = new Date(selected.date.valueOf());
                minDate.setDate(minDate.getDate() - 1);
                $('#divSubmissionDateFrom').datepicker('setEndDate', minDate);
            });

        $("#SubDateFrom").on("blur", function (e) {
            if ($('#SubDateFrom').val() == "") {
                $('#divSubmissionDateTo').datepicker('setStartDate', '@dtStrStart');
            }

        });

        $("#SubDateTo").on("blur", function (e) {
            if ($('#SubDateTo').val() == "") {
                $('#divSubmissionDateFrom').datepicker('setEndDate', '@dtStrEnd');
            }

        });

        SearchListing();
    });

    function ClearFilter() {
        $('#SubDateFrom').val('');
        $('#SubDateTo').val('');
        $('#hfEmpID').val('');
        $('#txtEmpName').val('');
        $('#Status').val('');
        SearchListing();
	}

@if (isHRBP)
{
	<text>
	function FormValidation(acknowledgement) {
		var _ValidationMsg = 'Minimum one selection is required.\n';

		$("#tblResult td input[name='chkSelectAssessment']:checked").each(function (i, value) {

			var row = $(this).closest("tr");
			if (row.find(".checkItem").val() != '' && row.find(".checkItem").val() != undefined) {
				_ValidationMsg = '';
			}
		});

		if (_ValidationMsg != null && _ValidationMsg != '') {
			alert(_ValidationMsg);
		}
		else {
			if (acknowledgement == 'R') {
				$("#btnRecommendedForm").removeClass("hidden");
				$("#btnNotRecommendedForm").addClass("hidden");
			}
			else
			{
				$("#btnNotRecommendedForm").removeClass("hidden");
				$("#btnRecommendedForm").addClass("hidden");
			}

			$("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application. If you want to make changes, click Close.');

            $("#ConfirmUpdate").modal('show');
		}
	}

	function RecommendAction(btn, acknowledgement) {
		btn.disabled = true;

		$("#divLoading").show();

		var myVar = setTimeout(function () { StartRecommend(btn, acknowledgement) }, 3000);
	}

	function StartRecommend(btn, acknowledgement) {
		var FullResultTask = '';
		var resultTask = '';

		var FullResultAssessment = '';
		var resultAssessment = '';

		var FullResultRequest = '';
		var resultRequest = '';

		if ($('#divLoading').is(':visible')) {
			$($('input[name="chkSelectAssessment"]:checked')).each(function () {
				var nameTask = $(this).attr('id');
				var nameAssessment = $(this).attr('id');
				var nameRequest = $(this).attr('id');

				resultTask = $("#" + nameTask).val();
				FullResultTask += resultTask + " ,";

				resultAssessment = $("#Label" + nameAssessment).text();
				FullResultAssessment += resultAssessment + " ,";

				resultRequest = $("#Label1" + nameRequest).text();
				FullResultRequest += resultRequest + " ,";

			});
			var form = {
				FullRID: FullResultRequest,
				FullAID: FullResultAssessment,
				FullTID: FullResultTask,
				Acknowledgement: acknowledgement
			};
			ajaxRecommend(btn, form);
		}
	}

	function ajaxRecommend(btn, form) {
		$.ajax({
		type: "POST",
			url: '@Url.Content("~/ContractAbsorption/SubmitRecommendForm")',
			cache: false,
			async: false,
			dataType: "json",
			data: form,
			success: function(result) {
				if (result.Success) {
					$("#ConfirmUpdate").modal('toggle');
					$("#divLoading").hide();
					$("#SuccessRecommend").modal();
					$("#btnOKRecommend").click(function() { RedirectTo('Recommend'); });
				}
				else {
					$("#ConfirmUpdate").modal('toggle');
					$("#divLoading").hide();

					btn.disabled = false;

					alert(result.ErrorMsg);
				}
			},
			error: function(e) {
			}
		});
	}

	function RedirectTo(_Action) {
		switch (_Action) {
			default:
				window.location.href = '@Url.Action("ContractAbsorptionInTray", "MSS")';
		}
	}
	</text>
}
</script>