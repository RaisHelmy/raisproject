@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Evaluation Ref. No.</th>
                                <th>Employee</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Course Title</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/TrainingEvaluation/AttendeeEvaluationForm")?EvaluationID=@item.DisplayText16&EvaluationRecipientID=@item.DisplayText17&TaskID=@item.ID&FromSource=MyInTray">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.DisplayText3</td>
                                    <td>@item.DisplayText7</td>
                                    <td>@item.DisplayText9</td>
                                    <td>@item.DisplayText13</td>
                                    @if (!String.IsNullOrEmpty(item.DisplayText10))
                                    {
                                        <td>@Convert.ToDateTime(item.DisplayText10).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (!String.IsNullOrEmpty(item.DisplayText11))
                                    {
                                        <td>@Convert.ToDateTime(item.DisplayText11).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>