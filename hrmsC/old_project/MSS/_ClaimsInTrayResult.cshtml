@model List<SEP.RoutingManagement.Models.GetMyIntray>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Claims Category</th>
                                <th>Claims Type</th>
                                <th>Nett Claims (RM)</th>
                                <th>Status</th>
                                <th>Submission Date</th>
                                
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                       @if (@item.DisplayText2 != "CIS01")
                                       {
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Claims/Index")?ID=@item.SourceID">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                       }
                                       else
                                       {
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Claims/ViewILSASClaims")?ID=@item.SourceID">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                       }
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.ApplicantCode - @item.ApplicantName</td>
                                    <td>@item.DisplayText1</td>
                                    <td>@item.DisplayText2</td>
                                    <td>@item.DisplayText6</td>
                                    <td style="color:green;"><b>@item.DisplayText8</b></td>
                                    @if (!String.IsNullOrEmpty(item.CreatedDate.ToString()))
                                    {
                                        <td>@Convert.ToDateTime(item.CreatedDate).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>