@model List<ESS.Core.DropDownObject>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "iDispensary Approval History";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            iDispensary Approval History<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Dispensary</label>
                    <div class="col-md-8 form-control-static">
                        @Html.DropDownList("Dispensary", new SelectList(Model, "Value", "Text"), "- All -", new { @class = "bs-select form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Vendor</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Vendor">
                            <option value="">- All -</option>
                            <option value="F. Spektrum">F. Spektrum</option>
                            <option value="JN Medical">JN Medical</option>
                            <option value="M.S. Ally">M.S. Ally</option>
                            <option value="Pharmaniaga">Pharmaniaga</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Partial("_PeoplePicker")
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Action Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="ActionType">
                            <option value="">- All -</option>
                            <option value="Verified">Verified</option>
                            <option value="PRCreated">PR Created</option>
                            <option value="Processed">Processed</option>
                            <option value="Declined">Declined</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Action Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="ActDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Action Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="ActDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function SearchListing() {
        var _SubDateFrom = $('#SubDateFrom').val();
        var _SubDateTo = $('#SubDateTo').val();
        var _Dispensary = $('#Dispensary').val();
        var _Vendor = $('#Vendor').val();
        var _SubmittedBy = $('#hfEmpID').val();
        var _ActionType = $('#ActionType').val();
        var _ActDateFrom = $('#ActDateFrom').val();
        var _ActDateTo = $('#ActDateTo').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/MSS/_VendorAppHistoryResult")',
            cache: false,
            dataType: "html",
            data: {
                SubDateFrom: _SubDateFrom, SubDateTo: _SubDateTo, Dispensary: _Dispensary, Vendor: _Vendor,
                SubmittedBy: _SubmittedBy, ActionType: _ActionType, ActDateFrom: _ActDateFrom, ActDateTo: _ActDateTo
            },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function ConvertDate(_date) {
        var mnth = ("0" + (_date.getMonth() + 1)).slice(-2),
            day = ("0" + _date.getDate()).slice(-2);

        return [day, mnth, _date.getFullYear()].join("/");
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        });

        var _Today = new Date();
        _Today.setDate(_Today.getDate() - 60);
        var _Start = ConvertDate(_Today);

        $('#SubDateFrom').val(_Start);
        $('#SubDateTo').val(ConvertDate(new Date()));

        SearchListing();
    });
</script>