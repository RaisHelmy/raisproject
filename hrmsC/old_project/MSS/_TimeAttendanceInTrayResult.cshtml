@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Timesheet Attendance In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th>Action</th>
                                <th>Status</th>
                                <th>Employee</th>
                                <th>Subtype</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Total Hours</th>
                                <th>Acc OT Hours</th>
                                <th>Charge Code</th>
                                <th>TCS No.</th>
                                <th>Ori OT Planning</th>
                                <th>No. of Meal</th>
                                <th>EASy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <div>
                                            <i class="fa fa-exclamation-circle ErrorMsg" name="ErrorMsg"
                                               style="font-size:24px;color:red;display: none"
                                               data-toggle="tooltip" title=""></i>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="checkbox" class="OTPlanningCheckBox" name="OTPlanningCheckBox" value="@item.ID" />
                                        <input type="hidden" class="EntryID" name="EntryID" value="@item.SourceID" />
                                    </td>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/TimeAttendance/TimesheetDetails")?ID=@item.SourceID&TaskID=@item.ID&Source=InTray">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td class="YesAction" name="YesAction"> @item.YesAction </td>
                                    @if (@item.DisplayText6 == "Declined" || @item.DisplayText6 == "Withdrawn")
                                    {
                                        <td style="color:red;" class="Status" name="Status"><b>@item.DisplayText7</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;" class="Status" name="Status"><b>@item.DisplayText7</b></td>
                                    }
                                    <td>@item.DisplayText10 - @item.DisplayText9</td>
                                    <td>@item.DisplayText2</td>
                                    <td>@item.DisplayText3</td>
                                    <td>@item.DisplayText4</td>
                                    <td>@item.DisplayText5</td>
                                    <td>@item.DisplayText6</td>
                                    <td>@item.DisplayText11</td>
                                    <td>@item.DisplayText12</td>
                                    <td>@item.DisplayText13</td>
                                    <td>@item.DisplayText16</td>
                                    <td>@item.DisplayText17</td>
                                    <td>@item.DisplayText18</td>
                                    <td>

                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>