@model List<SEP.RoutingManagement.Models.GetMyApprovalHistory>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Approval History
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee Number</th>
                                <th>Employee Name</th>
                                <th>Submission Date</th>
                                <th>Status</th>
                                <th>Action Type</th>
                                <th>Action Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/MedicalBoard/Index")?MedicalBoardID=@item.SourceID&TaskID=@item.ID&Source=ApprovalHistory">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.ApplicantCode</td>
                                    <td>@item.ApplicantName</td>
                                    @if (!String.IsNullOrEmpty(item.DisplayText7))
                                    {
                                        <td>@Convert.ToDateTime(item.DisplayText7).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (item.DisplayText6 == "Declined" || item.DisplayText6 == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.DisplayText6</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.DisplayText6</b></td>
                                    }
                                    <td>@item.ApproverAction</td>
                                    @if (item.ActionDate.HasValue)
                                    {
                                        <td>@item.ActionDate.Value.ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    transformTable("#tblResult");
</script>