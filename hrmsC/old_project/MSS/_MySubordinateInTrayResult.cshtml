@model List<SEP.RoutingManagement.Models.GetMyIntray>

@{

	Layout = null;
}

<div class="portlet box blue">
	<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
	<div class="portlet-title">
		<div class="caption">
			<i class="fa fa-reorder"></i>My Subordinate In-Tray
		</div>
		<div class="tools">
		</div>
	</div>
	<div class="portlet-body form">
		<div class="form-body">
			<div class="form-horizontal">
				<div class="table-toolbar">
					<table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
						<thead>
							<tr>
								<th>Employee No</th>
								<th>Employee Name</th>
								<th>Employee Group</th>
								<th>Company</th>
								<th>Department</th>
								<th>Unit / Section</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in @Model)
							{
							<tr>
								<td>@item.DisplayText1</td>
								<td>@item.DisplayText2</td>
								<td>@item.DisplayText3</td>
								<td>@item.DisplayText4</td>
								<td>@item.DisplayText5</td>
								<td>@item.DisplayText6</td>
							</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>
