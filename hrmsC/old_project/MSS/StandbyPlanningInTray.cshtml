@using ESS.Core

@model List<ESS.Core.DropDownObject>

@{
	Layout = "~/Views/Shared/_Layout.cshtml";

	ViewBag.Title = "Standby Planning In-tray";

	DateTime d1 = DateTime.Now.AddYears(-20);
	DateTime d2 = DateTime.Now.AddYears(20);
	string dtStrStart = d1.ToString("dd/MM/yyyy");
	string dtStrEnd = d2.ToString("dd/MM/yyyy");
}

<div class="row">
	<div class="col-md-12">
		<br />
		<h1 class="page-title">
			Standby Planning In-tray<span style="padding-left:20px;"><small></small></span>
		</h1>
	</div>
</div>
<br />
<div class="form-body">
	<div class="row">
		<div class="col-md-6">
			<div class="form-horizontal">
				<div class="form-group">
					<label class="col-md-5 control-label">Start Date</label>
					<div class="col-md-7 form-control-static">
						<div class="input-group date date-picker" id="divSubmissionDateFrom" data-date-format="dd MM yyyy">
							<input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
							<span class="input-group-btn">
								<button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="form-horizontal">
				<div class="form-group">
					<label class="col-md-5 control-label">End Date</label>
					<div class="col-md-7 form-control-static">
						<div class="input-group date date-picker" id="divSubmissionDateTo" data-date-format="dd MM yyyy">
							<input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
							<span class="input-group-btn">
								<button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-md-6">
			<div class="form-horizontal">
				<div class="form-group">
					<label class="col-md-5 control-label">Status</label>
					<div class="col-md-7 form-control-static">
						<select class="form-control" id="Status">
							<option value="">- All -</option>
							<option value="Pending">Pending</option>
							<option value="Verified">Verified</option>
							@*<option value="Approved">Approved</option>*@
							@*<option value="Rework">Rework</option>*@
							@*<option value="Declined">Declined</option>*@
						</select>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="form-horizontal">
				<div class="form-group">
					<label class="col-md-5 control-label">Employee Code</label>
					<div class="col-md-7 form-control-static">
						@Html.Partial("_PeoplePicker")
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">&nbsp;</div>
	<div class="row">
		<div class="col-md-12">
			<div class="text-right">
				<input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
				<input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
			</div>
		</div>
	</div>
	<div class="row">&nbsp;</div>
	<div class="row">
		<div class="col-md-12">
			<div id="SearchResult">

			</div>
		</div>
	</div>
</div>

<script type="text/javascript">
    function SearchListing() {
        var _DateFrom = $('#SubDateFrom').val();
		var _DateTo = $('#SubDateTo').val();
		var _Status = $('#Status').val();
        var _EmpID = $('#hfEmpID').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/MSS/_StandbyPlanningInTrayResult")',
            cache: false,
            dataType: "html",
            data: { DateFrom: _DateFrom, DateTo: _DateTo, Status: _Status, SearchEmpID: _EmpID },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

	jQuery(document).ready(function () {
		$('.date-picker').datepicker({
			format: 'dd/mm/yyyy',
			autoclose: true
		});

        $('#divSubmissionDateFrom').datepicker('setStartDate', '@dtStrStart');
        $('#divSubmissionDateFrom').datepicker('setEndDate', '@dtStrEnd');

        $('#divSubmissionDateTo').datepicker('setStartDate', '@dtStrStart');
        $('#divSubmissionDateTo').datepicker('setEndDate', '@dtStrEnd');

        $("#divSubmissionDateFrom").datepicker({
            autoclose: true,
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());

            minDate.setDate(minDate.getDate() + 1);
            $('#divSubmissionDateTo').datepicker('setStartDate', minDate);
        });

        $("#divSubmissionDateTo").datepicker({
            autoclose: true,
        })
            .on('changeDate', function (selected) {
                var minDate = new Date(selected.date.valueOf());
                minDate.setDate(minDate.getDate() - 1);
                $('#divSubmissionDateFrom').datepicker('setEndDate', minDate);
            });

        $("#SubDateFrom").on("blur", function (e) {
            if ($('#SubDateFrom').val() == "") {
                $('#divSubmissionDateTo').datepicker('setStartDate', '@dtStrStart');
            }

        });

        $("#SubDateTo").on("blur", function (e) {
            if ($('#SubDateTo').val() == "") {
                $('#divSubmissionDateFrom').datepicker('setEndDate', '@dtStrEnd');
            }

        });

        SearchListing();
    });

    function ClearFilter() {
        $('#SubDateFrom').val('');
		$('#SubDateTo').val('');
		$('#Status').val('');
        $('#hfEmpID').val('');
        $('#txtEmpName').val('');
        
        SearchListing();
	}
</script>