<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false

    });

    var IsAddRow = "0";

    function dTable_@(DataTableID)Validation() { // @(DataTableID)Validation
        var _ValidationMsg = '';

        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();

            var _StartDate = $row.find(".SubTypeColumn1").val();
            var _EndDate = $row.find(".SubTypeColumn2").val();
            var _StayType = $row.find(".SubTypeColumn4").val();
            var _ReceiptChecked = $row.find(".SubTypeColumn5").prop('checked');
            var _PaymentMode = $row.find(".PaymentMode").val();
            var _ServiceCharge = $row.find(".SubTypeColumn9").val();
            var _ExchangeRate = $row.find(".SubTypeColumn11").val();
            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n'
            }

            if (_Amount == null || _Amount == '0.00' || _Amount == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is required.\n';
            }
            if (_Amount == 'Infinity') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is invalid.\n';
            }
            if (_StartDate == null || _StartDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Start Date) is required.\n';
            }
            if (_EndDate == null || _EndDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (End Date) is required.\n';
            }

            if (!(_StartDate == null || _StartDate == '') && !(_EndDate == null || _EndDate == '')) {

                var startDateString = _StartDate + " 00:00";
                var endDateString = _EndDate + " 00:00";

                var StartDate = moment(startDateString, "DD/MM/YYYY HH:mm")._d;
                var EndDate = moment(endDateString, "DD/MM/YYYY HH:mm")._d;

                if (EndDate < StartDate) {
                    _ValidationMsg += ('- @ClaimsSubtypeName End Date has to be later than Start Date.\n');
                }

                if (_StartDate == _EndDate) {
                    _ValidationMsg += ('- @ClaimsSubtypeName Start Date and End Date cannot be a same date.\n');
                }
            }

            if (_StayType == null || _StayType == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Stay Type) is required.\n';
            }

            if (_ReceiptChecked && (_PaymentMode == null || _PaymentMode == "")) {
                _ValidationMsg += '- @ClaimsSubtypeName (Payment Mode) is required.\n';
            }

            if (_ServiceCharge == null || _ServiceCharge == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Service Charge / Late Check Out) is required.\n';
            }

            if (_ExchangeRate == null || _ExchangeRate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Exchange Rate) is required.\n';
            }

             var _GSTAmount = $row.find(".GSTAmount").val();
            var gstAmt = 0;
            if ('@GSTEnabled' != 'false') {

                if (_GSTAmount == null || _GSTAmount == '') {
                    _ValidationMsg += '- @ClaimsSubtypeName (GST Amount) is required.\n';
                }

                var gstMaxValue = '@GSTMaximumValue';
                gstAmt = parseFloat(_Amount) * (parseFloat(gstMaxValue) / 100);
                if ((parseFloat(_GSTAmount) || 0) > (parseFloat(gstAmt.toFixed(2)) || 0)) {
                    _ValidationMsg += '- @ClaimsSubtypeName - The GST Amount (highlighted in yellow) has exceeded the maximum value.Please edit or delete the record to proceed.\n';
                    $row.find(".GSTAmount").css("background-color", "yellow");
                }
                else {
                    $row.find(".GSTAmount").css("background-color", "white");
                }

            }

        });

        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="@(DataTableID)RemoveCheckbox"]:checked'), function (i, val) {
            var currLength = $('#tbl@(DataTableID) tr').length - 2;
            var row = $(this).closest("tr").get(0);
            if (currLength > 1) {
                _@(DataTableID)Table.fnDeleteRow(mytable.fnGetPosition(row));
            }
        });

        reorderTable('#tbl@(DataTableID)');
        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_add5Row() {
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
    }

