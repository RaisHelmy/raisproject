@model ESS.Claim.ViewModels.ClaimsSubtype
@using TNB_ESS_MVC.Helpers
@{
    Layout = null;
    string ClaimType = Model.ClaimSubTypeCategory;
    string ClaimsSubtypeName = ViewBag.HotelOverseas_ClaimsSubtypeName;
    string GSTEnabled = (ViewBag.HotelOverseas_GSTEnabled + "").ToLower();
    string Status = ViewBag.HotelOverseas_Status;
    string dtStrStart = ViewBag.HotelOverseas_StartDate;
    string dtStrEnd = ViewBag.HotelOverseas_EndDate;
    string GSTMaximumValue = ViewBag.HotelOverseas_GSTMaximumValue;
    string HotelRateHalfNoReceipt = ViewBag.HotelOverseas_HotelRateHalfNoReceipt;
    string HotelRateHalfYesReceipt = ViewBag.HotelOverseas_HotelRateHalfYesReceipt;
    string HotelRateFullNoReceipt = ViewBag.HotelOverseas_HotelRateFullNoReceipt;
    string HotelRateFullYesReceipt = ViewBag.HotelOverseas_HotelRateFullYesReceipt;
    string MaxClaimHalfYesReceipt = ViewBag.HotelOverseas_MaxClaimHalfYesReceipt;
    string MaxClaimHalfNoReceipt = ViewBag.HotelOverseas_MaxClaimHalfNoReceipt;
    string MaxClaimFullYesReceipt = ViewBag.HotelOverseas_MaxClaimFullYesReceipt;
    string MaxClaimFullNoReceipt = ViewBag.HotelOverseas_MaxClaimFullNoReceipt;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;

    List<SelectListItem> HotelStateList = ViewBag._ddlHotelState;
    List<SelectListItem> HotelList = ViewBag._ddlHotels;

    SelectListItem Item = new SelectListItem();
    Item.Text = "- OTHERS -";
    Item.Value = "- OTHERS -";

    HotelList.Add(Item);
}
<style>
    .select2-dropdown-none {
        display: none !important;
    }
</style>
<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimType - @ClaimsSubtypeName
        </div>

        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')"><img style=" vertical-align: initial;" src="../Assets/img/portlet-remove-icon-white.png" /></a>
            </div>

        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Charge Code *</th>
                                <th scope="col">Start Date *</th>
                                <th scope="col">End Date *</th>
                                <th scope="col">No. of Days</th>
                                <th scope="col">Stay Type *</th>
                                <th scope="col">With Receipts?</th>
                                <th scope="col">Receipt No.</th>
                                <th scope="col">Payment Mode *</th>
                                <th scope="col">No. Of Person *</th>
                                <th scope="col">Hotel State *</th>
                                <th scope="col">Hotel Name *</th>
                                <th scope="col">Hotel Rate (FC)</th>
                                <th scope="col">Hotel Amount (FC)</th>
                                <th scope="col">Service Charge / Late Check Out (FC) *</th>
                                <th scope="col">Total Hotel (FC)</th>
                                <th scope="col">Exchange Rate *</th>
                                <th scope="col">Total Hotel (RM)</th>
                                <th scope="col">Total Claimable (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @{
                            List<SelectListItem> StayTypeList = new List<SelectListItem>();
                            StayTypeList.Add(new SelectListItem { Text = "- Select One -", Value = "" });
                            StayTypeList.Add(new SelectListItem { Text = "Half Day", Value = "Half Day" });
                            StayTypeList.Add(new SelectListItem { Text = "Full Day", Value = "Full Day" });

                            List<SelectListItem> NoOfPerson = new List<SelectListItem>();
                            NoOfPerson.Add(new SelectListItem { Text = "1", Value = "1", Selected = true });
                            NoOfPerson.Add(new SelectListItem { Text = "2", Value = "2" });
                            NoOfPerson.Add(new SelectListItem { Text = "3", Value = "3" });
                            NoOfPerson.Add(new SelectListItem { Text = "4", Value = "4" });
                            NoOfPerson.Add(new SelectListItem { Text = "5", Value = "5" });
                            NoOfPerson.Add(new SelectListItem { Text = "6", Value = "6" });
                            NoOfPerson.Add(new SelectListItem { Text = "7", Value = "7" });
                            NoOfPerson.Add(new SelectListItem { Text = "8", Value = "8" });
                            NoOfPerson.Add(new SelectListItem { Text = "9", Value = "9" });
                            NoOfPerson.Add(new SelectListItem { Text = "10", Value = "10" });

                            List<SelectListItem> HotelNameList = new List<SelectListItem>();
                            HotelNameList.Add(new SelectListItem { Text = "- Select One -", Value = "" });


                        }

                        @Html.DropDownList(DataTableID + "hiddenDDL", StayTypeList,
                             new { @id = DataTableID + "hiddenDDL", @class = "bs-select form-control hidden " + DataTableID + "hiddenDDL", @style = "min-width:200px" })

                        @Html.DropDownList(DataTableID + "hiddenDDLPerson", NoOfPerson,
                             new { @id = DataTableID + "hiddenDDLPerson", @class = "bs-select form-control hidden " + DataTableID + "hiddenDDLPerson", @style = "min-width:200px" })

                        @Html.DropDownList(DataTableID + "hiddenDDLState", HotelStateList,
                             new { @id = DataTableID + "hiddenDDLState", @class = "bs-select form-control hidden " + DataTableID + "hiddenDDLState", @style = "min-width:200px" })

                        @Html.DropDownList(DataTableID + "hiddenDDLHotel", HotelList,
                             new { @id = DataTableID + "hiddenDDLHotel", @class = "bs-select form-control hidden " + DataTableID + "hiddenDDLHotel", @style = "min-width:200px" })

                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                        <td>
                                            <input type="hidden" class="hfChargeCode" />
                                            <select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" class="form-control SubTypeColumn1" onchange="@(DataTableID)_Calculation(this)"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" class="form-control SubTypeColumn2" onchange="@(DataTableID)_Calculation(this)"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn3"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" />
                                        </td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn4", StayTypeList,
                                     new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn4", @class = "bs-select form-control SubTypeColumn4", @style = "min-width:200px", @onchange = DataTableID + "_Calculation(this)" })
                                        </td>
                                        <td>
                                            <input type="hidden" value="" class="@(DataTableID)_hfReceipt" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" />
                                            <input type="checkbox" class="@(DataTableID)ReceiptCheckbox SubTypeColumn5"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5"
                                                   onchange="@(DataTableID)_ReceiptChange(this);" /> Yes
                                        </td>
                                        <td>
                                            <input type="hidden" value="Overseas" class="form-control Location" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Location"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Location" />
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn6"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" />
                                        </td>
                                        <td>
                                            <select class="bs-select form-control PaymentMode" style="min-width: 200px;"
                                                    name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].PaymentMode"
                                                    onchange="@(DataTableID)_Calculation(this)">
                                                <option value="">- Select One -</option>
                                                <option value="Cash">Cash</option>
                                                <option value="Online/Credit Card">Online/Credit Card</option>
                                            </select>
                                        </td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].NoOfPerson", NoOfPerson,
                                     new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].NoOfPerson", @class = "bs-select form-control NoOfPerson", @style = "min-width:120" })
                                        </td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].HotelState", HotelStateList,
                                     new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].HotelState", @class = "bs-select form-control HotelState", @style = "min-width:200", @onchange = DataTableID + "_PopulateHotel(this)" })

                                        </td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].HotelName", HotelList,
                                     new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].HotelName", @class = "bs-select form-control HotelName", @style = "min-width:200" })
                                            <span id="SpanShowHideOtherHotelName_ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].OtherHotelName" class="SpanShowHideOtherHotelName">
                                                <input type="text" style="min-width:150px" maxlength="30" class="form-control OtherHotelName"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].OtherHotelName"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].OtherHotelName" />
                                            </span>
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right SubTypeColumn7" onblur="@(DataTableID)_Calculation(this)"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right SubTypeColumn8"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right SubTypeColumn9" onblur="@(DataTableID)_Calculation(this)"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn9"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn9" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right SubTypeColumn10"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn10"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn10" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right SubTypeColumn11" onblur="@(DataTableID)_Calculation(this)"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn11"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn11" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right SubTypeColumn12"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn12"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn12" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right Amount" value="0.00"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right GSTAmount" value="0.00"
                                                   onblur="@(DataTableID)_CalculateSumGST(this);"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right TotalAmount" value="0.00"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" readonly />
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="18"></td>
                                        <td><input type="text" style="min-width:130px" value="0.00" class="form-control text-right GrandAmount" readonly /></td>
                                        <td><input type="text" style="min-width:130px" value="0.00" class="form-control text-right GrandGSTAmount" readonly /></td>
                                        <td><input type="text" style="min-width:130px" value="0.00" class="form-control text-right GrandTotalAmount" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>

                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                            <td>
                                                <input type="hidden" class="hfChargeCode" value="@thisDetail.SubTypeColumn0" />
                                                <select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                    <input type="text" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1"
                                                           onchange="@(DataTableID)_Calculation(this)"
                                                           id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1"
                                                           name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                    <input type="text" class="form-control SubTypeColumn2" value="@thisDetail.SubTypeColumn2"
                                                           onchange="@(DataTableID)_Calculation(this)"
                                                           id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn2"
                                                           name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn2" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control SubTypeColumn3" value="@thisDetail.SubTypeColumn3"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn3"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn3" />
                                            </td>
                                            <td>
                                                <input type="hidden" value="@thisDetail.SubTypeColumn4" />
                                                @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].SubTypeColumn4", StayTypeList,
                                                new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].SubTypeColumn4", @class = "bs-select form-control SubTypeColumn4", @style = "min-width:200px", @onchange = DataTableID + "_Calculation(this)" })
                                            </td>
                                            <td>
                                                <input type="hidden" class="@(DataTableID)_hfReceipt" value="@thisDetail.SubTypeColumn5"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn5" />
                                                <input type="checkbox" class="@(DataTableID)ReceiptCheckbox SubTypeColumn5"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn5"
                                                       onchange="@(DataTableID)_ReceiptChange(this);" /> Yes
                                            </td>
                                            <td>
                                                <input type="hidden" value="@thisDetail.Location" class="form-control Location"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Location"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Location" />
                                                <input type="text" style="min-width:130px" class="form-control SubTypeColumn6" value="@thisDetail.SubTypeColumn6"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn6"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn6" />
                                            </td>
                                            <td>
                                                <select class="bs-select form-control PaymentMode" style="min-width: 200px;"
                                                        name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].PaymentMode"
                                                        onchange="@(DataTableID)_Calculation(this)">
                                                    <option value="">- Select One -</option>
                                                    <option value="Cash" @(thisDetail.PaymentMode == "Cash" ? @"selected=selected" : "")>Cash</option>
                                                    <option value="Online/Credit Card" @(thisDetail.PaymentMode == "Online/Credit Card" ? @"selected=selected" : "")>Online/Credit Card</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input type="hidden" value="@thisDetail.NoOfPerson" />
                                                @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].NoOfPerson", NoOfPerson,
                                                new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].NoOfPerson", @class = "bs-select form-control NoOfPerson", @style = "min-width:120px" })
                                            </td>
                                            <td>
                                                <input type="hidden" value="@thisDetail.HotelState" />
                                                @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].HotelState", HotelStateList,
                                                new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].HotelState", @class = "bs-select form-control HotelState", @style = "min-width:200px", @onchange = DataTableID + "_PopulateHotel(this)" })
                                            </td>
                                            <td>
                                                <input type="hidden" value="@thisDetail.HotelName" />
                                                @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].HotelName", HotelList,
                                                new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].HotelName", @class = "bs-select form-control HotelName", @style = "min-width:200px" })

                                                <span id="SpanShowHideOtherHotelName_ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].OtherHotelName" class="SpanShowHideOtherHotelName">
                                                    <input type="text" style="min-width:150px" maxlength="30" class="form-control OtherHotelName" value="@thisDetail.OtherHotelName"
                                                           id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].OtherHotelName"
                                                           name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].OtherHotelName" />
                                                </span>
                                            </td>
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control text-right SubTypeColumn7" value="@thisDetail.SubTypeColumn7"
                                                       onblur="@(DataTableID)_Calculation(this)"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn7"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn7" />
                                            </td>
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control text-right SubTypeColumn8" value="@thisDetail.SubTypeColumn8"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn8"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn8" />
                                            </td>
                                            <td>
