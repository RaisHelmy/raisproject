    function @(DataTableID)_Calculation(x) {
        var $row = $(x).closest("tr");
        var _StartDate = document.getElementById($row.find(".SubTypeColumn1").attr('id'));
        var _EndDate = document.getElementById($row.find(".SubTypeColumn2").attr('id'));
        var _NoDays = document.getElementById($row.find(".SubTypeColumn3").attr('id'));
        var _StayType = document.getElementById($row.find(".SubTypeColumn4").attr('id'));
        var _WithReceipts = document.getElementById($row.find(".SubTypeColumn5").attr('id'));
        var _PaymentMode = $row.find('.PaymentMode');
        var _Location = document.getElementById($row.find(".Location").attr('id'));
        var _HotelRate = document.getElementById($row.find(".SubTypeColumn7").attr('id'));
        var _HotelAmount = document.getElementById($row.find(".SubTypeColumn8").attr('id'));
        var _ServiceCharge = document.getElementById($row.find(".SubTypeColumn9").attr('id'));
        var _TotalHotelFC = document.getElementById($row.find(".SubTypeColumn10").attr('id'));
        var _ExchangeRate = document.getElementById($row.find(".SubTypeColumn11").attr('id'));
        var _TotalHotelRM = document.getElementById($row.find(".SubTypeColumn12").attr('id'));
        var _TotalClaim = document.getElementById($row.find(".Amount").attr('id'));
        var _GSTAmount = document.getElementById($row.find(".GSTAmount").attr('id'));
        var _TotalAmount = document.getElementById($row.find(".TotalAmount").attr('id'));

        if (_StartDate.value != "" && _EndDate.value != "") {
            var from = toDate(_StartDate.value);
            var to = toDate(_EndDate.value);

            if (to < from) {
                _EndDate.value = _StartDate.value;
            }

            from = toDate(_StartDate.value);
            to = toDate(_EndDate.value);
            var timeDiff = Math.abs(to.getTime() - from.getTime());
            var days = Math.ceil(timeDiff / (1000 * 3600 * 24));

            if (days != "0") {
                _NoDays.value = days;
            }
            else {
                _NoDays.value = "1";
            }
        }

        if (_StartDate.value != "" && _EndDate.value != "" && _StayType.value != "") {
            var MaxClaim = 0;
            var Rate = 0;
            var receipt = _WithReceipts.checked;

            if (receipt) {
                _Location.value = "Overseas";
                _HotelRate.readOnly = false;
                _ServiceCharge.readOnly = false;
                _ExchangeRate.readOnly = false;

                if (_StayType.value == "Full Day") {
                    MaxClaim = '@MaxClaimFullYesReceipt';
                    Rate = '@HotelRateFullYesReceipt';
                }
                if (_StayType.value == "Half Day") {
                    MaxClaim = '@MaxClaimHalfYesReceipt';
                    Rate = '@HotelRateHalfYesReceipt';
                }

                _HotelRate = document.getElementById($row.find(".SubTypeColumn7").attr('id'));
                _ServiceCharge = document.getElementById($row.find(".SubTypeColumn9").attr('id'));
                _ExchangeRate = document.getElementById($row.find(".SubTypeColumn11").attr('id'));

                _HotelRate.value = @(DataTableID)_FormatNumber(_HotelRate, _HotelRate.value);
                _ServiceCharge.value = @(DataTableID)_FormatNumber(_ServiceCharge, _ServiceCharge.value);
                _ExchangeRate.value = @(DataTableID)_FormatNumber(_ExchangeRate, _ExchangeRate.value);

                if (_HotelRate.value != "" && _ServiceCharge.value != "" && _ExchangeRate.value != "") {
                    var hotelratefc = _HotelRate.value;
                    hotelratefc = hotelratefc * 1;
                    var hotelamtfc = (parseFloat(hotelratefc) || 0) * (parseFloat(_NoDays.value) || 0);
                    var servicecharge = _ServiceCharge.value * 1;
                    var totalhotelfc = hotelamtfc + servicecharge;
                    var exchange = _ExchangeRate.value * 1;
                    var totalHotelRM = (parseFloat(totalhotelfc) || 0) * (parseFloat(exchange) || 0);
                    var maxclaimTotal = (parseFloat(MaxClaim) || 0) * (parseFloat(exchange) || 0);
                    var totalclaim = 0;
                    var gstAmt = 0;
                    var TotalAmount = 0;

                    if (maxclaimTotal <= totalHotelRM) {
                        totalclaim = totalHotelRM;
                    }
                    else {
                        totalclaim = maxclaimTotal;
                    }

                    if ('@GSTEnabled' != 'false') {
                        var gstMaxValue = '@GSTMaximumValue';
                        if (totalclaim != "0") {
                            gstAmt = (parseFloat(totalclaim) || 0) * (parseFloat(gstMaxValue) / 100);
                        }
                    }
                    TotalAmount = (parseFloat(totalclaim) || 0) + ((parseFloat(gstAmt) || 0));

                    _HotelRate.value = hotelratefc.toFixed(2);
                    _HotelAmount.value = hotelamtfc.toFixed(2);
                    _TotalHotelFC.value = totalhotelfc.toFixed(2);
                    _TotalHotelRM.value = totalHotelRM.toFixed(2);
                    _TotalClaim.value = totalclaim.toFixed(2);
                    _GSTAmount.value = gstAmt.toFixed(2);
                    _TotalAmount.value = TotalAmount.toFixed(2);
                }

                __essClaim.EnableDropdown(_PaymentMode);
                if (_PaymentMode.val() == "Cash") {
                    _Location.value = "Overseas";
                }
                else {
                    _Location.value = "Domestic";
                }
            }
            else {
                _Location.value = "Domestic";
                _HotelRate.readOnly = true;
                _ServiceCharge.readOnly = true;
                _ExchangeRate.readOnly = true;
                __essClaim.DisableDropdown(_PaymentMode);

                if (_StayType.value == "Full Day") {
                    MaxClaim = '@MaxClaimFullNoReceipt';
                    Rate = '@HotelRateFullNoReceipt';
                }
                if (_StayType.value == "Half Day") {
                    MaxClaim = '@MaxClaimHalfNoReceipt';
                    Rate = '@HotelRateHalfNoReceipt';
                }

                if (_ExchangeRate.value == "") {
                    _ExchangeRate.value = "1.00";
                }
                _ServiceCharge.value = "0.00";
                _ExchangeRate.value = @(DataTableID)_FormatNumber(_ExchangeRate, _ExchangeRate.value);
                _ServiceCharge.value = @(DataTableID)_FormatNumber(_ServiceCharge, _ServiceCharge.value);

                var hotelratefc = Rate;
                hotelratefc = hotelratefc * 1;
                var hotelamtfc = (parseFloat(hotelratefc) || 0) * (parseFloat(_NoDays.value) || 0);
                var servicecharge = _ServiceCharge.value * 1;
                var totalhotelfc = hotelamtfc + servicecharge;
                var exchange = _ExchangeRate.value * 1;
                var totalHotelRM = (parseFloat(totalhotelfc) || 0) * (parseFloat(exchange) || 0);
                var maxclaimTotal = (parseFloat(MaxClaim) || 0) * (parseFloat(exchange) || 0);
                var totalclaim = 0;
                var gstAmt = 0;
                var TotalAmount = 0;

                if (maxclaimTotal <= totalHotelRM) {
                    totalclaim = totalHotelRM;
                }
                else {
                    totalclaim = maxclaimTotal;
                }

                if ('@GSTEnabled' != 'false') {
                    var gstMaxValue = '@GSTMaximumValue';
                    if (totalclaim != "0") {
                        gstAmt = (parseFloat(totalclaim) || 0) * (parseFloat(gstMaxValue) / 100);
                    }
                }
                TotalAmount = (parseFloat(totalclaim) || 0) + ((parseFloat(gstAmt) || 0));

                _HotelRate.value = hotelratefc.toFixed(2);
                _HotelAmount.value = hotelamtfc.toFixed(2);
                _TotalHotelFC.value = totalhotelfc.toFixed(2);
                _TotalHotelRM.value = totalHotelRM.toFixed(2);
                _TotalClaim.value = totalclaim.toFixed(2);
                _GSTAmount.value = gstAmt.toFixed(2);
                _TotalAmount.value = TotalAmount.toFixed(2);
            }
        }

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaximumValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".TotalAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandTotal + (_TotalAmount * 1);
            }
        });
        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
        CalculateSummary();
    }

    function @(DataTableID)_FormatNumber(x, val) {
        var number = "";
        var myNumeric = parseFloat(val.replace(/,/g, ''));
        if (!myNumeric) {
            number = "0.00";
        }
        else {
            if ($(x).hasClass("SubTypeColumn11")) {
                number = parseFloat(myNumeric.toFixed(10));
            }
            else {
                number = myNumeric.toFixed(2);
            }
        }

        return number;
    }

    function @(DataTableID)_PopulateHotel(x) {
        var $row = $(x).closest("tr");
        var _StateName =  document.getElementById($row.find(".HotelState").attr('id'));
        var _HotelName = document.getElementById($row.find(".HotelName").attr('id'));
        var _SpanShowHideOtherHotelName = document.getElementById($row.find(".SpanShowHideOtherHotelName").attr('id'));

        @(DataTableID)_PopulateHotelList(_StateName.value, _HotelName,"", _SpanShowHideOtherHotelName);

    }

    function @(DataTableID)_ShowHideOthers(x, type) {
        var $row = $(x).closest("tr");

        if (type == "- OTHERS -") {
            $row.find(".SpanShowHideOtherHotelName").removeClass("hide");
        } else {
            $row.find(".SpanShowHideOtherHotelName").addClass("hide");
        }


    }



    function @(DataTableID)_PopulateHotelList(StateName, HotelList, HotelName, SpanShowHideOtherHotelName) {
        if (StateName != "") {

            $.ajax({
                type: "GET",
                cache : false,
                url: '@Url.Action("GetHotelByState", "Claims")',
                data: {
                    stateName: StateName
                },
                datatype: "json",
                success: function (data) {


                    var found = 0;
                    HotelList.options.length = 0;

                    for (var i = 0; i < data.length; i++)
                    {
                        var option = document.createElement('option');

                        if (HotelName == data[i].Value) {
                            option.selected = true;
                            found = "1";
                        }

                        option.text = option.value = data[i].Value;
                        HotelList.add(option, i + 1);


                        if (i + 1 == data.length) {
                            var optionOther = document.createElement('option');

                            optionOther.text = optionOther.value = "- OTHERS -";
                             HotelList.add(optionOther, i+2);
                        }
                    }


                    var option = document.createElement('option');
                    option.text = "- Select One -";
                    option.value = "";
                    HotelList.add(option, 0);

                    if (found == "0") {
                        HotelList.value = "";
                    }




                    if (HotelName == "- OTHERS -") {
                        HotelList.value = "- OTHERS -";
                        SpanShowHideOtherHotelName.removeClass("hide");
                    } else {
                         SpanShowHideOtherHotelName.addClass("hide");
                    }

                },
                error: function (e) {
                    alert(e);
                    console.log(e);
                }
            });
        }
    }

    $(document).ready(function () {
        if ('@Status' == "Draft" || '@Status' == "Withdrawn" || '@Status' == "Declined" || '@Status' == "Returned")
        {
            @(DataTableID)_GetInputValues();
            @(DataTableID)_Initialize();

        }
        else {
            @(DataTableID)_GetInputValuesReadOnly();
            $(".@(DataTableID)RemoveCheckbox").uniform();
            $(".@(DataTableID)ReceiptCheckbox").uniform();
        }
    });




</script>