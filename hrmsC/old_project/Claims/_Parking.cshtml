                //$(".BtnPlus5").click(add5Row);

            $(".BtnPlus").click(function () {
                alert($(this).attr('title'));
                    addRow();
                });
        }
        )
    </script>*@

<script>

    function dTable_ParkingValidation() {
        return "";
    }

    jQuery(document).ready(function () {
        App.init();
        TableEditable.init();


        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });
       

        
        //$(".GSTAmount").each(function () {
        //    $(".Amount").keyup(function () {
        //        calculateSum();
        //    });
        //});

        
        //function deleteRow() {
        //    var par = $(this).parent().parent();
        //    par.remove();
        //};
        //$("#dTable").on("click", ".BtnMinus", deleteRow);


        //function is used to delete selected row
        $('.deleteall').on("click", function (event) {
            var tb = $(this).attr('title');
            var sel = false;
            var ch = $('#' + tb).find('tbody input[type=checkbox]');
            var c = confirm('Continue delete?');
            if (c) {
                ch.each(function () {
                    var $this = $(this);
                    if ($this.is(':checked')) {
                        sel = true;	//set to true if there is/are selected row

                        if ($(this).closest('tr').is('tr:only-child')) {
                            alert('Last row of data cannot be deleted. Please click Delete Section to remove this subtype.');
                        } else {
                            $(this).closest("tr.new_line").remove();
                            calculateSum(tb);
                            //$this.parents('tr.new_line').fadeOut(function () {
                            //  //  $(this).closest("tr.new_line").not('#new_line_details_0').remove();
                            //    $(this).closest("tr.new_line").remove();
                            //    calculateSum();
                            //});
                        }


                    }
                });
                if (!sel) alert('No data selected');
            }
            return false;
        });
        //function is used to delete individual row
        $('a.delete_single').on("click", function (event) {
            var $this = $(this);
            var c = confirm('Are you sure to delete this message?');
            if (c) {
                $this.parents('tr').fadeOut(function () {
                    $this.remove();
                });
            }
            return false;
        });



    });

    

  


    //move to master page
    function NumberOnly(evt) {
        var theEvent = evt || window.event;
        var key = theEvent.keyCode || theEvent.which;
        key = String.fromCharCode(key);
        var regex = /[0-9]/;
        if (!regex.test(key)) {
            theEvent.returnValue = false;
            if (theEvent.preventDefault) theEvent.preventDefault();
        }
    }

    



</script>
