@{
    ViewBag.Title = "ClaimTrendAnalysis";
    string EmployeeID = @ViewBag.EmployeeID;
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Claims Trend Analysis<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<iframe id="fraReport" src="@ViewBag.ReportUrl" 
        style="width:100%;height:500px" frameborder="0"></iframe>
<script>
    var table = document.getElementsByTagName('table');
    for (var i = 0; i < table.length; i++) {

        if (table[i].className.indexOf('atQuest_leftNav') != -1) {
            table[i].parentNode.style.display = 'none';
            break;
        }

    }
</script>