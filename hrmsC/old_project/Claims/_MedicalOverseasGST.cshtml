@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.MedicalOverseasGST_GSTMaxValue;
    string GSTMaxValue = ViewBag.MedicalOverseasGST_GSTMaximumValue;
    string GSTEnabled = (@ViewBag.MedicalOverseasGST_GSTEnabled + "").ToLower();
    string Status = @ViewBag.MedicalOverseasGST_Status;
    string dtStrStart = @ViewBag.MedicalOverseasGST_StartDate;
    string dtStrEnd = @ViewBag.MedicalOverseasGST_EndDate;
    string TreatmentRate = @ViewBag.MedicalOverseasGST_TreatmentRate;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
    GSTMaxValue = String.IsNullOrEmpty(Model.GST.ToString()) ? "0" : Model.GST.ToString();
}

<div class="portlet box blue" id="dTable_@(DataTableID)">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimsSubtypeName
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Receipt Date *</th>
                                <th scope="col">Receipt No. *</th>
                                <th scope="col">Amount (FC) *</th>
                                <th scope="col">Name of Hospital/Clinic</th>
                                <th scope="col">Treatment Rate</th>
                                <th scope="col">Total Medical (FC)</th>
                                <th scope="col">Exchange Rate *</th>
                                <th scope="col">Total Medical (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control ReceiptDate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control ReceiptNo" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" /></td>
                                        <td><input type="text" class="form-control text-right AmountFC" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" /></td>
                                        <td><input type="text" class="form-control Name" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4" /></td>
                                        <td><input type="text" class="form-control TreatmentRate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" readonly /></td>
                                        <td><input type="text" class="form-control SubTotalFC" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" readonly /></td>
                                        <td><input type="text" class="form-control ExchangeRate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7" /></td>
                                        <td><input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" readonly /></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                    <input type="text" class="form-control ReceiptDate" value="@thisDetail.SubTypeColumn1"
                                                           name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn1" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="text" class="form-control ReceiptNo" value="@thisDetail.SubTypeColumn2"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn2" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right AmountFC" value="@thisDetail.SubTypeColumn3"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn3" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control Name" value="@thisDetail.SubTypeColumn4"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn4" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control TreatmentRate" value="@thisDetail.SubTypeColumn5"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn5" readonly />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control SubTotalFC" value="@thisDetail.SubTypeColumn6"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn6" readonly />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control ExchangeRate" value="@thisDetail.SubTypeColumn7"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn7" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control Amount" value="@thisDetail.Amount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" readonly />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" readonly />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" readonly />
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                    <tr>
                                        <td>
                                            <input type="text" class="form-control ReceiptDate" value="@thisDetail.SubTypeColumn1"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn1" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control ReceiptNo" value="@thisDetail.SubTypeColumn2"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn2" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right AmountFC" value="@thisDetail.SubTypeColumn3"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn3" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Name" value="@thisDetail.SubTypeColumn4"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn4" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control TreatmentRate" value="@thisDetail.SubTypeColumn5"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn5" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTotalFC" value="@thisDetail.SubTypeColumn6"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn6" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control ExchangeRate" value="@thisDetail.SubTypeColumn7"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn7" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Amount" value="@thisDetail.Amount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" readonly />
                                        </td>
                                    </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="BtnPlus btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_addRow();">
                                    Add Row
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="BtnPlus5 btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_add5Row();">
                                    Add 5 Rows
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="deleteall btn red" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_removeRow();">
                                    Delete Row
                                    <i class="fa fa-minus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_@(DataTableID)Validation() {
        var _ValidationMsg = '';

        $('#tbl@(DataTableID) tbody tr').not(':last').each(function () {
            var _ReceiptDate = $(this).children('td:eq(1)').children('input[type=text]');
            var _ReceiptNo = $(this).children('td:eq(2)').children('input[type=text]');
            var _AmountRM = $(this).children('td:eq(3)').children('input[type=text]');
            var _GSTAmount = $(this).children('td:eq(7)').children('input[type=text]');

            if (_ReceiptDate.value == '')
                _ValidationMsg += '@ClaimsSubtypeName - Receipt Date is required.\n';

            if (_ReceiptNo.value == '')
                _ValidationMsg += '@ClaimsSubtypeName - Receipt No is required.\n';

            if (_AmountRM.value == '')
                _ValidationMsg += '@ClaimsSubtypeName - Amount (RM) field is required.\n';

            if (_GSTAmount.value == '')
                _ValidationMsg += '@ClaimsSubtypeName - GST Amount field is required.\n';
        });

        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="@(DataTableID)RemoveCheckbox"]:checked'), function (i, val) {
            var row = $(this).closest("tr").get(0);
            var id = $(this).attr("id");
            busTable.fnDeleteRow(mytable.fnGetPosition(row));
        });

        reorderTable('#tbl@(DataTableID)');
    }

    function @(DataTableID)_add5Row() {
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
    }

    function @(DataTableID)_addRow() {
        _@(DataTableID)Table.fnAddData([
            '<input type="checkbox" class="@(DataTableID)RemoveCheckbox" />',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy"><input type="text" class="form-control ReceiptDate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" value="" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" class="form-control ReceiptNo" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" /></td>',
            '<input type="text" class="form-control text-right AmountFC" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" /></td>',
            '<input type="text" class="form-control Name" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" /></td>',
            '<input type="text" class="form-control TreatmentRate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" readonly /></td>',
            '<input type="text" class="form-control SubTotalFC" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" readonly /></td>',
            '<input type="text" class="form-control ExchangeRate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" /></td>',
            '<input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Amount" readonly /></td>',
            '<input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].GSTAmount" readonly /></td>',
            '<input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].TotalAmount" readonly /></td>'
        ]);

        @(DataTableID)_Initialize();
    }

    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _TreatmentRate = $(this).children('td:eq(4)').children('input[type=text]');
                var _GSTAmount = $(this).children('td:eq(8)').children('input[type=text]');

                _TreatmentRate.val('@TreatmentRate');
                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }
    }

    function @(DataTableID)n_CalculateSum() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');

        //iterate through each textboxes and add the values
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".Amount").val();
            var gstAmt = 0;
            var gstMaxValue = 0;
            var Subtotalamount = 0;
            if ('@GSTEnabled' != 'false') {
                gstMaxValue = '@GSTMaxValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }

            Subtotalamount = parseFloat(amount) + parseFloat(gstAmt.toFixed(2));
            $row.find(".SubTotalAmount").val(Subtotalamount.toFixed(2));

            //add only if the value is number
            if (!isNaN(amount) && amount.length != 0) {
                grandAmount = (grandAmount + (amount * 1));
                grandGST = (grandGST + (gstAmt * 1));
                grandTotal = grandTotal + (grandAmount + grandGST);
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
    }

    $(document).ready(function () {
        @(DataTableID)_Initialize();
    });
</script>