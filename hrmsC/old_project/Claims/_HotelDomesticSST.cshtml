<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    var IsAddRow = "0";

    function @(DataTableID)_ReceiptChange(row) { 
          @(DataTableID)_CalculateAmount(row);
    }



    function @(DataTableID)_CalculateAmount(row) {
        var $row = $(row).closest("tr");

        var _pkStartDate = $row.find('.SubTypeColumn1').parent();
        var _pkEndDate = $row.find('.SubTypeColumn2').parent();
        var _StartDate = moment(_pkStartDate.datepicker("getDate"));
        var _EndDate = moment(_pkEndDate.datepicker("getDate"));
        var _NoDays =  $row.find('.SubTypeColumn3');
        var _StayType = $row.find('.SubTypeColumn4');
        var _WithReceipts = $row.find('.SubTypeColumn5');
        var _Location = $row.find('.Location');
        var _HotelRate = $row.find('.SubTypeColumn7');
        var _HotelAmount = $row.find('.SubTypeColumn8');
        var _ServiceCharge = $row.find('.SubTypeColumn9');
        var _TotalHotel =  $row.find('.SubTypeColumn10');

        var _TotalClaim = $row.find('.Amount');
        var _GSTAmount =  $row.find('.GSTAmount');
        var _TotalAmount =  $row.find('.TotalAmount');

        if (!_StartDate || !_EndDate) {
            _NoDays.val('0');
            return;
        }
        else {
            if (_StartDate.isAfter(_EndDate)) {
                _pkEndDate.datepicker("setDate", _StartDate._d);
                _EndDate = moment(_pkEndDate.datepicker("getDate"));
            }

            var daysCount = _EndDate.diff(_StartDate, 'days');
            if (daysCount == 0) {
                _NoDays.val("1");
            }
            else {
                _NoDays.val(daysCount);
            }
        }
         
        if (_StayType.val()) {

            var MaxClaim = 0;
            var Rate = 0;
            
            if (_WithReceipts.prop("checked")) {

                $row.find(".@(DataTableID)_hfReceipt").val('true');
                _HotelRate.prop("readonly", false);
                _ServiceCharge.prop("readonly", false);

                if (_StayType.val() == "Full Day") {
                    MaxClaim = '@MaxClaimFullYesReceipt';
                    Rate = '@HotelRateFullYesReceipt';
                }
                if (_StayType.val() == "Half Day") {
                    MaxClaim = '@MaxClaimHalfYesReceipt';
                    Rate = '@HotelRateHalfYesReceipt';
                }

                FormatCurrency(_HotelRate);
                FormatCurrency(_ServiceCharge);
            }
            else {
                $row.find(".@(DataTableID)_hfReceipt").val('false');
                _HotelRate.prop("readonly", true);
                _ServiceCharge.prop("readonly", true);

                if (_StayType.val() == "Full Day") {

                    MaxClaim = '@MaxClaimFullNoReceipt';
                    Rate = '@HotelRateFullNoReceipt';
                }
                if (_StayType.val() == "Half Day") {
                    MaxClaim = '@MaxClaimHalfNoReceipt';
                    Rate = '@HotelRateHalfNoReceipt';
                }

                _ServiceCharge.val("0.00");
                _HotelRate.val(Rate);

                FormatCurrency(_HotelRate);
                FormatCurrency(_ServiceCharge);
            }

            var hotelAmt = (parseFloat(_HotelRate.val()) || 0) * (parseFloat(_NoDays.val()) || 0);
            var totalHotelAmt = (parseFloat(_ServiceCharge.val()) || 0) + hotelAmt;
            var totalClaim = totalHotelAmt;

            if (MaxClaim != 0 && MaxClaim <= totalHotelAmt) {
                totalClaim = MaxClaim;
            }

            _HotelAmount.val(hotelAmt);
            _TotalHotel.val(totalHotelAmt);
            _TotalClaim.val(totalClaim);

            FormatCurrency(_HotelAmount);
            FormatCurrency(_TotalHotel);
            FormatCurrency(_TotalClaim);
        }

        @(DataTableID)_calculateTax($row);
        @(DataTableID)_calculateSubtotal($row);
    };

        function @(DataTableID)_calculateSubtotal (row) {
            var $row = $(row).closest("tr");
            var _Amount = $row.find(".Amount");
            var _GSTAmount = $row.find(".GSTAmount");
            var _TotalAmount =  $row.find(".TotalAmount");
            var amount = parseFloat(_Amount.val()) || 0;
            var gstAmount = parseFloat(_GSTAmount.val()) || 0;
            var totalAmount = amount + gstAmount;

            _TotalAmount.val(totalAmount);
            FormatCurrency(_TotalAmount);
            @(DataTableID)_calculateGrandAmount();
            CalculateSummary();
    };

    function @(DataTableID)_calculateTax(row) {
    @if (Model.IsAllowGST)
    {
        <text>

        var $row = $(row).closest("tr");
        var _Amount = $row.find(".Amount");
        var _GSTAmount = $row.find(".GSTAmount");
        var gstRate = @((Model.GST / 100).ToString("0.00"));

        var amount = parseFloat(_Amount.val()) || 0;
        var gstAmount = amount * gstRate;

        _GSTAmount.val(gstAmount);
        FormatCurrency(_GSTAmount);

        </text>
    }

        @(DataTableID)_calculateGrandAmount();
    };

    function @(DataTableID)_calculateGrandAmount () {

        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".TotalAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandTotal + (_TotalAmount * 1);
            }
        });
        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
    };

    function dTable_@(DataTableID)Validation() { // @(DataTableID)Validation
        var _ValidationMsg = '';

        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();


            var _StartDate = $row.find(".SubTypeColumn1").val();
            var _EndDate = $row.find(".SubTypeColumn2").val();
            var _StayType = $row.find(".SubTypeColumn4").val();
            var _HotelRate = $row.find(".SubTypeColumn7").val();
            var _TaxAmount = $row.find(".SubTypeColumn9").val();
            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n'
            }

            if (_Amount == null || _Amount == '0' || _Amount == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is required.\n'
            }
            if (_Amount == 'Infinity') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is invalid.\n'
            }
            if (_StartDate == null || _StartDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Start Date) is required.\n'
            }
            if (_EndDate == null || _EndDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (End Date) is required.\n'
            }

            if (!(_StartDate == null || _StartDate == '') && !(_EndDate == null || _EndDate == '') ) {
                if (_StartDate == _EndDate) {
                    _ValidationMsg += '- @ClaimsSubtypeName Start Date and End Date cannnot be the same date.\n'
                }

                _StartDate = moment(_StartDate, "DD/MM/YYYY")._d;
                _EndDate = moment(_EndDate, "DD/MM/YYYY")._d;

                if (_EndDate < _StartDate) {
                    _ValidationMsg += ('- @ClaimsSubtypeName End Date cannot be earlier than Start Date.\n');
                }
            }


            if (_StayType == null || _StayType == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Stay Type) is required.\n'
            }
            if (_HotelRate == null || _HotelRate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Hotel Rate) is required.\n'
            }
            if (_TaxAmount == null || _TaxAmount == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Tax Amount) is required.\n'
            }

            var _GSTAmount = $row.find(".GSTAmount").val();
            var gstAmt = 0;
            if ('@GSTEnabled' != 'false') {

                if (_GSTAmount == null || _GSTAmount == '') {
                    _ValidationMsg += '- @ClaimsSubtypeName (GST Amount) is required.\n'
                }

                var gstMaxValue = '@GSTMaximumValue';
                gstAmt = parseFloat(_Amount) * (parseFloat(gstMaxValue) / 100);
                if ((parseFloat(_GSTAmount) || 0) > (parseFloat(gstAmt.toFixed(2)) || 0)) {
                    _ValidationMsg += '- @ClaimsSubtypeName - The GST Amount (highlighted in yellow) has exceeded the maximum value.Please edit or delete the record to proceed.\n'
                    $row.find(".GSTAmount").css("background-color", "yellow");
                }
                else {
                    $row.find(".GSTAmount").css("background-color", "white");
                }

            }

        });

        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="@(DataTableID)RemoveCheckbox"]:checked'), function (i, val) {
            var currLength = $('#tbl@(DataTableID) tr').length - 2;
            var row = $(this).closest("tr").get(0);
            if (currLength > 1) {
                _@(DataTableID)Table.fnDeleteRow(mytable.fnGetPosition(row));
            }
        });


        reorderTable('#tbl@(DataTableID)');
        @(DataTableID)_calculateGrandAmount();
        @*@(DataTableID)_CalculateSubtotal();*@
    }

    function @(DataTableID)_add5Row() {
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
    }

    function @(DataTableID)_addRow() {

        var _LocationDDLOption = $('.@(DataTableID)hiddenDDL').html();

        var _PersonDDLOption = $('.@(DataTableID)hiddenDDLPerson').html();
        var _StateDDLOption = $('.@(DataTableID)hiddenDDLState').html();
        var _HotelDDLOption = $('.@(DataTableID)hiddenDDLHotel').html();

        _@(DataTableID)Table.fnAddData([
            '<input type="checkbox" class="@(DataTableID)RemoveCheckbox" />',
            '<input type="hidden" class="hfChargeCode" /><select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn0" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();"><option value="">Select One</option></select>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text"  class="form-control SubTypeColumn1" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" value="" onchange="@(DataTableID)_CalculateAmount(this)"/><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control SubTypeColumn2" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" value="" onchange="@(DataTableID)_CalculateAmount(this)"/><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" class="form-control SubTypeColumn3" maxlength="200" />',
            '<select id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4"  name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" class = "bs-select form-control SubTypeColumn4" style="min-width:200px" onchange="@(DataTableID)_CalculateAmount(this)" >' + _LocationDDLOption + '</select>',
            '<input type="hidden" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" class="@(DataTableID)_hfReceipt" maxlength="200"  value="false"/><input type="checkbox" class="@(DataTableID)ReceiptCheckbox SubTypeColumn5" onchange="@(DataTableID)_ReceiptChange(this);" /><label>Yes<label/>',
            '<input type="text" style="min-width:200px"id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" class="form-control SubTypeColumn6" maxlength="200" />',
            '<select id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].NoOfPerson"  name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].NoOfPerson" class = "bs-select form-control NoOfPerson" style="min-width:200px">' + _PersonDDLOption + '</select>',
            '<select id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].HotelState"  name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].HotelState" class = "bs-select form-control HotelState" style="min-width:200px"  onchange="@(DataTableID)_PopulateHotel(this)">' + _StateDDLOption + '</select>',
