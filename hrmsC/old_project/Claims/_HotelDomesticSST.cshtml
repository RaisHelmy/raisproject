    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@Model.FormattedMinDate');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@Model.FormattedMaxDate');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(16)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _Nodays = $(this).children('td:eq(4)').children('input[type=text]');
            _Nodays.prop('readonly', true);

            var _HotelAmt = $(this).children('td:eq(12)').children('input[type=text]');
            _HotelAmt.prop('readonly', true);

            var _TotalHotel = $(this).children('td:eq(14)').children('input[type=text]');
            _TotalHotel.prop('readonly', true);

            var _TotalClaim = $(this).children('td:eq(15)').children('input[type=text]');
            _TotalClaim.prop('readonly', true);

            var _TotalAmt = $(this).children('td:eq(17)').children('input[type=text]');
            _TotalAmt.prop('readonly', true);

            @*var $select =$(this).find('.HotelName');
            var instance = $select.data('select2');

            if (instance) {
                $select.select2('destroy');
            } else {
                $select.select2();

                $select.on('change', function(){
                    @(DataTableID)_ShowHideOthers(this, $(this).val());
                });
            }*@
        });
        BindtoDDL();

        $("#tbl@(DataTableID) input[type=checkbox]").uniform();
        CalculateSummary();
    }

    function @(DataTableID)GetDDLInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _DDLSelect = $(this).children('td:eq(5)').children('select');
            var _DDLHidden = $(this).children('td:eq(5)').children('input[type=hidden]');
            if (_DDLHidden.val() != undefined) {
                _DDLSelect.val(_DDLHidden.val());
            }

            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());

            var _DDLNoOfPerson = $(this).children('td:eq(8)').children('select');
            var _HiddenNoOfPerson = $(this).children('td:eq(8)').children('input[type=hidden]');

            if (_HiddenNoOfPerson.val() != undefined) {
                _DDLNoOfPerson.val(_HiddenNoOfPerson.val());
            }

            var _DDLState = $(this).children('td:eq(9)').children('select');
            var _HiddenState = $(this).children('td:eq(9)').children('input[type=hidden]');
            if (_HiddenState.val() != undefined) {
                _DDLState.val(_HiddenState.val());
            }

            var _DDLHotel = $(this).children('td:eq(10)').children('select');
            var _HiddenHotel = $(this).children('td:eq(10)').children('input[type=hidden]');

            if (_HiddenHotel.val() != undefined) {
                _DDLHotel.val(_HiddenHotel.val());
            }

            if (_DDLHotel.val() == "- OTHERS -") {
                $(this).find(".SpanShowHideOtherHotelName").removeClass("hide");
            } else {
                $(this).find(".SpanShowHideOtherHotelName").addClass("hide");
            }



            var _StateName = $(this).find(".HotelState");
            var _HotelList = document.getElementById($(this).find(".HotelName").attr('id'));
            var _SpanShowHideOtherHotelName = document.getElementById($(this).find(".SpanShowHideOtherHotelName").attr('id'));
            //var _HiddenHotelName = $(this).children('td:eq(11)').children('input[type=hidden]');

            var _WithReceiptHidden = $(this).children('td:eq(6)').children('input[type=hidden]').val();
            var _HotelRate =  $(this).find('.SubTypeColumn7');
            var _ServiceCharge =  $(this).find('.SubTypeColumn9');


           if (_WithReceiptHidden == 'true') {
                $(this).children('td:eq(6)').find('.@(DataTableID)ReceiptCheckbox').prop('checked', true);

                _HotelRate.prop("readonly", false);
                _ServiceCharge.prop("readonly", false);

            }
            else {
                $(this).children('td:eq(6)').find('.@(DataTableID)ReceiptCheckbox').prop('checked', false);

                _HotelRate.prop("readonly", true);
                _ServiceCharge.prop("readonly", true);
            }


            if (_StateName.val() != "") {
                var _HotelSelect = $(this).find(".HotelName");

                var _DDLHotelList = document.getElementById($(this).children('td:eq(10)').children('select').attr('id'));

                @(DataTableID)_PopulateHotelList(_StateName.val(), _DDLHotelList, _HiddenHotel.val(), _SpanShowHideOtherHotelName, _HotelSelect, $(this));

            }
        });
    }


    function @(DataTableID)_PopulateHotel(x) {
        var $row = $(x).closest("tr");
        var _StateName = document.getElementById($row.find(".HotelState").attr('id'));
        var _HotelName = document.getElementById($row.find(".HotelName").attr('id'));
        var _SpanShowHideOtherHotelName = document.getElementById($row.find(".SpanShowHideOtherHotelName").attr('id'));
        var _DDLHotelList = document.getElementById($row.children('td:eq(10)').children('select').attr('id'));


        var $select =$(_DDLHotelList);
        var instance = $select.data('select2');

        if (instance) {
            $select.select2('destroy');
        }

        @(DataTableID)_PopulateHotelList(_StateName.value, _DDLHotelList, "", _SpanShowHideOtherHotelName, $row);


        $select.select2({
            dropdownAutoWidth: 'true',
            width: 'auto'
        });

        $select.select2('val', '');
        $select.on('change', function(){
            @(DataTableID)_ShowHideOthers(this, $(this).val());
        });

        $select.on("select2-close", function (e) {
            $(".select2-drop").addClass("select2-dropdown-none");
			//console.log("select2:close");
        });

						$select.on("select2-open", function (e) {
 
							//console.log($(".select2-drop").find(".select2-result").length);
							$( ".select2-drop" ).each(function() {
							 
							  if($( this ).find(".select2-result").length > 0){ 
									$( this ).removeClass("select2-dropdown-none");
								}
							});
							
						});


    }

    function @(DataTableID)_ShowHideOthers(x, type) {

        var $row = $(x).closest("tr");

        if (type == "- OTHERS -") {
            $row.find(".SpanShowHideOtherHotelName").removeClass("hide");
        } else {
            $row.find(".SpanShowHideOtherHotelName").addClass("hide");
        }



    }



    function @(DataTableID)_PopulateHotelList(StateName, HotelList, HotelName, SpanShowHideOtherHotelName, x) {
        if (StateName != "") {

            $.ajax({
                type: "GET",
                cache : false,
                url: '@Url.Action("GetHotelByState", "Claims")',
                data: {
                    stateName: StateName
                },
                datatype: "json",
                success: function (data) {

                    var found = 0;

                    if (HotelList != null) {

                        HotelList.options.length = 0;

                        for (var i = 0; i < data.length; i++) {
                            var option = document.createElement('option');

                            if (HotelName == data[i].Value) {
                                option.selected = true;
                                found = "1";

                            }

                            option.text = option.value = data[i].Value;
                            HotelList.add(option, i + 1);

                            if (i + 1 == data.length) {
                                option.text = option.value = "- OTHERS -";

                                if (HotelName == "- OTHERS -") {
                                    option.selected = true;
                                    found = "1";
                                }

                                HotelList.add(option, i + 2);
                            }
                        }

                        var option = document.createElement('option');
                        option.text = "- Select One -";
                        option.value = "";
                        HotelList.add(option, 0);

                        if (found == "0") {
                            HotelList.value = "";
                        }


        var $select =$(HotelList);
        var instance = $select.data('select2');

        if (instance) {
            $select.select2('destroy');
        }


        $select.select2({
            dropdownAutoWidth: 'true',
            width: 'auto'
        });

        $select.on('change', function(){
            @(DataTableID)_ShowHideOthers(this, $(this).val());
        });

        $select.on("select2-close", function (e) {

			$(".select2-drop").addClass("select2-dropdown-none");
			//console.log("select2:close");
        });

		$select.on("select2-open", function (e) {
  
			$( ".select2-drop" ).each(function() {
							 
                if ($(this).find(".select2-result").length > 0) {
                    $(this).removeClass("select2-dropdown-none");
                } 
			});
							
		});



        if (HotelName == "- OTHERS -") {
            $(SpanShowHideOtherHotelName).removeClass("hide");

        } else {
            $(SpanShowHideOtherHotelName).addClass("hide");
        }


                    }

                },
                error: function (e) {
                    alert(e);
                    console.log(e);
                }
            });
        }
    }

    $(document).ready(function () {
        @(DataTableID)_Initialize();
        @(DataTableID)GetDDLInputValues();
    });

    $("#tbl@(DataTableID) .GSTAmount").on("blur", function (e) {
        var myNumeric = parseFloat($(this).val().replace(/,/g, ''));
        if (!myNumeric) {
            $(this).val('0.00');
        }


        @*@(DataTableID)_CalculateSubtotal();*@
        @(DataTableID)_calculateGrandAmount();
    });



</script>