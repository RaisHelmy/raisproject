<!-- Scripts -->
<script type="text/javascript">
    //var _Path = '/_layouts/15/TNBESS';
    var _Path = '@string.Format("{0}://{1}{2}", Request.Url.Scheme, Request.Url.Authority, Url.Content("~"))';
    var Path = '/_layouts/15/TNBESS';

    function GetParameterByName(name) {
        name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
        var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
        results = regex.exec(location.search);
        return results === null ? "" : decodeURIComponent(results[1].replace(/\+/g, " "));
    }

    function FormValidation() {
        var _StartDate = document.getElementById('ct_StartDate');
        var _EndDate = document.getElementById('ct_EndDate');
        var _StartTime = document.getElementById('ct_StartTime');
        var _EndTime = document.getElementById('ct_EndTime');
        var _ModeOfTransport = document.getElementById('ct_Mode');
        var _ct_Remarks = document.getElementById('ct_Remarks');

        var _ValidationMsg = '';

        if (_StartDate.value == '')
            _ValidationMsg += '- Start Date field is required.\n';

        if (_EndDate.value == '')
            _ValidationMsg += '- End Date field is required.\n';

        if (_StartTime.value == '')
            _ValidationMsg += '- Start Time field is required.\n';

        if (_EndTime.value == '')
            _ValidationMsg += '- End Time field is required.\n';

        if (_ct_Remarks.value == '')
            _ValidationMsg += '- Purpose & Destination of Travel field is required.\n';

        if (_ModeOfTransport.value == '')
            _ValidationMsg += '- Mode of Transport field is required.\n';



        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            var _StartParts = _StartDate.value.split('/');
            var _Start = new Date(_StartParts[2], _StartParts[1] - 1, _StartParts[0]);
            var _EndParts = _EndDate.value.split('/');
            var _End = new Date(_EndParts[2], _EndParts[1] - 1, _EndParts[0]);

            if (_Start > _End) {
                _ValidationMsg += '- Start Date cannot be greater than End Date.';
            }

            if (_ValidationMsg != null && _ValidationMsg != '') {
                alert(_ValidationMsg);
            }
            else {
                ConfirmAction('Submit');
            }
        }
    }

    function Decline_CommentMandatory() {
        var _ApproverComment = document.getElementById('txtAppComment').value;

        if (_ApproverComment == '') {
            alert('- Comment is required.');
            return false;
        }
        else {
            ConfirmAction('Return');
        }
    }

    function SaveForm(x, _Status) {

        if (_Status == "ActualClaim")
            return true;

        x.disabled = true;

        if (_Status == 'Draft') {
            $(".Success-body .well").html('Your Others Form Application has been successfully saved.');
        }
        else if (_Status == 'ConvertToDraft') {
            $(".Success-body .well").html('Your Others Form Application has been successfully converted to draft.');
        }
        else {
            $(".Success-body .well").html('Your Others Form Application has been successfully submitted.');
        }

        var isResubmit = '0';

        if (document.getElementById('ct_Status').value == "Returned" ||
            (document.getElementById('ct_Status').value == "Draft" &&
            (document.getElementById('ct_ReferenceNo').value != "" &&
             document.getElementById('ct_ReferenceNo').value != "Draft" &&
             document.getElementById('ct_ReferenceNo').value != "[Draft]")
            )) {
            isResubmit = '1';
        }

        jQuery.support.cors = true;

        var form = {
            SourceID: GetParameterByName('ID'),
            EmployeeID: document.getElementById('hfEmployeeID').value,
            ReferenceNo: document.getElementById('ct_ReferenceNo').value,
            Status: _Status,
            StartDate: document.getElementById('ct_StartDate').value,
            EndDate: document.getElementById('ct_EndDate').value,
            StartTime: document.getElementById('ct_StartTime').value,
            EndTime: document.getElementById('ct_EndTime').value,
            ModeOfTransport: document.getElementById('ct_Mode').value,
            Remarks: document.getElementById('ct_Remarks').value,
            MileageLimit: document.getElementById('ct_MileageLimit').value,
            IsResubmit: isResubmit
        };

        $("#divLoading").show();

        $.ajax({
            url: '@Url.Content("~/Claims/UpdateOthersForm")',
            type: 'POST',
            cache: false,
            //async: false,
            dataType: "json",
            data: form,
            success: function (result) {
                if (result.Success) {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    $("#SuccessSubmit").modal();
                } else {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    alert(result.ErrorMsg);
                    //console.log(result.ErrorMsg);
                    x.disabled = false;
                }
            },
            error: function (x, y, z) {
                $("#ConfirmUpdate").modal('toggle');
                $("#divLoading").hide();
                console.log(x + '\n' + y + '\n' + z);
                x.disabled = false;
            }
        });
    }

    function DeleteForm(x) {
        x.disabled = true;

        var ItemID = GetParameterByName('ID');

        jQuery.support.cors = true;

        $(".Success-body .well").html('Your Others Form Application has been deleted successfully' + '(' + $('#ct_ReferenceNo').val() + ')' + '.');
        $("#divLoading").show();

        $.ajax({
            url: _Path + '/API/OutstationFormWebApi/GetDeleteOutstationForm?ID=' + ItemID,
            type: 'GET',
            contentType: "application/json;charset=utf-8",
            success: function (result) {
                if (result) {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    $("#SuccessSubmit").modal();
                }
                else {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    alert('Deletion has failed! Please reload and try again.');
                    x.disabled = false;
                }
            },
            error: function (x, y, z) {
                //console.log(x + '\n' + y + '\n' + z);
                console.log(x);
                console.log(y);
                console.log(z);
                x.disabled = false;
            }
        });
    }

    function GetButtonConfiguration(_ID) {
        var _CurrEmpID = document.getElementById('hfEmployeeID').value;

        jQuery.support.cors = true;

        $.ajax({
            url: _Path + '/API/OutstationFormWebApi/GetOutstationFormActions?ID=' + _ID + '&CurrEmpID=' + _CurrEmpID,
            type: 'GET',
            contentType: "application/json;charset=utf-8",
            success: function (result) {
                if (result != null) {
                    SetButtonConfiguration(result);
                }
                else
                    console.log('failed!');
            },
            error: function (x, y, z) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

    function SetButtonConfiguration(result) {
        var _Source = GetParameterByName('Source');

        var ButtonWithdraw = document.getElementById('btnWithdraw');
        var ButtonAgree = document.getElementById('btnAgree');
        var ButtonApprove = document.getElementById('btnApprove');
        var ButtonReturn = document.getElementById('btnReturn');

        if (result.CanWithdraw == '1' && _Source == 'History') {
            ButtonWithdraw.style.display = '';
        }
        else {
            ButtonWithdraw.style.display = 'none';
        }

        if (result.CanAgree == '1' && _Source == 'InTray') {
            document.getElementById('DivApproval').style.display = 'block';
            ButtonAgree.style.display = '';
        }
        else {
            document.getElementById('DivApproval').style.display = 'none';
            ButtonAgree.style.display = 'none';
        }

        if (result.CanApprove == '1' && _Source == 'InTray') {
            document.getElementById('DivApproval').style.display = 'block';
            ButtonApprove.style.display = '';
        }
        else {
            document.getElementById('DivApproval').style.display = 'none';
            ButtonApprove.style.display = 'none';
        }

        if (result.CanReturn == '1' && _Source == 'InTray') {
            document.getElementById('DivApproval').style.display = 'block';
            ButtonReturn.style.display = '';
        }
        else {
            document.getElementById('DivApproval').style.display = 'none';
            ButtonReturn.style.display = 'none';
        }
    }

    function ApproverAction(x, _Action) {
        x.disabled = true;

        var _ID = GetParameterByName('ID');
        var _TaskID = GetParameterByName('TaskID');
        var _CurrentUserID = document.getElementById('hfEmployeeID').value;
        var _ApproverComment = document.getElementById('txtAppComment').value;
        var _ActivityName = '';
        var _OptionalApprover = false;
        var isResubmit = '1';

        jQuery.support.cors = true;

        $("#divLoading").show();

        var form = {
            ID: _ID,
            CurrentUserID: _CurrentUserID,
            Status: _Action,
            ApproverComment: _ApproverComment,
            TaskID: _TaskID,
            ActivityName: _ActivityName,
            OptionalApprover: _OptionalApprover,
            StartDate: document.getElementById('ct_StartDate').value,
            EndDate: document.getElementById('ct_EndDate').value,
            StartTime: document.getElementById('ct_StartTime').value,
            EndTime: document.getElementById('ct_EndTime').value,
            ModeOfTransport: document.getElementById('ct_Mode').value,
            Remarks: document.getElementById('ct_Remarks').value,
            IsResubmit: isResubmit,
            MileageLimit: document.getElementById('ct_MileageLimit').value
        };


        $.ajax({
            url: '@Url.Content("~/Claims/PostApproverActionOthersForm")',
            type: 'POST',
            cache: false,
            //async: false,
            dataType: "json",
            data: form,
            success: function (result) {
                if (result) {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();

                    if (_Action == "Withdrawn") {
                        $(".Success-body .well").html('Your Others Form Application has been successfully Withdrawn' + ' (' + $('#ct_ReferenceNo').val() + ')' + '.');
                    }
                    else if (_Action == "Agreed") {
                        $(".Success-body .well").html('The Others Form has been successfully Agreed' + ' (' + $('#ct_ReferenceNo').val() + ')' + '.');
                    }
                    else if (_Action == "Approved") {
                        $(".Success-body .well").html('The Others Form has been successfully Approved' + ' (' + $('#ct_ReferenceNo').val() + ')' + '.');
                    }
                    else if (_Action == "Returned") {
                        $(".Success-body .well").html('The Others Form has been successfully Returned' + ' (' + $('#ct_ReferenceNo').val() + ')' + '.');
                    }

                    $("#SuccessSubmit").modal();
                }
                else {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    alert('Your action on this Others Form Application has failed. Please reload and try again.');
                    x.disabled = false;
                }
            },
            error: function (x, y, z) {
                $("#ConfirmUpdate").modal('toggle');
                $("#divLoading").hide();
                console.log(x + '\n' + y + '\n' + z);
                x.disabled = false;
            }
        });
    }

