@model Tuple<ESS.Core.OutstationFormDetails, List<SEP.RoutingManagement.Models.GetApprovalAuditLog>>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Others Form Details";
    //DateTime d1 = DateTime.Now.AddDays(-Convert.ToInt32(ViewBag.StartLeadTime));
    DateTime d1 = DateTime.Today.AddDays(-Convert.ToInt32(ViewBag.StartLeadTime));
    DateTime d2 = DateTime.Today.AddDays(Convert.ToInt32(ViewBag.EndLeadTime));
    string dtStrStart = d1.ToString("dd MM yyyy");
    string dtStrEnd = d2.ToString("dd MM yyyy");
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Others Form Application
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
@if (!@ViewBag.CanSubmit)
{
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    Sorry, You are not allowed to submit this application.
                    Immediate Manager not found, please contact administrator for assistance.
                </h4>
            </div>
        </div>
    </div>
}
<input id="hfEmployeeID" type="hidden" value="@ViewBag.EmployeeID" />
<input id="hfSource" type="hidden" value="@ViewBag.Source" />
<style type="text/css">
    .hidden_1 {
        display: none;
    }

    .checkbox-grid li {
        display: block;
        float: left;
        width: 50%;
    }
</style>
<div id="tab_1" class="tab-pane active">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Requestor Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee Number</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_EmployeeCode">@Model.Item1.EmployeeNumber</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Company</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Company">@Model.Item1.Company</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee Name</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_EmployeeName">@Model.Item1.EmployeeName</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Department</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Department">@Model.Item1.Department</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Position</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Position">@Model.Item1.Position</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Unit/Section</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_UnitSection">@Model.Item1.UnitSection</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Immediate Manager</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_ImmediateManager">@Model.Item1.ImmediateManager</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Current Approver</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_CurrentApprover">@ViewBag.CurrApp</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Traveling Particulars
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct01_CustomFieldFormView">
                        <input type="hidden" id="hfStatus" value="@Model.Item1.Status" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Reference No.</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="ct_ReferenceNo" value="@Model.Item1.ReferenceNo" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Status</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="ct_Status" value="@Model.Item1.Status" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Travel Start Date<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            @if ((@Model.Item1.Status == "Draft" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                (@Model.Item1.Status == "Returned" && ViewBag.IsCurrentEmployeeSubmitter == true) || (@Model.Item1.Status == "Withdrawn" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                 (!ViewBag.IsCurrentEmployeeSubmitter && (@Model.Item1.Status == "Pending" ||
                                                @Model.Item1.Status == "Agreed")))
                                            {
                                                if (@Model.Item1.StartDate.HasValue)
                                                {
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control" id="ct_StartDate" name="ct_StartDate" value="@Model.Item1.StartDate.Value.ToString("dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                                }
                                                else
                                                {
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control" id="ct_StartDate" name="ct_StartDate" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                                }
                                            }
                                            else
                                            {
                                            <input class="form-control" type="text" id="ct_StartDate" value="@Model.Item1.StartDate.Value.ToString("dd/MM/yyyy")" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Travel End Date<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            @if ((@Model.Item1.Status == "Draft" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                (@Model.Item1.Status == "Returned" && ViewBag.IsCurrentEmployeeSubmitter == true) || (@Model.Item1.Status == "Withdrawn" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                 (!ViewBag.IsCurrentEmployeeSubmitter && (@Model.Item1.Status == "Pending" ||
                                                @Model.Item1.Status == "Agreed")))
                                            {
                                                if (@Model.Item1.EndDate.HasValue)
                                                {
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control" id="ct_EndDate" name="ct_EndDate" value="@Model.Item1.EndDate.Value.ToString("dd/MM/yyyy")" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                                }
                                                else
                                                {
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control" id="ct_EndDate" name="ct_EndDate" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                                }
                                            }
                                            else
                                            {
                                            <input class="form-control" type="text" id="ct_EndDate" value="@Model.Item1.EndDate.Value.ToString("dd/MM/yyyy")" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Travel Start Time<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            @if ((@Model.Item1.Status == "Draft" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                (@Model.Item1.Status == "Returned" && ViewBag.IsCurrentEmployeeSubmitter == true) || (@Model.Item1.Status == "Withdrawn" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                 (!ViewBag.IsCurrentEmployeeSubmitter && (@Model.Item1.Status == "Pending" ||
                                                @Model.Item1.Status == "Agreed")))
                                            {
                                                if (@Model.Item1.StartDate.HasValue)
                                                {
                                                    <input type="text" class="form-control timeinput" id="ct_StartTime" name="ct_StartTime" placeholder="HH:MM (e.g 12:30)"
                                                           value="@Model.Item1.StartDate.Value.ToString("HH:mm")" />
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control timeinput" id="ct_StartTime" name="ct_StartTime" placeholder="HH:MM (e.g 12:30)" />
                                                }
                                            }
                                            else
                                            {
                                                <input class="form-control" type="text" id="ct_StartTime" value="@Model.Item1.StartDate.Value.ToString("HH:mm")" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Travel End Time<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            @if ((@Model.Item1.Status == "Draft" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                (@Model.Item1.Status == "Returned" && ViewBag.IsCurrentEmployeeSubmitter == true) || (@Model.Item1.Status == "Withdrawn" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                 (!ViewBag.IsCurrentEmployeeSubmitter && (@Model.Item1.Status == "Pending" ||
                                                @Model.Item1.Status == "Agreed")))
                                            {
                                                if (@Model.Item1.EndDate.HasValue)
                                                {
                                                    <input type="text" class="form-control timeinput" id="ct_EndTime" name="ct_EndTime" placeholder="HH:MM (e.g 12:30)"
                                                           value="@Model.Item1.EndDate.Value.ToString("HH:mm")" />
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control timeinput" id="ct_EndTime" name="ct_EndTime" placeholder="HH:MM (e.g 12:30)" />
                                                }
                                            }
                                            else
                                            {
                                                <input class="form-control" type="text" id="ct_EndTime" value="@Model.Item1.EndDate.Value.ToString("HH:mm")" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Purpose & Destination of Travel<span class="mandatory"> *</span></label>
                                        <div class="col-md-10 form-control-static">
                                            @if ((@Model.Item1.Status == "Draft" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                (@Model.Item1.Status == "Returned" && ViewBag.IsCurrentEmployeeSubmitter == true) || (@Model.Item1.Status == "Withdrawn" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                 (!ViewBag.IsCurrentEmployeeSubmitter && (@Model.Item1.Status == "Pending" ||
                                                @Model.Item1.Status == "Agreed")))
                                            {
                                                <textarea class="form-control" id="ct_Remarks" rows="6" style="width:100%;">@Model.Item1.Remarks</textarea>
                                            }
                                            else
                                            {
                                                <textarea class="form-control" id="ct_Remarks" rows="6" style="width:100%;" readonly>@Model.Item1.Remarks</textarea>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Mode of Transport<span class="mandatory"> *</span></label>
                                        <div class="col-md-10 form-control-static">
                                            <input type="hidden" id="hfMode" value="@Model.Item1.ModeOfTransport" />
                                            @if ((@Model.Item1.Status == "Draft" && ViewBag.IsCurrentEmployeeSubmitter == true) || (@Model.Item1.Status == "Withdrawn" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                (@Model.Item1.Status == "Returned" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                 (!ViewBag.IsCurrentEmployeeSubmitter && (@Model.Item1.Status == "Pending" ||
                                                @Model.Item1.Status == "Agreed")))
                                            {
                                                <ul class="checkbox-grid" id="ModeOfTransport" style="padding:0;"></ul>
                                                <input type="hidden" id="ct_Mode" name="ct_Mode" value="@Model.Item1.ModeOfTransport" />
                                            }
                                            else
                                            {
                                                string ModeOfTransport = @Model.Item1.ModeOfTransport.Replace(",", "\n");
                                                
                                                <textarea class="form-control" id="ct_Mode" rows="6" style="width:100%;" readonly>@ModeOfTransport</textarea>
                                                @*<input class="form-control" type="text" id="ct_Mode" value="@Model.Item1.ModeOfTransport" readonly />*@
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Claimable Mileage Limit (KM)</label>
                                        <div class="col-md-4 form-control-static">
                                           @if ((@Model.Item1.Status == "Draft" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                (@Model.Item1.Status == "Returned" && ViewBag.IsCurrentEmployeeSubmitter == true) || (@Model.Item1.Status == "Withdrawn" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
                                                 (!ViewBag.IsCurrentEmployeeSubmitter && (@Model.Item1.Status == "Pending" ||
                                                @Model.Item1.Status == "Agreed")))
                                            {
                                                <input type="number" min="0" id="ct_MileageLimit" name="ct_MileageLimit" class="form-control" value="@Model.Item1.MileageLimit" />
                                            }
                                            else
                                            {
                                                <input id="ct_MileageLimit" name="ct_MileageLimit" class="form-control" value="@Model.Item1.MileageLimit" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if ((@Model.Item1.Status == "Draft" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
    (@Model.Item1.Status == "Returned" && ViewBag.IsCurrentEmployeeSubmitter == true) || (@Model.Item1.Status == "Withdrawn" && ViewBag.IsCurrentEmployeeSubmitter == true) ||
    (!ViewBag.IsCurrentEmployeeSubmitter && (@Model.Item1.Status == "Pending" ||
    @Model.Item1.Status == "Agreed")))
    {
        @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "Add", SourceType = "OthersForm", RequestID = ViewBag.ApplicationID })
    }
    else
    {
        @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "View", SourceType = "OthersForm", RequestID = ViewBag.ApplicationID })
    }
    @if (@Model.Item1.Status != "Draft")
    {
        <div class="row" id="DivAuditLog">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Audit Log
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="form-horizontal">
                                <div class="table-toolbar">
                                    <table id="tblAuditLog" class="table table-striped table-bordered table-hover table-full-width">
                                        <thead>
                                            <tr>
                                                <th style="width:15%;">Action By</th>
                                                <th style="width:15%;">Date</th>
                                                <th style="width:15%;">Activity</th>
                                                <th style="width:15%;">Action</th>
                                                <th style="width:40%;">Comment</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (@Model.Item2 != null && @Model.Item2.Count > 0)
                                            {
                                                foreach (var item in @Model.Item2)
                                                {
                                                    <tr>
                                                        <td>@item.EmployeeName</td>
                                                        <td>@item.FormattedDate</td>
                                                        <td>@item.ActivityName</td>
                                                        <td>@item.ActivityAction</td>
                                                        <td>@item.Comment</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="row" id="DivApproval" style="display:none;">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Approval Comments
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Comments</label>
                                        <div class="col-md-10 form-control-static">
                                            <textarea class="form-control" id="txtAppComment" rows="5" cols="60"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        @if ((@Model.Item1.Status == "Draft" || Model.Item1.Status == "Withdrawn") && ViewBag.IsCurrentEmployeeSubmitter == true)
        {
            <input type="button" class="btn green" value="Save As Draft" id="btnSave" onclick="ConfirmAction('SaveAsDraft');" />
        }
        @if ((@Model.Item1.Status == "Draft" || @Model.Item1.Status == "Returned" || Model.Item1.Status == "Withdrawn") && ViewBag.IsCurrentEmployeeSubmitter == true)
        {
            if (!@ViewBag.CanSubmit)
            {
                <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="FormValidation();" disabled />
            }
            else
            {
                <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="FormValidation();" />
            }
        }
        @if (((@Model.Item1.Status == "Draft" && Model.Item1.ReferenceNo.Contains("Draft")) || (Model.Item1.Status == "Withdrawn")) && ViewBag.IsCurrentEmployeeSubmitter == true)
        {
            <input type="button" class="btn green" value="Delete" id="btnDelete" onclick="ConfirmAction('Delete');" />
        }
        @if ((Model.Item1.Status == "Approved") && ViewBag.AllowConvertToDraft == true)
        {            
            <input type="button" class="btn green" value="Convert to draft" id="btnConvertToDraft" onclick="ConfirmAction('ConvertToDraft');" />
        }
        @if ((Model.Item1.Status == "Approved") && !string.IsNullOrEmpty(ViewBag.ActualClaimRequestID))
        {
            <input type="button" class="btn green" value="View Actual Claim" id="btnViewActualClaim" onclick="RedirectTo('ViewActualClaim')" />
        }
        @if (Model.Item1.Status == "Approved" && ViewBag.IsCurrentEmployeeSubmitter == true && d1 <= Model.Item1.EndDate && ViewBag.AllowConvertToDraft == true)
        {
            <input type="button" class="btn green" value="Proceed to Actual Claim" id="btnActualClaim" onclick="ConfirmAction('ActualClaim');" />
        }
        <input type="button" class="btn green" value="Withdraw" id="btnWithdraw" onclick="ConfirmAction('Withdraw');" style="display:none;" />
        <input type="button" class="btn green" value="Agree" id="btnAgree" onclick="ConfirmAction('Agree');" style="display:none;" />
        <input type="button" class="btn green" value="Approve" id="btnApprove" onclick="ConfirmAction('Approve');" style="display:none;" />
        <input type="button" class="btn green" value="Return" id="btnReturn" onclick="Decline_CommentMandatory();" style="display:none;" />
        <input type="button" class="btn green" value="Back" id="btnBack" onclick="window.history.back()" />
    </div>
</div>
<!-- Success Message -->
<div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well">
                    Your Others Form Application has been successfully submitted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <button type="submit" class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Confirmation Message -->
<div class="modal fade" id="ConfirmUpdate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Confirmation</h4>
            </div>
            <div class="modal-body">
                <div class="well">
