            autoclose: true,
            minuteStep: 5,
            showSeconds: false,
            showMeridian: false,
            defaultTime: 0000
        });

        $('.timeinput').inputmask("mask", {
            "mask": "99:99"
        });

        //$("#ct_Mode").val($('#hfMode').val());

        GetButtonConfiguration(GetParameterByName('ID'));

        var _Status = document.getElementById('hfStatus').value;
        if (_Status == 'Draft' || _Status == 'Returned' || _Status == 'Pending' || _Status == 'Agreed' || _Status == 'Withdrawn') {
            GetModeOfTransport();
        }
    });
