    function RedirectTo(_Action) {
        switch (_Action) {
            case "Agree":
            case "Approve":
            case "Return":
                window.location.href = '@Url.Content("~/MSS/OthersFormInTray")';
                break;
            case "Draft":
            case "Submit":
            case "Delete":
            case "Withdraw":
                window.location.href = '@Url.Content("~/Claims/OthersFormHistory")';
                break;
            case "ConvertToDraft":
                window.location.href = '@Url.Content("~/Claims/OthersFormHistory")';
                break;
            case "ActualClaim":                
                window.location.href = '@Html.Raw(Url.Content("~/Claims/ClaimsApplication?Type=COH01&OthersID=" + ViewBag.ApplicationID + "&OthersRef=" + Model.Item1.ReferenceNo))';
                break;
            case "ViewActualClaim":
                window.location.href = '@Html.Raw(Url.Content("~/Claims/Index?ID=" + ViewBag.ActualClaimRequestID))';
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }

    function GetModeOfTransport() {
        var Url = '@Url.Content("~/Claims/GetOthersFormModeOfTransport")';

        var ddlTarget = '#ModeOfTransport';

        $.ajaxSetup({ cache: false });
        $.getJSON(Url, function (data) {
            $(ddlTarget).empty();
            $.each(data, function (index, optionData) {
                $(ddlTarget).append("<li><input type='checkbox' value='" + optionData.Value + "' onchange='MultiSelect_OnChange();'> " + optionData.Text + "</li>");
            });

            SetModeOfTransportSelectedValue();
        });
    }

    function SetModeOfTransportSelectedValue() {
        var _ModeOfTransport = document.getElementById('hfMode').value;
        var _Modes = _ModeOfTransport.split(',')

        _Modes.forEach(function (x) {
            $('#ModeOfTransport input').each(function () {
                if ($(this).attr('value') == x) {
                    $(this).prop("checked", true);
                }
            });
        })
    }

    function MultiSelect_OnChange() {
        var _Mode = $('#ct_Mode');
        _Mode.val('');

        $('#ModeOfTransport input:checked').each(function () {
            if (_Mode.val() == '') {
                _Mode.val($(this).attr('value'));
            }
            else {
                var _temp = _Mode.val();
                _temp += ',' + $(this).attr('value');
                _Mode.val('');
                _Mode.val(_temp);
            }
        });
    }

