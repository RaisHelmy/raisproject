@model ESS.Claim.ViewModels.FlexiBenefitsVM
@{
    ViewBag.Title = "Test";
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Summary
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        <th scope="col" width="50%">Component</th>
                                        <th scope="col" width="25%">Amount (RM)</th>
                                        <th scope="col" width="25%">Approved Amount (RM)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @{
                                        int SubtypeIndex = 0;
                                        double TotalAmount = 0.00;
                                        double TotalApproveAmount = 0.00;
                                        double LPAmount = 0.00;
                                        double LPApproveAmount = 0.00;
                                        double OtherAmount = 0.00;
                                        double OtherApproveAmount = 0.00;
                                    }

                                    @foreach (var subtype in Model.ClaimSubtype)
                                    {
                                        if (subtype.IsChoosen)
                                        {
                                            var SumName = "dTable" + subtype.FormInterface + "Sum";
                                            var ApproveSumName = "dTable" + subtype.FormInterface + "ApproveSum";
                                            var LPSumName = "dTable" + subtype.FormInterface + "LPSum";
                                            var LPApproveSumName = "dTable" + subtype.FormInterface + "LPApproveSum";
                                            
                                            if (subtype.FormInterface == "_FBLeavePassage")
                                            {
                                                if (Model.LeavePassage != null)
                                                {
                                                    <tr>
                                                        <td>@subtype.ClaimsSubtypeName</td>
                                                        @{
                                                                double TransportAmt = 0.00;
                                                                double AccomAmt = 0.00;
                                                                double MiscAmt = 0.00;
                                                                double TransportApproveAmt = 0.00;
                                                                double AccomApproveAmt = 0.00;
                                                                double MiscApproveAmt = 0.00;

                                                                foreach (var item in Model.LeavePassage)
                                                                {
                                                                    if (item.Transportation != null)
                                                                    {
                                                                        TransportAmt = TransportAmt + item.Transportation.Sum(x => (String.IsNullOrEmpty(x.Amount) ? 0.00 : Convert.ToDouble(x.Amount)));
                                                                        TransportApproveAmt = TransportApproveAmt + item.Transportation.Sum(x =>(String.IsNullOrEmpty(x.ApprovedAmount) ? 0.00 : Convert.ToDouble(x.ApprovedAmount)));
                                                                    }
                                                                    if (item.Accommodation != null)
                                                                    {
                                                                        AccomAmt = AccomAmt + item.Accommodation.Sum(x => (String.IsNullOrEmpty(x.Amount) ? 0.00 : Convert.ToDouble(x.Amount)));
                                                                        AccomApproveAmt = AccomApproveAmt + item.Accommodation.Sum(x => (String.IsNullOrEmpty(x.ApprovedAmount) ? 0.00 :Convert.ToDouble(x.ApprovedAmount)));
                                                                    }
                                                                    if (item.Miscellaneous != null)
                                                                    {
                                                                        MiscAmt = MiscAmt + item.Miscellaneous.Sum(x => (String.IsNullOrEmpty(x.Amount) ? 0.00 : Convert.ToDouble(x.Amount)));
                                                                        MiscApproveAmt = MiscApproveAmt + item.Miscellaneous.Sum(x => (String.IsNullOrEmpty(x.ApprovedAmount) ? 0.00 :Convert.ToDouble(x.ApprovedAmount)));
                                                                    }
                                                                }

                                                                LPAmount = TransportAmt + AccomAmt + MiscAmt;
                                                                LPApproveAmount = TransportApproveAmt + AccomApproveAmt + MiscApproveAmt;
                                                        }

                                                        <td class="text-right"><span id="@LPSumName">@String.Format("{0:0.00}", LPAmount)</span></td>
                                                        <td class="text-right"><span id="@LPApproveSumName">@String.Format("{0:0.00}", LPApproveAmount)</span></td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td>@subtype.ClaimsSubtypeName</td>
                                                        <td class="text-right"> <span id="@LPSumName">0.00</span></td>
                                                        <td class="text-right"> <span id="@LPApproveSumName">0.00</span></td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                
                                                if (subtype.SubTypeDetails != null)
                                                {
                                                    OtherAmount = OtherAmount + subtype.SubTypeDetails.Sum(x => (String.IsNullOrEmpty(x.Amount) ? 0.00 : Convert.ToDouble(x.Amount)));
                                                        OtherApproveAmount = OtherApproveAmount + subtype.SubTypeDetails.Sum(x => (String.IsNullOrEmpty(x.ApprovedAmount) ? 0.00 : Convert.ToDouble(x.ApprovedAmount)));
                                                    
                                                    <tr>

                                                        <td>@subtype.ClaimsSubtypeName</td>
                                                        <td class="text-right"> <span id="@SumName">@String.Format("{0:0.00}", subtype.SubTypeDetails.Sum(x => (String.IsNullOrEmpty(x.Amount) ? 0.00 : Convert.ToDouble(x.Amount))))</span></td>
                                                        <td class="text-right"><span id="@ApproveSumName">@String.Format("{0:0.00}", subtype.SubTypeDetails.Sum(x => (String.IsNullOrEmpty(x.ApprovedAmount) ? 0.00 : Convert.ToDouble(x.ApprovedAmount))))</span></td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    <tr>

                                                        <td>@subtype.ClaimsSubtypeName</td>
                                                        <td class="text-right"><span id="@SumName">0.00</span></td>
                                                        <td class="text-right"><span id="@ApproveSumName">0.00</span></td>
                                                    </tr>
                                                }
                                            }
                                            SubtypeIndex++;
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="text-right"> Total</td>
                                        <td class="text-right">
                                            <span id="TotalSummary"> @String.Format("{0:0.00}", (LPAmount + OtherAmount))</span>
                                            <input id="TotalSummaryInput" value="@String.Format("{0:0.00}", (LPAmount + OtherAmount))" type="hidden" name="TotalAmount" />
                                        </td>
                                        <td class="text-right">
                                            <span id="TotalAppSummary"> @String.Format("{0:0.00}", (LPApproveAmount + OtherApproveAmount))</span>
                                            <input id="TotalAppSummaryInput" value="@String.Format("{0:0.00}", (LPApproveAmount + OtherApproveAmount))" type="hidden" name="TotalApproved" />
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

