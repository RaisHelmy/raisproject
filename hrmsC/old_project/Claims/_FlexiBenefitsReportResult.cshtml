@model List<ESS.Claim.ViewModels.FlexiBenefitsReport>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My Flexi Benefits Report
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Year</th>
                                <th>Components</th>
                                <th>Amount (RM)</th>
                                <th>Approved Amount (RM)</th>
                                <th>Status</th>
                                <th>Created Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>

                                        <td>
                                            <a class="btn blue btn-sm" onclick="window.open('@Url.Content("~/Claims/FlexiBenefitsViewForm")?RequestID=@item.ID&Source=Report')">
                                                <i class="fa fa-search"></i>
                                            </a>
                                        </td>

                                    <td>@item.RequestNo</td>
                                    <td>@item.EmployeeCode - @item.EmployeeName  </td>
                                    <td>@item.Year</td>
                                    <td>@item.Components</td>
                                    <td>@item.TotalAmount</td>
                                    <td>@item.ApprovedAmount</td>
                                    @if (@item.ClaimStatusName == "Returned" || @item.ClaimStatusName == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.ClaimStatusName</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.ClaimStatusName</b></td>
                                    }

                                    @if (@item.CreatedDate.HasValue)
                                    {
                                        <td>@item.CreatedDate.Value.ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>