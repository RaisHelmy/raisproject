@model ESS.AdvanceClaim.Models.AdvanceClaim
<style>
    .center {
        text-align:center;
    }
</style>

<div class="portlet box blue subtypeportlet" id="dTable_Bus">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Request Details
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Reference No.</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.DisplayFor(x => x.RequestNo)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Claim Status</label>
                                <div class="col-md-8 form-control-static">
                                    @*@Html.DisplayFor(x => x.Status)*@
                                    @ESS.AdvanceClaim.Service.GetStatus(Model.Status)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Category</label>
                            <div class="col-md-8 form-control-static">
                                @Html.DisplayFor(x => x.RequestType)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Current Approver</label>
                            <div class="col-md-8 form-control-static">
                                @Html.DisplayFor(x => x.ApproverName)
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            </div>
    </div>
</div>

