            '<div class="input-group date date-picker @(DataTableID)" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text"  class="form-control SubTypeColumn1" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" value="" onchange="@(DataTableID)Calculation(this)"/><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<div class="input-group date date-picker @(DataTableID)" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control SubTypeColumn2" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" value="" onchange="@(DataTableID)Calculation(this)"/><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control SubTypeColumn11" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn11" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn11" value="" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" class="form-control SubTypeColumn3" maxlength="200" />',
            '<select id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4"  name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" class = "bs-select form-control SubTypeColumn4" style="min-width:200px" onchange="@(DataTableID)Calculation(this)" >' + _LocationDDLOption + '</select>',
            '<input type="hidden"  value="true" class="@(DataTableID)_hfReceipt" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" /><input type="checkbox" checked="checked" class="@(DataTableID)ReceiptCheckbox SubTypeColumn5" onchange="@(DataTableID)_ReceiptChange(this);" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" /> Yes',
            '<input type="text" style="min-width:200px"id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" class="form-control SubTypeColumn6" maxlength="200" />',
            '<input type="text" style="min-width:130px" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" class="form-control text-right SubTypeColumn7" maxlength="10" onblur="@(DataTableID)Calculation(this)"/>',
            '<input type="text" style="min-width:130px" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" class="form-control text-right SubTypeColumn8" maxlength="10" />',
            '<input type="text" style="min-width:130px" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn9" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn9" class="form-control text-right SubTypeColumn9" maxlength="10" onblur="@(DataTableID)Calculation(this)" />',
            '<input type="text" style="min-width:130px" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn10" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn10" class="form-control text-right SubTypeColumn10" maxlength="10" />',
            '<input type="text" style="min-width:130px" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Amount" value="" class="form-control text-right Amount" maxlength="10"/>',
            '<input type="text" style="min-width:130px" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].GSTAmount" value="" class="form-control text-right GSTAmount" maxlength="10" onblur="@(DataTableID)_CalculateSumGST(this);"/>',
            '<input type="text" style="min-width:130px" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].TotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].TotalAmount" value="" class="form-control text-right TotalAmount" readonly />'
        ]);

        @(DataTableID)_Initialize();
    }

    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .@(DataTableID)').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .@(DataTableID)').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(14)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _Nodays = $(this).children('td:eq(5)').children('input[type=text]');
            _Nodays.prop('readonly', true);

            var _HotelAmt = $(this).children('td:eq(10)').children('input[type=text]');
            _HotelAmt.prop('readonly', true);

            var _TotalHotel = $(this).children('td:eq(12)').children('input[type=text]');
            _TotalHotel.prop('readonly', true);

            var _TotalClaim = $(this).children('td:eq(13)').children('input[type=text]');
            _TotalClaim.prop('readonly', true);

            var _TotalAmt = $(this).children('td:eq(15)').children('input[type=text]');
            _TotalAmt.prop('readonly', true);
        });


        $(".@(DataTableID)RemoveCheckbox").uniform();
        $(".@(DataTableID)ReceiptCheckbox").uniform();
        BindtoDDL();
        CalculateSummary();
    }

    function @(DataTableID)GetDDLInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _DDLSelect = $(this).children('td:eq(6)').children('select');
            var _DDLHidden = $(this).children('td:eq(6)').children('input[type=hidden]');
            _DDLSelect.val(_DDLHidden.val());

            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());

            var _WithReceiptHidden = $(this).children('td:eq(7)').children('input[type=hidden]').val();
            var _HotelRate = $(this).children('td:eq(9)').children('input[type=text]');
            var _TaxAmount = $(this).children('td:eq(11)').children('input[type=text]');
            var _WithReceipt = $(this).find('.SubTypeColumn5');

            if (_WithReceiptHidden == 'true') {
                $(this).children('td:eq(7)').find('input[type=checkbox]').prop('checked', true);
                _WithReceipt.prop('checked', true);
                _HotelRate.prop('readonly', false);
                _TaxAmount.prop('readonly', false);
            }
            else {
                $(this).children('td:eq(7)').find('input[type=checkbox]').prop('checked', true);
                _WithReceipt.prop('checked', false);
                _HotelRate.prop('readonly', true);
                _TaxAmount.prop('readonly', true);
            }

            $(this).children('td:eq(7)').find('input[type=checkbox]').uniform();
        });
    }

    function @(DataTableID)_ReceiptChange(x) {
        var $row = $(x).closest("tr");

        var _Receipts = $row.find(".SubTypeColumn5").is(':checked');

        if (_Receipts) {
            $row.find(".@(DataTableID)_hfReceipt").val('true');
        }
        else {
            $row.find(".@(DataTableID)_hfReceipt").val('false');
        }

        @(DataTableID)Calculation(x);
    }

    function @(DataTableID)Calculation(x) {
        var $row = $(x).closest("tr");
        var _StartDate = document.getElementById($row.find(".SubTypeColumn1").attr('id'));
        var _EndDate = document.getElementById($row.find(".SubTypeColumn2").attr('id'));
        var _NoDays = document.getElementById($row.find(".SubTypeColumn3").attr('id'));
        var _StayType = document.getElementById($row.find(".SubTypeColumn4").attr('id'));

        var _WithReceipts = document.getElementById($row.find(".SubTypeColumn5").attr('id'));
        var _HotelRate = document.getElementById($row.find(".SubTypeColumn7").attr('id'));
        var _HotelAmount = document.getElementById($row.find(".SubTypeColumn8").attr('id'));
        var _TaxAmount = document.getElementById($row.find(".SubTypeColumn9").attr('id'));
        var _TotalHotel = document.getElementById($row.find(".SubTypeColumn10").attr('id'));
        var _TotalClaim = document.getElementById($row.find(".Amount").attr('id'));
        var _GSTAmount = document.getElementById($row.find(".GSTAmount").attr('id'));
        var _TotalAmount = document.getElementById($row.find(".TotalAmount").attr('id'));

        if (_StartDate.value != "" && _EndDate.value != "") {
            var from = toDate(_StartDate.value);
            var to = toDate(_EndDate.value);

            if (to < from) {
                _EndDate.value = _StartDate.value;
            }

            from = toDate(_StartDate.value);
            to = toDate(_EndDate.value);
            var timeDiff = Math.abs(to.getTime() - from.getTime());
            var days = Math.ceil(timeDiff / (1000 * 3600 * 24));

            if (days != "0") {
                _NoDays.value = days;
            }
            else {
                _NoDays.value = "1";
            }
        }

        _HotelRate.value = @(DataTableID)_FormatNumber(_HotelRate.value);
        _TaxAmount.value = @(DataTableID)_FormatNumber(_TaxAmount.value);

        if (_StartDate.value != "" && _EndDate.value != "" && _StayType.value != "" && _HotelRate.value != "" && _TaxAmount.value != "") {
            var MaxClaim = 0;
            var Rate = 0;
            var receipt = _WithReceipts.checked;

            if (receipt) {
                _HotelRate.readOnly = false;
                _TaxAmount.readOnly = false;

                if (_StayType.value == "Full Day") {

                    MaxClaim = '@MaxClaimFullYesReceipt';
                    Rate = '@HotelRateFullYesReceipt';
                }
                if (_StayType.value == "Half Day") {
                    MaxClaim = '@MaxClaimHalfYesReceipt';
                    Rate = '@HotelRateHalfYesReceipt';
                }

                var HotelAmount = 0;
                if (Rate == '0') {
                    HotelAmount = parseFloat(_NoDays.value) * parseFloat(_HotelRate.value);
                    _HotelAmount.value = HotelAmount.toFixed(2);
                }
                else if (Rate > MaxClaim) {
                    HotelAmount = parseFloat(_NoDays.value) * parseFloat(MaxClaim);
                    _HotelAmount.value = HotelAmount.toFixed(2);
                }
                else {
                    HotelAmount = parseFloat(_NoDays.value) * parseFloat(_HotelRate.value);
                    _HotelAmount.value = HotelAmount.toFixed(2);
                }

                var totalHotel = 0;
                totalHotel = parseFloat(HotelAmount) + parseFloat(_TaxAmount.value);
                _TotalHotel.value = totalHotel.toFixed(2);

                var TotalClaim = 0;
                if (MaxClaim == '0') {
                    TotalClaim = HotelAmount + parseFloat(_TaxAmount.value);
                }
                else if (parseFloat(_HotelRate.value) > parseFloat(MaxClaim)) {
                    TotalClaim = parseFloat(MaxClaim) * parseFloat(_NoDays.value) + parseFloat(_TaxAmount.value);
                }
                else {
                    TotalClaim = HotelAmount + parseFloat(_TaxAmount.value);
                }

                _TotalClaim.value = TotalClaim.toFixed(2);

                var gstAmt = 0;
                if ('@GSTEnabled' != 'false') {
                    var gstMaxValue = '@GSTMaximumValue';
                    gstAmt = parseFloat(TotalClaim) * (parseFloat(gstMaxValue) / 100);
                }
                _GSTAmount.value = gstAmt.toFixed(2);

                var TotalAmount = 0;
                TotalAmount = parseFloat(TotalClaim) + (parseFloat(gstAmt));
                _TotalAmount.value = TotalAmount.toFixed(2);

            }
            else {

                _HotelRate.readOnly = true;
                _TaxAmount.readOnly = true;
                _HotelRate.value = true;
                _TaxAmount.value = true;

                if (_StayType.value == "Full Day") {

                    MaxClaim = '@MaxClaimFullNoReceipt';
                    Rate = '@HotelRateFullNoReceipt';
                }
                if (_StayType.value == "Half Day") {
                    MaxClaim = '@MaxClaimHalfNoReceipt';
                    Rate = '@HotelRateHalfNoReceipt';
                }

                MaxClaim = MaxClaim * 1;
                _HotelRate.value = MaxClaim.toFixed(2);
                _TaxAmount.value = '0.00';

                var HotelAmount = 0;
                HotelAmount = parseFloat(_NoDays.value) * parseFloat(MaxClaim);
                _HotelAmount.value = HotelAmount.toFixed(2);

                var totalHotel = 0;
                totalHotel = parseFloat(HotelAmount)
                _TotalHotel.value = totalHotel.toFixed(2);

                var TotalClaim = 0;
                TotalClaim = HotelAmount
                _TotalClaim.value = TotalClaim.toFixed(2);

                var gstAmt = 0;
                if ('@GSTEnabled' != 'false') {
                    var gstMaxValue = '@GSTMaximumValue';
                    gstAmt = parseFloat(TotalClaim) * (parseFloat(gstMaxValue) / 100);
                }
                _GSTAmount.value = gstAmt.toFixed(2);

                var TotalAmount = 0;
                TotalAmount = parseFloat(TotalClaim) + (parseFloat(gstAmt));
                _TotalAmount.value = TotalAmount.toFixed(2);

            }
        }

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaximumValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".TotalAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandTotal + (_TotalAmount * 1);
            }
        });
        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaximumValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_FormatNumber(x) {
        var number = "";
        var myNumeric = parseFloat(x.replace(/,/g, ''));
        if (!myNumeric) {
            number = "0.00";
        }
        else {
            number = myNumeric.toFixed(2);
        }

        return number;
    }

    $(document).ready(function () {
        @(DataTableID)_Initialize();
        @(DataTableID)GetDDLInputValues();
    });


</script>