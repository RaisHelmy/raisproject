@model  TNB_ESS_MVC.Controllers.ClaimsController.DropDownListModel
@{
    
    Layout = null;
}

@if (Model.Categories.Count() != 0)
{
<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png"></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Advance Claim
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4 ">
                        Advance Claim Request No :
                    </label>
                    <div class="col-md-6 form-control-static">
                        @*@Html.DropDownList("AdvanceClaimID", new SelectList(Model, "Value", "Text"), "- All -", new { @class = "bs-select form-control" })*@
                        @Html.DropDownListFor(
                            x => x.AdvanceClaimID,
                            Model.Categories,
                            "",
                            new { @class = "bs-select form-control" }
                        )
                    </div>
                    <div class="col-md-2">
                        <a class="btn green" href="javascript:AdvClaimInsert();">Update</a>
                    </div>
                </div>
              
            </div>
            
           

        </div>
    </div>
</div>
    <script>
        function AdvClaimInsert()
        {

            $('form').submit();
        }
    </script>
}

