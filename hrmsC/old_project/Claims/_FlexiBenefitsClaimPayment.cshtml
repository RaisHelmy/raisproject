@model ESS.Claim.ViewModels.FlexiBenefitsVM
@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Payment
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        First Payment 
                                    </label>
                                    <div class="col-md-5 form-control-static">
                                        @Html.TextBoxFor(m => m.FirstPayment, new { @id = "FirstPayment", @class = "form-control payment text-right", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">First Payment Processing Start Date</label>
                                    <div class="col-md-5 form-control-static">
                                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                            <input type="text" class="form-control payment" id="FirstPaymentDate" 
                                                    name="FirstPaymentDate" readonly
                                                    value="@(String.IsNullOrEmpty(Model.FirstPaymentDate) ? DateTime.Today.ToString("dd/MM/yyyy") : Model.FirstPaymentDate)"  />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
@if (Model.Status.ToUpper() == "APPROVED" || Model.Status.ToUpper() == "PROCESSED" || Model.Status.ToUpper() == "PAID" || Model.Status.ToUpper() == "PROCESSEDWITHOUTPAYMENT" || Model.Status.ToUpper() == "PENDINGADMIN" || Model.Status.ToUpper() == "PAID (PARTIAL)" || Model.Status.ToUpper() == "RETURNED (PARTIAL)")
{
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            First Processed Amount
                                        </label>
                                        <div class="col-md-5 form-control-static">
                                            @Html.TextBoxFor(m => m.ProcessedAmount, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            First Payment Amount
                                        </label>
                                        <div class="col-md-5 form-control-static">                                           
                                            @Html.TextBoxFor(m => m.PaymentAmount, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            First Payment Release Date
                                        </label>
                                        <div class="col-md-5 form-control-static">
                                            @Html.TextBoxFor(m => m.PaymentDate, new { @class = "form-control", @readonly = "readonly" })                                     
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            First Payment Method
                                        </label>
                                        <div class="col-md-5 form-control-static">
                                            @Html.TextBoxFor(m => m.PaymentMethod, new { @class = "form-control", @readonly = "readonly" })                                       
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
}
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Second Payment 
                                    </label>
                                    <div class="col-md-5 form-control-static">
                                        @Html.TextBoxFor(m => m.SecondPayment, new { @id = "SecondPayment", @class = "form-control payment text-right", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Second Payment Processing Start Date</label>
                                    <div class="col-md-5 form-control-static">
                                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                            <input type="text" class="form-control payment" id="SecondPaymentDate" name="SecondPaymentDate" value="@Model.SecondPaymentDate" readonly />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

@if (Model.Status.ToUpper() == "APPROVED" || Model.Status.ToUpper() == "PROCESSED" || Model.Status.ToUpper() == "PAID" || Model.Status.ToUpper() == "PROCESSEDWITHOUTPAYMENT" || Model.Status.ToUpper() == "PENDINGADMIN" || Model.Status.ToUpper() == "PAID (PARTIAL)" || Model.Status.ToUpper() == "RETURNED (PARTIAL)")
{
    <div class="row">
        <div class="col-md-12">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">
                        Second Processed Amount
                    </label>
                    <div class="col-md-5 form-control-static">
                        @Html.TextBoxFor(m => m.ProcessedAmount2, new { @class = "form-control", @readonly = "readonly" })
                        
                     
                    </div>
                </div>
            </div>
        </div>
    </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Second Payment Amount
                                        </label>
                                        <div class="col-md-5 form-control-static">
                                            @Html.TextBoxFor(m => m.PaymentAmount2, new { @class = "form-control", @readonly = "readonly" })
                                    
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Second Payment Release Date
                                        </label>
                                        <div class="col-md-5 form-control-static">
                                            @Html.TextBoxFor(m => m.PaymentDate2, new { @class = "form-control", @readonly = "readonly" })
                                       
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Second Payment Method
                                        </label>
                                        <div class="col-md-5 form-control-static">
                                            @Html.TextBoxFor(m => m.PaymentMethod2, new { @class = "form-control", @readonly = "readonly" })
                                          
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
}

                </div>
            </div>
        </div>
    </div>
</div>