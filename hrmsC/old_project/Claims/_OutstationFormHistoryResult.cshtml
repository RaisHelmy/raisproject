@model List<ESS.Core.OutstationFormDetails>

@{
    Layout = null;

    DateTime dLeadTimeToProceedActualClaim = DateTime.Today.AddDays(-Convert.ToInt32(ViewBag.LeadTimeToActualClaim));
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Outstation Form History
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Travel Start Date</th>
                                <th>Travel End Date</th>
                                <th>Mode of Transport</th>
                                <th>Submission Date</th>
                                <th>Status</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Claims/OutstationFormDetails")?ID=@item.ID&Source=History">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.ReferenceNo</td>
                                    @if (@item.StartDate.HasValue)
                                    {
                                        <td>@item.StartDate.Value.ToString("dd-MM-yyyy HH:mm")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (@item.EndDate.HasValue)
                                    {
                                        <td>@item.EndDate.Value.ToString("dd-MM-yyyy HH:mm")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (@item.Status == "Returned" || @item.Status == "Withdrawn" || @item.Status == "Cancelled" || @item.Status == "Draft")
                                    {
                                        <td>@item.ModeOfTransport</td>
                                    }
                                    else
                                    {
                                        <td>@TNB_ESS_MVC.Helpers.GeneralHelper.OutstationFormModeOfTransportDisplay(@item.ModeOfTransport)</td>
                                    }

                                    @if (@item.SubmissionDate.HasValue)
                                    {
                                        <td>@item.SubmissionDate.Value.ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    @if (@item.Status == "Returned" || @item.Status == "Withdrawn" || @item.Status == "Cancelled")
                                    {
                                        <td style="color:red;"><b>@item.Status</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.Status</b></td>
                                    }

                                    @if (item.Status == "Approved" || item.Status == "Pending")
                                    {
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.AdvanceClaimID))
                                            {
                                                <a href="@Html.Raw(Url.Content("~/Claims/ViewAdvanceClaims?ID=" + item.AdvanceClaimID + "&Source=History"))">
                                                    <label style="color:green; cursor: pointer; display: block;"><b>View Advance Claim</b></label>
                                                </a>
                                            }
                                            else
                                            {
                                                if (DateTime.Now <= @item.EndDate)
                                                {
                                                    <a href="@Html.Raw(Url.Content("~/Claims/AdvanceClaimsApplication?OutstationID=" + item.ID))">
                                                        <label style="color: blue; cursor: pointer; display: block;"><b>Request Advance Claim</b></label>
                                                    </a>

                                                }
                                            }

                                            @if (item.Status == "Approved")
                                            {
                                                if (!string.IsNullOrEmpty(@item.ActualClaimID))
                                                {
                                                    <a href="@Html.Raw(Url.Content("~/Claims/Index?ID=" + @item.ActualClaimID))">
                                                        <label style="color: green; cursor: pointer; display: block;"><b>View Actual Claim</b></label>
                                                    </a>
                                                }
                                                else if (@item.Status == "Approved" && dLeadTimeToProceedActualClaim <= @item.EndDate)
                                                {
                                                    <a href="@Html.Raw(Url.Content("~/Claims/ClaimsApplication?Type=COS01&OutstationID=" + @item.ID + "&OutstationRef=" + @item.ReferenceNo + "&DuplicateAttachment=true"))">
                                                        <label style="color: blue; cursor: pointer; display: block;"><b>Proceed Actual Claim</b></label>
                                                    </a>
                                                }
                                            }
                                        </td>
                                    }
                                    else
                                    {
                                        <td> - </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>