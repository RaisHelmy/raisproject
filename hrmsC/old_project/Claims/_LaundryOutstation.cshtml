@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.LaundryOutstation_ClaimsSubtypeName;
    string GSTEnabled = (@ViewBag.LaundryOutstation_GSTEnabled + "").ToLower();
    string Status = @ViewBag.LaundryOutstation_Status;
    string dtStrStart = @ViewBag.LaundryOutstation_StartDate;
    string dtStrEnd = @ViewBag.LaundryOutstation_EndDate;
    string noOfDays = ViewBag.LaundryOutstation_noOfDays;
    string GSTMaximumValue = ViewBag.LaundryOutstation_GSTMaximumValue;

}

<div class="portlet box blue subtypeportlet" id="dTable_LaundryOutstation">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimsSubtypeName
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tblLaundryOutstation">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col" width="20%">No.of Days</th>
                                <th scope="col" width="20%">Receipt Date *</th>
                                <th scope="col" width="30%">Description</th>
                                <th scope="col" width="15%">Amount (RM) *</th>
                                <th scope="col" width="15%">GST Amount (RM)</th>
                                <th scope="col" width="15%">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="LaundryOutstationRemoveCheckbox" /></td>
                                        <td><input type="text" class="form-control SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" /></td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control SubTypeColumn2" id="Date" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" /></td>
                                        <td><input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" onkeypress="NumberOnly(event);" onkeyup="LaundryOutstation_CalculateSum();" /></td>
                                        <td><input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" id="txtGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" id="txtTotalAmount" readonly /></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="LaundryOutstationRemoveCheckbox" /></td>
                                            <td>
                                                <input type="text" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1" />
                                            </td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                    <input type="text" class="form-control SubTypeColumn2" id="Date" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn2" value="@thisDetail.SubTypeColumn2" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="text" class="form-control SubTypeColumn3" value="@thisDetail.SubTypeColumn3"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn3" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control Amount" value="@thisDetail.Amount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" onkeypress="NumberOnly(event);" onkeyup="LaundryOutstation_CalculateSum();" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount" id="txtGSTAmount" readonly />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" id="txtTotalAmount" readonly />
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                    <tr>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn2" value="@thisDetail.SubTypeColumn2" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn2" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Amount" value="@thisDetail.Amount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" />
                                        </td>
                                    </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="BtnPlus btn green" title="dTable_LaundryOutstation" href="javascript:LaundryOutstation_addRow();">
                                    Add Row
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="BtnPlus5 btn green" title="dTable_LaundryOutstation" href="javascript:LaundryOutstation_add5Row();">
                                    Add 5 Rows
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="deleteall btn red" title="dTable_LaundryOutstation" href="javascript:LaundryOutstation_removeRow();">
                                    Delete Row
                                    <i class="fa fa-minus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var _LaundryOutstationTable = $('#tblLaundryOutstation').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_LaundryOutstationValidation() { // LaundryOutstationValidation
        var _ValidationMsg = '';

        var thisTable = $('#tblBusOverseas');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _Date = $row.find(".SubTypeColumn2").val();

            if (_Amount == null || _Amount == '0' || _Amount == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is required.\n'
            }

            if (_Date == null || _Date == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Date) is required.\n'
            }

        });

        return _ValidationMsg;
    }

    function LaundryOutstation_removeRow() {
        $.each($('input[class="LaundryOutstationRemoveCheckbox"]:checked'), function (i, val) {
            var row = $(this).closest("tr").get(0);
            var id = $(this).attr("id");
            _LaundryOutstationTable.fnDeleteRow(mytable.fnGetPosition(row));
        });

        reorderTable('#tblLaundryOutstation');
    }

    function LaundryOutstation_add5Row() {
        LaundryOutstation_addRow();
        LaundryOutstation_addRow();
        LaundryOutstation_addRow();
        LaundryOutstation_addRow();
        LaundryOutstation_addRow();
    }

    function LaundryOutstation_addRow() {
        _LaundryOutstationTable.fnAddData([
            '<input type="checkbox" class="LaundryRemoveCheckbox" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LaundryOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" class="form-control SubTypeColumn1" maxlength="200" />',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy"><input type="text" class="form-control SubTypeColumn2" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LaundryOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" value="" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LaundryOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" class="form-control SubTypeColumn3" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LaundryOutstationTable.fnSettings().fnRecordsTotal() + '].Amount" value="" class="form-control text-right Amount" onkeypress="NumberOnly(event);" onkeyup="LaundryOutstation_CalculateSum();" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LaundryOutstationTable.fnSettings().fnRecordsTotal() + '].GSTAmount" value="" class="form-control text-right GSTAmount" readonly />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LaundryOutstationTable.fnSettings().fnRecordsTotal() + '].TotalAmount" value="" class="form-control text-right SubTotalAmount" readonly />'
        ]);

        LaundryOutstation_Initialize();
    }

    function LaundryOutstation_Initialize() {
        $('#tblLaundryOutstation .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tblLaundryOutstation .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tblLaundryOutstation .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tblLaundryOutstation tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(5)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $('#tblLaundryOutstation tbody tr').each(function () {
            var _noOfDays = $(this).children('td:eq(1)').children('input[type=text]');

            _noOfDays.prop('readonly', true);
            _noOfDays.val('@noOfDays');
        });
    }

    function LaundryOutstation_CalculateSum() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tblLaundryOutstation');

        //iterate through each textboxes and add the values
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".Amount").val();
            var noofDay = $row.find(".SubTypeColumn1").val();
            var gstAmt = 0;
            var gstMaxValue = 0;
            var Subtotalamount = 0;
            if ('@GSTEnabled' != 'false') {
                gstMaxValue = '@GSTMaximumValue';
                gstAmt = (amount) * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }

            Subtotalamount = parseFloat(amount) + parseFloat(gstAmt.toFixed(2));
            $row.find(".SubTotalAmount").val(Subtotalamount.toFixed(2));

            //add only if the value is number
            if (!isNaN(amount) && amount.length != 0) {
                grandAmount = (grandAmount + (amount * 1));
                grandGST = (grandGST + (gstAmt * 1));
                grandTotal = grandTotal + (grandAmount + grandGST);
            }

        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
    }


    $(document).ready(function () {
        LaundryOutstation_Initialize();
    });
</script>