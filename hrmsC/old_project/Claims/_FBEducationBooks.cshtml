@model ESS.Claim.ViewModels.FlexiBenefitsSubtype
@using TNB_ESS_MVC.Helpers
@{
    ViewBag.Title = "EducationBooks";
    Layout = null;
}

<div class="portlet box blue subtypeportlet" id="dTable_FBEducationBooks">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i> Education Books
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <table class="table table-striped table-bordered table-hover SubtypeTable" id="FBEducationBooks">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        <th scope="col">Date *</th>
                        <th scope="col">Staff/Dependant *</th>
                        <th scope="col">Type *</th>
                        <th scope="col">Shop Name *</th>
                        <th scope="col">Receipt No. *</th>
                        <th scope="col">Description</th>
                        <th scope="col">Amount (RM) *</th>
                        <th scope="col">Approved Amount (RM) *</th>
                        <th scope="col">Approval Remarks</th>
                    </tr>
                </thead>

                @if (Model.SubTypeDetails == null)
                {
                    <tbody>
                        <input type="hidden" value="@Model.SubtypeID" name="ClaimSubtype[@Model.subtypeIndex].SubTypeID" />
                        <tr id="new_line_details_0" class="new_line">
                            <td><input type="checkbox" class="subtypeCheckbox" /></td>
                            <td>
                                <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                    <input type="text" style="min-width:200px" class="form-control StartDate" id="StartDate" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].StartDate" />
                                    <span class="input-group-btn">
                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <select class="form-control SelfDependant" style="min-width:200px" id="SelfDependant" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SelfDependant">
                                    <option value="Self">Self</option>
                                    <option value="Dependant">Dependant</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-control Type" style="min-width:200px" id="Type" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Type">
                                    <option value="Work-Related">Work-Related</option>
                                    <option value="Non Work-Related">Non Work-Related</option>
                                </select>
                            </td>
                            <td><input type="text" style="min-width:200px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].ShopName" class="form-control ShopName" maxlength="200" /></td>
                            <td><input type="text" style="min-width:200px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].ReceiptNo" class="form-control ReceiptNo" maxlength="200" /></td>
                            <td><input type="text" style="min-width:300px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Description" class="form-control Description" maxlength="200" /></td>
                            <td><input type="text" style="min-width:100px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" class="form-control text-right Amount" value="0.00" maxlength="10" onblur=" calculateSum('dTable_FBEducationBooks');"></td>
                            <td><input type="text" style="min-width:100px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].ApprovedAmount" class="form-control text-right ApprovedAmount" value="0.00" maxlength="10" readonly></td>
                            <td><input type="text" style="min-width:300px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].ApprovalRemarks" class="form-control ApprovalRemarks" maxlength="200" readonly /></td>
                        </tr>

                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-right"><label class="control-label text-right"> Total</label></td>
                            <td><input type="text" class="form-control text-right GrandAmount" value="0.00" readonly /></td>
                            <td><input type="text" class="form-control text-right GrandApprovedAmount" value="0.00" readonly /></td>
                            <td></td>
                        </tr>

                    </tfoot>
                }
                else
                {
                    int count = 0;
                    <input type="hidden" value="@Model.SubtypeID" name="ClaimSubtype[@Model.subtypeIndex].SubTypeID" />
                    <tbody>
                        @foreach (var item in Model.SubTypeDetails)
                        {
                            string TRid = "new_line_details_" + count;
                            <tr id="@TRid" class="new_line">
                                <td><input type="checkbox" class="subtypeCheckbox" /></td>
                                <td>
                                    <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                        <input type="text" style="min-width:200px" class="form-control StartDate" id="StartDate" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].StartDate" value="@item.StartDate" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @{
                            string SelfDependantName = "ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].SelfDependant";
                                    }

                                    @Html.DropDownListFor(m => m.SubTypeDetails[count].SelfDependant, new List<SelectListItem>
                                            {
                                                new SelectListItem { Text = "Self", Value = "Self",Selected=GeneralHelper.IsSelectedDDLValue("Self",item.SelfDependant)},
                                                new SelectListItem { Text = "Dependant", Value = "Dependant",Selected=GeneralHelper.IsSelectedDDLValue("Dependant",item.SelfDependant)},
                                            }, new { @Name = SelfDependantName, @class = "bs-select form-control SelfDependant", @style = "min-width:200px" })

                                </td>
                                <td>
                                    @{
                            string TypeName = "ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].Type";
                                    }

                                    @Html.DropDownListFor(m => m.SubTypeDetails[count].Type, new List<SelectListItem>
                                            {
                                                new SelectListItem { Text = "Work-Related", Value = "Work-Related",Selected=GeneralHelper.IsSelectedDDLValue("Work-Related",item.Type)},
                                                new SelectListItem { Text = "Non Work-Related", Value = "Non Work-Related",Selected=GeneralHelper.IsSelectedDDLValue("Non Work-Related",item.Type)},
                                            }, new { @Name = TypeName, @class = "bs-select form-control Type", @style = "min-width:200px" })

                                </td>

                                <td><input type="text" style="min-width:200px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].ShopName" class="form-control ShopName" maxlength="200" value="@item.ShopName" /></td>
                                <td><input type="text" style="min-width:200px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].ReceiptNo" class="form-control ReceiptNo" maxlength="200" value="@item.ReceiptNo" /></td>
                                <td><input type="text" style="min-width:300px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Description" class="form-control Description" maxlength="200" value="@item.Description" /></td>
                                <td><input type="text" style="min-width:100px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" class="form-control text-right Amount" maxlength="10" value="@item.Amount"  onblur=" calculateSum('dTable_FBEducationBooks');" onpaste=" return false"></td>
                                <td><input type="text" style="min-width:100px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].ApprovedAmount" class="form-control text-right ApprovedAmount" maxlength="10" value="@item.ApprovedAmount" readonly  onblur="calculateApproveSum('dTable_FBEducationBooks');"></td>
                                <td><input type="text" style="min-width:300px" name="ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].ApprovalRemarks" class="form-control ApprovalRemarks" maxlength="200" value="@item.ApprovalRemarks" readonly /></td>
                            </tr>
                            count++;
                        }

                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-right"><label class="control-label text-right"> Total</label></td>
                            <td><input type="text" class="form-control text-right GrandAmount" readonly value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" /></td>
                            <td><input type="text" class="form-control text-right GrandApprovedAmount" readonly value="@String.Format("{0:0.00}",Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.ApprovedAmount) ? 0.00 : Convert.ToDouble(m.ApprovedAmount))))" /></td>
                            <td></td>
                        </tr>

                    </tfoot>
                }
            </table>



            <div class="form-horizontal">
                <div class="table-toolbar">

                    <div class="row subtypeBtn">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="BtnPlus btn green" href="javascript:addRow('dTable_FBEducationBooks',@Model.subtypeIndex);">
                                    Add Row
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>

                            <div class="btn-group">
                                <a class="BtnPlus5 btn green" href="javascript:add5Row('dTable_FBEducationBooks',@Model.subtypeIndex);">
                                    Add 5 Rows
                                    <i class="fa fa-plus"></i>
                                </a>

                            </div>
                            <div class="btn-group">
                                <a class="deleteall btn red" href="javascript:DeleteRow('dTable_FBEducationBooks');">
                                    Delete Row
                                    <i class="fa fa-minus"></i>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<script>

    function dTable_FBEducationBooksValidation() {
        var ValidationMsg = '';
        var thisTable = $('#dTable_FBEducationBooks');

        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".Amount").val();
            var date = $row.find(".StartDate").val();
            var ReceiptNo = $row.find(".ReceiptNo").val();
            var ShopName = $row.find(".ShopName").val();
            if (amount == null || amount == '0.00' || amount == '') {
                ValidationMsg += '- Amount (Education Books) is required.\n'
            }

            if (date == null || date == '') {
                ValidationMsg += '- Date (Education Books) is required.\n'
            }

            if (ReceiptNo == null || ReceiptNo == '') {
                ValidationMsg += '- Receipt No (Education Books) is required.\n'
            }

            if (ShopName == null || ShopName == '') {
                ValidationMsg += '- Shop Name (Education Books) is required.\n'
            }

        });

        if (ValidationMsg != null && ValidationMsg != '') {
            return ValidationMsg;
        }
        else {
            return '';
        }
    }
    function dTable_FBEducationBooksApprovalValidation() {
        var ValidationMsg = '';
        var thisTable = $('#dTable_FBEducationBooks');

        thisTable.find(".ApprovedAmount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".ApprovedAmount").val();

            if (amount == null || amount == '0' || amount == '') {
                ValidationMsg += '- Approved Amount (Education Books) is required.\n'
            }
        });

        if (ValidationMsg != null && ValidationMsg != '') {
            return ValidationMsg;
        }
        else {
            return '';
        }
    }
</script>
