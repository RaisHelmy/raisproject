@model ESS.Claim.ViewModels.FlexiBenefitsLeavePassageDetails
@using TNB_ESS_MVC.Helpers
@{
    ViewBag.Title = "Leave Passage";
    Layout = null;
    int Index = Model.Index;
    string IDName = "divDest" + Model.Index;
    string TransportID = IDName + "_FBTransport";
    string AccommodationID = IDName + "_FBAccommodation";
    string MiscellaneousID = IDName + "_FBMiscellaneousID";
    string divID = "CurrIndex" + Index;
    string SubmmiterName = (string)ViewData["SubmitterName"];

}
<div class="row destination" id="@IDName">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i> <span id="DestinationName">Destination @(Index + 1)</span>
                    <input type="hidden" name="LeavePassage[@Index].Index" value="@Model.Index" />
                    <input type="hidden" name="LeavePassage[@Index].ID" value="@Model.ID" />
                    <input type="hidden" name="LeavePassage[@Index].TransportDetailID" value="@Model.TransportDetailID" />
                    <input type="hidden" name="LeavePassage[@Index].AccomDetailID" value="@Model.AccomDetailID" />
                    <input type="hidden" name="LeavePassage[@Index].MiscDetailID" value="@Model.MiscDetailID" />
                    <div id="@divID" class="hidden">
                        
                    </div>
                </div>
                <div class="tools">
                    @if (Index != 0)
                    { 
                        <input type="button" class="btn btn-xs red pull-right subtypeBtn" id="btnRemoveDest" onclick="RemoveDestination(@Index)" value="Remove Destination" />
                        <input type="submit" class="hidden" id="btnHiddenRemove" value="Remove Destination" name="SubmitType"/>
                    }
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-md-4 control-label">Type</label>
                                    <div class="col-md-8 form-control-static">
                                        @{
                                            string TypeName = "LeavePassage[" + Index + "].Type";
                                        }
                                        @Html.DropDownListFor(m => m.Type, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "Domestic", Value = "Domestic"},
                                            new SelectListItem { Text = "Oversea", Value = "Oversea"},
                                        }, new { @Name = TypeName, @class = "bs-select form-control", @id="Type"})
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-md-4 control-label">Destination</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="Destination" name="LeavePassage[@Index].Destination" value="@Model.Destination" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-md-4 control-label">Start Date</label>
                                    <div class="col-md-8 form-control-static">
                                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                            @{
                                                string LPStartDate = "LPStartDate_" +Index;
                                            }
                                            <input type="text" class="form-control" id="@LPStartDate" name="LeavePassage[@Index].StartDate" value="@Model.StartDate" onchange="LPStartDateOnchange(this,'@Index')" />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-md-4 control-label">End Date</label>
                                    <div class="col-md-8 form-control-static">
                                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                            @{
                                                string LPEndDate = "LPEndDate_" + Index;
                                            }
                                            <input type="text" class="form-control" id="@LPEndDate" name="LeavePassage[@Index].EndDate" value="@Model.EndDate" onchange="LPEndDateOnchange(this,'@Index')" />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Transportation -->
                    <div class="row">
                        <br />
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="portlet box blue subsubType" >
                                    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                                    <div class="portlet-title">
                                        <div class="caption">
                                            <i class="fa fa-reorder"></i> Transportation
                                        </div>
                                        <div class="tools">
                                        </div>
                                    </div>
                                    <div class="portlet-body form">
                                        <div class="form-body">
                                            <table class="table table-striped table-bordered table-hover table-full-width SubtypeTable" id="@TransportID">
                                                <thead>
                                                    <tr>
                                                        <th scope="col"></th>
                                                        <th scope="col">Date *</th>
                                                        <th scope="col" width="20%">Type *</th>
                                                        <th scope="col" width="20%">Staff/Dependant *</th>
                                                        <th scope="col" width="20%">Name *</th>
                                                        <th scope="col">From *</th>
                                                        <th scope="col">To *</th>
                                                        <th scope="col">Description</th>
                                                        <th scope="col">Amount (RM) *</th>
                                                        <th scope="col">Approved Amount (RM) *</th>
                                                        <th scope="col">Approval Remarks</th>
                                                    </tr>
                                                </thead>

                                                @if (Model.Transportation == null)
                                                {
                                                    <tbody>
                                                        <tr id="new_line_details_0" class="new_line">
                                                            <td><input type="checkbox" class="subtypeCheckbox" /></td>
                                                            <td>
                                                                <div class="input-group date date-picker LPDate_@Index" data-date-format="dd MM yyyy">
                                                                    <input type="text" style="min-width:200px" class="form-control StartDate" id="LeavePassageTransportationStartDate" name="LeavePassage[@Index].Transportation[0].StartDate" />
                                                                    <span class="input-group-btn">
                                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <select class="bs-select form-control Type" style="min-width:200px" name="LeavePassage[@Index].Transportation[0].Type">
                                                                    <option value="Flight">Flight</option>
                                                                    <option value="Taxi">Taxi</option>
                                                                    <option value="Car Rental">Car Rental</option>
                                                                    <option value="Train">Train</option>
                                                                    <option value="Bus">Bus</option>
                                                                    <option value="Others">Others</option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <select class="bs-select form-control SelfDependant" style="min-width:200px" name="LeavePassage[@Index].Transportation[0].SelfDependant" onchange="PostBack();">
                                                                    <option value="Self">Self</option>
                                                                    <option value="Dependant">Dependant</option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="text" style="min-width:200px" name="LeavePassage[@Index].Transportation[0].Name" class="form-control Name" maxlength="200" value="@SubmmiterName" readonly/>
                                                            </td>
                                                            <td><input type="text" style="min-width:200px" name="LeavePassage[@Index].Transportation[0].From" class="form-control From" maxlength="200" /></td>
                                                            <td><input type="text" style="min-width:200px" name="LeavePassage[@Index].Transportation[0].To" class="form-control To" maxlength="200" /></td>
                                                            <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Transportation[0].Description" class="form-control Description" maxlength="200" /></td>
                                                            <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Transportation[0].Amount" class="form-control text-right Amount" value="0.00" maxlength="10"  onblur="calculateLPSum('@TransportID');"></td>
                                                            <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Transportation[0].ApprovedAmount" class="form-control text-right ApprovedAmount" value="0.00" maxlength="10" readonly></td>
                                                            <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Transportation[0].ApprovalRemarks" class="form-control ApprovalRemarks" maxlength="200" readonly /></td>
                                                        </tr>

                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="8" class="text-right"><label class="control-label text-right"> Total</label></td>
                                                            <td><input type="text" class="form-control text-right GrandAmount" value="0.00" readonly /></td>
                                                            <td><input type="text" class="form-control text-right GrandApprovedAmount" value="0.00" readonly /></td>
                                                            <td></td>
                                                        </tr>

                                                    </tfoot>
                                                }
                                                else
                                                {
                                                    int TransportationCount = 0;
                                                    <tbody>
                                                        @foreach (var item in Model.Transportation)
                                                        {
                                                            <tr id="new_line_details_@TransportationCount" class="new_line">
                                                                <td><input type="checkbox" class="subtypeCheckbox" /></td>
                                                                <td>
                                                                    <div class="input-group date date-picker LPDate_@Index" data-date-format="dd MM yyyy">
                                                                        <input type="text" style="min-width:200px" class="form-control StartDate" id="LeavePassageTransportationStartDate" name="LeavePassage[@Index].Transportation[@TransportationCount].StartDate" value="@item.StartDate" />
                                                                        <span class="input-group-btn">
                                                                            <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                        </span>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    @{
                                                            string TransportType = "LeavePassage[" + Index + "].Transportation[" + TransportationCount + "].Type";
                                                                    }
                                                                    @Html.DropDownListFor(m => item.Type, new List<SelectListItem>
                                                                    {
                                                                        new SelectListItem { Text = "Flight", Value = "Flight" ,Selected=GeneralHelper.IsSelectedDDLValue("Flight",item.Type)},
                                                                        new SelectListItem { Text = "Taxi", Value = "Taxi",Selected=GeneralHelper.IsSelectedDDLValue("Taxi",item.Type)},
                                                                        new SelectListItem { Text = "Car Rental", Value = "Car Rental",Selected=GeneralHelper.IsSelectedDDLValue("Car Rental",item.Type)},
                                                                        new SelectListItem { Text = "Train", Value = "Train",Selected=GeneralHelper.IsSelectedDDLValue("Train",item.Type)},
                                                                        new SelectListItem { Text = "Bus", Value = "Bus",Selected=GeneralHelper.IsSelectedDDLValue("Bus",item.Type)},
                                                                        new SelectListItem { Text = "Others", Value = "Others",Selected=GeneralHelper.IsSelectedDDLValue("Others",item.Type)},
                                                                    }, new { @Name = TransportType, @class = "bs-select form-control Type", @style = "min-width:200px" })

                                                                </td>
                                                                <td>
                                                                    @{
                                                            string TransportSDName = "LeavePassage[" + Index + "].Transportation[" + TransportationCount + "].SelfDependant";
                                                            string dName = "LeavePassage[" + Index + "].Transportation[" + TransportationCount + "].Name";
                                                                    }
                                                                    @Html.DropDownListFor(m => item.SelfDependant, new List<SelectListItem>
                                                                    {
                                                                        new SelectListItem { Text = "Self", Value = "Self",Selected=GeneralHelper.IsSelectedDDLValue("Self",item.SelfDependant)},
                                                                        new SelectListItem { Text = "Dependant", Value = "Dependant",Selected=GeneralHelper.IsSelectedDDLValue("Dependant",item.SelfDependant)},
                                                                    }, new { @Name = TransportSDName, @class = "bs-select form-control SelfDependant", @onchange = "PostBack();", @style = "min-width:200px" })


                                                                </td>
                                                                <td>
                                                                    @if (item.SelfDependant == "Self")
                                                                    {
                                                                        <input type="text" style="min-width:200px" name="@dName" class="form-control Name" maxlength="200" value="@SubmmiterName" isddl="false" readonly />
                                                                    }
                                                                    else
                                                                    {

                                                                        SelectList dependantList = (SelectList)ViewData["Dependant"];
                                                                        List<SelectListItem> dependantList2 = new List<SelectListItem>();

                                                                        foreach (var ddlObject in dependantList)
                                                                        {
                                                                            SelectListItem selectItem = new SelectListItem();
                                                                            selectItem.Text = ddlObject.Text;
                                                                            selectItem.Value = ddlObject.Value;
                                                                            selectItem.Selected = GeneralHelper.IsSelectedDDLValue(ddlObject.Text, item.Name);
                                                                            dependantList2.Add(selectItem);
                                                                        }


                                                                        @Html.DropDownList(dName, (IEnumerable<SelectListItem>)dependantList2, new { @Name = dName, @class = "bs-select form-control Name", @isddl = "true", @style = "min-width:200px" })
                                                                    }
                                                                </td>
                                                                <td><input type="text" style="min-width:200px" name="LeavePassage[@Index].Transportation[@TransportationCount].From" class="form-control From" maxlength="200" value="@item.From" /></td>
                                                                <td><input type="text" style="min-width:200px" name="LeavePassage[@Index].Transportation[@TransportationCount].To" class="form-control To" maxlength="200" value="@item.To" /></td>
                                                                <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Transportation[@TransportationCount].Description" class="form-control Description" maxlength="200" value="@item.Description" /></td>
                                                                <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Transportation[@TransportationCount].Amount" class="form-control text-right Amount" maxlength="10" value="@item.Amount"  onblur="calculateLPSum('@TransportID');"></td>
                                                                <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Transportation[@TransportationCount].ApprovedAmount" class="form-control text-right ApprovedAmount" maxlength="10" value="@item.ApprovedAmount" readonly onblur="calculateLPApproveSum('@TransportID');"></td>
                                                                <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Transportation[@TransportationCount].ApprovalRemarks" class="form-control ApprovalRemarks" maxlength="200" value="@item.ApprovalRemarks" readonly /></td>
                                                            </tr>

                                                                    TransportationCount++;
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="8" class="text-right"><label class="control-label text-right"> Total</label></td>
                                                            <td><input type="text" class="form-control text-right GrandAmount" readonly value="@String.Format("{0:0.00}",Model.Transportation.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" /></td>
                                                            <td><input type="text" class="form-control text-right GrandApprovedAmount" readonly value="@String.Format("{0:0.00}",Model.Transportation.Sum(m => (String.IsNullOrEmpty(m.ApprovedAmount) ? 0.00 : Convert.ToDouble(m.ApprovedAmount))))" /></td>
                                                            <td></td>
                                                        </tr>

                                                    </tfoot>

                                                }

                                            </table>

                                            <div class="form-horizontal">
                                                <div class="table-toolbar">

                                                    <div class="row subtypeBtn">
                                                        <div class="col-md-12">

                                                            <div class="btn-group">
                                                                <a class="BtnPlus btn green" href="javascript:addLPRow('@TransportID','@Index','Transportation');">
                                                                    Add Row
                                                                    <i class="fa fa-plus"></i>
                                                                </a>
                                                            </div>

                                                            <div class="btn-group">
                                                                <a class="BtnPlus5 btn green" href="javascript:addLP5Row('@TransportID','@Index','Transportation');">
                                                                    Add 5 Rows
                                                                    <i class="fa fa-plus"></i>
                                                                </a>

                                                            </div>
                                                            <div class="btn-group">
                                                                <a class="deleteall btn red" href="javascript:DeleteLPRow('@TransportID');">
                                                                    Delete Row
                                                                    <i class="fa fa-minus"></i>
                                                                </a>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Accommodation -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="portlet box blue subsubType" >
                                    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                                    <div class="portlet-title">
                                        <div class="caption">
                                            <i class="fa fa-reorder"></i> Accommodation
                                        </div>
                                        <div class="tools">
                                        </div>
                                    </div>
                                    <div class="portlet-body form">
                                        <div class="form-body">
                                            <table class="table table-striped table-bordered table-hover table-full-width SubtypeTable" id="@AccommodationID">
                                                <thead>
                                                    <tr>
                                                        <th scope="col"></th>
                                                        <th scope="col">Date From *</th>
                                                        <th scope="col">Date To *</th>
                                                        <th scope="col">Receipt No. *</th>
                                                        <th scope="col">Description</th>
                                                        <th scope="col">Amount (RM) *</th>
                                                        <th scope="col">Approved Amount (RM) *</th>
                                                        <th scope="col">Approval Remarks</th>
                                                    </tr>
                                                </thead>

                                                @if (Model.Accommodation == null)
                                                {
                                                    <tbody>
                                                        <tr id="new_line_details_0" class="new_line">
                                                            <td><input type="checkbox" class="subtypeCheckbox" /></td>
                                                            <td>
                                                                <div class="input-group date date-picker LPDate_@Index" data-date-format="dd MM yyyy">
                                                                    <input type="text" style="min-width:200px" class="form-control StartDate" name="LeavePassage[@Index].Accommodation[0].StartDate" />
                                                                    <span class="input-group-btn">
                                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="input-group date date-picker LPDate_@Index" data-date-format="dd MM yyyy">
                                                                    <input type="text" style="min-width:200px" class="form-control EndDate" name="LeavePassage[@Index].Accommodation[0].EndDate" />
                                                                    <span class="input-group-btn">
                                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td><input type="text" style="min-width:200px" name="LeavePassage[@Index].Accommodation[0].ReceiptNo" class="form-control ReceiptNo" maxlength="200" /></td>
                                                            <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Accommodation[0].Description" class="form-control Description" maxlength="200" /></td>
                                                            <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Accommodation[0].Amount" class="form-control text-right Amount" value="0.00" maxlength="10" onblur="calculateLPSum('@AccommodationID');"></td>
                                                            <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Accommodation[0].ApprovedAmount" class="form-control text-right ApprovedAmount" value="0.00" maxlength="10" readonly></td>
                                                            <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Accommodation[0].ApprovalRemarks" class="form-control ApprovalRemarks" maxlength="200" readonly /></td>
                                                        </tr>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="5" class="text-right"><label class="control-label text-right"> Total</label></td>
                                                            <td><input type="text" class="form-control text-right GrandAmount" value="0.00" readonly /></td>
                                                            <td><input type="text" class="form-control text-right GrandApprovedAmount" value="0.00" readonly /></td>
                                                            <td></td>
                                                        </tr>

                                                    </tfoot>

                                                }
                                                else
                                                {
                                                    int AccommodationCount = 0;
                                                    <tbody>
                                                        @foreach (var item in Model.Accommodation)
                                                        {
                                                            <tr id="new_line_details_@AccommodationCount" class="new_line">
                                                                <td><input type="checkbox" class="subtypeCheckbox" /></td>
                                                                <td>
                                                                    <div class="input-group date date-picker LPDate_@Index" data-date-format="dd MM yyyy">
                                                                        <input type="text" style="min-width:200px" class="form-control StartDate" name="LeavePassage[@Index].Accommodation[@AccommodationCount].StartDate" value="@item.StartDate" />
                                                                        <span class="input-group-btn">
                                                                            <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                        </span>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="input-group date date-picker LPDate_@Index" data-date-format="dd MM yyyy">
                                                                        <input type="text" style="min-width:200px" class="form-control EndDate" name="LeavePassage[@Index].Accommodation[@AccommodationCount].EndDate" value="@item.EndDate" />
                                                                        <span class="input-group-btn">
                                                                            <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                        </span>
                                                                    </div>
                                                                </td>
                                                                <td><input type="text" style="min-width:200px" name="LeavePassage[@Index].Accommodation[@AccommodationCount].ReceiptNo" class="form-control ReceiptNo" maxlength="200" value="@item.ReceiptNo" /></td>
                                                                <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Accommodation[@AccommodationCount].Description" class="form-control Description" maxlength="200" value="@item.Description" /></td>
                                                                <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Accommodation[@AccommodationCount].Amount" class="form-control text-right Amount" maxlength="10" value="@item.Amount"  onblur="calculateLPSum('@AccommodationID');"></td>
                                                                <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Accommodation[@AccommodationCount].ApprovedAmount" class="form-control text-right ApprovedAmount" maxlength="10" value="@item.ApprovedAmount" readonly onblur="calculateLPApproveSum('@AccommodationID');"></td>
                                                                <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Accommodation[@AccommodationCount].ApprovalRemarks" class="form-control ApprovalRemarks" maxlength="200" value="@item.ApprovalRemarks" readonly /></td>
                                                            </tr>

                                                            AccommodationCount++;
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="5" class="text-right"><label class="control-label text-right"> Total</label></td>
                                                            <td><input type="text" class="form-control text-right GrandAmount" readonly value="@String.Format("{0:0.00}", Model.Accommodation.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" /></td>
                                                            <td><input type="text" class="form-control text-right GrandApprovedAmount" readonly value="@String.Format("{0:0.00}", Model.Accommodation.Sum(m => (String.IsNullOrEmpty(m.ApprovedAmount) ? 0.00 : Convert.ToDouble(m.ApprovedAmount))))" /></td>
                                                            <td></td>
                                                        </tr>

                                                    </tfoot>
                                                }

                                            </table>

                                            <div class="form-horizontal">
                                                <div class="table-toolbar">

                                                    <div class="row subtypeBtn">
                                                        <div class="col-md-12">

                                                            <div class="btn-group">
                                                                <a class="BtnPlus btn green" href="javascript:addLPRow('@AccommodationID','@Index','Accommodation');">
                                                                    Add Row
                                                                    <i class="fa fa-plus"></i>
                                                                </a>
                                                            </div>

                                                            <div class="btn-group">
                                                                <a class="BtnPlus5 btn green" href="javascript:addLP5Row('@AccommodationID','@Index','Accommodation');">
                                                                    Add 5 Rows
                                                                    <i class="fa fa-plus"></i>
                                                                </a>

                                                            </div>
                                                            <div class="btn-group">
                                                                <a class="deleteall btn red" href="javascript:DeleteLPRow('@AccommodationID');">
                                                                    Delete Row
                                                                    <i class="fa fa-minus"></i>
                                                                </a>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Miscellaneous -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="portlet box blue subsubType" id="@MiscellaneousID">
                                    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                                    <div class="portlet-title">
                                        <div class="caption">
                                            <i class="fa fa-reorder"></i> Miscellaneous
                                        </div>
                                        <div class="tools">
                                        </div>
                                    </div>
                                    <div class="portlet-body form">
                                        <div class="form-body">
                                            <table class="table table-striped table-bordered table-hover table-full-width SubtypeTable" id="@MiscellaneousID">
                                                <thead>
                                                    <tr>
                                                        <th scope="col"></th>
                                                        <th scope="col">Date *</th>
                                                        <th scope="col">Receipt No. *</th>
                                                        <th scope="col">Description</th>
                                                        <th scope="col">Amount (RM) *</th>
                                                        <th scope="col">Approved Amount (RM) *</th>
                                                        <th scope="col">Approval Remarks</th>
                                                    </tr>
                                                </thead>

                                                @if (Model.Miscellaneous == null)
                                                {
                                                    <tbody>
                                                        <tr id="new_line_details_0" class="new_line">
                                                            <td><input type="checkbox" class="subtypeCheckbox" /></td>
                                                            <td>
                                                                <div class="input-group date date-picker LPDate_@Index" data-date-format="dd MM yyyy">
                                                                    <input type="text" style="min-width:200px" class="form-control StartDate" name="LeavePassage[@Index].Miscellaneous[0].StartDate" />
                                                                    <span class="input-group-btn">
                                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td><input type="text" style="min-width:200px" name="LeavePassage[@Index].Miscellaneous[0].ReceiptNo" class="form-control ReceiptNo" maxlength="200" /></td>
                                                            <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Miscellaneous[0].Description" class="form-control Description" maxlength="200" /></td>
                                                            <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Miscellaneous[0].Amount" class="form-control text-right Amount" value="0.00" maxlength="10" onblur="calculateLPSum('@MiscellaneousID');"></td>
                                                            <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Miscellaneous[0].ApprovedAmount" class="form-control text-right ApprovedAmount" value="0.00" maxlength="10" readonly></td>
                                                            <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Miscellaneous[0].ApprovalRemarks" class="form-control ApprovalRemarks" maxlength="200" readonly /></td>
                                                        </tr>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="4" class="text-right"><label class="control-label text-right"> Total</label></td>
                                                            <td><input type="text" class="form-control text-right GrandAmount" value="0.00" readonly /></td>
                                                            <td><input type="text" class="form-control text-right GrandApprovedAmount" value="0.00" readonly /></td>
                                                            <td></td>
                                                        </tr>

                                                    </tfoot>
                                                }
                                                else
                                                {
                                                    int MiscellaneousCount = 0;
                                                    <tbody>
                                                        @foreach (var item in Model.Miscellaneous)
                                                        {
                                                            <tr id="new_line_details_@MiscellaneousCount" class="new_line">
                                                                <td><input type="checkbox" class="subtypeCheckbox" /></td>
                                                                <td>
                                                                    <div class="input-group date date-picker LPDate_@Index" data-date-format="dd MM yyyy">
                                                                        <input type="text" style="min-width:200px" class="form-control StartDate" name="LeavePassage[@Index].Miscellaneous[@MiscellaneousCount].StartDate" value="@item.StartDate" />
                                                                        <span class="input-group-btn">
                                                                            <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                        </span>
                                                                    </div>
                                                                </td>
                                                                <td><input type="text" style="min-width:200px" name="LeavePassage[@Index].Miscellaneous[@MiscellaneousCount].ReceiptNo" class="form-control ReceiptNo" maxlength="200" value="@item.ReceiptNo" /></td>
                                                                <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Miscellaneous[@MiscellaneousCount].Description" class="form-control Description" maxlength="200" value="@item.Description" /></td>
                                                                <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Miscellaneous[@MiscellaneousCount].Amount" class="form-control text-right Amount" maxlength="10" value="@item.Amount"  onblur="calculateLPSum('@MiscellaneousID');"></td>
                                                                <td><input type="text" style="min-width:100px" name="LeavePassage[@Index].Miscellaneous[@MiscellaneousCount].ApprovedAmount" class="form-control text-right ApprovedAmount" maxlength="10" value="@item.ApprovedAmount" readonly onblur="calculateLPApproveSum('@MiscellaneousID');"></td>
                                                                <td><input type="text" style="min-width:300px" name="LeavePassage[@Index].Miscellaneous[@MiscellaneousCount].ApprovalRemarks" class="form-control ApprovalRemarks" maxlength="200" value="@item.ApprovalRemarks" readonly /></td>
                                                            </tr>
                                                            MiscellaneousCount++;
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="4" class="text-right"><label class="control-label text-right"> Total</label></td>
                                                            <td><input type="text" class="form-control text-right GrandAmount" readonly value="@String.Format("{0:0.00}",Model.Miscellaneous.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" /></td>
                                                            <td><input type="text" class="form-control text-right GrandApprovedAmount" readonly value="@String.Format("{0:0.00}",Model.Miscellaneous.Sum(m => (String.IsNullOrEmpty(m.ApprovedAmount) ? 0.00 : Convert.ToDouble(m.ApprovedAmount))))" /></td>
                                                            <td></td>
                                                        </tr>

                                                    </tfoot>
                                                }
                                            </table>
                                            <div class="form-horizontal">
                                                <div class="table-toolbar">

                                                    <div class="row subtypeBtn">
                                                        <div class="col-md-12">

                                                            <div class="btn-group">
                                                                <a class="BtnPlus btn green" href="javascript:addLPRow('@MiscellaneousID','@Index','Miscellaneous');">
                                                                    Add Row
                                                                    <i class="fa fa-plus"></i>
                                                                </a>
                                                            </div>

                                                            <div class="btn-group">
                                                                <a class="BtnPlus5 btn green" href="javascript:addLP5Row('@MiscellaneousID','@Index','Miscellaneous');">
                                                                    Add 5 Rows
                                                                    <i class="fa fa-plus"></i>
                                                                </a>

                                                            </div>
                                                            <div class="btn-group">
                                                                <a class="deleteall btn red" href="javascript:DeleteLPRow('@MiscellaneousID');">
                                                                    Delete Row
                                                                    <i class="fa fa-minus"></i>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
