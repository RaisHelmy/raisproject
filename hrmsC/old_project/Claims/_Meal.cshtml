@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimType = Model.ClaimSubTypeCategory;
    string ClaimsSubtypeName = ViewBag.Meal_ClaimsSubtypeName;
    string GSTEnabled = (@ViewBag.Meal_GSTEnabled + "").ToLower();
    string Status = @ViewBag.Meal_Status;
    string dtStrStart = @ViewBag.Meal_StartDate;
    string dtStrEnd = @ViewBag.Meal_EndDate;
    string GSTMaximumValue = ViewBag.Meal_GSTMaximumValue;
    string PayScaleGroup =ViewBag.Meal_PayScaleGroup;
    string SubmitterID = ViewBag.Meal_SubmitterID;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
}

<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimType - @ClaimsSubtypeName
        </div>

        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')"><img style=" vertical-align: initial;" src="../Assets/img/portlet-remove-icon-white.png" /></a>
            </div>

        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Charge Code *</th>
                                <th scope="col">Working Type *</th>
                                <th scope="col">Date *</th>
                                <th scope="col">Planned Start Time</th>
                                <th scope="col">Planned End Time</th>
                                <th scope="col">Actual Start Time *</th>
                                <th scope="col">Actual End Time *</th>
                                <th scope="col">Meal Type *</th>
                                <th scope="col">Amount (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @{
                            List<SelectListItem> MealWorkingTypeList = new List<SelectListItem>();
                            MealWorkingTypeList.Add(new SelectListItem { Text = "- Please Select -", Value = "" });
                            MealWorkingTypeList.Add(new SelectListItem { Text = "Normal Hours", Value = "Normal Hours" });
                            MealWorkingTypeList.Add(new SelectListItem { Text = "Shift Hours", Value = "Shift Hours" });

                            List<SelectListItem> Meal_MealType = new List<SelectListItem>();
                            Meal_MealType.Add(new SelectListItem { Text = "- Please Select -", Value = "" });
                            //Meal_MealType.Add(new SelectListItem { Text = "Breakfast", Value = "Breakfast" });
                            //Meal_MealType.Add(new SelectListItem { Text = "Lunch", Value = "Lunch" });
                            //Meal_MealType.Add(new SelectListItem { Text = "Dinner", Value = "Dinner" });
                            //Meal_MealType.Add(new SelectListItem { Text = "Others", Value = "Others 1" });
                            //Meal_MealType.Add(new SelectListItem { Text = "Others2", Value = "Others 2" });
                            //Meal_MealType.Add(new SelectListItem { Text = "Others3", Value = "Others 3" });
                        }
                        @Html.DropDownList(DataTableID + "MealWorkingTypeListDDL", MealWorkingTypeList, 
                                           new { @id = DataTableID + "MealWorkingTypeListDDL", @class = "hidden " + DataTableID + "WorkingTypeListhiddenDDL"})
                        @Html.DropDownList(DataTableID + "Meal_MealTypeDDL", Meal_MealType, 
                                           new { @id = DataTableID + "Meal_MealTypeDDL", @class = "hidden " + DataTableID + "_MealTypehiddenDDL" })

                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                        <td>
                                            <input type="hidden" class="hfChargeCode" />
                                            <select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" 
                                                    name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0" 
                                                    onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn1", MealWorkingTypeList,
                                            new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn1",
                                                @class = "bs-select form-control SubTypeColumn1", @style = "min-width:200px", @onchange = DataTableID + "_CalculateSum(this)" })
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control SubTypeColumn2" style="width:150px" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" onchange="@(DataTableID)_CalculateSum(this)" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" class="form-control SubTypeColumn3" />
                                        </td>
                                        <td>
                                            <input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4" class="form-control SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" onblur="@(DataTableID)_CalculateSum(this)" 
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" class="form-control SubTypeColumn5 timeinput" />
                                        </td>
                                        <td>
                                            <input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" onblur="@(DataTableID)_CalculateSum(this)"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" class="form-control SubTypeColumn6 timeinput" />
                                        </td>
                                        <td>
                                            
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn7", Meal_MealType,
