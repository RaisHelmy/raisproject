    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(10)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _PlanStartTime = $(this).children('td:eq(4)').children('input[type=text]');
            var _PlanEndTime = $(this).children('td:eq(5)').children('input[type=text]');
            var _Amount = $(this).children('td:eq(9)').children('input[type=text]');
            _PlanStartTime.prop('readonly', true);
            _PlanEndTime.prop('readonly', true);
            _Amount.prop('readonly', true);

            var WorkingType = $(this).children('td:eq(2)').children('input[type=hidden]'); // $(this).find(".SubTypeColumn1"); //document.getElementById($row.find(".SubTypeColumn1").attr('id'));
            var MealTypeList = document.getElementById($(this).find(".SubTypeColumn7").attr('id')); // document.getElementById($row.find(".SubTypeColumn7").attr('id'));
            var MealTypeSelected = $(this).children('td:eq(8)').children('input[type=hidden]');
             

            if (WorkingType.val() != "" && IsAddRow == "0") { 
                PopulateMealTypeList(WorkingType.val(), MealTypeList, MealTypeSelected.val())
            }

        });


        $(".@(DataTableID)RemoveCheckbox").uniform();
        $('.timeinput').inputmask("mask", {
            "mask": "99:99"
        });
        BindtoDDL();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSum(x) {
        var $row = $(x).closest("tr");
        var _WorkingType = document.getElementById($row.find(".SubTypeColumn1").attr('id'));
        var _Date = document.getElementById($row.find(".SubTypeColumn2").attr('id'));
        var _PlanStartTime = document.getElementById($row.find(".SubTypeColumn3").attr('id'));
        var _PlanEndTime = document.getElementById($row.find(".SubTypeColumn4").attr('id'));
        var _ActualStartTime = document.getElementById($row.find(".SubTypeColumn5").attr('id'));
        var _ActualEndTime = document.getElementById($row.find(".SubTypeColumn6").attr('id'));
        var _MealType = document.getElementById($row.find(".SubTypeColumn7").attr('id'));
        var _Amount = document.getElementById($row.find(".Amount").attr('id'));
        var _GSTAmount = document.getElementById($row.find(".GSTAmount").attr('id'));
        var _TotalAmount = document.getElementById($row.find(".TotalAmount").attr('id'));

        @(DataTableID)_PopulateMealType(x);

        if (_WorkingType.value != "" && _Date.value != "" && _ActualStartTime.value != "" && _ActualEndTime.value != "" && _MealType.value != "") {
            var form = {
                SubmitterID: '@SubmitterID',
                PayScaleGroup: '@PayScaleGroup',
                SelectedDate: _Date.value,
                ActualStartTime: _ActualStartTime.value,
                ActualEndTime: _ActualEndTime.value,
                MealType: _MealType.value,
                GSTEnabled: '@GSTEnabled',
                GSTMaximumValue: '@GSTMaximumValue',
            };
             
            $.ajax({
                type: "POST",
                url: '@Url.Content("~/Claims/_MealCalculation")',
                cache: false,
                async: false,
                dataType: "json",
                data: form,
                success: function (result) {
                    if (result.Success) {
                        _PlanStartTime.value = result['_PlanStartDate'];
                        _PlanEndTime.value = result['_PlanEndDate'];
                        _Amount.value = result['_Amount'];
                        _GSTAmount.value = result['_GSTAmount'];
                        _TotalAmount.value = result['_TotalAmount'];
                    }
                    else {
                        alert(result.ErrorMsg);
                    }
                },
                error: function (e) {

                }
            });

            @(DataTableID)_CalculateSubtotal();
            CalculateSummary();
        }

    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaximumValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".TotalAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandTotal + (_TotalAmount * 1);
            }
        });
        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
        CalculateSummary();
    }


