        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _DDL1Select = $(this).children('td:eq(2)').children('select');
            var _DDL1Hidden = $(this).children('td:eq(2)').children('input[type=hidden]');

            var _DDL2Select = $(this).children('td:eq(8)').children('select');
