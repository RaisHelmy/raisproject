
@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.ElaunKhususTechnicalAdvisor_ClaimsSubtypeName;
    string dtStrStart = ViewBag.ElaunKhususTechnicalAdvisor_StartDate;
    string dtStrEnd = ViewBag.ElaunKhususTechnicalAdvisor_EndDate;
    DateTime dateStrStart = DateTime.ParseExact(dtStrStart, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
    DateTime dateStrEnd = DateTime.ParseExact(dtStrEnd, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
    string Status = ViewBag.ElaunKhususTechnicalAdvisor_Status;
    string GSTEnabled = (ViewBag.ElaunKhususTechnicalAdvisor_GSTEnabled + "").ToLower();
    string GSTMaxValue = ViewBag.ElaunKhususTechnicalAdvisor_GSTMaxValue;

    string ETechAdvisor_CategoryDDL = ViewBag.ElaunKhususTechnicalAdvisor_Category_DDList;
    string ETechAdvisor_LocationDDL = ViewBag.ElaunKhususTechnicalAdvisor_Location_DDList;
    string ETechAdvisor_CommByDDL = ViewBag.ElaunKhususTechnicalAdvisor_CommBy_DDList;
    string ETechAdvisor_MappedAmtDDL = ViewBag.ElaunKhususTechnicalAdvisor_MappedAmt_DDList;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
    GSTMaxValue = String.IsNullOrEmpty(Model.GST.ToString()) ? "0" : Model.GST.ToString();
}

<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@Model.ClaimSubTypeCategory - @Model.ClaimsSubtypeName
        </div>
        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')">
                    <img style=" vertical-align: initial;" src="../Assets/img/portlet-remove-icon-white.png" />
                </a>
            </div>
        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"></a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Charge Code *</th>
                                <th scope="col">Start Date *</th>
                                <th scope="col">End Date *</th>
                                <th scope="col">Category *</th>
                                <th scope="col">Location *</th>
                                <th scope="col">Commissioned By *</th>
                                <th scope="col">Amount</th>
                                <th scope="col">Tax Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                        <td>
                                            <input type="hidden" class="hfChargeCode" />
                                            <select class="form-control ddlChargeCode SubTypeColumn0" style="min-width:130px" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();"
                                                    name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" class="form-control SubTypeColumn1"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" class="form-control SubTypeColumn2"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <select class="form-control SubTypeColumn3" style="min-width:200px"
                                                    name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-control SubTypeColumn4" style="min-width:200px"
                                                    name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-control SubTypeColumn5" style="min-width:200px"
                                                    name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right Amount" style="min-width:130px" maxlength="10" value="0.00" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount"
                                                   onblur="@(DataTableID)_CalculateSum(this);" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="0.00" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount"
                                                   onblur="@(DataTableID)_CalculateSumGST(this);" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="0.00" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" />
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="7"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="0.00" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="0.00" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="0.00" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                            <td>
                                                <input type="hidden" class="hfChargeCode" value="@thisDetail.SubTypeColumn0" />
                                                <select class="form-control ddlChargeCode SubTypeColumn0" style="min-width:130px" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();"
                                                        name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                    <input type="text" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1"
                                                           name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                    <input type="text" class="form-control SubTypeColumn2" value="@thisDetail.SubTypeColumn2"
                                                           name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn2" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <select class="form-control SubTypeColumn3" style="min-width:200px" selVal="@thisDetail.SubTypeColumn3"
                                                        name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn3">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select class="form-control SubTypeColumn4" style="min-width:200px" selVal="@thisDetail.SubTypeColumn4"
                                                        name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn4">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select class="form-control SubTypeColumn5" style="min-width:200px" selVal="@thisDetail.SubTypeColumn5"
                                                        name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn5">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right Amount" style="min-width:130px" maxlength="10" value="@thisDetail.Amount" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount"
                                                       onblur="@(DataTableID)_CalculateSum(this);" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="@thisDetail.GSTAmount" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount"
                                                       onblur="@(DataTableID)_CalculateSumGST(this);" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="@thisDetail.TotalAmount" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" />
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="7"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                    <tr>
                                        <td></td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn0" style="min-width:130px" value="@thisDetail.SubTypeColumn0" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn1" style="min-width:150px" value="@thisDetail.SubTypeColumn1" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn2" style="min-width:150px" value="@thisDetail.SubTypeColumn2" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn2" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn3" style="min-width:200px" value="@thisDetail.SubTypeColumn3" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn3" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn4" style="min-width:200px" value="@thisDetail.SubTypeColumn4" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn5" style="min-width:200px" value="@thisDetail.SubTypeColumn5" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn5" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right Amount" style="min-width:130px" value="@thisDetail.Amount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="@thisDetail.GSTAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="@thisDetail.TotalAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" />
                                        </td>
                                    </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.GSTAmount) ? 0.00 : Convert.ToDouble(m.GSTAmount))))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.TotalAmount) ? 0.00 : Convert.ToDouble(m.TotalAmount))))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
            {
                <div class="form-horizontal">
                    <div class="table-toolbar">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="btn-group">
                                    <a class="BtnPlus btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_addRow();">
                                        Add Row
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                                <div class="btn-group">
                                    <a class="BtnPlus5 btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_add5Row();">
                                        Add 5 Rows
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                                <div class="btn-group">
                                    <a class="deleteall btn red" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_removeRow();">
                                        Delete Row
                                        <i class="fa fa-minus"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    var ETechAdvisor_CategoryDDL = @Html.Raw(ETechAdvisor_CategoryDDL);
    var ETechAdvisor_LocationDDL = @Html.Raw(ETechAdvisor_LocationDDL);
    var ETechAdvisor_CommByDDL = @Html.Raw(ETechAdvisor_CommByDDL);
    var ETechAdvisor_MappedAmtDDL = @Html.Raw(ETechAdvisor_MappedAmtDDL);

    function dTable_@(DataTableID)Validation() {
        var _ValidationMsg = '';

        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");

            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            var _StartDate = $row.find(".SubTypeColumn1").val();
            var _EndDate = $row.find(".SubTypeColumn2").val();
            var _Category = $row.find(".SubTypeColumn3").val();
            var _Location = $row.find(".SubTypeColumn4").val();
            var _CommissionedBy = $row.find(".SubTypeColumn5").val();
            var _Amount = $row.find(".Amount").val();

            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n'
            }

            if (_StartDate == null || _StartDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Start Date) is required.\n'
            }

            if (_EndDate == null || _EndDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (End Date) is required.\n'
            }

            if (_Category == null || _Category == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Category) is required.\n'
            }

            if (_Location == null || _Location == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Location) is required.\n'
            }

            if (_CommissionedBy == null || _CommissionedBy == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Commissioned By) is required.\n'
            }

            if (_Amount == null || _Amount == '0' || _Amount == '' || _Amount == '0.00') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is required.\n'
            }

            if (_Amount == 'Infinity') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is invalid.\n'
            }

            var _GSTAmount = $row.find(".GSTAmount").val();
            var gstAmt = 0;
            if ('@GSTEnabled' != 'false') {
                if (_GSTAmount == null || _GSTAmount == '') {
                    _ValidationMsg += '- @ClaimsSubtypeName (GST Amount) is required.\n'
                }

                var gstMaxValue = '@GSTMaxValue';
                gstAmt = parseFloat(_Amount) * (parseFloat(gstMaxValue) / 100);
                if ((parseFloat(_GSTAmount) || 0) > (parseFloat(gstAmt.toFixed(2)) || 0)) {
                    _ValidationMsg += '- @ClaimsSubtypeName - The GST Amount (highlighted in yellow) has exceeded the maximum value.Please edit or delete the record to proceed.\n'
                    $row.find(".GSTAmount").css("background-color", "yellow");
                }
                else {
                    $row.find(".GSTAmount").css("background-color", "white");
                }
            }
        });
        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="@(DataTableID)RemoveCheckbox"]:checked'), function (i, val) {
            var currLength = $('#tbl@(DataTableID) tr').length - 2;
            var row = $(this).closest("tr").get(0);
            if (currLength > 1) {
                _@(DataTableID)Table.fnDeleteRow(mytable.fnGetPosition(row));
            }
        });

        reorderTable('#tbl@(DataTableID)');
        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_add5Row() {
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
    }

    function @(DataTableID)_addRow() {
        _@(DataTableID)Table.fnAddData([
            '<input type="checkbox" class="@(DataTableID)RemoveCheckbox" />',
            '<input type="hidden" class="hfChargeCode" /><select class="form-control ddlChargeCode SubTypeColumn0" style="min-width:130px" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn0"><option value="">Select One</option></select>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control SubTypeColumn2" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<select class="form-control SubTypeColumn3" style="min-width:200px" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn3"><option value="">Select One</option></select>',
            '<select class="form-control SubTypeColumn4" style="min-width:200px" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4"><option value="">Select One</option></select>',
            '<select class="form-control SubTypeColumn5" style="min-width:200px" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5"><option value="">Select One</option></select>',
            '<input type="text" class="form-control text-right Amount" style="min-width:130px" maxlength="10" value="0.00" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Amount" onblur="@(DataTableID)_CalculateSum(this);" />',
           '<input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="0.00" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].GSTAmount" onblur="@(DataTableID)_CalculateSumGST(this);" />',
            '<input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="0.00" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].TotalAmount" />'
        ]);

        @(DataTableID)_PrepDropDownList();
        @(DataTableID)_Initialize();
    }

    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        @(DataTableID)_DatePickBehaviourListener();

        $('#tbl@(DataTableID) .date-picker').each(function () {
            var currRow = $(this).parents('tr');
            var dateElem = currRow.find('input.SubTypeColumn2').parent('div.date-picker');
            var endDate = dateElem.datepicker('getDate');
            dateElem.datepicker('setDate', endDate);
        })

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).find('input.GSTAmount');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $(".@(DataTableID)RemoveCheckbox").uniform();
        BindtoDDL();
        CalculateSummary();
    }

    function @(DataTableID)_DatePickBehaviourListener() {
        $('#tbl@(DataTableID) .date-picker').datepicker().on('changeDate', function () {
            var currRow = $(this).parents('tr');
            var startDate = currRow.find('input.SubTypeColumn1').parent('div.date-picker').datepicker('getDate');
            var endDateElem = currRow.find('input.SubTypeColumn2').parent('div.date-picker');
            var endDate = endDateElem.datepicker('getDate');
            var amountElem = currRow.find('.Amount');
            var categoryElem = currRow.find('.SubTypeColumn3');

            var setStartDateVal = new Date();
            var setEndDateVal = new Date();

            if (startDate != null) {

                var setEndDate = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 1);
                var endDateConfig = new Date(@dateStrEnd.Year, @dateStrEnd.Month - 1, @dateStrEnd.Day);
                setStartDateVal = startDate;
                setEndDateVal = new Date(setEndDate.setDate(setEndDate.getDate() - 1));

                endDateElem.datepicker('setStartDate', startDate);
            } else {
                setStartDateVal = new Date(@dateStrStart.Year, @dateStrStart.Month, @dateStrStart.Day);
                endDateElem.datepicker('setStartDate', setStartDateVal);
            }

            if (!(startDate == null || endDate == null)) {
                if (!(endDate >= setStartDateVal && endDate <= setEndDateVal)) {
                    endDateElem.datepicker('setDate', startDate);
                }
            }

            var totalDays = 0;
            if (startDate != null && endDate != null) {
                totalDays = Math.ceil(Math.abs(endDate - startDate) / (1000 * 60 * 60 * 24)) + 1;
            }

            amountElem.attr('valid-days', totalDays);
            categoryElem.change();
        });
    }

    function @(DataTableID)_HTMLDDL() {
        var tempCategoryDDL = "";
        var tempLocationDDL = "";
        var tempCommByDDL = "";

        for (var j = 0; j < ETechAdvisor_CategoryDDL.length; j++) {
            tempCategoryDDL += '<option value="' + ETechAdvisor_CategoryDDL[j].Text + '" value2="' + ETechAdvisor_CategoryDDL[j].Value + '">' + ETechAdvisor_CategoryDDL[j].Text + '</option>';
        }

        for (var j = 0; j < ETechAdvisor_LocationDDL.length; j++) {
            tempLocationDDL += '<option value="' + ETechAdvisor_LocationDDL[j].Text + '" value2="' + ETechAdvisor_LocationDDL[j].Value + '">' + ETechAdvisor_LocationDDL[j].Text + '</option>';
        }

        for (var j = 0; j < ETechAdvisor_CommByDDL.length; j++) {
            tempCommByDDL += '<option value="' + ETechAdvisor_CommByDDL[j].Text + '" value2="' + ETechAdvisor_CommByDDL[j].Value + '">' + ETechAdvisor_CommByDDL[j].Text + '</option>';
        }

        ETechAdvisor_CategoryDDL = tempCategoryDDL;
        ETechAdvisor_LocationDDL = tempLocationDDL;
        ETechAdvisor_CommByDDL = tempCommByDDL;
    }

    function @(DataTableID)_PrepDropDownList() {
        var rowCount = _@(DataTableID)Table.fnSettings().fnRecordsTotal() - 1;

        for (var i = 0; i < rowCount + 1; i++) {
            var elemCategory = $('select.SubTypeColumn3[name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + parseInt(rowCount - i) + '].SubTypeColumn3"]');
            var elemLocation = $('select.SubTypeColumn4[name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + parseInt(rowCount - i) + '].SubTypeColumn4"]');
            var elemCommBy = $('select.SubTypeColumn5[name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + parseInt(rowCount - i) + '].SubTypeColumn5"]');

            if (!elemCategory.hasClass('CategoryDDL-Loaded')) {
                elemCategory.unbind();
                elemCategory.empty();
                elemCategory.append('<option value="">Select One</option>');
                elemCategory.append(ETechAdvisor_CategoryDDL);
                elemCategory.addClass('CategoryDDL-Loaded');
                elemCategory.change(function () {
                    @(DataTableID)_GetMappedAmount($(this));
                });
                elemCategory.val(elemCategory.attr('selVal')).change();
            }

            if (!elemLocation.hasClass('LocationDDL-Loaded')) {
                elemLocation.unbind();
                elemLocation.empty();
                elemLocation.append('<option value="">Select One</option>');
                elemLocation.append(ETechAdvisor_LocationDDL);
                elemLocation.addClass('LocationDDL-Loaded');
                elemLocation.change(function () {
                    @(DataTableID)_GetMappedAmount($(this));
                });
                elemLocation.val(elemLocation.attr('selVal')).change();
            }

            if (!elemCommBy.hasClass('CommByDDL-Loaded')) {
                elemCommBy.unbind();
                elemCommBy.empty();
                elemCommBy.append('<option value="">Select One</option>');
                elemCommBy.append(ETechAdvisor_CommByDDL);
                elemCommBy.addClass('CommByDDL-Loaded');
                elemCommBy.change(function () {
                    @(DataTableID)_GetMappedAmount($(this));
                });
                elemCommBy.val(elemCommBy.attr('selVal')).change();
            }
        }
    }

    function @(DataTableID)_GetMappedAmount(x) {
        var rowElem = $(x).parents('tr');
        var categoryElem = rowElem.find('select.SubTypeColumn3').find('option:selected').attr('value2');
        var locationElem = rowElem.find('select.SubTypeColumn4').find('option:selected').attr('value2');
        var commByElem = rowElem.find('select.SubTypeColumn5').find('option:selected').attr('value2');
        var amountElem = rowElem.find('.Amount');
        var totalDays = amountElem.attr('valid-days')

        if (categoryElem === "" || typeof categoryElem === "undefined" ||
            locationElem === "" || typeof locationElem === "undefined" ||
            commByElem === "" || typeof commByElem === "undefined") {
            amountElem.val(parseFloat(0).toFixed(2));
            return false;
        }

        var matchingText = categoryElem + " - " + locationElem + " - " + commByElem;
        var mappedValue = ETechAdvisor_MappedAmtDDL.find(x => x.Text === matchingText).Value;

        if (isNaN(mappedValue)) mappedValue = parseFloat(0).toFixed(2);
        amountElem.val(parseFloat(mappedValue * totalDays).toFixed(2)).blur();
    }

    function @(DataTableID)_CalculateSum(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }
        //var MaxClaimableValue = parseFloat(@@MaxClaimableValue);

        var $row = $(x).closest("tr");
        //var SubTypeColumn4 = parseFloat($row.find(".SubTypeColumn4").val());
        //if (SubTypeColumn4 > MaxClaimableValue)
        //{
        //    $row.find(".Amount").val(MaxClaimableValue.toFixed(2));
        //}
        //else
        //{
        //  $row.find(".Amount").val(SubTypeColumn4.toFixed(2));
        //}
        var amount = $row.find(".Amount").val();
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            gstMaxValue = '@GSTMaxValue';
            gstAmt = amount * (parseFloat(gstMaxValue) / 100);
            $row.find(".GSTAmount").val(gstAmt.toFixed(2));
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaxValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;

        var thisTable = $('#tbl@(DataTableID)');

        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandAmount + grandGST;
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));

        CalculateSummary();
    }

    $(document).ready(function () {

        @(DataTableID)_HTMLDDL();

        @(DataTableID)_Initialize();

        @(DataTableID)_PrepDropDownList();

    });
</script>