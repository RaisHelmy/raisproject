
@{
    ViewBag.Title = "ViewAttachment";
}

<h2>ViewAttachment</h2>


@Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = ViewBag.Mode, SourceType = "Claims", RequestID = ViewBag.RequestID, ShowOptionField = "true", Mandatory = "true" })

<input type="button" class="btn green" value="Test" id="btnTest" onclick="testUpload();" />

<script>
    var Path = 'http://localhost:49773';

    //testing
    function testUpload() {

        $.ajax({
            type: "POST",
            url: '@Url.Content("~/Claims/testUpload1")',
            cache: false,
            async: false,
            dataType: "json",
            success: function (result) {
                if (result.Success) {
                    alert("success");
                    window.location = "http://localhost:49773/Claims/TestAttachment";
                }
                else {
                    alert(result.ErrorMsg);
                }
            },
            error: function (e) {

            }
        });
    }

</script>



