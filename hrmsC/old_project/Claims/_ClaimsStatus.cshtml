@model ESS.Claim.ViewModels.ClaimVM
<style>
    .center {
        text-align:center;
    }
</style>

<div class="portlet box blue">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Request Details
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Reference No.</label>
                                <div class="col-md-8 form-control-static">
                                  
                                    <input type="hidden" name="ID" value="@Model.ID" />
                                    <input type="hidden" name="RequestNo" value="@Model.RequestNo" />
                                    @Html.DisplayFor(x => x.RequestNo)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Claim Status</label>
                                <div class="col-md-8 form-control-static">
                                    @*@Html.DisplayFor(x => x.Status)*@
                                    <input type="hidden" name="Status" value="@Model.Status" />
                                    @ESS.Claim.Service.GetStatus(int.Parse(Model.Status))
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Category</label>
                            <div class="col-md-8 form-control-static">
                                @Html.DisplayFor(x => x.ClaimType)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Current Approver</label>
                            <div class="col-md-8 form-control-static">
                                @Html.DisplayFor(x => x.ApproverName) 
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            </div>
    </div>
</div>

