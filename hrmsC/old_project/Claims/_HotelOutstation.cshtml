    function HotelOutstation_Initialize() {
        $('#tblHotelOutstation .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tblHotelOutstation .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tblHotelOutstation .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tblHotelOutstation tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(12)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $('#tblHotelOutstation tbody tr').each(function () {
            var _Nodays = $(this).children('td:eq(3)').children('input[type=text]');

            _Nodays.prop('readonly', true);
        });
    }

    function HotelOutstationGetDDLInputValues() {
        $('#tblHotelOutstation tbody tr').each(function () {
            var _DDLSelect = $(this).children('td:eq(4)').children('select');
            var _DDLHidden = $(this).children('td:eq(4)').children('input[type=hidden]');
            _DDLSelect.val(_DDLHidden.val());

        });
    }

    function toDate(dateStr) {
        var parts = dateStr.split("/");
        return new Date(parts[2], parts[1] - 1, parts[0]);
    }

    function HotelOutstationDateOnchange(categoryIndex, subtypeIndex, IndexCount) {
        var ddlName = "ClaimsSubtypeCategory[" + categoryIndex + "].ClaimSubtype[" + subtypeIndex + "].SubTypeDetails[" + IndexCount + "]";
        var _StartDate = document.getElementById(ddlName + ".SubTypeColumn1");
        var _EndDate = document.getElementById(ddlName + ".SubTypeColumn2");
        var _Nodays = document.getElementById(ddlName + ".SubTypeColumn3");

        if (_StartDate.value != "" && _EndDate.value == "") {
            _EndDate.value = _StartDate.value;
        }

        if (_StartDate.value == "" && _EndDate.value != "") {
            _StartDate.value = _EndDate.value;
        }

        var f = toDate(_StartDate.value);
        var t = toDate(_EndDate.value);

        if (t < f) {
            alert(" End date is less than start date ");
            _StartDate.value = _EndDate.value;
        }

        f = toDate(_StartDate.value);
        t = toDate(_EndDate.value);

        _Nodays.value = (t.getDate() - f.getDate()) + 1;
    }

    function HotelOutstationCalculate() {

        var thisTable = $('#tblHotelOutstation');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _NoDays = $row.find(".SubTypeColumn3").val();
            var _StayType = $row.find(".SubTypeColumn4").val();
            var _WithReceipts = $row.find(".SubTypeColumn5").is(':checked');
            var _HotelRate = $row.find(".SubTypeColumn7").val();
            var _HotelAmount = $row.find(".SubTypeColumn8").val();
            var _TaxAmount = $row.find(".SubTypeColumn9").val();
            var _TotalHotel = $row.find(".SubTypeColumn10").val();
            var _TotalClaim = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".SubTotalAmount").val();
            var MaxClaim = 0;
            var Rate = 0;

            if (_NoDays == "") {
                alert("Date is required");
                $row.find(".SubTypeColumn7").val('0.00');
                $row.find(".SubTypeColumn8").val('0.00');
                $row.find(".SubTypeColumn9").val('0.00');
                $row.find(".SubTypeColumn10").val('0.00');
                $row.find(".Amount").val('0.00');
                $row.find(".GSTAmount").val('0.00');
                $row.find(".SubTotalAmount").val('0.00');
            }

            if (_StayType == "")
            {
                alert("Stay Type is required");
                $row.find(".SubTypeColumn7").val('0.00');
                $row.find(".SubTypeColumn8").val('0.00');
                $row.find(".SubTypeColumn9").val('0.00');
                $row.find(".SubTypeColumn10").val('0.00');
                $row.find(".Amount").val('0.00');
                $row.find(".GSTAmount").val('0.00');
                $row.find(".SubTotalAmount").val('0.00');

            }


            if (_WithReceipts) {
                if (_StayType == "Full Day") {

                    MaxClaim = '@MaxClaimFullYesReceipt';
                    Rate = '@HotelRateFullYesReceipt';
                }
                if (_StayType == "Half Day")
                {
                    MaxClaim = '@MaxClaimHalfYesReceipt';
                    Rate = '@HotelRateHalfYesReceipt';
                }

            }
            else {
                if (_StayType == "Full Day") {

                    MaxClaim = '@MaxClaimFullNoReceipt';
                    Rate = '@HotelRateFullNoReceipt';
                }
                if (_StayType == "Half Day")
                {
                    MaxClaim = '@MaxClaimHalfNoReceipt';
                    Rate = '@HotelRateHalfNoReceipt';
                }
            }

            console.log('MaxClaim -' + MaxClaim);
            console.log('Rate -' + Rate);

            var HotelAmount = 0;
            HotelAmount = parseFloat(_NoDays) * parseFloat(_HotelRate);
            $row.find(".SubTypeColumn8").val(HotelAmount);

            var totalHotel = 0;
            totalHotel = parseFloat(HotelAmount) + parseFloat(_TaxAmount);
            $row.find(".SubTypeColumn10").val(totalHotel);

            var TotalClaim = 0;
            if (parseFloat(_HotelRate) > parseFloat(MaxClaim)) {
                TotalClaim = parseFloat(MaxClaim) * parseFloat(_NoDays) + parseFloat(_TaxAmount);
            }
            else
            {
                TotalClaim = HotelAmount + parseFloat(_TaxAmount);
            }
            $row.find(".Amount").val(TotalClaim);

            var gstAmt = 0;
            if ('@GSTEnabled' != 'false') {
                var gstMaxValue = '@GSTMaximumValue';
                gstAmt = parseFloat(TotalClaim) * (parseFloat(gstMaxValue) / 100);
            }
            $row.find(".GSTAmount").val(gstAmt.toFixed(2));

            var TotalAmount = 0;
            TotalAmount = parseFloat(TotalClaim) + (parseFloat(gstAmt.toFixed(2));
            $row.find(".SubTotalAmount").val(TotalAmount);
        });
    }

    $(document).ready(function () {
        HotelOutstation_Initialize();
        HotelOutstationGetDDLInputValues();
    });
</script>