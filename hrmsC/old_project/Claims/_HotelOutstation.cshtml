            <div class="form-horizontal">
                <div class="table-toolbar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="BtnPlus btn green" title="dTable_HotelOutstation" href="javascript:HotelOutstation_addRow();">
                                    Add Row
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="BtnPlus5 btn green" title="dTable_HotelOutstation" href="javascript:HotelOutstation_add5Row();">
                                    Add 5 Rows
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="deleteall btn red" title="dTable_HotelOutstation" href="javascript:HotelOutstation_removeRow();">
                                    Delete Row
                                    <i class="fa fa-minus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var _HotelOutstationTable = $('#tblHotelOutstation').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_HotelOutstationValidation() { // HotelOutstationValidation
        var _ValidationMsg = '';

        $('#tblHotelOutstation tbody tr').not(':last').each(function () {
            var _Date = $(this).children('td:eq(1)').children('input[type=text]');
            var _Amount = $(this).children('td:eq(3)').children('input[type=text]');
            var _GSTAmount = $(this).children('td:eq(4)').children('input[type=text]');

            if (_Date.value == '')
                _ValidationMsg += 'Transportation (Hotel) - Date is required.\n';

            if (_Amount.value == '')
                _ValidationMsg += 'Transportation (Hotel) - Amount (RM) is required.\n';

            if (_GSTAmount.value == '')
                _ValidationMsg += 'Transportation (Hotel) - GST Amount (RM) is required.\n';
        });

        return _ValidationMsg;
    }

    function HotelOutstation_removeRow() {
        $.each($('input[class="HotelOutstationRemoveCheckbox"]:checked'), function (i, val) {
            var row = $(this).closest("tr").get(0);
            var id = $(this).attr("id");
            _HotelOutstationTable.fnDeleteRow(mytable.fnGetPosition(row));
        });

        reorderTable('#tblHotelOutstation');
    }

    function HotelOutstation_add5Row() {
        HotelOutstation_addRow();
        HotelOutstation_addRow();
        HotelOutstation_addRow();
        HotelOutstation_addRow();
        HotelOutstation_addRow();
    }

    function HotelOutstation_addRow() {

        var _LocationDDLOption = $('.HotelOutstationhiddenDDL').html();

        _HotelOutstationTable.fnAddData([
            '<input type="checkbox" class="HotelRemoveCheckbox" />',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy"><input type="text" class="form-control SubTypeColumn1" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" value="" onchange="HotelOutstationDateOnchange(@Model.categoryIndex,@Model.subtypeIndex,' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + ')"/><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy"><input type="text" class="form-control SubTypeColumn2" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" value="" onchange="HotelOutstationDateOnchange(@Model.categoryIndex,@Model.subtypeIndex,' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + ')"/><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" class="form-control SubTypeColumn3" maxlength="200" />',
            '<select id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn4"  name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" class = "bs-select form-control SubTypeColumn4" style="min-width:200px" >' + _LocationDDLOption + '</select>',
            '<input type="checkbox" checked="checked" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" class="SubTypeColumn5" maxlength="200" onclick="HotelOutstationCalculate()" /><label>Yes<label/>',
            '<input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" class="form-control SubTypeColumn6" maxlength="200" />',
            '<input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" class="form-control SubTypeColumn7" maxlength="200" onkeyup="HotelOutstationCalculate()"/>',
            '<input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" class="form-control SubTypeColumn8" maxlength="200" />',
            '<input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn9" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn9" class="form-control SubTypeColumn9" maxlength="200" onkeyup="HotelOutstationCalculate()"/>',
            '<input type="text" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn10" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _HotelOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn10" class="form-control SubTypeColumn10" maxlength="200" />',
