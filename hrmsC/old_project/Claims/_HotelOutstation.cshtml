@model ESS.Claim.ViewModels.ClaimsSubtype
@using TNB_ESS_MVC.Helpers
@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.HotelOutstation_ClaimsSubtypeName;
    string GSTEnabled = (ViewBag.HotelOutstation_GSTEnabled + "").ToLower();
    string Status = ViewBag.HotelOutstation_Status;
    string dtStrStart = ViewBag.HotelOutstation_StartDate;
    string dtStrEnd = ViewBag.HotelOutstation_EndDate;
    string GSTMaximumValue = ViewBag.HotelOutstation_GSTMaximumValue;
    string HotelRateHalfNoReceipt = ViewBag.HotelOutstation_HotelRateHalfNoReceipt;
    string HotelRateHalfYesReceipt =ViewBag.HotelOutstation_HotelRateHalfYesReceipt;
    string HotelRateFullNoReceipt = ViewBag.HotelOutstation_HotelRateFullNoReceipt;
    string HotelRateFullYesReceipt= ViewBag.HotelOutstation_HotelRateFullYesReceipt;
    string MaxClaimHalfYesReceipt = ViewBag.HotelOutstation_MaxClaimHalfYesReceipt;
    string MaxClaimHalfNoReceipt = ViewBag.HotelOutstation_MaxClaimHalfNoReceipt ;
    string MaxClaimFullYesReceipt =ViewBag.HotelOutstation_MaxClaimFullYesReceipt;
    string MaxClaimFullNoReceipt = ViewBag.HotelOutstation_MaxClaimFullNoReceipt ;

}

<div class="portlet box blue" id="dTable_HotelOutstation">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimsSubtypeName 
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tblHotelOutstation">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Start Date *</th>
                                <th scope="col">End Date *</th>
                                <th scope="col">No. of Days</th>
                                <th scope="col">Stay Type *</th>
                                <th scope="col">With Receipts?</th>
                                <th scope="col">Receipt No.</th>
                                <th scope="col">Hotel Rate (RM) *</th>
                                <th scope="col">Hotel Amount (RM)</th>
                                <th scope="col">Tax Amount (RM) *</th>
                                <th scope="col">Total Hotel (RM)</th>
                                <th scope="col">Total Claimable (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @{
                            List<SelectListItem> StayTypeList = new List<SelectListItem>();
                            StayTypeList.Add(new SelectListItem { Text = "- Please Select -", Value = "" });
                            StayTypeList.Add(new SelectListItem { Text = "Half Day", Value = "Half Day" });
                            StayTypeList.Add(new SelectListItem { Text = "Full Day", Value = "Full Day" });

                        }

                        @Html.DropDownList("HotelOutstationhiddenDDL", StayTypeList, new { @id = "HotelOutstationhiddenDDL", @class = "bs-select form-control hidden HotelOutstationhiddenDDL", @style = "min-width:200px" })

                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="HotelOutstationRemoveCheckbox" /></td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" style="width:150px" class="form-control SubTypeColumn1" onchange="HotelOutstationDateOnchange('@Model.categoryIndex','@Model.subtypeIndex','0')"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" style="width:150px" class="form-control SubTypeColumn2" onchange="HotelOutstationDateOnchange('@Model.categoryIndex','@Model.subtypeIndex','0')"
                                                       id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn3"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" />
                                        </td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn4", StayTypeList,
