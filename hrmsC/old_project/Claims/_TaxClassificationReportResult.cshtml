@model List<ESS.Claim.ViewModels.TaxClassificationReport>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Tax Classification List
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Year</th>
                                <th>Employee</th>
                                <th>Tax Classification Status</th>
                                <th>Total Claim Amount (RM)</th>
                                <th>Total Approved Amount (RM)</th>
                                <th>Total Taxable Amount (RM)</th>
                                <th>Total Non-Taxable Amount (RM)</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/Claims/TaxClassificationViewForm")?TaxID=@item.TaxID">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>

                                    <td>@item.Year</td>
                                    <td>@item.EmployeeCode - @item.EmployeeName</td>
                                    <td>@item.Status</td>
                                    @if (!string.IsNullOrEmpty(item.TotalClaimAmt))
                                    {
                                        <td>@String.Format("{0:0.00}", Convert.ToDecimal(item.TotalClaimAmt))</td>
                                    }
                                    else
                                    {
                                        <td>0.00</td>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TotalApproveAmt))
                                    {
                                        <td>@String.Format("{0:0.00}", Convert.ToDecimal(item.TotalApproveAmt))</td>
                                    }
                                    else
                                    {
                                        <td>0.00</td>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TotalTaxAmt))
                                    {
                                        <td>@String.Format("{0:0.00}", Convert.ToDecimal(item.TotalTaxAmt))</td>
                                    }
                                    else
                                    {
                                        <td>0.00</td>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TotalNonTaxAmt))
                                    {
                                        <td>@String.Format("{0:0.00}", Convert.ToDecimal(item.TotalNonTaxAmt))</td>
                                    }
                                    else
                                    {
                                        <td>0.00</td>
                                    }

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>