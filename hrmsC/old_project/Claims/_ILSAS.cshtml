<script>
    var AssignedDate = [];

    function dTable_ILSASValidation() {
        var ErrorMessage = "";

        AssignedDate = []
        var i = 0;
        $('#ILSASTable .ILSASRate').each(function () {
            var $row = $(this).closest("tr");

            var Name = $row.find(".Name").val();
            if (Name == "") {
                ErrorMessage += "Course Name cannot empty\n";
            }

            var strStartDate = $row.find(".StartDate").val();
            var StartDate;
            if (strStartDate == "") {
                ErrorMessage += "Start Date cannot empty\n";
            }
            else {
                StartDate = moment(strStartDate, "DD/MM/YYYY")._d;
            }

            AssignedDate[i] = StartDate;
            i++;

            var strEndDate = $row.find(".EndDate").val();
            var EndDate;
            if (strEndDate == "") {
                ErrorMessage += "End Date cannot empty\n";
            }
            else {
                EndDate = moment(strEndDate, "DD/MM/YYYY")._d;
            }
            AssignedDate[i] = EndDate;
            i++;

            var Amount = $row.find(".Amount").val();
            if (Amount == "" || Amount == "NaN") {
                ErrorMessage += "Amount cannot be Empty\n";
            }

            if (EndDate < StartDate) {
                ErrorMessage += "End Date cannot greater than StartDate\n";
            }

            if ((StartDate && EndDate) && StartDate.getMonth() != EndDate.getMonth()) {
                ErrorMessage += Name + " : Cross month selection is not allowed, please add as new row.\n";
            }
            //console.log(i + ":" + EndDate);
        });

        if (ErrorMessage != "") {
            ErrorMessage = "ILSAS Teaching Claim\n" + ErrorMessage;
            return ErrorMessage;
        }


        //console.log(AssignedDate);
        if (multipleDateRangeOverlaps()) { ErrorMessage += "Duplicated Date detected" }
        return ErrorMessage;
    }


    function dateRangeOverlaps(a_start, a_end, b_start, b_end) {
        //console.log(a_start + ":" + a_end + ":" + b_start + ":" + b_end);
        if (a_start <= b_start && b_start <= a_end) { return true; } // b starts in a
        if (a_start <= b_end && b_end <= a_end) { return true; } // b ends in a
        if (b_start < a_start && a_end < b_end) { return true; } // a in b
        return false;
    }

    function multipleDateRangeOverlaps() {
        var i, j;

        if (AssignedDate.length % 2 !== 0)
            throw new TypeError('AssignedDate length must be a multiple of 2');
        for (i = 0; i < AssignedDate.length - 2; i += 2) {
            for (j = i + 2; j < AssignedDate.length; j += 2) {

                if (
                    dateRangeOverlaps(
                        AssignedDate[i], AssignedDate[i + 1],
                        AssignedDate[j], AssignedDate[j + 1]
                    )
                ) return true;
            }
        }
        return false;
    }

    var ILSASTable = $('#ILSASTable').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function addILSASRow() {

        ILSASTable.fnAddData([
            '<input type="checkbox" class="ILSASRemoveCheckbox" /><input name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + ILSASTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn0" class="ChargeCode" type="hidden" value="@ViewBag.ChargeCode">',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + ILSASTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" class="form-control" style="width:250px" />',
            '<select name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + ILSASTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" class="form-control ILSASRate" style="width:250px" onchange="CalculateILSASAmount()"></select>',
            '<div class="input-group date date-picker"><input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + ILSASTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" class="form-control StartDate" style="width:150px" onchange="CalculateILSASAmount()"/><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
