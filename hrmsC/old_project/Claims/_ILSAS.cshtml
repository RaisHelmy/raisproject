    function newExceedLimit(done) {
        $('#ILSASCAP').hide();
        $('#ILSASExceed').val(false);

        var monthNames = ["January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];
        var FormStatus = '@Status';
        var capTable;
        var exceedTable = {};

        $.ajax({
            url: '../Claims/ILSASCheckCap',
            type: 'POST',
            data: { EmployeeID: $("[name='Submiter.ID']").val() },
            success: function (result) {
                capTable = result;

                var thisTable = $('#ILSASTable');
                var NR = 0;
                var SR = 0;
                var isExceedLimit = false;
                var message = "";

                $('#ILSASCAP .exceedDetail').html('Details:');
                thisTable.find(".ILSASRate").each(function () {
                    var $row = $(this).closest("tr");
                    var thisDate = moment($row.find('.StartDate').val(), "DD/MM/YYYY")._d;
                    var Rate = $row.find(".ILSASRate").val();
                    var Hour = $row.find(".Hour");
                    var SubmitAmount = $row.find(".HiddenAmount").val();

                    console.log(capTable);

                    var found = 0;
                    for (var i in capTable) {
                        if (capTable[i].Month == (thisDate.getMonth() + 1) && capTable[i].Year == thisDate.getFullYear()) {
                            found = 1;

                            console.log('Found');
                            console.log(capTable[i]);

                            // Month for this row is in captable
                            if (exceedTable[thisDate.getMonth()] == undefined) {
                                exceedTable[thisDate.getMonth()] = {
                                    NR: capTable[i].NR,
                                    SR: capTable[i].SR,
                                    Year: thisDate.getFullYear()
                                };
                            }

                            if (FormStatus == "Draft" || FormStatus == "Withdrawn" || FormStatus == "Declined") {
                                console.log("RATE: " + Rate + " NR = " + NR + " SR = " + SR);
                                switch (Rate) {
                                    case "Full Day":
                                        exceedTable[thisDate.getMonth()].NR += parseFloat(SubmitAmount);
                                        break;
                                    case "Half Day AM":
                                        exceedTable[thisDate.getMonth()].NR += parseFloat(SubmitAmount);
                                        break;
                                    case "Half Day PM":
                                        exceedTable[thisDate.getMonth()].NR += parseFloat(SubmitAmount);
                                        break;
                                    case "By Hour":
                                        exceedTable[thisDate.getMonth()].NR += parseFloat(SubmitAmount);
                                        break;
                                    case "Hour":
                                        exceedTable[thisDate.getMonth()].SR += parseFloat(Hour.val());
                                        break;
                                    default:
                                        break;
                                }
                            }

                            console.log(exceedTable);

                            break;
                        }
                    }

                    if (found == 0) {

                        // Month for this row isn't in captable
                        if (exceedTable[thisDate.getMonth()] == undefined) {
                            exceedTable[thisDate.getMonth()] = {
                                NR: 0,
                                SR: 0,
                                Year: thisDate.getFullYear()
                            };
                        }

                        switch (Rate) {
                            case "Full Day":
                                exceedTable[thisDate.getMonth()].NR += parseFloat(SubmitAmount);
                                break;
                            case "Half Day AM":
                                exceedTable[thisDate.getMonth()].NR += parseFloat(SubmitAmount);
                                break;
                            case "Half Day PM":
                                exceedTable[thisDate.getMonth()].NR += parseFloat(SubmitAmount);
                                break;
                            case "By Hour":
                                exceedTable[thisDate.getMonth()].NR += parseFloat(SubmitAmount);
                                break;
                            case "Hour":
                                exceedTable[thisDate.getMonth()].SR += parseFloat(Hour.val());
                                break;
                            default:
                                break;
                        }
                    }
                });

                for (var month in exceedTable) {
                    if (exceedTable[month].NR > 1000 || exceedTable[month].SR > 30) {
                        $('#ILSASExceed').val(true);
                        isExceedLimit = true;
                        $('#ILSASCAP .exceedDetail').append('<br/>' + exceedTable[month].Year + " " + monthNames[month] + " Exceed Limit");
                        $('#ILSASCAP').show();
                    }
                    else if (exceedTable[month].SR > 0) {
                        $('#ILSASExceed').val(true);
                    }

                    if ($('#ILSASCAP:visible').length) {
                        alert('ILSAS claim exceed capping limit.');
                    }
                }

                    done(isExceedLimit, message);
            }
        });
    }

    function isExceed() {
        var thisTable = $('#ILSASTable');
        var NR = 0;
        var SR = 0;
        thisTable.find(".ILSASRate").each(function () {

            var $row = $(this).closest("tr");
            var Rate = $row.find(".ILSASRate").val();
            var Hour = $row.find(".Hour");
            var SubmitAmount = $row.find(".HiddenAmount").val();

            switch (Rate) {
                case "Full Day":
                    NR += parseFloat(SubmitAmount);
                    break;
                case "Half Day AM":
                    NR += parseFloat(SubmitAmount);
                    break;
                case "Half Day PM":
                    NR += parseFloat(SubmitAmount);
                    break;
                case "By Hour":
                    NR += parseFloat(SubmitAmount);
                    break;
                case "Hour":
                    SR += Hour.val();
                    break;
                default:
                    break;
            }
        })

        //console.log("NR = " + NR + " SR = " + SR);
        if (NR > 1000 || SR > 30) {

            $('#ILSASCAP').show();
            $('#ILSASExceed').val(true);
            return true;
        }
        else if (SR > 0) {

            $('#ILSASCAP').hide();
            $('#ILSASExceed').val(true);
            return true;
        }
        else {

            $('#ILSASCAP').hide();
            $('#ILSASExceed').val(false);
            return false;
        }
    }

    function CalculateILSASAmount() {
        var NR = 0;
        var SR = 0;
        var grandTotal = 0;
        var thisTable = $('#ILSASTable');

        thisTable.find(".ILSASRate").each(function () {

            var $row = $(this).closest("tr");
            var Rate = $row.find(".ILSASRate").val();
            var StartDate = $row.find(".StartDate");
            var StartTime = $row.find(".StartTime");
            var EndDate = $row.find(".EndDate");
            var EndTime = $row.find(".EndTime");
            var Hour = $row.find(".Hour");
            var Hidden = $row.find(".HiddenAmount");
            var amount = 0;

            //var d = new Date();
            //var curr_date = d.getDate();
            //var curr_month = d.getMonth();
            //var curr_year = d.getFullYear();

            //if (StartDate.val() == "") {
            //StartDate.val(("0" + curr_date).slice(-2) + "/" + ("0" + curr_month).slice(-2) + "/" + curr_year);
            //}

            if (StartDate.val() != "" && EndDate.val() == "") {
                EndDate.val(StartDate.val());
            }

            if (StartDate.val() == "" && EndDate.val() != "") {
                StartDate.val(EndDate.val());
            }                       

            //var sstLastDay = moment("31/08/2018", "DD/MM/YYYY");
            //var sstThreshold = moment("01/09/2018", "DD/MM/YYYY");
            //var SStartDate = moment(StartDate.val(), "DD/MM/YYYY");
            //var EEndDate = moment(EndDate.val(), "DD/MM/YYYY");

            //if (SStartDate.isSame(sstThreshold) || SStartDate.isAfter(sstThreshold)) {
            //    $(EndDate.parent()).datepicker("setStartDate", "01/09/2018");

            //    if (EEndDate.isBefore(sstThreshold)) {
            //        $(EndDate.parent()).datepicker("setDate", "01/09/2018");
            //    }
            //}
            //else if (SStartDate.isBefore(sstThreshold)) {
            //    $(EndDate.parent()).datepicker("setEndDate", "31/08/2018");

            //    if (EEndDate.isAfter(sstLastDay)) {
            //        $(EndDate.parent()).datepicker("setDate", "31/08/2018");
            //    }
            //}

            if (StartDate.val() != '' && EndDate.val() != '') {

                var SDate = moment(StartDate.val(), "DD/MM/YYYY")._d;
                var EDate = moment(EndDate.val(), "DD/MM/YYYY")._d;

                if (SDate > EDate) {
                    EndDate.val(StartDate.val());
                    //alert('Start Date cannot bigger than End Date!');
                }

                var diff = Math.ceil((EDate - SDate) / (1000 * 60 * 60 * 24)) + 1;

                switch (Rate) {
                    case "Full Day":
                        amount = diff * 200;
                        NR += amount;
                        Hour.val("6");
                        Hour.attr("readonly", "readonly");
                        StartTime.val("0830");
                        EndTime.val("1700");
                        StartTime.attr("readonly", "readonly");
                        EndTime.attr("readonly", "readonly");
                        EndDate.removeAttr("readonly");
                        break;
                    case "Half Day AM":
                        amount = diff * 116.67;
                        NR += amount;
                        Hour.val("3.5");
                        Hour.attr("readonly", "readonly");
                        StartTime.val("0830");
                        EndTime.val("1230");
                        StartTime.attr("readonly", "readonly");
                        EndTime.attr("readonly", "readonly");
                        EndDate.removeAttr("readonly");
                        break;
                    case "Half Day PM":
                        amount = diff * 83.33
                        NR += amount;
                        Hour.val("2.5");
                        Hour.attr("readonly", "readonly");
                        StartTime.attr("readonly", "readonly");
                        EndTime.attr("readonly", "readonly");
                        StartTime.val("1500");
                        EndTime.val("1730");
                        EndDate.removeAttr("readonly");
                        break;
                    case "By Hour":
                        amount = diff * 33.33 * Hour.val();
                        if (amount > 200)
                            amount = 200;
                        NR += amount;
                        Hour.removeAttr("readonly");
                        StartTime.removeAttr("readonly");
                        EndTime.removeAttr("readonly");
                        EndDate.val(StartDate.val());
                        EndDate.attr("readonly", "readonly");
                        break;
                    case "Hour":
                        amount = diff * 100 * Hour.val();
                        if (amount > 800)
                            amount = 800;
                        SR += Hour.val();
                        Hour.removeAttr("readonly");
                        StartTime.removeAttr("readonly");
                        EndTime.removeAttr("readonly");
                        EndDate.val(StartDate.val());
                        EndDate.attr("readonly", "readonly");
                        break;
                    default:
                        amount = 0;
                }

                if (amount < 0) {
                    amount = 0;
                }
                $row.find(".Amount").val(amount.toFixed(2));
                $row.find(".HiddenAmount").val(amount.toFixed(2));
                grandTotal += amount;
            }

        });

        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));

        var ilsasCC = $("#ChargeCodeList").val().split(",")[0];
        $("#dTable_ILSAS .ChargeCode").val(ilsasCC);

        CalculateSummary();
    }


