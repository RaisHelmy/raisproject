    function ValidateApprovedAmount(x) {
        var TAmount = $(x);

        if (TAmount.val() != undefined) {
            var myNumeric = parseFloat(TAmount.val().replace(/,/g, ''));
            if (!myNumeric) {
                TAmount.val('0.00');
            }
            else {
                TAmount.val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }
    }

