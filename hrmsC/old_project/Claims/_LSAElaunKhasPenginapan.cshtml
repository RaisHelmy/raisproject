@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimType = Model.ClaimSubTypeCategory;
    string ClaimsSubtypeName = ViewBag.LSAElaunKhasPenginapan_ClaimsSubtypeName;
    string GSTEnabled = (ViewBag.LSAElaunKhasPenginapan_GSTEnabled + "").ToLower();
    string Status = ViewBag.LSAElaunKhasPenginapan_Status;
    string dtStrStart = ViewBag.LSAElaunKhasPenginapan_StartDate;
    string dtStrEnd = ViewBag.LSAElaunKhasPenginapan_EndDate;
    string rate = ViewBag.LSAElaunKhasPenginapan_Rate;
    string Amount = ViewBag.LSAElaunKhasPenginapan_Amount;
    string GSTAmount = ViewBag.LSAElaunKhasPenginapan_GSTAmount;
    string TotalAmount = ViewBag.LSAElaunKhasPenginapan_TotalAmount;

}

<div class="portlet box blue subtypeportlet" id="dTable_LSAElaunKhasPenginapan">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimType - @ClaimsSubtypeName
        </div>
        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')"><img style=" vertical-align: initial;" src="../Assets/img/portlet-remove-icon-white.png" /></a>
            </div>

        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tblLSAElaunKhasPenginapan">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Charge Code *</th>
                                <th scope="col">Rate</th>
                                <th scope="col">Amount (RM) *</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="LSAElaunKhasPenginapanRemoveCheckbox" /></td>
                                        <td>
                                            <input type="hidden" class="hfChargeCode" />
                                            <select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td><input type="text" style="min-width:200px" class="form-control SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" /></td>
                                        <td><input type="text" style="min-width:130px" class="form-control text-right Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" /></td>
                                        <td><input type="text" style="min-width:130px" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" readonly /></td>
                                        <td><input type="text" style="min-width:130px" class="form-control text-right TotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" id="txtTotalAmount" readonly /></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="LSAElaunKhasPenginapanRemoveCheckbox" /></td>
                                            <td>
                                                <input type="hidden" class="hfChargeCode" value="@thisDetail.SubTypeColumn0" />
                                                <select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0"
                                                        onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input type="text" style="min-width:200px" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1" />
                                            </td>
                                            
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control text-right Amount" value="@thisDetail.Amount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" onkeypress="NumberOnly(event);" onkeyup="LSAElaunKhasPenginapan_CalculateSum();" />
                                            </td>
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount" id="txtGSTAmount" readonly />
                                            </td>
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control text-right TotalAmount" value="@thisDetail.TotalAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" id="txtTotalAmount" readonly />
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.GSTAmount) ? 0.00 : Convert.ToDouble(m.GSTAmount))))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.TotalAmount) ? 0.00 : Convert.ToDouble(m.TotalAmount))))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                    <tr>
                                        <td></td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn0" value="@thisDetail.SubTypeColumn0" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:200px" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right Amount" value="@thisDetail.Amount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right TotalAmount" value="@thisDetail.TotalAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" />
                                        </td>
                                    </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.GSTAmount) ? 0.00 : Convert.ToDouble(m.GSTAmount))))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.TotalAmount) ? 0.00 : Convert.ToDouble(m.TotalAmount))))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
            {
                <div class="form-horizontal hidden">
                    <div class="table-toolbar">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="btn-group">
                                    <a class="BtnPlus btn green" title="dTable_LSAElaunKhasPenginapan" href="javascript:LSAElaunKhasPenginapan_addRow();">
                                        Add Row
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                                <div class="btn-group">
                                    <a class="BtnPlus5 btn green" title="dTable_LSAElaunKhasPenginapan" href="javascript:LSAElaunKhasPenginapan_add5Row();">
                                        Add 5 Rows
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                                <div class="btn-group">
                                    <a class="deleteall btn red" title="dTable_LSAElaunKhasPenginapan" href="javascript:LSAElaunKhasPenginapan_removeRow();">
                                        Delete Row
                                        <i class="fa fa-minus"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
<script type="text/javascript">
    var _LSAElaunKhasPenginapanTable = $('#tblLSAElaunKhasPenginapan').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_LSAElaunKhasPenginapanValidation() { // LSAElaunKhasPenginapanValidation
        var _ValidationMsg = '';

        var thisTable = $('#tblLSAElaunKhasPenginapan');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n'
            }
        });

        return _ValidationMsg;
    }

    function LSAElaunKhasPenginapan_removeRow() {
        $.each($('input[class="LSAElaunKhasPenginapanRemoveCheckbox"]:checked'), function (i, val) {
            var row = $(this).closest("tr").get(0);
            var id = $(this).attr("id");
            _LSAElaunKhasPenginapanTable.fnDeleteRow(mytable.fnGetPosition(row));
        });

        reorderTable('#tblLSAElaunKhasPenginapan');
    }

    function LSAElaunKhasPenginapan_add5Row() {
        LSAElaunKhasPenginapan_addRow();
        LSAElaunKhasPenginapan_addRow();
        LSAElaunKhasPenginapan_addRow();
        LSAElaunKhasPenginapan_addRow();
        LSAElaunKhasPenginapan_addRow();
    }

    function LSAElaunKhasPenginapan_addRow() {
        _LSAElaunKhasPenginapanTable.fnAddData([
            '<input type="checkbox" class="DayTripRemoveCheckbox" />',
            '<input type="hidden" class="hfChargeCode" /><select class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LSAElaunKhasPenginapanTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn0" onchange="ChargeCodeChange(this);"><option value="">Select One</option></select>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy"><input type="text" class="form-control startdate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LSAElaunKhasPenginapanTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" value="" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LSAElaunKhasPenginapanTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LSAElaunKhasPenginapanTable.fnSettings().fnRecordsTotal() + '].Amount" value="" class="form-control text-right Amount" onkeypress="NumberOnly(event);" onkeyup="LSAElaunKhasPenginapan_CalculateSum();" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LSAElaunKhasPenginapanTable.fnSettings().fnRecordsTotal() + '].GSTAmount" value="" class="form-control text-right GSTAmount" readonly />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _LSAElaunKhasPenginapanTable.fnSettings().fnRecordsTotal() + '].TotalAmount" value="" class="form-control text-right TotalAmount" readonly />'
        ]);

        LSAElaunKhasPenginapan_Initialize();
    }

    function LSAElaunKhasPenginapan_Initialize() {
        $('#tblLSAElaunKhasPenginapan .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tblLSAElaunKhasPenginapan .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tblLSAElaunKhasPenginapan .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tblLSAElaunKhasPenginapan tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(4)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }
        else {
            $('#tblLSAElaunKhasPenginapan tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(4)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('@GSTAmount');
            });
        }


        $('#tblLSAElaunKhasPenginapan tbody tr').each(function () {
            var _rate = $(this).children('td:eq(2)').children('input[type=text]');

            _rate.prop('readonly', true);
            _rate.val('@rate');

            var _Amount = $(this).children('td:eq(3)').children('input[type=text]');

            _Amount.prop('readonly', true);
            _Amount.val('@Amount');

            var _TotalAmount = $(this).children('td:eq(5)').children('input[type=text]');

            _TotalAmount.prop('readonly', true);
            _TotalAmount.val('@TotalAmount');
        });

        BindtoDDL();
    }


    function LSAElaunKhasPenginapanCalculateSubtotal() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tblLSAElaunKhasPenginapan');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".TotalAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandTotal + (_TotalAmount * 1);
            }
        });
        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
    }

    function LSAElaunKhasPenginapanGetDDLListInputValues() {
        $('#tblLSAElaunKhasPenginapan tbody tr').each(function () {
            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());
        });
    }

    $(document).ready(function () {
        LSAElaunKhasPenginapan_Initialize();
        LSAElaunKhasPenginapanCalculateSubtotal();
        CalculateSummary();
        LSAElaunKhasPenginapanGetDDLListInputValues();
    });
</script>