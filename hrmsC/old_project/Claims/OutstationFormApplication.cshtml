@model ESS.Core.EmployeeDetailsSummary

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Outstation Form Application";
    DateTime d1 = DateTime.Now.AddDays(-Convert.ToInt32(ViewBag.StartLeadTime));
    DateTime d2 = DateTime.Now.AddDays(Convert.ToInt32(ViewBag.EndLeadTime));
    string dtStrStart = d1.ToString("dd MM yyyy");
    string dtStrEnd = d2.ToString("dd MM yyyy");
}

<input id="hfEmployeeID" type="hidden" value="@ViewBag.EmployeeID" />
<style type="text/css">
    .hidden_1 {
        display: none;
    }

    .checkbox-grid li {
        display: block;
        float: left;
        width: 50%;
    }
</style>

<style>
    .mode-of-transport-grid {
        columns: 2;
        -webkit-columns: 2;
        -moz-columns: 2;
        list-style: none;
    }
</style>

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Outstation Form Application
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
@if (!@ViewBag.CanSubmit)
{
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    Sorry, You are not allowed to submit this application.
                    Immediate Manager not found, please contact administrator for assistance.
                </h4>
            </div>
        </div>
    </div>
}
<div id="tab_1" class="tab-pane active">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Requestor Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee Number</label>
                                        <div class="col-md-8 form-control-static">
                                            <a id="ct00_EmployeeCode" href="#"
                                               onclick="window.open('@Url.Action("Index","Employee", new { EmployeeID = Model.ID })');">
                                                @Model.EmployeeCode
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Company</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Company">@Model.CompanyCode - @Model.Company</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee Name</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_EmployeeName">@Model.EmployeeName</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Department</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Department">@Model.Department</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Position</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Position">@Model.Position</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Unit/Section</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_UnitSection">@Model.UnitSection</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Immediate Manager</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_ImmediateManager">@Model.ImmediateManager</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Current Approver</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_CurrentApprover"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Traveling Particulars
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct01_CustomFieldFormView">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Reference No.</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="ct_ReferenceNo" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Status</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="ct_Status" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Travel Start Date<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control" id="ct_StartDate" name="ct_StartDate" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Travel End Date<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control" id="ct_EndDate" name="ct_EndDate" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Travel Start Time<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control timeinput" id="ct_StartTime" name="ct_StartTime" placeholder="HH:MM (e.g 12:30)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Travel End Time<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="text" class="form-control timeinput" id="ct_EndTime" name="ct_EndTime" placeholder="HH:MM (e.g 12:30)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Purpose & Destination of Travel<span class="mandatory"> *</span></label>
                                        <div class="col-md-10 form-control-static">
                                            <textarea class="form-control" id="ct_Remarks" rows="6" style="width:100%;"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Mode of Transport<span class="mandatory"> *</span></label>
                                        <div class="col-md-10 form-control-static" id="Popover-Content">
                                            <ul class="mode-of-transport-grid" id="ModeOfTransport" style="padding:0;margin-bottom:0!important;"></ul>
                                            <input type="hidden" id="ct_Mode" name="ct_Mode" />
                                        </div>
                                        <div class="col-md-2"></div>
                                        <div class="col-md-10 form-control-static">
                                            <ul class="mode-of-transport-grid" id="DisableModeOfTransport" style="padding:0;"></ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="hidden">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Claimable Mileage Limit (KM)</label>
                                            <div class="col-md-4 form-control-static">
                                                <input type="number" min="0" id="ct_MileageLimit" name="ct_MileageLimit" value="99999" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "New", SourceType = "OutstationForm" })
</div>
<div class="row">
    <div class="col-md-12">
        <input type="button" class="btn green" value="Save As Draft" id="btnSave" onclick="ConfirmAction('SaveAsDraft');" />
        @if (!@ViewBag.CanSubmit)
        {
            <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="FormValidation();" disabled />
        }
        else
        {
            <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="FormValidation();" />
        }
        <input type="button" class="btn green" value="Back" id="btnBack" onclick="window.history.back()" />
    </div>
</div>
<!-- Success Message -->
<div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well">
                    Your Outstation Form Application has been successfully submitted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <button type="submit" class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Confirmation Message -->
<div class="modal fade" id="ConfirmUpdate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Confirmation</h4>
            </div>
            <div class="modal-body">
                <div class="well">
                    Are you sure you want to Submit this Outstation Form application?\n\rPress Confirm to proceed, or Close to stay on the current page.
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn default blue" id="btnSubmitForm" value="Submit" onclick="javascript: SaveForm(this, 'Pending');">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="submit" class="btn default blue" id="btnSubmitSave" value="Draft" onclick="javascript: SaveForm(this, 'Draft');">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
    </p>
</div>
<!-- Scripts -->
<script type="text/javascript">
    var _Path = '/_layouts/15/TNBESS';

    function FormValidation() {
        var _StartDate = document.getElementById('ct_StartDate');
        var _EndDate = document.getElementById('ct_EndDate');
        var _StartTime = document.getElementById('ct_StartTime');
        var _EndTime = document.getElementById('ct_EndTime');
        var _ModeOfTransport = document.getElementById('ct_Mode');
        var _CompanyVehicle = $('#DisableModeOfTransport input').prop('checked');
        var _ct_Remarks = document.getElementById('ct_Remarks');

        var _ValidationMsg = '';

        if (_StartDate.value == '')
            _ValidationMsg += '- Start Date field is required.\n';

        if (_EndDate.value == '')
            _ValidationMsg += '- End Date field is required.\n';

        if (_StartTime.value == '')
            _ValidationMsg += '- Start Time field is required.\n';

        if (_EndTime.value == '')
            _ValidationMsg += '- End Time field is required.\n';

        if (_ct_Remarks.value == '')
            _ValidationMsg += '- Purpose & Destination of Travel field is required.\n';

        if (_ModeOfTransport.value == '' && _CompanyVehicle != true)
            _ValidationMsg += '- Mode of Transport field is required.\n';

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            var _StartParts = _StartDate.value.split('/');
            var _Start = new Date(_StartParts[2], _StartParts[1] - 1, _StartParts[0]);
            var _EndParts = _EndDate.value.split('/');
            var _End = new Date(_EndParts[2], _EndParts[1] - 1, _EndParts[0]);

            if (_Start > _End) {
                _ValidationMsg += '- Start Date cannot be greater than End Date.';
            }

            if (_ValidationMsg != null && _ValidationMsg != '') {
                alert(_ValidationMsg);
            }
            else {
                ConfirmAction('Submit');
            }
        }
    }

    function SaveForm(x, _Status) {
        x.disabled = true;

        if (_Status == 'Draft') {
            $(".Success-body .well").html('Your Outstation Form Application has been successfully saved.');
        }
        else {
            $(".Success-body .well").html('Your Outstation Form Application has been successfully submitted.');
        }

        jQuery.support.cors = true;

        var form = {
            EmployeeID: document.getElementById('hfEmployeeID').value,
            ReferenceNo: document.getElementById('ct_ReferenceNo').value,
            Status: _Status,
            CurrentStatus: "Draft",
            StartDate: document.getElementById('ct_StartDate').value,
            EndDate: document.getElementById('ct_EndDate').value,
            StartTime: document.getElementById('ct_StartTime').value,
            EndTime: document.getElementById('ct_EndTime').value,
            ModeOfTransport: document.getElementById('ct_Mode').value,
            Remarks: document.getElementById('ct_Remarks').value,
            MileageLimit: document.getElementById('ct_MileageLimit').value
        };

        $("#divLoading").show();

        $.ajax({
            url: '@Url.Content("~/Claims/SaveOutstationForm")',
            type: 'POST',
            cache: false,
            async: false,
            dataType: "json",
            data: form,
            success: function (result) {
                if (result.Success) {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    $("#SuccessSubmit").modal();
                } else {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    alert(result.ErrorMsg);
                    x.disabled = false;
                }
            },
            error: function (x, y, z) {
                $("#ConfirmUpdate").modal('toggle');
                $("#divLoading").hide();
                console.log(x + '\n' + y + '\n' + z);
                x.disabled = false;
            }
        });
    }

    function ConfirmAction(_Action) {
        if (_Action == 'SaveAsDraft') {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').removeClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Save this Outstation Form Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Draft'); });
            $('#ConfirmUpdate').modal('show');
        }
        else if (_Action == 'Submit') {
            $('#btnSubmitForm').removeClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Submit this Outstation Form Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Submit'); });
            $('#ConfirmUpdate').modal('show');
            $('#ConfirmSubmit').modal();
            if ($('#tblAttachment .dataTables_empty').length == 1) {
                alert("Submit this claim without attachment?");
            }
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "Draft":
            case "Submit":
                window.location.href = '@Url.Content("~/Claims/OutstationFormHistory")';
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }

    function GetModeOfTransport() {
        var Url = '@Url.Content("~/Claims/GetModeOfTransport")';

        var ddlTarget = '#ModeOfTransport';
        var ddlTarget_CV = '#DisableModeOfTransport';
        //$.ajaxSetup({ cache: false });
        //$.getJSON(Url, function (data) {
        //    $(ddlTarget).empty();
        //    $.each(data, function (index, optionData) {
        //        $(ddlTarget).append("<li><input type='checkbox' value='" + optionData.Value + "' onchange='MultiSelect_OnChange();'><span  rel='popover' data-content='" + optionData.Text + "'  data-toggle='popover' data-trigger='hover'>" + optionData.Text + "</span></li>");
        //    });

        //    $(ddlTarget_CV).append("<li><input type='checkbox' value='' onchange='DisableMultiSelect_OnChange();'>  Company Vehicle / Car Pool  </li>");
        //});


          $.get('@Url.Action("GetModeOfTransportWithAdditionalInfo", "Claims")', function (result) {
              $(ddlTarget).empty();

            for (i = 0; i < result.length; i++) {
             $(ddlTarget).append("<li><input type='checkbox' value='" + result[i].TextValue + "' onchange='MultiSelect_OnChange();'><span  rel='popover' data-content='" + result[i].AdditionalInfo + "'  data-toggle='popover' data-trigger='hover'>  " + result[i].TextValue + "</span></li>");
            }

                 $(ddlTarget_CV).append("<li><input type='checkbox' value='' onchange='DisableMultiSelect_OnChange();'>  Company Vehicle / Car Pool  </li>");
        });
    }

    function MultiSelect_OnChange() {
        var _Mode = $('#ct_Mode');
        _Mode.val('');

        $('#ModeOfTransport input:checked').each(function () {
            if (_Mode.val() == '') {
                _Mode.val($(this).attr('value'));
            }
            else {
                var _temp = _Mode.val();
                _temp += ',' + $(this).attr('value');
                _Mode.val('');
                _Mode.val(_temp);
            }
        });
    }

    function DisableMultiSelect_OnChange() {
        var _currentState;
        $('#ModeOfTransport input').each(function () {
            _currentState = $(this).is('[disabled=disabled]');
            if (_currentState == true)
            {
                $(this).removeAttr('disabled');
            } else
            {
                $(this).attr('disabled', 'disabled');
                $(this).prop('checked', false);
                $('#ct_Mode').val('');
            }
        });
    }

    $(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('.date-picker').datepicker('setStartDate', '@dtStrStart');
        $('.date-picker').datepicker('setEndDate', '@dtStrEnd');

        $('.timepicker-24').timepicker({
            autoclose: true,
            minuteStep: 5,
            showSeconds: false,
            showMeridian: false,
            defaultTime: 0000
        });

        $('.timeinput').inputmask("mask", {
            "mask": "99:99"
        });

        GetModeOfTransport();

    //$('[data-toggle="popover"]').popover({ trigger: "hover" });;

    //            $('[data-toggle="popover"]').popover({
    //            title: 'dynamic data',
    //            html: true,
    //            placement: 'right'
    //        });
    });


    var popOverSettings = {
    placement: 'right',
        container: 'body',
    trigger:'hover',
    html: true,
    selector: '[rel="popover"]'//,
    //content: function () {
    //    return 'here is the text'; //$('#Popover-Content').html();
    //}
}

$('body').popover(popOverSettings);


</script>

@*@Html.Partial("__ClaimCommonScript")*@