@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.TransferAllowance_ClaimsSubtypeName;
    string dtStrStart = ViewBag.TransferAllowance_StartDate;
    string dtStrEnd = ViewBag.TransferAllowance_EndDate;
    string Status = ViewBag.TransferAllowance_Status;
    string GSTEnabled = (ViewBag.TransferAllowance_GSTEnabled + "").ToLower();
    string GSTMaxValue = ViewBag.TransferAllowance_GSTMaxValue;
    decimal LumpSumPayment = ViewBag.TransferAllowance_LumpSumPayment;
    decimal VariableExpenseTransport = ViewBag.TransferAllowance_VariableExpenseTransport;
    decimal VariableExpenseTravelling = ViewBag.TransferAllowance_VariableExpenseTravelling;
    decimal VariableExpenseMiscellaneous = ViewBag.TransferAllowance_VariableExpenseMiscellaneous;
    string HyperLinkTextInfo = ViewBag.TransferAllowance_TextInfo;
    bool Popup = Model.SubTypeDetails == null ? true : false;
    string TransferAllowance_Outstation_Single_LumpSum = ViewBag.TransferAllowance_Outstation_Single_LumpSum;
    string TransferAllowance_Outstation_WithFamily_LumpSum = ViewBag.TransferAllowance_Outstation_WithFamily_LumpSum;
    string TransferAllowance_WithinStation_Single_LumpSum = ViewBag.TransferAllowance_WithinStation_Single_LumpSum;
    string TransferAllowance_WithinStation_WithFamily_LumpSum = ViewBag.TransferAllowance_WithinStation_WithFamily_LumpSum;

    string TransferAllowance_Single_Rate = ViewBag.TransferAllowance_Single_Rate;
    string TransferAllowance_WithFamily_Rate = ViewBag.TransferAllowance_WithFamily_Rate;
    string TransferAllowance_WithFamily_Addition = ViewBag.TransferAllowance_WithFamily_Addition;

    string TransferAllowance_Single_MiscellaneousRate = ViewBag.TransferAllowance_Single_MiscellaneousRate;
    string TransferAllowance_WithFamily_MiscellaneousRate = ViewBag.TransferAllowance_WithFamily_MiscellaneousRate;

    string TransferAllowance_ValueX = ViewBag.TransferAllowance_ValueX;
    string TransferAllowance_ValueY = ViewBag.TransferAllowance_ValueY;

    double SingleMultiplier1 = ViewBag.TransferAllowance_SingleMultiplier1;
    double FamilyMultiplier1 = ViewBag.TransferAllowance_FamilyMultiplier1;
    double FamilyMultiplier2 = ViewBag.TransferAllowance_FamilyMultiplier2;
    double SingleAddition1 = ViewBag.TransferAllowance_SingleAddition1;
    double FamilyAddition1 = ViewBag.TransferAllowance_FamilyAddition1;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
}

<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@Model.ClaimSubTypeCategory - @Model.ClaimsSubtypeName
        </div>
        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')">
                    <img style=" vertical-align initial;" src="../Assets/img/portlet-remove-icon-white.png" />
                </a>
            </div>
        }
