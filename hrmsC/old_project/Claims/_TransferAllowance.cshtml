</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_@(DataTableID)Validation() {
        var _ValidationMsg = '';

        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");

            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            var _TransferDate = $row.find(".SubTypeColumn1").val();
            var _TransferType = $row.find(".SubTypeColumn2").val();
            var _TransferLocation = $row.find(".SubTypeColumn3").val();
            var _Distance = $row.find(".SubTypeColumn4").val();
            var _Amount = $row.find(".Amount").val();
            var _ValueX = @TransferAllowance_ValueX;

            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n'
            }

            if (_TransferDate == null || _TransferDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Transfer Date) is required.\n'
            }

            if (_TransferType == null || _TransferType == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Transfer Type) is required.\n'
            }

            if (_TransferLocation == null || _TransferLocation == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Transfer Location) is required.\n'
            }

            if (_Amount == null || _Amount == '0' || _Amount == '' || _Amount == '0.00') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is required.\n'
            }

            if (_Amount == 'Infinity') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is invalid.\n'
            }

            if (_Distance == null || _Distance == '0' || _Distance == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Distance) is required.\n'
            }

            if (_Distance == 'Infinity') {
                _ValidationMsg += '- @ClaimsSubtypeName (Distance) is invalid.\n'
            }
            if (_TransferLocation == 'Outstation' && _Distance < _ValueX ){
                _ValidationMsg += '- @ClaimsSubtypeName (Distance) is Over Limit.\n'
            }
            else if(_TransferLocation == 'Within Station' && _Distance > _ValueX ){
                _ValidationMsg += '- @ClaimsSubtypeName (Distance) is Lack Of Limit.\n'
            }

            var _GSTAmount = $row.find(".GSTAmount").val();
            var gstAmt = 0;
            if ('@GSTEnabled' != 'false') {
                if (_GSTAmount == null || _GSTAmount == '') {
                    _ValidationMsg += '- @ClaimsSubtypeName (GST Amount) is required.\n'
                }

                var gstMaxValue = '@GSTMaxValue';
                gstAmt = parseFloat(_Amount) * (parseFloat(gstMaxValue) / 100);
                if ((parseFloat(_GSTAmount) || 0) > (parseFloat(gstAmt.toFixed(2)) || 0)) {
                    _ValidationMsg += '- @ClaimsSubtypeName - The GST Amount (highlighted in yellow) has exceeded the maximum value.Please edit or delete the record to proceed.\n'
                    $row.find(".GSTAmount").css("background-color", "yellow");
                }
                else {
                    $row.find(".GSTAmount").css("background-color", "white");
                }
            }
        });

        return _ValidationMsg;
    }

