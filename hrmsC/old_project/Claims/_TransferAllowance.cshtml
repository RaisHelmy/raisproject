                                <th scope="col">Transfer Type *</th>
                                <th scope="col">Transfer Location *</th>
                                <th scope="col">Distance (KM) *</th>
                                <th scope="col">Lump Sum Payment (RM)</th>
                                <th scope="col">Variable Expense - Transport</th>
                                <th scope="col">Variable Expense - Travelling</th>
                                <th scope="col">Variable Expense - Miscellaneous</th>
                                <th scope="col">Advance Taken/Prior Approval (RM)</th>
                                <th scope="col">Subtotal (RM) *</th>
