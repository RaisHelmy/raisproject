    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(12)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $(".@(DataTableID)RemoveCheckbox").uniform();
        BindtoDDL();
        CalculateSummary();
    }

    function @(DataTableID)GetDDLListInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());

            var _TransferTypeSelect = $(this).children('td:eq(3)').children('select');
            var _TransferTypeHidden = $(this).children('td:eq(3)').children('input[type=hidden]');
            _TransferTypeSelect.val(_TransferTypeHidden.val());

            var _TransferLocationSelect = $(this).children('td:eq(4)').children('select');
            var _TransferLocationHidden = $(this).children('td:eq(4)').children('input[type=hidden]');
            _TransferLocationSelect.val(_TransferLocationHidden.val());
        });
    }

    function @(DataTableID)_TransferTypeChange(x) {
        var $row = $(x).closest("tr");
        $row.find(".hfTransferType").val($row.find(".SubTypeColumn2").val());
    }

    function @(DataTableID)_TransferLocationChange(x) {
        var $row = $(x).closest("tr");
        $row.find(".hfTransferLocation").val($row.find(".SubTypeColumn3").val());
    }

    function @(DataTableID)_Sumuptotal(x) {
        var $row = $(x).closest("tr");

        var TransferType = $row.find(".SubTypeColumn2").val();
        var TransferLocation = $row.find(".SubTypeColumn3").val();
        var Distance = $row.find(".SubTypeColumn4").val();
        var AdvanceTakenPriorApproval = $row.find(".SubTypeColumn9").val();
        var LamSam = 0;
        var Transport = 0;
        var Travelling = 0;
        var Miscellaneous = 0;
        var total = 0;
        if (TransferType != '' && TransferLocation != '' && $.isNumeric(Distance)) {

           if(!$.isNumeric(AdvanceTakenPriorApproval))
            {
                $row.find(".SubTypeColumn9").val('0.00');
                Miscellaneous = 0;
            }

            if (TransferType == 'Single' && TransferLocation == 'Outstation') {
                LamSam = @TransferAllowance_Outstation_Single_LumpSum;
                Transport = @SingleAddition1 + (@SingleMultiplier1 * Distance);
                Travelling = @TransferAllowance_Single_Rate * Distance;
                Miscellaneous = @TransferAllowance_Single_MiscellaneousRate * (Transport + Travelling)
            }

            if (TransferType == 'With Family' && TransferLocation == 'Outstation') {
                LamSam = @TransferAllowance_Outstation_WithFamily_LumpSum;
                Transport = @FamilyMultiplier1 * (@FamilyAddition1 + (@FamilyMultiplier2 * Distance));
                Travelling = @TransferAllowance_WithFamily_Addition + (@TransferAllowance_WithFamily_Rate * Distance);
                Miscellaneous = @TransferAllowance_WithFamily_MiscellaneousRate * (Transport + Travelling)
            }

            if (TransferType == 'Single' && TransferLocation == 'Within Station') {
                LamSam = @TransferAllowance_WithinStation_Single_LumpSum;
                @*Transport = 180 + (1.5 * Distance);
                Travelling = @TransferAllowance_Single_Rate * Distance;
                Miscellaneous = 0.00;*@

                Transport = 0.00;
                Travelling = 0.00;
                Miscellaneous = 0.00;

            }
            if (TransferType == 'With Family' && TransferLocation == 'Within Station') {
                LamSam = @TransferAllowance_WithinStation_WithFamily_LumpSum;
                @*Transport = 1.5 * (180 + (1.5 * Distance));
                Travelling = @TransferAllowance_WithFamily_Addition + (@TransferAllowance_WithFamily_Rate * Distance);
                Miscellaneous = 0.00;*@

                Transport = 0.00;
                Travelling = 0.00;
                Miscellaneous = 0.00;
            }

            LamSam = __essClaim.RoundNum(LamSam, 2);
            Transport = __essClaim.RoundNum(Transport, 2);
            Travelling = __essClaim.RoundNum(Travelling, 2);
            Miscellaneous = __essClaim.RoundNum(Miscellaneous, 2);
            AdvanceTakenPriorApproval = __essClaim.RoundNum(AdvanceTakenPriorApproval, 2);

            total = LamSam + Transport + Travelling + Miscellaneous - AdvanceTakenPriorApproval;
        }

        $row.find(".SubTypeColumn5").val(LamSam.toFixed(2));
        $row.find(".SubTypeColumn6").val(Transport.toFixed(2));
        $row.find(".SubTypeColumn7").val(Travelling.toFixed(2));
        $row.find(".SubTypeColumn8").val(Miscellaneous.toFixed(2));
        $row.find(".Amount").val(total.toFixed(2));

        @(DataTableID)_CalculateSum($row.find(".Amount"));
    }

    function @(DataTableID)_CalculateSum(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }



        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            gstMaxValue = '@GSTMaxValue';
            gstAmt = amount * (parseFloat(gstMaxValue) / 100);
            $row.find(".GSTAmount").val(gstAmt.toFixed(2));
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaxValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;

        var thisTable = $('#tbl@(DataTableID)');

        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandAmount + grandGST;
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));

        CalculateSummary();
    }

