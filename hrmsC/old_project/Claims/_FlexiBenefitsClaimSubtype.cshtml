@model List<ESS.Claim.ViewModels.FlexiBenefitsSubtype>
<div class="row" id="div_SubtypeSelection">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Claims Subtype Selection
                </div>
            </div>
            <div class="portlet-body form" style="padding:10px !important">
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-12">
                            @{int i = 0;}
                            @foreach (ESS.Claim.ViewModels.FlexiBenefitsSubtype subtype in Model)
                            {

                                <div class="col-md-6" style="padding:5px;">
                                    <input type="hidden" name="ClaimSubtype[@i].ClaimsSubtypeName" value="@subtype.ClaimsSubtypeName" />
                                    <input type="hidden" name="ClaimSubtype[@i].FormInterface" value="@subtype.FormInterface" />
                                    <input type="hidden" name="ClaimSubtype[@i].subtypeIndex" value="@i" />
                                    @Html.CheckBox("ClaimSubtype[" + i + "].IsChoosen", @subtype.IsChoosen, new { @class = "SubtypeCheckBox" })
                                    <span class="task-title-sp">
                                        @subtype.ClaimsSubtypeName
                                    </span>
                                </div>

                                i++;

                            }
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <input type="submit" class="btn green" value="Next" id="btnNext" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
