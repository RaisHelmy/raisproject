@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.OthersDayTripAllowanceNoGST_ClaimsSubtypeName;
    string dtStrStart = ViewBag.OthersDayTripAllowanceNoGST_StartDate;
    string dtStrEnd = ViewBag.OthersDayTripAllowanceNoGST_EndDate;
    string Status = ViewBag.OthersDayTripAllowanceNoGST_Status;
    string GSTEnabled = (ViewBag.OthersDayTripAllowanceNoGST_GSTEnabled + "").ToLower();
    string GSTMaxValue = ViewBag.OthersDayTripAllowanceNoGST_GSTMaxValue;
    double MinimumDistance = ViewBag.OthersDayTripAllowanceNoGST_MinimumDistance;
    double Rate = ViewBag.OthersDayTripAllowanceNoGST_Rate;
    int Interval = ViewBag.OthersDayTripAllowanceNoGST_Interval;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
}

<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@Model.ClaimSubTypeCategory - @Model.ClaimsSubtypeName
        </div>
        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')">
                    <img style=" vertical-align: initial;" src="../Assets/img/portlet-remove-icon-white.png" />
                </a>
            </div>
        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"></a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Charge Code *</th>
                                <th scope="col">Date *</th>
                                <th scope="col">Start Time *</th>
                                <th scope="col">End Time *</th>
                                <th scope="col">Destination</th>
                                <th scope="col">No. of Hours</th>
                                <th scope="col">One Way Distance (KM) *</th>
                                <th scope="col">Rate (RM)</th>
                                <th scope="col">Interval (Hrs)</th>
                                <th scope="col">Amount (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @if (@Status == "Draft" || Status == "Withdrawn")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                        <td>
                                            <input type="hidden" class="hfChargeCode" />
                                            <select class="form-control ddlChargeCode SubTypeColumn0" style="min-width:130px" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();"
                                                    name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" class="form-control Date"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Date" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control timeinput StartTime" style="min-width:130px" placeholder="HH:MM (e.g 12:30)"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].StartTime"
                                                   onblur="@(DataTableID)_TimeChange(this);" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control timeinput EndTime" style="min-width:130px" placeholder="HH:MM (e.g 12:30)"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].EndTime"
                                                   onblur="@(DataTableID)_TimeChange(this);" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn4" style="min-width:130px"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTypeColumn5" style="min-width:130px" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTypeColumn6" style="min-width:130px"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTypeColumn7" style="min-width:130px" value="@Rate" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTypeColumn8" style="min-width:130px" value="@Interval" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right Amount" style="min-width:130px" maxlength="10" value="0.00" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="0.00"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount"
                                                   onblur="@(DataTableID)CalculationGST(this);" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="0.00" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" />
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="10"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="0.00" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="0.00" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="0.00" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                            <td>
                                                <input type="hidden" class="hfChargeCode" value="@thisDetail.SubTypeColumn0" />
                                                <select class="form-control ddlChargeCode SubTypeColumn0" style="min-width:130px" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();"
                                                        name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                    <input type="text" class="form-control Date" value="@thisDetail.Date"
                                                           name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Date" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="text" class="form-control timeinput StartTime" style="min-width:130px" placeholder="HH:MM (e.g 12:30)"
                                                       value="@thisDetail.StartTime" onblur="@(DataTableID)_TimeChange(this);"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].StartTime" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control timeinput EndTime" style="min-width:130px" placeholder="HH:MM (e.g 12:30)"
                                                       value="@thisDetail.EndTime" onblur="@(DataTableID)_TimeChange(this);"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].EndTime" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control SubTypeColumn4" style="min-width:130px" value="@thisDetail.SubTypeColumn4"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn4" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right SubTypeColumn5" style="min-width:130px" value="@thisDetail.SubTypeColumn5" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn5" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right SubTypeColumn6" style="min-width:130px" value="@thisDetail.SubTypeColumn6"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn6" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right SubTypeColumn7" style="min-width:130px" value="@thisDetail.SubTypeColumn7" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn7" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right SubTypeColumn8" style="min-width:130px" value="@thisDetail.SubTypeColumn8" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn8" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right Amount" style="min-width:130px" value="@thisDetail.Amount" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="@thisDetail.GSTAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount"
                                                       onblur="@(DataTableID)CalculationGST(this);" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="@thisDetail.TotalAmount" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" />
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="10"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.GSTAmount) ? 0.00 : Convert.ToDouble(m.GSTAmount))))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.TotalAmount) ? 0.00 : Convert.ToDouble(m.TotalAmount))))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                    <tr>
                                        <td></td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn0" style="min-width:130px" value="@thisDetail.SubTypeColumn0" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0" />
                                        </td>
                                        <td>
                                            @{
                                                string strDate = string.Empty;
                                                string strSTime = string.Empty;
                                                string strETime = string.Empty;

                                                strDate = (string.IsNullOrEmpty(thisDetail.Date) ? thisDetail.SubTypeColumn1 : thisDetail.Date);
                                                strSTime = (string.IsNullOrEmpty(thisDetail.StartTime) ? thisDetail.SubTypeColumn2 : thisDetail.StartTime);
                                                strETime = (string.IsNullOrEmpty(thisDetail.EndTime) ? thisDetail.SubTypeColumn3 : thisDetail.EndTime);
                                            }
                                            <input type="text" class="form-control Date" style="min-width:150px" value="@strDate" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Date" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control timeinput StartTime" style="min-width:130px" value="@strSTime" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].StartTime" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control timeinput EndTime" style="min-width:130px" value="@strETime" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].EndTime" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn4" style="min-width:130px" value="@thisDetail.SubTypeColumn4" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTypeColumn5" style="min-width:130px" value="@thisDetail.SubTypeColumn5" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn5" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTypeColumn6" style="min-width:130px" value="@thisDetail.SubTypeColumn6" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn6" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTypeColumn7" style="min-width:130px" value="@thisDetail.SubTypeColumn7" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn7" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTypeColumn8" style="min-width:130px" value="@thisDetail.SubTypeColumn8" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn8" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right Amount" style="min-width:130px" value="@thisDetail.Amount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="@thisDetail.GSTAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="@thisDetail.TotalAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" />
                                        </td>
                                    </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="10"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.GSTAmount) ? 0.00 : Convert.ToDouble(m.GSTAmount))))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.TotalAmount) ? 0.00 : Convert.ToDouble(m.TotalAmount))))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
            {
                <div class="form-horizontal">
                    <div class="table-toolbar">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="btn-group">
                                    <a class="BtnPlus btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_addRow();">
                                        Add Row
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                                <div class="btn-group">
                                    <a class="BtnPlus5 btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_add5Row();">
                                        Add 5 Rows
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                                <div class="btn-group">
                                    <a class="deleteall btn red" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_removeRow();">
                                        Delete Row
                                        <i class="fa fa-minus"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_@(DataTableID)Validation() {
        var _ValidationMsg = '';

        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");

            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            var _Date = $row.find(".Date").val();
            var _StartTime = $row.find(".StartTime").val();
            var _EndTime = $row.find(".EndTime").val();
            var _Distance = $row.find(".SubTypeColumn6").val();

            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n'
            }

            if (_Date == null || _Date == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Date) is required.\n'
            }

            if (_StartTime == null || _StartTime == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Start Time) is required.\n'
            }

            if (_EndTime == null || _EndTime == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (End Time) is required.\n'
            }

            if (_Distance == null || _Distance == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Distance) is required.\n'
            }
            else if ((parseFloat(_Distance) || 0) < parseFloat(@MinimumDistance)) {
                _ValidationMsg += '- @ClaimsSubtypeName (Distance) has to be greater than or equal to @MinimumDistance km.\n'
            }

            var _GSTAmount = $row.find(".GSTAmount").val();
            var gstAmt = 0;
            if ('@GSTEnabled' != 'false') {
                if (_GSTAmount == null || _GSTAmount == '') {
                    _ValidationMsg += '- @ClaimsSubtypeName (GST Amount) is required.\n'
                }

                var gstMaxValue = '@GSTMaxValue';
                gstAmt = parseFloat(_Amount) * (parseFloat(gstMaxValue) / 100);
                if ((parseFloat(_GSTAmount) || 0) > (parseFloat(gstAmt.toFixed(2)) || 0)) {
                    _ValidationMsg += '- @ClaimsSubtypeName - The GST Amount (highlighted in yellow) has exceeded the maximum value.Please edit or delete the record to proceed.\n'
                    $row.find(".GSTAmount").css("background-color", "yellow");
                }
                else {
                    $row.find(".GSTAmount").css("background-color", "white");
                }
            }
        });

        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="@(DataTableID)RemoveCheckbox"]:checked'), function (i, val) {
            var currLength = $('#tbl@(DataTableID) tr').length - 2;
            var row = $(this).closest("tr").get(0);
            if (currLength > 1) {
                _@(DataTableID)Table.fnDeleteRow(mytable.fnGetPosition(row));
            }
        });

        reorderTable('#tbl@(DataTableID)');
        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_add5Row() {
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
    }

    function @(DataTableID)_addRow() {
        _@(DataTableID)Table.fnAddData([
            '<input type="checkbox" class="@(DataTableID)RemoveCheckbox" />',
            '<input type="hidden" class="hfChargeCode" /><select class="form-control ddlChargeCode SubTypeColumn0" style="min-width:130px" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn0"><option value="">Select One</option></select>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control Date" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Date" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" class="form-control timeinput StartTime" style="min-width:130px" placeholder="HH:MM (e.g 12:30)" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].StartTime" onblur="@(DataTableID)_TimeChange(this);" />',
            '<input type="text" class="form-control timeinput EndTime" style="min-width:130px" placeholder="HH:MM (e.g 12:30)" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].EndTime" onblur="@(DataTableID)_TimeChange(this);" />',
            '<input type="text" class="form-control SubTypeColumn4" style="min-width:130px" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" />',
            '<input type="text" class="form-control text-right SubTypeColumn5" style="min-width:130px" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" />',
            '<input type="text" class="form-control text-right SubTypeColumn6" style="min-width:130px" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" />',
            '<input type="text" class="form-control text-right SubTypeColumn7" style="min-width:130px" value="@Rate" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" />',
            '<input type="text" class="form-control text-right SubTypeColumn8" style="min-width:130px" value="@Interval" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" />',
            '<input type="text" class="form-control text-right Amount" style="min-width:130px" maxlength="10" value="0.00" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Amount" />',
            '<input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="0.00" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].GSTAmount" onblur="@(DataTableID)CalculationGST(this);" />',
            '<input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="0.00" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].TotalAmount" />'
        ]);

        @(DataTableID)_Initialize();
    }

    function @(DataTableID)_TimeChange(x) {
        var $row = $(x).closest("tr");

        var _date = '31-12-1800 '
        var _StartTime = $row.find(".StartTime").val();
        var _EndTime = $row.find(".EndTime").val();

        if (_StartTime != '' && _EndTime != '') {
            var startDateStr = _date + _StartTime;
            var endDateStr = _date + _EndTime;

            var startDateTimeParts = startDateStr.split(' ');
            var startTimeParts = startDateTimeParts[1].split(':');
            var startDateParts = startDateTimeParts[0].split('-');
            var startDate = new Date(startDateParts[2], parseInt(startDateParts[1], 10) - 1, startDateParts[0], startTimeParts[0], startTimeParts[1]);

            var endDateTimeParts = endDateStr.split(' ');
            var endTimeParts = endDateTimeParts[1].split(':');
            var endDateParts = endDateTimeParts[0].split('-');
            var endDate = new Date(endDateParts[2], parseInt(endDateParts[1], 10) - 1, endDateParts[0], endTimeParts[0], endTimeParts[1]);

            var timeDiff = endDate.getTime() - startDate.getTime();
            // 1 hour = 60 mins | 1 min = 60 seconds | 1 sec = 1000ms
            var noOfHours = ((timeDiff / 1000) / 60) / 60;

            if (noOfHours < 0) {
                endDate.setHours(endDate.getHours() + 24);

                timeDiff = endDate.getTime() - startDate.getTime();
                noOfHours = ((timeDiff / 1000) / 60) / 60;
            }

            $row.find(".SubTypeColumn5").val(noOfHours.toFixed(2));

            @(DataTableID)Calculation(x);
        }
    }

    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(11)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $(".@(DataTableID)RemoveCheckbox").uniform();
        InitDistanceMin("tbl@(DataTableID)", "SubTypeColumn6", 0);
        BindtoDDL();
        CalculateSummary();
    }

    function @(DataTableID)GetDDLListInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());
        });
    }

    function @(DataTableID)Calculation(x) {
        //if (x != undefined) {
        //    var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
        //    if (!myNumeric) {
        //        $(x).val('0.00');
        //    }
        //    else {
        //        $(x).val(myNumeric.toFixed(2));
        //        //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
        //    }
        //}

        var $row = $(x).closest("tr");
        var NoOfHours = parseFloat($row.find(".SubTypeColumn5").val()) || 0;
        var rate = parseFloat($row.find(".SubTypeColumn7").val()) || 0;
        var interval = parseFloat($row.find(".SubTypeColumn8").val()) || 1;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        var _amount = rate * Math.floor(NoOfHours / interval);
        $row.find(".Amount").val(_amount.toFixed(2));

        console.log('@GSTEnabled');

        if ('@GSTEnabled' != 'false') {
            gstMaxValue = '@GSTMaxValue';
            gstAmt = _amount * (parseFloat(gstMaxValue) / 100);
            $row.find(".GSTAmount").val(gstAmt.toFixed(2));
        }

        TotalAmount = (parseFloat(_amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)CalculationGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var $row = $(x).closest("tr");
        var NoOfHours = parseFloat($row.find(".SubTypeColumn5").val()) || 0;
        var rate = parseFloat($row.find(".SubTypeColumn7").val()) || 0;
        var interval = parseFloat($row.find(".SubTypeColumn8").val()) || 1;
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        var _amount = rate * Math.floor(NoOfHours / interval);
        $row.find(".Amount").val(_amount.toFixed(2));

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaxValue';
                gstAmt = _amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(_amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;

        var thisTable = $('#tbl@(DataTableID)');

        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandAmount + grandGST;
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));

        CalculateSummary();
    }

    $(document).ready(function () {
        @(DataTableID)_Initialize();
        @(DataTableID)GetDDLListInputValues();
    });
</script>