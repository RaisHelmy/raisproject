@using ESS.Claim.ViewModels
@using System.Globalization
@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.SubsistenceAllowanceMultiNoGST_ClaimsSubtypeName;
    string Status = ViewBag.SubsistenceAllowanceMultiNoGST_Status;
    string GSTEnabled = (ViewBag.SubsistenceAllowanceMultiNoGST_GSTEnabled + "").ToLower();
    string GSTMaxValue = ViewBag.SubsistenceAllowanceMultiNoGST_GSTMaxValue;
    string NoOfDays = ViewBag.SubsistenceAllowanceMultiNoGST_NoOfDays;
    string NoOfMeals = ViewBag.SubsistenceAllowanceMultiNoGST_NoOfMeals;
    string NoOfExtraHour = ViewBag.SubsistenceAllowanceMultiNoGST_NoOfExtraHour;
    string TwentyFourHourRate = ViewBag.SubsistenceAllowanceMultiNoGST_TwentyFourHourRate;
    string ExtraHourRate = ViewBag.SubsistenceAllowanceMultiNoGST_ExtraHourRate;
    string WorkSubtotal = ViewBag.SubsistenceAllowanceMultiNoGST_WorkSubtotal;

    double dblBreakfastRate = ViewBag.SubsistenceAllowanceMultiNoGST_BreakfastRate;
    double dblLunchRate = ViewBag.SubsistenceAllowanceMultiNoGST_LunchRate;
    double dblDinnerRate = ViewBag.SubsistenceAllowanceMultiNoGST_DinnerRate;
    string PayScaleGroup = ViewBag.SubsistenceAllowanceMultiNoGST_PayScaleGroup;

    string StartDate = ViewBag.StartDate;
    string StartTime = ViewBag.StartTime;
    string EndDate = ViewBag.EndDate;
    string EndTime = ViewBag.EndTime;

    int iNoOfDays = ViewBag.NoOfDays;
    double iNoOfExtraHours = ViewBag.NoOfExtraHours;
    double iTwentyFourHourRate = ViewBag.TwentyFourHourRate;
    double iExtraHourRate = ViewBag.ExtraHourRate;
    double iWorkSubtotal = ViewBag.WorkSubtotal;
    double TotalNoOfHour = ViewBag.TotalNoOfHours;

    DateTime StartDateTime = DateTime.MinValue;
    DateTime EndDateTime = DateTime.MaxValue;
    DateTime.TryParseExact(StartDate + " " + StartTime, "dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out StartDateTime);
    DateTime.TryParseExact(EndDate + " " + EndTime, "dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out EndDateTime);
    if (StartDateTime != DateTime.MinValue && EndDateTime != DateTime.MaxValue)
    {
        TimeSpan dayDiff = EndDateTime - StartDateTime;
        iNoOfExtraHours = Convert.ToDouble(dayDiff.Hours) + (Convert.ToDouble(dayDiff.Minutes) / 60.0);
    }

    SubTypeDetails mainDetail = null;
    // Header form stuff are stored in first row if applicable
    if (Model.SubTypeDetails != null)
    {
        mainDetail = Model.SubTypeDetails[0];
    }
    else
    {
        mainDetail = null;
    }

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
}

