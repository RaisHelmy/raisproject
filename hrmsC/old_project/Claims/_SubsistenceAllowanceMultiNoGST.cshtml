</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function @(DataTableID)_removeRow() {
        $.each($('input[class="SubsidiesOutstationMultiRemoveCheckbox"]:checked'), function (i, val) {
            var currLength = $('#tbl@(DataTableID) tr').length - 2;
            var row = $(this).closest("tr").get(0);
            if (currLength > 1) {
                _@(DataTableID)Table.fnDeleteRow(mytable.fnGetPosition(row));
            }
        });

        reorderTable('#tbl@(DataTableID)');
        @(DataTableID)_Initialize();
        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_add5Row() {
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
    }

    function @(DataTableID)_addRow() {
        _@(DataTableID)Table.fnAddData([
            "<input type='checkbox' class='SubsidiesOutstationMultiRemoveCheckbox' /></td>",
            '<input type="hidden" class="hfChargeCode" /><select class="form-control ddlChargeCode SubTypeColumn0" style="min-width:130px" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].SubTypeColumn0"><option value="">Select One</option></select>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control StartDate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].StartDate" onchange="@(DataTableID)_TableDateConfiguration();" /> <span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" class="form-control timeinput StartTime" style="min-width:130px" placeholder="HH:MM (e.g 12:30)" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].StartTime" onchange="@(DataTableID)_TableDateConfiguration();" />',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control EndDate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].EndDate" onchange="@(DataTableID)_TableDateConfiguration();" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" class="form-control timeinput EndTime" style="min-width:130px" placeholder="HH:MM (e.g 12:30)" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].EndTime" onchange="@(DataTableID)_TableDateConfiguration();" />',
            '<input type="text" class="form-control text-right NoOfHours" style="min-width:130px" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].NoOfHours" readonly />',
            '<input type="text" class="form-control text-right Amount" style="min-width:130px" value="0.00" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].Amount" />' +
            '<input type="hidden" class="GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].GSTAmount" value="0.00" />' +
            '<input type="hidden" class="TotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + (_@(DataTableID)Table.fnSettings().fnRecordsTotal()) + '].TotalAmount" value="0.00" />'
        ]);

        @(DataTableID)_Initialize();
    }

    function dTable_@(DataTableID)Validation() {
        var _ValidationMsg = '';

        var table = _@(DataTableID)Table;
        var subtotalBreakfast = parseFloat($('#subtotalBreakfast').val().replace(',', '')) || 0;
        var subtotalLunch = parseFloat($('#subtotalLunch').val().replace(',', '')) || 0;
        var subtotalDinner = parseFloat($('#subtotalDinner').val().replace(',', '')) || 0;

        $.each(table.fnGetNodes(), function (i, value) {
            var _ChargeCode = $(value).find(".SubTypeColumn0").val();
            var _StartDate = $(value).find(".StartDate").val();
            var _StartTime = $(value).find(".StartTime").val();
            var _EndDate = $(value).find(".EndDate").val();
            var _EndTime = $(value).find(".EndTime").val();
            var _NoOfHours = $(value).find(".NoOfHours").val();

            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n';
            }
            else {
                $('#sMultiDummyChargeCode').val(_ChargeCode);
            }

            if (_StartDate == null || _StartDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Start Date) is required.\n';
            }

            if (_StartTime == null || _StartTime == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Start Time) is required.\n';
                        }

            if (_EndDate == null || _EndDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (End Date) is required.\n';
                        }

            if (_EndTime == null || _EndTime == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (End Time) is required.\n';
            }

            if (parseInt(_NoOfHours) < 1) {
                _ValidationMsg += '- @ClaimsSubtypeName (No Of Hours) must be more than 0.\n';
            }

            
            if (!(_StartTime == null || _StartTime == '') && !(_EndTime == null || _EndTime == '') && !(_StartDate == null || _StartDate == '') && !(_EndDate == null || _EndDate == '')) {
                var startDateString = _StartDate + " " + _StartTime;
                var endDateString = _EndDate + " " + _EndTime;

                var StartDate = moment(startDateString, "DD/MM/YYYY HH:mm")._d;
                var EndDate = moment(endDateString, "DD/MM/YYYY HH:mm")._d;
                 
                if (EndDate <= StartDate) {
                    _ValidationMsg += ('- @ClaimsSubtypeName End Date/Time has to be later than Start Date/Time.\n');                    
                }
            }
        });

        var FormStartDate = $("#StartDate").val();
        var FormStartTime = $("#StartTime").val();
        var FormEndDate = $("#EndDate").val();
        var FormEndTime = $("#EndTime").val();

        var subStartDate = $("#startDate").val();
        var subStartTime = $("#startTime").val();
        var subEndDate = $("#endDate").val();
        var subEndTime = $("#endTime").val();

        var totalNoOfHours = parseFloat($('#totalNoOfHour').val().replace(',', '')) || 0;
        var totalSubsistence = parseFloat($('#totalSubsistence').val().replace(',', '')) || 0;

        var grandAmount =  $('#GrandTotalAmount').val();
        var grandNoOfHours = $('#GrandNoOfHours').val();

        if (FormStartDate != subStartDate) {
            _ValidationMsg += '- @ClaimsSubtypeName (Start Date) not match the claim start date, please refresh the form. \n';
        }

        if (FormStartTime != subStartTime) {
            _ValidationMsg += '- @ClaimsSubtypeName (Start Time) not match the claim start date, please refresh the form. \n';
        }

        if (FormEndDate != subEndDate) {
            _ValidationMsg += '- @ClaimsSubtypeName (End Date) not match the claim end date, please refresh the form. \n';
        }

        if (FormEndTime != subEndTime) {
            _ValidationMsg += '- @ClaimsSubtypeName (End Time) not match the claim start date, please refresh the form. \n';
        }

        if (totalSubsistence != grandAmount) {
            _ValidationMsg += '- @ClaimsSubtypeName (Total Subsistence) do not match the grand amount. \n';
        }

        if (totalNoOfHours != grandNoOfHours) {
            _ValidationMsg += '- @ClaimsSubtypeName (Total No of Hours) do not match. \n';
        }

        if (totalSubsistence < 0) {
            _ValidationMsg += '- @ClaimsSubtypeName (Total Subsistence) must be more than 0. \n';
        }

        return _ValidationMsg;
    }

    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@StartDate');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@EndDate');

        $('.timeinput').inputmask("mask", {
            "mask" : "99:99"
        });

        $('.timeinput').inputmask("h:s", {
            "placeholder": "__/__",
            onincomplete: function () {
                // replace placeholder with zero
                $(this).val($(this).val().replace(/_/g, '0'));
            }
        });

        $(".numericinput").inputmask("integer", {
            min: 0,
            max: 10000,
            allowMinus : false,
            rightAlign: false
        });

        $(".numericinput").css("textAlign", "left");

        $(".SubsidiesOutstationMultiRemoveCheckbox").uniform();
        BindtoDDL();

        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
        {
            @Html.Raw(DataTableID + "_CalculateTotalMeal();");
            @Html.Raw(DataTableID + "_TableDateConfiguration();");
        }

        CalculateSummary();
    }

    function @(DataTableID)GetDDLListInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());
        });
    }

    function @(DataTableID)_CalculateBreakfastSubtotal() {
        var twentyFourHourRate = parseFloat($('#24HourRate').val()) || 0;
        var breakfastRate = parseFloat('@dblBreakfastRate'.replace(',', '')) || 0;
        var breakfastProvided = parseFloat($('#breakfastProvided').val().replace(',', '')) || 0;
        var breakfastSubtotal = breakfastProvided * (breakfastRate * twentyFourHourRate);

        $('#subtotalBreakfast').val(breakfastSubtotal.toFixed(2));
        @(DataTableID)_CalculateTotalMeal();
    }

    function @(DataTableID)_CalculateLunchSubtotal() {
        var twentyFourHourRate = parseFloat($('#24HourRate').val()) || 0;
        var lunchRate = parseFloat('@dblLunchRate'.replace(',', '')) || 0;
        var lunchProvided = parseFloat($('#lunchProvided').val().replace(',', '')) || 0;
        var lunchSubtotal = lunchProvided * (lunchRate * twentyFourHourRate);

        $('#subtotalLunch').val(lunchSubtotal.toFixed(2));
        @(DataTableID)_CalculateTotalMeal();
    }

    function @(DataTableID)_CalculateDinnerSubtotal() {
        var twentyFourHourRate = parseFloat($('#24HourRate').val()) || 0;
        var dinnerRate = parseFloat('@dblDinnerRate'.replace(',', '')) || 0;
        var dinnerProvided = parseFloat($('#dinnerProvided').val().replace(',', '')) || 0;
        var dinnerSubtotal = dinnerProvided * (dinnerRate * twentyFourHourRate);

        $('#subtotalDinner').val(dinnerSubtotal.toFixed(2));
        @(DataTableID)_CalculateTotalMeal();
    }

    function @(DataTableID)_CalculateTotalMeal() {
        if (!$('#breakfastProvided').val()) {
            $('#breakfastProvided').val('0');
        }
        if (!$('#lunchProvided').val()) {
            $('#lunchProvided').val('0');
        }
        if (!$('#dinnerProvided').val()) {
            $('#dinnerProvided').val('0');
        }

        var subtotalBreakfast = parseFloat($('#subtotalBreakfast').val().replace(',', '')) || 0;
        var subtotalLunch = parseFloat($('#subtotalLunch').val().replace(',', '')) || 0;
        var subtotalDinner = parseFloat($('#subtotalDinner').val().replace(',', '')) || 0;
        var totalMeal = subtotalBreakfast + subtotalLunch + subtotalDinner;

        $('#totalMeal').val(totalMeal.toFixed(2));
        @(DataTableID)_CalculateTotalSubsistence();
    }

    function @(DataTableID)_CalculateTotalSubsistence() {
        var subtotal = parseFloat($('#subtotal').val().replace(',', '')) || 0;
        var totalMeal = parseFloat($('#totalMeal').val().replace(',', '')) || 0;
        var totalSubsistence = subtotal - totalMeal;

        if (totalSubsistence < 0)
            totalSubsistence = 0;

        $('#totalSubsistence').val(totalSubsistence.toFixed(2));
        @(DataTableID)_TableDateConfiguration();
    }

    function @(DataTableID)_TableDateConfiguration() {
        var table = _@(DataTableID)Table;
        var totalRows = table.fnSettings().fnRecordsTotal();
        var startRow = $(table.fnGetNodes()[0]);
        var endRow = $(table.fnGetNodes()[totalRows - 1]);

        $.each(table.fnGetNodes(), function (i, value) {
            var eStartDate = $(value).find('.StartDate');
            var eStartTime = $(value).find('.StartTime');
            var eEndDate = $(value).find('.EndDate');
            var eEndTime = $(value).find('.EndTime');

            eStartDate.prop('readonly', true);
            eStartTime.prop('readonly', true);

            eEndDate.removeProp('readonly');
            eEndTime.removeProp('readonly');
            
            if (i > 0) {
                var prevRow = $(table.fnGetNodes()[i - 1]);

                var preEndDate = prevRow.find('.EndDate').val();
                var preEndTime = prevRow.find('.EndTime').val();

                //eStartDate.val(prevRow.find('.EndDate').val());
                //eStartTime.val(prevRow.find('.EndTime').val().replace(/_/g, '0')); 

                preEndDate = moment(preEndDate + ' ' + preEndTime, 'DD-MM-YYYY HH:mm').add(1, 'm').toDate();
    
                preEndTime = ("0" + preEndDate.getHours()).slice(-2) + ":" + ("0" + preEndDate.getMinutes()).slice(-2);
       
                preEndDate = ("0" + preEndDate.getDate()).slice(-2) + "/" + ("0" + (preEndDate.getMonth() + 1)).slice(-2) + "/" + preEndDate.getFullYear();
  
                eStartDate.val(preEndDate);
                eStartTime.val(preEndTime);

             
                eEndDate.datepicker({
                    format: 'dd/mm/yyyy',
                    autoclose: true
                });
                eEndDate.datepicker('setStartDate', prevRow.find('.EndDate').val());
                eEndDate.datepicker('setEndDate', '@EndDate');
            }
        });

        if (!!'@StartDate') {
            startRow.find('.StartDate').val('@StartDate');
        }

        if (!!'@StartTime') {
            startRow.find('.StartTime').val('@StartTime');
        }
        startRow.find('.StartDate').prop('readonly', true);
        startRow.find('.StartTime').prop('readonly', true);

        if (!!'@EndDate') {
            endRow.find('.EndDate').val('@EndDate');
        }

        if (!!'@EndTime') {
            endRow.find('.EndTime').val('@EndTime');
        }
        endRow.find('.EndDate').prop('readonly', true);
        endRow.find('.EndTime').prop('readonly', true);

        @(DataTableID)_CalculateAmountDistribution();
    }

    function @(DataTableID)_CalculateAmountDistribution() {
        var table = _@(DataTableID)Table;
        var totalSubsistence = parseFloat($('#totalSubsistence').val().replace(',', ''));
        var totalNoOfHours = parseFloat($('#totalNoOfHour').val().replace(',', ''));
        var ratePerHour = totalSubsistence / totalNoOfHours;

        $.each(table.fnGetNodes(), function (i, value) {
            var startDate  = $(value).find('.StartDate').val();
            var startTime = $(value).find('.StartTime').val();
            var endDate = $(value).find('.EndDate').val();
            var endTime = $(value).find('.EndTime').val();

            var startDateTime = moment(startDate + ' ' + startTime, 'DD-MM-YYYY HH:mm');
            var endDateTime = moment(endDate + ' ' + endTime, 'DD-MM-YYYY HH:mm');
            var noOfHours = moment.duration(endDateTime.diff(startDateTime)).asHours().toFixed(2);

            $(value).find('.NoOfHours').val(noOfHours);
            $(value).find('.Amount').val((noOfHours * ratePerHour).toFixed(2));
            $(value).find('.GSTAmount').val("0.00");
            $(value).find('.TotalAmount ').val((noOfHours * ratePerHour).toFixed(2));
        });

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var totalSubsistence = parseFloat($('#totalSubsistence').val().replace(',', ''));
        var totalNoOfHours = parseFloat($("#totalNoOfHour").val().replace(',', ''));

        var grandNoOfHours = 0;
        var grandAmount = 0;
        var table = _@(DataTableID)Table;
        var lastRow = $(table.fnGetNodes()[table.fnSettings().fnRecordsTotal() - 1]);

        $.each(table.fnGetNodes(), function (i, value) {
            var hours = parseFloat($(value).find('.NoOfHours ').val().replace(',', ''));
            var amount = parseFloat($(value).find('.TotalAmount ').val().replace(',', ''));

            grandNoOfHours += hours;
            grandAmount += amount;
        });

        if (grandNoOfHours != totalNoOfHours) {
            var diff = +(totalNoOfHours - grandNoOfHours).toFixed(12);
            var lastRowNoOfHours = lastRow.find('.NoOfHours');
            var lastRowNoOfHoursVal = parseFloat(lastRowNoOfHours.val().replace(',', ''));
            var modifiedVal = lastRowNoOfHoursVal + diff;
            lastRowNoOfHours.val(modifiedVal.toFixed(2));
            grandNoOfHours = totalNoOfHours;
        }

        if (grandAmount != totalSubsistence) {
            var diff = +(totalSubsistence - grandAmount).toFixed(12);
            var lastRowAmount = lastRow.find('.Amount');
            var lastRowTotalAmount = lastRow.find('.TotalAmount');
            var lastRowTotalAmountVal = parseFloat(lastRowTotalAmount.val().replace(',', ''));
            var modifiedVal = lastRowTotalAmountVal + diff;
            lastRowTotalAmount.val(modifiedVal.toFixed(2));
            lastRowAmount.val(modifiedVal.toFixed(2));
            grandAmount = totalSubsistence;
        }

        $('#GrandNoOfHours').val(grandNoOfHours.toFixed(2));
        $('#GrandTotalAmount').val(grandAmount.toFixed(2));

        CalculateSummary();
    }


    $(document).ready(function () {
        @(DataTableID)_Initialize();
        @(DataTableID)GetDDLListInputValues();
    });
</script>