                                                <input type="hidden" class="TotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@i].TotalAmount" value="@thisDetail.TotalAmount" />
                                            </td>
