    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(16)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _Nodays = $(this).children('td:eq(4)').children('input[type=text]');
            _Nodays.prop('readonly', true);

            var _HotelAmt = $(this).children('td:eq(12)').children('input[type=text]');
            _HotelAmt.prop('readonly', true);

            var _TotalHotel = $(this).children('td:eq(14)').children('input[type=text]');
            _TotalHotel.prop('readonly', true);

            var _TotalClaim = $(this).children('td:eq(15)').children('input[type=text]');
