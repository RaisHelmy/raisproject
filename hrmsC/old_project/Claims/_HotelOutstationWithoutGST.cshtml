            '<input type="hidden" value="true" class="@(DataTableID)_hfReceipt" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" /><input type="checkbox" class="@(DataTableID)ReceiptCheckbox SubTypeColumn5" onchange="@(DataTableID)_ReceiptChange(this);" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" checked="checked" /> Yes',
