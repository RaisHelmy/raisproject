    function @(DataTableID)_FormatNumber(x) {
        var number = "";
        var myNumeric = parseFloat(x.replace(/,/g, ''));
        if (!myNumeric) {
            number = "0.00";
        }
        else {
            number = myNumeric.toFixed(2);
        }

        return number;
    }


    function @(DataTableID)_PopulateHotel(x) {
        var $row = $(x).closest("tr");
        var _StateName = document.getElementById($row.find(".HotelState").attr('id'));
        var _HotelName = document.getElementById($row.find(".HotelName").attr('id'));
        var _SpanShowHideOtherHotelName = document.getElementById($row.find(".SpanShowHideOtherHotelName").attr('id'));  
        var _DDLHotelList = document.getElementById($row.children('td:eq(10)').children('select').attr('id')); 
        var $select =$(_DDLHotelList);
        var instance = $select.data('select2');

        if (instance) { 
            $select.select2('destroy');
        } 
         
         @(DataTableID)_PopulateHotelList(_StateName.value, _DDLHotelList,"", _SpanShowHideOtherHotelName);
 

        $select.select2({
            dropdownAutoWidth: 'true',
            width: 'auto'
        });
         
        $select.select2('val', '');
        $select.on('change', function(){        
            @(DataTableID)_ShowHideOthers(this, $(this).val());
        });

        $select.on("select2-close", function (e) {
			$(".select2-drop").addClass("select2-dropdown-none"); 
        });

		$select.on("select2-open", function (e) {
 
			//console.log($(".select2-drop").find(".select2-result").length);
			$( ".select2-drop" ).each(function() {
							 
				if($( this ).find(".select2-result").length > 0){ 
					$( this ).removeClass("select2-dropdown-none");
				}
			});
							
        });

    }

    function @(DataTableID)_ShowHideOthers(x, type) {
        var $row = $(x).closest("tr");       

        if (type == "- OTHERS -") {          
            $row.find(".SpanShowHideOtherHotelName").removeClass("hide");          
        } else {          
            $row.find(".SpanShowHideOtherHotelName").addClass("hide");         
        }        

    }

    

    function @(DataTableID)_PopulateHotelList(StateName, HotelList, HotelName, SpanShowHideOtherHotelName) {
        if (StateName != "") { 
             
            $.ajax({
                type: "GET",
                cache : false,
                url: '@Url.Action("GetHotelByState", "Claims")',
                data: {
                    stateName: StateName
                },
                datatype: "json", 
                success: function (data) {   

                    var found = 0;

                    if (HotelList != null) {
                        HotelList.options.length = 0;
                                 
                        for (var i = 0; i < data.length; i++)  
                        {                        
                            var option = document.createElement('option');

                            if (HotelName == data[i].Value) {
                                option.selected = true; 
                                found = "1";
                            }
               
                            option.text = option.value = data[i].Value;
                            HotelList.add(option, i + 1);   

                            if (i + 1 == data.length) {
                                option.text = option.value = "- OTHERS -";
                                 HotelList.add(option, i+2);   

                                if (HotelName == "- OTHERS -") {
                                    option.selected = true;
                                    found = "1";
                                }
                            }
                        }  

                        var option = document.createElement('option');
                        option.text = "- Select One -";
                        option.value = "";
                        HotelList.add(option, 0);                      

                        if (found == "0") {
                            HotelList.value = "";
                        }
                     
                        var $select =$(HotelList);
                        var instance = $select.data('select2');

                        if (instance) { 
                            $select.select2('destroy'); 
                        } 
         

                        $select.select2({
                            dropdownAutoWidth: 'true',
                            width: 'auto'
                        });

                        $select.on('change', function(){        
                            @(DataTableID)_ShowHideOthers(this, $(this).val());
                        });

                        $select.on("select2-close", function (e) {
							$(".select2-drop").addClass("select2-dropdown-none"); 
                        });

						$select.on("select2-open", function (e) {
 
							//console.log($(".select2-drop").find(".select2-result").length);
							$( ".select2-drop" ).each(function() {
							 
							  if($( this ).find(".select2-result").length > 0){ 
									$( this ).removeClass("select2-dropdown-none");
								}
							});
							
						});

 

                        if (HotelName == "- OTHERS -") {          
                            $(SpanShowHideOtherHotelName).removeClass("hide");          
           
                        } else {          
                            $(SpanShowHideOtherHotelName).addClass("hide");              
                        }

                    }

                },
                error: function (e) {
                    alert(e);
                    console.log(e);
                }
            });
        }
    }

    $(document).ready(function () {
        @(DataTableID)_Initialize();
        @(DataTableID)GetDDLInputValues();
    });


</script>