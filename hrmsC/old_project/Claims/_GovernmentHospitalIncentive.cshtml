</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_@(DataTableID)Validation() {
        var _ValidationMsg = '';

        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");

            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            var _Date = $row.find(".SubTypeColumn1").val();
            var _ReceiptNo = $row.find(".SubTypeColumn2").val();
            var _Amount = $row.find(".Amount").val();

            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n'
            }

            if (_Date == null || _Date == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Receipt Date) is required.\n'
            }

            if (_ReceiptNo == null || _ReceiptNo == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Receipt No.) is required.\n'
            }

            if (_Amount == null || _Amount == '0' || _Amount == '' || _Amount == '0.00') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is required.\n'
            }

            if (_Amount == 'Infinity') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is invalid.\n'
            }

            var _GSTAmount = $row.find(".GSTAmount").val();
            var gstAmt = 0;
            if ('@GSTEnabled' != 'false') {
                if (_GSTAmount == null || _GSTAmount == '') {
                    _ValidationMsg += '- @ClaimsSubtypeName (GST Amount) is required.\n'
                }

                var gstMaxValue = '@GSTMaxValue';
                gstAmt = parseFloat(_Amount) * (parseFloat(gstMaxValue) / 100);
                if ((parseFloat(_GSTAmount) || 0) > (parseFloat(gstAmt.toFixed(2)) || 0)) {
                    _ValidationMsg += '- @ClaimsSubtypeName - The GST Amount (highlighted in yellow) has exceeded the maximum value.Please edit or delete the record to proceed.\n'
                    $row.find(".GSTAmount").css("background-color", "yellow");
                }
                else {
                    $row.find(".GSTAmount").css("background-color", "white");
                }
            }
        });

        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="@(DataTableID)RemoveCheckbox"]:checked'), function (i, val) {
            var currLength = $('#tbl@(DataTableID) tr').length - 2;
            var row = $(this).closest("tr").get(0);
            if (currLength > 1) {
                _@(DataTableID)Table.fnDeleteRow(mytable.fnGetPosition(row));
            }
        });

        reorderTable('#tbl@(DataTableID)');
        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_add5Row() {
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
    }

    function @(DataTableID)_addRow() {
        _@(DataTableID)Table.fnAddData([
            '<input type="checkbox" class="@(DataTableID)RemoveCheckbox" />',
            '<input type="hidden" class="hfChargeCode" /><select class="form-control ddlChargeCode SubTypeColumn0" style="min-width:130px" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn0"><option value="">Select One</option></select>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control SubTypeColumn1" onchange="@(DataTableID)_DateChange(this);" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px"><input type="text" class="form-control SubTypeColumn2" onchange="@(DataTableID)_DateChange(this);" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" class="form-control SubTypeColumn3" style="min-width:150px" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" />',
            '<input type="hidden" class="hfRelationship" /><select class="form-control SubTypeColumn4" style="min-width:130px" onchange="@(DataTableID)_RelationshipChange(this);@(DataTableID)_BindNameddl(this);" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4"><option value="">Select One</option><option value="Self">Self</option><option value="Dependant">Dependant</option></select>',
            '<input type="hidden" class="hfRelationshipname" /><select class="form-control SubTypeColumn5" style="min-width:130px" onchange="@(DataTableID)_RelationshipnameChange(this);" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5"><option value="">Select One</option></select>',
            '<input type="text" class="form-control text-right SubTypeColumn6" style="min-width:130px" value="@DailyRate" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" />',
            '<input type="text" class="form-control text-right Amount" style="min-width:130px" maxlength="10" value="0.00" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Amount" onblur="@(DataTableID)_CalculateSum(this);" />',
            '<input type="text" class="form-control text-right GSTAmount" style="min-width:130px" value="0.00" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].GSTAmount" onblur="@(DataTableID)_CalculateSumGST(this);" />',
            '<input type="text" class="form-control text-right TotalAmount" style="min-width:130px" value="0.00" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].TotalAmount" />'
        ]);

        @(DataTableID)_Initialize();
    }

    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(9)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $(".@(DataTableID)RemoveCheckbox").uniform();
        BindtoDDL();
        CalculateSummary();
    }

    function @(DataTableID)GetDDLListInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());

            var _RelationSelect = $(this).children('td:eq(5)').children('select');
            var _RelationHidden = $(this).children('td:eq(5)').children('input[type=hidden]');
            _RelationSelect.val(_RelationHidden.val());

            @*var $row = $(this);
            $.ajax({
                type: 'POST',
                url: '@Url.Content("~/Claims/GetNameList")',
                data: { SelectType: _RelationSelect, SubmitterName: '@SubmitterName', SubmitterID: '@SubmitterID' },
                dataType: 'json',
                cache: false,
                async: false,
                success: function (data) {
                    var statesDdl = $row.find(".SubTypeColumn5");
                    statesDdl.empty();
                    statesDdl.append($('<option/>', { value: '', html: 'Select One' }));
                    if (data.agent != null) {
                        $.each(data.agent, function () {
                            statesDdl.append(
                                $('<option/>', {
                                    value: this.Value,
                                    html: this.Text
                                })
                            );
                        });
                    }
                }
            });*@

            var _RelationNameSelect = $(this).children('td:eq(6)').children('select');
            var _RelationNameHidden = $(this).children('td:eq(6)').children('input[type=hidden]');
            _RelationNameSelect.val(_RelationNameHidden.val());
        });
    }

    function @(DataTableID)_DateChange(x) {
        var $row = $(x).closest("tr");

        var _StartDate = $row.find(".SubTypeColumn1");
        var _EndDate = $row.find(".SubTypeColumn2");

        if (_StartDate.val() != "" && _EndDate.val() != "") {
            var from = moment(_StartDate.val(), "DD/MM/YYYY")._d;
            var to = moment(_EndDate.val(), "DD/MM/YYYY")._d;

            if (to < from) {
                _EndDate.val(_StartDate.val());
            }

            from = moment(_StartDate.val(), "DD/MM/YYYY");
            to = moment(_EndDate.val(), "DD/MM/YYYY");
            var days = to.diff(from, 'days');

            if (days != "0") {
                $row.find(".SubTypeColumn3").val(days);
            }
            else {
                $row.find(".SubTypeColumn3").val('1');
            }
        }

        @(DataTableID)_CalculateSum_WhenDateChanged(x);
    }

    function @(DataTableID)_RelationshipChange(x) {
        var $row = $(x).closest("tr");

        $row.find(".hfRelationship").val($row.find(".SubTypeColumn4").val());
    }

    function @(DataTableID)_BindNameddl(x) {
        var $row = $(x).closest("tr");
        var selected = $row.find(".SubTypeColumn4").val();
        if (selected == 'Dependant') {
            $.ajax({
                type: 'POST',
                url: '@Url.Content("~/Claims/GetNameList")',
                data: { SelectType: selected, SubmitterName: '@SubmitterName', SubmitterID: '@SubmitterID' },
                dataType: 'json',
                cache: false,
                async: false,
                success: function (data) {
                    var statesDdl = $row.find(".SubTypeColumn5");
                    statesDdl.empty();
                    statesDdl.append($('<option/>', { value: '', html: 'Select One' }));
                    if (data.agent != null) {
                        $.each(data.agent, function () {
                            statesDdl.append(
                                $('<option/>', {
                                    value: this.Value,
                                    html: this.Text
                                })
                            );
                        });
                    }
                }
            });
        }
        else if(selected == 'Self')
        {
            var statesDdl = $row.find(".SubTypeColumn5");
            statesDdl.empty();
            statesDdl.append($('<option/>', { value: '', html: 'Select One' }));
            statesDdl.append($('<option/>', { value: "@Html.Raw(ViewBag.GovernmentHospitalIncentive_SubmitterName)", html: "@Html.Raw(ViewBag.GovernmentHospitalIncentive_SubmitterName)", selected: true }));
        }
        else
        {
            var statesDdl = $row.find(".SubTypeColumn5");
            statesDdl.empty();
            statesDdl.append($('<option/>', { value: '', html: 'Select One' }));
        }
    }

    function @(DataTableID)_RelationshipnameChange(x) {
        var $row = $(x).closest("tr");

        $row.find(".hfRelationshipname").val($row.find(".SubTypeColumn5").val());
    }

    function @(DataTableID)_CalculateSum_WhenDateChanged(x) {
        var $row = $(x).closest("tr");
        var totalDay = $row.find('.SubTypeColumn3').val();
        var dailyRate = $row.find('.SubTypeColumn6').val();
        var amount = parseFloat(totalDay) * parseFloat(dailyRate);
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if (!amount) {
            $row.find('.Amount').val('0.00');
        }
        else {
            $row.find('.Amount').val(amount.toFixed(2));
        }

        if ('@GSTEnabled' != 'false') {
            gstMaxValue = '@GSTMaxValue';
            gstAmt = amount * (parseFloat(gstMaxValue) / 100);
            $row.find(".GSTAmount").val(gstAmt.toFixed(2));
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSum(x) {
        if (x != undefined && x.className.indexOf('Amount') > -1) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            gstMaxValue = '@GSTMaxValue';
            gstAmt = amount * (parseFloat(gstMaxValue) / 100);
            $row.find(".GSTAmount").val(gstAmt.toFixed(2));
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaxValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;

        var thisTable = $('#tbl@(DataTableID)');

        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandAmount + grandGST;
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));

        CalculateSummary();
    }

    $(document).ready(function () {
        @(DataTableID)_Initialize();
        @(DataTableID)GetDDLListInputValues();
        if ('@Popup' == 'True') {
            @(DataTableID)_PopupInfo();
        }
        function @(DataTableID)_PopupInfo() {

            var HyperLinkTextInfo = '@HyperLinkTextInfo';
            if (HyperLinkTextInfo == null || HyperLinkTextInfo == '') {
            }
            else {
                var win = window.open(HyperLinkTextInfo, '_blank');
                if (win) {
                    //Browser has allowed it to be opened
                    win.focus();
                } else {
                    //Browser has blocked it
                    alert('Please allow popups for this website');
                }
            }
        }
    });
</script>