@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.GovernmentHospitalIncentive_ClaimsSubtypeName;
    string dtStrStart = ViewBag.GovernmentHospitalIncentive_StartDate;
    string dtStrEnd = ViewBag.GovernmentHospitalIncentive_EndDate;
    string Status = ViewBag.GovernmentHospitalIncentive_Status;
    string GSTEnabled = (ViewBag.GovernmentHospitalIncentive_GSTEnabled + "").ToLower();
    string GSTMaxValue = ViewBag.GovernmentHospitalIncentive_GSTMaxValue;
    string DailyRate = ViewBag.GovernmentHospitalIncentive_DailyRate;
    string MaxClaimableValue = ViewBag.GovernmentHospitalIncentive_MaxClaimable;
    string HyperLinkTextInfo = ViewBag.GovernmentHospitalIncentive_TextInfo;
    string SubmitterID = ViewBag.GovernmentHospitalIncentive_SubmitterID;
    string SubmitterName = ViewBag.GovernmentHospitalIncentive_SubmitterName;
    bool Popup = Model.SubTypeDetails == null ? true : false;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
    GSTMaxValue = String.IsNullOrEmpty(Model.GST.ToString()) ? "0" : Model.GST.ToString();
}

