@using ESS.Claim.ViewModels
@model ClaimVM
@{
    ViewBag.Title = "ClaimsApplication";
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime d1 = DateTime.Now.AddYears(-20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    bool gotItem = false;

    string strSubmissionLeadTime = ViewBag.ClaimSubmitdays;
    int SubmissionLeadTime = Convert.ToInt32(strSubmissionLeadTime);

    string minSubmissionDate = DateTime.Today.AddDays(-SubmissionLeadTime).ToString("dd/MM/yyyy");
    string maxSubmissionDate = DateTime.Today.ToString("dd/MM/yyyy");

    string OutstationID = Model.OutstationClaimID;
    string OutstationRef = ViewBag.OutstationRef;
    bool? DuplicateAttachment = ViewBag.DuplicateAttachment;
    bool IsPriorApprovalMandatory = ViewBag.IsPriorApprovalMandatory;

    //code for block submission
    string CurrentDatTime = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
    bool IsClaimMileageExceedThreshold = false;
    decimal ClaimMileageThreshold = 0;

    if (ViewBag.IsClaimMileageExceedThreshold != null)
    {
        IsClaimMileageExceedThreshold = ViewBag.IsClaimMileageExceedThreshold;
    }
    if (ViewBag.ClaimMileageThreshold != null)
    {
        ClaimMileageThreshold = ViewBag.ClaimMileageThreshold;
    }
}
<style>
    .ClaimStatus {
        display: none !important;
    }
</style>
@using (Html.BeginForm("ClaimsApplication", "Claims", FormMethod.Post))
{
    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
