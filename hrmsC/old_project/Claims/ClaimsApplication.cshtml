    function VerifyOutstationFormDate() {
        var startDateString = $('#StartDate').val() + " " + $('#StartTime').val();
        var endDateString = $('#EndDate').val() + " " + $('#EndTime').val();

        var StartDate = moment(startDateString, "DD/MM/YYYY HH:mm");
        var EndDate = moment(endDateString, "DD/MM/YYYY HH:mm");

        var oriOFStartDate = moment($('#hfStartDate').val());
        var oriOFEndDate = moment($('#hfEndDate').val());

        if (!oriOFStartDate || !oriOFEndDate) {
            return;
        }

        var warningNote = $('.OFDateWarningNote');
        warningNote.find(".note-message").html(
            '<b>Note : Start Date and/or End Date had been changed. </b><br />' +
            'Original Start Date Time : ' + oriOFStartDate.format('DD/MM/YYYY HH:mm') + '<br />' +
            'Original End Date Time : ' + oriOFEndDate.format('DD/MM/YYYY HH:mm') + '<br />'
        );

        if (!oriOFStartDate.isSame(StartDate) || !oriOFEndDate.isSame(EndDate)) {
            warningNote.show();
        }
        else {
            warningNote.hide();
        }

        $('.subtypeportlet .date-picker').each(function () {
            var minSubmissionDate = StartDate;
            var maxSubmissionDate = EndDate;

            var dpkMinSubmissionDate = null;
            var dpkMaxSubmissionDate = null;
            var dStartDate = $(this).datepicker('getStartDate');
            var dEndDate = $(this).datepicker('getEndDate');

            if (dStartDate.setHours) {
                dpkMinSubmissionDate = moment(dStartDate.setHours(0, 0, 0, 0));
            }

            if (dEndDate.setHours) {
                dpkMaxSubmissionDate = moment(dEndDate.setHours(0, 0, 0, 0));
            }

            if (dpkMinSubmissionDate != null && minSubmissionDate.isAfter(dpkMinSubmissionDate)) {
                $(this).datepicker('setStartDate', StartDate._d);
            }

            if (dpkMaxSubmissionDate != null && maxSubmissionDate.isBefore(dpkMaxSubmissionDate)) {
                $(this).datepicker('setEndDate', EndDate._d);
            }
        });
    }
