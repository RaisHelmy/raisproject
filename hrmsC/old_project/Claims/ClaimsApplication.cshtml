    function initDatepicker() {
        $('.subtypeportlet .date-picker').each(function () {
            var minSubmissionDate = moment('@minSubmissionDate', "DD/MM/YYYY");
            var maxSubmissionDate = moment('@maxSubmissionDate', "DD/MM/YYYY");

            var dpkMinSubmissionDate = null;
            var dpkMaxSubmissionDate = null;
            var dStartDate = $(this).datepicker('getStartDate');
            var dEndDate = $(this).datepicker('getEndDate');

            if (dStartDate.setHours) {
                dpkMinSubmissionDate = moment(dStartDate.setHours(0, 0, 0, 0));
            }

            if (dEndDate.setHours) {
                dpkMaxSubmissionDate = moment(dEndDate.setHours(0, 0, 0, 0));
            }

            if (dpkMinSubmissionDate != null && minSubmissionDate.isAfter(dpkMinSubmissionDate)) {
                $(this).datepicker('setStartDate', '@minSubmissionDate');
            }

            if (dpkMaxSubmissionDate != null && maxSubmissionDate.isBefore(dpkMaxSubmissionDate)) {
                $(this).datepicker('setEndDate', '@maxSubmissionDate');
            }
        });
    }

    function submitclaim(Type) {
        initDatepicker();
        var ErrorMessage = "";
        var ClaimTypeCode = $("[name='ClaimTypeCode']").val();
        if (ClaimTypeCode != "COH01" && ClaimTypeCode != "COB01") {
            if ($('#StartDate').val() == "") {
                alert("Please Fill In Start Date");
                return false;
            }
            if ($('#EndDate').val() == "") {
                alert("Please Fill In End Date");
                return false;
            }

            if ($('#StartTime').val() == "") {
                alert("Please Fill In Start Time");
                return false;
            }
            if ($('#EndTime').val() == "") {
                alert("Please Fill In End Time");
                return false;
            }

            var startDateString = $('#StartDate').val() + " " + $('#StartTime').val();
            var endDateString = $('#EndDate').val() + " " + $('#EndTime').val();

            var StartDate = moment(startDateString, "DD/MM/YYYY HH:mm")._d;
            var EndDate = moment(endDateString, "DD/MM/YYYY HH:mm")._d;

            if (EndDate <= StartDate) {
                alert('End Date/Time has to be later than Start Date/Time');
                return false;
            }


            if (($('#hfStartDate').val() != null && $('#hfStartDate').val() != "") && ($('#hfEndDate').val() != null && $('#hfEndDate').val() != ""))
            {
                var hfStartDate = moment($('#hfStartDate').val())._d;
                var hfEndDate = moment($('#hfEndDate').val())._d;

                //var hfStartDateString = (pad2(hfStartDate.getDate()) + '/' + pad2(hfStartDate.getMonth() + 1) + '/' + hfStartDate.getFullYear()) + " " + (pad2(hfStartDate.getHours()) + pad2(hfStartDate.getMinutes()));
                //var hfEndDateString = (pad2(hfEndDate.getDate()) + '/' + pad2(hfEndDate.getMonth() + 1) + '/' + hfEndDate.getFullYear()) + " " + (pad2(hfEndDate.getHours()) + pad2(hfEndDate.getMinutes()));

                //hfStartDate = moment(hfStartDateString, "DD/MM/YYYY HH:mm")._d;
                //hfEndDate = moment(hfEndDateString, "DD/MM/YYYY HH:mm")._d;

                //if (hfStartDate != "" && hfEndDate != "") {
                //    if (StartDate < hfStartDate || StartDate > hfEndDate) {
                //        alert('Start Date/Time enter is not in approved Start Date/Time range.');
                //        return false;
                //    }
                //    if (EndDate > hfEndDate || EndDate < hfStartDate) {
                //        alert('End Date/Time enter is not in approved End Date/Time range.');
                //        return false;
                //    }

                //}
            }

            //Only 1 subtype is allow as per claim for Day Trip Allowance (No GST),Subsistence Allowance (No GST),Subsistence Allowance (Multi) (No GST)
            var LimitSelection = 'Day Trip Allowance (No GST),Subsistence Allowance (No GST),Subsistence Allowance (Multi) (No GST)';
            var TravellingAllowanceCount = 0;
            $('.subtypeportlet .portlet-title').each(function () {
                var _temp = $(this).text().trim();
                var _split = _temp.split("-");
                _temp = _split[1].trim();
                if (LimitSelection.indexOf(_temp) != -1)
                {
                    TravellingAllowanceCount++;
                }
            });

            if (TravellingAllowanceCount > 1)
            {
                alert('Only one Claims Subtype selection is allow for the following subtype:\n- Day Trip Allowance (No GST)\n- Subsistence Allowance (No GST)\n- Subsistence Allowance (Multi) (No GST)');
                return false;
            }

            if (Type == 'Submit' ) {
                var today = new Date();
                //today.setHours(23, 59, 59, 999);

                var diff = today - EndDate;
                var days = diff / 1000 / 60 / 60 / 24;
                var Status = $('[name=Status]').val();

                //if ((days - 1) > 60) {
                //    alert('This claim should be submitted within 60 calendar day(s) from the Travel End Date.');
                //    return false;
                //}

                if ((days - 1) > '@ViewBag.ClaimSubmitdays') {
                    alert('This claim should be submitted within ' + '@ViewBag.ClaimSubmitdays' + ' calendar day(s) from the Travel End Date.');
                    $(this).val('');
                    // temp bypass, must reenable
                    return false;
                }

                if (EndDate >= today) {
                    alert('End Date has to be earlier than Today Date');
                    $(this).val('');
                    // temp bypass, must reenable
                    return false;
                }
            }

            if ($("[name='ClaimTypeCode']").val() == "COV01")
            {
                var tips = $("[name='Tips']").val();
                var forexloss = $("[name='ForexLoss']").val();
                var tipsCC = $("[name='TipsChargeCode']").val();
                var FLCC = $("[name='ForexLossChargeCode']").val();

                if (tips != "0.00" && tipsCC == "")
                {
                    alert("Please Select Tips Charge Code");
                    return false;
                }

                if (forexloss != "0.00" && FLCC == "")
                {
                    alert("Please Select Forex Loss Charge Code");
                    return false;
                }

            }

        }

        if (Type != 'Draft') {
            if (ClaimTypeCode != "COH01" && ClaimTypeCode != "COB01") {
                if (ValidateSubtypeDateRange()) {
                    return false;
                }
            }

            if (!ClaimSubtype_ValidateSelections()) {
                alert('Selected subtypes in claims subtype selection does not match the form. Please click the refresh button to update the form.');
                return false;
            }

            if ($('#Description').val() == "") {
                alert("Remarks is mandatory.");
                return false;
            }

            $('.subtypeportlet').each(function () {
                var tablename = this.id;

                var Error = eval(tablename + "Validation()");
                if (Error != '') {
                    ErrorMessage = ErrorMessage + '\n\r' + Error;
                }
            });

            if ($('#dis_NettTotal').html() == '0.00' || $('#dis_NettTotal').html() == '0')
                ErrorMessage = 'Total claims cannot be 0.\n';

            //validation added to check subtype total amount = 0
            var IsValidValue = $('.TotalAmount').filter(function (i, v) {
                //console.log(v.value);
                //console.log(!parseFloat(v.value) || parseFloat(v.value) <= 0);
                if (!parseFloat(v.value) || parseFloat(v.value) <= 0)
                {
                    if (!parseFloat(v.value) || parseFloat(v.value) <= 0) {
                        var row = $(v).closest('div.subtypeportlet');
                        //console.log(row.find('div.caption').text().trim());
                        if ($("[name='ClaimTypeCode']").val() == "COV01" || $("[name='ClaimTypeCode']").val() == "COS01")
                        {
                            var subtypeTitle = row.find('div.caption').text().trim();

                            if (subtypeTitle.indexOf("Flight") < 0) {

                                ErrorMessage += row.find('div.caption').text().trim() + ' Total Amount cannot be 0.\n';
                            }
                        }
                        else
                        {
                            ErrorMessage += row.find('div.caption').text().trim() + ' Total Amount cannot be 0.\n';
                        }
                    }
                    ErrorMessage += ''
                }
                return (!parseFloat(v.value) || parseFloat(v.value) <= 0);
            });

            if (ErrorMessage != "") {
                alert(ErrorMessage);
                return false;
            }

            if ($("#divDICText").css("visibility") == "visible" && !$("#DICText").val()) {
                ErrorMessage = "DIC Line Item Text field is mandatory.";
            }

            var regex = /^[a-z0-9!"#$%&'()*+,.\/:;<=>?@Html.Raw("@")\[\] ^_`{|}~-]*$/i;

            if ($("#divDICText").css("visibility") == "visible" && $("#DICText").val()) {
                if (regex.test($("#DICText").val()) == false) {
                    ErrorMessage = "DIC Line Item Text field contains illegal characters.";
                }
            }

            if (ErrorMessage != "") {
                alert(ErrorMessage);
                return false;
            }

            if (ClaimTypeCode == "COH01" || ClaimTypeCode == "COB01") {
                var fulldate = new Date();
                $('.subtypeportlet .date-picker input').each(function () {
                    //if (!this.value) {
                    //    return;
                    //}

                    var thisDate = moment(this.value, "DD/MM/YYYY")._d;

                    var twodatediff = fulldate - thisDate;
                    var diffdays = twodatediff / 1000 / 60 / 60 / 24;

                    if ((diffdays - 1) > '@ViewBag.ClaimSubmitdays') {
                        ErrorMessage = ErrorMessage + 'This claim should be submitted within ' + '@ViewBag.ClaimSubmitdays' + ' calendar day(s) from the Travel End Date.' + '\n\r';
                        $(this).val('');
                        //return false;
                    }
                    if (thisDate > fulldate) {
                        ErrorMessage = ErrorMessage + 'This claim does not allow future date submission.' + '\n\r';
                        $(this).val('');
                        //return false;
                    }

                });
                if (ErrorMessage != "") {
                    alert(ErrorMessage);
                    return false;
                }
            }
        }

        if (Type == 'Draft') {

            $('#ConfirmMessage').html(' Are you sure you want to Save this Claims Application?<br />Press Confirm to proceed, or Close to stay on the current page.')
            $('#btnSubmitForm').attr("submitValue", 'Draft');
            $('#ConfirmSubmit').modal();
        }
        else {
            if ($('#chkDisclaimer').parent().hasClass('checked')) {

                $('#ConfirmMessage').html(' Are you sure you want to Submit this Claims Application?<br />Press Confirm to proceed, or Close to stay on the current page.')
                $('#btnSubmitForm').attr("submitValue", 'Submit');
                $('#ConfirmSubmit').modal();
                if ($('#tblAttachment .dataTables_empty').length == 1) {
                    alert("Submit this claim without attachment?");
                }
            }
            else {
                alert('- Please read and check the Disclaimer section before proceeding to submit.\n');
            }
        }
    }

    // Helper function
    function convertDate(inputFormat) {
        function pad(s) { return (s < 10) ? '0' + s : s; }
        var d = new Date(inputFormat);
        return [pad(d.getDate()), pad(d.getMonth() + 1), d.getFullYear()].join('/');
    }

    function toDate(dateStr) {
        var parts = dateStr.split("/");
        return new Date(parts[2], parts[1] - 1, parts[0]);
    }

    function getParameterByName(name, url)
    {
        if (!url) url = window.location.href;
        name = name.replace(/[\[\]]/g, "\\$&");
        var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
            results = regex.exec(url);
        if (!results) return null;
        if (!results[2]) return '';
        return decodeURIComponent(results[2].replace(/\+/g, " "));
    }

    function SubmitForm() {
        var Type = $('#btnSubmitForm').attr("submitValue");
        $('#btnSubmitForm').attr("disabled", true);
        $('#ConfirmSubmit').modal('hide');
        $('#divLoading').show();
        var data = $('form').serializeArray();
        //Add in additional data to the original form data:
        data.push(
            { name: 'SubmitType', value: Type }
        );
        PerformClaimSubmission(data, Type);
    }

    function PerformClaimSubmission(data, Type) {
        $.ajax({
            url: '../Claims/SubmitClaimAction',
            type: 'POST',
            data: data,
            success: function (result) {

                $('#divLoading').hide();

                if (result.result == true) {
                    $('#SuccessSubmit').modal();
                    $('#SuccessMessage').html("Claims has been successfully " + Type + 'ed');
                    $('#btnOK').attr('href', '../Claims/ClaimsHistory');
                } else {

                    //Execution Timeout Expired handling
                    if (result.ErrorMessage.includes('Execution Timeout Expired')) {
                        alert('System is experiencing heavy traffic. Please try again later. Contact your system administration if the problem persists.');
                    } else {
                        alert(result.ErrorMessage);
                    }

                    $('#btnSubmitForm').attr("disabled", false);

                }
                // ... Process the result ...
            }
        });
    }

    function reorderTable(tableName) {
        var int = 0;
        var name = '';
        $.each($(tableName + ' tbody tr'), function (i, val) {

            $.each($(this).find('td [name]'), function (i, val) {
                var name = $(this).attr('name');
                $(this).attr('name', reorder(int, name));
                $(this).attr('id', reorder(int, name));
                // var column =  $(this).find('[name]').attr('name').split('.');
            });
            int++;

        });
    }

    function reorder(currentIndex, name) {
        if (typeof name === "undefined") { } else
        {
            var ColumnNaw = name.split('.');
            var replaceIndex = ColumnNaw[2].match(/\d+/g);
            ColumnNaw[2] = ColumnNaw[2].replace(replaceIndex, currentIndex);
            return ColumnNaw.join('.');
        }
    }

