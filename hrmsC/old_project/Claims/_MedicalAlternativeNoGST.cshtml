    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(9)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _TreatmentRate = $(this).children('td:eq(7)').children('input[type=text]');
            var _TotalMedical = $(this).children('td:eq(8)').children('input[type=text]');

            _TreatmentRate.prop('readonly', true);
            _TotalMedical.prop('readonly', true);

        });

        $(".@(DataTableID)RemoveCheckbox").uniform();
        BindtoDDL();
    }



    function @(DataTableID)GetDDLListInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());

            var _DDLSelect = $(this).children('td:eq(2)').children('select');
            var _DDLHidden = $(this).children('td:eq(2)').children('input[type=hidden]');
            _DDLSelect.val(_DDLHidden.val());
        });
    }

    function @(DataTableID)_CalculateSum(x) {

        var sum = 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;
        var MaxRate = 0;
        var totalMedical = 0;
        var thisTable = $('#tbl@(DataTableID)');

        var $row = $(x).closest("tr");
        var _TreatmentType = $row.find(".SubTypeColumn1").val();
        var _Amount = $row.find(".SubTypeColumn4").val();
        var _TotalMedical = $row.find(".Amount").val();
        var _GSTAmount = $row.find(".GSTAmount").val();
        var _TotalAmount = $row.find(".TotalAmount").val();

        if (_TreatmentType != "") {
            var MaxRate = 0;

            if (_TreatmentType == "Acupuncture") {
                MaxRate = "40.00";
                $row.find(".SubTypeColumn6").val(MaxRate);
            }

            if (_TreatmentType == "Chiropractic") {
                MaxRate = "100.00";
                $row.find(".SubTypeColumn6").val(MaxRate);
            }

            if (_TreatmentType == "Homeopathy") {
                MaxRate = "40.00";
                $row.find(".SubTypeColumn6").val(MaxRate);
            }

            MaxRate = MaxRate * 1;

            if (_Amount != "") {

                var myNumeric = parseFloat(_Amount.replace(/,/g, ''));
                if (!myNumeric) {
                    $row.find(".SubTypeColumn4").val('0.00');
                }
                else {
                    $row.find(".SubTypeColumn4").val(myNumeric.toFixed(2));
                }

                _Amount = _Amount * 1;

                if (parseFloat(_Amount) > parseFloat(MaxRate)) {
                    $row.find(".Amount").val(MaxRate.toFixed(2));
                    totalMedical = MaxRate;
                }
                else {

                    if (_Amount == "0.00") {
                        $row.find(".Amount").val(MaxRate.toFixed(2));
                        totalMedical = MaxRate;
                    }
                    else {
                        $row.find(".Amount").val(_Amount.toFixed(2));
                        totalMedical = _Amount;
                    }

                }
            }
            else {
                $row.find(".SubTypeColumn4").val('0.00');
                $row.find(".Amount").val(MaxRate.toFixed(2));
                totalMedical = MaxRate;
            }

            if ('@GSTEnabled' != 'false') {
                var gstMaxValue = '@GSTMaximumValue';
                if (totalMedical == MaxRate) {
                    gstAmt = 0;
                }
                else {
                    gstAmt = parseFloat(totalMedical) * (parseFloat(gstMaxValue) / 100);

                }

            }


            TotalAmount = parseFloat(totalMedical) + (parseFloat(gstAmt));

            if (TotalAmount > MaxRate) {
                gstAmt = MaxRate - parseFloat(totalMedical);
                TotalAmount = parseFloat(totalMedical) + (parseFloat(gstAmt));
            }
            $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            $row.find(".TotalAmount").val(TotalAmount.toFixed(2));
        }

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaximumValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSubtotal() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".TotalAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandTotal + (_TotalAmount * 1);
            }
        });
        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
        CalculateSummary();
    }

    $(document).ready(function () {
        @(DataTableID)_Initialize();
        @(DataTableID)GetDDLListInputValues();
    });
</script>