                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="submit" class="btn default blue" id="btnSubmitApprove" onclick="javascript: ApproverAction('Approved');">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="submit" class="btn default blue" id="btnSubmitReturn" onclick="javascript: ApproverAction('Returned');">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
