                <button type="submit" class="btn default blue" id="btnSubmitForm" value="Submit" onclick="javascript: SaveForm('Pending');">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="submit" class="btn default blue" id="btnSubmitSave" value="Draft" onclick="javascript: SaveForm('Draft');">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="submit" class="btn default blue" id="btnSubmitDelete" onclick="javascript: DeleteForm();">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
                <button type="submit" class="btn default blue" id="btnSubmitWithdraw" onclick="javascript: ApproverAction('Withdrawn');">
                    <i class="fa fa-check"></i>
                    Confirm
                </button>
