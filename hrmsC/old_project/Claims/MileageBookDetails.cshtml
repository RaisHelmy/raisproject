<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
    </p>
</div>
<!-- Scripts -->
<script type="text/javascript">
    var _Path = '/_layouts/15/TNBESS';
    //var _Path = '';

    function GetParameterByName(name) {
        name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
        var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
        results = regex.exec(location.search);
        return results === null ? "" : decodeURIComponent(results[1].replace(/\+/g, " "));
    }

    function NumberOnly(evt) {
        var theEvent = evt || window.event;
        var key = theEvent.keyCode || theEvent.which;
        key = String.fromCharCode(key);
        var regex = /[0-9]/;
        if (!regex.test(key)) {
            theEvent.returnValue = false;
            if (theEvent.preventDefault) theEvent.preventDefault();
        }
    }

    function ThousandSeparator(x) {
        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    function CalculateGrossDistance() {
        var _ReadingA = document.getElementById('ct_ReadingA').value;
        var _ReadingB = document.getElementById('ct_ReadingB').value;
        var _GrossDistance = document.getElementById('ct_GrossDistance');

        if (_ReadingA != '' && _ReadingB != '') {
            _GrossDistance.value = ThousandSeparator(parseInt(_ReadingB) - parseInt(_ReadingA));
        }
    }

    function CalculateTotalClaims() {
        var _ClaimableDistance = document.getElementById('ct_ClaimDistance').value;
        var _Rate = document.getElementById('ct_Rate').value;
        var _TotalClaims = document.getElementById('ct_TotalClaims');

        if (_ClaimableDistance != '' && _Rate != '') {
            _TotalClaims.value = ThousandSeparator((parseFloat(_ClaimableDistance) * parseFloat(_Rate)).toFixed(2));
        }
        else {
            _TotalClaims.value = '0.00';
        }
    }

    function MileageBook_removeRow() {
        $('#tblMileage tbody tr').not(':last').each(function () {
            var _checkbox = $(this).children('td:eq(0)').find('input[type=checkbox]');

            if ($('#tblMileage tbody tr').length == 2) {

            }
            else {
                if ($(_checkbox).parent().hasClass('checked')) {
                    $(_checkbox).closest('tr').remove();
                }
            }
        });

        AmountChange();
    }

    function MileageBook_add5Row() {
        MileageBook_addRow();
        MileageBook_addRow();
        MileageBook_addRow();
        MileageBook_addRow();
        MileageBook_addRow();
    }

    function MileageBook_addRow() {
        var _table = $('#tblMileage tr:last');
        var _rowFormat = '<tr class="trMileage">' +
                            '<td><div class="checker"><span><input type="checkbox" class="mbcheckbox"></span></div></td>' +
                            '<td><input type="hidden" class="hfChargeCode" />' +
                            '<select class="form-control ddlChargeCode" onchange="ChargeCodeChange(this);">' +
                            '<option value="">Select One</option></select></td>' +
                            '<td><input class="form-control text-right txtAmount" type="text" onblur="FormatAmountColumn(this)" onchange="AmountChange();" /></td></tr>';

        _table.before(_rowFormat);

        $('.mbcheckbox').parent().unbind('click');

        $('.mbcheckbox').parent().click(function () {
            if ($(this).hasClass('checked')) {
                $(this).removeClass('checked');
            }
            else {
                $(this).addClass('checked');
            }
        });

        BindtoDDL();
    }

    var origBindtoDDL = BindtoDDL;
    BindtoDDL = function () {
        // overwrite method here
        if (document.getElementById('ChargeCodeList') !== null) {
            var _ChargeCodeList = document.getElementById('ChargeCodeList').value;
            _ChargeCodeList = _ChargeCodeList.substring(0, _ChargeCodeList.length - 1);

            BindOptionToSelect(_ChargeCodeList);
        }

        return origBindtoDDL();
    }

    function BindOptionToSelect(ChargeCodeList) {
        var chargeCodes = ChargeCodeList.split(',');

        $('.ddlChargeCode').each(function () {
            $(this).find('option').remove().end().append('<option value="">Select One</option>');

            if (chargeCodes != '') {
                for (var i = 0; i < chargeCodes.length; i++) {
                    var option = document.createElement("option");
                    option.text = chargeCodes[i].trim();
                    option.value = chargeCodes[i].trim();
                    this.add(option);
                }

                //$(this).val($(this).siblings('.hfChargeCode').val());
                //if ($(this).val() == null) {
                //    $(this).children("option[value='']").attr('selected', 'selected');
                //}

                $(this).children("option[value='" + $(this).siblings('.hfChargeCode').val().trim() + "']").attr('selected', 'selected');
            }
        });
    }

    function ChargeCodeChange(x) {
        var _hfChargeCode = $(x).siblings('.hfChargeCode').val($(x).val());
    }

    function AmountChange() {
        var _Total = 0;

        $('.txtAmount').each(function () {
            var _Amount = parseFloat($(this).val().replace(/,/g, '')) || 0;
            _Total += _Amount;
        });

        $('#txtTotalAmount').val(ThousandSeparator(_Total.toFixed(2)));
    }

    function FormatAmountColumn(amountInput) {
        var amount = parseFloat(amountInput.value.replace(/,/g, ''));

        if (!amount) {
            amountInput.value = '0.00';
        }
        else {
            amountInput.value = ThousandSeparator(amount.toFixed(2));
        }
    }

    function GetChargeCodeDropDownDetails() {
        var _ChargeCodeDetails = [];

        $('.trMileage').each(function () {
            var _ChargeCode = $(this).find('.ddlChargeCode').val();
            var _Amount = $(this).find('.txtAmount').val();

            var _details = { ChargeCode: _ChargeCode, Amount: _Amount };

            _ChargeCodeDetails.push(_details);
        });

        return _ChargeCodeDetails;
    }

    function FormValidation() {
        var _Month = document.getElementById('ct_Month');
        var _Year = document.getElementById('ct_Year');
        var _ReadingA = document.getElementById('ct_ReadingA');
        var _ReadingB = document.getElementById('ct_ReadingB');
        var _ClaimableDistance = document.getElementById('ct_ClaimDistance');
        var _Rate = document.getElementById('ct_Rate');

        var _ValidationMsg = '';

        if (_Month.value == '')
            _ValidationMsg += '- Month field is required.\n';

        if (_Year.value == '')
            _ValidationMsg += '- Year field is required.\n';

        if (_ReadingA.value == '')
            _ValidationMsg += '- Month Start field is required.\n';

        if (_ReadingB.value == '')
            _ValidationMsg += '- Month End field is required.\n';

        if (_ClaimableDistance.value == '')
            _ValidationMsg += '- Claimable Distance field is required.\n';

        if (_Rate.value == '')
            _ValidationMsg += '- Rate field is required.\n';

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            var _TotalClaims = parseFloat($('#ct_TotalClaims').val()) || 0;
            var _TotalAmount = parseFloat($('#txtTotalAmount').val()) || 0;

            if (_TotalClaims == 0) {
                _ValidationMsg += '- Total Claims cannot be 0.00.\n';
                alert(_ValidationMsg);
                return false;
            }

            if (_TotalClaims != _TotalAmount) {
                _ValidationMsg += '- Total Claims and Total Amount does not tally.\n';
            }

            if (_ValidationMsg != null && _ValidationMsg != '') {
                alert(_ValidationMsg);
            }
            else {
                ConfirmAction('Submit');
            }
        }
    }

    function Decline_CommentMandatory() {
        var _ApproverComment = document.getElementById('txtAppComment').value;

        if (_ApproverComment == '') {
            alert('- Comment is required.');
            return false;
        }
        else {
            ConfirmAction('Return');
        }
    }

    function SaveForm(_Status) {
        if (_Status == 'Draft') {
            $(".Success-body .well").html('Your Mileage Book Application has been successfully saved.');
        }
        else {
            $(".Success-body .well").html('Your Mileage Book Application has been successfully submitted.');
        }

        jQuery.support.cors = true;

        var _ChargeCodeDetails = GetChargeCodeDropDownDetails();

        var form = {
            SourceID: GetParameterByName('ID'),
            EmployeeID: document.getElementById('hfEmployeeID').value,
            ReferenceNo: document.getElementById('ct_ReferenceNo').value,
            Status: _Status,
            Month: document.getElementById('ct_Month').value,
            Year: document.getElementById('ct_Year').value,
            ReadingA: document.getElementById('ct_ReadingA').value,
            ReadingB: document.getElementById('ct_ReadingB').value,
            GrossDistance: document.getElementById('ct_GrossDistance').value,
            ClaimableDistance: document.getElementById('ct_ClaimDistance').value,
            Rate: document.getElementById('ct_Rate').value,
            TotalClaims: document.getElementById('ct_TotalClaims').value,
            Remarks: document.getElementById('ct_Remarks').value,
            Details: _ChargeCodeDetails,
            ListOfChargeCode: document.getElementById('ChargeCodeList').value
        };

        $("#divLoading").css("display", "block");

        $.ajax({
            url: '@Url.Content("~/Claims/UpdateMileageBookForm")',
            type: 'POST',
            cache: false,
            async: false,
            dataType: "json",
            data: form,
            success: function (result) {
                if (result.Success) {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").css("display", "none");
                    $("#SuccessSubmit").modal();
                } else {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").css("display", "none");
                    alert(result.ErrorMsg);
                }
            },
            error: function (x, y, z) {
                $("#ConfirmUpdate").modal('toggle');
                $("#divLoading").css("display", "none");
                console.log(x + '\n' + y + '\n' + z);
            }
        });
    }

    function DeleteForm() {
        var ItemID = GetParameterByName('ID');

        jQuery.support.cors = true;

        $(".Success-body .well").html('Your Mileage Book Application has been deleted successfully' + '(' + $('#ct_ReferenceNo').val() + ')' + '.');
        $("#divLoading").show();

        $.ajax({
            url: _Path + '/API/MileageBookWebApi/GetDeleteMileageBook?ID=' + ItemID,
            type: 'GET',
            contentType: "application/json;charset=utf-8",
            success: function (result) {
                if (result) {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    $("#SuccessSubmit").modal();
                }
                else {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    alert('Deletion has failed! Please reload and try again.');
                }
            },
            error: function (x, y, z) {
                console.log(x + '\n' + y + '\n' + z);
            }
        });
    }

    function GetButtonConfiguration(_ID) {
        var _CurrEmpID = document.getElementById('hfEmployeeID').value;

        jQuery.support.cors = true;

        $.ajax({
            url: _Path + '/API/MileageBookWebApi/GetMileageBookActions?ID=' + _ID + '&CurrEmpID=' + _CurrEmpID,
            type: 'GET',
            contentType: "application/json;charset=utf-8",
            success: function (result) {
                if (result != null) {
                    SetButtonConfiguration(result);
                }
                else
                    console.log('failed!');
            },
            error: function (x, y, z) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

    function SetButtonConfiguration(result) {
        var _Source = GetParameterByName('Source');

        var ButtonWithdraw = document.getElementById('btnWithdraw');
        var ButtonAgree = document.getElementById('btnAgree');
        var ButtonApprove = document.getElementById('btnApprove');
        var ButtonReturn = document.getElementById('btnReturn');

        if (result.CanWithdraw == '1' && _Source == 'History') {
            ButtonWithdraw.style.display = '';
        }
        else {
            ButtonWithdraw.style.display = 'none';
        }

        if (result.CanAgree == '1' && _Source == 'InTray') {
            document.getElementById('DivApproval').style.display = 'block';
            ButtonAgree.style.display = '';
        }
        else {
            document.getElementById('DivApproval').style.display = 'none';
            ButtonAgree.style.display = 'none';
        }

        if (result.CanApprove == '1' && _Source == 'InTray') {
            document.getElementById('DivApproval').style.display = 'block';
            ButtonApprove.style.display = '';
        }
        else {
            document.getElementById('DivApproval').style.display = 'none';
            ButtonApprove.style.display = 'none';
        }

        if (result.CanReturn == '1' && _Source == 'InTray') {
            document.getElementById('DivApproval').style.display = 'block';
            ButtonReturn.style.display = '';
        }
        else {
            document.getElementById('DivApproval').style.display = 'none';
            ButtonReturn.style.display = 'none';
        }
    }

    function ApproverAction(_Action) {
        var _ID = GetParameterByName('ID');
        var _TaskID = GetParameterByName('TaskID');
        var _CurrentUserID = document.getElementById('hfEmployeeID').value;
        var _ApproverComment = document.getElementById('txtAppComment').value;
        var _ActivityName = '';
        var _OptionalApprover = false;

        jQuery.support.cors = true;

        $("#divLoading").show();

        var form = {
            ID: _ID,
            CurrentUserID: _CurrentUserID,
            Status: _Action,
            ApproverComment: _ApproverComment,
            TaskID: _TaskID,
            ActivityName: _ActivityName,
            OptionalApprover: _OptionalApprover
        };

        $.ajax({
            url: _Path + '/API/MileageBookWebApi/PostApproverAction',
            type: 'POST',
            data: JSON.stringify(form),
            contentType: "application/json;charset=utf-8",
            success: function (result) {
                if (result) {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();

                    if (_Action == "Withdrawn") {
                        $(".Success-body .well").html('Your Mileage Book Application has been successfully Withdrawn' + ' (' + $('#ct_ReferenceNo').val() + ')' + '.');
                    }
                    else if (_Action == "Agreed") {
                        $(".Success-body .well").html('The Mileage Book has been successfully Agreed' + ' (' + $('#ct_ReferenceNo').val() + ')' + '.');
                    }
                    else if (_Action == "Approved") {
                        $(".Success-body .well").html('The Mileage Book has been successfully Approved' + ' (' + $('#ct_ReferenceNo').val() + ')' + '.');
                    }
                    else if (_Action == "Returned") {
                        $(".Success-body .well").html('The Mileage Book has been successfully Returned' + ' (' + $('#ct_ReferenceNo').val() + ')' + '.');
                    }

                    $("#SuccessSubmit").modal();
                }
                else {
                    $("#ConfirmUpdate").modal('toggle');
                    $("#divLoading").hide();
                    alert('Your action on this Mileage Book Application has failed. Please reload and try again.');
                }
            },
            error: function (x, y, z) {
                $("#ConfirmUpdate").modal('toggle');
                $("#divLoading").hide();
                console.log(x + '\n' + y + '\n' + z);
            }
        });
    }

    function ConfirmAction(_Action) {
        if (_Action == 'SaveAsDraft') {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').removeClass('hidden_1');
            $('#btnSubmitDelete').addClass('hidden_1');
            $('#btnSubmitWithdraw').addClass('hidden_1');
            $('#btnSubmitAgree').addClass('hidden_1');
            $('#btnSubmitApprove').addClass('hidden_1');
            $('#btnSubmitReturn').addClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Save this Mileage Book Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Draft'); });
            $('#ConfirmUpdate').modal('show');
        }
        else if (_Action == 'Submit') {
            $('#btnSubmitForm').removeClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('#btnSubmitDelete').addClass('hidden_1');
            $('#btnSubmitWithdraw').addClass('hidden_1');
            $('#btnSubmitAgree').addClass('hidden_1');
            $('#btnSubmitApprove').addClass('hidden_1');
            $('#btnSubmitReturn').addClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Submit this Mileage Book Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Submit'); });
            $('#ConfirmUpdate').modal('show');
        }
        else if (_Action == 'Delete') {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('#btnSubmitDelete').removeClass('hidden_1');
            $('#btnSubmitWithdraw').addClass('hidden_1');
            $('#btnSubmitAgree').addClass('hidden_1');
            $('#btnSubmitApprove').addClass('hidden_1');
            $('#btnSubmitReturn').addClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Delete this Mileage Book Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Delete'); });
            $('#ConfirmUpdate').modal('show');
        }
        else if (_Action == "Withdraw") {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('#btnSubmitDelete').addClass('hidden_1');
            $('#btnSubmitWithdraw').removeClass('hidden_1');
            $('#btnSubmitAgree').addClass('hidden_1');
            $('#btnSubmitApprove').addClass('hidden_1');
            $('#btnSubmitReturn').addClass('hidden_1');
            $('.modal-body .well').html('Are you sure you want to Withdraw this Mileage Book Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Withdraw'); });
            $('#ConfirmUpdate').modal('show');
        }
        else if (_Action == "Agree") {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('#btnSubmitDelete').addClass('hidden_1');
            $('#btnSubmitWithdraw').addClass('hidden_1');
            $('#btnSubmitAgree').removeClass('hidden_1');
            $('#btnSubmitApprove').addClass('hidden_1');
            $('#btnSubmitReturn').addClass('hidden_1');
            $('.modal-body .well').html('Confirm to Agree this Mileage Book Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Agree'); });
            $('#ConfirmUpdate').modal('show');
        }
        else if (_Action == "Approve") {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('#btnSubmitDelete').addClass('hidden_1');
            $('#btnSubmitWithdraw').addClass('hidden_1');
            $('#btnSubmitAgree').addClass('hidden_1');
            $('#btnSubmitApprove').removeClass('hidden_1');
            $('#btnSubmitReturn').addClass('hidden_1');
            $('.modal-body .well').html('Confirm to Approve this Mileage Book Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Approve'); });
            $('#ConfirmUpdate').modal('show');
        }
        else if (_Action == "Return") {
            $('#btnSubmitForm').addClass('hidden_1');
            $('#btnSubmitSave').addClass('hidden_1');
            $('#btnSubmitDelete').addClass('hidden_1');
            $('#btnSubmitWithdraw').addClass('hidden_1');
            $('#btnSubmitAgree').addClass('hidden_1');
            $('#btnSubmitApprove').addClass('hidden_1');
            $('#btnSubmitReturn').removeClass('hidden_1');
            $('.modal-body .well').html('Confirm to Return this Mileage Book Application?\n\rPress Confirm to proceed, or Close to stay on the current page.');
            $('#btnOK').click(function () { RedirectTo('Return'); });
            $('#ConfirmUpdate').modal('show');
        }
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "Agree":
            case "Approve":
            case "Return":
                window.location.href = '/_layouts/15/TNBESS/MSS/MileageBookInTray';  //'/_layouts/15/essv2/MSS/MileageBookInTray'; // 
                break;
            case "Draft":
            case "Submit":
            case "Delete":
            case "Withdraw":
                window.location.href = '/_layouts/15/TNBESS/Claims/MileageBookHistory'; //'/_layouts/15/essv2/Claims/MileageBookHistory'; // 
                break;
            default:
                window.location.href = '/Pages/default.aspx';
        }
    }

    function BackRedirect() {
        if (document.referrer == "" || document.URL == document.referrer) {
            window.location.href = '/_layouts/15/essv2/Claims/MileageBookHistory';
        } else {
            window.location.href = document.referrer;
        }
    }
    $(document).ready(function () {
        $("#ct_Month").val($('#hfMonth').val());
        $("#ct_Year").val($('#hfYear').val());
        $("#ct_Rate").val($('#hfRate').val());

        GetButtonConfiguration(GetParameterByName('ID'));
        BindtoDDL();
        AmountChange();
    });
</script>