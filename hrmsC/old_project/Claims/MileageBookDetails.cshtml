@model Tuple<List<ESS.Core.MileageBookDetails>, List<ESS.Core.DropDownObject>, List<SEP.RoutingManagement.Models.GetApprovalAuditLog>>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Mileage Book Details";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd/MM/yyyy");
    string dtStrEnd = d2.ToString("dd/MM/yyyy");
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Mileage Book Application
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
@if (!@ViewBag.CanSubmit)
{
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    Sorry, You are not allowed to submit this application.
                    Immediate Manager not found, please contact administrator for assistance.
                </h4>
            </div>
        </div>
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    Invalid Mileage Book ID.
                </h4>
            </div>
        </div>
    </div>
}

<input id="hfEmployeeID" type="hidden" value="@ViewBag.EmployeeID" />
<style type="text/css">
    .hidden_1 {
        display: none;
    }
</style>
<div id="tab_1" class="tab-pane active">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Requestor Details
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee Number</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_EmployeeCode">@Model.Item1[0].EmployeeNumber</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Company</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Company">@Model.Item1[0].Company</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee Name</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_EmployeeName">@Model.Item1[0].EmployeeName</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Department</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Department">@Model.Item1[0].Department</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Position</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_Position">@Model.Item1[0].Position</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Unit/Section</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_UnitSection">@Model.Item1[0].UnitSection</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Immediate Manager</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_ImmediateManager">@Model.Item1[0].ImmediateManager</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Current Approver</label>
                                        <div class="col-md-8 form-control-static">
                                            <label id="ct00_CurrentApprover">@ViewBag.CurrApp</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Mileage Book
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body" id="ct01_CustomFieldFormView">
                        <input type="hidden" id="FormID" value="FE3A5D7C-39CD-4E9A-94E3-011D82C27C70" />
                        <input type="hidden" id="InstanceID" value="{InstanceID}" />
                        <input type="hidden" id="ct_CurrEmpID" />
                        <input type="hidden" id="ct_SubmissionDate" />
                        <input type="hidden" id="hfStatus" value="@Model.Item1[0].Status" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Reference No.</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="ct_ReferenceNo" value="@Model.Item1[0].ReferenceNo" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Status</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="ct_Status" value="@Model.Item1[0].Status" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Month<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" id="hfMonth" value="@Model.Item1[0].Month" />
                                            @if (@Model.Item1[0].Status == "Draft")
                                            {
                                                <select class="form-control" id="ct_Month">
                                                    <option value="">Select One</option>
                                                    <option value="January">January</option>
                                                    <option value="February">February</option>
                                                    <option value="March">March</option>
                                                    <option value="April">April</option>
                                                    <option value="May">May</option>
                                                    <option value="June">June</option>
                                                    <option value="July">July</option>
                                                    <option value="August">August</option>
                                                    <option value="September">September</option>
                                                    <option value="October">October</option>
                                                    <option value="November">November</option>
                                                    <option value="December">December</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="form-control" type="text" id="ct_Month" value="@Model.Item1[0].Month" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Year<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" id="hfYear" value="@Model.Item1[0].Year" />
                                            @if (@Model.Item1[0].Status == "Draft")
                                            {
                                                <select class="form-control" id="ct_Year">
                                                    <option value="">Select One</option>
                                                    @{
                                                        int _StartYear = DateTime.Now.AddYears(-1).Year;
                                                        int _EndYear = DateTime.Now.Year;

                                                        while (_StartYear <= _EndYear)
                                                        {
                                                            <option value="@_StartYear">@_StartYear</option>
                                                            _StartYear++;
                                                        }
                                                    }
                                                </select>
                                                        }
                                                        else
                                                        {
                                                            <input class="form-control" type="text" id="ct_Year" value="@Model.Item1[0].Year" readonly />
                                                        }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Month Start [A]<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            @if (@Model.Item1[0].Status == "Draft")
                                            {
                                                <input class="form-control" type="text" id="ct_ReadingA" value="@Model.Item1[0].ReadingA"
                                                       onkeyup="CalculateGrossDistance();" onkeypress="NumberOnly(event);" onpaste="return false" />
                                            }
                                            else
                                            {
                                                <input class="form-control" type="text" id="ct_ReadingA" value="@Model.Item1[0].ReadingA" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Month End [B]<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            @if (@Model.Item1[0].Status == "Draft")
                                            {
                                                <input class="form-control" type="text" id="ct_ReadingB" value="@Model.Item1[0].ReadingB"
                                                       onkeyup="CalculateGrossDistance();" onkeypress="NumberOnly(event);" onpaste="return false" />
                                            }
                                            else
                                            {
                                                <input class="form-control" type="text" id="ct_ReadingB" value="@Model.Item1[0].ReadingB" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Gross Distance [B - A]</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="ct_GrossDistance" value="@Model.Item1[0].GrossDistance" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Claimable Distance<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            @if (@Model.Item1[0].Status == "Draft")
                                            {
                                                <input class="form-control" type="text" id="ct_ClaimDistance" value="@Model.Item1[0].ClaimableDistance"
                                                       onkeyup="CalculateTotalClaims();" onkeypress="NumberOnly(event);" onpaste="return false" />
                                            }
                                            else
                                            {
                                                <input class="form-control" type="text" id="ct_ClaimDistance" value="@Model.Item1[0].ClaimableDistance" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Rate<span class="mandatory"> *</span></label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" id="hfRate" value="@Model.Item1[0].Rate" />
                                            @if (@Model.Item1[0].Status == "Draft")
                                            {
                                                @Html.DropDownList("ct_Rate", new SelectList(Model.Item2, "Value", "Text"),
                                                                   "Select One",
                                                                   new { @class = "bs-select form-control", onchange = "CalculateTotalClaims();" })
                                            }
                                            else
                                            {
                                                <input class="form-control" type="text" id="ct_Rate" value="@Model.Item1[0].Rate" readonly />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Total Claims</label>
                                        <div class="col-md-8 form-control-static">
                                            <input class="form-control" type="text" id="ct_TotalClaims" value="@Model.Item1[0].TotalClaims" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Remarks</label>
                                        <div class="col-md-10 form-control-static">
                                            @if (@Model.Item1[0].Status == "Draft")
                                            {
                                                <textarea class="form-control" id="ct_Remarks" rows="6" style="width:100%;">@Model.Item1[0].Remarks</textarea>
                                            }
                                            else
                                            {
                                                <textarea class="form-control" id="ct_Remarks" rows="6" style="width:100%;" readonly>@Model.Item1[0].Remarks</textarea>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (@Model.Item1[0].Status == "Draft")
    {
        @Html.Action("ChargeCodeControl", "ChargeCode", new { ID = @ViewBag.ApplicationID, ListOfChargeCode = "" })
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Mileage Details
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body" id="ct02_CustomFieldFormView">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="table-toolbar">
                                            <table id="tblMileage" class="table table-striped table-bordered table-hover table-full-width">
                                                <thead>
                                                    <tr>
                                                        <th class="text-center" style="width:5%"></th>
                                                        <th class="text-center" style="width:50%;">Charge Code</th>
                                                        <th class="text-center" style="width:45%;">Amount</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in @Model.Item1)
                                                    {
                                                        <tr class="trMileage">
                                                            <td><input type="checkbox" class="MileageBookRemoveCheckbox" /></td>
                                                            <td>
                                                                <input type="hidden" class="hfChargeCode" value="@item.ChargeCode" />
                                                                <select class="form-control ddlChargeCode" onchange="ChargeCodeChange(this);">
                                                                    <option value="">Select One</option>
                                                                </select>
                                                            <td><input class="form-control text-right txtAmount" type="text" value="@item.Amount" onblur="FormatAmountColumn(this)" onchange="AmountChange();" /></td>
                                                        </tr>
                                                    }
                                                    <tr>
                                                        <td colspan="2" class="text-right">Total</td>
                                                        <td><input class="form-control text-right" type="text" id="txtTotalAmount" value="@Model.Item1[0].TotalClaims" readonly /></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="table-toolbar">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="btn-group">
                                                        <a class="BtnPlus btn green" href="javascript:MileageBook_addRow();">
                                                            Add Row
                                                            <i class="fa fa-plus"></i>
                                                        </a>
                                                    </div>
                                                    <div class="btn-group">
                                                        <a class="BtnPlus5 btn green" href="javascript:MileageBook_add5Row();">
                                                            Add 5 Rows
                                                            <i class="fa fa-plus"></i>
                                                        </a>
                                                    </div>
                                                    <div class="btn-group">
                                                        <a class="deleteall btn red" href="javascript:MileageBook_removeRow();">
                                                            Delete Row
                                                            <i class="fa fa-minus"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Mileage Details
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body" id="ct02_CustomFieldFormView">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="table-toolbar">
                                            <table id="tblMileage" class="table table-striped table-bordered table-hover table-full-width">
                                                <thead>
                                                    <tr>
                                                        <th class="text-center" style="width: 50%;">Charge Code</th>
                                                        <th class="text-center" style="width: 50%;">Amount</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in @Model.Item1)
                                                    {
                                                        <tr>
                                                            <td><input class="form-control" type="text" value="@item.ChargeCode" readonly /></td>
                                                            <td><input class="form-control text-right txtAmount" type="text" value="@item.Amount" readonly /></td>
                                                        </tr>
                                                    }
                                                    <tr>
                                                        <td class="text-right">Total</td>
                                                        <td><input class="form-control text-right" type="text" id="txtTotalAmount" value="@Model.Item1[0].TotalClaims" readonly /></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (@Model.Item1[0].Status == "Draft")
    {
        @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "Add", SourceType = "MileageBook", RequestID = ViewBag.ApplicationID })
    }
    else
    {
        @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "View", SourceType = "MileageBook", RequestID = ViewBag.ApplicationID })
    }
    @if (@Model.Item1[0].Status != "Draft")
    {
        <div class="row" id="DivAuditLog">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Audit Log
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="form-horizontal">
                                <div class="table-toolbar">
                                    <table id="tblAuditLog" class="table table-striped table-bordered table-hover table-full-width">
                                        <thead>
                                            <tr>
                                                <th style="width:15%;">Action By</th>
                                                <th style="width:15%;">Date</th>
                                                <th style="width:15%;">Activity</th>
                                                <th style="width:15%;">Action</th>
                                                <th style="width:40%;">Comment</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (@Model.Item3 != null && @Model.Item3.Count > 0)
                                            {
                                                foreach (var item in @Model.Item3)
                                                {
                                                    <tr>
                                                        <td>@item.EmployeeName</td>
                                                        <td>@item.FormattedDate</td>
                                                        <td>@item.ActivityName</td>
                                                        <td>@item.ActivityAction</td>
                                                        <td>@item.Comment</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="row" id="DivApproval" style="display:none;">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Approval Comments
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Comments</label>
                                        <div class="col-md-10 form-control-static">
                                            <textarea class="form-control" id="txtAppComment" rows="5" cols="60"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        @if (@Model.Item1[0].Status == "Draft")
        {
            <input type="button" class="btn green" value="Save As Draft" id="btnSave" onclick="ConfirmAction('SaveAsDraft');" />
            if (!@ViewBag.CanSubmit)
            {
                <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="FormValidation();" disabled />
            }
            else
            {
                <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="FormValidation();" />
            }
            <input type="button" class="btn green" value="Delete" id="btnDelete" onclick="ConfirmAction('Delete');" />
        }
        <input type="button" class="btn green" value="Withdraw" id="btnWithdraw" onclick="ConfirmAction('Withdraw');" style="display:none;" />
        <input type="button" class="btn green" value="Agree" id="btnAgree" onclick="ConfirmAction('Agree');" style="display:none;" />
        <input type="button" class="btn green" value="Approve" id="btnApprove" onclick="ConfirmAction('Approve');" style="display:none;" />
        <input type="button" class="btn green" value="Return" id="btnReturn" onclick="Decline_CommentMandatory();" style="display:none;" />
