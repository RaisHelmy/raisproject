@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Advance Claim History";
    DateTime d1 = DateTime.Now;
    string beginDate = d1.AddMonths(-2).ToString("dd/MM/yyyy");
    string defaultDate = d1.ToString("dd/MM/yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            My Advance Claims History<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Start Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="StartDate" name="StartDate" value="@beginDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">End Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="EndDate" name="EndDate" value="@defaultDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Claims Category</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="RequestType">
                            <option value="">- All -</option>
                            <option value="Outstation / Local">Outstation/Local</option>
                            <option value="Oversea">Oversea</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option value="">- All -</option>
                            <option value="0">Draft</option>
                            <option value="11">Pending</option>
                            <option value="3">Approved</option>
                            <option value="4">Returned</option>
                            <option value="5">Withdrawn</option>
                            <option value="6">Processed</option>
                            <option value="7">Paid</option>
                            <option value="8">Failed</option>
                            <option value="10">ProcessedWithoutPayment</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function SearchListing() {
        var _StartDate = $('#StartDate').val();
        var _EndDate = $('#EndDate').val();
        var _ModeOfTransport = $('#RequestType').val();
        var _Status = $('#Status').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Claims/_AdvanceClaimsHistorySearchResult")',
            cache: false,
            dataType: "html",
            data: { StartDate: _StartDate, EndDate: _EndDate, RequestType: _ModeOfTransport, StatusCode: _Status },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        
        SearchListing();
      //  $('.date-picker').datepicker();

        //SearchListing();
    });
</script>
