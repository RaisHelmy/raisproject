                                        <td><input type="text" class="form-control SubTypeColumn11" value="@thisDetail.SubTypeColumn11" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn11" readonly /></td>
                                        <td><input type="text" class="form-control SubTypeColumn12" value="@thisDetail.SubTypeColumn12" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn12" readonly /></td>
