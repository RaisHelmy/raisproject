    function @(DataTableID)_Initialize() {
        $('#tbl@(DataTableID) .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tbl@(DataTableID) .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tbl@(DataTableID) .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(16)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _subtotal = $(this).children('td:eq(11)').children('input[type=text]');
            var _Amount = $(this).children('td:eq(15)').children('input[type=text]');
            _subtotal.prop('readonly', true);
            _Amount.prop('readonly', true);
        });
    }
    function HandphoneBillCalculation()
    {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');

        //iterate through each textboxes and add the values
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _SelectedType = $row.find(".SubTypeColumn1").val();
            var _MonthCharge = $row.find(".SubTypeColumn4").val();
            var _ChargeUsage = $row.find(".SubTypeColumn5").val();
            var _OnNet = $row.find(".SubTypeColumn6").val();
            var _OffNet = $row.find(".SubTypeColumn7").val();
            var _DomesticCall = $row.find(".SubTypeColumn8").val();
            var _DomesticSMS = $row.find(".SubTypeColumn9").val();
            var _Other = $row.find(".SubTypeColumn10").val();
            var _SubTotal = $row.find(".SubTypeColumn11").val();
            var _ServiceTax = $row.find(".SubTypeColumn12").val();
            var _Discount = $row.find(".SubTypeColumn13").val();
            var _@(DataTableID) = $row.find(".SubTypeColumn14").val();
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".SubTotalAmount").val();

            if (_SelectedType != "") {
                if (isNaN(_MonthCharge) || _MonthCharge.length == 0) { $row.find(".SubTypeColumn4").val("0.00"); }
                if (isNaN(_ChargeUsage) || _ChargeUsage.length == 0) { $row.find(".SubTypeColumn5").val("0.00"); }
                if (isNaN(_OnNet) || _OnNet.length == 0) { $row.find(".SubTypeColumn6").val("0.00"); }
                if (isNaN(_OffNet) || _OffNet.length == 0) { $row.find(".SubTypeColumn7").val("0.00"); }
                if (isNaN(_DomesticCall) || _DomesticCall.length == 0) { $row.find(".SubTypeColumn8").val("0.00"); }
                if (isNaN(_DomesticSMS) || _DomesticSMS.length == 0) { $row.find(".SubTypeColumn9").val("0.00"); }
                if (isNaN(_Other) || _Other.length == 0) { $row.find(".SubTypeColumn10").val("0.00"); }
                if (isNaN(_SubTotal) || _SubTotal.length == 0) { $row.find(".SubTypeColumn11").val("0.00"); }
                if (isNaN(_ServiceTax) || _ServiceTax.length == 0) { $row.find(".SubTypeColumn12").val("0.00"); }
                if (isNaN(_Discount) || _Discount.length == 0) { $row.find(".SubTypeColumn13").val("0.00"); }
                if (isNaN(_@(DataTableID)) || _@(DataTableID).length == 0) { $row.find(".SubTypeColumn14").val("0.00"); }

                var SubTotal = parseFloat(_MonthCharge) + parseFloat(_ChargeUsage) - parseFloat(_OnNet) - parseFloat(_OffNet) - parseFloat(_DomesticCall) - parseFloat(_DomesticSMS) - parseFloat(_Other);
                $row.find(".SubTypeColumn11").val(SubTotal);

                var HandphoneBill = parseFloat(SubTotal) + parseFloat(_ServiceTax) - parseFloat(_Discount);
                $row.find(".SubTypeColumn14").val(HandphoneBill);

                var MaxClaimable = 0;
                if (_SelectedType == "Prepaid") {
                    MaxClaimable = '@PrepaidMaxClaimable';
                }
                else {
                    MaxClaimable = '@PostpaidMaxClaimable';
                }
                var TotalClaimable = 0;
                if (parseFloat(HandphoneBill) >= parseFloat(MaxClaimable)) {
                    TotalClaimable = parseFloat(MaxClaimable);
                }
                else {
                    TotalClaimable = parseFloat(HandphoneBill);
                }
                $row.find(".Amount").val(TotalClaimable);

                var gstAmt = 0;
                if ('@GSTEnabled' != 'false') {
                    var gstMaxValue = '@GSTMaximumValue';
                    gstAmt = parseFloat(TotalClaimable) * (parseFloat(gstMaxValue) / 100);
                }
                $row.find(".GSTAmount").val(gstAmt);

                var TotalAmount = 0;
                TotalAmount = parseFloat(TotalClaimable) + (parseFloat(gstAmt));
                $row.find(".SubTotalAmount").val(TotalAmount);
            }
            else
            {
            }

        });
    }

