                                            <td><input type="text" class="form-control SubTypeColumn2" value="@thisDetail.SubTypeColumn2" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn2" /></td>
