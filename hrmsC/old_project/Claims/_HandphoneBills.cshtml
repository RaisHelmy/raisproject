                                        <td><input type="text" class="form-control SubTypeColumn2" value="@thisDetail.SubTypeColumn2" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn2" readonly /></td>
                                        <td><input type="text" class="form-control SubTypeColumn3" value="@thisDetail.SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn3" readonly /></td>
                                        <td><input type="text" class="form-control SubTypeColumn4" value="@thisDetail.SubTypeColumn4" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn4" readonly /></td>
