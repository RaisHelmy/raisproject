</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_@(DataTableID)Validation() { // @(DataTableID)Validation
        var _ValidationMsg = '';
        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _SelectedType = $row.find(".SubTypeColumn1").val();
            var _StatementDate = $row.find(".SubTypeColumn3").val();
            var _ChargeUsage = $row.find(".SubTypeColumn5").val();

            if (_ChargeUsage == null || _ChargeUsage == '') {
                _ValidationMsg += '- Handphone Bills (Chargable Usage) is required.\n'
            }

            if (_SelectedType == null || _SelectedType == '') {
                _ValidationMsg += '- Handphone Bills (Subcription Type) is required.\n'
            }

            if (_StatementDate == null || _StatementDate == '') {
                _ValidationMsg += '- Handphone Bills (Statement Date) is required.\n'
            }
        });
        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="@(DataTableID)RemoveCheckbox"]:checked'), function (i, val) {
            var row = $(this).closest("tr").get(0);
            var id = $(this).attr("id");
