@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.HandphoneBills_ClaimsSubtypeName;
    string GSTEnabled = (@ViewBag.HandphoneBills_GSTEnabled + "").ToLower();
    string Status = @ViewBag.HandphoneBills_Status;
    string dtStrStart = @ViewBag.HandphoneBills_StartDate;
    string dtStrEnd = @ViewBag.HandphoneBills_EndDate;
    string GSTMaximumValue = ViewBag.HandphoneBills_GSTMaximumValue;
    string PostpaidMaxClaimable = ViewBag.HandphoneBills_PostpaidMaxClaimable;
    string PrepaidMaxClaimable = ViewBag.HandphoneBills_PrepaidMaxClaimable;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
    GSTMaximumValue = String.IsNullOrEmpty(Model.GST.ToString()) ? "0" : Model.GST.ToString();
}

<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimsSubtypeName
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Subscription Type *</th>
                                <th scope="col">Handphone No.</th>
                                <th scope="col">StatementDate</th>
                                <th scope="col">Monthly Charges (RM)</th>
                                <th scope="col">(+) Chargable Usage (RM) *</th>
                                <th scope="col">(-) Personal Calls - On Net Calls (RM)</th>
                                <th scope="col">(-) Personal Calls - Off Net Calls (RM)</th>
                                <th scope="col">(-) Personal Calls - Domestic Calls (RM)</th>
                                <th scope="col">(-) Personal Calls - Domestic SMS (RM)</th>
                                <th scope="col">(-) Personal Calls - Others (RM)</th>
                                <th scope="col">Subtotal (RM)</th>
                                <th scope="col">(+) Service Tax (RM)</th>
                                <th scope="col">(-) Discounts / Rebates (RM)</th>
                                <th scope="col">Total Handphone Bill (RM)</th>
                                <th scope="col">Total Claimable (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @{
                            List<SelectListItem> SubscriptionTypeList = new List<SelectListItem>();
                            SubscriptionTypeList.Add(new SelectListItem { Text = "- Please Select -", Value = "" });
                            SubscriptionTypeList.Add(new SelectListItem { Text = "Postpaid", Value = "Postpaid" });
                            SubscriptionTypeList.Add(new SelectListItem { Text = "Prepaid", Value = "Prepaid" });
                        }

                        @Html.DropDownList("HiddenDDL", SubscriptionTypeList, new { @id = "HiddenDDL", @class = "bs-select form-control hidden hiddenDDL", @style = "min-width:200px" })


                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn1", SubscriptionTypeList, new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn1", @class = "bs-select form-control SubTypeColumn1", @style = "min-width:200px" })
                                        </td>
                                        <td><input type="text" class="form-control SubTypeColumn2" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" /></td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn4" onkeyup="HandphoneBillCalculation()"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn5" onkeyup="HandphoneBillCalculation()"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn6" onkeyup="HandphoneBillCalculation()"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn7" onkeyup="HandphoneBillCalculation()"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn8" onkeyup="HandphoneBillCalculation()"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn9" onkeyup="HandphoneBillCalculation()"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn9"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn9" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn10" onkeyup="HandphoneBillCalculation()"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn10"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn10" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn11"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn11"
