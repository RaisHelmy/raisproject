@model ESS.AdvanceClaim.Models.AdvanceClaim
@{
    ViewBag.Title = "Advance Claims Application";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool gotItem = false;
}
<script type="text/javascript" src="/Assets/plugins/jquery-inputmask/jquery.inputmask.bundle.min.js"></script>

@using (Html.BeginForm("AdvanceClaimsApplication", "Claims", FormMethod.Post))
{

    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
                    Advance Claims Application
                    <span style="padding-left:20px;">
                        <small>@Model.RequestType</small>
                    </span>
                </h1>
            </div>
        </div>
    </div>

    <!-- Employee Details -->
    @Html.Partial("_EmployeeInfoClaim", Model.Submiter)

    <input type="hidden" name="EquivalentPayScaleGroup" value="@Model.EquivalentPayScaleGroup" />

    <!-- Claims Particular -->
    @Html.Partial("_AdvanceClaimsParticular", Model)



    @Html.Partial("_AdvanceClaimDetail", Model)


    <!-- Attachment -->
    @Html.Action("AttachmentControl", "Attachment", new { EmployeeID = @Model.Submiter.ID, Mode = "New", SourceType = "AdvanceClaims" })



    <!-- Disclaimer -->
    <div class="row">
        <div class="col-md-12">
            <input type="checkbox" id="chkDisclaimer"> <b>Jika saya gagal mengemukakan tuntutan dan atau menjelaskan wang pendahuluan perjalanan yang berlebihan dalam tempoh satu (1) bulan seperti di atas, saya bersetuju dan menganggap tuntutan yang melebihi tempoh satu (1) bulan akan lupus serta membenarkan TNB untuk memotong keseluruhan atau mana-mana bahagian jumlah yang diambil sebagai wang pendahuluan perjalanan saya. TNB turut berhak membuat potongan gaji dengan jumlah yang maksimum untuk memastikan penjelasan pendahuluan dapat diselesaikan dengan segera.</b>
        </div>
    </div>

    <br />

    <!-- Buttons -->
    <div class="row">
        <div class="col-md-12">
            <input type="button" class="btn green" value="Save as Draft" id="btnDraft" onclick="submitclaim('Draft'); " />

            <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="submitclaim('Submit'); " />

        </div>
    </div>


    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div id="SuccessSubmitMessage" class="well">
                        Claims has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <a class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmDraft" tabindex="-1" role="basic" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Save this Advance Claim Application?<br />
                        Press Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmitForm" onclick="SubmitForm('Draft'); return false;">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="ConfirmSubmit" tabindex="-1" role="basic" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Submit this Advance Claims Application?<br />
                        Press Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmitForm" onclick="SubmitForm('Submit'); return false;">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

        </p>
    </div>
}
<script type="text/javascript">



    function submitclaim(Type) {

        if (Type == 'Draft') {
            $('#ConfirmDraft').modal();

        }
        else {
            if ($('#chkDisclaimer').parent().hasClass('checked')) {
                $('#ConfirmSubmit').modal();
            }
            else {
                alert('- Please read and check the Disclaimer section before proceeding to submit.\n');
            }
        }
    }


    function SubmitForm(Type) {
        if (Type == 'Draft') {
            $('#ConfirmDraft').modal('hide');
            $("#SuccessSubmitMessage").html('Your Advance Claim Application has been successfully saved.');
        }
        else {
            $('#ConfirmSubmit').modal('hide');
            $("#SuccessSubmitMessage").html('Your Advance Claim Application has been successfully submitted.');
        }

        $('#divLoading').modal();
        var data = $('form').serializeArray();

        //Add in additional data to the original form data:
        data.push(
            { name: 'SubmitType', value: Type }
        );

        $.ajax({
            url: '../Claims/SubmitAdvanceClaim',
            type: 'POST',
            data: data,
            success: function (result) {

                $('#divLoading').modal('hide');

                if (result.result == true) {
                    $('#SuccessSubmit').modal();
                    $('#btnOK').attr('href', '../Claims/AdvanceClaimsHistory');
                }
                else {
                    alert(result.ErrorMessage);

                }
                // ... Process the result ...
            }
        });

    }



    $(document).ready(function () {
        // FormConfiguration();

        // Form plugin function
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            defaultDate: new Date()

        });

        $('.timeinput').inputmask("mask", {
            "mask": "99:99"
        });



    });
</script>


