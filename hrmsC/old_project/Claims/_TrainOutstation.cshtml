@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.TrainOutstation_GSTMaxValue;
    string GSTMaxValue = ViewBag.TrainOutstation_GSTMaximumValue;
    string GSTEnabled = (@ViewBag.TrainOutstation_GSTEnabled + "").ToLower();
    string Status = @ViewBag.TrainOutstation_Status;
    string dtStrStart = @ViewBag.TrainOutstation_StartDate;
    string dtStrEnd = @ViewBag.TrainOutstation_EndDate;
}

<div class="portlet box blue" id="dTable_TrainOutstation">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimsSubtypeName
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tblTrainOutstation">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col" width="15%">Charge Code</th>
                                <th scope="col" width="20%">Date *</th>
                                <th scope="col" width="30%">Description</th>
                                <th scope="col" width="10%">Amount (RM) *</th>
                                <th scope="col" width="10%">GST Amount (RM)</th>
                                <th scope="col" width="10%">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="TrainOutstationRemoveCheckbox" /></td>
                                        <td>
                                            <input type="hidden" class="hfChargeCode" />
                                            <select class="form-control ddlChargeCode" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0" onchange="ChargeCodeChange(this);">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control Date" id="Date" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control Description" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" /></td>
                                        <td><input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" onkeypress="NumberOnly(event);" onkeyup="TrainOutstation_CalculateSum();" /></td>
                                        <td><input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" id="txtGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" id="txtTotalAmount" readonly /></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="TrainOutstationRemoveCheckbox" /></td>
                                            <td>
                                                <input type="hidden" class="hfChargeCode" value="@thisDetail.SubTypeColumn0" />
                                                <select class="form-control ddlChargeCode" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0" onchange="ChargeCodeChange(this);">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                    <input type="text" class="form-control Date" id="Date" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" value="@thisDetail.SubTypeColumn1" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="text" class="form-control Description" value="@thisDetail.SubTypeColumn2"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn2" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control Amount" value="@thisDetail.Amount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" onkeypress="NumberOnly(event);" onkeyup="TrainOutstation_CalculateSum();" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" id="txtGSTAmount" readonly />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" id="txtTotalAmount" readonly />
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                    <tr>
                                        <td>
                                            <input type="text" class="form-control ddlChargeCode" value="@thisDetail.SubTypeColumn0" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn0" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Date" value="@thisDetail.SubTypeColumn1" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn1" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Description" value="@thisDetail.SubTypeColumn2" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn2" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Amount" value="@thisDetail.Amount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" />
                                        </td>
                                    </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="BtnPlus btn green" title="dTable_TrainOutstation" href="javascript:TrainOutstation_addRow();">
                                    Add Row
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="BtnPlus5 btn green" title="dTable_TrainOutstation" href="javascript:TrainOutstation_add5Row();">
                                    Add 5 Rows
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="deleteall btn red" title="dTable_TrainOutstation" href="javascript:TrainOutstation_removeRow();">
                                    Delete Row
                                    <i class="fa fa-minus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var origBindtoDDL = BindtoDDL;
    BindtoDDL = function () {
        // overwrite method here
        var _ChargeCodeList = document.getElementById('ChargeCodeList').value;
        _ChargeCodeList = _ChargeCodeList.substring(0, _ChargeCodeList.length - 1);

        BindOptionToSelect(_ChargeCodeList);

        return origBindtoDDL();
    }

    function BindOptionToSelect(ChargeCodeList) {
        var chargeCodes = ChargeCodeList.split(',');

        $('.ddlChargeCode').each(function () {
            $(this).find('option').remove().end().append('<option value="">Select One</option>');

            for (var i = 0; i < chargeCodes.length; i++) {
                var option = document.createElement("option");
                option.text = chargeCodes[i];
                option.value = chargeCodes[i];
                this.add(option);
            }

            $(this).val($(this).siblings('.hfChargeCode').val());
            if ($(this).val() == null) {
                $(this).children("option[value='']").attr('selected', 'selected');
            } // can be reused during initialize to retain drop down value
        });
    }

    function ChargeCodeChange(x) {
        $(x).siblings('.hfChargeCode').val($(x).val());
    } // put to master form, then don't have to duplicate

    var _TrainOutstationTable = $('#tblTrainOutstation').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_TrainOutstationValidation() {
        var _ValidationMsg = '';

        $('#tblTrainOutstation tbody tr').not(':last').each(function () {
            var _Date = $(this).children('td:eq(1)').children('input[type=text]');
            var _Amount = $(this).children('td:eq(3)').children('input[type=text]');
            var _GSTAmount = $(this).children('td:eq(4)').children('input[type=text]');

            if (_Date.value == '')
                _ValidationMsg += '@ClaimsSubtypeName - Date is required.\n';

            if (_Amount.value == '')
                _ValidationMsg += '@ClaimsSubtypeName - Amount (RM) is required.\n';

            if (_GSTAmount.value == '')
                _ValidationMsg += '@ClaimsSubtypeName - GST Amount (RM) is required.\n';
        });

        return _ValidationMsg;
    }

    function TrainOutstation_removeRow() {
        $.each($('input[class="TrainOutstationRemoveCheckbox"]:checked'), function (i, val) {
            var row = $(this).closest("tr").get(0);
            var id = $(this).attr("id");
            _TrainOutstationTable.fnDeleteRow(mytable.fnGetPosition(row));
        });

        reorderTable('#tblTrainOutstation');
    }

    function TrainOutstation_add5Row() {
        TrainOutstation_addRow();
        TrainOutstation_addRow();
        TrainOutstation_addRow();
        TrainOutstation_addRow();
        TrainOutstation_addRow();
    }

    function TrainOutstation_addRow() {
        _TrainOutstationTable.fnAddData([
            '<input type="checkbox" class="TrainOutstationRemoveCheckbox" />',
            '<input type="hidden" class="hfChargeCode" /><select class="form-control ddlChargeCode" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _TrainOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn0" onchange="ChargeCodeChange(this);"><option value="">Select One</option></select>',
            '<div class="input-group date date-picker" data-date-format="dd MM yyyy"><input type="text" class="form-control Date" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _TrainOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" value="" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
            '<input type="text" class="form-control Description" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _TrainOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" /></td>',
            '<input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _TrainOutstationTable.fnSettings().fnRecordsTotal() + '].Amount" readonly /></td>',
            '<input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _TrainOutstationTable.fnSettings().fnRecordsTotal() + '].GSTAmount" readonly /></td>',
            '<input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _TrainOutstationTable.fnSettings().fnRecordsTotal() + '].TotalAmount" readonly /></td>'
        ]);

        TrainOutstation_Initialize();
    }

    function TrainOutstation_Initialize() {
        $('#tblTrainOutstation .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tblTrainOutstation .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tblTrainOutstation .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tblTrainOutstation tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(4)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }

        BindtoDDL();
    }

    function TrainOutstation_CalculateSum() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tblTrainOutstation');

        //iterate through each textboxes and add the values
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".Amount").val();
            var gstAmt = 0;
            var gstMaxValue = 0;
            var Subtotalamount = 0;
            if ('@GSTEnabled' != 'false') {
                gstMaxValue = '@GSTMaxValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }

            Subtotalamount = parseFloat(amount) + parseFloat(gstAmt.toFixed(2));
            $row.find(".SubTotalAmount").val(Subtotalamount.toFixed(2));

            //add only if the value is number
            if (!isNaN(amount) && amount.length != 0) {
                grandAmount = (grandAmount + (amount * 1));
                grandGST = (grandGST + (gstAmt * 1));
                grandTotal = grandTotal + (grandAmount + grandGST);
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
    }

    $(document).ready(function () {
        TrainOutstation_Initialize();
    });
</script>