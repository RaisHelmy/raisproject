@model ESS.Claim.ViewModels.FlexiBenefitsVM
@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Claim Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct01_CustomFieldFormView">
                    @if (!string.IsNullOrEmpty(Model.RequestNo))
                    {
                        <div id="trRefNo" class="row">
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Reference No.</label>
                                        <div class="col-md-8 form-control-static">
                                            @Html.TextBoxFor(m => m.RequestNo, new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Status</label>
                                        <div class="col-md-8 form-control-static">
                                            @Html.TextBoxFor(m => m.Status, new { @id = "txtStatus", @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row" style="">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Year
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Html.TextBoxFor(m => m.Year, new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.RequestNo) && Model.Status != "Draft")
                        {
                            <div id="divCurrentApprover" class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Current Approver</label>
                                        <div class="col-md-8 form-control-static">
                                            @Html.TextBoxFor(m => m.CurrentApprover, new { @class = "form-control", @readonly = "readonly" })
                                            @Html.HiddenFor(m => m.CurrentApproverID)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                    <div class="row" style="">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Eligibility (RM)
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Html.TextBoxFor(m => m.Eligibility, new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Balance (RM)</label>
                                    <div class="col-md-8 form-control-static">
                                        @Html.TextBoxFor(m => m.Balance, new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-2">
                                        Remarks<span id="lvCommMan" style="color:red; display:none;"> *</span>
                                    </label>
                                    <div class="col-md-10 form-control-static">
                                        @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", @rows = 5 })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="hdValue">
                        <input type="hidden" name="ClaimType" value="@Model.ClaimType" />
                        <input type="hidden" name="ClaimTypeCode" value="@Model.ClaimTypeCode" />
                        <input type="hidden" name="EmployeeID" id="ct01_EmployeeID" />
                        <input type="hidden" name="CreatedBy" id="ct01_CreatedBy" />
                        <input type="hidden" name="DetailsID" id="ct01_DetailsID" />
                        <input type="hidden" name="AttachmentMandatory" id="AttachmentMandatory" value="true" />
                        <input type="hidden" name="CommentMandatory" id="CommentMandatory" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>