
@{
    ViewBag.Title = "TestAttachment";
}

<h2>TestAttachment</h2>


@Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "New", SourceType = "Claims", ShowOptionField = "true", ControlType = "datepicker", CustomTextLabel1="Receipt Date",Mandatory="true" })

<input type="button" class="btn green" value="Test" id="btnTest" onclick="testUpload();" />

<script>
    //testing
    function testUpload() {

        $.ajax({
            type: "POST",
            url: '@Url.Content("~/Claims/testUpload1")',
            cache: false,
            async: false,
            dataType: "json",
            success: function (result) {
                if (result.Success) {
                    alert("success");
                    window.location = "http://localhost:49773/Claims/TestAttachment";
                }
                else {
                    alert(result.ErrorMsg);
                }
            },
            error: function (e) {

            }
        });
    }
</script>


