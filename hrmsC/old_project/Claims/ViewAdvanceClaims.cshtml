<script type="text/javascript">
    //var Path = 'http://localhost:49773';
	var Path = '/_layouts/15/TNBESS'

    function submitclaim(Type) {
        if (Type == 'Draft') {
            $('#ConfirmDraft').modal();

        }
        else {
            if ($('#chkDisclaimer').parent().hasClass('checked')) {

                $('#ConfirmSubmit').modal();

            }
            else {
                alert('- Please read and check the Disclaimer section before proceeding to submit.\n');
            }
        }
    }

    function ApproveReject(Type) {


        if (Type == 'Approve')
        {
            $('#ConfirmApprove').modal();

        }
        else if (Type == 'Agree')
        {
            $('#ConfirmAgree').modal();
        }
        else if (Type == 'Return')
        {
            $('#ConfirmReturn').modal();
        }
        else {
            $('#ConfirmReject').modal();
        }


    }

    function SubmitForm(Type) {
        if (Type == 'Draft') {
            $('#ConfirmDraft').modal('hide');
            $("#actionText").html('Your Advance Claim Application has been successfully saved.');
        }
        else {
            $('#ConfirmSubmit').modal('hide');
            $("#actionText").html('Your Advance Claim Application has been successfully submitted.');
        }

        $('#divLoading').modal();
        var data = $('form').serializeArray();

        //Add in additional data to the original form data:
        data.push(
          { name: 'SubmitType', value: Type }
        );

        $.ajax({
            url: '../Claims/UpdateAdvanceClaim',
            type: 'POST',
            data: data,
            success: function (result) {

                $('#divLoading').modal('hide');

                if (result.result == true) {
                    $('#SuccessAction').modal();
                    $('#btnUpdate').attr('href', '../Claims/AdvanceClaimsHistory');
                }
                else {
                    alert(result.ErrorMessage);

                }
                // ... Process the result ...
            }
        });

    }

    function ApproveRejectAdvClaim(Type) {
        if (Type == 'Approve')
        {
            $('#ConfirmApprove').modal('hide');

        }
        else if (Type == 'Agree')
        {
            $('#ConfirmAgree').modal('hide');
        }
        else if (Type == 'Return')
        {
            $('#ConfirmReturn').modal('hide');
        }
        else
        {
            $('#ConfirmReject').modal('hide');
        }
        $('#divLoading').modal();

        $.ajax({
            url: '../Claims/ApproveRejectAdvanceClaim',
            type: 'POST',
            data:
            {
                SubsisEntitlement: $('#SubsistenceEntitlement').val(),
                SubsisTotal: $('#SubsistenceTotal').val(),
                HotelEntitlement: $('#HotelEntitlement').val(),
                HotelTotal: $('#HotelAmount').val(),
                RequestedAmount: $('#RequestedAmount').val(),
                ActionType: Type,
                RequestID:getUrlParameter('ID'),
                TaskID:'@Model.ProcessID',
                ApproverComment: $('#txtAppComment').val()
            },
            success: function (result) {

                $('#divLoading').modal('hide');

                if (result.Success == true) {
                    $('#actionText').html('Claims has been successfully ' + result.Status);
                    $('#SuccessAction').modal();
                    $('#btnUpdate').attr('href', '../MSS/AdvanceClaimsInTray');
                }
                else {
                    alert(result.ErrorMessage);

                }
                // ... Process the result ...
            }
        });

    }


    @*function Withdraw() {

