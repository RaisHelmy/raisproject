    var getUrlParameter = function getUrlParameter(sParam) {
        var sPageURL = decodeURIComponent(window.location.search.substring(1)),
            sURLVariables = sPageURL.split('&'),
            sParameterName,
            i;

        for (i = 0; i < sURLVariables.length; i++) {
            sParameterName = sURLVariables[i].split('=');

            if (sParameterName[0] === sParam) {
                return sParameterName[1] === undefined ? true : sParameterName[1];
            }
        }
    };

    $(document).ready(function () {
        // FormConfiguration();

        // Form plugin function
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            defaultDate: new Date()

        });

        $('.timeinput').inputmask("mask", {
            "mask": "99:99"
        });

        GetAuditLog('@Model.RequestID');
    });

    function GetAuditLog(_RequestID) {
        jQuery.support.cors = true;

        $.ajax({
            url: Path + '/api/FlexiBenefitsWebApi/GetAuditLog?id=' + _RequestID,
            type: 'GET',
            contentType: "application/json;charset=utf-8",
            success: function (result) {
                if (result != null) {

                    SetAuditLog(result);
                }
                else
                    console.log('failed!');
            },
            error: function (x, y, z) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

    function SetAuditLog(result) {
        var _AuditTrailBody = '';

        for (var i = 0; i < result.length; i++) {
            var _AuditTrail = "<tr><td>" + result[i].EmployeeName + "</td><td>" +
                result[i].FormattedDate + "</td><td>" + result[i].ActivityName + "</td><td>" +
                result[i].ActivityAction + "</td><td style=\"white-space: pre;\">" + result[i].Comment + "</td></tr>";
            _AuditTrailBody += _AuditTrail;
        }

        $('#tblAuditLog').find('tbody').html(_AuditTrailBody);
    }
</script>


