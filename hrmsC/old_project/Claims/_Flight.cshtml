@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimType = Model.ClaimSubTypeCategory;
    string ClaimsSubtypeName = ViewBag.Flight_ClaimsSubtypeName;
    string GSTEnabled = (@ViewBag.Flight_GSTEnabled + "").ToLower();
    string Status = @ViewBag.Flight_Status;
    string dtStrStart = @ViewBag.Flight_StartDate;
    string dtStrEnd = @ViewBag.Flight_EndDate;
    string GSTMaximumValue = ViewBag.Flight_GSTMaximumValueFlightNoGstCalculation;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
}

<input type="hidden" id="@(Model.ClaimsSubtypeName.Contains("SST") ? "TableFlightWithoutSST" : "TableFlightWithoutGST")" value="@(DataTableID)" />
<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimType - @ClaimsSubtypeName
        </div>

        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')"><img style=" vertical-align: initial;" src="../Assets/img/portlet-remove-icon-white.png" /></a>
            </div>

        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Charge Code *</th>
                                <th scope="col">Airport Name</th>
                                <th scope="col">Class*</th>
                                <th scope="col">Departure Date*</th>
                                <th scope="col">Departure Time*</th>
                                <th scope="col">Departure -  Flight No.</th>
                                <th scope="col">Departure - First Destination</th>
                                <th scope="col">Departure - Arrival Date *</th>
                                <th scope="col">Departure - Arrival Time *</th>
                                <th scope="col">Return - Departure Date *</th>
                                <th scope="col">Return - Departure Time *</th>
                                <th scope="col">Return - Airport Name</th>
                                <th scope="col">Amount (RM) *</th>
                                <th scope="col">Tax Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @{
                            List<SelectListItem> FlightClassList = ViewBag.Flight_ddlFlightClass;
                        }

                        @Html.DropDownList(DataTableID + "ClassDDL", FlightClassList, new { @id = DataTableID + "ClassDDL", @class = "bs-select form-control hidden hiddenDDL", @style = "min-width:200px" })

                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                        <td>
                                            <input type="hidden" class="hfChargeCode" />
                                            <select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td><input type="text" style="min-width:200px" class="form-control SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" /></td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn2", FlightClassList,
                                                                new { @class = "bs-select form-control SubTypeColumn2", @style = "width:200px" })
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" style="width:150px" class="form-control SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="hidden" class="form-control Location" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Location" value="Domestic" />
                                            <input type="text" class="form-control SubTypeColumn4 timeinput" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4" />
                                        </td>
                                        <td><input type="text" class="form-control SubTypeColumn5" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" /></td>
                                        <td><input type="text" class="form-control SubTypeColumn6" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" /></td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" style="width:150px" class="form-control SubTypeColumn7" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7" onchange="@(DataTableID)Calculation();" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control SubTypeColumn8 timeinput" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8"  onblur="@(DataTableID)Calculation();" /></td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" style="width:150px" class="form-control SubTypeColumn9" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn9" onchange="@(DataTableID)Calculation();" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control SubTypeColumn10 timeinput" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn10" onblur="@(DataTableID)Calculation();" /></td>
                                        <td><input type="text" class="form-control SubTypeColumn11" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn11" /></td>
                                        <td><input type="text" style="min-width:130px" class="form-control text-right Amount " name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" maxlength="10" value="0.00" onblur="@(DataTableID)_CalculateSum(this);" /></td>
                                        <td><input type="text" style="min-width:130px" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" maxlength="10" value="0.00" onblur="@(DataTableID)_CalculateSumGST(this);" /></td>
                                        <td><input type="text" style="min-width:130px" class="form-control text-right TotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" value="0.00" readonly /></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="13"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="0.00" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="0.00" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="0.00" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                            <td>
                                                <input type="hidden" class="hfChargeCode" value="@thisDetail.SubTypeColumn0" />
                                                <select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();">
                                                    <option value="">Select One</option>
                                                </select>
                                            </td>
                                            <td><input type="text" style="min-width:200px" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn1" /></td>
                                            <td>
                                                <input type="hidden" value="@thisDetail.SubTypeColumn2" />
                                                @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[" + count + "].SubTypeColumn2", FlightClassList, new { @class = "bs-select form-control SubTypeColumn2", @style = "width:200px" })
                                            </td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:130px">
                                                    <input type="text" style="width:150px" class="form-control SubTypeColumn3" value="@thisDetail.SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn3" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="hidden" class="form-control Location" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Location" value="Domestic" />
                                                <input type="text" class="form-control SubTypeColumn4 timeinput" value="@thisDetail.SubTypeColumn4" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn4" />
                                            </td>
                                            <td><input type="text" class="form-control SubTypeColumn5" value="@thisDetail.SubTypeColumn5" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn5" /></td>
                                            <td><input type="text" class="form-control SubTypeColumn6" value="@thisDetail.SubTypeColumn6" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn6" /></td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                    <input type="text" style="width:150px" class="form-control SubTypeColumn7" value="@thisDetail.SubTypeColumn7" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn7" onchange="@(DataTableID)Calculation();" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td><input type="text" class="form-control SubTypeColumn8 timeinput" value="@thisDetail.SubTypeColumn8" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn8"  onblur="@(DataTableID)Calculation();" /></td>
                                            <td>
                                                <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                    <input type="text" style="width:150px" class="form-control SubTypeColumn9" value="@thisDetail.SubTypeColumn9" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn9" onchange="@(DataTableID)Calculation();" />
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>
                                            </td>
                                            <td><input type="text" class="form-control SubTypeColumn10 timeinput" value="@thisDetail.SubTypeColumn10" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn10" onblur="@(DataTableID)Calculation();" /></td>
                                            <td><input type="text" class="form-control SubTypeColumn11" value="@thisDetail.SubTypeColumn11" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn11" /></td>
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control text-right Amount " value="@thisDetail.Amount" maxlength="10"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" onblur="@(DataTableID)_CalculateSum(this);" />
                                            </td>
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount" maxlength="10"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount" onblur="@(DataTableID)_CalculateSumGST(this);" />
                                            </td>
                                            <td>
                                                <input type="text" style="min-width:130px" class="form-control text-right TotalAmount" value="@thisDetail.TotalAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" readonly />
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="13"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount))))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.GSTAmount) ? 0.00 : Convert.ToDouble(m.GSTAmount))))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.TotalAmount) ? 0.00 : Convert.ToDouble(m.TotalAmount))))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                    <tr>
                                        <td></td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn0" value="@thisDetail.SubTypeColumn0" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn0" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:200px" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn1" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn2" value="@thisDetail.SubTypeColumn2" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn2" />
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" class="form-control SubTypeColumn3" value="@thisDetail.SubTypeColumn3" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn3" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="hidden" class="form-control Location" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Location" value="Domestic" />
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn4" value="@thisDetail.SubTypeColumn4" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn5" value="@thisDetail.SubTypeColumn5" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn5" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn6" value="@thisDetail.SubTypeColumn6" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn6" />
                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" class="form-control SubTypeColumn7" value="@thisDetail.SubTypeColumn7" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn7" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn8" value="@thisDetail.SubTypeColumn8" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn8" />

                                        </td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="min-width:150px">
                                                <input type="text" class="form-control SubTypeColumn9" value="@thisDetail.SubTypeColumn9" readonly
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn9" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn10" value="@thisDetail.SubTypeColumn10" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn10" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control SubTypeColumn11" value="@thisDetail.SubTypeColumn11" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].SubTypeColumn11" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right Amount " value="@thisDetail.Amount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].Amount" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].GSTAmount" />
                                        </td>
                                        <td>
                                            <input type="text" style="min-width:130px" class="form-control text-right TotalAmount" value="@thisDetail.TotalAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[@count].TotalAmount" />
                                        </td>
                                    </tr>

