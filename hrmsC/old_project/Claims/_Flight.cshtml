                    </table>
                </div>
            </div>
            @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
            {
                <div class="form-horizontal">
                    <div class="table-toolbar">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="btn-group">
                                    <a class="BtnPlus btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_addRow();">
                                        Add Row
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                                <div class="btn-group">
                                    <a class="BtnPlus5 btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_add5Row();">
                                        Add 5 Rows
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                                <div class="btn-group">
                                    <a class="deleteall btn red" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_removeRow();">
                                        Delete Row
                                        <i class="fa fa-minus"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_@(DataTableID)Validation() { // FlightValidation
        var _ValidationMsg = '';

        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _Class = $row.find(".SubTypeColumn2").val();
            var _DepartureDate = $row.find(".SubTypeColumn3").val();
            var _DepartureTime = $row.find(".SubTypeColumn4").val();
            var _DepartureArrivalDate = $row.find(".SubTypeColumn7").val();
            var _DepartureArrivalTime = $row.find(".SubTypeColumn8").val();
            var _ReturnDepartureDate = $row.find(".SubTypeColumn9").val();
            var _ReturnDepartureTime = $row.find(".SubTypeColumn10").val();
            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n'
            }

            if (_Amount == null || _Amount == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is required.\n'
            }

            if (_Amount == 'Infinity') {
                _ValidationMsg += '- @ClaimsSubtypeName (Amount) is invalid.\n'
            }

            if (_Class == null || _Class == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Flight Class) is required.\n'
            }

            if (_DepartureDate == null || _DepartureDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Departure Date) is required.\n'
            }

            if (_DepartureTime == null || _DepartureTime == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Departure Time) is required.\n'
            }

            if (_DepartureArrivalDate == null || _DepartureArrivalDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Departure Arrival Date) is required.\n'
            }

            if (_DepartureArrivalTime == null || _DepartureArrivalTime == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Departure Arrival Time) is required.\n'
            }

            if (_ReturnDepartureDate == null || _ReturnDepartureDate == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Return Departure Date) is required.\n'
            }

            if (_ReturnDepartureTime == null || _ReturnDepartureTime == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Return Departure Time) is required.\n'
            }

            if (!(_DepartureDate == null || _DepartureTime == '') && !(_DepartureArrivalDate == null || _DepartureArrivalTime == '') && !(_ReturnDepartureDate == null || _ReturnDepartureTime == '')) {

                var departureDateString = _DepartureDate + " " + _DepartureTime;
                var departureArrivalDateString = _DepartureArrivalDate + " " + _DepartureArrivalTime;
                var returnDateString = _ReturnDepartureDate + " " + _ReturnDepartureTime;

                var DepartureDate = moment(departureDateString, "DD/MM/YYYY HH:mm")._d;
                var DepartureArrivalDate = moment(departureArrivalDateString, "DD/MM/YYYY HH:mm")._d;
                var ReturnDate = moment(returnDateString, "DD/MM/YYYY HH:mm")._d;
                 
                if (DepartureArrivalDate <= DepartureDate) {
                    _ValidationMsg += ('- @ClaimsSubtypeName Departure Arrival Date/Time has to be later than Departure Date/Time.\n');                    
                }

                if (ReturnDate <= DepartureArrivalDate) {
                    _ValidationMsg += ('- @ClaimsSubtypeName Return Departure Date/Time has to be later than Departure Arrival Date/Time.\n');                    
                }
            }

            var _GSTAmount = $row.find(".GSTAmount").val();
            var gstAmt = 0;
            if ('@GSTEnabled' != 'false') {

                if (_GSTAmount == null || _GSTAmount == '') {
                    _ValidationMsg += '- @ClaimsSubtypeName (GST Amount) is required.\n'
                }

                var gstMaxValue = '@GSTMaximumValue';
                gstAmt = parseFloat(_Amount) * (parseFloat(gstMaxValue) / 100);
                if ((parseFloat(_GSTAmount) || 0) > (parseFloat(gstAmt.toFixed(2)) || 0)) {
                    _ValidationMsg += '- @ClaimsSubtypeName - The GST Amount (highlighted in yellow) has exceeded the maximum value.Please edit or delete the record to proceed.\n'
                    $row.find(".GSTAmount").css("background-color", "yellow");
                }
                else {
                    $row.find(".GSTAmount").css("background-color", "white");
                }

            }

        });

        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="@(DataTableID)RemoveCheckbox"]:checked'), function (i, val) {
            var currLength = $('#tbl@(DataTableID) tr').length - 2;
            var row = $(this).closest("tr").get(0);
            if (currLength > 1) {
                _@(DataTableID)Table.fnDeleteRow(mytable.fnGetPosition(row));
            }
        });
        @(DataTableID)Calculation();
        reorderTable('#tbl@(DataTableID)');
        @(DataTableID)_CalculateSubtotal();
    }

