@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.SubsistenceOutstationNoGST_ClaimsSubtypeName;
    string Status = ViewBag.SubsistenceOutstationNoGST_Status;
    string GSTEnabled = (ViewBag.SubsistenceOutstationNoGST_GSTEnabled + "").ToLower();
    string GSTMaxValue = ViewBag.SubsistenceOutstationNoGST_GSTMaxValue;
    string NoOfDays = ViewBag.SubsistenceOutstationNoGST_NoOfDays;
    string NoOfMeals = ViewBag.SubsistenceOutstationNoGST_NoOfMeals;
    string NoOfExtraHour = ViewBag.SubsistenceOutstationNoGST_NoOfExtraHour;
    string TwentyFourHourRate = ViewBag.SubsistenceOutstationNoGST_TwentyFourHourRate;
    string ExtraHourRate = ViewBag.SubsistenceOutstationNoGST_ExtraHourRate;
    string WorkSubtotal = ViewBag.SubsistenceOutstationNoGST_WorkSubtotal;
    string ClaimableAmount = ViewBag.SubsistenceOutstationNoGST_ClaimableAmount;
    double dblBreakfastRate = ViewBag.SubsistenceOutstationNoGST_BreakfastRate;
    double dblLunchRate = ViewBag.SubsistenceOutstationNoGST_LunchRate;
    double dblDinnerRate = ViewBag.SubsistenceOutstationNoGST_DinnerRate;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
}

<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@Model.ClaimSubTypeCategory - @Model.ClaimsSubtypeName
        </div>
        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')">
                    <img style=" vertical-align initial;" src="../Assets/img/portlet-remove-icon-white.png" />
                </a>
            </div>
        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"></a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
