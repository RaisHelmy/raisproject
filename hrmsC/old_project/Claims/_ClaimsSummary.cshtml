<script>
    function CalculateSummary() {
        var subtypename = 'SubType'
        $('.subtypeportlet').each(function (index) {
            var tablename = this.id;
            var colname = subtypename + index;
            var totalValue = $('#' + tablename).find('.GrandTotalAmount').val();
            $('#' + colname).html('<div class="text-right">' + totalValue + '</div>');
        });
        calcSummary();
        CheckMileageThreshold();
        CalculateChargeCodeSummary();
    }

    function CustomRounding(inputAmount) {
        var outputAmount = inputAmount * 10;
        var fraction = outputAmount - Math.floor(outputAmount);
        if ((fraction >= 0) & (fraction < 0.25)) {
            fraction = 0.0;
        }
        else if ((fraction >= 0.25) & (fraction < 0.75)) {
            fraction = 0.5;
        }
        else {
            fraction = 1.0;
        }
        outputAmount = Math.floor(outputAmount) + fraction;
        outputAmount = outputAmount / 10;
        return outputAmount;
    }

    $(function () {
        $("#txtTipsChargeCode").text(DisplayChargeCodeDesc($("#txtTipsChargeCode").text()));
        $("#txtForexLossChargeCode").text(DisplayChargeCodeDesc($("#txtForexLossChargeCode").text()));
        CalculateSummary();
    });
</script>