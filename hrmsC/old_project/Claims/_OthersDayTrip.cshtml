@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.OthersDayTrip_GSTMaxValue;
    string GSTMaxValue = ViewBag.OthersDayTrip_GSTMaximumValue;
    string GSTEnabled = (@ViewBag.OthersDayTrip_GSTEnabled + "").ToLower();
    string Status = @ViewBag.OthersDayTrip_Status;
    string dtStrStart = @ViewBag.OthersDayTrip_StartDate;
    string dtStrEnd = @ViewBag.OthersDayTrip_EndDate;
}

<div class="portlet box blue" id="dTable_OthersDayTrip">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimsSubtypeName
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tblOthersDayTrip">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Date *</th>
                                <th scope="col">Start Time *</th>
                                <th scope="col">End Time *</th>
                                <th scope="col">Destination</th>
                                <th scope="col">No. of Hours</th>
                                <th scope="col">Distance (KM) *</th>
                                <th scope="col">Rate (RM)</th>
                                <th scope="col">Interval (Hrs)</th>
                                <th scope="col">Amount (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="OthersDayTripRemoveCheckbox" /></td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control Date" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Date" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control DayTripStartTime" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].StartTime" /></td>
                                        <td><input type="text" class="form-control DayTripEndTime" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].EndTime" /></td>
                                        <td><input type="text" class="form-control Destination" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4" /></td>
                                        <td><input type="text" class="form-control NoOfHours" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" /></td>
                                        <td><input type="text" class="form-control Distance" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" /></td>
                                        <td><input type="text" class="form-control Rate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7" /></td>
                                        <td><input type="text" class="form-control Interval" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8" /></td>
                                        <td><input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" readonly /></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                    <tr>
                                        <td><input type="checkbox" class="OthersDayTripRemoveCheckbox" /></td>
                                        <td>
                                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                <input type="text" class="form-control Date" value="@thisDetail.Date"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Date" />
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control DayTripStartTime" value="@thisDetail.StartTime"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].StartTime" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right DayTripEndTime" value="@thisDetail.EndTime"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].EndTime" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Destination" value="@thisDetail.SubTypeColumn4"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control NoOfHours" value="@thisDetail.SubTypeColumn5"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn5" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Distance" value="@thisDetail.SubTypeColumn6"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn6" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Rate" value="@thisDetail.SubTypeColumn7"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn7" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Interval" value="@thisDetail.SubTypeColumn8"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn8" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Amount" value="@thisDetail.Amount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" readonly />
                                        </td>
                                    </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                <tr>
                                    <td>
                                        <input type="text" class="form-control Date" value="@thisDetail.Date"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Date" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control DayTripStartTime" value="@thisDetail.StartTime"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].StartTime" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control DayTripEndTime" value="@thisDetail.EndTime"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].EndTime" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control Destination" value="@thisDetail.SubTypeColumn4"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn4" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control NoOfHours" value="@thisDetail.SubTypeColumn5"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn5" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control Distance" value="@thisDetail.SubTypeColumn6"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn6" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control Rate" value="@thisDetail.SubTypeColumn7"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn7" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control Interval" value="@thisDetail.SubTypeColumn8"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn8" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control Amount" value="@thisDetail.Amount"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" readonly />
                                    </td>
                                </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="BtnPlus btn green" title="dTable_OthersDayTrip" href="javascript:OthersDayTrip_addRow();">
                                    Add Row
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="BtnPlus5 btn green" title="dTable_OthersDayTrip" href="javascript:OthersDayTrip_add5Row();">
                                    Add 5 Rows
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="deleteall btn red" title="dTable_OthersDayTrip" href="javascript:OthersDayTrip_removeRow();">
                                    Delete Row
                                    <i class="fa fa-minus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var _OthersDayTripTable = $('#tblOthersDayTrip').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_OthersDayTripValidation() {
        var _ValidationMsg = '';

        $('#tblOthersDayTrip tbody tr').not(':last').each(function () {
            var _Date = $(this).children('td:eq(1)').children('input[type=text]');
            var _StartTime = $(this).children('td:eq(2)').children('input[type=text]');
            var _EndTime = $(this).children('td:eq(3)').children('input[type=text]');
            var _Distance = $(this).children('td:eq(6)').children('input[type=text]');
            var _GSTAmount = $(this).children('td:eq(10)').children('input[type=text]');

            if (_Date.value == '')
                _ValidationMsg += 'Travelling Allowance - Day Trip Allowance - Date is required.\n';

            if (_StartTime.value == '')
                _ValidationMsg += 'Travelling Allowance - Day Trip Allowance - Start Time is required.\n';

            if (_EndTime.value == '')
                _ValidationMsg += 'Travelling Allowance - Day Trip Allowance - End Time is required.\n';

            if (_Distance.value == '')
                _ValidationMsg += 'Travelling Allowance - Day Trip Allowance - Distance is required.\n';

            if (_GSTAmount.value == '')
                _ValidationMsg += 'Travelling Allowance - Day Trip Allowance - GST Amount (RM) is required.\n';
        });

        return _ValidationMsg;
    }

    function OthersDayTrip_add5Row() {
        OthersDayTrip_addRow();
        OthersDayTrip_addRow();
        OthersDayTrip_addRow();
        OthersDayTrip_addRow();
        OthersDayTrip_addRow();
    }

    function OthersDayTrip_addRow() {
        _MedicalOverseasTable.fnAddData([
           '<input type="checkbox" class="MedicalOverseasRemoveCheckbox" />',
           '<div class="input-group date date-picker" data-date-format="dd MM yyyy"><input type="text" class="form-control Date" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].Date" value="" /><span class="input-group-btn"><button type="button" class="btn default"><i class="fa fa-calendar"></i></button></span></div>',
           '<input type="text" class="form-control DayTripStartTime" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].StartTime" /></td>',
           '<input type="text" class="form-control DayTripEndTime" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].EndTime" /></td>',
           '<input type="text" class="form-control Destination" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" /></td>',
           '<input type="text" class="form-control NoOfHours" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" readonly /></td>',
           '<input type="text" class="form-control Distance" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" readonly /></td>',
           '<input type="text" class="form-control Rate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" /></td>',
           '<input type="text" class="form-control Interval" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" /></td>',
           '<input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].Amount" readonly /></td>',
           '<input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].GSTAmount" readonly /></td>',
           '<input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _OthersDayTripTable.fnSettings().fnRecordsTotal() + '].TotalAmount" readonly /></td>'
        ]);

        OthersDayTrip_Initialize();
    }

    function OthersDayTrip_Initialize() {
        $('#tblOthersDayTrip .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tblOthersDayTrip .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tblOthersDayTrip .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tblOthersDayTrip tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(10)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }
    }

    function OthersDayTrip_CalculateSum() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tblOthersDayTrip');

        //iterate through each textboxes and add the values
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".Amount").val();
            var gstAmt = 0;
            var gstMaxValue = 0;
            var Subtotalamount = 0;
            if ('@GSTEnabled' != 'false') {
                gstMaxValue = '@GSTMaxValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }

            Subtotalamount = parseFloat(amount) + parseFloat(gstAmt.toFixed(2));
            $row.find(".SubTotalAmount").val(Subtotalamount.toFixed(2));

            //add only if the value is number
            if (!isNaN(amount) && amount.length != 0) {
                grandAmount = (grandAmount + (amount * 1));
                grandGST = (grandGST + (gstAmt * 1));
                grandTotal = grandTotal + (grandAmount + grandGST);
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
    }

    $(document).ready(function () {
        OthersDayTrip_Initialize();
    });
</script>