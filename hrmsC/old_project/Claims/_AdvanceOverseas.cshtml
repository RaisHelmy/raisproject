@model ESS.Claim.ViewModels.ClaimsSubtype
@using TNB_ESS_MVC.Helpers
@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.AdvanceOverseas_ClaimsSubtypeName;
    string GSTEnabled = (@ViewBag.AdvanceOverseas_GSTEnabled + "").ToLower();
    string Status = @ViewBag.AdvanceOverseas_Status;
    string dtStrStart = @ViewBag.AdvanceOverseas_StartDate;
    string dtStrEnd = @ViewBag.AdvanceOverseas_EndDate;
    string noOfDays = ViewBag.AdvanceOverseas_noOfDays;
    string PayScaleGroup =ViewBag.AdvanceOverseas_PayScaleGroup;
}
<div class="portlet box blue subtypeportlet" id="dTable_AdvanceOverseas">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimsSubtypeName
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tblAdvanceOverseas">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col">No. Of Days</th>
                                <th scope="col">Country</th>
                                <th scope="col">Approval Letter Ref. No. *</th>
                                <th scope="col">Adv Rate</th>
                                <th scope="col">Subsistence Rate (RM)</th>
                                <th scope="col">Total Subsistence (RM)</th>
                                <th scope="col">Hotel Adv Rate</th>
                                <th scope="col">Hotel Rate (RM)</th>
                                <th scope="col">Total Hotel (RM)</th>
                                <th scope="col">Total Advance Allowance (RM) *</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>

                        @{
                            List<SelectListItem> CountryList = ViewBag.AdvanceOverseas_ddlCountry;
                        }
                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="AdvanceOverseasRemoveCheckbox" /></td>
                                        <td><input type="text" id="noOfDays" class="form-control SubTypeColumn1" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" /></td>
                                        <td>

                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn2", CountryList, new { @id = "Country", @class = "bs-select form-control", @style = "width:200px", @onchange = "CountryListOnChange();" })

                                        </td>
                                        <td><input type="text" class="form-control SubTypeColumn3" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" /></td>
                                        <td><input type="text" id="advRate" class="form-control SubTypeColumn4" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4" /></td>
                                        <td><input type="text" id="subsistenceRate" class="form-control SubTypeColumn5" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" /></td>
                                        <td><input type="text" id="totalSubsistence" class="form-control SubTypeColumn6" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" /></td>
                                        <td><input type="text" id="hotelAdvRate" class="form-control SubTypeColumn7" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7" /></td>
                                        <td><input type="text" id="hotelRate" class="form-control SubTypeColumn8" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8" /></td>
                                        <td><input type="text" id="totalHotel" class="form-control SubTypeColumn9" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn9" /></td>
                                        <td><input type="text" id="amount" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" onkeypress="NumberOnly(event);" /></td>
                                        <td><input type="text" id="GSTAmount" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" readonly /></td>
                                        <td><input type="text" id="TotalAmount" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" readonly /></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="10"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>


                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                        <tr>
                                            <td><input type="checkbox" class="AdvanceOverseasRemoveCheckbox" /></td>
                                            <td>
                                                <input type="text" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn1" />
                                            </td>
                                            <td>
                                                @{
                                                    <input type="hidden" value="@thisDetail.SubTypeColumn2" />
                                                    @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn2", CountryList, new { @id = "Country", @class = "bs-select form-control SubTypeColumn2", @style = "width:200px", @onchange = "CountryListOnChange();" })
                                                }
                                            </td>
                                            <td>
                                                <input type="text" class="form-control SubTypeColumn3" value="@thisDetail.SubTypeColumn3"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn3" />
                                            </td>
                                            <td>
                                                <input type="text" id="advRate" class="form-control SubTypeColumn4" value="@thisDetail.SubTypeColumn4"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn4" />
                                            </td>
                                            <td>
                                                <input type="text" id="subsistenceRate" class="form-control SubTypeColumn5" value="@thisDetail.SubTypeColumn5"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn5" />
                                            </td>
                                            <td>
                                                <input type="text" id="totalSubsistence" class="form-control SubTypeColumn6" value="@thisDetail.SubTypeColumn6"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn6" />
                                            </td>
                                            <td>
                                                <input type="text" id="hotelAdvRate" class="form-control SubTypeColumn7" value="@thisDetail.SubTypeColumn7"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn7" />
                                            </td>
                                            <td>
                                                <input type="text" id="hotelRate" class="form-control SubTypeColumn8" value="@thisDetail.SubTypeColumn8"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn8" />
                                            </td>
                                            <td>
                                                <input type="text" id="totalHotel" class="form-control SubTypeColumn9" value="@thisDetail.SubTypeColumn9"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn9" />
                                            </td>

                                            <td>
                                                <input type="text" id="amount" class="form-control Amount" value="@thisDetail.Amount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" onkeypress="NumberOnly(event);" />
                                            </td>
                                            <td>
                                                <input type="text" id="GSTAmount" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" readonly />
                                            </td>
                                            <td>
                                                <input type="text" id="TotalAmount" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                                       name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" readonly />
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="10"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                    <tr>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn1" value="@thisDetail.SubTypeColumn1" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn1" />
                                        </td>
                                        <td>
                                            @{
                                                <input type="hidden" value="@thisDetail.SubTypeColumn2" />
                                                @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn2", CountryList, new { @id = "Country", @class = "bs-select form-control SubTypeColumn2", @style = "width:200px", @readonly = "readonly" })
                                            }
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubTypeColumn3" value="@thisDetail.SubTypeColumn3" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn3" />
                                        </td>
                                        <td>
                                            <input type="text" id="advRate" class="form-control SubTypeColumn4" value="@thisDetail.SubTypeColumn4" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" id="subsistenceRate" class="form-control SubTypeColumn5" value="@thisDetail.SubTypeColumn5" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn5" />
                                        </td>
                                        <td>
                                            <input type="text" id="totalSubsistence" class="form-control SubTypeColumn6" value="@thisDetail.SubTypeColumn6" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn6" />
                                        </td>
                                        <td>
                                            <input type="text" id="hotelAdvRate" class="form-control SubTypeColumn7" value="@thisDetail.SubTypeColumn7" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn7" />
                                        </td>
                                        <td>
                                            <input type="text" id="hotelRate" class="form-control SubTypeColumn8" value="@thisDetail.SubTypeColumn8" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn8" />
                                        </td>
                                        <td>
                                            <input type="text" id="totalHotel" class="form-control SubTypeColumn9" value="@thisDetail.SubTypeColumn9" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn9" />
                                        </td>

                                        <td>
                                            <input type="text" id="amount" class="form-control Amount" value="@thisDetail.Amount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" onkeypress="NumberOnly(event);" />
                                        </td>
                                        <td>
                                            <input type="text" id="GSTAmount" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" readonly />
                                        </td>
                                        <td>
                                            <input type="text" id="TotalAmount" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount" readonly
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" readonly />
                                        </td>
                                    </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="9"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="form-horizontal hidden">
                <div class="table-toolbar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="BtnPlus btn green" title="dTable_AdvanceOverseas" href="javascript:AdvanceOverseas_addRow();">
                                    Add Row
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="BtnPlus5 btn green" title="dTable_AdvanceOverseas" href="javascript:AdvanceOverseas_add5Row();">
                                    Add 5 Rows
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="deleteall btn red" title="dTable_AdvanceOverseas" href="javascript:AdvanceOverseas_removeRow();">
                                    Delete Row
                                    <i class="fa fa-minus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var _AdvanceOverseasTable = $('#tblAdvanceOverseas').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_AdvanceOverseasValidation() { // AdvanceOverseasValidation
        var _ValidationMsg = '';

        var thisTable = $('#tblAdvanceOverseas');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _RefNo = $row.find(".SubTypeColumn3").val();

            if (_Amount == null || _Amount == '0' || _Amount == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Total Advance Allowance) is required.\n'
            }

            if (_RefNo == null || _RefNo == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Approval Letter Ref. No.) is required.\n'
            }

        });

        return _ValidationMsg;
    }

    function AdvanceOverseas_removeRow() {
        $.each($('input[class="AdvanceOverseasRemoveCheckbox"]:checked'), function (i, val) {
            var row = $(this).closest("tr").get(0);
            var id = $(this).attr("id");
            _AdvanceOverseasTable.fnDeleteRow(mytable.fnGetPosition(row));
        });

        reorderTable('#tblAdvanceOverseas');
    }

    function AdvanceOverseas_add5Row() {
        AdvanceOverseas_addRow();
        AdvanceOverseas_addRow();
        AdvanceOverseas_addRow();
        AdvanceOverseas_addRow();
        AdvanceOverseas_addRow();
    }

    function AdvanceOverseas_addRow() {
        _AdvanceOverseasTable.fnAddData([
            '<input type="checkbox" class="AdvanceRemoveCheckbox" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn9" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn10" class="form-control" maxlength="200" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].Amount" value="" class="form-control text-right Amount" />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].GSTAmount" value="" class="form-control text-right GSTAmount" readonly />',
            '<input type="text" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _AdvanceOverseasTable.fnSettings().fnRecordsTotal() + '].TotalAmount" value="" class="form-control text-right SubTotalAmount" readonly />'
        ]);

        AdvanceOverseas_Initialize();
    }

    function AdvanceOverseas_Initialize() {
        $('#tblAdvanceOverseas .date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
        $('#tblAdvanceOverseas .date-picker').datepicker('setStartDate', '@dtStrStart');
        $('#tblAdvanceOverseas .date-picker').datepicker('setEndDate', '@dtStrEnd');

        if ('@GSTEnabled' == 'false') {
            $('#tblAdvanceOverseas tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(11)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }
        
        $('#tblAdvanceOverseas tbody tr').each(function () {
            var _noOfDays = $(this).children('td:eq(1)').children('input[type=text]');

            _noOfDays.prop('readonly', true);
            _noOfDays.val('@noOfDays');
        });

        $('#advRate').prop('readonly', true);
        $('#subsistenceRate').prop('readonly', true);
        $('#totalSubsistence').prop('readonly', true);
        $('#hotelAdvRate').prop('readonly', true);
        $('#hotelRate').prop('readonly', true);
        $('#totalHotel').prop('readonly', true);
        $('#amount').prop('readonly', true);
        $('#GSTAmount').prop('readonly', true);
        $('#TotalAmount').prop('readonly', true);
    }

    function AdvanceOverseas_CountryOnChange()
    {
        var _noOfDays ='@noOfDays';
    }

    function GetCountryListInputValues() {
        $('#tblAdvanceOverseas tbody tr').each(function () {
            var _CountrySelect = $(this).children('td:eq(2)').children('select');
            var _CountryHidden = $(this).children('td:eq(2)').children('input[type=hidden]');
            _CountrySelect.val(_CountryHidden.val());

        });
    }

    function CountryListOnChange()
    {
        var _Country = $('#Country').val();
        $.ajax({
            type: "POST",
            url: '@Url.Content("~/Claims/_AdvanceOverseasValue")',
            cache: false,
            async: false,
            dataType: "json",
            data: {Country:_Country, GSTEnabled:'@GSTEnabled', noOfDays:'@noOfDays',PayScaleGroup:'@PayScaleGroup'},
            success: function (result) {
                if (result.Success) {
                   
                    $('#advRate').val(result['advRate']);
                    $('#advRate').prop('readonly', true);
                    $('#subsistenceRate').val(result['subsistenceRate']);
                    $('#subsistenceRate').prop('readonly', true);
                    $('#totalSubsistence').val(result['totalSubsistence']);
                    $('#totalSubsistence').prop('readonly', true);
                    $('#hotelAdvRate').val(result['hotelAdvRate']);
                    $('#hotelAdvRate').prop('readonly', true);
                    $('#hotelRate').val(result['hotelRate']);
                    $('#hotelRate').prop('readonly', true);
                    $('#totalHotel').val(result['totalHotel']);
                    $('#totalHotel').prop('readonly', true);
                    $('#amount').val(result['amount']);
                    $('#amount').prop('readonly', true);
                    $('#GSTAmount').val(result['GSTAmount']);
                    $('#GSTAmount').prop('readonly', true);
                    $('#TotalAmount').val(result['TotalAmount']);
                    $('#TotalAmount').prop('readonly', true);

                }
                else {
                    alert(result.ErrorMsg);
                }
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    $(document).ready(function () {
        AdvanceOverseas_Initialize();
        GetCountryListInputValues();
    });
</script>