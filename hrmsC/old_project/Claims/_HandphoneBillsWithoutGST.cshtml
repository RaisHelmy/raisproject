@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimType = Model.ClaimSubTypeCategory;
    string ClaimsSubtypeName = ViewBag.HandphoneBillsWithoutGST_ClaimsSubtypeName;
    string GSTEnabled = (@ViewBag.HandphoneBillsWithoutGST_GSTEnabled + "").ToLower();
    string Status = @ViewBag.HandphoneBillsWithoutGST_Status;
    string dtStrStart = @ViewBag.HandphoneBillsWithoutGST_StartDate;
    string dtStrEnd = @ViewBag.HandphoneBillsWithoutGST_EndDate;
    string GSTMaximumValue = ViewBag.HandphoneBillsWithoutGST_GSTMaximumValue;
    string PostpaidMaxClaimable = ViewBag.HandphoneBillsWithoutGST_PostpaidMaxClaimable;
    string PrepaidMaxClaimable = ViewBag.HandphoneBillsWithoutGST_PrepaidMaxClaimable;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
}

<div class="portlet box blue subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimType - @ClaimsSubtypeName
        </div>

        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')"><img style=" vertical-align: initial;" src="../Assets/img/portlet-remove-icon-white.png" /></a>
            </div>

        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">Charge Code *</th>
                                <th scope="col">Subscription Type *</th>
                                <th scope="col">Handphone No.</th>
                                <th scope="col">Statement Date*</th>
                                <th scope="col">Monthly Charges (RM)</th>
                                <th scope="col">(+) Chargable Usage (RM) *</th>
                                <th scope="col">(-) Personal Calls - On Net Calls (RM)</th>
                                <th scope="col">(-) Personal Calls - Off Net Calls (RM)</th>
                                <th scope="col">(-) Personal Calls - Domestic Calls (RM)</th>
                                <th scope="col">(-) Personal Calls - Domestic SMS (RM)</th>
                                <th scope="col">(-) Personal Calls - Others (RM)</th>
                                <th scope="col">Subtotal (RM)</th>
                                <th scope="col">(+) Service Tax (RM)</th>
                                <th scope="col">(-) Discounts / Rebates (RM)</th>
                                <th scope="col">Total Handphone Bill (RM)</th>
                                <th scope="col">Total Claimable (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @{
                            List<SelectListItem> SubscriptionTypeList = new List<SelectListItem>();
                            SubscriptionTypeList.Add(new SelectListItem { Text = "Select One", Value = "" });
                            SubscriptionTypeList.Add(new SelectListItem { Text = "Postpaid", Value = "Postpaid" });
                            SubscriptionTypeList.Add(new SelectListItem { Text = "Prepaid", Value = "Prepaid" });
                        }

                        @Html.DropDownList(DataTableID + "HiddenDDL", SubscriptionTypeList, new { @id = DataTableID + "HiddenDDL", @class = "bs-select form-control hidden " + DataTableID + "hiddenDDL", @style = "min -width:200px" })


                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="@(DataTableID)RemoveCheckbox" /></td>
                                        <td>
                                            <input type="hidden" class="hfChargeCode" />
                                            <select style="min-width:130px" class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn0" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();">
                                                <option value="">Select One</option>
                                            </select>
                                        </td>
                                        <td>
                                            @Html.DropDownList("ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn1", SubscriptionTypeList, new { @id = "ClaimsSubtypeCategory[" + Model.categoryIndex + "].ClaimSubtype[" + Model.subtypeIndex + "].SubTypeDetails[0].SubTypeColumn1", @class = "bs-select form-control SubTypeColumn1", @style = "min-width:160px", @onchange = (DataTableID) + "Calculation(this)" })
                                        </td>
                                        <td>
                                            <input type="tel" style="min-width:140px" class="form-control SubTypeColumn2"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2"
                                                   placeholder="+6012-34567890" />

                                        </td>
                                        <td>
