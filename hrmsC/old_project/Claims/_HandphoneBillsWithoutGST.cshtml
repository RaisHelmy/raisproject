                                                   onblur="@(DataTableID)_CalculateSumGST(this);" value="0.00"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" />
                                        </td>
                                        <td>
                                            <input type="text" maxlength="10" class="form-control text-right TotalAmount" value="0.00"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount"
                                                   id="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" readonly />
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="16"></td>
                                        <td><input type="text" style="min-width:130px" maxlength="10" value="0.00" class="form-control text-right GrandAmount" readonly /></td>
