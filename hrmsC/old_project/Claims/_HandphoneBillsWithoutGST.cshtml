            "mask":"+6099-99999999"
        });

        BindtoDDL();
        CalculateSummary();
    }


    function @(DataTableID)_CalculateSubtotal()
    {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".TotalAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = (grandAmount + (_Amount*1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandTotal + (_TotalAmount * 1);
            }
        });
        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
        CalculateSummary();
    }

    function @(DataTableID)Calculation(x)
    {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');


            var $row = $(x).closest("tr");
            var _SelectedType = $row.find(".SubTypeColumn1").val();
            var _MonthCharge = $row.find(".SubTypeColumn4").val();
            var _ChargeUsage = $row.find(".SubTypeColumn5").val();
            var _OnNet = $row.find(".SubTypeColumn6").val();
            var _OffNet = $row.find(".SubTypeColumn7").val();
            var _DomesticCall = $row.find(".SubTypeColumn8").val();
            var _DomesticSMS = $row.find(".SubTypeColumn9").val();
            var _Other = $row.find(".SubTypeColumn10").val();
            var _SubTotal = $row.find(".SubTypeColumn11").val();
            var _ServiceTax = $row.find(".SubTypeColumn12").val();
            var _Discount = $row.find(".SubTypeColumn13").val();
            var _@(DataTableID) = $row.find(".SubTypeColumn14").val();
            var _Amount = $row.find(".Amount").val();
            var _GSTAmount = $row.find(".GSTAmount").val();
            var _TotalAmount = $row.find(".TotalAmount").val();

            if (_SelectedType != "") {
                if (isNaN(_MonthCharge) || _MonthCharge.length == 0) { $row.find(".SubTypeColumn4").val("0.00"); } else { $row.find(".SubTypeColumn4").val(@(DataTableID)_FormatNumber(_MonthCharge)); }
                if (isNaN(_ChargeUsage) || _ChargeUsage.length == 0) { $row.find(".SubTypeColumn5").val("0.00"); } else { $row.find(".SubTypeColumn5").val(@(DataTableID)_FormatNumber(_ChargeUsage)); }
                if (isNaN(_OnNet) || _OnNet.length == 0) { $row.find(".SubTypeColumn6").val("0.00"); } else { $row.find(".SubTypeColumn6").val(@(DataTableID)_FormatNumber(_OnNet)); }
                if (isNaN(_OffNet) || _OffNet.length == 0) { $row.find(".SubTypeColumn7").val("0.00"); } else { $row.find(".SubTypeColumn7").val(@(DataTableID)_FormatNumber(_OffNet)); }
                if (isNaN(_DomesticCall) || _DomesticCall.length == 0) { $row.find(".SubTypeColumn8").val("0.00"); } else { $row.find(".SubTypeColumn8").val(@(DataTableID)_FormatNumber(_DomesticCall)); }
                if (isNaN(_DomesticSMS) || _DomesticSMS.length == 0) { $row.find(".SubTypeColumn9").val("0.00"); } else { $row.find(".SubTypeColumn9").val(@(DataTableID)_FormatNumber(_DomesticSMS)); }
                if (isNaN(_Other) || _Other.length == 0) { $row.find(".SubTypeColumn10").val("0.00"); } else { $row.find(".SubTypeColumn10").val(@(DataTableID)_FormatNumber(_Other)); }
                if (isNaN(_SubTotal) || _SubTotal.length == 0) { $row.find(".SubTypeColumn11").val("0.00"); } else { $row.find(".SubTypeColumn11").val(@(DataTableID)_FormatNumber(_SubTotal)); }
                if (isNaN(_ServiceTax) || _ServiceTax.length == 0) { $row.find(".SubTypeColumn12").val("0.00"); } else { $row.find(".SubTypeColumn12").val(@(DataTableID)_FormatNumber(_ServiceTax)); }
                if (isNaN(_Discount) || _Discount.length == 0) { $row.find(".SubTypeColumn13").val("0.00"); } else { $row.find(".SubTypeColumn13").val(@(DataTableID)_FormatNumber(_Discount)); }
                if (isNaN(_@(DataTableID)) || _@(DataTableID).length == 0) { $row.find(".SubTypeColumn14").val("0.00"); } else { $row.find(".SubTypeColumn14").val(@(DataTableID)_FormatNumber(_@(DataTableID))); }

                _MonthCharge = _MonthCharge * 1;
                _ChargeUsage = _ChargeUsage * 1;
                _OnNet = _OnNet * 1;
                _OffNet = _OffNet * 1;
                _DomesticCall = _DomesticCall * 1;
                _Other = _Other * 1;
                _SubTotal = _SubTotal * 1;
                _ServiceTax = _ServiceTax * 1;
                _Discount = _Discount * 1;
                _@(DataTableID) = _@(DataTableID) * 1;


                var SubTotal = (parseFloat(_MonthCharge)|| 0)  + (parseFloat(_ChargeUsage)|| 0)  - (parseFloat(_OnNet)|| 0)  - (parseFloat(_OffNet)|| 0)  - (parseFloat(_DomesticCall)|| 0)  - (parseFloat(_DomesticSMS)|| 0)  - (parseFloat(_Other)|| 0) ;
                $row.find(".SubTypeColumn11").val(SubTotal.toFixed(2));

                var HandphoneBill = (parseFloat(SubTotal)|| 0)  + (parseFloat(_ServiceTax)|| 0)  - (parseFloat(_Discount)|| 0) ;
                $row.find(".SubTypeColumn14").val(HandphoneBill.toFixed(2));

                var MaxClaimable = 0;
                if (_SelectedType == "Prepaid") {
                    MaxClaimable = '@PrepaidMaxClaimable';
                }
                else {
                    MaxClaimable = '@PostpaidMaxClaimable';
                }
                var TotalClaimable = 0;
                if ((parseFloat(HandphoneBill)|| 0)  >= (parseFloat(MaxClaimable)|| 0) ) {
                    TotalClaimable = parseFloat(MaxClaimable);
                }
                else {
                    TotalClaimable = parseFloat(HandphoneBill);
                }
                $row.find(".Amount").val(TotalClaimable.toFixed(2));

                var gstAmt = 0;
                if ('@GSTEnabled' != 'false') {
                    var gstMaxValue = '@GSTMaximumValue';
                    if (TotalClaimable != "0")
                    {
                        gstAmt = parseFloat(TotalClaimable) * (parseFloat(gstMaxValue) / 100);
                    }
                }
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));

                var TotalAmount = 0;
                TotalAmount = parseFloat(TotalClaimable) + (parseFloat(gstAmt));
                $row.find(".TotalAmount").val(TotalAmount.toFixed(2));
            }

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_CalculateSumGST(x) {
        if (x != undefined) {
            var myNumeric = parseFloat($(x).val().replace(/,/g, ''));
            if (!myNumeric) {
                $(x).val('0.00');
            }
            else {
                $(x).val(myNumeric.toFixed(2));
                //$(this).val(ThousandSeparator(myNumeric.toFixed(2)));
            }
        }

        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tbl@(DataTableID)');

        var $row = $(x).closest("tr");
        var amount = $row.find(".Amount").val();
        var gstAmount = parseFloat($row.find(".GSTAmount").val()) || 0;
        var gstAmt = 0;
        var gstMaxValue = 0;
        var TotalAmount = 0;

        if ('@GSTEnabled' != 'false') {
            if (gstAmount == 0.00) {
                gstMaxValue = '@GSTMaximumValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }
            else {
                gstAmt = gstAmount;
            }
        }

        TotalAmount = (parseFloat(amount) || 0) + (parseFloat(gstAmt.toFixed(2)) || 0);
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();
        CalculateSummary();
    }

    function @(DataTableID)_FormatNumber(x)
    {
        var number = "";
        var myNumeric = parseFloat(x.replace(/,/g, ''));
        if (!myNumeric) {
            number = "0.00";
        }
        else {
            number = myNumeric.toFixed(2);
        }

        return number;
    }

    function @(DataTableID)GetDDLListInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());

            var _DDLSelect = $(this).children('td:eq(2)').children('select');
            var _DDLHidden = $(this).children('td:eq(2)').children('input[type=hidden]');
            _DDLSelect.val(_DDLHidden.val());

        });
    }

    function @(DataTableID)_DateDropdownListxx() {
        var rowCount = _@(DataTableID)Table.fnSettings().fnRecordsTotal() - 1;
        var StatementDate = $('.SubTypeColumn3[name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + rowCount + '].SubTypeColumn3');
        StatementDate.empty();
        StatementDate.append('<option value="">Select One</option>');

        // P is Previous

        var today = new Date();
        var P_SecondMonth = new Date();
        var P_ThirdMonth = new Date();
        var CurrentDay = today.getDate();
        var CurrentMonth = today.getMonth() + 1;
        var GetP_SecondMonth = today.getMonth();
        var GetP_ThirdMonth = today.getMonth() - 1;
        var Year = today.getFullYear();
        var LastYear = today.getFullYear() - 1;
        var GetPreviousMonth_1;
        var GetPreviousMonth_2;
        var isPreviousYear_1 = false;
        var isPreviousYear_2 = false;

        const monthNames = ["January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];
        const d = new Date();

        if (CurrentMonth == 1) {
            GetPreviousMonth_1 = 11;
            GetPreviousMonth_2 = 10;
        }
        else if (CurrentMonth == 2) {
            GetPreviousMonth_2 = 11;
        }

        if (CurrentMonth == 1) {
            today = CurrentDay + '/' + "0" + CurrentMonth + '/' + Year;
            P_SecondMonth = CurrentDay + '/' + 12 + '/' + LastYear;
            P_ThirdMonth = CurrentDay + '/' + 11 + '/' + LastYear;
            isPreviousYear_1 = true;
        }
        else if (CurrentMonth == 2) {
            today = CurrentDay + '/' + "0" + CurrentMonth + '/' + Year;
            P_SecondMonth = CurrentDay + '/' + "0" + GetP_SecondMonth + '/' + Year;
            P_ThirdMonth = CurrentDay + '/' + 12 + '/' + LastYear;
            isPreviousYear_2 = true;
        }
        else {
            if (CurrentMonth < 10 || GetP_SecondMonth < 10 || GetP_ThirdMonth < 10) {
                if (CurrentMonth < 10) {
                    today = CurrentDay + '/' + "0" + CurrentMonth + '/' + Year;
                }

                if (GetP_SecondMonth < 10) {
                    P_SecondMonth = CurrentDay + '/' + "0" + GetP_SecondMonth + '/' + Year;
                }

                if (GetP_ThirdMonth < 10) {
                    P_ThirdMonth = CurrentDay + '/' + "0" + GetP_ThirdMonth + '/' + Year
                }
            }
            else {
                today = CurrentDay + '/' + CurrentMonth + '/' + Year;
                P_SecondMonth = CurrentDay + '/' + GetP_SecondMonth + '/' + Year;
                P_ThirdMonth = CurrentDay + '/' + GetP_ThirdMonth + '/' + Year;
            }
        }

        if (isPreviousYear_1) {
            StatementDate.append('<option value="' + P_ThirdMonth + '">' + monthNames[GetPreviousMonth_2] + " " + LastYear + '</option>');
            StatementDate.append('<option value="' + P_SecondMonth + '">' + monthNames[GetPreviousMonth_1] + " " + LastYear + '</option>');
            StatementDate.append('<option value="' + today + '">' + monthNames[d.getMonth()] + " " + Year + '</option>');
        }
        else if (isPreviousYear_2) {
            StatementDate.append('<option value="' + P_ThirdMonth + '">' + monthNames[GetPreviousMonth_2] + " " + LastYear + '</option>');
            StatementDate.append('<option value="' + P_SecondMonth + '">' + monthNames[d.getMonth() - 1] + " " + Year + '</option>');
            StatementDate.append('<option value="' + today + '">' + monthNames[d.getMonth()] + " " + Year + '</option>');
        }
        else {
            StatementDate.append('<option value="' + P_ThirdMonth + '">' + monthNames[d.getMonth() - 2] + " " + Year + '</option>');
            StatementDate.append('<option value="' + P_SecondMonth + '">' + monthNames[d.getMonth() - 1] + " " + Year + '</option>');
            StatementDate.append('<option value="' + today + '">' + monthNames[d.getMonth()] + " " + Year + '</option>');
        }
    }

    function @(DataTableID)_DateDropdownList() {
        var rowCount = _@(DataTableID)Table.fnSettings().fnRecordsTotal() - 1;

        @{
            DateTime dateNow = DateTime.UtcNow.AddHours(8);
            DateTime month2 = dateNow.AddMonths(-1);
            DateTime month3 = dateNow.AddMonths(-2);
        }

        for (var i = 0; i < rowCount + 1; i++) {
            var StatementDate = $('select.SubTypeColumn3[name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails['
                + parseInt(rowCount - i) + '].SubTypeColumn3"]');

            if (!StatementDate.hasClass('DDL-Loaded')) {
                StatementDate.empty();
                StatementDate.append('<option value="">Select One</option>');
                StatementDate.append('<option value="@dateNow.ToString("dd/MM/yyyy")">@dateNow.ToString("MMMM yyyy")</option>');
                StatementDate.append('<option value="@month2.ToString("dd/MM/yyyy")">@month2.ToString("MMMM yyyy")</option>');
                StatementDate.append('<option value="@month3.ToString("dd/MM/yyyy")">@month3.ToString("MMMM yyyy")</option>');
                StatementDate.addClass('DDL-Loaded');
            }

            //reselect value if any
            var StatementDateSelVal = StatementDate.attr('selval')
            if (typeof StatementDateSelVal !== 'undefined') {
                StatementDate.val(StatementDateSelVal).change();
            }
        }
    }

    $(document).ready(function () {
        @(DataTableID)_Initialize();

        @(DataTableID)GetDDLListInputValues();

        @(DataTableID)_DateDropdownList();
    });
</script>