@model List<ESS.Claim.ViewModels.FBAttachment>
@{
    Layout = null;
    string EmployeeID = ViewBag.EmployeeID;
    string Mode = ViewBag.Mode;
}

<div id="AttachmentControl" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i> Flexi Benefits Attachment
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="form-horizontal">
                        @if (string.IsNullOrEmpty(Mode))
                        {
                            <div id="divAddAttach" style="display:block">
                                <div class="form-group">
                                    <label class="col-md-3 control-label">Component</label>
                                    <div class="col-md-5 form-control-static">
                                        <select class="form-control" id="Component">
                                            <option value="Leave Passage">Leave Passage</option>
                                            <option value="Dental">Dental</option>
                                            <option value="Optical">Optical</option>
                                            <option value="Medical for Parents">Medical for Parents</option>
                                            <option value="Computer and PDA">Computer and PDA</option>
                                            <option value="Education Books">Education Books</option>
                                            <option value="Insurance">Insurance</option>
                                            <option value="Business Peripherals">Business Peripherals</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-3" id="CustomTextLabel1">Date</label>
                                    <div class="col-md-5 form-control-static">
                                        <div class="input-group date Customdate-picker" data-date-format="dd MM yyyy">
                                            <input type="text" class="form-control" id="CustomTextValue1" />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div class="form-group">
                                    <label class="control-label col-md-3">Attachment</label>
                                    <div class="col-md-5">
                                        <div class="input-group">
                                            <input type="file" name="Attachment" id="Attachment" onchange="ConvertImageToBaseSixtyFour();" />
                                        </div>
                                    </div>
                                </div>
                                <br />

                                <div class="form-group">
                                    <label class="control-label col-md-3"> Attachment Description</label>
                                    <div class="col-md-8">
                                        <textarea class="form-control" rows="2" style="width:100%;" id="AttachDescription"></textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="form-group">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-8">
                                        <span class="input-group-btn">
                                            <button id="btnAttach" class="btn default" type="button" onclick="FileValidation()">Attach</button>
                                        </span>
                                    </div>

                                </div>

                                <div class="hidden">
                                    <input id="hfFileSize" type="text" value="@ViewBag.MaximumFileSize" />
                                    <input id="hfFileExtension" type="text" value="@ViewBag.AllowedFileTypes" />
                                    <input type="text" name="FileContents" id="FileContents" />
                                    <input type="text" name="DocumentName" id="DocumentName" />
                                    <input type="text" name="DocumentSize" id="DocumentSize" />
                                    <input type="text" name="DocumentContentType" id="DocumentContentType" />
                                    <input type="text" name="DocumentDescription" id="DocumentDescription" />
                                    <input type="text" name="AttachEmployeeID" id="AttachEmployeeID" value="@EmployeeID" />
                                    <input type="text" name="SourceType" id="SourceType" value="FlexiBenefits" />
                                    <input type="text" name="DocID" id="ID" value="@Guid.NewGuid().ToString()" />
                                </div>

                            </div>
                        }

                        <div id="AttachmentListing">
                            @Html.Partial("FBAttachmentListing", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
    var Attach = "";
    //Page Load
    $(document).ready(function () {

        $('.Customdate-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
    });

    // helper function
    function guid() {
        function s4() {
            return Math.floor((1 + Math.random()) * 0x10000)
              .toString(16)
              .substring(1);
        }
        return s4() + s4() + '-' + s4() + '-' + s4() + '-' +
          s4() + '-' + s4() + s4() + s4();
    }

    function ConvertImageToBaseSixtyFour() {
        var _AllowedMaxSize = parseFloat(document.getElementById('hfFileSize').value) || 0;
        var _AllowedExtensions = document.getElementById('hfFileExtension').value;
        var _selectedFile = document.getElementById('Attachment').files;

        if (_selectedFile.length > 0) {
            var _fileToLoad = _selectedFile[0];

            var _fileReader = new FileReader();

            _fileReader.onload = function (fileLoadedEvent) {
                var _ValidFile = false;
                var _documentName = $('#Attachment')[0].files[0].name;
                var _documentSize = $('#Attachment')[0].files[0].size;
                var _fileExtension = _documentName.substring(_documentName.lastIndexOf('.') + 1).toLowerCase();

                if (_AllowedExtensions.indexOf(_fileExtension) > -1) {
                    var _docSize = parseFloat(_documentSize) || 0;
                    if (_docSize > _AllowedMaxSize) {
                        document.getElementById('Attachment').value = '';
                        alert('- File size has exceeded the allowed limit of ' + _AllowedMaxSize + ' bit');
                    }
                    else {
                        _ValidFile = true;
                    }
                }
                else {
                    document.getElementById('Attachment').value = '';
                    alert('- Invalid file type. Only files of the following extensions are allowed (' + _AllowedExtensions + ')');
                }

                if (_ValidFile) {
                    var _fileContents = document.getElementById("FileContents");
                    _fileContents.value = fileLoadedEvent.target.result;
                    Attach = fileLoadedEvent.target.result;
                    var _documentContentType = _fileContents.value.split(",")[0].split(":")[1].split(";")[0];

                    document.getElementById('DocumentName').value = _documentName;
                    document.getElementById('DocumentSize').value = _documentSize;
                    document.getElementById('DocumentContentType').value = _documentContentType;
                }
            };

            _fileReader.readAsDataURL(_fileToLoad);
        }
    }

    function FileValidation() {
        var ValidationMsg = '';
        var _selectedFile = document.getElementById('Attachment').value;
        var _Date = document.getElementById('CustomTextValue1').value;

        if (_selectedFile == '') {
            ValidationMsg += '- Please Select a file to upload.\n'
        }

        if (_Date == '') {
            ValidationMsg += '- Date is required.\n'
        }

        // Consolidate Message
        if (ValidationMsg != null && ValidationMsg != '') {
            alert(ValidationMsg);
        }
        else {
            StructureAttachmentListing();
            clearInput();
        }

    }

    function clearInput() {
        document.getElementById('AttachDescription').value = "";
        document.getElementById('ID').value = guid();
        document.getElementById('FileContents').value = "";
        document.getElementById('DocumentName').value = "";
        document.getElementById('DocumentSize').value = "";
        document.getElementById('DocumentContentType').value = "";
        document.getElementById('Attachment').value = "";


        var CustomField = document.getElementById('CustomTextValue1');

        if (CustomField !== null) {
            document.getElementById('CustomTextValue1').value = "";
        }

    }

    function StructureAttachmentListing() {
        var _ID = document.getElementById('ID').value;
       // var _FileContents = document.getElementById('FileContents').value;
        var _FileContents = Attach;
        var _DocumentName = document.getElementById('DocumentName').value;
        var _DocumentSize = document.getElementById('DocumentSize').value;
        var _DocumentContentType = document.getElementById('DocumentContentType').value;
        var _DocumentDescription = document.getElementById('AttachDescription').value;
        var _AttachEmployeeID = document.getElementById('AttachEmployeeID').value;
        var _SourceType = document.getElementById('SourceType').value;
        var _RequestID = $('input[name="ID"]').val();
        var _CreatedDate = '@DateTime.Now';
        var _CustomTextValue1 = document.getElementById('CustomTextValue1').value;
        var _CustomTextLabel1 = 'Date';
        var _ControlType1 = 'datepicker';
        var _Component = document.getElementById('Component').value;
        var _AttachRemarks = 'new';

        var form = {
            ID: _ID,
            SourceID: _RequestID,
            Component: _Component,
            FileContent: _FileContents,
            FileName: _DocumentName,
            FileSize: _DocumentSize,
            ContentType: _DocumentContentType,
            Description: _DocumentDescription,
            EmployeeID: _AttachEmployeeID,
            SourceType: _SourceType,
            RequestID: _RequestID,
            CustomTextLabel1: _CustomTextLabel1,
            CustomTextValue1: _CustomTextValue1,
            ControlType1: _ControlType1,
            CreatedDate: _CreatedDate,
            AttachRemarks: _AttachRemarks
        };

        $.ajax({
            url: '@Url.Content("~/Claims/FBAttachmentListing?ActionType=add&Mode" + @Mode)',
            type: 'POST',
            data: form,
            dataType: "text",
            //contentType: "application/json;charset=utf-8",
            cache: false,
            dataType: "html",
            success: function (data) {
                $("#AttachmentListing").html(data);
                Attach = "";
            },
            error: function (x, y, z) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

    function DownloadFBDocument(ID) {
        var url = '@Url.Content("~/Claims/FBAttachDownload")';
        window.open(url + '?ID=' + ID);
    }

    function DownloadFBDocumentFromDB(ID) {
        var AttachmentID = ID;
        //window.open(Path + '/api/FileWebApi/' + AttachmentID);

        var jqxhr = $.ajax(Path + '/ETKMS')
            .done(function () {
                window.open(Path + '/Attachment/DownloadFile/' + AttachmentID);
            });
    }

    function DeleteDocument(_ID) {
       // var _FileContents = document.getElementById('FileContents').value;
        var _FileContents = Attach;
        var _DocumentName = document.getElementById('DocumentName').value;
        var _DocumentSize = document.getElementById('DocumentSize').value;
        var _DocumentContentType = document.getElementById('DocumentContentType').value;
        var _DocumentDescription = document.getElementById('AttachDescription').value;
        var _AttachEmployeeID = document.getElementById('AttachEmployeeID').value;
        var _SourceType = document.getElementById('SourceType').value;
        var _RequestID = $('input[name="ID"]').val();
        var _CreatedDate = '@DateTime.Now';
        var _CustomTextValue1 = document.getElementById('CustomTextValue1').value;
        var _CustomTextLabel1 = 'Date';
        var _ControlType1 = 'datepicker';
        var _Component = document.getElementById('Component').value;
        var _AttachRemarks = 'new';

        var form = {
            ID: _ID,
            SourceID: _RequestID,
            Component: _Component,
            FileContent: _FileContents,
            FileName: _DocumentName,
            FileSize: _DocumentSize,
            ContentType: _DocumentContentType,
            Description: _DocumentDescription,
            EmployeeID: _AttachEmployeeID,
            SourceType: _SourceType,
            RequestID: _RequestID,
            CustomTextLabel1: _CustomTextLabel1,
            CustomTextValue1: _CustomTextValue1,
            ControlType1: _ControlType1,
            CreatedDate: _CreatedDate,
            AttachRemarks: _AttachRemarks
        };

        $.ajax({
            url: '@Url.Content("~/Claims/FBAttachmentListing")',
            type: 'POST',
            data: { FBAttachItem: form, ID: _ID, ActionType: 'remove' },
            cache: false,
            dataType: "html",
            success: function (data) {
                $("#AttachmentListing").html(data);
            },
            error: function (x, y, z) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

    function DeleteFBDocumentFromDB(_ID) {
       // var _FileContents = document.getElementById('FileContents').value;
        var _FileContents = Attach;
        var _DocumentName = document.getElementById('DocumentName').value;
        var _DocumentSize = document.getElementById('DocumentSize').value;
        var _DocumentContentType = document.getElementById('DocumentContentType').value;
        var _DocumentDescription = document.getElementById('AttachDescription').value;
        var _AttachEmployeeID = document.getElementById('AttachEmployeeID').value;
        var _SourceType = document.getElementById('SourceType').value;
        var _RequestID = $('input[name="ID"]').val();
        var _CreatedDate = '@DateTime.Now';
        var _CustomTextValue1 = document.getElementById('CustomTextValue1').value;
        var _CustomTextLabel1 = 'Date';
        var _ControlType1 = 'datepicker';
        var _Component = document.getElementById('Component').value;
        var _AttachRemarks = 'new';

        var form = {
            ID: _ID,
            SourceID: _RequestID,
            Component: _Component,
            FileContent: _FileContents,
            FileName: _DocumentName,
            FileSize: _DocumentSize,
            ContentType: _DocumentContentType,
            Description: _DocumentDescription,
            EmployeeID: _AttachEmployeeID,
            SourceType: _SourceType,
            RequestID: _RequestID,
            CustomTextLabel1: _CustomTextLabel1,
            CustomTextValue1: _CustomTextValue1,
            ControlType1: _ControlType1,
            CreatedDate: _CreatedDate,
            AttachRemarks: _AttachRemarks
        };

        $.ajax({
            url: '@Url.Content("~/Claims/FBAttachmentListing")',
            type: 'POST',
            data: { FBAttachItem: form, ID: _ID, ActionType: 'removeDB' },
            cache: false,
            dataType: "html",
            success: function (data) {
                $("#AttachmentListing").html(data);
            },
            error: function (x, y, z) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

</script>
