@model ESS.AdvanceClaim.Models.AdvanceClaim

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Claims Particular
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct01_CustomFieldFormView">

                    <div class="row" style="">
                        <div id="divCurrentApprover" class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-2">Outstation Form</label>
                                    <div class="col-md-4 form-control-static">
                                        <label>@Model.OutstationRefNo (Linked)</label>
                                        <input type="hidden" name="OutstationFormID" value="@Model.OutstationFormID"/>
                                    </div>

                                    <label class="control-label col-md-2">Category</label>
                                    <div class="col-md-4 form-control-static">
                                        <label id="ct01_Category" class="LabelDisplay">@Model.RequestType</label>
                                        <input type="hidden" name="RequestType" value="@Model.RequestType" />
                                        <input type="hidden" name="RequestTypeCode" value="@Model.RequestTypeCode" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    @if (Model.Status == 0)
                    {
                        <div id="trClaimsDate" class="row" style="">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Start Date @*<span id="dtStartDate" style="color:red;"> *</span>*@
                                        </label>

                                        <div class="col-md-4 form-control-static">
                                            @*<div id="divEndDate" class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                    @Html.TextBoxFor(m => m.Item1.StartDate, new { @class = "form-control" })
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>*@
                                            <label>@Model.StartDate</label>
                                        </div>
                                        <label class="control-label col-md-2">
                                            End Date @*<span id="dtEndDate" style="color:red;"> *</span>*@
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            @*<div id="divEndDate" class="input-group date date-picker" data-date-format="dd MM yyyy">
                                                    @Html.TextBoxFor(m => m.Item1.EndDate, new { @class = "form-control" })
                                                    <span class="input-group-btn">
                                                        <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                    </span>
                                                </div>*@
                                            <label>@Model.EndDate</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div id="trClaimsTime" class="row" style="">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Start Time @*<span id="dtStartDate" style="color:red;"> *</span>*@
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            @*@Html.TextBoxFor(m => m.Item1.StartTime, new { @class = "form-control timeinput", @placeholder = "HH:MM (e.g 12:30)" })*@
                                            <label>@Model.StartTime</label>
                                        </div>

                                        <label class="control-label col-md-2">
                                            End Time @*<span id="dtEndTime" style="color:red;"> *</span>*@
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            @*@Html.TextBoxFor(m => m.Item1.EndTime, new { @class = "form-control timeinput", @placeholder = "HH:MM (e.g 12:30)" })*@
                                            <label>@Model.EndTime</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div id="trClaimsRemarks" class="row" style="">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Remarks</label>
                                        <div class="col-md-10 form-control-static">
                                            @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", rows = "5" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="trClaimsDate" class="row" style="">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Start Date <span id="dtStartDate" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            @Html.TextBoxFor(m => m.StartDate, new { @class = "form-control", @ReadOnly = "Readyonly" })
                                        </div>
                                        <label class="control-label col-md-2">
                                            End Date <span id="dtEndDate" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            @Html.TextBoxFor(m => m.EndDate, new { @class = "form-control", @ReadOnly = "Readyonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div id="trClaimsTime" class="row" style="">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">
                                            Start Time <span id="dtStartDate" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            @Html.TextBoxFor(m => m.StartTime, new { @class = "form-control timeinput", @placeholder = "HH:MM (e.g 12:30)", @ReadOnly = "Readyonly" })

                                        </div>

                                        <label class="control-label col-md-2">
                                            End Time <span id="dtEndTime" style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-4 form-control-static">
                                            @Html.TextBoxFor(m => m.EndTime, new { @class = "form-control timeinput", @placeholder = "HH:MM (e.g 12:30)", @ReadOnly = "Readyonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div id="trClaimsRemarks" class="row" style="">
                            <div class="col-md-12">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-2">Remarks</label>
                                        <div class="col-md-10 form-control-static">
                                            @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", rows = "5", @ReadOnly = "Readyonly" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    }

                </div>
            </div>
        </div>
    </div>
</div>