@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.SubsistenceOutstation_GSTMaxValue;
    string GSTMaxValue = ViewBag.SubsistenceOutstation_GSTMaximumValue;
    string GSTEnabled = (@ViewBag.SubsistenceOutstation_GSTEnabled + "").ToLower();
    string Status = @ViewBag.SubsistenceOutstation_Status;
}

<div class="portlet box blue" id="dTable_SubsistenceOutstation">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@ClaimsSubtypeName
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tblSubsistenceOutstation">
                        <thead>
                            <tr>
                                <th scope="col" width="5%"></th>
                                <th scope="col">No. Of Days</th>
                                <th scope="col">No. Of Extra Hours</th>
                                <th scope="col">24 Hour Rate</th>
                                <th scope="col">Extra Hours Rate</th>
                                <th scope="col">Subtotal (RM)</th>
                                <th scope="col">B/fast Provided (Qty.)</th>
                                <th scope="col">Subtotal B/fast (RM)</th>
                                <th scope="col">Lunch Provided (Qty.)</th>
                                <th scope="col">Subtotal Lunch (RM)</th>
                                <th scope="col">Dinner Provided (Qty.)</th>
                                <th scope="col">Subtotal Dinner (RM)</th>
                                <th scope="col">Total Meals (RM)</th>
                                <th scope="col">Total Subsistence (RM)</th>
                                <th scope="col">GST Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
                        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status =="Returned")
                        {
                            if (Model.SubTypeDetails == null)
                            {
                                <tbody>
                                    <tr>
                                        <td><input type="checkbox" class="SubsidiesOutstationRemoveCheckbox" /></td>
                                        <td><input type="text" class="form-control NoOfDays" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn1" /></td>
                                        <td><input type="text" class="form-control NoOfExtraHours" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn2" /></td>
                                        <td><input type="text" class="form-control TwentyFourHourRate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn3" /></td>
                                        <td><input type="text" class="form-control ExtraHoursRate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn4" /></td>
                                        <td><input type="text" class="form-control Subtotal" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn5" /></td>
                                        <td><input type="text" class="form-control BreakfastProvided" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn6" /></td>
                                        <td><input type="text" class="form-control SubtotalBreakfast" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn7" /></td>
                                        <td><input type="text" class="form-control LunchProvided" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn8" /></td>
                                        <td><input type="text" class="form-control SubtotalLunch" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn9" /></td>
                                        <td><input type="text" class="form-control DinnerProvided" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn10" /></td>
                                        <td><input type="text" class="form-control SubtotalDinner" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn11" /></td>
                                        <td><input type="text" class="form-control TotalMeals" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].SubTypeColumn12" /></td>
                                        <td><input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].Amount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].GSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[0].TotalAmount" readonly /></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                            else
                            {
                                int count = 0;

                                <tbody>
                                    @foreach (var thisDetail in Model.SubTypeDetails)
                                    {
                                    <tr>
                                        <td><input type="checkbox" class="SubsidiesOutstationRemoveCheckbox" /></td>
                                        <td>
                                            <input type="text" class="form-control NoOfDays" value="@thisDetail.SubTypeColumn1"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn1" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control NoOfExtraHours" value="@thisDetail.SubTypeColumn2"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn2" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control TwentyFourHourRate" value="@thisDetail.SubTypeColumn3"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn3" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control ExtraHoursRate" value="@thisDetail.SubTypeColumn4"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn4" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Subtotal" value="@thisDetail.SubTypeColumn5"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn5" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control BreakfastProvided" value="@thisDetail.SubTypeColumn6"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn6" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubtotalBreakfast" value="@thisDetail.SubTypeColumn7"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn7" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control LunchProvided" value="@thisDetail.SubTypeColumn8"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn8" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubtotalLunch" value="@thisDetail.SubTypeColumn9"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn9" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control DinnerProvided" value="@thisDetail.SubTypeColumn10"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn10" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control SubtotalDinner" value="@thisDetail.SubTypeColumn11"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn11" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control TotalMeals" value="@thisDetail.SubTypeColumn12"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn12" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control Amount" value="@thisDetail.Amount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" readonly />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                                   name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" readonly />
                                        </td>
                                    </tr>

                                        count++;
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                    </tr>
                                </tfoot>
                            }
                        }
                        else
                        {
                            int count = 0;

                            <tbody>
                                @foreach (var thisDetail in Model.SubTypeDetails)
                                {
                                <tr>
                                    <td>
                                        <input type="text" class="form-control NoOfDays" value="@thisDetail.SubTypeColumn1" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn1" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control NoOfExtraHours" value="@thisDetail.SubTypeColumn2" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn2" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control TwentyFourHourRate" value="@thisDetail.SubTypeColumn3" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn3" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control ExtraHoursRate" value="@thisDetail.SubTypeColumn4" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn4" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control Subtotal" value="@thisDetail.SubTypeColumn5" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn5" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control BreakfastProvided" value="@thisDetail.SubTypeColumn6" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn6" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control SubtotalBreakfast" value="@thisDetail.SubTypeColumn7" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn7" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control LunchProvided" value="@thisDetail.SubTypeColumn8" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn8" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control SubtotalLunch" value="@thisDetail.SubTypeColumn9" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn9" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control DinnerProvided" value="@thisDetail.SubTypeColumn10" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn10" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control SubtotalDinner" value="@thisDetail.SubTypeColumn11" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn11" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control TotalMeals" value="@thisDetail.SubTypeColumn12" readonly
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].SubTypeColumn12" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control Amount" value="@thisDetail.Amount"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].Amount" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control text-right GSTAmount" value="@thisDetail.GSTAmount"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].GSTAmount" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control text-right SubTotalAmount" value="@thisDetail.TotalAmount"
                                               name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[count].TotalAmount" readonly />
                                    </td>
                                </tr>

                                    count++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"></td>
                                    <td><input type="text" class="form-control text-right GrandAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.Amount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandGSTAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.GSTAmount))" readonly /></td>
                                    <td><input type="text" class="form-control text-right GrandTotalAmount" value="@Model.SubTypeDetails.Sum(m => Convert.ToDecimal(m.TotalAmount))" readonly /></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="btn-group">
                                <a class="BtnPlus btn green" title="dTable_SubsistenceOutstation" href="javascript:SubsistenceOutstation_addRow();">
                                    Add Row
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="BtnPlus5 btn green" title="dTable_SubsistenceOutstation" href="javascript:SubsistenceOutstation_add5Row();">
                                    Add 5 Rows
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                            <div class="btn-group">
                                <a class="deleteall btn red" title="dTable_SubsistenceOutstation" href="javascript:SubsistenceOutstation_removeRow();">
                                    Delete Row
                                    <i class="fa fa-minus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var _SubsistenceOutstationTable = $('#tblSubsistenceOutstation').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    function dTable_SubsistenceOutstationValidation() {
        var _ValidationMsg = '';

        $('#tblSubsistenceOutstation tbody tr').not(':last').each(function () {
            var _GSTAmount = $(this).children('td:eq(14)').children('input[type=text]');

            if (_GSTAmount.value == '')
                _ValidationMsg += 'Travelling Allowance (Subsistence Allowance) - GST Amount (RM) is required.\n';
        });

        return _ValidationMsg;
    }

    function SubsistenceOutstation_removeRow() {
        $.each($('input[class="SubsidiesOutstationRemoveCheckbox"]:checked'), function (i, val) {
            var row = $(this).closest("tr").get(0);
            var id = $(this).attr("id");
            busTable.fnDeleteRow(mytable.fnGetPosition(row));
        });

        reorderTable('#tblSubsistenceOutstation');
    }

    function SubsistenceOutstation_add5Row() {
        SubsistenceOutstation_addRow();
        SubsistenceOutstation_addRow();
        SubsistenceOutstation_addRow();
        SubsistenceOutstation_addRow();
        SubsistenceOutstation_addRow();
    }

    function SubsistenceOutstation_addRow() {
        _SubsistenceOutstationTable.fnAddData([
           '<input type="checkbox" class="SubsidiesOutstationRemoveCheckbox" /></td>',
            '<input type="text" class="form-control NoOfDays" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" />',
            '<input type="text" class="form-control NoOfExtraHours" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" />',
            '<input type="text" class="form-control TwentyFourHourRate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" />',
            '<input type="text" class="form-control ExtraHoursRate" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" />',
            '<input type="text" class="form-control Subtotal" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" />',
            '<input type="text" class="form-control BreakfastProvided" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" />',
            '<input type="text" class="form-control SubtotalBreakfast" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" />',
            '<input type="text" class="form-control LunchProvided" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" />',
            '<input type="text" class="form-control SubtotalLunch" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn9" />',
            '<input type="text" class="form-control DinnerProvided" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn10" />',
            '<input type="text" class="form-control SubtotalDinner" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn11" />',
            '<input type="text" class="form-control TotalMeals" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].SubTypeColumn12" />',
            '<input type="text" class="form-control Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].Amount" readonly />',
            '<input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].GSTAmount" readonly />',
            '<input type="text" class="form-control text-right SubTotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _SubsistenceOutstationTable.fnSettings().fnRecordsTotal() + '].TotalAmount" readonly />'
        ]);

        SubsistenceOutstation_Initialize();
    }

    function SubsistenceOutstation_Initialize() {
        if ('@GSTEnabled' == 'false') {
            $('#tblSubsistenceOutstation tbody tr').each(function () {
                var _GSTAmount = $(this).children('td:eq(14)').children('input[type=text]');

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');
            });
        }
    }

    function SubsistenceOutstation_CalculateSum() {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#tblSubsistenceOutstation');

        //iterate through each textboxes and add the values
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".Amount").val();
            var gstAmt = 0;
            var gstMaxValue = 0;
            var Subtotalamount = 0;
            if ('@GSTEnabled' != 'false') {
                gstMaxValue = '@GSTMaxValue';
                gstAmt = amount * (parseFloat(gstMaxValue) / 100);
                $row.find(".GSTAmount").val(gstAmt.toFixed(2));
            }

            Subtotalamount = parseFloat(amount) + parseFloat(gstAmt.toFixed(2));
            $row.find(".SubTotalAmount").val(Subtotalamount.toFixed(2));

            //add only if the value is number
            if (!isNaN(amount) && amount.length != 0) {
                grandAmount = (grandAmount + (amount * 1));
                grandGST = (grandGST + (gstAmt * 1));
                grandTotal = grandTotal + (grandAmount + grandGST);
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
    }

    $(document).ready(function () {
        SubsistenceOutstation_Initialize();
    });
</script>