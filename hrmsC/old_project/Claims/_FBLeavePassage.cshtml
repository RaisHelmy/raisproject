        var id = +$div[0].id.match(/\d+/g) + 1;
        $div.after($div.clone().attr('id', 'new_line_details_' + id));

        $div = $("#" + tb).find('tr[id^="new_line_details_"]:last');
        // Transportation
        if (subtype == 'Transportation') {
            $div.find('.StartDate').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].StartDate');
            $div.find('.EndDate').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].EndDate');
            $div.find('.Type').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].Type');
            $div.find('.SelfDependant').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].SelfDependant');
            $div.find('.Name').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].Name');
            $div.find('.ClinicName').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].ClinicName');
            $div.find('.ProviderName').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].ProviderName');
            $div.find('.ShopName').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].ShopName');
            $div.find('.ReceiptNo').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].ReceiptNo');
            $div.find('.From').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].From');
            $div.find('.To').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].To');
            $div.find('.Description').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].Description');
            $div.find('.Amount').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].Amount');
            $div.find('.ApprovedAmount').attr('name', 'LeavePassage[' + index + '].Transportation[' + id + '].ApprovedAmount');
        }

        // Accommodation
