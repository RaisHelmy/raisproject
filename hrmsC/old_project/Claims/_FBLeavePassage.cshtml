@model  List<ESS.Claim.ViewModels.FlexiBenefitsLeavePassageDetails>
@{
    ViewBag.Title = "Leave Passage";
    Layout = null;
}

<div class="portlet box blue subtypeportlet" id="dTable_FBLeavePassage">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i> Leave Passage
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <input type="submit" class="btn green subtypeBtn" value="Add Destination" id="btnSubmit" name="SubmitType" />
                </div>

            </div>
            <div class="row">&nbsp;</div>
            @* Destination *@

            @{
                var data = new ViewDataDictionary 
                     { 
                         new KeyValuePair<string, object>("Dependant", ViewBag.DependantName), 
                         new KeyValuePair<string, object>("SubmitterName", ViewBag.SubmitterName) 
                     };
            }

            @if (Model.Count == 0)
            {
                @Html.Partial("_FBLeavePassageDetails", new ESS.Claim.ViewModels.FlexiBenefitsLeavePassageDetails() { Index = Model.Count, ID = (Guid.NewGuid()).ToString() }, data);
            }
            else
            {
                bool isOldFlexiDraft = false;
                if (Model.Count > 1 && (Model.Where(x => x.Index == 0).Count() == Model.Count))
                {
                    isOldFlexiDraft = true;
                }

                int index = 0;
                foreach (var item in @Model)
                {
                    if (isOldFlexiDraft)
                    {
                        item.Index = index;
                        index++;
                    }

                    @Html.Partial("_FBLeavePassageDetails", item, data);
                }
            }

            <!-- For Summary -->
            <input type="hidden" name="ClaimSubtype[0].SubTypeDetails[0].Amount" id="hfLPSubAmt" />
            <input type="hidden" name="ClaimSubtype[0].SubTypeDetails[0].ApprovedAmount" id="hfLPSubApprovedAmt" />
        </div>
    </div>
</div>

<script>

    function RemoveDestination(currIndex) {
        var idName = "CurrIndex" + currIndex;
        $("#" + idName).append('<input type="hidden" name="CurrIndex" value="' + currIndex + '" />');
        $('#btnHiddenRemove').click();

    }

    function addLPRow(tb, index, subtype) {

