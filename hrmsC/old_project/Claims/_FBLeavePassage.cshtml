            $div.find('.StartDate').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].StartDate');
            $div.find('.EndDate').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].EndDate');
            $div.find('.Type').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].Type');
            $div.find('.SelfDependant').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].SelfDependant');
            $div.find('.Name').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].Name');
            $div.find('.ClinicName').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].ClinicName');
            $div.find('.ProviderName').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].ProviderName');
            $div.find('.ShopName').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].ShopName');
            $div.find('.ReceiptNo').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].ReceiptNo');
            $div.find('.From').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].From');
            $div.find('.To').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].To');
            $div.find('.Description').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].Description');
            $div.find('.Amount').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].Amount');
            $div.find('.ApprovedAmount').attr('name', 'LeavePassage[' + index + '].Accommodation[' + id + '].ApprovedAmount');
        }


        // Miscellaneous
        if (subtype == 'Miscellaneous') {
            $div.find('.StartDate').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].StartDate');
            $div.find('.EndDate').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].EndDate');
            $div.find('.Type').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].Type');
            $div.find('.SelfDependant').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].SelfDependant');
            $div.find('.Name').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].Name');
            $div.find('.ClinicName').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].ClinicName');
            $div.find('.ProviderName').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].ProviderName');
            $div.find('.ShopName').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].ShopName');
            $div.find('.ReceiptNo').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].ReceiptNo');
            $div.find('.From').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].From');
            $div.find('.To').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].To');
            $div.find('.Description').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].Description');
            $div.find('.Amount').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].Amount');
            $div.find('.ApprovedAmount').attr('name', 'LeavePassage[' + index + '].Miscellaneous[' + id + '].ApprovedAmount');
        }


        $div.find('.StartDate').val('');
        $div.find('.EndDate').val('');
        $div.find('.ShopName').val('');
        $div.find('.ProviderName').val('');
        $div.find('.ReceiptNo').val('');
        $div.find('.From').val('');
        $div.find('.To').val('');
        $div.find('.Description').val('');
        $div.find('.ApprovedAmount').val('');
        $div.find('.Amount').val('0.00');

        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        reorderLPTable(tb);
        calculateLPSum(tb);
        LPDateInit();

    };

    function addLP5Row(tb, index, subtype) {
        addLPRow(tb, index, subtype);
        addLPRow(tb, index, subtype);
        addLPRow(tb, index, subtype);
        addLPRow(tb, index, subtype);
        addLPRow(tb, index, subtype);
    }

    function calculateLPSum(tb) {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#' + tb);
        //console.log(thisTable);
        //iterate through each textboxes and add the values
        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".Amount").val();
            var myNumeric = parseFloat(amount.replace(/,/g, ''));
            if (!myNumeric) {
                amount = "0.00";
            }
            else {
                amount = (myNumeric.toFixed(2));
            }

            //add only if the value is number
            if (!isNaN(amount) && amount.length != 0) {
                amount = parseFloat(amount.replace(/,/g, '')) || 0;
                $row.find(".Amount").val(amount.toFixed(2));
                $row.find(".ApprovedAmount").val(amount.toFixed(2));
                grandAmount = (grandAmount + (amount * 1));
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandApprovedAmount").val(grandAmount.toFixed(2));
        calculateLPSubtotalSum();
        CalculateSummary();
    }

    function calculateLPSubtotalSum() {
        var TotalSum = 0;
        $('#dTable_FBLeavePassage table').each(function () {
            var tablename = this.id;
            var totalValue = parseFloat($('#' + tablename).find('.GrandAmount').val()) || 0;
            TotalSum = parseFloat(TotalSum) + parseFloat(totalValue) || 0;
        });

        $('#dTable_FBLeavePassageLPSum').html(TotalSum.toFixed(2));
        $('#dTable_FBLeavePassageLPApproveSum').html(TotalSum.toFixed(2));
    }

    function calculateLPApproveSum(tb) {
        var sum = 0;
        var grandAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;
        var thisTable = $('#' + tb);

        thisTable.find(".ApprovedAmount").each(function () {
            var $row = $(this).closest("tr");
            var amount = $row.find(".ApprovedAmount").val();
            //add only if the value is number
            if (!isNaN(amount) && amount.length != 0) {
                amount = parseFloat(amount.replace(/,/g, '')) || 0;
                $row.find(".ApprovedAmount").val(amount.toFixed(2));
                grandAmount = (grandAmount + (amount * 1));
            }
            else {
                $row.find(".ApprovedAmount").val('0.00');
            }
        });

        thisTable.find(".GrandApprovedAmount").val(grandAmount.toFixed(2));
        calculateLPApproveSubtotalSum();
        CalculateApproveSummary();
    }

    function calculateLPApproveSubtotalSum() {
        var TotalSum = 0;
        $('#dTable_FBLeavePassage table').each(function () {
            var tablename = this.id;
            var totalValue = parseFloat($('#' + tablename).find('.GrandApprovedAmount').val()) || 0;
            TotalSum = parseFloat(TotalSum) + parseFloat(totalValue) || 0;
        });

        $('#dTable_FBLeavePassageLPApproveSum').html(TotalSum.toFixed(2));
    }

    function DeleteLPRow(tb) {
        var thisTable = $('#' + tb);
        var ch = thisTable.find('tbody input[type=checkbox]');
        var sel = false;
        var c = confirm('Confirm delete?');
        if (c) {
            ch.each(function () {
                var $this = $(this);
                if ($this.is(':checked')) {
                    sel = true;	//set to true if there is/are selected row

                    if ($(this).closest('tr').is('tr:only-child')) {
                        alert('Minimum line of record is required. Please uncheck the subtype selection to remove.');


                    } else {
                        $(this).closest("tr.new_line").remove();
                        calculateLPSum(tb);
                    }


                }
            });
            if (!sel) alert('No data selected');
        }

        reorderLPTable(tb);
        LPDateInit();
    }

    function reorderLPTable(tableName) {
        var int = 0;
        var name = '';

        $.each($('#' + tableName + ' tbody tr'), function (i, val) {

            $.each($(this).find('td [name]'), function (i, val) {
                var name = $(this).attr('name');
                $(this).attr('name', LPreorder(int, name));
                // var column =  $(this).find('[name]').attr('name').split('.');
            });
            int++;

        });
    }

    function LPreorder(currentIndex, name) {
        if (typeof name === "undefined") { } else
        {
            var ColumnNaw = name.split('.');
            var replaceIndex = ColumnNaw[1].match(/\d+/g);
            ColumnNaw[1] = ColumnNaw[1].replace(replaceIndex, currentIndex);
            return ColumnNaw.join('.');
        }
    }

    function dTable_FBLeavePassageValidation() {
        var ValidationMsg = '';
        var ParentTable = $('#dTable_FBLeavePassage');
        var Index = 1;

        var LPSum = $('#dTable_FBLeavePassageLPSum').html();

        if (LPSum == "0.00")
        {
            ValidationMsg += '- Leave Passage must have value.\n'
        }

        ParentTable.find(".destination").each(function () {
            var DestID = this.id;
            ValidationMsg += SubTypeValidation(DestID, Index);
            Index++;
        });

        if (ValidationMsg != null && ValidationMsg != '') {
            return ValidationMsg;
        }
        else {
            return '';
        }
    }

    function SubTypeValidation(DestID, Index) {

        var ValidationMsg = '';
        var CurrDest = $('#' + DestID);
        var DestinationName = CurrDest.find('#Destination').val();
        var LPno = Index - 1;
        var StartDate = CurrDest.find('#LPStartDate_' + LPno).val();
        var EndDate = CurrDest.find('#LPEndDate_' + LPno).val();

        if (DestinationName == null || DestinationName == '') {
            ValidationMsg += '- Destination (Leave Passage ' + Index + ') is required.\n'
        }
        if (StartDate == null || StartDate == '') {
            ValidationMsg += '- Start Date (Leave Passage ' + Index + ') is required.\n'
        }
        if (EndDate == null || EndDate == '') {
            ValidationMsg += '- End Date (Leave Passage ' + Index + ') is required.\n'
        }

        var f = toDate(StartDate);
        var t = toDate(EndDate);

        if (t < f) {
            ValidationMsg += '- End Date (Leave Passage ' + Index + ') must greater than Start Date (Leave Passage ' + Index + ').\n'
        }

        CurrDest.find(".table").each(function () {
            var TableID = this.id;
            ValidationMsg += SubSubtypeValidation(DestID, TableID, Index);
        });

        if (ValidationMsg != null && ValidationMsg != '') {
            return ValidationMsg;
        }
        else {
            return '';
        }

    }

    function SubSubtypeValidation(DestID, TableID, Index) {
        var ValidationMsg = '';
        var CurrDest = '#' + DestID;
        var CurrTable = '#' + TableID;
        var searchName = CurrDest + " " + CurrTable;

        var LPno = Index - 1;
        var CurrDestObj = $('#' + DestID);
        var LPSDate = CurrDestObj.find('#LPStartDate_' + LPno).val();
        var LPEDate = CurrDestObj.find('#LPEndDate_' + LPno).val();

        var fLPSDate = toDate(LPSDate);
        var tLPEDate = toDate(LPEDate);

        var Obj = $(searchName);
        if (TableID.indexOf("Transport") > -1) {
            Obj.find(".Amount").each(function () {
                var $row = $(this).closest("tr");
                var amount = $row.find(".Amount").val();
                var name = $row.find(".Name").val();
                var nameAttr = $row.find(".Name").attr('isddl');
                var name = $row.find(".Name").val();
                var From = $row.find(".From").val();
                var To = $row.find(".To").val();
                var date = $row.find(".StartDate").val();

                if (amount != '0.00') {
                    if ((name == null || name == '') && nameAttr == "false") {
                        ValidationMsg += '- Name (Transportation :Leave Passage' + Index + ') is required.\n'
                    }

                    if (date == null || date == '') {
                        ValidationMsg += '- Date (Transportation :Leave Passage' + Index + ') is required.\n'
                    }

                    if (From == null || From == '') {
                        ValidationMsg += '- From (Transportation :Leave Passage' + Index + ') is required.\n'
                    }

                    if (To == null || To == '') {
                        ValidationMsg += '- To (Transportation :Leave Passage' + Index + ') is required.\n'
                    }

                    var Tdate = toDate(date);

                    if (Tdate < fLPSDate) {
                        ValidationMsg += '- Date (Transportation :Leave Passage' + Index + ') must between than Start Date and End Date.\n'
                    }

                    if (Tdate > tLPEDate) {
                        ValidationMsg += '- Date (Transportation :Leave Passage' + Index + ') must between than Start Date and End Date.\n'
                    }
                }
                
            });
        }
        if (TableID.indexOf("Accommodation") > -1) {
            Obj.find(".Amount").each(function () {
                var $row = $(this).closest("tr");
                var amount = $row.find(".Amount").val();
                var startdate = $row.find(".StartDate").val();
                var enddate = $row.find(".EndDate").val();
                var ReceiptNo = $row.find(".ReceiptNo").val();

                if (amount != '0.00' ) {
                    if (ReceiptNo == null || ReceiptNo == '') {
                        ValidationMsg += '- Receipt No (Accommodation :Leave Passage' + Index + ') is required.\n'
                    }


                    if (startdate == null || startdate == '') {
                        ValidationMsg += '- Date From (Accommodation :Leave Passage' + Index + ') is required.\n'
                    }

                    if (enddate == null || enddate == '') {
                        ValidationMsg += '- Date To (Accommodation :Leave Passage' + Index + ') is required.\n'
                    }

                    var f = toDate(startdate);
                    var t = toDate(enddate);

                    if (t < f) {
                        ValidationMsg += '-  Date To (Accommodation :Leave Passage' + Index + ') must greater than Date From  (Accommodation :Leave Passage' + Index + ').\n'
                    }

                    if (f < fLPSDate) {
                        ValidationMsg += '- Date From (Accommodation :Leave Passage' + Index + ') must between than Start Date and End Date.\n'
                    }

                    if (f > tLPEDate) {
                        ValidationMsg += '- Date From (Accommodation :Leave Passage' + Index + ') must between than Start Date and End Date.\n'
                    }

                    if (t < fLPSDate) {
                        ValidationMsg += '- Date To (Accommodation :Leave Passage' + Index + ') must between than Start Date and End Date.\n'
                    }

                    if (t > tLPEDate) {
                        ValidationMsg += '- Date To (Accommodation :Leave Passage' + Index + ') must between than Start Date and End Date.\n'
                    }
                }

            });
        }
        if (TableID.indexOf("Miscellaneous") > -1) {
            Obj.find(".Amount").each(function () {
                var $row = $(this).closest("tr");
                var amount = $row.find(".Amount").val();
                var date = $row.find(".StartDate").val();
                var ReceiptNo = $row.find(".ReceiptNo").val();
                if (amount != '0.00') {

                    if (ReceiptNo == null || ReceiptNo == '') {
                        ValidationMsg += '- Receipt No (Miscellaneous :Leave Passage' + Index + ') is required.\n'
                    }

                    if (date == null || date == '') {
                        ValidationMsg += '- Date (Miscellaneous :Leave Passage' + Index + ') is required.\n'
                    }

                    var Tdate = toDate(date);

                    if (Tdate < fLPSDate) {
                        ValidationMsg += '- Date (Miscellaneous :Leave Passage' + Index + ') must between than Start Date and End Date.\n'
                    }

                    if (Tdate > tLPEDate) {
                        ValidationMsg += '- Date (Miscellaneous :Leave Passage' + Index + ') must between than Start Date and End Date.\n'
                    }
                }

            });
        }

        if (ValidationMsg != null && ValidationMsg != '') {
            return ValidationMsg;
        }
        else {
            return '';
        }
    }

    function dTable_FBLeavePassageApprovalValidation() {
        var ValidationMsg = '';
        var ParentTable = $('#dTable_FBLeavePassage');
        var Index = 1;
        ParentTable.find(".destination").each(function () {
            var DestID = this.id;
            ValidationMsg += SubTypeApprovalValidation(DestID, Index);
            Index++;
        });

        if (ValidationMsg != null && ValidationMsg != '') {
            return ValidationMsg;
        }
        else {
            return '';
        }
    }

    function SubTypeApprovalValidation(DestID, Index) {
        var ValidationMsg = '';
        var CurrDest = $('#' + DestID);

        CurrDest.find(".table").each(function () {
            var TableID = this.id;
            ValidationMsg += SubSubtypeApprovalValidation(DestID, TableID, Index);
        });

        if (ValidationMsg != null && ValidationMsg != '') {
            return ValidationMsg;
        }
        else {
            return '';
        }

    }

    function SubSubtypeApprovalValidation(DestID, TableID, Index) {
        var ValidationMsg = '';
        var CurrDest = '#' + DestID;
        var CurrTable = '#' + TableID;
        var searchName = CurrDest + " " + CurrTable;
        var Obj = $(searchName);

        if (TableID.indexOf("Transport") > -1) {
            Obj.find(".Amount").each(function () {
                var $row = $(this).closest("tr");
                var ApprovedAmount = $row.find(".ApprovedAmount").val();
                if (ApprovedAmount == null || ApprovedAmount == '') {
                    ValidationMsg += '- Approved Amount (Transportation :Leave Passage' + Index + ') is required.\n'
                }

            });
        }
        if (TableID.indexOf("Accommodation") > -1) {
            Obj.find(".Amount").each(function () {
                var $row = $(this).closest("tr");
                var ApprovedAmount = $row.find(".ApprovedAmount").val();
                if (ApprovedAmount == null ||ApprovedAmount == '') {
                    ValidationMsg += '- Approved Amount (Accommodation :Leave Passage' + Index + ') is required.\n'
                }
            });
        }
        if (TableID.indexOf("Miscellaneous") > -1) {
            Obj.find(".Amount").each(function () {
                var $row = $(this).closest("tr");
                var ApprovedAmount = $row.find(".ApprovedAmount").val();
                if (ApprovedAmount == null || ApprovedAmount == '') {
                    ValidationMsg += '- Approved Amount (Miscellaneous :Leave Passage' + Index + ') is required.\n'
                }

            });
        }

        if (ValidationMsg != null && ValidationMsg != '') {
            return ValidationMsg;
        }
        else {
            return '';
        }
    }

    function LPStartDateOnchange(x,index) {
        var ClassName = '.LPDate_' + index;
        var dateValue = $('#' + x.id).val();
        $(ClassName).datepicker('setStartDate', dateValue);
    }

    function LPEndDateOnchange(x,index) {

        var ClassName = '.LPDate_' + index;
        var dateValue = $('#' + x.id).val();
        $(ClassName).datepicker('setEndDate', dateValue);
    }

</script>




