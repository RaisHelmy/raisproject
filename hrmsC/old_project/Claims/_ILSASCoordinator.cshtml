@model TNB_ESS_MVC.Controllers.ClaimsController.ILSASCoorDropDownListModel
@{
    Layout = null;
}
<div class="portlet box blue" >
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Select ILSAS Coordinator
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-group">
                <div class="row">
                    <label class="control-label col-md-4 ">
                        ILSAS Coordinator :
                    </label>
                    <div class="col-md-6 form-control-static">
                        @Html.DropDownListFor(
                        x => x.ILSASCoordinator,
                        Model.CoordinatorList,
                        "Select Coordinator",
                        new { @class = "bs-select form-control", @onchange="RefreshClaim()" }
                        )
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function RefreshClaim() {
        $('form').submit();
    }
</script>
 
