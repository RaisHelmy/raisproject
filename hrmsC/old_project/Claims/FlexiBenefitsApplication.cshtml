@model ESS.Claim.ViewModels.FlexiBenefitsVM
@using ESS.Core
@{
    ViewBag.Title = "FlexiBenefitApplication";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool IsTopMgmt = ESS.Claim.FlexiBenefits.IsTopMgmt(Common.GetEmployeeID());
    bool IsPA = SP.IsInGroup("Flexi Benefits - Personal Assistant");//false;//true;//
    bool gotItem = false;

    var EmpID = ESS.Core.Common.GetEmployeeID().ToUpper();
    string dtStrStart = ViewBag.dtStrStart;
    string dtStrEnd = ViewBag.dtStrEnd;

    dtStrStart = String.Format("01/01/{0}", Model.Year);
    dtStrEnd = String.Format("31/12/{0}", Model.Year);
}

<style type="text/css">
    .hidden_1 {
        display: none;
    }
</style>

@*@using (Html.BeginForm("FlexiBenefitsApplication", "Claims", FormMethod.Post, new { @id = "Form_FB", @onkeypress = "return event.keyCode!=13;" }))*@
@using (Html.BeginForm("FlexiBenefitsApplication", "Claims", FormMethod.Post, new { @id = "Form_FB" }))
{
    <input type="hidden" id="txtRefID" value="@Model.ID" name="ID" />
    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
                    Flexi Benefits Application
                    <span style="padding-left:20px;">
                        <small></small>
                    </span>
                </h1>
            </div>
            @if (!String.IsNullOrEmpty(Model.ID))
            {
                <div class="col-md-12 ">
                    <div class="pull-right">
                        <a href="@ViewBag.FBForm">Print Flexi Benefits Details</a>
                    </div>
                </div>
            }
        </div>
    </div>

    if ((!IsTopMgmt && !IsPA))
    {

        <div class="row">
            <div class="col-md-12">
                <div class="note note-danger">
                    <h4 class="block">
                        Sorry, You are not allow to submit claims.<br />
                        Please contact administrator for assistance.
                    </h4>

                </div>
            </div>
        </div>
    }
    @*else if (Convert.ToDouble(Model.Balance) <= 0)
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="note note-danger">
                        <h4 class="block">
                            Sorry, you are not allowed to submit new claims because maximum claim eligibilty amount has been reached.

                        </h4>

                    </div>
                </div>
            </div>
        }*@

    <!-- Employee Details -->
    @Html.Partial("_EmployeeInfoClaim", Model.Submiter)

    <!-- Claims Details -->
    @Html.Partial("_FlexiBenefitsClaimDetails", Model)

    <!-- Claims Subtype Selection -->
    @Html.Partial("_FlexiBenefitsClaimSubtype", Model.ClaimSubtype)

    <div class="row">
        <div class="col-md-12">
            <!-- Claim Subtype-->
            @foreach (var subtype in Model.ClaimSubtype)
            {
                if (subtype.IsChoosen)
                {
                    gotItem = true;

                    if (subtype.FormInterface == "_FBLeavePassage")
                    {
                        @Html.Action(@subtype.FormInterface, new { input = Model.LeavePassage, parameter = ViewBag.Parameter })
                    }
                    else
                    {
                        @Html.Action(@subtype.FormInterface, new { input = subtype, parameter = ViewBag.Parameter })
                    }

                }
            }

        </div>
    </div>

    @Html.Action("FlexiBenefitsAttachment", "Claims", new { FBAttachment = Model.FBAttachment })

    <!-- SUmmary -->
    if (gotItem)
    {
        @Html.Partial("_FlexiBenefitsSummary", Model)

    }
    if (!string.IsNullOrEmpty(Model.Status))
    {
        @Html.Partial("_AuditLog")
    }

    if ((Model.StatusCode == "4" || Model.StatusCode == "5")
        && EmpID == Model.Submiter.ID.ToString().ToUpper())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i> Submitter Comments
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Comments</label>
                                            <div class="col-md-10 form-control-static">
                                                <textarea class="form-control" id="txtSubComment" rows="5" cols="60" maxlength="1000"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <br />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Disclaimer -->
    <div class="row">
        <div class="col-md-12">
            <input type="checkbox" id="chkDisclaimer"> <b>I declare that all the expenses claimed above are expenses that have incurred as per my eligibility stated in the circular.</b>
        </div>
    </div>

    <br />

    <!-- Buttons -->
    <div class="row">
        <div class="col-md-12">

            @*@if (Convert.ToDouble(Model.Balance) > 0)
                        CR Feb 2018 - To allow employees to submit Flexi Benefits claims even though limit/balance for the year has been exceeded
                {*@
            @if (IsTopMgmt)
            {

                <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="SubmitValidation();" />
                if ((Model.Status == "Draft" || string.IsNullOrEmpty(Model.Status)) && !IsPA)
                {
                    <input type="button" class="btn green" value="Save As Draft" id="btnSave" onclick="SubmitDraft();" />
                    <input type="button" class="btn red" value="Delete" id="btnDelete" onclick="DeleteDraft();" />
                }
            }

            @if (IsPA)
            {
                if (Model.Status == "Draft" || string.IsNullOrEmpty(Model.Status))
                {
                    <input type="button" class="btn green" value="Save As Draft" id="btnSave" onclick="SubmitDraft();" />
                    <input type="button" class="btn red" value="Delete" id="btnDelete" onclick="DeleteDraft();" />
                }
                <a class="btn green" href="@Url.Content("~/Claims/FlexiBenefitsIndex")"> Back</a>
            }



            @*}*@

        </div>
    </div>

    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well">
                        Your application has been successfully processed.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <a class="btn default blue" id="btnOK">
                        <i class="fa fa-check"></i>
                        OK
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmUpdate" tabindex="-1" role="basic" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Submit this Claim?\n\rPress Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue " id="btnSubmitForm" onclick="SubmitForm('Submit'); return false;">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default blue " id="btnSubmitDraft" onclick="SubmitForm('Draft'); return false;">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default blue " id="btnDeleteDraft" onclick="SubmitForm('DeleteDraft'); return false;">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
        </p>
    </div>
}

<script>
    //var Path = '/_layouts/15/tnbess';
    var Path = '@string.Format("{0}://{1}{2}", Request.Url.Scheme, Request.Url.Authority, Url.Content("~"))';
    //var Path = 'http://localhost:49773';

    // Helper function
    function toDate(dateStr) {
        var parts = dateStr.split("/");
        return new Date(parts[2], parts[1] - 1, parts[0]);
    }

    function getParameterByName(name) {
        name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
        var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
        results = regex.exec(location.search);
        return results === null ? "" : decodeURIComponent(results[1].replace(/\+/g, " "));
    }

    function addRow(tb, subtypeindex) {
        var $div = $("#" + tb).find('tr[id^="new_line_details_"]:last');

        var id = +$div[0].id.match(/\d+/g) + 1;
        $div.after($div.clone().attr('id', 'new_line_details_' + id));

        $div = $("#" + tb).find('tr[id^="new_line_details_"]:last');
        $div.find('.subtypeCheckbox').closest('td').html('<input type="checkbox" class="subtypeCheckbox">');
        $div.find('.StartDate').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].StartDate');
        $div.find('.EndDate').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].EndDate');
        $div.find('.Type').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].Type');
        $div.find('.SelfDependant').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].SelfDependant');
        $div.find('.Name').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].Name');
        $div.find('.ClinicName').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].ClinicName');
        $div.find('.ProviderName').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].ProviderName');
        $div.find('.ShopName').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].ShopName');
        $div.find('.ReceiptNo').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].ReceiptNo');
        $div.find('.From').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].From');
        $div.find('.To').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].To');
        $div.find('.Description').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].Description');
        $div.find('.Amount').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].Amount');
        $div.find('.ApprovedAmount').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].ApprovedAmount');
        $div.find('.BrandModel').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].BrandModel');
        $div.find('.ParentsInLaws').attr('name', 'ClaimSubtype[' + subtypeindex + '].SubTypeDetails[' + id + '].ParentsInLaws');

        $div.find('.StartDate').val('');
        $div.find('.EndDate').val('');
        $div.find('.ShopName').val('');
        $div.find('.ProviderName').val('');
        $div.find('.ReceiptNo').val('');
        $div.find('.From').val('');
        $div.find('.To').val('');
        $div.find('.Description').val('');
        $div.find('.ApprovedAmount').val('');
        $div.find('.Amount').val('0.00');

        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        $('.date-picker').datepicker('setStartDate', '@dtStrStart');
        $('.date-picker').datepicker('setEndDate', '@dtStrEnd');

        calculateSum(tb);
        reorderTable(tb);
        RefineSubtypeReadability($('#' + tb), SubtypeReadabilityEnhance_isEditMode);
    };

    function add5Row(tb, subtypeindex) {
        addRow(tb, subtypeindex);
        addRow(tb, subtypeindex);
        addRow(tb, subtypeindex);
        addRow(tb, subtypeindex);
        addRow(tb, subtypeindex);
    }

    function DeleteRow(tb) {
        var thisTable = $('#' + tb);
        var ch = thisTable.find('tbody input[type=checkbox]');
        var sel = false;
        var c = confirm('Confirm delete?');
        if (c) {
            ch.each(function () {
                var $this = $(this);
                if ($this.is(':checked')) {
                    sel = true;	//set to true if there is/are selected row

                    if ($(this).closest('tr').is('tr:only-child')) {
                        alert('Minimum line of record is required. Please uncheck the subtype selection to remove.');


                    } else {
                        $(this).closest("tr.new_line").remove();
                        calculateSum(tb);
                    }


                }
            });
            if (!sel) alert('No data selected');
        }

        reorderTable(tb);
    }

    function reorderTable(tableName) {
        var int = 0;
        var name = '';

        $.each($('#' + tableName + ' tbody tr'), function (i, val) {

            $.each($(this).find('td [name]'), function (i, val) {
                var name = $(this).attr('name');
                $(this).attr('name', reorder(int, name));
                // var column =  $(this).find('[name]').attr('name').split('.');
            });
            int++;

        });
    }

    function reorder(currentIndex, name) {
        if (typeof name === "undefined") { } else {
            var ColumnNaw = name.split('.');
            var replaceIndex = ColumnNaw[1].match(/\d+/g);
            ColumnNaw[1] = ColumnNaw[1].replace(replaceIndex, currentIndex);
            return ColumnNaw.join('.');
        }
    }

    function GetAuditLog(_RequestID) {
        jQuery.support.cors = true;

        $.ajax({
            url: Path + '/api/FlexiBenefitsWebApi/GetAuditLog?id=' + _RequestID,
            type: 'GET',
            contentType: "application/json;charset=utf-8",
            success: function (result) {
                if (result != null) {

                    SetAuditLog(result);
                }
                else
                    console.log('failed!');
            },
            error: function (x, y, z) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

    function SetAuditLog(result) {
        var _AuditTrailBody = '';

        for (var i = 0; i < result.length; i++) {
            var _AuditTrail = "<tr><td>" + result[i].EmployeeName + "</td><td>" +
                result[i].FormattedDate + "</td><td>" + result[i].ActivityName + "</td><td>" +
                result[i].ActivityAction + "</td><td>" + result[i].Comment + "</td></tr>";
            _AuditTrailBody += _AuditTrail;
        }

        $('#tblAuditLog').find('tbody').html(_AuditTrailBody);
    }

    // Page Load
    function FormConfiguration() {

    }

    function PostBack() {
        $("#btnNext").click();
    }

    //Ajax
    function SubmitValidation() {
        var _chkDisclaimer = document.getElementById("chkDisclaimer").checked;
        var _totalSum = document.getElementById('TotalSummaryInput').value;
        var _Balance = document.getElementById('Balance').value;
        var ValidationMsg = '';

        var ischeck = false;
        $.each($('.SubtypeCheckBox'), function () {
            ischeck = document.getElementById(this.id).checked;
            if (ischeck) {
                return false;
            }
        });

        if (!ischeck) {
            ValidationMsg += '- Subtype is required.\n'
        }

        if (!_chkDisclaimer) {
            ValidationMsg += '- Disclaimer is required.\n'
        }

        $('.subtypeportlet').each(function () {
            var tablename = this.id;

            var Error = eval(tablename + "Validation()");
            if (Error != '') {
                ValidationMsg = ValidationMsg + Error;
            }
        });

        // CR Feb 2018 - To allow employees to submit Flexi Benefits claims even though limit/balance for the year has been exceeded
        //if ((parseFloat(_totalSum) || 0) > (parseFloat(_Balance) || 0)) {
        //    ValidationMsg += '- The Total Amount has exceeded the maximum value.Please edit or delete the record to proceed.\n'
        //}

        // Consolidate Message
        if (ValidationMsg != null && ValidationMsg != '') {
            alert(ValidationMsg);
        }
        else {

            $("#btnSubmitForm").removeClass("hidden_1");
            $("#btnSubmitDraft").addClass("hidden_1");
            $("#btnDeleteDraft").addClass("hidden_1");
            $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will submit this application for Approval. If you want to make changes, click Close.');
            $("#SuccessSubmit .modal-body .well").html('Your application has been successfully submitted.Status: Pending');
            $("#ConfirmUpdate").modal('show');
        }
    }

    function SubmitDraft() {

        $("#btnSubmitDraft").removeClass("hidden_1");
        $("#btnSubmitForm").addClass("hidden_1");
        $("#btnDeleteDraft").addClass("hidden_1");
        $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will save this application as draft. If you want to make changes, click Close.');
        $("#SuccessSubmit .modal-body .well").html('Your application has been successfully saved as draft.');
        $("#ConfirmUpdate").modal('show');

    }

    function DeleteDraft() {

        $("#btnDeleteDraft").removeClass("hidden_1");
        $("#btnSubmitDraft").addClass("hidden_1");
        $("#btnSubmitForm").addClass("hidden_1");
        $("#ConfirmUpdate .modal-body .well").html('Clicking Confirm will delete this draft. If you want to make changes, click Close.');
        $("#SuccessSubmit .modal-body .well").html('Your draft has been successfully deleted.');
        $("#ConfirmUpdate").modal('show');

    }

    function SubmitForm(SubmitType) {
        $("#divLoading").show();
        var data = $('form').serializeArray();
        //Add in additional data to the original form data:

        RequestID = getParameterByName('RequestID');
        if (RequestID == "") {
            RequestID = document.getElementById('txtRefID').value;
        }

        data.push(
          { name: 'SubmitType', value: SubmitType },
          { name: 'RequestID', value: RequestID }
        );

        //support submitter comment
        var SubComment = $('#txtSubComment').val();
        if ($('#txtSubComment').length) {
            data.push({ name: 'SubmitterComment', value: SubComment });
        }

        $.ajax({
            url: '@Url.Content("~/Claims/SubmitFBClaim")',
            type: 'POST',
            data: data,
            success: function (result) {

                $("#ConfirmUpdate").modal('toggle');
                $("#divLoading").hide();

                if (result.Success == true) {
                    $('#SuccessSubmit').modal();
                    $('#btnOK').attr('href', '../Claims/FlexiBenefitsHistory');
                } else {
                    alert(result.ErrorMsg);

                }
                // ... Process the result ...
            }
        });

    }

    jQuery(document).ready(function () {

        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        $('.date-picker').datepicker('setStartDate', '@dtStrStart');
        $('.date-picker').datepicker('setEndDate', '@dtStrEnd');

        FormConfiguration();

        $('.SubtypeTable').dataTable(
        {
            "bLengthChange": false,
            "bFilter": false,
            "bPaginate": false,
            "bInfo": false,
            "bSort": false,
        });

        if ('@Model.Status' != '') {
            GetAuditLog('@Model.ID');
        }


    });

    $(window).load(function () {
        $.uniform.restore(".subtypeCheckbox");
        LPDateInit();
    });

    function LPDateInit() {
        var ParentTable = $('#dTable_FBLeavePassage');
        var index = 0;

        if (ParentTable != undefined) {
            ParentTable.find(".destination").each(function () {
                var ClassName = '.LPDate_' + index;
                var SdateValue = $('#LPStartDate_' + index).val();
                var EdateValue = $('#LPEndDate_' + index).val();

                $(ClassName).datepicker('setStartDate', SdateValue);
                $(ClassName).datepicker('setEndDate', EdateValue);

                index++;
            });
        }

    }

</script>

@Html.Partial("__FBClaimCommonScript")
@Html.Partial("__ClaimCommonScript")