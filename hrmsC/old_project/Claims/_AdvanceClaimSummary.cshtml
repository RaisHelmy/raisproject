@model ESS.AdvanceClaim.Models.AdvanceClaim
<style>
    .center {
        text-align:center;
    }
</style>

<div class="portlet box blue subtypeportlet" id="dTable_Bus">
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Summary
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4">Requested Amount:</label>
                                <div class="col-md-8 form-control-static">
                                    @Html.TextBoxFor(x => x.RequestedAmount, new { @class = "form-control text-right",@readonly = "readonly"})
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="control-label col-md-4"></label>
                                <div class="col-md-8 form-control-static">
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Verified Amount:</label>
                            <div class="col-md-8 form-control-static">
                                @Html.TextBoxFor(x => x.VerifiedAmount, new { @class = "form-control text-right", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4"></label>
                            <div class="col-md-8 form-control-static">
                                @*@Html.DisplayFor(x => x.Status)*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                @if (string.IsNullOrEmpty(@Model.PaymentMethod))
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Payment Amount:</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control text-right" id="PaymentAmount" name="PaymentAmount" readonly="readonly" type="text" value="">

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4"></label>
                                    <div class="col-md-8 form-control-static">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Payment Method:</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control text-right" id="PaymentMethod" name="PaymentMethod" readonly="readonly" type="text" value="">

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4"></label>
                                    <div class="col-md-8 form-control-static">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Payment Date:</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control text-right" id="PaymentDate" name="PaymentDate" readonly="readonly" type="text" value="">
                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4"></label>
                                    <div class="col-md-8 form-control-static">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Payment Amount:</label>
                                    <div class="col-md-8 form-control-static">
                                        @Html.TextBoxFor(x => x.PaymentAmount, new { @class = "form-control text-right", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4"></label>
                                    <div class="col-md-8 form-control-static">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Payment Method:</label>
                                    <div class="col-md-8 form-control-static">
                                        @Html.TextBoxFor(x => x.PaymentMethod, new { @class = "form-control text-right", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4"></label>
                                    <div class="col-md-8 form-control-static">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Payment Date:</label>
                                    <div class="col-md-8 form-control-static">
                               
                                        @Html.TextBoxFor(x => x.PaymentDate, new { @class = "form-control text-right", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4"></label>
                                    <div class="col-md-8 form-control-static">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
        </div>
    </div>
</div>

