@model List<ESS.Claim.ViewModels.FBEntitlementConfig>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My Flexi Benefits History
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th width="33.3%">Year</th>
                                <th width="33.3%">PayScale Group</th>
                                <th width="33.3%">Entitlement</th>
                                
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>@item.Year</td>
                                    <td>@item.PayScaleGroup</td>
                                    <td class="text-right">@String.Format("{0:0.00}", (String.IsNullOrEmpty(item.Entitlement) ? 0.00 : Convert.ToDouble(item.Entitlement)))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>