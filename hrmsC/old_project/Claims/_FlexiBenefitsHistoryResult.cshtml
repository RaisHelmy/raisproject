@model List<ESS.Claim.ViewModels.FlexiBenefitsHistory>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My Flexi Benefits History
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Year</th>
                                <th>Components</th>
                                <th>Amount (RM)</th>
                                <th>Approve Amount (RM)</th>
                                <th>Status</th>
                                <th>Created Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    @if (@item.ClaimStatusName == "Draft" || item.ClaimStatusName == "Withdrawn" || 
                                          item.ClaimStatusName == "Declined" || item.ClaimStatusName == "Returned")
                                    {
                                        <td>
                                            <a class="btn blue btn-sm" href="@Url.Content("~/Claims/FlexiBenefitsApplication")?RequestID=@item.ID">
                                                <i class="fa fa-search"></i>
                                            </a>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <a class="btn blue btn-sm" href="@Url.Content("~/Claims/FlexiBenefitsViewForm")?RequestID=@item.ID">
                                                <i class="fa fa-search"></i>
                                            </a>
                                        </td>
                                    }
                                   
                                    <td>@item.RequestNo</td>
                                    <td>@item.EmployeeCode - @item.EmployeeName</td>
                                    <td>@item.Year</td>
                                    <td>@item.Components</td>
                                    <td>@item.TotalAmount</td>
                                    @if (!string.IsNullOrEmpty(item.TotalApproveAmount))
                                    {
                                        <td>@item.TotalApproveAmount</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }

                                    @if (@item.ClaimStatusName == "Returned" || @item.ClaimStatusName == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.ClaimStatusName</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.ClaimStatusName</b></td>
                                    }

                                    @if (@item.CreatedDate.HasValue)
                                    {
                                        <td>@item.CreatedDate.Value.ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>