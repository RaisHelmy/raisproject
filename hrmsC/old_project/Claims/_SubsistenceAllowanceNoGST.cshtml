                                <th scope="col" width="5%"></th>
                                <th scope="col">Charge Code *</th>
                                <th scope="col">No. Of Days</th>
                                <th scope="col">Additional Hour</th>
                                <th scope="col">24 Hour Rate</th>
                                <th scope="col">Additional Hour Rate</th>
                                <th scope="col">Subtotal (RM)</th>
                                <th scope="col">B/fast Provided (Qty.)</th>
                                <th scope="col">Subtotal B/fast (RM)</th>
                                <th scope="col">Lunch Provided (Qty.)</th>
                                <th scope="col">Subtotal Lunch (RM)</th>
                                <th scope="col">Dinner Provided (Qty.)</th>
                                <th scope="col">Subtotal Dinner (RM)</th>
                                <th scope="col">Total Meals (RM)</th>
                                <th scope="col">Total Subsistence (RM)</th>
                                <th scope="col">Claimable Amount (RM)</th>
                                <th scope="col">Tax Amount (RM)</th>
                                <th scope="col">Total Amount (RM)</th>
                            </tr>
                        </thead>
