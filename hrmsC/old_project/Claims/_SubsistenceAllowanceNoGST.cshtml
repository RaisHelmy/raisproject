                        <div class="row">
                            <div class="col-md-12">
                                @*<div class="btn-group">
                                    <a class="BtnPlus btn green" title="dTable_@(DataTableID)" href="javascript:@(DataTableID)_addRow();;@(DataTableID)_duplicateColumnValueToAllRows();@(DataTableID)_CalculateSubtotal();">
