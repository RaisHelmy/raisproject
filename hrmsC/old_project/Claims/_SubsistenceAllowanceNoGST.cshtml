</div>
<script type="text/javascript">
    var _@(DataTableID)Table = $('#tbl@(DataTableID)').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });

    var @(DataTableID)_ExtraHourRates = @Html.Raw(Json.Encode(extraHoursRate));

    function dTable_@(DataTableID)Validation() {
        var _ValidationMsg = '';

        var thisTable = $('#tbl@(DataTableID)');

        var FormStartDate = $("#StartDate").val();
        var FormStartTime = $("#StartTime").val();
        var FormEndDate = $("#EndDate").val();
        var FormEndTime = $("#EndTime").val();

        var FormStartDateTime = moment(FormStartDate + " " + FormStartTime, "DD/MM/YYYY hh:mm");
        var FormEndDateTime = moment(FormEndDate + " " + FormEndTime, "DD/MM/YYYY hh:mm");
        var Duration = moment.duration(FormEndDateTime.diff(FormStartDateTime));
        var Days = Duration.days();
        var Hours = (Duration.asHours() % 24).toFixed(2);

        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");

            var _ChargeCode = $row.find(".SubTypeColumn0").val();
            var _BFastProvided = parseInt($row.find(".SubTypeColumn6").val()) || 0;
            var _LunchProvided = parseInt($row.find(".SubTypeColumn8").val()) || 0;
            var _DinnerProvided = parseInt($row.find(".SubTypeColumn10").val()) || 0;
            var _NoOfMeals = parseInt('@NoOfMeals') || 0;

            if (_ChargeCode == null || _ChargeCode == '') {
                _ValidationMsg += '- @ClaimsSubtypeName (Charge Code) is required.\n';
            }

            if (_LunchProvided > _NoOfMeals) {
                _ValidationMsg += '- @ClaimsSubtypeName B/fast Provided (Qty.) must not be more than ' + @NoOfMeals + '.\n';
            }

            if (_BFastProvided > _NoOfMeals) {
                _ValidationMsg += '- @ClaimsSubtypeName Lunch Provided (Qty.) must not be more than ' + @NoOfMeals + '.\n';
            }

            if (_DinnerProvided > _NoOfMeals) {
                _ValidationMsg += '- @ClaimsSubtypeName Dinner Provided (Qty.) must not be more than ' + @NoOfMeals + '.\n';
            }
        });

        var GrandClaimableAmount = $('.GrandClaimableAmount').val();
        var TotalSubsistence = $('.SubTypeColumn13').val();

        if (GrandClaimableAmount != TotalSubsistence) {
            _ValidationMsg = '- @ClaimsSubtypeName Total Claimable Amount must be equal to Total Subsistence.\n';
        }

        return _ValidationMsg;
    }

    function @(DataTableID)_removeRow() {
        $.each($('input[class="SubsidiesOutstationRemoveCheckbox"]:checked'), function (i, val) {
            var currLength = $('#tbl@(DataTableID) tr').length - 2;
            var row = $(this).closest("tr").get(0);
            if (currLength > 1) {
                _@(DataTableID)Table.fnDeleteRow(mytable.fnGetPosition(row));
            }
        });

        reorderTable('#tbl@(DataTableID)');
        @(DataTableID)_CalculateSubtotal();
    }

    function @(DataTableID)_add5Row() {
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
        @(DataTableID)_addRow();
    }

    function @(DataTableID)_addRow() {
        _@(DataTableID)Table.fnAddData([
           '<input type="checkbox" class="SubsidiesOutstationRemoveCheckbox" /></td>',
           '<input type="hidden" class="hfChargeCode" /><input type="hidden" class="form-control Location"  name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Location" value="Overseas" /><select class="form-control ddlChargeCode SubTypeColumn0" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn0" onchange="ChargeCodeChange(this); CalculateChargeCodeSummary();"><option value="">Select One</option></select>',
            '<input type="text" class="form-control text-right SubTypeColumn1" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn1" />',
            '<input type="text" class="form-control text-right SubTypeColumn2" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn2" />',
            '<input type="text" class="form-control text-right SubTypeColumn3" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn3" />',
            '<input type="text" class="form-control text-right SubTypeColumn4" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn4" />',
            '<input type="text" class="form-control text-right SubTypeColumn5" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn5" />',
            '<input type="text" class="form-control text-right SubTypeColumn6" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn6" />',
            '<input type="text" class="form-control text-right SubTypeColumn7" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn7" />',
            '<input type="text" class="form-control text-right SubTypeColumn8" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn8" />',
            '<input type="text" class="form-control text-right SubTypeColumn9" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn9" />',
            '<input type="text" class="form-control text-right SubTypeColumn10" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn10" />',
            '<input type="text" class="form-control text-right SubTypeColumn11" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn11" />',
            '<input type="text" class="form-control text-right SubTypeColumn12" readonly name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn12" />',
            '<input type="text" class="form-control text-right SubTypeColumn13" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].SubTypeColumn13" readonly />',
            '<input type="text" class="form-control text-right Amount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].Amount" onblur="@(DataTableID)CalculationClaimableAmount(this);" value="0.00" />',
            '<input type="text" class="form-control text-right GSTAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].GSTAmount" readonly />',
            '<input type="text" class="form-control text-right TotalAmount" name="ClaimsSubtypeCategory[@Model.categoryIndex].ClaimSubtype[@Model.subtypeIndex].SubTypeDetails[' + _@(DataTableID)Table.fnSettings().fnRecordsTotal() + '].TotalAmount" readonly />'
        ]);

        @(DataTableID)_Initialize();
    }

    function @(DataTableID)_Initialize() {
        if ('@GSTEnabled' == 'false') {
            $('#tbl@(DataTableID) tbody tr').each(function () {
                var _NoOfDays = $(this).find('.SubTypeColumn1');
                var _NoOfExtraHour = $(this).find('.SubTypeColumn2');
                var _TwentyFourHourRate = $(this).find('.SubTypeColumn3');
                var _ExtraHourRate = $(this).find('.SubTypeColumn4');
                var _Subtotal = $(this).find('.SubTypeColumn5');
                var _SubtotalSubsistence = $(this).find('.SubTypeColumn13');
                var _ClaimableAmount = $(this).find('.Amount');
                var _GSTAmount = $(this).find('.GSTAmount');
                var _TotalAmount = $(this).find('.TotalAmount'); 

                var FlightExtraHourStdTime = '1300';
                var FlightReturnTime = @(DataTableID)_GetFlightDepartureTime();
                var extraTimeTotal = -1;
                var flightDays = 0;
                var SubTotalCalculated = 0;
                flightDays = @(DataTableID)_GetFlightDetailsDays();
                extraTimeTotal = (FlightReturnTime - FlightExtraHourStdTime) / 100;

                  @(DataTableID)_GetFlightDatetime($(this).find('.StartDate'), $(this).find('.StartTime'), $(this).find('.EndDate'), $(this).find('.EndTime'));
                //if (FlightReturnTime >= FlightExtraHourStdTime) {
                //    extraTimeTotal = (FlightReturnTime - FlightExtraHourStdTime) / 100;
                //    _NoOfExtraHour.val('Yes');
                //}
                //else {
                //    _NoOfExtraHour.val('No');
                //}

                _NoOfDays.val(flightDays);
                _TwentyFourHourRate.val('@TwentyFourHourRate');

                var extraHrRate = @(DataTableID)_CalculateExtraHourRate($(this), extraTimeTotal, flightDays);

                if (extraHrRate > 0) {
                    _NoOfExtraHour.val('Yes');
                }
                else {
                    _NoOfExtraHour.val('No');
                }

                SubTotalCalculated = (_TwentyFourHourRate.val() * _NoOfDays.val()) + (_TwentyFourHourRate.val() * extraHrRate / 100);
                if (SubTotalCalculated > 0)
                {

                }
                else
                {
                    SubTotalCalculated = 0;
                }

                var _TotalMeal = $(this).find('.SubTypeColumn12').val();
                var _TotalClaimable = _ClaimableAmount.val();

                _Subtotal.val(parseFloat(SubTotalCalculated).toFixed(2));
                _SubtotalSubsistence.val((_Subtotal.val() - _TotalMeal).toFixed(2));
                _ClaimableAmount.val(_SubtotalSubsistence.val());

                if (!@(DataTableID)_CheckClaimableAmountAgainstSubsistenceAmount(_TotalClaimable)) {
                    _ClaimableAmount.val('0.00');
                    _TotalAmount.val('0.00');
                }

                _GSTAmount.prop('readonly', true);
                _GSTAmount.val('0.00');

                @(DataTableID)Calculation(this);
            });
        }

        $(".SubsidiesOutstationRemoveCheckbox").uniform();
        BindtoDDL();
        CalculateSummary();

    }

    function @(DataTableID)GetDDLListInputValues() {
        $('#tbl@(DataTableID) tbody tr').each(function () {
            var _CCSelect = $(this).children('td:eq(1)').children('select');
            var _CCHidden = $(this).children('td:eq(1)').children('input[type=hidden]');
            _CCSelect.val(_CCHidden.val());
        });
    }

    function @(DataTableID)Calculation(x) {
        var $row = $(x).closest("tr");

        var _ClaimableAmount = parseFloat($row.find(".Amount").val()) || 0;
        var _SubtotalBeforeMeal = parseFloat($row.find(".SubTypeColumn5").val()) || 0;
        var _BFastProvided = parseInt($row.find(".SubTypeColumn6").val()) || 0;
        var _LunchProvided = parseInt($row.find(".SubTypeColumn8").val()) || 0;
        var _DinnerProvided = parseInt($row.find(".SubTypeColumn10").val()) || 0;
        var _TwentyFourHourRate = parseFloat('@TwentyFourHourRate') || 0;
        var _BFastRate = parseFloat('@dblBreakfastRate') || 0;
        var _LunchRate = parseFloat('@dblLunchRate') || 0;
        var _DinnerRate = parseFloat('@dblDinnerRate') || 0;

        var totalBfast = _BFastProvided * _TwentyFourHourRate * _BFastRate;
        var totalLunch = _LunchProvided * _TwentyFourHourRate * _LunchRate;
        var totalDinner = _DinnerProvided * _TwentyFourHourRate * _DinnerRate;
        var totalMeal = totalBfast + totalLunch + totalDinner;

        $row.find(".SubTypeColumn7").val(totalBfast.toFixed(2));
        $row.find(".SubTypeColumn9").val(totalLunch.toFixed(2));
        $row.find(".SubTypeColumn11").val(totalDinner.toFixed(2));
        $row.find(".SubTypeColumn12").val(totalMeal.toFixed(2));

        //var _Subtotal = (parseFloat('@WorkSubtotal') || 0) - totalMeal;
        var _Subtotal = _SubtotalBeforeMeal - totalMeal;
        if (_Subtotal >= 0) {
        }
        else {
            _Subtotal = 0;
        }
        //alert(parseFloat('@WorkSubtotal'));
        //alert(totalMeal

        if (_ClaimableAmount > _Subtotal) {
            _ClaimableAmount = _Subtotal;
        }

        $row.find(".SubTypeColumn13").val(_Subtotal.toFixed(2));
        $row.find(".Amount").val(_Subtotal.toFixed(2));

        var gstAmt = 0;
        if ('@GSTEnabled' != 'false') {
            var gstMaxValue = '@GSTMaxValue';
            gstAmt = parseFloat(_Subtotal) * (parseFloat(gstMaxValue) / 100);
        }
        $row.find(".GSTAmount").val(gstAmt.toFixed(2));

        var TotalAmount = 0;
        TotalAmount = parseFloat(_Subtotal) + (parseFloat(gstAmt));
        $row.find(".TotalAmount").val(TotalAmount.toFixed(2));

        @(DataTableID)_CalculateSubtotal();

        if ('@Model.ClaimsSubtypeName'.indexOf("SST") > 1) {
            if (typeof SST_SubsistenceAmountCalculation != "undefined")
                SST_SubsistenceAmountCalculation(_Subtotal);
        }
        else {
            if (typeof GST_SubsistenceAmountCalculation != "undefined")
                GST_SubsistenceAmountCalculation(_Subtotal)
        }
    }

    function @(DataTableID)CalculationClaimableAmount(x) {
        var $row = $(x).closest("tr");
        var _ClaimableAmount = parseFloat($row.find(".Amount").val()) || 0;
        $row.find(".Amount").val(_ClaimableAmount.toFixed(2));
        $row.find(".TotalAmount").val(_ClaimableAmount.toFixed(2));

        if (!@(DataTableID)_CheckClaimableAmountAgainstSubsistenceAmount(_ClaimableAmount)) {
            $row.find(".Amount").val('0.00');
            $row.find(".TotalAmount").val('0.00');
        }

        @(DataTableID)_CalculateSubtotal();

    }

    function @(DataTableID)_CalculateSubtotal() {
        var grandAmount = 0;
        var grandClaimableAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;

        var thisTable = $('#tbl@(DataTableID)');

        thisTable.find(".SubTypeColumn13").each(function () {
            var $row = $(this).closest("tr");
            var _ClaimableAmount = $row.find(".Amount").val();
            var _Amount = $row.find(".SubTypeColumn13").val();
            var _GSTAmount = $row.find(".GSTAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                //grandAmount = (grandAmount + (_Amount * 1));
                grandAmount = _Amount * 1;
                grandClaimableAmount = (grandClaimableAmount + (_ClaimableAmount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandAmount + grandGST;
            }
        });

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandClaimableAmount").val(grandClaimableAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        //thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandClaimableAmount.toFixed(2));

        //Check if claim amount is bigger than subsistence amount
        @(DataTableID)_ValidateClaimableAmount();
        CalculateSummary();
    }

    function @(DataTableID)_CheckClaimableAmountAgainstSubsistenceAmount(currentClaimAmount) {

        var grandAmount = 0;
        var grandClaimableAmount = 0;
        var grandGST = 0;
        var grandTotal = 0;

        var thisTable = $('#tbl@(DataTableID)');

        thisTable.find(".SubTypeColumn13").each(function () {
            var $row = $(this).closest("tr");
            var _ClaimableAmount = $row.find(".Amount").val();
            var _Amount = $row.find(".SubTypeColumn13").val();
            var _GSTAmount = $row.find(".GSTAmount").val();

            if (!isNaN(_Amount) && _Amount.length != 0) {
                grandAmount = _Amount * 1;
                grandClaimableAmount = (grandClaimableAmount + (_ClaimableAmount * 1));
                grandGST = (grandGST + (_GSTAmount * 1));
                grandTotal = grandAmount + grandGST;
            }
        });

        if (grandClaimableAmount > grandAmount) {
            grandClaimableAmount = grandClaimableAmount - currentClaimAmount;

            thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
            thisTable.find(".GrandClaimableAmount").val(grandClaimableAmount.toFixed(2));
            thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
            thisTable.find(".GrandTotalAmount").val(grandClaimableAmount.toFixed(2));

            return false;
        }

        thisTable.find(".GrandAmount").val(grandAmount.toFixed(2));
        thisTable.find(".GrandClaimableAmount").val(grandClaimableAmount.toFixed(2));
        thisTable.find(".GrandGSTAmount").val(grandGST.toFixed(2));
        //thisTable.find(".GrandTotalAmount").val(grandTotal.toFixed(2));
        thisTable.find(".GrandTotalAmount").val(grandClaimableAmount.toFixed(2));

        return true;
    }

    function @(DataTableID)_duplicateColumnValueToAllRows() {

        var _ClaimableAmount = -1;
        var _BFastProvided = -1;
        var _BFastProvidedSubtotal = -1;
        var _LunchProvided = -1;
        var _LunchProvidedSubtotal = -1;
        var _DinnerProvided = -1;
        var _DinnerProvidedSubtotal = -1;
        var _TotalMeal = -1;
        var _TotalSubsistence = -1;
        var _TotalAmount = -1;

        var thisTable = $('#tbl@(DataTableID)');

        thisTable.find(".Amount").each(function () {
            var $row = $(this).closest("tr");

            //if (_ClaimableAmount > -1) $row.find(".SubTypeColumn13").val(parseFloat(_ClaimableAmount).toFixed(2));
            //else _ClaimableAmount = $row.find(".SubTypeColumn13").val();

            if (_BFastProvided > -1) $row.find(".SubTypeColumn6").val(parseInt(_BFastProvided));
            else _BFastProvided = $row.find(".SubTypeColumn6").val();

            if (_BFastProvidedSubtotal > -1) $row.find(".SubTypeColumn7").val(parseFloat(_BFastProvidedSubtotal).toFixed(2));
            else _BFastProvidedSubtotal = $row.find(".SubTypeColumn7").val();

            if (_LunchProvided > -1) $row.find(".SubTypeColumn8").val(parseInt(_LunchProvided));
            else _LunchProvided = $row.find(".SubTypeColumn8").val();

            if (_LunchProvidedSubtotal > -1) $row.find(".SubTypeColumn9").val(parseFloat(_LunchProvidedSubtotal).toFixed(2));
            else _LunchProvidedSubtotal = $row.find(".SubTypeColumn9").val();

            if (_DinnerProvided > -1) $row.find(".SubTypeColumn10").val(parseInt(_DinnerProvided));
            else _DinnerProvided = $row.find(".SubTypeColumn10").val();

            if (_DinnerProvidedSubtotal > -1) $row.find(".SubTypeColumn11").val(parseFloat(_DinnerProvidedSubtotal).toFixed(2));
            else _DinnerProvidedSubtotal = $row.find(".SubTypeColumn11").val();

            if (_TotalMeal > -1) $row.find(".SubTypeColumn12").val(parseFloat(_TotalMeal).toFixed(2));
            else _TotalMeal = $row.find(".SubTypeColumn12").val();

            if (_TotalSubsistence > -1) $row.find(".SubTypeColumn13").val(parseFloat(_TotalSubsistence).toFixed(2));
            else _TotalSubsistence = $row.find(".SubTypeColumn13").val();

            //if (_TotalAmount > -1) $row.find(".TotalAmount").val(parseFloat(_TotalAmount).toFixed(2));
            //else _TotalAmount = $row.find(".TotalAmount").val();

        });

        @(DataTableID)_CalculateSubtotal();

    }

    function @(DataTableID)_ValidateClaimableAmount() {
        var _TotalClaimableAmount = 0;
        var _TotalSubsistenceAmount = 0;

        var thisTable = $('#tbl@(DataTableID)');
        _TotalSubsistenceAmount = thisTable.find(".GrandAmount").val();
        _TotalClaimableAmount = thisTable.find(".GrandClaimableAmount").val();

        if (parseFloat(_TotalClaimableAmount) > parseFloat(_TotalSubsistenceAmount)) {

            thisTable.find(".SubTypeColumn13").each(function () {
                var $row = $(this).closest("tr");
                $row.find(".Amount").val(parseFloat(0).toFixed(2));
                $row.find(".TotalAmount").val(parseFloat(0).toFixed(2));
            });

            thisTable.find(".GrandClaimableAmount").val(parseFloat(0).toFixed(2));
            thisTable.find(".GrandTotalAmount").val(parseFloat(0).toFixed(2));
        }
    }

    function @(DataTableID)_CalculateExtraHourRate(x, theExtraHour, flightTotalDays) {

        //var returnResult = 0;
        var $row = $(x).closest("tr");
        var _ExtraHourRate = $row.children('td:eq(5)').children('input[type=text]');
        var ehRate = 0;

        if (theExtraHour < 0) {
            ehRate = @(DataTableID)_ExtraHourRates[Object.keys(@(DataTableID)_ExtraHourRates).filter(function (x) { return x.indexOf('before 1pm') > 0 })] || 0;
        }
        else if (theExtraHour >= 0 && theExtraHour < 5) {
            ehRate = @(DataTableID)_ExtraHourRates[Object.keys(@(DataTableID)_ExtraHourRates).filter(function (x) { return x.indexOf('between 1pm to 6pm') > 0 })] || 0;
        }
        else if (theExtraHour >= 5) {
            ehRate = @(DataTableID)_ExtraHourRates[Object.keys(@(DataTableID)_ExtraHourRates).filter(function (x) { return x.indexOf('6 onwards') > 0 })] || 0;
        }

        _ExtraHourRate.val(ehRate + "%");

        return ehRate;
        @*var form = {
            ExtraHour: theExtraHour,
            PayScaleGroup: '@PayScaleGroup',
            TotalDays: flightTotalDays
        };


        $.ajax({
            type: "POST",
            url: '@Url.Content("~/Claims/_@(DataTableID)_ExtraHourCalculation")',
            cache: false,
            async: false,
            dataType: "json",
            data: form,
            success: function (result) {
                if (result.Success) {
                    returnResult = result['_ExtraHourRate'];
                    _ExtraHourRate.val(returnResult + '%');

                }
                else {
                    alert(result.ErrorMsg);
                }
            },
            error: function (e) {

            }
        });

        return returnResult;*@
    }

    function @(DataTableID)_GetFlightDetailsDays()
    {
        var CurDepartureDate = "";
        var DepartureDate = "";
        var CurArrivalDate = "";
        var ArrivalDate = "";
        var CurReturnDepartureTime = "";
        var ReturnDepartureTime = "";

        var thisTable = null;
        if (@(Model.ClaimsSubtypeName.Contains("SST").ToString().ToLower())) {
            flightTable = $("#TableFlightWithoutSST").val();
        }
        else {
            flightTable = $("#TableFlightWithoutGST").val();
        }

        thisTable = $("#tbl" + flightTable)
        thisTable.find(".SubTypeColumn7").each(function () {
            var $row = $(this).closest("tr");
            CurDepartureDate = $row.find(".SubTypeColumn7").val();
            CurArrivalDate = $row.find(".SubTypeColumn9").val();
            ReturnDepartureTime = $row.find(".SubTypeColumn10").val();

            if(DepartureDate == "")
            {
                DepartureDate = CurDepartureDate;
                CurReturnDepartureTime = ReturnDepartureTime
            }
            else
            {
                if (CurDepartureDate < DepartureDate)
                {
                    DepartureDate = CurDepartureDate;
                    ReturnDepartureTime = CurReturnDepartureTime;
                }

            }

            if(ArrivalDate == "")
            {
                ArrivalDate = CurArrivalDate;
            }
            else
            {
                if (CurArrivalDate > ArrivalDate)
                    ArrivalDate = CurArrivalDate;
            }
        });

        var date1 = new Date(DepartureDate.replace(/(\d{2})[-/](\d{2})[-/](\d+)/, "$2/$1/$3"));
        var date2 = new Date(ArrivalDate.replace(/(\d{2})[-/](\d{2})[-/](\d+)/, "$2/$1/$3"));
        var timeDiff = Math.abs(date2.getTime() - date1.getTime());
        var diffDays = Math.ceil(timeDiff / (1000 * 3600 * 24));
 
        return diffDays || 0;

    }


