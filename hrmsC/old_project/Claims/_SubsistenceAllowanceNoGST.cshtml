
@model ESS.Claim.ViewModels.ClaimsSubtype

@{
    Layout = null;
    string ClaimsSubtypeName = ViewBag.SubsistenceAllowanceNoGST_ClaimsSubtypeName;
    string Status = ViewBag.SubsistenceAllowanceNoGST_Status;
    string GSTEnabled = (ViewBag.SubsistenceAllowanceNoGST_GSTEnabled + "").ToLower();
    string GSTMaxValue = ViewBag.SubsistenceAllowanceNoGST_GSTMaxValue;
    string NoOfDays = ViewBag.SubsistenceAllowanceNoGST_NoOfDays;
    string NoOfMeals = ViewBag.SubsistenceAllowanceNoGST_NoOfMeals;
    string NoOfExtraHour = ViewBag.SubsistenceAllowanceNoGST_NoOfExtraHour;
    string TwentyFourHourRate = ViewBag.SubsistenceAllowanceNoGST_TwentyFourHourRate;

    string WorkSubtotal = ViewBag.SubsistenceAllowanceNoGST_WorkSubtotal;
    double dblBreakfastRate = ViewBag.SubsistenceAllowanceNoGST_BreakfastRate;
    double dblLunchRate = ViewBag.SubsistenceAllowanceNoGST_LunchRate;
    double dblDinnerRate = ViewBag.SubsistenceAllowanceNoGST_DinnerRate;
    string PayScaleGroup = ViewBag.SubsistenceAllowanceNoGST_PayScaleGroup;
    Dictionary<string, double> extraHoursRate = ViewBag.SubsistenceAllowanceNoGST_ExtraHourRate;

    string DataTableID = "tbl" + Model.FormInterface + "_" + Model.categoryIndex + "_" + Model.subtypeIndex;
}


<div class="portlet box blue subsistence subtypeportlet" id="dTable_@(DataTableID)">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@Model.ClaimSubTypeCategory - @Model.ClaimsSubtypeName
        </div>
        @if (Status == "Draft" || Status == "Withdrawn" || Status == "Declined" || Status == "Returned")
        {
            <div class="tools">
                <a href="javascript:;" onclick="RemoveSubtype('@Model.categoryIndex','@Model.subtypeIndex')">
                    <img style="vertical-align: initial;" src="../Assets/img/portlet-remove-icon-white.png" />
                </a>
            </div>
        }
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"></a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table class="table table-striped table-bordered table-hover table-full-width" id="tbl@(DataTableID)">
