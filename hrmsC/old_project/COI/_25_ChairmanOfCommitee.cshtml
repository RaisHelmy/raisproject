@model Integrity.ConflictOfInterest.Models.ConflictVM

@{
    /**/
    var detailsOfConflict = Model.DetailsOfConflict;
}

<div class="portlet box blue ChairmanOfCommitee">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Chairman of Committee
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse">
                
            </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-4">Chairman</label>
                            <div class="col-md-8 form-control-static">
                                @Html.Action("_PeoplePickerExt", "PeoplePicker", new { CurrEmpID = Model.EmployeeID, SearchType = "" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#hfEmpID').attr('name', 'Chairman');
        $('#hfEmpID').val('@Model.Chairman');
        $('#txtEmpName').val('@Model.ChairmanName');
    });
</script>
