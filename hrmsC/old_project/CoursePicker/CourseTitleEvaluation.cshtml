@model TNB_ESS_MVC.Controllers.CoursePickerController.CoursePicker

@{
    Layout = null;
}
<div class="row" onkeypress="return event.keyCode!=13;">
    <div class="col-md-12">
        <div class="form-horizontal">
            <div class="form-body">
                <div class="form-group">
                    <label class="control-label col-md-2 ">
                        Start Date
                    </label>
                    <div class="col-md-4 form-control-static">
                        <div class="col-md-12 input-group date date-picker date-picker2" data-date-format="dd/mm/yyyy">
                            <input class="form-control" type="text" id="CPStartDate" value="" />
                            <span class="input-group-btn datepick-btn">
                                <button class="btn default" type="button"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                    <label class="control-label col-md-2 ">
                        End Date
                    </label>
                    <div class="col-md-4 form-control-static">
                        <div class="col-md-12 input-group date date-picker" data-date-format="dd/mm/yyyy">
                            <input class="form-control" type="text" id="CPEndDate" value="" />
                            <span class="input-group-btn datepick-btn">
                                <button class="btn default" type="button"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-2 ">
                        Category
                    </label>
                    <div class="col-md-4 form-control-static">
                        @Html.DropDownList("CPTrainingCategory", new SelectList(Model.Cateogry, "Value", "Text"), "- All -", new { @class = "bs-select form-control", @onchange = "changeType(this)" })
                    </div>
                    <label class="control-label col-md-2 ">
                        Type
                    </label>
                    <div class="col-md-4  form-control-static">
                        @Html.Action("_DDLTrainingType", "Training", new {  })
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-2 ">
                        Course Title
                    </label>
                    <div class="col-md-4 form-control-static">
                        <input class="form-control" type="text" name="_CPCourseTitle" id="_CPCourseTitle" />
                    </div>
                    <label class="control-label col-md-2 ">
                        Division
                    </label>
                    <div class="col-md-4  form-control-static">
                        @Html.DropDownList("CPDivision", new SelectList(Model.Division, "Value", "Text"), new { @class = "bs-select form-control" })
                    </div>
                </div>
                <div class="form-group ">
                    <div class="col-md-12">
                        <div class="text-right" style="margin-top:15px;">
                            <input id="btn-Search" type="button" value="Search" class="btn green btn-Search" onclick="SearchCourse();">
                        </div>
                    </div>
                    
                </div>
            </div>
            <br />
            <div id="CourseTitleResult">

            </div>
            
        </div>
    </div>
</div>

<script>
    jQuery(document).ready(function () {

        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });
    });

    function SearchCourse() {
        var _StartDate = $('#CPStartDate').val();
        var _EndDate = $('#CPEndDate').val();
        var _CategoryCode = $('#CPTrainingCategory').val();
        var _TrainingType = $('#TrainingType').val();
        var _CourseTitle = $('#_CPCourseTitle').val();
        var _Division = $('#CPDivision').val();
        var _Grade = $('#CPCourseGrade').val();


        $("#CourseTitleResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/CoursePicker/_CourseTitleEvaluationResult")',
            cache: false,
            dataType: "html",
            data: { StartDate: _StartDate, EndDate: _EndDate, CategoryCode: _CategoryCode, TrainingType: _TrainingType, CourseTitle: _CourseTitle, Division: _Division},
            success: function (content) {
                $("#CourseTitleResult").html(content);
            },
            error: function (e) {
            }
        });
    }

    function changeType(e) {
        //alert(e.value);

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Training/_DDLTrainingType")',
            cache: false,
            dataType: "html",
            data: { CategoryCode: e.value }, //$("#TrainingCategory").val() },
            success: function (content) {
                $("#TrainingTypeResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>
