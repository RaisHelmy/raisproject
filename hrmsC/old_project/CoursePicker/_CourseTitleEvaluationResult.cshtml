@model List<ESS.Core.CoursePickerList>

@{
    Layout = null;
}

<div class="table-toolbar">
    <table id="tblCoursePicker" class="table table-striped table-bordered table-hover table-full-width">
        <thead>
            <tr>
                <th></th>
                <th>Category</th>
                <th>Type</th>
                <th>Session ID</th>
                <th>Course Title</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Division</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><input type="radio" name="pp" value="@item.CourseID" CourseSessionID="@item.CourseSessionID" CourseTitle="@item.CourseTitle" /></td>
                    <td>@item.Category</td>
                    <td>@item.Type</td>
                    <td>@item.CourseSessionID</td>
                    <td>@item.CourseTitle</td>
                    @if (item.StartDate.HasValue)
                    {
                        <td>@item.StartDate.Value.ToString("dd/MM/yyyy")</td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    @if (item.EndDate.HasValue)
                    {
                        <td>@item.EndDate.Value.ToString("dd/MM/yyyy")</td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    <td>@item.Division</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@*<div class="modal-footer">
        <button type="button" class="btn default green" onclick="SetSelectedCourse()">Select</button>
        <button type="button" class="btn default" data-dismiss="modal">Close</button>
    </div>*@
@Html.Partial("_includeDataTableScripts")
<script>
    transformTable("#tblCoursePicker");
</script>
