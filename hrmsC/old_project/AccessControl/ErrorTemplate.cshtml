@model ESS_Access_Control.AccessMessage

<br />
<body>
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    @Model.Message
                </h4>
                <p>
                    Detail Message:
                    <div class="well" style="font-family: 'Courier New';">
                        @Html.Raw(Model.Detail)
                        <br />
                        <br />
                        <i>Date: @DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss tt")</i>

                        <br />
                        <br />
                        @if (Model.ShowContactPerson)
                        {
                            <span>Please contact @Model.ContactPersonName for assistance.</span>
                            <br />
                            <span>Email : @Model.ContactPersonEmail</span>
                            <br />
                            <span>Phone number : @Model.ContactPersonPhoneNo</span>
                        }
                    </div>
                </p>
                @*<p>
                        <input type="button" class="btn red" title="Back to Previous" value="Back to Previous" onclick="javascript: self.history.go(-1);" />
                        <input type="button" class="btn red" name="Back to Home" title="Back to Home" value="Back to Home" onclick="javascript: self.location='/';" />
                    </p>*@
            </div>
        </div>
    </div>
</body>