@{
    ViewBag.Title = "View Vesting Notice";
    string VestID = ViewBag.VestID;
    string CompPlan = ViewBag.CompPlan;
    string CompReviewItem = ViewBag.CompReviewItem;
    string VestNumber = ViewBag.VestNumber;
}

<input type="hidden" value="@VestID" />
<input type="hidden" value="@CompPlan" />
<input type="hidden" value="@CompReviewItem" />
<input type="hidden" value="@VestNumber" />

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title
            <span style="padding-left:20px;">
                <small></small>
            </span>
        </h1>
    </div>
</div>

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>View Vesting Notice
        </div>
        <div class="tools">
            <a id="subtypeToggle" title="" data-original-title="" href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <div class="col-md-6">
                    <select id="ddlLanguage" class="form-control">
                        <option value="EN">English</option>
                        <option value="BM">Bahasa Malaysia</option>
                    </select>

                </div>
            </div>
        </div>
        <div class="form-actions fluid">
            <div class="col-md-offset-3 col-md-9">
                <input type="button" class="btn green" value="View" onclick="DownloadVestingNotice()" />
            </div>
        </div>
    </div>
</div>


<br />
<script type="text/javascript">
    function DownloadVestingNotice() {
        var Language = document.getElementById("ddlLanguage").value;

        window.open('@Html.Raw(Url.Action("DownloadVestNotice", "LTIP", new {
                    VestID = VestID,
                    VestNumber = VestNumber,
                    CompPlan = CompPlan,
                    CompReviewItem = CompReviewItem }))' + "&Language=" + Language);
    }
</script>

