@using System.Globalization
@using LTIP.Models
@model GrantDetail
@{

}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Grant Details
                </div>
                <div class="tools">
                    <a id="subtypeToggle" title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Compensation Plan
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label>
                                            @Model.CompPlan
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Offer/Grant Date
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        @{
                                            if (!string.IsNullOrEmpty(Model.GrantAllocationDate))
                                            {
                                                DateTime tempdate;
                                                <label>
                                                    @(DateTime.TryParse(Model.GrantAllocationDate, out tempdate) ? tempdate.ToString("dd/MM/yyyy") : " - ")
                                                </label>
                                            }
                                            else
                                            {
                                                <label> - </label>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Compensation Review Item
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label>
                                            @Model.CompReviewItem
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-5">
                                        Granted
                                    </label>
                                    <div class="col-md-7 form-control-static">
                                        <label>
                                            @Model.FinalAllocation
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
