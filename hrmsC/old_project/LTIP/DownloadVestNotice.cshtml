@model string

@{
    Exception ex = ViewBag.Error;
}

<div>
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    @Model
                </h4>
                <p>
                    Detail Message:
                    <div class="well" style="font-family: 'Courier New';">
                        @Html.Raw(ex.Message)
                        <br /><br />
                        @Html.Raw(ex.StackTrace)
                        <br /><br />
                        @Html.Raw(ex.ToString())
                    </div>
                </p>
            </div>
        </div>
    </div>
</div>

