@using LTIP.Models
@model GrantDetail
@{
    ViewBag.Title = "LTIP Grant/Vesting Details";
    ESS.Core.EmployeeDetailsSummary EmployeeDetails = ViewBag.EmployeeDetails;
}

@using (Html.BeginForm("OfferAcceptanceDetails", "LTIP", FormMethod.Post))
{
    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
                    @ViewBag.Title
                    <span style="padding-left:20px;">
                        <small></small>
                    </span>
                </h1>
            </div>
        </div>
    </div>

    @Html.Partial("_EmployeeDetails", EmployeeDetails)
    @Html.Partial("_GrantDetails", Model)
    @Html.Partial("_GrantVesting", new Tuple<GrantDetail, string>(Model, "1"))
    @Html.Partial("_GrantVesting", new Tuple<GrantDetail, string>(Model, "2"))
    @Html.Partial("_GrantVesting", new Tuple<GrantDetail, string>(Model, "3"))
}
<script>
</script>

