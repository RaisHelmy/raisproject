@model List<LTIP.Models.OfferAcceptance>

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>LTIP Grant/Vesting Status
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblMain" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Comp. Plan</th>
                                <th>Comp. Review Item</th>
                                <th>Offer/Grant Date</th>
                                <th>Granted</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var offer in Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" 
                                           href="@Url.Action("GrantDetails", "LTIP", new { GrantID = offer.GrantID, Mode = "readonly", Source = "GrantStatus" })">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                    <td>@offer.CompPlan</td>
                                    <td>@offer.CompReviewItem</td>
                                    <td>@offer.GrantAllocationDate</td>
                                    <td>@offer.FinalAllocation</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    transformTable("#tblMain");
</script>


