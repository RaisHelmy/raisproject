@model LTIP.Models.OfferAcceptance
@{
    ViewBag.Title = "LTIP Offer/Acceptance Declaration";
}

<style>
    .radio input[type=radio],
    .radio-inline input[type=radio],
    .checkbox input[type=checkbox],
    .checkbox-inline input[type=checkbox] {
        margin-left: 0px;
    }
</style>
@using (Html.BeginForm("GrantStatus", "LTIP", FormMethod.Post))
{
    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
                    @ViewBag.Title
                    <span style="padding-left:20px;">
                        <small></small>
                    </span>
                </h1>
            </div>
        </div>
    </div>

    <input type="hidden" name="GrantID" value="@Model.GrantID" />

    <div class="portlet box blue">
        <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-reorder"></i>Offer Declaration
            </div>
            <div class="tools">
            </div>
        </div>
        <div class="portlet-body form">
            <div class="form-body">
                <table cellpadding="0" cellspacing="0" class="FormSection">
                    <tr>
                        <td>
                            Reference is made to your letter of offer dated @Model.OfferStartDate with the reference number set out in the table below ("<b>Offer Letter</b>") and the offer ("<b>Offer</b>")
                            made therein pursuant to Tenaga Nasional Berhad Long-Term Incentive Plan ("<b>Scheme</b>").
                            <br />
                            <br />
                            <i>
                                Merujuk kepada surat tawaran bertarikh @Model.OfferStartDate dengan nombor rujukan yang dinyatakan dalam jadual di bawah ("<b>Surat Tawaran</b>") dan tawaran ("<b>Tawaran</b>")
                                yang dibuat di dalamnya menurut Pelan Insentif Jangka Panjang Tenaga Nasional Berhad ("<b>Skim</b>").
                            </i>
                            <br />
                            <br />
                            <table border="0" cellpadding="5" cellspacing="5" width="100%">

                                <tr>
                                    <td valign="top"><input type="checkbox" id="chkDeclaration1" name="chkDeclaration1" /></td>
                                    <td>
                                        I hereby accept the Offer as described in and upon the terms and conditions set out in the Offer Letter.
                                        <br /><br />
                                        <i>Saya dengan ini menerima tawaran tersebut dan tertakluk di atas terma-terma dan syarat- syarat yang dinyatakan di dalam Surat Tawaran.</i>
                                        <br /><br />
                                    </td>
                                </tr>

                                <tr>
                                    <td valign="top"><input type="checkbox" id="chkDeclaration2" name="chkDeclaration2" /></td>
                                    <td>
                                        I hereby agree to pay RM1.00 by way of direct deduction from my salary which I hereby consent to and authorise the
                                        Company for doing so, by submission of this Acceptance Form to the Company through the Company’s Employee Self-Service online platform, as consideration
                                        for the Offer.
                                        <br />
                                        <br />
                                        <i>
                                            Saya dengan ini bersetuju untuk membayar RM1.00 dan memberi kuasa kepada Syarikat untuk membuat potongan gaji
                                            sebagai balasan bagi Tawaran ini dengan penyerahan Borang Penerimaan kepada Syarikat melalui platform dalam talian Pekerja Syarikat (Employee Self-Service).
                                        </i>
                                        <br />
                                        <br />
                                    </td>
                                </tr>

                                <tr>
                                    <td valign="top"><input type="checkbox" id="chkDeclaration3" name="chkDeclaration3" /></td>
                                    <td>
                                        I hereby agree to pay RM2.20, by way of direct deduction from my salary which I hereby consent to and authorise the Company for doing so during Vesting, as consideration for the Vesting into my CDS Account (if entitled).
                                        <br />
                                        <br />
                                        <i>
                                            Saya dengan ini juga bersetuju untuk membayar RM2.20 dan memberi kuasa kepada Syarikat untuk membuat potongan gaji semasa Pemberian (Vesting) sebagai balasan bagi Pemberian Saham ke dalam akaun CDS saya (jika layak).
                                        </i>
                                        <br />
                                        <br />
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        &nbsp;
                                    </td>
                                    <td>
                                        <br />
                                        I refer to the following tax payment methods in respect of the taxable income arising from my participation in the Tenaga Nasional Berhad Long-Term Incentive Plan (<b>"Scheme"</b>):<br /><br />
                                        <i>Saya merujuk kepada kaedah pembayaran cukai berikut bagi pendapatan boleh cukai yang dikenakan daripada penyertaan saya dalam Pelan Insentif Jangka Panjang Tenaga Nasional Berhad (<b>"Skim"</b>):</i><br /><br />
                                        <table border="0" cellpadding="5" cellspacing="5">
                                            <tr>
                                                <td width="40px" valign="top">
                                                    <input type="radio" name="TaxOption" value="A" checked="checked" />
                                                </td>
                                                <td>
                                                    <b>OPTION A</b>: Payment upon filing Tax Return (Upon Election by Employee)<br />
                                                    <i><b>OPSYEN A</b>: Bayaran semasa pemfailan Borang Nyata Cukai Pendapatan (BNCP) (Jika dipilih oleh Pekerja)</i><br />
                                                    <ol>
                                                        <li>
                                                            Tax arising from the Scheme is paid upon the filing of Annual Tax Return i.e. Form B/BE/M, on or before 30 April (without business source income) or 30 June (with business source income) following the year of vest.<br /><br />
                                                            <i>Cukai yang dikenakan daripada Skim ini perlu dibayar semasa pemfailan BNCP iaitu Borang B/BE/M, pada atau sebelum 30 April (tanpa punca pendapatan perniagaan) atau 30 Jun (dengan punca pendapatan perniagaan) bagi tahun selepas pemberian saham.</i><br /><br />
                                                        </li>
                                                        <li>
                                                            Tax arising from the Scheme can be paid by way of an instalment plan (CP 38 directives) arranged with the Collections Unit, Inland Revenue Board of Malaysia (IRBM) upon the filing of Annual Tax Return i.e. Form B/BE/M, on or before 30 April (without business source income) or 30 June (with business source income) following the year of vest.  This option is only available upon specific application to the IRBM and a confirmation obtained via the issuance of the Form CP 38 by the IRBM.<br /><br />
                                                            <i>Cukai yang dikenakan daripada Skim ini boleh dibayar melalui pelan ansuran (Arahan CP 38) selepas berurusan dengan Unit Pungutan, Lembaga Hasil Dalam Negeri (LHDN) semasa pemfailan BNCP iaitu Borang B/BE/M, pada atau sebelum 30 April (tanpa punca pendapatan perniagaan) atau 30 Jun (dengan punca pendapatan perniagaan) bagi tahun selepas pemberian saham. Pilihan ini hanya diperolehi melalui permohonan khas kepada LHDN dan pengesahan diperolehi melalui Arahan Borang CP 38 yang dikeluarkan oleh LHDN.</i>
                                                        </li>
                                                    </ol>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td width="20px" valign="top">
                                                    <input type="radio" name="TaxOption" value="B" />
                                                </td>
                                                <td>
                                                    <b>OPTION B</b>: Payment through Monthly Tax Deduction ("MTD")<br />
                                                    <i><b>OPSYEN B</b>: Bayaran melalui Potongan Cukai Bulanan ("PCB")</i><br />
                                                    <ol>
                                                        <li>
                                                            Tax arising from the Shares Scheme is paid through monthly payroll deductions from remuneration under the MTD scheme in the month the shares are vested. If the MTD is higher than the total salary for the month, then the additional MTD (based on the specification of formula) will be recovered from the following month's salary.<br /><br />
                                                            <i>Cukai yang dikenakan daripada Skim Saham ini akan dibayar melalui potongan gaji bulanan di bawah skim PCB pada bulan pemberian Saham dibuat. Sekiranya potongan PCB tersebut adalah lebih tinggi daripada jumlah pendapatan bulanan pekerja, baki PCB (berdasarkan formula tertentu) akan dipotong dalam gaji bulan berikutnya.</i>
                                                        </li>
                                                    </ol>
                                                </td>
                                            </tr>
                                        </table>
                                        I will undertake the responsibility of settling all taxes arising from my Shares taxable income.<br /><br />
                                        <i>Saya mengakui untuk bertanggungjawab bagi menyelesaikan semua cukai yang kena dibayar yang berpunca daripada pendapatan boleh cukai Saham saya.</i><br />
                                        <br />

                                    </td>
                                </tr>

                                <tr>
                                    <td valign="top"><input type="checkbox" name="chkDeclaration4" /></td>
                                    <td>
                                        I hereby declare to the Company and confirm that I am not a Connected Person described in the Offer Letter as of the date hereof,
                                        and I undertake to immediately inform the Company in the event that I become a Connected Person at any time from the date hereof
                                        up to the expiry of the Scheme or the cessation of my employment with the Company, whichever earlier.
                                        <br />
                                        <br />
                                        <i>
                                            Saya dengan ini mengisytiharkan kepada Syarikat dan mengesahkan bahawa saya bukan orang yang berkait seperti yang dinyatakan
                                            di dalam Surat Tawaran pada tarikh ia dikeluarkan, dan saya berjanji untuk memberitahu Syarikat dengan serta-merta sekiranya saya
                                            menjadi Orang yang Berkait pada bila-bila masa dari tarikh Perjanjian ini sehingga tamat tempoh Skim ini atau tamat perkhidmatan
                                            saya dengan Syarikat, yang mana lebih awal.
                                        </i>
                                        <br /><br />
                                    </td>
                                </tr>

                                <tr>
                                    <td valign="top"><input type="checkbox" name="chkDeclaration5" /></td>
                                    <td>
                                        I agree to be bound by the terms of the By-Laws of the Scheme and the Offer Letter and any amendments or variation thereto.
                                        <br />
                                        <br />
                                        <i>Saya bersetuju untuk terikat dengan terma-terma Undang-undang Kecil Skim ini dan Surat Tawaran dan apa-apa pindaan atau perubahan kepadanya.</i>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <br />
                            <br />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <input type="button" class="btn green" value="Accept" id="btnAccept" onclick="AcceptOffer();" />
                            <input type="button" class="btn red" value="Decline" id="btnDecline" onclick="DeclineOffer();" />
                        </td>
                    </tr>
                </table>
                <br /> <br />
                <div class="row">
                    <div class="col-md-12">
                        <input type="button" class="btn blue" value="Back" id="btnBack" onclick="BackToHistory();" />
                        <input type="button" class="btn blue" value="Exit" id="btnExit" onclick="ExitDeclaration();" />
                        <input type="button" class="btn green" value="Next" id="btnNext" onclick="ProceedNext();" disabled="disabled" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@Html.Partial("__Prompt")

<script>
    $(function () {
        $('input[type=radio]').uniform();
    });

    function AcceptOffer() {
        var chkDeclaration_1 = $('input[name="chkDeclaration1"]');
        var chkDeclaration_2 = $('input[name="chkDeclaration2"]');
        var chkDeclaration_3 = $('input[name="chkDeclaration3"]');
        var chkDeclaration_4 = $('input[name="chkDeclaration4"]');
        var chkDeclaration_5 = $('input[name="chkDeclaration5"]');

        if (chkDeclaration_1.prop('checked') &&
            chkDeclaration_2.prop('checked') &&
            chkDeclaration_3.prop('checked') &&
            chkDeclaration_4.prop('checked') &&
            chkDeclaration_5.prop('checked')) {
            var r = confirm('Note: Once you have ACCEPTED the offer, the system/process will not allow you to reverse the decision.\n\nAre you sure you want to proceed?\n\nSetelah anda MENERIMA tawaran ini sistem/proses tidak membenarkan sebarang pertukaran dibuat terhadap keputusan anda.\n\nAdakah anda pasti untuk meneruskan dengan keputusan anda?');
            if (r == true) {
                ProceedNext("Accept");
            }
        }
        else {
            alert('Please check all declaration checkboxes to proceed');
        }
    }

    function DeclineOffer() {
        var r = confirm('Note: Once you have DECLINED the offer, the system/process will not allow you to reverse the decision.\n\nAre you sure you want to DECLINE?\n\nSetelah anda MENOLAK tawaran ini sistem/proses tidak membenarkan sebarang pertukaran dibuat terhadap keputusan anda.\n\nAdakah anda pasti untuk MENOLAK tawaran ini?');
        if (r == true) {
            ProceedNext("Decline");
        }
    }

    function BackToHistory() {
        history.back();
    }

    function ExitDeclaration() {
        window.location = '@Url.Action("OfferAcceptance", "LTIP")';
    }

    function ProceedNext(action) {
        var data = {
            GrantID: '@Model.GrantID',
			TaxOption: $('span.checked').children('input[name="TaxOption"]').val(),
            Action: action
        };
        $.post('@Url.Action("OfferAcceptanceDeclaration", "LTIP")', data, function (result) {
            if (result.Success) {
                ShowDialog({
                    message: result.Message,
                    okCallback: function () {
                        window.location.href = '@Url.Action("OfferAcceptanceHistory", "LTIP")';
                    }
                });
            }
            else {
                alert(result.ErrorMessage);
            }
        });
    }
</script>

