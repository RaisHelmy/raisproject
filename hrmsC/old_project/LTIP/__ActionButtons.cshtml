@model LTIP.Models.OfferAcceptance
@{
    bool isOwner = ViewBag.IsOwner;
    String BackUrl = ViewBag.BackUrl;
}

<div class="row">
    <div class="col-md-12">
        <input type="button" class="btn green" value="Back" id="btnBack" onclick="BackToHistory()" />
        
        @if (isOwner && Model.GrantStatusDesc == "Pending")
        {
            <input type="button" class="btn green" value="Next" id="btnNext" onclick="ProceedNext()" />
        }
    </div>
</div>
<script>
    function BackToHistory() {
        history.back();
    }
</script>
