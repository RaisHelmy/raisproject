@model LTIP.Models.OfferAcceptance
@{

}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Offer Acceptance Details
                </div>
                <div class="tools">
                    <a id="subtypeToggle" title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Action
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label>
                                            @{ 
                                                string actionMessage = "-";

                                                if (Model.Action.ToUpper() == "ACCEPTED")
                                                {
                                                    actionMessage = "Accept";
                                                }
                                                else if (Model.Action.ToUpper() == "DECLINED")
                                                {
                                                    actionMessage = "Decline";
                                                }

                                                @actionMessage;
                                            }
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Action Date
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label>
                                            @{ 
                                                if (string.IsNullOrEmpty(Model.ActionDate))
                                                {
                                                    @("-")
                                                }
                                                else
                                                {
                                                    @Model.ActionDate
                                                }
                                            }
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Selected Tax Method
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label>
                                            @{
                                                string taxCodeMessage = "-";

                                                if (Model.TaxMethod == ("A"))
                                                {
                                                    taxCodeMessage = "OPTION A: Payment upon filing Tax Return (Upon Election by Employee)";
                                                }
                                                else if (Model.TaxMethod == "B")
                                                {
                                                    taxCodeMessage = "OPTION B: Payment through Monthly Tax Deduction (\"MTD\")";
                                                }
                                            }

                                            @taxCodeMessage
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
