@using System.Linq
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (System.Web.HttpContext.Current.Request.QueryString["CallFromAdminQuickLink"] != null)
    {
        Layout = null;
    }
    @*if (System.Web.HttpContext.Current.Request.QueryString["CallFromShortQuickLinkFT"] != null)
    {
        <p>@System.Web.HttpContext.Current.Request.QueryString["CallFromShortQuickLinkFT"]</p>
        <p>@System.Web.HttpContext.Current.Request.QueryString["EmployeeID"]</p>
        <p>@System.Web.HttpContext.Current.Request.QueryString["EmployeeCode"]</p>
    }*@
}

@*<p>@System.Web.HttpContext.Current.Request.QueryString["CallFromAdminQuickLink"]</p>*@

<script>
        @if (System.Web.HttpContext.Current.Request.QueryString["CallFromShortQuickLinkPP"] != null)
        {
            <text>
            $(document).ready(function () {
                $('#txtEmpName').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeCode"]' + ' - ' + '@System.Web.HttpContext.Current.Request.QueryString["EmployeeName"]');
                $('#hfEmpID').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeID"]');

                $('#txtEmployeeID').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeCode"]' + ' - ' + '@System.Web.HttpContext.Current.Request.QueryString["EmployeeName"]');
                $('#EmployeeID').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeID"]');
            });
            </text>

        }
        else if (System.Web.HttpContext.Current.Request.QueryString["CallFromShortQuickLinkFT"] != null)
        {
            <text>
            $(document).ready(function () {
                $('#SubmittedBy').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeCode"]');
                $('#EmployeeName').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeName"]');
                $('#EmployeeNo').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeCode"]');
                $('#employeeSearch').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeCode"]');
                $('#EmployeeSearch').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeCode"]');
                $('#EmployeeCode').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeCode"]');
                $('#EmpName').val('@System.Web.HttpContext.Current.Request.QueryString["EmployeeName"]');
            });
            </text>
        }
</script>