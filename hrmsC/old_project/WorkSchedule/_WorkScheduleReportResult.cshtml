@model List<ESS.Core.WorkScheduleHistory>
@{
    Layout = null;

}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Work Schedule Report
        </div>
        @*<input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />*@
        <input type="button" id="ExportExcel" class="btn btn-xs green pull-right" value="Export To Excel" onclick="ExportExcel()"/>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee Number</th>
                                <th>Employee Name</th>
                                <th>Work Schedule Type</th>
                                <th>Submission Date</th>
                                @*<th>Action Date</th>*@
                                <th>Status</th>
                                <th>Approver ID</th>
                                <th>Approver Name</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <a class="btn blue btn-sm" href="@Url.Content("~/WorkSchedule/WorkScheduleApplication")?ID=@item.ID&Source=Report">
                                                <i class="fa fa-search"></i>
                                            </a>
                                        </td>
                                        <td>@item.ReferenceNo</td>
                                        <td>@item.EmployeeNo</td>
                                        <td>@item.EmployeeName</td>
                                        <td>@item.WorkScheduleType</td>
                                        @if (item.SubmissionDate.HasValue)
                                        {
                                            <td>@item.SubmissionDate.Value.ToString("dd-MM-yyyy")</td>
                                        }
                                        else
                                        {
                                            <td>-</td>
                                        }

                                        @*@if (item.ModifiedDate.HasValue)
                                        {
                                            <td>@item.ModifiedDate.Value.ToString("dd-MM-yyyy")</td>
                                        }
                                        else
                                        {
                                            <td>-</td>
                                        }*@

                                        @if (item.Status == "Declined" || item.Status == "Withdrawn")
                                        {
                                            <td style="color:red;"><b>@item.Status</b></td>
                                        }
                                        else
                                        {
                                            <td style="color:green;"><b>@item.Status</b></td>
                                        }
                                        <td>@item.ApproverCode</td>
                                        <td>@item.ApproverName</td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
                <div>Note: The list display up to a maximum of 1000 records. Click on "Export to Excel" to view more.</div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
 
    $('#tblResult').dataTable({
        "aLengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]]
    });

    var tableWrapper = "#tblResult_wrapper";

    jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
    jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
    jQuery(tableWrapper + ' .dataTables_length select').select2({
        showSearchInput: false //hide search box with special css class
    });
</script>