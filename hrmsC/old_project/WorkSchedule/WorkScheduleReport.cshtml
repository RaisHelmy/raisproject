@model List<TNB_ESS_MVC.Controllers.WorkScheduleController.WorkScheduleTypeList>
@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Work Schedule Report";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Work Schedule Report<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Work Schedule Type</label>
                    <div class="col-md-8 form-control-static">
                        @Html.DropDownList("WorkScheduleType", new SelectList(Model, "WorkScheduleType", "WorkScheduleType"), "- All -", new { @class = "bs-select form-control" })
                        @*<select class="form-control" id="WorkScheduleType">
                                <option value="">- All -</option>
                                <option value="Normal Working Hours">Normal Working Hours</option>
                                <option value="Staggered Working Hours">Staggered Working Hours</option>
                                <option value="Staggered Ramadhan">Staggered Ramadhan</option>
                            </select>*@
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option value="">- All -</option>
                            <option value="Pending">Pending</option>
                            <option value="Declined">Declined</option>
                            <option value="Approved">Approved</option>
                            <option value="Withdrawn">Withdrawn</option>
                            <option value="Failed">Failed</option>
                            <option value="Draft">Draft</option>
                            <option value="Error">Error</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Partial("_PeoplePicker")
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Reference No.</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" id="RefNo" class="form-control" name="RefNo" />
                    </div>
                </div>
            </div>
        </div>

    </div>

    @* Below part is for search Name/Code in 1 textbox *@
    @*<div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee Name/Code</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" id="EmpNameCode" class="form-control" name="EmpNameCode" />
                    </div>
                </div>
            </div>
        </div>
    </div>*@
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            @*<input type="button" id="btn-Export" class="btn green" value="Export To Excel" />*@
        </div>
    </div>
</div>

<iframe id="txtArea1" style="display:none"></iframe>


<script type="text/javascript">
    function ExportExcel() {
        var dt = new Date();
        var day = dt.getDate();
        var month = dt.getMonth() + 1;
        var year = dt.getFullYear();
        var hour = dt.getHours();
        var mins = dt.getMinutes();
        var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;

        var _DateFrom = $('#SubDateFrom').val();
        var _DateTo = $('#SubDateTo').val();
        var _WorkSchduleType = $('#WorkScheduleType').val();
        var _Status = $('#Status').val();
        var _EmpID = $('#hfEmpID').val();
        var _RefNo = $('#RefNo').val();

        window.open("../WorkSchedule/_ExportToExcel?FileName=WorkSchdule_Report_" + postfix + "&DateFrom=" + _DateFrom + "&DateTo=" +
            _DateTo + "&WorkScheduleType=" + _WorkSchduleType + "&Status=" + _Status + "&EmpID=" + _EmpID + "&RefNo=" + _RefNo);
    }
    function SearchListing() {

        var ValidationMsg = '';

        if ($('#SubDateFrom').val() == '') {
            ValidationMsg += '- Submission Date (From) is required.\n'
        }
        if ($('#SubDateTo').val() == '') {
            ValidationMsg += '- Submission Date (To) is required.\n'
        }

        if (ValidationMsg != "") {
            alert(ValidationMsg);
        }
        else {
             var _DateFrom = $('#SubDateFrom').val();
            var _DateTo = $('#SubDateTo').val();
            var _WorkSchduleType = $('#WorkScheduleType').val();
            var _Status = $('#Status').val();
            var _EmpID = $('#hfEmpID').val();
            var _RefNo = $('#RefNo').val();
            //alert(_WorkSchduleType);
            $("#SearchResult").html("LOADING...");

            $.ajax({
                type: "GET",
                url: '@Url.Content("~/WorkSchedule/_WorkScheduleReportResult")',
                cache: false,
                dataType: "html",
                data: { DateFrom: _DateFrom, DateTo: _DateTo, WorkScheduleType: _WorkSchduleType, Status: _Status, EmpID: _EmpID, RefNo: _RefNo },
                success: function (content) {
                    $("#SearchResult").html(content);
                    ExportToExcel();
                },
                error: function (e) {
                    console.log(e);
                }
            });
        }
       
    }

    function ConvertDate(_date) {
        var mnth = ("0" + (_date.getMonth() + 1)).slice(-2),
            day = ("0" + _date.getDate()).slice(-2);

        return [day, mnth, _date.getFullYear()].join("/");
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        });


        var _Today = new Date();
        _Today.setDate(_Today.getDate() - 60);
        var _Start = ConvertDate(_Today);

        $('#SubDateFrom').val(_Start);
        $('#SubDateTo').val(ConvertDate(new Date()));

        //SearchListing();
    });

    function ExportToExcel()
    {
        // EXPORT TO EXCEL
        var ua = window.navigator.userAgent;
        var msie = ua.indexOf("MSIE ");

       
        //07-06-2016 -- TBD
        // Internet Explorer
        if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {
            var _btn = document.getElementById('btn-Export');
            _btn.onclick = fnExcelReport;
        }
        else {
            $("#btn-Export").click(function (e) {
                //getting values of current time for generating the file name
                var dt = new Date();
                var day = dt.getDate();
                var month = dt.getMonth() + 1;
                var year = dt.getFullYear();
                var hour = dt.getHours();
                var mins = dt.getMinutes();
                var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                //creating a temporary HTML link element (they support setting file names)
                //var a = document.createElement('a');
                //getting data from our div that contains the HTML table
                //var data_type = 'data:application/vnd.ms-excel';
                var table_div = document.getElementById('tblResult');
                //var table_html = table_div.outerHTML.replace(/ /g, '%20');
                //a.href = data_type + ', ' + table_html;
                ////setting the file name
                //a.download = 'WorkSchdule_Report_' + postfix + '.xls';
                ////triggering the function
                //a.click();
                ////just in case, prevent default behaviour
                tableToExcel(table_div, 'sheet1', 'WorkSchdule_Report_' + postfix);
                e.preventDefault();
            });
        }
    }

    function ClearFilter() {
        $('#SubDateFrom').val('');
        $('#SubDateTo').val('');
        $('#Status').val('');
        $('#txtEmpName').val('');
        $('#hfEmpID').val('');
        $('#RefNo').val('');
        $('#WorkScheduleType').val('');
        SearchListing();
    }

    function fnExcelReport() {
        var dt = new Date();
        var day = dt.getDate();
        var month = dt.getMonth() + 1;
        var year = dt.getFullYear();
        var hour = dt.getHours();
        var mins = dt.getMinutes();
        var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
        var _fileName = 'WorkSchedule_Report_' + postfix + '.xls';

        var tab_text = "<table border='2px'><tr bgcolor='#87AFC6'>";
        var textRange; var j = 0;
        tab = document.getElementById('tblResult'); // id of table

        for (j = 0 ; j < tab.rows.length ; j++) {
            tab_text = tab_text + tab.rows[j].innerHTML + "</tr>";
            //tab_text=tab_text+"</tr>";
        }

        tab_text = tab_text + "</table>";


        //var ua = window.navigator.userAgent;
        //var msie = ua.indexOf("MSIE ");

        //if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./))      // If Internet Explorer
        //{
        txtArea1.document.open("txt/html", "replace");
        txtArea1.document.write(tab_text);
        txtArea1.document.close();
        txtArea1.focus();
        sa = txtArea1.document.execCommand("SaveAs", true, _fileName);
        //}
        //else //other browser not tested on IE 11
        //    sa = window.open('data:application/vnd.ms-excel,filename=aaa.xlsx' + encodeURIComponent(tab_text));
        return (sa);
    }

    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
          , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
          , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
          , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name, filename) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            //window.location.href = uri + base64(format(template, ctx))
            var link = document.createElement("a");
            link.download = filename + '.xls';
            link.href = uri + base64(format(template, ctx));
            link.click();
        }
    })()


</script>

