@model ESS.GenCoLetter.Models.OfferLetterDetail
@using ESS.GenCoLetter.Constants
@{
    ViewBag.Title = "Offer Letter";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string color = "";
    string download = "";
    string acceptanceDownload = "";
    string checkBoxDecline = "";
    string checkBoxAccept = "";
    if (Model.OfferLetterData.Status == GlobalConstants.STATUS_PENDING)
    {
        color = "red";
    }
    else
    {
        if (Model.OfferLetterData.Status == GlobalConstants.STATUS_DECLINED)
        {
            color = "red";
            checkBoxDecline = "checked disabled";
            checkBoxAccept = "disabled";
        }
        else
        {
            color = "green";
            checkBoxAccept = "checked disabled";
            checkBoxDecline = "disabled";
        }

    }

    if (Model.OfferLetterData.Downloaded)
    {
        download = "download";
    }
    if (Model.OfferLetterData.AcceptanceDownloaded)
    {
        acceptanceDownload = "download";
    }
}
<style>
    .color{
        color:@color;
        font-weight:bold;
    }
    .download{
        color:green;
    }
</style>
<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                @ViewBag.Title
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>


@Html.HiddenFor(model => model.OfferLetterData.ID)

<!-- Employee Details -->
@Html.Partial("_EmployeeInfoOfferLetter", Model.Submiter)

<!-- Application Detail -->
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Application Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div id="trRefNo" class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Reference No
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.OfferLetterData.ReferenceNo
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Status</label>
                                    <div class="col-md-8 form-control-static">
                                        <span class="color">@Model.OfferLetterData.Status</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Offer Letter Detail -->
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Offer Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div id="trRefNo" class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Company
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        TNB Power Generation Sdn. Bhd. (GenCo)
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Grade</label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.OfferLetterData.NewPayScaleGroup
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="trRefNo" class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Position
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.OfferLetterData.NewPosition
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Salary</label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.OfferLetterData.NewBasicWage
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="trRefNo" class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Letter of Offer
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <a href="#" onclick="DownloadPDF()">Click to Download</a> &nbsp;<i class="fa fa-check-circle @download" id="dlicon"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (Model.OfferLetterData.Status != "Pending")
                        {
                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Letter of Acceptance
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <a href="#" onclick="AcceptanceDownloadPDF()">Click to Download</a> &nbsp;<i class="fa fa-check-circle @acceptanceDownload" id="dlicon2"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <script>
                                function AcceptanceDownloadPDF() {
                                    var _ID = $("#OfferLetterData_ID").val();
                                    window.open("@Url.Action("AcceptanceDownloadPDF")?ID=" + _ID);
                                    $("#dlicon2").addClass("download");
                                }
                            </script>

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Offer Declaration -->
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Offer Declaration
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div id="trRefNo" class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <p>
                                            Saya telah membaca dan memahami mengenai kesemua terma dan syarat yang terkandung di dalam surat tawaran pelantikan sebagai anggota kerja di bawah terma dan syarat TNB Power Generation Sdn. Bhd. (GenCo). Maka dengan ini saya membuat pilihan seperti berikut:-
                                        </p>

                                        <p><b><i>Opsyen A – BERSETUJU MENERIMA TAWARAN</i></b></p>
                                        <p>
                                            <input type="checkbox" id="chkAccept1" @checkBoxAccept /> BERSETUJU menerima tawaran pelantikan sebagai anggota kerja di bawah terma dan syarat perkhidmatan TNB Power Generation Sdn. Bhd. (GenCo) berkuatkuasa @Model.OfferLetterData.EffectiveDateMalay
                                        </p>
                                        <p>DAN</p>

                                        <p>
                                            <input type="checkbox" id="chkAccept2" @checkBoxAccept /> BERSETUJU menamatkan perkhidmatan di bawah @Model.OfferLetterData.CurrentCompany berkuatkuasa @Model.OfferLetterData.EffectiveDateMalay
                                        </p>


                                        <p><b><i>Opsyen B – TIDAK BERSETUJU MENERIMA TAWARAN</i></b></p>

                                        <p>
                                            <input type="checkbox" id="chkReject1" @checkBoxDecline />  TIDAK BERSETUJU menerima tawaran pelantikan sebagai anggota kerja di bawah terma dan syarat perkhidmatan TNB Power Generation Sdn. Bhd. (GenCo) berkuatkuasa @Model.OfferLetterData.EffectiveDateMalay dan ingin dikekalkan di dalam perkhidmatan @Model.OfferLetterData.CurrentCompany
                                        </p>

                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Audit Log -->
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="~/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Audit Log
                </div>
            </div>
            <div class="portlet-body form">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-horizontal">
                            <div class="form-body">
                                <div style="overflow-x:auto">
                                    <table id="tblAuditLog" class="table table-striped table-bordered table-hover table-full-width">
                                        <thead>
                                            <tr>
                                                <th>Action By</th>
                                                <th>Date</th>
                                                <th>Activity</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.AuditLog)
                                            {
                                                <tr>
                                                    @if (item.EmployeeCode == "00000000-0000-0000-0000-000000000000")
                                                    {
                                                        <td>System</td>
                                                    }
                                                    else
                                                    {
                                                        <td>@item.EmployeeName</td>
                                                    }
                                                    <td>@item.CreatedDate.Value.ToString("dd/MM/yyyy hh:mm tt")</td>
                                                    <td>@item.ActivityName</td>
                                                    <td>@item.ActivityAction</td>

                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<p>Sila klik butang Accept sekiranya menerima tawaran atau butang Decline sekiranya menolak tawaran.</p>

<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
    top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
    opacity: .8; filter: alpha(opacity=70);display:none">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

    </p>
</div>
<input type="hidden" id="approvalAction" />

@if (Model.OfferLetterData.Status == ESS.GenCoLetter.Constants.GlobalConstants.STATUS_PENDING &&
        Model.Submiter.ID.ToString() == ViewBag.EmployeeID &&
        Model.OfferLetterData.ValidityDate >= DateTime.Now.Date)
{
    <a class="btn btn-sm default blue" id="btnAccept" data-toggle="modal" onclick="PerformAction('ACCEPTED')">
        Accept
    </a>

    <a class="btn btn-sm default red" id="btnDecline" data-toggle="modal" onclick="PerformAction('DECLINED')">
        Decline
    </a>

    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmSubmit" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Are you sure you want to Submit this Application? <br />
                        Press Confirm to proceed, or Close to stay on the current page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default blue" id="btnSubmitForm" value="Submit" onclick="SubmitFormAction();">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    <div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                    <h4 class="Success-title">Action Successfully Completed</h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well">
                        Your Work Schedule Application has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <button type="button" class="btn default blue" id="btnOK" onclick="location.reload();">
                        <i class="fa fa-check"></i>
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function PerformAction(action) {
            var chkAccept1 = document.querySelector('#chkAccept1').checked;
            var chkAccept2 = document.querySelector('#chkAccept2').checked;
            var chkReject1 = document.querySelector('#chkReject1').checked;
            var allowSubmit = false;

            if (action == "ACCEPTED") {
                if (chkAccept1 && chkAccept2 && !chkReject1) {
                    allowSubmit = true;
                }
                else {
                    alert('Please tick on the checkbox to proceed.');
                }
            }

            if (action == "DECLINED") {
                if (!chkAccept1 && !chkAccept2 && chkReject1) {
                    allowSubmit = true;
                }
                else {
                    alert('Please tick on the checkbox to proceed.');
                }
            }

            if (allowSubmit) {
                $("#approvalAction").val(action);
                $('#ConfirmSubmit').modal('show');
            }
        }

        function SubmitFormAction() {
            $("#ConfirmSubmit").modal('hide');
            $("#divLoading").show();
            var _approvalAction = $("#approvalAction").val();
            var _ID = $("#OfferLetterData_ID").val();

            if (_approvalAction == 'DECLINED') {
                $(".Success-body .well").html('Your rejection has been successfully recorded.');
            }
            else if (_approvalAction == 'ACCEPTED') {
                $(".Success-body .well").html('Your acceptance has been successfully recorded.');
            }
            else {
                alert('Please perform either accept or decline');
            }

            //jQuery.support.cors = true;

            $.ajax({
                url: '@Url.Content("~/GenCoLetter/PostApproverAction")',
                type: 'POST',
                cache: false,
                async: false,
                dataType: "json",
                data: { ID: _ID, ApprovalAction: _approvalAction},
                success: function (result) {
                    if (result.Success) {
                        $("#ConfirmSubmit").modal('hide');
                        $("#divLoading").css("display", "none");
                        $("#SuccessSubmit").modal();

                    } else {
				        alert(result.ErrorMsg);
                    }

                },
                error: function (x, y, z) {
                    $("#ConfirmUpdate").modal('hide');
                    $("#divLoading").css("display", "none");
                    console.log(x + '\n' + y + '\n' + z);
                }
            });
        }

        function SaveForm(_Status) {
            $("#divLoading").css("display", "block");
            SubmitStatus = _Status;
            var myVar = setTimeout(SubmitFormAction, 3000);
        }
    </script>
}


<a class="btn btn-sm default" id="btnBack" href="@Url.Content("~/GenCoLetter/GenCoLetterList")">
    Back
</a>

<script>
    function DownloadPDF() {
        var _ID = $("#OfferLetterData_ID").val();
        window.open("@Url.Action("DownloadPDF")?ID=" + _ID);
        $("#dlicon").addClass("download");
    }
</script>



