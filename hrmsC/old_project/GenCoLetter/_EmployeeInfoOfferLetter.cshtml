@model ESS.Core.EmployeeDetailsSummary
@{
    Layout = null;
}

<div id="EmployeeDetails" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Employee Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Number
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.EmployeeCode
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.EmployeeName

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        IC No
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.NewIC
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Company
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.Company
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Department
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.Department
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Unit / Section
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.UnitSection

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Position
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.Position
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Grade
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.PayScaleGroup
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


