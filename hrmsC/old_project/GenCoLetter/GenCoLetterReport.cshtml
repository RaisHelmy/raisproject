    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
            </div>
        </div>
    </div>

    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>



<script type="text/javascript">

    $(document).ready(function () {
        $('#divSubmissionDateFrom').datepicker('setDate', '@filterStartDate');
        $('#divSubmissionDateTo').datepicker('setDate', '@filterEndDate');


        $("#divSubmissionDateFrom").datepicker({
            autoclose: true,
        }).on('changeDate', function (selected) {
            var minDate = new Date(selected.date.valueOf());

            minDate.setDate(minDate.getDate() + 1);
            $('#divSubmissionDateTo').datepicker('setDate', minDate);
        });

         $("#divSubmissionDateTo").datepicker({
            autoclose: true,
        }).on('changeDate', function (selected) {
            //var minDate = new Date(selected.date.valueOf());
            //minDate.setDate(minDate.getDate() - 1);
            //$('#divSubmissionDateFrom').datepicker('setDate', minDate);
        });
    });

    function SearchListing() {
        $("#SearchResult").html("LOADING...");

        var _Type = $("#Type").val();
        var _Status = $("#Status").val();
        var _EmployeeID = $("#EmployeeID").val();
        var _Division = $("#Division").val();
        var _Department = $("#Department").val();
        var _UnitSection = $("#UnitSection").val();
        var _ReleaseDateFrom = $("#ReleaseDateFrom").val();
        var _ReleaseDateTo = $("#ReleaseDateTo").val();
        var _SearchEmployeeID = $("#hfEmpID").val();
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/GenCoLetter/_GenCoLetterList")',
            cache: false,
            dataType: "html",
            data: {
                //TemplateName: _Type,
                //Division: _Division,
                //Department: _Department,
                //UnitSection: _UnitSection,
                ReleaseDateFrom: _ReleaseDateFrom,
                ReleaseDateTo: _ReleaseDateTo,
                EmployeeID: _SearchEmployeeID,
                Status: _Status,
            },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
        }

    function changeDivision(e) {
        $("#DepartmentResult").html('<select class="bs-select form-control" id="Department" name="Department"><option value>- All -</option></select>');
        $("#UnitSectionResult").html('<select class="bs-select form-control" id="UnitSection" name="UnitSection"><option value>- All -</option></select>');
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Mobility/_DDLDepartment")',
            cache: false,
            dataType: "html",
            data: { CompanyCode: e.value },
            success: function (content) {
                $("#DepartmentResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function changeDepartment(e) {
        $("#UnitSectionResult").html('<select class="bs-select form-control" id="UnitSection" name="UnitSection"><option value>- All -</option></select>');
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Mobility/_DDLUnitSection")',
            cache: false,
            dataType: "html",
            data: { DepartmentCode: e.value },
            success: function (content) {
                $("#UnitSectionResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

