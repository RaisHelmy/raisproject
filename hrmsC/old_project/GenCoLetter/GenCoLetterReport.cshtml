@model ESS.GenCoLetter.Models.DropdownLists
@{
    ViewBag.Title = "Offer Letter Report";
    string filterStartDate = DateTime.Now.AddDays(-7).ToString("dd MMMM yyyy");
    string filterEndDate = DateTime.Now.ToString("dd MMMM yyyy");
}
<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Offer Letter Report<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<input type="hidden" name="EmployeeID" id="EmployeeID" value="@ViewBag.EmployeeID" />

<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Partial("_PeoplePicker")
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        @Html.DropDownList("Status", new SelectList(Model.statusList, "Value", "Text"), "- All -", new { @class = "bs-select form-control" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Offer Start Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divSubmissionDateFrom" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="ReleaseDateFrom" name="ReleaseDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Offer End Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="divSubmissionDateTo" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="ReleaseDateTo" name="ReleaseDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

