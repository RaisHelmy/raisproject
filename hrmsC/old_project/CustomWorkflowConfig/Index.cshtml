
@{
    ViewBag.Title = "Custom WF Config";
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Custom Workflow Configuration<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<input type="hidden" id="hfEmployeeID" value="@ViewBag.EmployeeID" />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Start Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">End Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Personnel Area</label>
                    <div class="col-md-8 form-control-static">
                        @Html.DropDownList("Company", new SelectList(ViewBag.CompanyList, "Value", "Text"), "- All -", new { @class = "bs-select form-control", @onchange = "changeCompany(this)" })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Division / Department</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLDepartment", "Training", new { })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Unit / Section</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLUnitSection", "Training", new { })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input id="btnSearchApproval" type="button" value="Search" class="btn green btn-Search" onclick="SearchListing();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="DeleteConfigModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title">Confirmation - Delete Config</h4>
            </div>
            <div class="modal-body">
                <div class="well">
                    Clicking Delete will remove this config. If you want to cancel, click Close. 
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn default red" id="btnDeleteConfig">
                    <i class="fa fa-check"></i>
                    Delete
                </button>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        SearchListing();
    });

    function SearchListing() {
        var _DateFrom = $('#SubDateFrom').val();
        var _DateTo = $('#SubDateTo').val();
        var _CompanyCode = $('#Company option:selected').val();
        var _DepartmentCode = $('#Department option:selected').val();
        var _UnitSectionCode = $('#UnitSection option:selected').val();
        var _EmployeeName = $('#EmployeeName').val();
       

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/CustomWorkFlowConfig/_ConfigSearchResult")',
            cache: false,
            dataType: "html",
            data: {
                DateFrom: _DateFrom, DateTo: _DateTo, CompanyCode: _CompanyCode, DepartmentCode: _DepartmentCode,
                UnitSectionCode: _UnitSectionCode, EmployeeName: _EmployeeName
            },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function changeType(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Training/_DDLTrainingType")',
            cache: false,
            dataType: "html",
            data: { CategoryCode: e.value},
            success: function (content) {
                $("#TrainingTypeResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function changeCompany(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Training/_DDLDepartment")',
            cache: false,
            dataType: "html",
            data: { CompanyCode: e.value },
            success: function (content) {
                $("#DepartmentResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function changeDepartment(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/Training/_DDLUnitSection")',
            cache: false,
            dataType: "html",
            data: { DepartmentCode: e.value },
            success: function (content) {
                $("#UnitSectionResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function DeleteConfig(Id)
    {
        $("#DeleteConfigModal").modal();
        $("#btnDeleteConfig").click(function () {
            $.ajax({
                url: '@Url.Action("Delete", "CustomWorkflowConfig")',
                data: { id: Id },
                success: function () {
                    $("#DeleteConfigModal").modal('hide');
                    location.href = '@Url.Action("Index", "CustomWorkflowConfig")';
                },
                error: function (err) {
                    alert(err);
                }
            });
        });
    }
</script>