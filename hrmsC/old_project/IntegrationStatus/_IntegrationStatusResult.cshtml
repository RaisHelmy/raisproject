@model IEnumerable<IntegrationStatus.Models.Result>

@{
	Layout = null;
}

<div class="portlet box blue">
	<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Integration Status Listing
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel">
        <div class="tools">
        </div>
    </div>
	<div class="portlet-body form">
		<div class="form-body">
			<div class="form-horizontal">
				<div class="table-toolbar">
					<table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
						<thead>
							<tr>
                                <th>
                                    <input id="StatusCheckboxHeader" type="checkbox" onchange="SelectAll(this)" />
                                </th>
								<th></th>
								<th>
									Module Name
								</th>
								<th>
									Request No
								</th>
								<th>
									Employee
								</th>
								<th>
									Integration Status
								</th>
								<th>
									Last Integration Date
								</th>
								<th>
									Error Message
								</th>
                                <th>
                                    Request Status
                                </th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td>
										<input type="checkbox" class="StatusCheckBox" value="@item.RequestID" module="@item.ModuleCode" />
									</td>
									<td>
										@{
											string host = Request.Url.Host;
											string scheme = Request.Url.Scheme;
											string delimeter = "://";
											string url = scheme + delimeter + host + item.FormPath;
										}

										<a class="btn blue btn-sm" href="@url">
											<i class="fa fa-search"></i>
										</a>
									</td>
									<td>
										@item.ModuleName
									</td>
									<td>
										@item.RequestNo
									</td>
									<td>
										@item.Employee
									</td>
									<td>
										@item.IntegrationStatus.ToUpper()
									</td>
									<td>
										@item.LastIntegrationDate
									</td>

									<td>
										@item.ErrorMessage
									</td>

                                    <td>
                                        @item.RequestStatus
                                    </td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

<table id="tblExport" border="1" style="display: none;">
    <thead>
        <tr>
            <th></th>
            <th></th>
            <th>
                Module Name
            </th>
            <th>
                Request No
            </th>
            <th>
                Employee
            </th>
            <th>
                Integration Status
            </th>
            <th>
                Last Integration Date
            </th>
            <th>
                Error Message
            </th>
            <th>
                Request Status
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <input type="checkbox" class="StatusCheckBox" value="@item.RequestID" module="@item.ModuleCode" />
                </td>
                <td>
                    @{
                        string host = Request.Url.Host;
                        string scheme = Request.Url.Scheme;
                        string delimeter = "://";
                        string url = scheme + delimeter + host + item.FormPath;
                    }

                    <a class="btn blue btn-sm" href="@url">
                        <i class="fa fa-search"></i>
                    </a>
                </td>
                <td>
                    @item.ModuleName
                </td>
                <td>
                    @item.RequestNo
                </td>
                <td>
                    @item.Employee
                </td>
                <td>
                    @item.IntegrationStatus.ToUpper()
                </td>
                <td>
                    @item.LastIntegrationDate
                </td>

                <td>
                    @item.ErrorMessage
                </td>

                <td>
                    @item.RequestStatus
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(function () {
        transformTable("#tblResult");
  //      var datatable = $('#tblResult').dataTable({
  //          "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]]
  //      });
		//var tableWrapper = "#tblResult_wrapper";

		//jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
		//jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
		//jQuery(tableWrapper + ' .dataTables_length select').select2({
		//	showSearchInput: false //hide search box with special css class
		//});

		datatable.on('draw.dt', function () { $('input[type="checkbox"]').uniform(); });	
    });

    function SelectAll(element) {
        $('#tblResult input[type="checkbox"].StatusCheckBox').prop('checked', element.checked);
        $.uniform.update();
    }

    $(function () {
        BindExport();
    });
</script>