@using ESS.Core
@using Asset.Models
@model List<AssetSearchResult>
@{
    bool allowHyperlink = false;
    try
    {
        allowHyperlink = SP.IsInGroup("ESS Admin") ||
                         SP.IsInGroup("Asset Declaration GM");
    }
    catch
    {
        allowHyperlink = false;
    }
}
<style>
    .table-centered {
        width: 50% !important;
        display: table;
        margin-right: auto;
        margin-left: auto;
    }

    .table-header {
        background-color: green;
        color: white;
        font-weight: bold;
        text-align: center;
    }

    .table-body {
        background-color: powderblue;
    }

    .table-left {
        text-align: left;
    }

    .table-right {
        text-align: right;
    }

    .table-footer {
        background-color: lightgreen;
    }
</style>

<div class="form-body">
    <div class="form-horizontal">
        <div class="table-toolbar">
            <table id="tblResultSummary" class="table table-bordered table-centered">
                <thead>
                    <tr class="table-header">
                        <th>Status</th>
                        <th>No. of Records</th>
                    </tr>
                </thead>
                <tbody class="table-body">
                    <tr>
                        <td class="table-left">Completed</td>
                        <td class="table-right">
                            @(Model.Where(x => x.SubmissionStatusCode == "CO").Count())
                        </td>
                    </tr>
                    <tr>
                        <td class="table-left">Completed (Manual Form)</td>
                        <td class="table-right">
                            @(Model.Where(x => x.SubmissionStatusCode == "MA").Count())
                        </td>
                    </tr>
                    <tr>
                        <td class="table-left">Pending</td>
                        <td class="table-right">
                            @(Model.Where(x => x.SubmissionStatusCode == "PE").Count())
                        </td>
                    </tr>
                    <tr>
                        <td class="table-left">Incomplete</td>
                        <td class="table-right" style="color: red;">
                            @(Model.Where(x => x.SubmissionStatusCode != "CO" &&
                                                        x.SubmissionStatusCode != "MA" &&
                                                        x.SubmissionStatusCode != "PE").Count())
                        </td>
                    </tr>
                </tbody>
                <tfoot class="table-footer">
                    <tr>
                        <td style="text-align: center; font-weight: bold;">Total</td>
                        <td class="table-right">
                            @(Model.Count)
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <br />
    <br />

    <div class="form-horizontal">
        <div class="table-toolbar">
            <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Company</th>
                        <th>Personnel Area</th>
                        <th>Personnel Subarea</th>
                        <th>Payscale Group</th>
                        <th>Status</th>
                        <th>Current In-Tray</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (AssetSearchResult item in @Model)
                        {
                            <tr>
                                <td>
                                    @if (allowHyperlink)
                                    {
                                        <a href="javascript:void(0)"
                                           onclick="window.open('@Url.Action("AssetDeclaration", "Asset", new { EmployeeID = item.EmployeeID})')">
                                            @item.Employee
                                        </a>
                                    }
                                    else
                                    {
                                        @item.Employee
                                    }
                                </td>
                                <td>@item.Company</td>
                                <td>@item.PersonnelArea</td>
                                <td>@item.PersonnelSubarea</td>
                                <td>@item.Grade</td>
                                <td>
                                    @if (item.SubmissionStatusCode == "NO" || String.IsNullOrEmpty(item.SubmissionStatusCode))
                                    {
                                        <span style="color : red;">
                                            @*@item.SubmissionStatusName*@ Incomplete
                                        </span>
                                    }
                                    @*else if (String.IsNullOrEmpty(item.SubmissionStatusCode))
                                        {
                                            <span>Draft</span>
                                        }*@
                                    else
                                    {
                                        <span style="color : green">
                                            @item.SubmissionStatusName
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.SubmissionStatusCode.Equals("PE"))
                                    {
                                        // approver = HOD
                                        <span> Ketua Jabatan (@item.HODName) </span>
                                    }
                                    else if (item.SubmissionStatusCode.Equals("A1"))
                                    {
                                        <span> JHED (Sekretariat) </span>
                                    }
                                    else if (item.SubmissionStatusCode.Equals("A2"))
                                    {
                                        // approver = Pengerusi Jawatankuasa
                                        <span> JHED (Pengerusi Jawatankuasa) </span>
                                    }
                                    else
                                    {
                                        <span> - </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    transformTable("#tblResult");
    //var tblResult =
    //    $('#tblResult').dataTable({
    //        "bLengthChange": false,
    //        "bFilter": false,
    //        "bPaginate": false,
    //        "bInfo": false,
    //        "bSortable": false,
    //    });
</script>