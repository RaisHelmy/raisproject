@using Asset.Models
@model AssetVM
@{
    string Title = @"Pengesahan Perisytiharan";

    bool chkDeclarationChecked = false,
         chkDeclarationEnabled = true,
         chkDeclarationVisible = true,
         divDeclarationCheckboxVisible = true;


    if (Model.IsSelf)
    {
        if (Model.AssetSubmissionStatusCode.Equals("PE") || Model.AssetSubmissionStatusCode.Equals("A1") ||
            Model.AssetSubmissionStatusCode.Equals("A2"))
        {
            chkDeclarationChecked = true;
            chkDeclarationEnabled = false;
        }
    }
    else
    {
        chkDeclarationChecked = false;
        chkDeclarationVisible = false;
        divDeclarationCheckboxVisible = false;
    }
}

@if (divDeclarationCheckboxVisible)
{
    <div class="portlet box blue">
        <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-reorder"></i>@Title
            </div>
            <div class="tools">
                <a title="" data-original-title="" href="javascript:;" class="collapse"></a>
            </div>
        </div>
        <div class="portlet-body form">
            <div class="form-body">
                <div class="row">
                    <div class="col-md-12">
                        <input type="checkbox" id="chkConfirmation" 
                               @(chkDeclarationChecked ? "checked" : "") @(chkDeclarationEnabled ? "" : "disabled")>
                        <b>Saya dengan ini mengisytiharkan semua harta yang dimiliki oleh saya serta tanggungan, dan segala maklumat yang diberikan adalah lengkap dan benar.</b>
                    </div>
                </div>
            </div>
        </div>
    </div>
}