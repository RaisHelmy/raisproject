@model List<SEP.RoutingManagement.Models.GetApprovalAuditLog>
@{
    Layout = null;
}

<div class="row" id="trAuditLog">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>
                    Audit Log
                </div>
                <div class="tools">
                    <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="table-toolbar">
                            <table id="tblAuditLog" class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        <th style="width:25%;">Nama</th>
                                        <th style="width:25%;">Peranan</th>
                                        <th style="width:25%;">Tarikh & Waktu</th>
                                        <th style="width:25%;">Tindakan</th>
                                        @*<th style="width:40%;">Comment</th>*@
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model)
                                    {
                                        <tr>
                                            <td>@log.EmployeeName</td>
                                            <td>
                                                @if (log.ActivityName == "Perisytiharan Harta")
                                                {
                                                    @("Pemula")
                                                }
                                                else if (log.ActivityName.Contains("Ketua Pejabat"))
                                                {
                                                    @("Ketua Pejabat")
                                                }
                                                else
                                                {
                                                    @log.ActivityName
                                                }

                                            </td>
                                            <td>@log.FormattedDate</td>
                                            <td>@log.ActivityAction</td>
                                            @*<td style="white-space:pre-line;">@log.Comment</td>*@
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    $(function () {
        $('#tblAuditLog').DataTable({
            "bLengthChange": false,
            "bFilter": false,
            "bPaginate": false,
            "bInfo": false,
            "bSort": false
        });
    });
</script>
