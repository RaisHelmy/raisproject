@model List<ESS.Employee.Models.FamilyInfo>
@{
    string Title = @"Maklumat Keluarga";
}

<div class="collapse-portlet portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>@Title
        </div>
        <div class="tools">
            <a title="" data-original-title="" href="javascript:;" class="collapse"></a>
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResultFamilyInfo" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th>Hubungan</th>
                                <th>Nama</th>
                                <th>Tarikh Lahir</th>
                                <th>No. Kad Pengenalan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        @(string.IsNullOrEmpty(item.RelationshipType) ? "-" : item.RelationshipType)
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(item.Name) ? "-" : item.Name)
                                    </td>
                                    @if (item.DateOfBirth != null && item.DateOfBirth.HasValue)
                                    {
                                        <td>@item.DateOfBirth.Value.ToString("dd/MM/yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                    <td>@((string.IsNullOrEmpty(item.NewICNo)) ? " - " : item.NewICNo)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var tblResultFamilyInfo =
    $('#tblResultFamilyInfo').dataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSortable": false,
    });
</script>