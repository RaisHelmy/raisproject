@model ESS.Core.EmployeeDetailsSummary
@{
    String message = String.Format(@"Note: You are currently logged in as {0} - {1}, and you are currently NOT ALLOWED to view this employee's Asset Declaration details." + Environment.NewLine, 
                     Model.EmployeeCode, Model.EmployeeName);
}
<br />
<body>
    <div class="row">
        <div class="col-md-12">
            <div class="note note-danger">
                <h4 class="block">
                    Access Denied
                </h4>
                <p>
                    @Html.Raw(message)
                </p>
            </div>
        </div>
    </div>
</body>