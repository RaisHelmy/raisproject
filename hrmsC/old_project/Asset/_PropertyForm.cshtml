    }

    function PropertyForm_PropertyTypeOnchange() {
        if ('@Readonly' == "True") {
            return;
        }

        var selected = $('select[name="Property.PropertyTypeCode"]').val();

        if (selected == "WT") {
            $('select[name="Property.OwnershipDetails"]').val('EM');
            $('select[name="Property.OwnershipDetails"]').prop('disabled', true);
            $('input[name="Property.OwnershipDetails"]').prop('disabled', false);
            $('#PropertyType_HelpBlock').show();
        }
        else if (selected == "SY" || selected == "UA") {
            $('select[name="Property.OwnershipDetails"]').prop('disabled', false);
            $('input[name="Property.OwnershipDetails"]').prop('disabled', true);
            $('#PropertyType_HelpBlock').show();
        }
        else {
            $('select[name="Property.OwnershipDetails"]').prop('disabled', false);
            $('input[name="Property.OwnershipDetails"]').prop('disabled', true);
            $('#PropertyType_HelpBlock').hide();
        }
    }

    function PropertyForm_FundSourceOnChange() {
        var selected = $('select[name="Property.FundSourceTypeCode"').val();

        if (selected == "PI") {
            $('.Pinjaman').show();
            $('.Pelupusan').hide();
        }
        else if (selected == "PE") {
            $('.Pinjaman').hide();
            $('.Pelupusan').show();
        }
        else {
            $('.Pinjaman').hide();
            $('.Pelupusan').hide();
        }
    }
</script>