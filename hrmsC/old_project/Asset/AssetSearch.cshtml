@using Asset.Models
@model AssetSearchConfig

@{
    ViewBag.Title = "Asset Declaration List";
    string CurrentEmployeeID = ViewBag.CurrentEmployeeID;

    if (!String.IsNullOrEmpty(Model.Mode))
    {
        if (Model.Mode == "HOD")
        {
            ViewBag.Title = "Asset Declaration List (HOD)";
        }

        if (Model.Mode == "ICT")
        {
            ViewBag.Title = "Asset Declaration List (ICT)";
        }

        if (Model.Mode.Contains("GHR"))
        {
            ViewBag.Title = "Asset Declaration List (GHR)";
        }
    }
    else
    {
        Model.Mode = "";
    }
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title
            <span style="padding-left:20px;">
                <small>
                </small>
            </span>
        </h1>
    </div>
</div>
<br />

<form>
    <input type="hidden" name="Mode" value="@Model.Mode" />
    <input type="hidden" name="ModeParameter" value="@Model.ModeParameter" />
    <div class="form-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Company Code</label>
                        <div class="col-md-8 form-control-static">
                            <select id="ddlCompanyCode" class="form-control" name="CompanyCode">
                                <option value="">--  All --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Grade</label>
                        <div class="col-md-8 form-control-static">
                            <select id="ddlGrade" class="form-control" name="Grade">
                                <option value="">--  All --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Personnel Area</label>
                        <div class="col-md-8 form-control-static">
                            <select id="ddlPersonnelArea" class="form-control" name="PersonnelArea">
                                <option value="">--  All --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Personnel Subarea</label>
                        <div class="col-md-8 form-control-static">
                            <select id="ddlPersonnelSubarea" class="form-control" name="PersonnelSubarea">
                                <option value="">--  All --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Employee</label>
                        <div class="col-md-8 form-control-static">
                            @Html.Action("_PeoplePickerExt", "PeoplePicker",
                                                    new { CurrEmpID = CurrentEmployeeID, SearchType = "" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Declaration Status</label>
                        <div class="col-md-8 form-control-static">
                            <select id="ddlDeclarationStatus" class="form-control" name="DeclarationStatus">
                                <option value="">-- All --</option>
                                <option value="CO">Completed</option>
                                <option value="MA">Completed (Manual Form)</option>
                                <option value="NO">Incomplete</option>
                                <option value="PE">Pending</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">&nbsp;</div>
        <div class="row">
            <div class="col-md-12">
                <div class="text-right">
                    <input type="button" class="btn green btn-Search"
                           value="Search" onclick="SearchListing();">
                    @*<input type="button" class="btn default "
                           value="Clear" onclick="ClearFilter();">*@
                </div>
            </div>
        </div>
        <div class="row">&nbsp;</div>
        <div class="row">
            <div class="col-md-12">
                <div id="AssetDeclarationListSearchResult">
                </div>
            </div>
        </div>
    </div>
</form>

@Html.Partial("__Prompt")
<script>
    var OptionLink = '@Url.Action("_GetAssetSearchOptions", "Asset")';
    var ddlCompanyCode;
        var ddlGrade;
        var ddlPersonnelArea;
        var ddlPersonnelSubarea;
        var ddlDeclarationStatus;
    //var ddlCompanyCode = $('#ddlCompanyCode');

    $(function () {
        ddlCompanyCode = $('#ddlCompanyCode');
        ddlGrade = $('#ddlGrade');
        ddlPersonnelArea = $('#ddlPersonnelArea');
        ddlPersonnelSubarea = $('#ddlPersonnelSubarea');
        ddlDeclarationStatus = $('#ddlDeclarationStatus');

        InitCompanyCodeOptions();
        InitPayScaleGroupOptions();
        ddlCompanyCode.on('change', UpdateAreaCodeOption);
        ddlPersonnelArea.on('change', UpdateSubAreaCodeOption);
    });

    function InitPayScaleGroupOptions() {
        FillDropdown(ddlGrade,
            {
                OptionType: "Grade",
                CompanyCode: ddlCompanyCode.val() || "",
                AreaCode: ddlPersonnelArea.val() || "",
                SubAreaCode: ddlPersonnelSubarea.val() || "",
                Mode : '@Model.Mode'
            });
    }

    function InitCompanyCodeOptions() {
        FillDropdown(ddlCompanyCode,
        {
            OptionType: "CompanyCode",
            CompanyCode: ddlCompanyCode.val() || "",
            AreaCode: ddlPersonnelArea.val() || "",
            SubAreaCode: ddlPersonnelSubarea.val() || "",
            Mode : '@Model.Mode'
        });
    }

    function UpdateAreaCodeOption() {
        FillDropdown(ddlPersonnelArea,
            {
                OptionType: "PersonnelArea",
                CompanyCode: ddlCompanyCode.val() || "",
                AreaCode: ddlPersonnelArea.val() || "",
                SubAreaCode: ddlPersonnelSubarea.val() || "",
                Mode : '@Model.Mode'
            }, UpdateSubAreaCodeOption);
    }

    function UpdateSubAreaCodeOption() {
        FillDropdown(ddlPersonnelSubarea,
            {
                OptionType: "PersonnelSubarea",
                CompanyCode: ddlCompanyCode.val() || "",
                AreaCode: ddlPersonnelArea.val() || "",
                SubAreaCode: ddlPersonnelSubarea.val() || "",
                Mode : '@Model.Mode'
            });
    }

    function FillDropdown(ddl, option, callback) {
        $.get(OptionLink, option, function (result) {
            ddl.empty().append('<option value="">--  All --</option>');

            for (var i = 0; i < result.length; i++) {
                ddl.append('<option value="' + result[i].Code + '">' + result[i].Description + '</option>');
            }

            if (callback) {
                callback();
            }
        });
    }

    function SearchListing() {
        var option = $('form').serializeArray();

        ShowLoadingScreen();
        $.get('@Url.Action("_AssetSearchResult", "Asset")', option, function (result) {
            HideLoadingScreen();
            $('#AssetDeclarationListSearchResult').html(result);
        });
    }

    function ClearFilter() {

    }
</script>