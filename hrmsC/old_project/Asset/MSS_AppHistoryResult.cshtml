@model List<Asset.Models.ApproverHistoryItem>
@{
    Layout = null;
}
<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Perisytiharan Harta: My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Status</th>
                                <th>Submission Date</th>
                                <th>Action</th>
                                <th>Action Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("AssetDeclaration", "Asset", new { EmployeeID = item.EmployeeID })">
                                            @item.Employee
                                        </a>
                                    </td>
                                    <td>
                                        @item.SubmissionStatusName
                                    </td>
                                    <td>
                                        @item.SubmissionStatusDate
                                    </td>
                                    <td>
                                        @item.ActivityAction
                                    </td>
                                    <td>
                                        @item.CreatedDate
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var tblResult = $('#tblResult').DataTable({
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSort": false
    });
</script>