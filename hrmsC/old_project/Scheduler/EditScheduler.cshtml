@model ESS.Models.Scheduler

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Edit Scheduler";
    string strStartDate = DateTime.Today.AddDays(7).ToString("dd/MM/yyyy");
    string strEndDate = DateTime.Today.AddYears(5).ToString("dd/MM/yyyy");
    string[] ProcessType = { "IMPORT", "EXPORT" };
    string[] Active = { "True", "False" };
}

@using (Html.BeginForm("DeleteScheduler", "Scheduler", FormMethod.Post, new { @id = "DeleteSchedulerForm", @class = "form-horizontal" }))
{
    @Html.HiddenFor(model => model.ID)

    <div class="form-section">
        <div class="row">
            <div class="col-md-12">
                <h1 class="page-title">
                    Edit Scheduler
                    <span style="padding-left:20px;">
                        <small></small>
                    </span>
                </h1>
            </div>
        </div>
    </div>
    <div id="tab_1" class="tab-pane active">
        <div class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Scheduler Details
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body" id="ct01_CustomFieldFormView">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Name <span class="mandatory"> *</span></label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Description</label>
                                            <div class="col-md-10 form-control-static">
                                                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @rows = 5, @readonly = true })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Schedule Start<span class="mandatory"> *</span></label>
                                            <div class="col-md-8 form-control-static">
                                                @*<div class="input-group date form_datetime">*@
                                                @*@Html.EditorFor(m => m.ScheduleStart, new { htmlAttributes = new { @class = "form-control", @readonly = true } })*@
                                                @*<span class="input-group-btn">
                                                        <button class="btn default date-set" type="button">
                                                            <i class="fa fa-calendar"></i>
                                                        </button>
                                                    </span>*@
                                                @*</div>*@

                                                @{
    string ScheduleStart = Model.ScheduleStart.Value.ToString("yyyy MMMM dd hh:mm");

    @Html.EditorFor(m => ScheduleStart, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Schedule End<span class="mandatory"> *</span></label>
                                            <div class="col-md-8 form-control-static">
                                                @*<div class="input-group date form_datetime">*@
                                                @*@Html.EditorFor(m => m.ScheduleEnd, new { htmlAttributes = new { @class = "form-control", @readonly = true } })*@
                                                @*<span class="input-group-btn">
                                                        <button class="btn default date-set" type="button">
                                                            <i class="fa fa-calendar"></i>
                                                        </button>
                                                    </span>*@
                                                @*</div>*@

                                                @{
    string ScheduleEnd = Model.ScheduleEnd.Value.ToString("yyyy MMMM dd hh:mm");

    @Html.EditorFor(m => ScheduleEnd, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">SAP Table<span class="mandatory"> *</span></label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.SAP_Table, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">SEP Prd Table<span class="mandatory"> *</span></label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.SEP_PRDTable, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">SEP Stg Table<span class="mandatory"> *</span></label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.SEP_STGTable, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">SAP Fields<span class="mandatory"> *</span></label>
                                            <div class="col-md-10 form-control-static">
                                                @Html.TextAreaFor(m => m.SAP_Fields, new { @class = "form-control", @rows = 5, @readonly = true })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">SEP Fields<span class="mandatory"> *</span></label>
                                            <div class="col-md-10 form-control-static">
                                                @Html.TextAreaFor(m => m.SEP_Fields, new { @class = "form-control", @rows = 5, @readonly = true })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">SEP Query</label>
                                            <div class="col-md-10 form-control-static">
                                                @Html.TextAreaFor(m => m.SEP_Query, new { @class = "form-control", @rows = 5, @readonly = true })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">SAP Options</label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.SAP_Options, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">SAP Row Count</label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.SAP_RowCount, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">SEP File Name</label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.SEP_FileName, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Frequency<span class="mandatory"> *</span></label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.Frequency, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Process Type</label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.DropDownListFor(m => m.ProcessType, new SelectList(ProcessType), new { @class = "form-control", @disabled = true })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Process Sequence<span class="mandatory"> *</span></label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.EditorFor(m => m.ProcessSequence, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-4">Active</label>
                                            <div class="col-md-8 form-control-static">
                                                @Html.DropDownListFor(m => m.Active, new SelectList(Active), new { @class = "form-control", @disabled = true })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-actions fluid">
                            <div class="row">
                                <div class="col-md-6">
                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-offset-6 col-md-6">
                                        <a class="btn green" data-toggle="modal" href="#ConfirmDeleteScheduler">
                                            <i class="fa fa-pencil"></i>Delete
                                        </a>
                                        <a class="btn default" id="btnBack" onclick="javascript:location.href='@Url.Action("Schedulers", "Scheduler")'">
                                            Cancel
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal-->
    <div class="modal fade" id="ConfirmDeleteScheduler" tabindex="-1" role="basic" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title">Confirmation - Delete This Record</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        Clicking Confirm will delete this record from the database. If you want to discard the changes, click Close.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn default green" id="btnDelete">
                        <i class="fa fa-check"></i>
                        Confirm
                    </button>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Scripts -->
    <script type="text/javascript">
        function Validate(e) {
            var ValidationMsg = '';

            if ($("#Name").val() == '')
                ValidationMsg += '- Name  is required.\n';

            if ($("#ScheduleStart").val() == '')
                ValidationMsg += '- Schedule Start  is required.\n';

            if ($("#ScheduleEnd").val() == '')
                ValidationMsg += '- Schedule End  is required.\n';

            if ($("#SAP_Table").val() == '')
                ValidationMsg += '- SAP Table  is required.\n';

            if ($("#SEP_PRDTable").val() == '')
                ValidationMsg += '- SEP Prd Table  is required.\n';

            if ($("#SEP_STGTable").val() == '')
                ValidationMsg += '- SEP Stg Table  is required.\n';

            if ($("#SAP_Fields").val() == '')
                ValidationMsg += '- SAP Fields  is required.\n';

            if ($("#SEP_Fields").val() == '')
                ValidationMsg += '- SEP Fields  is required.\n';

            if ($("#Frequency").val() == '')
                ValidationMsg += '- Frequency  is required.\n';

            if ($("#ProcessSequence").val() == '')
                ValidationMsg += '- Process Sequence  is required.\n';

            // Consolidate Message
            if (ValidationMsg != null && ValidationMsg != '') {
                $(e).attr('href', function () {
                    return this.href = '';
                });
                alert(ValidationMsg);
            }
            else {
                $(e).attr('href', function () {
                    return this.href = '#ConfirmAddScheduler';
                });
            }

        }

        $(document).ready(function () {
            $('.form_datetime').datetimepicker({
                autoclose: true,
                isRTL: App.isRTL(),
                format: "yyyy MM dd hh:ii",
                pickerPosition: (App.isRTL() ? "bottom-right" : "bottom-left")
            });
        });
    </script>
}