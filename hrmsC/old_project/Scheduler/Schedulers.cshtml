@model List<ESS.Models.Scheduler>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Schedulers";
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Schedulers<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Schedulers
                        </div>
                        <a href="@Url.Content("~/Scheduler/NewScheduler")" id="btn-Edit" class="btn btn-xs green btn-Edit pull-right"><i class="fa fa-plus"></i>  Add New Scheduler</a>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">
                            <div class="form-horizontal">
                                <div class="table-toolbar">
                                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th>Name</th>
                                                <th>Process Type</th>
                                                <th>Process Sequence</th>
                                                <th>Frequency</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in @Model)
                                            {
                                                <tr>
                                                    <td>
                                                        <a class="btn blue btn-sm" href="@Url.Content("~/Scheduler/EditScheduler")?ID=@item.ID">
                                                            <i class="fa fa-search"></i>
                                                        </a>
                                                    </td>
                                                    <td>@item.Name</td>
                                                    <td>@item.ProcessType</td>
                                                    <td>@item.ProcessSequence</td>
                                                    <td>@item.Frequency</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");

    jQuery(document).ready(function () {

    });
</script>