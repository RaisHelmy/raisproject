@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Medical Board Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct01_CustomFieldFormView">
                    <div id="trRefNo" class="row" style="display:none;">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Reference No.</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="ct01_ReferenceNo" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Status</label>
                                    <div class="col-md-8 form-control-static">
                                        <input class="form-control" type="text" id="ct01_Status" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row" style="">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Employee Name <span id="lvEmpMan" style="color:red;display:none"> *</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <div id="divPeoplePicker">
                                            @Html.Action("_PeoplePickerExt", "PeoplePicker", new { CurrEmpID = ViewBag.EmployeeID, SearchType = "Subordinates" })
                                            @*PeoplePicker hiddenfieldid = hfEmpID, textboxid =txtEmpName*@
                                        </div>
                                        <div id="divApplicant" style="display:none">
                                            <input class="form-control" type="text" id="ct01_ApplicantName" readonly />
                                            <input class="form-control" type="hidden" id="ct01_ApplicantID" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="divCurrentApprover" class="col-md-6" style="display:none;">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Current Approver</label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="ct01_CurrentApprover" class="LabelDisplay"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="trAppDate" class="row" style="">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Appointment Date <span id="lvADMan" style="color:red;display:none"> *</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <div id="divAppointmentDate" class="input-group date date-picker" data-date-format="dd MM yyyy">
                                            <input type="text" class="form-control" id="ct01_AppointmentDate" name="AppointmentDate" />
                                            <span class="input-group-btn">
                                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                            </span>
                                        </div>
                                        <div id="divAppointmentDateRO" style="display:none">
                                            <input class="form-control" type="text" id="ct01_AppointmentDateRO" name="AppointmentDate" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div id="trLocation" class="row" style="">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-2">
                                        Location <span id="lvLocationMan" style="color:red;display:none"> *</span>
                                    </label>
                                    <div class="col-md-10 form-control-static">
                                        <textarea class="form-control" rows="3" style="width:100%;" id="ct01_Location" name="Location"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div id="trAttach" class="row" style="display: none">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Attachment <span id="lvAttachMan" style="color:red;"> *</span>
                                    </label>
                                    <div class="col-md-4  form-control-static">
                                        <input type="file" name="ct01_Attachment"
                                               id="ct01_Attachment" onchange="ConvertImageToBaseSixtyFour();" />
                                        <input type="hidden" name="FileContent" id="FileContent" />
                                        <input type="hidden" name="ct01_DocumentName" id="ct01_DocumentName" />
                                        <input type="hidden" name="ct01_DocumentSize" id="ct01_DocumentSize" />
                                        <input type="hidden" name="ct01_DocumentContentType" id="ct01_DocumentContentType" />
                                        <input type="hidden" name="ct01_DocumentDescription" id="ct01_DocumentDescription" />
                                        <label name="AttachmentTemplate" id="AttachmentTemplate" style="display:none;"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                            </div>
                        </div>
                    </div>
                    <div id="trAttachView" class="row" style="display:none;">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Attachment
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" id="AttachmentID" />
                                        <a id="AttachmentDownload" onclick="DownloadAttachment();"></a>
                                        <a id="AttachmentRemove" onclick="RemoveAttachment();" style="display:none;">[Remove]</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                        </div>
                    </div>

                    <div id="hdValue">
                        <input type="hidden" name="EmployeeID" id="ct01_EmployeeID" />
                        <input type="hidden" name="CreatedBy" id="ct01_CreatedBy" />
                        <input type="hidden" name="DetailsID" id="ct01_DetailsID" />
                        <input type="hidden" name="AttachmentMandatory" id="AttachmentMandatory" value="true" />
                        <input type="hidden" name="CommentMandatory" id="CommentMandatory" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>