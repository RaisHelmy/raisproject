
@{
    Layout = null;
}

<div id="EmployeeDetails" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Employee Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Number
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="ct00_EmployeeCodeRO"></label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="ct00_EmployeeNameRO"></label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        New IC Number
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <label id="ct00_NewICRO"></label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Pay Scale Group
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_PayScaleGroupRO"></label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Cost Center
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_CostCenterRO"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Joined Date
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_JoinedDateRO"></label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Department
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_DepartmentRO"></label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Unit / Section
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_UnitSectionRO"></label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Position
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_PositionRO"></label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Manager
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        <label id="ct00_ManagerRO"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="hdEmpInfo">
                        <input type="hidden" name="PayScaleGroup" id="ct00_PayScaleGroup" />
                        <input type="hidden" name="CostCenterCode" id="ct00_CostCenterCode" />
                        <input type="hidden" name="CostCenterName" id="ct00_CostCenterName" />
                        <input type="hidden" name="CompanyCode" id="ct00_CompanyCode" />
                        <input type="hidden" name="CompanyName" id="ct00_CompanyName" />
                        <input type="hidden" name="AreaCode" id="ct00_AreaCode" />
                        <input type="hidden" name="AreaName" id="ct00_AreaName" />
                        <input type="hidden" name="SubAreaCode" id="ct00_SubAreaCode" />
                        <input type="hidden" name="SubAreaName" id="ct00_SubAreaName" />
                        <input type="hidden" name="PositionCode" id="ct00_PositionCode" />
                        <input type="hidden" name="PositionName" id="ct00_PositionName" />
                        <input type="hidden" name="ManagerID" id="ct00_ManagerID" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
