@model List<ESS.MedicalBoard.Models.MedicalBoardList>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Listing
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Employee</th>
                                <th>Submission Date</th>
                                <th>Letter Date to Hospital</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                            <tr>
                                <td>
                                    <a class="btn blue btn-sm" href="@Url.Content("~/MedicalBoard/ListForm")?MedicalBoardID=@item.MedicalBoardID">
                                        <i class="fa fa-search"></i>
                                    </a>
                                </td>
                                <td>@item.EmployeeCode - @item.EmployeeName</td>
                                <td>@item.SubmissionDate.ToString("dd-MM-yyyy")</td>

                                @if (@item.LetterDateToHospital.HasValue)
                                {
                                    <td>@item.LetterDateToHospital.Value.ToString("dd-MM-yyyy")</td>
                                }
                                else
                                {
                                    <td>-</td>
                                }

                                <td style="color:green;"><b>@item.Status</b></td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>