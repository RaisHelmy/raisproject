@model List<ESS.MedicalBoard.Models.MedicalBoardReport>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Medical Board Report
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee Number</th>
                                <th>Employee Name</th>
                                <th>Pay Scale Group</th>
                                <th>Age</th>
                                <th>Cost Center</th>
                                <th>Company Code</th>
                                <th>Company Name</th>
                                <th>Division Code</th>
                                <th>Division Name</th>
                                <th>Join Date</th>
                                <th>Submission Date</th>
                                <th>Verified Date</th>
                                <th>Letter Date to Hospital</th>
                                <th>Days</th>
                                <th>TypeOfDisease</th>
                                <th>Hospital</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                            <tr>
                                <td>
                                    <a class="btn blue btn-sm" href="@Url.Content("~/MedicalBoard/Index")?MedicalBoardID=@item.MedicalBoardID&Source=Report">
                                        <i class="fa fa-search"></i>
                                    </a>
                                </td>
                                <td>@item.ReferenceNo</td>
                                <td>@item.EmployeeCode</td>
                                <td>@item.EmployeeName</td>
                                <td>@item.PayScaleGroup</td>
                                <td>@item.Age</td>
                                <td>@item.CostCenterCode @item.CostCenterName</td>
                                <td>@item.CompanyCode</td>
                                <td>@item.CompanyName</td>
                                <td>@item.DivisionCode</td>
                                <td>@item.DivisionName</td>
                                <td>@item.JoinDate.ToString("dd-MM-yyyy")</td>
                                <td>@item.SubmissionDate.ToString("dd-MM-yyyy")</td>

                                @if (@item.VerifiedDate.HasValue)
                                {
                                    <td>@item.VerifiedDate.Value.ToString("dd-MM-yyyy")</td>
                                }
                                else
                                {
                                    <td>-</td>
                                }

                                @if (@item.LetterDateToHospital.HasValue)
                                {
                                    <td>@item.LetterDateToHospital.Value.ToString("dd-MM-yyyy")</td>
                                }
                                else
                                {
                                    <td>-</td>
                                }

                                <td>@item.Days</td>
                                <td>@item.TypeOfDisease</td>
                                <td>@item.Hospital</td>

                                @if (@item.Status == "Declined" || @item.Status == "Withdrawn")
                                {
                                    <td style="color:red;"><b>@item.Status</b></td>
                                }
                                else
                                {
                                    <td style="color:green;"><b>@item.Status</b></td>
                                }
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>