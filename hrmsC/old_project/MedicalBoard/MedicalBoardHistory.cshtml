
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Medical Board History";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Medical Board History<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option value="">- All -</option>
                            <option value="Pending">Pending</option>
                            <option value="Verified">Verified</option>
                            <option value="Reworked">Reworked</option>
                            <option value="MB Arranged">MB Arranged</option>
                            <option value="MB Attended">MB Attended</option>
                            <option value="Fit To Work">Fit To Work</option>
                            <option value="Unfit To Work">Unfit To Work</option>
                            <option value="Declined">Declined</option>
                            <option value="Admin Verified">Admin Verified</option>
                            <option value="Returned">Returned</option>
                            <option value="Admin Agreed">Admin Agreed</option>
                            <option value="Admin Disagreed">Admin Disagreed</option>
                            <option value="Admin Approved">Admin Approved</option>
                            <option value="Admin Reworked">Admin Reworked</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function SearchListing() {
        var _DateFrom = $('#SubDateFrom').val();
        var _DateTo = $('#SubDateTo').val();
        var _Status = $('#Status').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/MedicalBoard/_MedicalBoardHistoryResult")',
            cache: false,
            dataType: "html",
            data: { DateFrom: _DateFrom, DateTo: _DateTo,Status: _Status },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        });

        SearchListing();
    });


    function ClearFilter() {
        $('#SubDateFrom').val('');
        $('#SubDateTo').val('');
        $('#Status').val('');
        SearchListing();
    }
</script>

