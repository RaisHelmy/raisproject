@model ESS.DeathDonation.Models.IntrayDto.ResponseIntray
@{
    Layout = null;
}


    <div class="portlet box blue">
        <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
        <div class="portlet-title">
            <div class="caption">
                <i class="fa fa-reorder"></i>My In-tray
            </div>
        </div>
        <div class="portlet-body form">
            <div class="form-body">
                <div class="form-horizontal">
                    <div class="table-toolbar">
                        @if (Model.result)
                        {
                            <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Reference No.</th>
                                        <th>Employee</th>
                                        <th>Status</th>
                                        <th>Submission Date</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model.intrayInfos)
                                    {
                                    <tr>
                                        <td>
                                            <a class="btn blue btn-sm" href="@Url.Action("Application", "DeathDonation", new { id = item.deathDonationId })">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        </td>
                                        <td>@item.referenceNo</td>
                                        <td>@item.deceasedEmployeeCode - @item.deceasedEmployeeName</td>
                                        @if (item.status == ESS.DeathDonation.Constants.StatusConstants.STATUS_WITHDRAW ||
                                                item.status == ESS.DeathDonation.Constants.StatusConstants.STATUS_DECLINED ||
                                                item.status == ESS.DeathDonation.Constants.StatusConstants.STATUS_PENDING)
                                        {
                                            <td style="color:red;"><b>@item.status</b></td>
                                        }
                                        else
                                        {
                                            <td style="color:green;"><b>@item.status</b></td>
                                        }
                                        <td>@item.createdDate.ToString("dd/MM/yyyy")</td>

                                    </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <span>@Model.errorMessage</span>
                        }
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
<script>
    transformTable("#tblResult");
</script>