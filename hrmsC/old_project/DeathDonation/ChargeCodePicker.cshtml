@model Tuple<string, string>

@{
    Layout = null;
    string employeeId = Model.Item1;
    string chargeCodeType = Model.Item2;



    string chargeTypeName = "ChargeType";
    string chargeCodeName = "ChargeCode";
    string chargeCodeDescName = "ChargeCodeDesc";

    string chargeType = "";
    string chargeCode = "";
    string chargeCodeDesc = "";
    string chargeCodeDisplayText = "";


}

<div>
    <div class="input-group">
        <input type="text" class="form-control ChargeCodePickerName" value="@chargeCodeDisplayText" readonly id="ChargeCodePickerName"/>
        <span class="input-group-btn" style="">
            <a data-toggle="modal" href="#SearchChargeCode" class="btn default TimesheetChargeCodePicker" onclick="SearchChargeCode()"><i class="fa fa-list-alt"></i></a>
        </span>
        <input class="ChargeCodePickerType" type="hidden" id="ChargeCodePickerType" name="@chargeTypeName" value="@chargeType"/>
        <input class="ChargeCodePickerCC" type="hidden" id="ChargeCodePickerCC" name="@chargeCodeName" value="@chargeCode"/>
        <input class="ChargeCodePickerDesc" type="hidden" id="ChargeCodePickerDesc" name="@chargeCodeDescName" value="@chargeCodeDesc"/>
    </div>
</div>