@model List<ESS.Core.PeoplePickerObject>
@{
    Layout = null;
}
<div class="table-toolbar">
    <table id="tblPeerPicker" class="table table-striped table-bordered table-hover table-full-width">
        <thead>
            <tr>
                <th></th>
                <th>Employee Number</th>
                <th>Employee Name</th>
                <th>Department</th>
                <th>Unit/Section</th>
                <th>Position</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in @Model)
            {
                <tr>
                    <td><input type="checkbox" class="MultiPeoplePickerCheckbox" value="@item.EmployeeID" empname="@item.EmployeeName" empcode="@item.EmployeeCode" /></td>
                    <td class="EmployeeCode">@item.EmployeeCode</td>
                    <td class="EmployeeName">@item.EmployeeName</td>
                    <td class="Department">@item.Department</td>
                    <td class="UnitSection">@item.UnitSection</td>
                    <td class="Position">@item.Position</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    var tblPeerPicker = null;

    $(function () {
        tblPeerPicker = $('#tblPeerPicker').dataTable()
        $('input[type="checkbox"]').uniform();
    });
</script>
