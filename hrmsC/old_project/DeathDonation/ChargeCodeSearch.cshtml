@{
    Layout = "";
}

<div class="form-body">
    <div class="row">
        <div class="col-md-2">

            @Html.Label("Search Type :", new { @class = "control-label" })
        </div>
        <div class="col-md-4">
            <select id="chargecodesearchtype" class="form-control" onchange="toggleCCFavouriteBtn()">
                <option selected="selected" value="ALL">All</option>
                <option value="Favourite">Favourite</option>
            </select>
        </div>
        <div class="col-md-4">


        </div>
    </div>
    <div id="chargecoderow">
        <div class="row" style="margin-top:10px">
            <div class="col-md-2">

                @Html.Label("Charge Type :", new { @class = "control-label" })
            </div>
            <div class="col-md-4">
                <select id="chargecodedll" class="form-control">
                    <option selected="selected" value="ALL">All</option>
                    <option value="CC">Cost Center</option>
                    <option value="PM">Order Number (Plant Maintenance)</option>
                    <option value="JO">Order Number (Job Order)</option>
                    <option value="WB">WBS Element</option>
                    <option value="NT">Network Number And Operation Activity Number</option>
                    <option value="DI">DIC</option>
                </select>
            </div>
            <div class="col-md-4">


            </div>
        </div>
        <div class="row" style="margin-top:10px">
            <div class="col-md-2">
                @Html.Label("Search :", new { @class = "control-label" })
            </div>
            <div class="col-md-4">
                <input type="text" id="chargecodevalue" class="form-control" />
            </div>
            <div class="col-md-4">
                <a class="btn green" href="javascript:SearchChargeCode()">
                    Search
                </a>

            </div>
        </div>
    </div>
    <div id="favoriterow" class="row" style="display:none;margin-top:10px">
        <div class="col-md-2">
            @Html.Label("Favorite Group :", new { @class = "control-label" })
        </div>
        <div class="col-md-4">
            <select name="favGroup" id="favGroup" class="form-control"></select>
        </div>
        <div class="col-md-4">
            <a class="btn green" href="javascript:SearchFavGroupChargeCode()">
                Search
            </a>
        </div>
    </div>

    <hr />

    <input type="hidden" name="SourceID" value="@ViewBag.SourceID" />
    <div class="row" style="margin-top:10px;">
        <div class="col-md-12">
            <div id="ChargeCodeResult">
                @Html.Action("_ChargeCodeSearchResult", "DeathDonation", new { Type = "", Value = "" })
            </div>
        </div>
    </div>


</div>
@*</div>
    </div>*@
<script>



    //$("#chargecodesearchtype").change(function () {
