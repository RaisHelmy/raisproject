@model ESS.Core.EmployeeDetailsSummary
@{
    ViewBag.Title = "Admin Page";
}

<div class="row">
    <div class="col-md-12">
        <div class="note note-success">
            <h1 class="block">You are : @Model.EmployeeCode - @Model.EmployeeName</h1>
        </div>
    </div>
</div>

<form method="post">
    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue" id="tempLogin">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>Login As
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="form-horizontal">
                            <input type="text" class="form-control" name="userDetail" />
                            <input type="submit" class="btn blue" style="margin-top: 10px;" value="Go" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>