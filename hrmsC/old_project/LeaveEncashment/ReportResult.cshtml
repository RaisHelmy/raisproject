@using LeaveApplication.Models
@model IEnumerable<LeaveEncashmentGridVM>
@{

}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Leave Encashment Report
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel">
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No</th>
                                <th>Employee</th>
                                <th>Division</th>
                                <th>Submission Date</th>
                                <th>HR Received Date</th>
                                <th>Approval Date</th>
                                <th>Requested Days</th>
                                <th>Approved Days</th>
                                <th>Retirement Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                            <tr>
                                <td>
                                    <a class="btn blue btn-sm"
                                       href="@Url.Action("Index", "LeaveEncashment", new { EncashmentID = item.EncashmentID , Source = "History" })">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                </td>
                                <td>@item.ReferenceNo</td>
                                <td>@item.EmployeeCode - @item.EmployeeName</td>
                                <th>@item.DivisionCode - @item.DivisionName</th>
                                <td>
                                    @{
                                        @item.FormattedSubmissionDate
                                    }
                                </td>
                                <td>
                                    @(item.ReceiveDate.HasValue ? item.ReceiveDate.Value.ToString("dd/MM/yyyy hh:mm tt") : " - ")
                                </td>
                                <td>
                                    @(item.ApprovalDate.HasValue ? item.ApprovalDate.Value.ToString("dd/MM/yyyy hh:mm tt") : " - ")
                                </td>
                                <td>
                                    @item.RequestedDays
                                </td>
                                <td>
                                    @item.ApprovedDays
                                </td>
                                <td>
                                    @{
                                        double approvedDays = (double) (item.ApprovedDays.HasValue ? item.ApprovedDays.Value : 0);
                                        @(item.RetirementDate.HasValue ? item.RetirementDate.Value.AddDays(-approvedDays).ToString("dd/MM/yyyy") : " - ")
                                    }

                                </td>
                                <td>
                                    @if (item.Status == "WD" || item.Status == "DE")
                                    {
                                        <span style="color : red; font-weight: bold;">
                                            @item.StatusName
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color : green; font-weight: bold;">
                                            @item.StatusName
                                        </span>
                                    }
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<table id="tblExport" border="1" style="display: none;">
    <thead>
        <tr>
            <th>Reference No</th>
            <th>Employee</th>
            <th>Division</th>
            <th>Submission Date</th>
            <th>HR Received Date</th>
            <th>Approval Date</th>
            <th>Requested Days</th>
            <th>Approved Days</th>
            <th>Retirement Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ReferenceNo</td>
                <td>@item.EmployeeCode - @item.EmployeeName</td>
                <td>@item.DivisionCode - @item.DivisionName</td>
                <td>
                    @{
                        @item.FormattedSubmissionDate
                    }
                </td>
                <td>
                    @(item.ReceiveDate.HasValue ? item.ReceiveDate.Value.ToString("dd/MM/yyyy hh:mm tt") : " - ")
                </td>
                <td>
                    @(item.ApprovalDate.HasValue ? item.ApprovalDate.Value.ToString("dd/MM/yyyy hh:mm tt") : " - ")
                </td>
                <td>
                    @item.RequestedDays
                </td>
                <td>
                    @item.ApprovedDays
                </td>
                <td>
                    @{
                        double approvedDays = (double)(item.ApprovedDays.HasValue ? item.ApprovedDays.Value : 0);
                        @(item.RetirementDate.HasValue ? item.RetirementDate.Value.AddDays(-approvedDays).ToString("dd/MM/yyyy") : " - ")
                    }

                </td>
                <td>
                    @if (item.Status == "WD" || item.Status == "DE")
                    {
                        <span style="color : red; font-weight: bold;">
                            @item.StatusName
                        </span>
                    }
                    else
                    {
                        <span style="color : green; font-weight: bold;">
                            @item.StatusName
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    transformTable("#tblResult");

    $(function () {
        BindExport();
    });
</script>