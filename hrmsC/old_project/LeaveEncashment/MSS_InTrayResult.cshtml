@model List<SEP.RoutingManagement.Models.GetMyIntray>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>SubmissionDate</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Action("Index", "LeaveEncashment", new { EncashmentID = item.SourceID, Source = "InTray" })">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.ApplicantCode - @item.ApplicantName</td>
                                    <td>@item.DisplayText6</td>
                                    @{
                                        if (item.DisplayText4 == "Returned" || item.DisplayText4 == "Declined" || item.DisplayText4 == "Withdrawn")
                                        {
                                            <td style="color:red;"><b>@item.DisplayText4</b></td>
                                        }
                                        else
                                        {
                                            <td style="color:green;"><b>@item.DisplayText4</b></td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>