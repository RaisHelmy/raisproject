@model List<SEP.RoutingManagement.Models.GetMyApprovalHistory>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My In-Tray
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Action Date</th>
                                <th>Approver Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Action("Index", "LeaveEncashment", new { EncashmentID = item.SourceID, Source = "ApprovalHistory" })">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    </td>
                                    <td>@item.ApplicationRefNo</td>
                                    <td>@item.ApplicantCode - @item.ApplicantName</td>
                                    <td>
                                        @if (item.ActionDate.HasValue)
                                        {
                                            @item.ActionDate.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            @("-")
                                        }
                                    </td>

                                    @if (item.ApproverAction == "Reject")
                                    {
                                        <td style="color:red;"><b>@item.ApproverAction</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.ApproverAction</b></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>