@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Loan Application Form";
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Loan Application
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>

<input id="hfFileSize" type="hidden" value="@ViewBag.MaximumFileSize" />
<input id="hfFileExtension" type="hidden" value="@ViewBag.AllowedFileTypes" />
<input id="hfEmployeeID" type="hidden" value="@ViewBag.EmployeeID" />
@Html.Raw(File.ReadAllText(Server.MapPath("../Static/LoanManagement.html")))
