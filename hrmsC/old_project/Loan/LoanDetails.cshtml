@model ESS.Core.FormEngineObject

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Loan Details";
}

<div class="form-section">
    <div class="row">
        <div class="col-md-12">
            <h1 class="page-title">
                Loan Details
                <span style="padding-left:20px;">
                    <small></small>
                </span>
            </h1>
        </div>
    </div>
</div>
@* Current Employee *@
<input id="hfEmployeeID" type="hidden" value="@ViewBag.EmployeeID" />

<input id="hfApproverFileSize" type="hidden" value="@ViewBag.MaximumFileSize" />
<input id="hfApproverFileExtension" type="hidden" value="@ViewBag.AllowedFileTypes" />
<div class="HtmlBody">
    @Html.Raw(Model.HtmlBody)
</div>


<script>

    $('#tblAuditLog').dataTable(
    {
        "bLengthChange": false,
        "bFilter": false,
        "bPaginate": false,
        "bInfo": false,
        "bSortable": false,
        "aaSorting": [[1, 'asc']],

    });
</script>