@*@Html.Action("AttachmentControl", "Attachment", new { EmployeeID = ViewBag.EmployeeID, Mode = "New", SourceType = "Employee", ShowOptionField = "true", ControlType = "dropdown", CustomTextLabel1 = "Field", Mandatory = true, DropdownList = ViewBag.GetFieldAttachment })*@
@{
	Layout = null;
	string _EmployeeID = ViewBag.EmployeeID;
	string _Mode = ViewBag.Mode;
	string _SourceType = ViewBag.SourceType;
	string _RequestID = ViewBag.RequestID;
	string _SessionName = ViewBag.SessionName;

	string _CustomTextLabel1 = ViewBag.CustomTextLabel1;
	string _ControlType = ViewBag.ControlType;
	string _Mandatory = ViewBag.Mandatory;
	string _ShowOptionField = ViewBag.ShowOptionField;
	string _ShowDescriptionField = ViewBag.ShowDescriptionField;
	string _DescriptionValue = ViewBag.DescriptionValue + "";

	var _Path = string.Format("{0}://{1}{2}", Request.Url.Scheme, Request.Url.Authority, Url.Content("~"));

	//for dropdown list custom text
	List<SelectListItem> _dropdownItems = ViewBag.DropdownList;
	if (_dropdownItems != null && _dropdownItems.Count > 0)
	{
		_dropdownItems.First().Selected = true;
	}

	string spanRequired = "hidden";

	if (String.Equals(_Mandatory, "TRUE", StringComparison.OrdinalIgnoreCase))
	{
		spanRequired = "";
	}

	bool chkShowOptionField = false;
	bool.TryParse(_ShowOptionField, out chkShowOptionField);

	bool chkShowDescriptionField = false;
	bool.TryParse(_ShowDescriptionField, out chkShowDescriptionField);

	string hiddenDescriptionField = "hidden";
	if (chkShowDescriptionField)
	{
		hiddenDescriptionField = "";
	}
}

<div id="_AttachmentControl" class="row">
	<div class="col-md-12">
		<div class="portlet box blue">
			<div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
			<div class="portlet-title">
				<div class="caption">
					<i class="fa fa-reorder"></i>Attachment
				</div>
			</div>
			<div class="portlet-body form">
				<div class="form-body">
					<div class="form-horizontal">
						<div id="_divAddAttach" style="display:block">
							<div class="form-group">
								<label class="control-label col-md-3">Attachment</label>
								<div class="col-md-5">
									<div class="input-group">
										<input type="file" name="FN_Attachment" id="FN_Attachment" />@*onchange="_ConvertImageToBaseSixtyFour();"*@
									</div>
								</div>
							</div>
							<br />

							@if (chkShowOptionField)
							{
								if (_ControlType == "datepicker")
								{
									<div class="form-group">
										<label class="control-label col-md-3" id="_CustomTextLabel1">
											@_CustomTextLabel1
											<span class="required @spanRequired">*</span>
										</label>
										<div class="col-md-5 form-control-static">
											<div class="input-group date _Customdate-picker" data-date-format="dd MM yyyy">
												<input type="text" class="form-control" id="_CustomTextValue1" />
												<span class="input-group-btn">
													<button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
												</span>
											</div>
										</div>
									</div>
								}

								if (_ControlType == "textbox")
								{
									<div class="form-group">
										<label class="control-label col-md-3" id="_CustomTextLabel1">
											@_CustomTextLabel1
											<span class="required @spanRequired">*</span>
										</label>
										<div class="col-md-5 form-control-static">
											<input type="text" class="form-control" id="_CustomTextValue1" />
										</div>
									</div>
								}
								if (_ControlType == "dropdown")
								{
									<div class="form-group hidden divAttachmentRequired">
										<label class="control-label col-md-3" id="_CustomTextLabel1">
											Supporting Document Required
											<span class="required @spanRequired">*</span>
										</label>
										<div class="col-md-5 form-control-static DocumentsRequired">
											@*@if (_dropdownItems != null)
											{
												foreach (var item in _dropdownItems.Skip(1))
												{
													<label type="text">- @item.Text</label>
													<br />
												}
											}*@
										</div>
									</div>
									<br />
									<div class="form-group">
										<label class="control-label col-md-3" id="_CustomTextLabel1">
											@_CustomTextLabel1
											<span class="required @spanRequired">*</span>
										</label>

										<div class="col-md-5 form-control-static">
											<select id="_CustomTextValue1" class="form-control">
												@if (_dropdownItems != null)
												{
													foreach (SelectListItem item in _dropdownItems)
													{
														<option value="@item.Value">@item.Text</option>
													}
												}
											</select>
										</div>
									</div>
								}
								<br />
							}

							<div class="form-group @hiddenDescriptionField">
								<label class="control-label col-md-3">Attachment Description</label>
								<div class="col-md-8">
									<textarea class="form-control" rows="2" style="width:100%;" id="_AttachDescription">@_DescriptionValue</textarea>
								</div>
							</div>
							<br />

							<div class="form-group">
								<div class="col-md-3"></div>
								<div class="col-md-8">
									<span class="input-group-btn">
										<button id="_btnAttach" class="btn default" type="button" onclick="_FileValidation()">Attach</button>
									</span>
								</div>
							</div>
							<br />
							<div class="hidden" id="_AttachmentHidden">
								<input id="_hfFileSize" type="text" value="@ViewBag.MaximumFileSize" />
								<input id="_hfFileExtension" type="text" value="@ViewBag.AllowedFileTypes" />
								<input type="text" name="_FileContents" id="_FileContents" />
								<input type="text" name="_DocumentName" id="_DocumentName" />
								<input type="text" name="_DocumentSize" id="_DocumentSize" />
								<input type="text" name="_DocumentContentType" id="_DocumentContentType" />
								<input type="text" name="_DocumentDescription" id="_DocumentDescription" />
								<input type="text" name="_AttachEmployeeID" id="_AttachEmployeeID" value="@_EmployeeID" />
								<input type="text" name="_SourceType" id="_SourceType" value="@_SourceType" />
								<input type="text" name="_RequestID" id="_RequestID" value="@_RequestID" />
								<input type="text" name="_Mode" id="_Mode" value="@_Mode" />
								<input type="text" name="_ID" id="_ID" value="@Guid.NewGuid().ToString()" />
								<input type="text" name="SessionName" id="_SessionName" value="@ViewBag.SessionName" />
							</div>

						</div>
						<div id="_AttachmentListing">

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script type="text/javascript">

    var attach = "";
    //Page Load
    $(document).ready(function () {
        var _Mode = '@_Mode';
        _GetAttachmentList();
        if (_Mode == 'View') {
            document.getElementById('_divAddAttach').style.display = 'none';
        }

        $('._Customdate-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
        });
    });

    // helper function
    function _guid() {
        function s4() {
            return Math.floor((1 + Math.random()) * 0x10000)
              .toString(16)
              .substring(1);
        }
        return s4() + s4() + '-' + s4() + '-' + s4() + '-' +
          s4() + '-' + s4() + s4() + s4();
    }

    function _ConvertImageToBaseSixtyFour() {
        var _AllowedMaxSize = parseFloat(document.getElementById('_hfFileSize').value) || 0;
        var _AllowedExtensions = document.getElementById('_hfFileExtension').value;
        var _selectedFile = document.getElementById('FN_Attachment').files;

        if (_selectedFile.length > 0) {
            var _fileToLoad = _selectedFile[0];

            var _fileReader = new FileReader();

            _fileReader.onload = function (fileLoadedEvent) {
                var _ValidFile = false;
                var _documentName = $('#FN_Attachment')[0].files[0].name;
                var _documentSize = $('#FN_Attachment')[0].files[0].size;
                var _fileExtension = _documentName.substring(_documentName.lastIndexOf('.') + 1).toLowerCase();
                alert(_documentSize + "");
                if (_AllowedExtensions.indexOf(_fileExtension) > -1) {
                    var _docSize = parseFloat(_documentSize) || 0;
                    if (_docSize > _AllowedMaxSize) {
                        document.getElementById('FN_Attachment').value = '';
                        alert('- File size has exceeded the allowed limit of ' + _AllowedMaxSize + ' bit');
                    }
                    else {
                        _ValidFile = true;
                    }
                }
                else {
                    document.getElementById('FN_Attachment').value = '';
                    alert('- Invalid file type. Only files of the following extensions are allowed (' + _AllowedExtensions + ')');
                }

                if (_ValidFile) {
                    var _fileContents = document.getElementById("_FileContents");
                    _fileContents.value = fileLoadedEvent.target.result;
                    var _documentContentType = _fileContents.value.split(",")[0].split(":")[1].split(";")[0];
                    document.getElementById('_DocumentName').value = _documentName;
                    document.getElementById('_DocumentSize').value = _documentSize;
                    document.getElementById('_DocumentContentType').value = _documentContentType;
                    //console.log(_fileContents.value + "====" + _documentName + "====" + _documentSize);
                }
            };

            _fileReader.readAsDataURL(_fileToLoad);
        }
    }


    function _EL(id) { return document.getElementById(id); } // Get el by ID helper function

    function _readFile() {
        var _AllowedMaxSize = parseFloat(document.getElementById('_hfFileSize').value) || 0;//'1572864';//
        var _AllowedExtensions = document.getElementById('_hfFileExtension').value;

        if (this.files && this.files[0]) {
            var FR = new FileReader();

            FR.onload = function (e) {
                var _ValidFile = false;
                var _documentName = $('#FN_Attachment')[0].files[0].name;
                var _documentSize = $('#FN_Attachment')[0].files[0].size;
                var _fileExtension = _documentName.substring(_documentName.lastIndexOf('.') + 1).toLowerCase();

                if (_AllowedExtensions.indexOf(_fileExtension) > -1) {
                    var _docSize = parseFloat(_documentSize) || 0;
                    if (_docSize > parseFloat(_AllowedMaxSize)) {
                        document.getElementById('FN_Attachment').value = '';
                        alert('- File size has exceeded the allowed limit of ' + _AllowedMaxSize + ' byte');
                    }
                    else {
                        _ValidFile = true;
                    }
                }
                else {
                    document.getElementById('FN_Attachment').value = '';
                    alert('- Invalid file type. Only files of the following extensions are allowed (' + _AllowedExtensions + ')');
                }

                if (_ValidFile) {
                    var _fileContents = document.getElementById("_FileContents");
                    _fileContents.value = e.target.result;
                    attach = e.target.result;
                    //console.log(attach);
                    var _documentContentType = _fileContents.value.split(",")[0].split(":")[1].split(";")[0];

                    document.getElementById('_DocumentName').value = _documentName;
                    document.getElementById('_DocumentSize').value = _documentSize;
                    document.getElementById('_DocumentContentType').value = _documentContentType;
                    //console.log(_fileContents.value + "====" + documentName + "====" + documentSize);
                }
                // console.log(e.target.result);
            };
            FR.readAsDataURL(this.files[0]);
        }
    }

    _EL("FN_Attachment").addEventListener("change", _readFile, false);


    function _getBase64Image(img) {
        // Create an empty canvas element
        var canvas = document.createElement("_canvas");
        canvas.width = img.width;
        canvas.height = img.height;

        // Copy the image contents to the canvas
        var ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0);

        // Get the data-URL formatted image
        // Firefox supports PNG and JPEG. You could check img.src to guess the
        // original format, but be aware the using "image/jpg" will re-encode the image.
        var dataURL = canvas.toDataURL("image/png");

        return dataURL.replace(/^data:image\/(png|jpg);base64,/, "");
    }



    function _FileValidation() {
        var ValidationMsg = '';
        var _selectedFile = document.getElementById('FN_Attachment').value;

        if (_selectedFile == '') {
            ValidationMsg += '- Please Select a file to upload.\n'
        }

        else {

            var CustomField = document.getElementById('_CustomTextValue1');

            if (CustomField !== null) {
                var _Mandatory = '@_Mandatory';
                var _CustomTextValue1 = document.getElementById('_CustomTextValue1').value;
                if (_Mandatory == 'true' && _CustomTextValue1 == '') {
                    ValidationMsg += '- ' + '@_CustomTextLabel1' + ' is required.\n'
                }
            }

        }

        // Consolidate Message
        if (ValidationMsg != null && ValidationMsg != '') {
            alert(ValidationMsg);
        }
        else {
            _UploadAttachmentToSession();
        }

    }

    // Attach to Session
    function _UploadAttachmentToSession() {
        var Description = document.getElementById('_AttachDescription').value;
        var _ID = document.getElementById('_ID').value;
        var _FileContents = attach;
        var _DocumentName = document.getElementById('_DocumentName').value;
        var _DocumentSize = document.getElementById('_DocumentSize').value;
        var _DocumentContentType = document.getElementById('_DocumentContentType').value;
        var _DocumentDescription = Description;
        var _AttachEmployeeID = document.getElementById('_AttachEmployeeID').value;
        var _SourceType = document.getElementById('_SourceType').value;
        var _RequestID = document.getElementById('_RequestID').value;
        var _Mode = document.getElementById('_Mode').value;
        var _CreatedDate = '@DateTime.Now';
        var _CustomTextValue1 = '';
        var _CustomTextLabel1 = '';
        var _ControlType1 = '';

        var CustomField = document.getElementById('_CustomTextValue1');

        if (CustomField !== null) {
            _CustomTextValue1 = document.getElementById('_CustomTextValue1').value;
            _CustomTextLabel1 = document.getElementById('_CustomTextLabel1').innerHTML;
            _ControlType1 = '@_ControlType';
        }


        if (_RequestID != "" && _Mode == "Add") {
            _RequestID = "";
        }

        var form = {
            ID: _ID,
            FileContents: _FileContents,
            DocumentName: _DocumentName,
            DocumentSize: _DocumentSize,
            DocumentContentType: _DocumentContentType,
            DocumentDescription: _DocumentDescription,
            AttachEmployeeID: _AttachEmployeeID,
            SourceType: _SourceType,
            RequestID: _RequestID,
            Mode: _Mode,
            CustomTextLabel1: _CustomTextLabel1,
            CustomTextValue1: _CustomTextValue1,
            ControlType1: _ControlType1,
            CreatedDate: _CreatedDate,
            SessionName: '@_SessionName'
        };

        $("#divLoading").css("display", "block");
        $.ajax({
            url: '@Url.Content("~/SubAttachment/UploadAttachmentToSession")',
            type: 'POST',
            data: form,  //form,//
            //contentType: "application/json;charset=utf-8",
            dataType: "text",
            success: function (data) {
                _GetAttachmentList();
                $("#divLoading").hide();
                attach = "";
            },
            error: function (x, y, z) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

    //  Logical function (AJAX)
    function _GetAttachmentList() {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/SubAttachment/_AttachmentListing/")',
            cache: false,
            dataType: "html",
            data: { Mode: '@_Mode', RequestID: '@_RequestID', SessionName: '@_SessionName', EmployeeID: '@_EmployeeID', SourceType: '@_SourceType', ShowOptionField: '@_ShowOptionField', CustomTextLabel1: '@_CustomTextLabel1' },
            async: false,
            success: function (content) {
                $("#_AttachmentListing").html(content);
                _clearInput();
            },
            error: function (e) {
                alert(x + '\n' + y + '\n' + z);
            }
        });
    }

    function _clearInput() {
        document.getElementById('_AttachDescription').value = "@_DescriptionValue";
        document.getElementById('_ID').value = _guid();
        document.getElementById('_FileContents').value = "";
        document.getElementById('_DocumentName').value = "";
        document.getElementById('_DocumentSize').value = "";
        document.getElementById('_DocumentContentType').value = "";
        document.getElementById('FN_Attachment').value = "";


        var CustomField = document.getElementById('_CustomTextValue1');

        if (CustomField !== null) {

            //don't clear if it is dropdown
            //if (document.getElementById('_CustomTextValue1').tagName != "SELECT")

                document.getElementById('_CustomTextValue1').value = "";
        }

    }

    function _DeleteSessionDocument(ID) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/SubAttachment/RemoveSessionDocument")',
            cache: false,
            async: false,
            dataType: "html",
            data: { ID: ID, Mode: '@_Mode', RequestID: '@_RequestID', SessionName: '@_SessionName' },
            success: function (content) {
                _GetAttachmentList();
            },
            error: function (e) {

            }
        });
    }

    function _DeleteDocument(ID) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/SubAttachment/DeleteDBDocument")',
            cache: false,
            async: false,
            dataType: "html",
            data: { ID: ID, Mode: '@_Mode', RequestID: '@_RequestID' },
            success: function (content) {
                _GetAttachmentList();
            },
            error: function (e) {

            }
        });
    }

    function _DownloadTempDocument(ID) {
        var url = '@Url.Content("~/SubAttachment/DownloadDocument")';
        window.open(url + '?ID=' + ID + '&Mode=' + '@_Mode' + '&RequestID=' + '@_RequestID' + '&SessionName=' + '@_SessionName');
    }

    function _DownloadAttachment(_AttachmentID) {
        var AttachmentID = _AttachmentID;
        //window.open('@_Path' + '/api/FileWebApi/' + AttachmentID);

        var jqxhr = $.ajax('@_Path' + '/ETKMS')
            .done(function () {
                window.open('@_Path' + '/Attachment/DownloadFile/' + AttachmentID);
            });
    }

</script>