@using UniformApplication.Services
@using ESS.Core

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Uniform Maintenance";

    List<DropDownObject> StateDDL = Service.DDL_GetState();
    List<DropDownObject> LocationDDL = Service.DDL_GetLocation("");
    



}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title <span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Reference No</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="ReferenceNo" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Category Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Category">
                            <option selected value="">- All -</option>
                            <option value="0">Yearly Cycle</option>
                            <option value="1">Special Requirement</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee Number</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="EmployeeCode" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee Name</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="EmployeeName" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">State</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLState", "UniformApplication", new { ForFilter = true })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Location</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLLocation", "UniformApplication", new { State = "", ForFilter = true })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date From</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="DateFrom" name="DateFrom" value="@ViewBag.FromDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date To</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="DateTo" name="DateTo" value="@ViewBag.ToDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option selected value="">- All -</option>
                            <option value="DR">Draft</option>
                            <option value="PE">Pending</option>
                            <option value="VE">Verified</option>
                            <option value="RC">Received</option>
                            <option value="RT">Returned</option>
                            <option value="NO">Did Not Order</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">

            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Yearly</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="Year" />
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>

<!-- Success Message -->
<div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well" id="SuccessMessage">
                    Claims has been successfully submitted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <a class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

    </p>
</div>

<script type="text/javascript">



    function ClearFilter() {
        $('#DateFrom').val('');
        $('#DateTo').val('');
        $('#ReferenceNo').val('');
        $('#Category').val('');
        $('#EmployeeCode').val('');
        $('#EmployeeName').val('');
        $('#State').val('');
        $('#Location').val('');
        $('#Status').val('');
        $('#Year').val('');

    }


    function SearchListing() {
        var _DateFrom = $('#DateFrom').val();
        var _DateTo = $('#DateTo').val();
        var _ReferenceNo = $('#ReferenceNo').val();
        var _Category = $('#Category').val();
        var _EmployeeCode = $('#EmployeeCode').val();
        var _EmployeeName = $('#EmployeeName').val();
        var _State = $('#State').val();
        var _Location = $('#Location').val();
        var _Status = $('#Status').val();
        var _Year = $('#Year').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/UniformApplication/_UniformMaintenanceResult")',
            cache: false,
            dataType: "html",
            data: {
                DateFrom: _DateFrom,
                DateTo: _DateTo,
                ReferenceNo: _ReferenceNo,
                Category: _Category,
                EmployeeCode: _EmployeeCode,
                EmployeeName: _EmployeeName,
                State: _State,
                Location: _Location,
                Status: _Status,
                Year: _Year
            },
            success: function (content) {
                $("#SearchResult").html(content);
                //ExportToExcel();
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    @*function changeState(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/UniformApplication/_DDLLocation")',
            cache: false,
            dataType: "html",
            data: { State: e.value },
            success: function (content) {
                $("#LocationResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }*@

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        SearchListing();
    });



</script>

