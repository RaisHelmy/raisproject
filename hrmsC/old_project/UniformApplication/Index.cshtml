    <!-- Confirmation Message -->
    <div class="modal fade" id="ConfirmationDialog" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 id="ConfirmationDialog_Title" class="modal-title"></h4>
                </div>
                <div class="modal-body">
                    <div id="ConfirmationDialog_Message" class="well">
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="ConfirmationDialog_PositiveButton" type="button" class="btn default blue">
                        <i class="fa fa-check"></i>
                    </button>
                    <button id="ConfirmationDialog_NegativeButton" type="button" class="btn default" data-dismiss="modal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Success Message -->
    <div class="modal fade" id="SuccessDialog" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    <h4 id="SuccessDialog_Title" class="Success-title">
                        Action Successfully Completed
                    </h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well" id="SuccessDialog_Message">
                        Request has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <a class="btn default blue" id="SuccessDialog_OkButton" data-dismiss="modal">
                        <i class="fa fa-check"></i>
                        OK
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed;
    right: 0px; top: 0px; width: 100%; height: 100%; background-color: gainsboro; z-index: 30001; opacity: .8; filter: alpha(opacity=70); display: none; ">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Performing action, please wait...<img src="/_layouts/15/TNBESS/Assets/img/ajax-loading.gif">
        </p>
    </div>

    <script>
    $(function () {
        InitializeCommonControls();


    });

    function InitializeCommonControls() {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        $('.timeinput').inputmask("mask", {
            "mask": "99:99"
        });

        $('.timeinput').inputmask("h:s", {
            "placeholder": "__/__",
            onincomplete: function () {
                // replace placeholder with zero
                $(this).val($(this).val().replace(/_/g, '0'));
            }
        });

        $('.number-only').keyup(function () {
            if (this.value != this.value.replace(/[^0-9\.]/g, '')) {
                this.value = this.value.replace(/[^0-9\.]/g, '');
            }
        });
    }

    function SubmitApplication(submitStatus) {
        if (submitStatus == "Draft") {
            ShowConfirmationDialog({
                message: "Are you sure you want to save this uniform application as draft?\n\r Press Confirm to proceed, or Close to stay on the current page.",
                positiveCallback: PerformSaveAsDraft
            });
        }
        else if (submitStatus == "RC" || submitStatus == "FB" )
        {
            $('#StatusUpdate').val(submitStatus);

            ShowConfirmationDialog({
                message: "Are you sure you want to update this uniform application?\n\r Press Confirm to proceed, or Close to stay on the current page.",
                positiveCallback: PerformStatusUpdate
            });
        }
        else
        {
            var validationMessage = PerformSubmissionValidation();
            var SummaryInfo = GetSubmissionSummary();
            if (validationMessage) {
                alert(validationMessage);
            }
            else {
                ShowConfirmationDialog({
                    message: "Are you sure you want to Submit this uniform application?" +
                             "<br><br> Item Summary: <br>" + SummaryInfo +
                             "<br> Press Confirm to proceed, or Close to stay on the current page.",
                    positiveCallback: PerformSubmission
                });
            }
        }
    }

    function GetSubmissionSummary() {
        var SummaryInfo = "";
        var itemCount = 0;
        while ($('[name="RequestItems[' + itemCount + '].Title"]').length > 0) {


            SummaryInfo +=
                $('[name="RequestItems[' + itemCount + '].Title"]').val() + ", Size: " +
                $('[name="RequestItems[' + itemCount + '].Size"]').val() + ", Quantity: " +
                $('[name="RequestItems[' + itemCount + '].RequestQty"]').val() + " <br>";

            itemCount++;
        }

        return SummaryInfo;
    }

    function PerformSubmissionValidation() {
        var ValidationMessage = "";
        var itemCount = 0;
        var IsAllZero = true;
        var IsSizeSelected = true;

        while ($('[name="RequestItems[' + itemCount + '].Title"]').length > 0) {


            if (!($('[name="RequestItems[' + itemCount + '].RequestQty"]').val()=='0' || $('[name="RequestItems[' + itemCount + '].RequestQty"]').val()=='')) {

                IsAllZero = false;

                if ($('[name="RequestItems[' + itemCount + '].Size"]').val() == '') {
                    IsSizeSelected = false;
                }
            }
  
            itemCount++;
        }

        if ($('#State').val() == '') {
             ValidationMessage += "- Please select state." + '\n';
        }

        if ($('#Location').val() == '') {
            ValidationMessage += "- Please select location." + '\n';
        }


        if (IsAllZero) {
            ValidationMessage += "- Please select quantity for your requested uniform." + '\n';
        }

        if (!IsSizeSelected) {
            ValidationMessage += "- Please select size for your requested uniform."+ '\n';
        }

        return ValidationMessage;
        }

    function PerformVerifyValidation() {
        var ValidationMessage = "";
        var itemCount = 0; 
        var IsSizeSelected = true;

        while ($('[name="RequestItems[' + itemCount + '].Title"]').length > 0) {

            if (!($('[name="RequestItems[' + itemCount + '].VerifiedQty"]').val()=='0' || $('[name="RequestItems[' + itemCount + '].VerifiedQty"]').val()=='')) {
                 
                if ($('[name="RequestItems[' + itemCount + '].VerifiedSize"]').val() == '') {
                    IsSizeSelected = false;
                }
            }
  
            itemCount++;
        } 

        if (!IsSizeSelected) {
            ValidationMessage += "- Please select size for your requested uniform."+ '\n';
        }

        return ValidationMessage;
    }

    function PerformSaveAsDraft() {
        var data = $('form').serializeArray();

        HideConfirmationDialog();
        ShowLoadingScreen();
        $.post('@Url.Action("SaveAsDraft", "UniformApplication")', data, function (result) {
            HideLoadingScreen();

            if (result.IsSuccess) {
                ShowDialog({
                    message: "This uniform application was saved as draft successfully.",
                    okCallback: function () {
                        window.location.href = '@Url.Action("UniformHistory", "UniformApplication")';
                    }
                });
            }
            else {
                alert(result.Message);
            }
        });
    }

    function PerformStatusUpdate() {

        var data = $('form').serializeArray();
        data[data.length] = { name: "StatusUpdate", value: StatusUpdate };

        HideConfirmationDialog();
        ShowLoadingScreen();
        $.post('@Url.Action("UpdateApplication", "UniformApplication")', data, function (result) {
            HideLoadingScreen();
            if (result.IsSuccess) {
                ShowDialog({
                    message: "This uniform application was updated successfully.",
                    okCallback: function () {
                        window.location.href = '@Url.Action("UniformHistory", "UniformApplication")';
                    }
                });
            }
            else {
                alert(result.Message);
            }
        });
    }

    function PerformSubmission() {
        var data = $('form').serializeArray();

        HideConfirmationDialog();
        ShowLoadingScreen();
        $.post('@Url.Action("SubmitApplication", "UniformApplication")', data, function (result) {
            HideLoadingScreen();
            if (result.IsSuccess) {
                ShowDialog({
                    message: "This uniform application was submitted successfully. <br><br>" + result.ReturnedObj.message,
                    okCallback: function () {
                        window.location.href = '@Url.Action("UniformHistory", "UniformApplication")';
                    }
                });
            }
            else {
                alert(result.Message);
            }
        });
    }

    function DeleteApplication() {
        ShowConfirmationDialog({
            message: "Are you sure you want to delete this uniform application? <br> Press Confirm to proceed, or Close to stay on the current page.",
            positiveCallback: PerformDeleteApplication
        });
    }

    function PerformDeleteApplication() {
        var data = {
            ID: '@Model.ID'
        };

        HideConfirmationDialog();
        ShowLoadingScreen();
        $.post('@Url.Action("DeleteApplication", "UniformApplication")', data, function (result) {
            HideLoadingScreen();
            if (result.IsSuccess) {
                ShowDialog({
                    message: "This uniform application was deleted successfully.",
                    okCallback: function () {
                        window.location.href = '@Url.Action("UniformHistory", "UniformApplication")';
                    }
                });
            }
            else {
                alert(result.Message);
            }
        });
    }

    function ApproverAction(action) {

        var data = $('form').serializeArray();
        var _ApproverInfo = {};
        var _ApproverAction = "";
        var _ApproverComment = $("#txtAppComment").val();
        var _DeclineReason = "";
        var _NewStartDate = $('#StartDate').val();
        var _NewEndDate = $('#EndDate').val();

        //if ($("#txtAppComment").length > 0 && !_ApproverComment && (action == "Decline" || action == "Withdraw" || action == "Cancel")) {
        //    alert("Comment is mandatory");
        //    return;
        //}

        if (action == "Verify") {
            var ValidationMessage = PerformVerifyValidation();

            if (ValidationMessage) {
                alert(ValidationMessage);
                return;
            }
        }


        var _RedirectUrl = "";

        switch (action) {
            case "Verify":
                _ApproverAction = "Verified";
                break;
            case "Acknowledge":
                _ApproverAction = "Acknowledged";
                break;
            case "Agree":
                _ApproverAction = "Agreed";
                break;
            case "Approve":
                _ApproverAction = "Approved";
                break;
            case "Cancel":
                _ApproverAction = "Cancelled";
                break;
            case "Decline":
                _ApproverAction = "Declined";
                break;
            case "Endorse":
                _ApproverAction = "Endorsed";
                break;
            case "Process":
                _ApproverAction = "Processed";
                break;
            case "ProcessMemo":
                _ApproverAction = "ProcessMemo";
                break;
            case "Receive":
                _ApproverAction = "Received";
                break;
            case "Recommend":
                _ApproverAction = "Recommended";
                break;
            case "Withdraw":
                _ApproverAction = "Withdrawn";
                //_ApproverComment = "";
                //_RedirectUrl = '@Url.Action("UniformHistory", "UniformApplication")';
                break;
            case "ApproveCancel":
                _ApproverAction = "ApproveCancel";
                break;
            case "Rework":
                _ApproverAction = "Reworked";
                break;
        }
        var action2 = "";
        if (action == "ApproveCancel") {
            action2 = "Approve Cancel";
        } else {
            action2 = action;
        }
        var promptMessage = "Are you sure you want to " + action2 + " this uniform application?\n\r Press Confirm to proceed, or Close to stay on the current page.";
        var notifyMessage = "";

        if (_ApproverAction == "Cancelled") {
            notifyMessage = "This uniform application was successfully submitted for cancellation.";
        } else if (_ApproverAction == "ApproveCancel") {
            notifyMessage = "This uniform application was cancelled successfully.";
        }
        else {
            notifyMessage = "This uniform application was " + _ApproverAction + " successfully.";
        }


        _ApproverInfo = {
            ID: '@Model.ID',
            TaskID: '@Model.TaskID',
            CurrentUserID: '@ViewBag.CurrentUserID',
            Status: action,
            ApproverComment: _ApproverComment ,
            ActivityName: '',
            OptionalApprover: false
        };


        data.push({ name: 'info.ID', value: '@Model.ID'});
        data.push({ name: 'info.TaskID', value: '@Model.TaskID'});
        data.push({ name: 'info.CurrentUserID', value: '@ViewBag.CurrentUserID'});
        data.push({ name: 'info.Status', value: action});
        data.push({ name: 'info.ApproverComment', value: _ApproverComment });
        data.push({ name: 'info.ActivityName', value: ''});
        data.push({ name: 'info.OptionalApprover', value: false });
        data.push({ name: 'ApproverAction', value: _ApproverAction });

        // If cancelled by submitter itself, redirect to history
        if (_ApproverInfo.CurrentUserID == '@Model.EmployeeID') {
            _RedirectUrl = '@Url.Action("UniformHistory", "UniformApplication")';
        }

        ShowConfirmationDialog({
            message: promptMessage,
            positiveCallback: function () {
                HideConfirmationDialog();
                ShowLoadingScreen();

                $.post('@Url.Action("PostApproverAction", "UniformApplication")',
                    data,
                    function (result) {
                        HideLoadingScreen();

                        if (result.Success) {
                            ShowDialog({
                                message: notifyMessage,
                                okCallback: function () {
                                    @*if (_RedirectUrl) {
                                        window.location.href = _RedirectUrl;
                                    }
                                    else {
                                        window.location.href = '@Url.Action("InTray", "UniformApplication")';
                                    }*@

                                    window.location.href = '@ViewBag.BackUrl';
                                }
                            });
                        }
                        else {
                            ShowDialog({
                                title: "Action not completed.",
                                message: "Error Message : " + result.ErrorMsg,
                                okCallback: function () {
                                    HideDialog();
                                }
                            });
                        }
                    });
            }
        });
    }


    // Dialog with Confirm/Close
    function ShowConfirmationDialog(data) {
        if (!data) {
            data = {};
        }

        var dialog = $('#ConfirmationDialog'),
            title = data.title || "Confirmation",
            message = data.message || "Are you sure you want to submit this Uniform Application? <br> Press Confirm to proceed, or Close to stay on the current page.",
            positiveButtonText = data.positiveButtonText || "Confirm",
            positiveCallback = data.positiveCallback,
            negativeButtonText = data.negativeButtonText || "Close",
            negativeCallback = data.negativeCallback;

        dialog.find("#ConfirmationDialog_Title").html(title);
        dialog.find("#ConfirmationDialog_Message").html(message);
        var ePositiveButton = dialog.find("#ConfirmationDialog_PositiveButton");
        var eNegativeButton = dialog.find("#ConfirmationDialog_NegativeButton");

        ePositiveButton.html(positiveButtonText);
        ePositiveButton.off('click');
        ePositiveButton.one('click', function () {
            if (positiveCallback)
                positiveCallback(dialog);
        });

        eNegativeButton.html(negativeButtonText);
        eNegativeButton.off('click');
        eNegativeButton.one('click', function () {
            if (negativeCallback)
                negativeCallback(dialog);
        });

        dialog.modal();
    }

    function HideConfirmationDialog() {
        var dialog = $('#ConfirmationDialog');
        dialog.modal("hide");
    }

    // Dialog with OK
    function ShowDialog(data) {
        if (!data) {
            data = {};
        }

        var dialog = $('#SuccessDialog'),
            title = data.title,
            message = data.message || "The operation was success.",
            okCallback = data.okCallback;

        var okButton = dialog.find("#SuccessDialog_OkButton");

        dialog.find("#SuccessDialog_Title").html(title);
        dialog.find("#SuccessDialog_Message").html(message);

        okButton.off('click');
        okButton.one('click', function () {
            if (okCallback)
                okCallback();
        });

        dialog.modal();
    }

    function HideDialog() {
        var dialog = $('#SuccessDialog');
        dialog.modal("hide");
    }

    function ShowLoadingScreen() {
        $("#divLoading").show();
    }

    function HideLoadingScreen() {
        $('#divLoading').hide();
    }
    </script>

