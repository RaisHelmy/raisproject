@model  UniformApplication.Model.BSOMember
@using ESS.Core
@using UniformApplication.Services
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool IsAddRole = (Model.ID == Guid.Empty);
    string FormType = IsAddRole ? "Add" : "Edit";
    string FormAction = IsAddRole ? "Added" : "Updated";
    ViewBag.Title = FormType + " BSO Role";


    List<DropDownObject> StateDDL = Service.DDL_GetState(true);
    List<DropDownObject> LocationDDL = Service.DDL_GetLocation(Model.StateID.ToString(), true);
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title <span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">

    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue">
                <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa fa-reorder"></i>BSO Role
                    </div>
                    <div class="tools">
                        <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="form-body">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">Employee<span style="color:red;"> *</span></label>
                                        <div class="col-md-8 form-control-static">

                                            <input type="hidden" name="ID" id="ID" value="@Model.ID.ToString()">
                                            @if (Model.ID != Guid.Empty)
                                            {
                                                string EmployeeDisplay = !string.IsNullOrEmpty(@Model.EmployeeCode) ? @Model.EmployeeCode + " - " + Model.EmployeeName : "";
                                                <input type="hidden" name="hfEmpID" id="hfEmpID" value="@Model.EmployeeID">
                                                <input type="hidden" name="EmployeeID" id="EmployeeID" value="@Model.EmployeeID">
                                                <input type="text" class="form-control" readonly name="EmployeeDisplay" id="EmployeeDisplay" value="@EmployeeDisplay">
                                            }
                                            else
                                            {
                                                string EmployeeDisplay = !string.IsNullOrEmpty(@Model.EmployeeCode) ? @Model.EmployeeCode + " - " + Model.EmployeeName : "";
                                                <input type="hidden" name="EmployeeID" id="EmployeeID" value="@Model.EmployeeID">
                                                <input type="hidden" name="EmployeeDisplay" id="EmployeeDisplay" value="@EmployeeDisplay">
                                                @Html.Action("_PeoplePickerExt", "PeoplePicker", new { CurrEmpID = Common.GetEmployeeID(), SearchType = "" })
                                            }

                                        </div>
                                    </div>
                                </div>
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            State <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <input type="hidden" name="StateValue" id="StateValue" value="@Model.StateID"/>
                                            @Html.DropDownList("State", new SelectList(StateDDL, "Value", "Text"), null, new { @class = "bs-select form-control", @name = "State", @onchange = "changeState(this)", @value = Model.StateID })
                                            @*<select tabindex="0" id="ddlState" class="form-control" onchange="OnLeaveTypeChanged(); PopulateLeaveSubtype(); TransitionFocus('ddlLeaveSubtype');"></select>*@
                                        </div>
                                    </div>
                                </div>
                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-4">
                                            Location <span style="color:red;"> *</span>
                                        </label>
                                        <div class="col-md-8 form-control-static">
                                            <span id="LocationResult">
                                                <input type="hidden" name="LocationValue" id="LocationValue" value="@Model.LocationID" />
                                                @Html.DropDownList("Location", new SelectList(LocationDDL, "Value", "Text"), null, new { @class = "bs-select form-control", @name = "Location", @value = Model.LocationID })
                                            </span>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="text-right">
                                    <input type="button" id="btn-Search" class="btn green btn-Search" value="Update" onclick="AddBSORole()">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">&nbsp;</div>
        
    </div>


    <!-- Success Message -->
    <div class="modal fade" id="SuccessDialog" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header Success-header">
                    <h4 id="SuccessDialog_Title" class="Success-title">
                        Action Successfully Completed
                    </h4>
                </div>
                <div class="modal-body Success-body">
                    <div class="well" id="SuccessDialog_Message">
                        Request has been successfully submitted.
                    </div>
                </div>
                <div class="modal-footer Success-footer">
                    <a class="btn default blue" id="SuccessDialog_OkButton" data-dismiss="modal">
                        <i class="fa fa-check"></i>
                        OK
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Gif -->
    <div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
        <p style="position: absolute; top: 30%; left: 30%; color: black;">
            Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

        </p>
    </div>

    <script type="text/javascript">

        function AddBSORole()
        {
            ShowLoadingScreen();
            _RedirectUrl = "";
            notifyMessage = "The BSO role was successfully @FormAction.";

            var _ID = $('#ID').val();
            var _EmployeeID = $('#hfEmpID').val();
            var _StateID = $('#State').val();
            var _LocationID = $('#Location').val();

            if (_EmployeeID == '' || _StateID == '' || _LocationID == '') {
                alert("Please fill in all the required * field.")
                HideLoadingScreen();
                return;
            }

            $.post('@Url.Action("AddBSOEmployee", "UniformApplication")',
                {
                    ID: _ID,
                    EmployeeID: _EmployeeID,
                    StateID: _StateID,
                    LocationID: _LocationID
                },
                function (result) {
                    HideLoadingScreen();

                    if (result.Success) {
                        ShowDialog({
                            message: notifyMessage,
                            okCallback: function () {
                                if (_RedirectUrl) {
                                    window.location.href = _RedirectUrl;
                                }
                                else {
                                    window.location.href = '@Url.Action("BSOMaintenance", "UniformApplication")';
                                }
                            }
                        });
                    }
                    else {
                        ShowDialog({
                            title: "Action not completed.",
                            message: "Error Message : " + result.ErrorMsg,
                            okCallback: function () {
                                HideDialog();
                            }
                        });
                    }
                });
        }
        
        function ShowDialog(data) {
            if (!data) {
                data = {};
            }

            var dialog = $('#SuccessDialog'),
                title = data.title,
                message = data.message || "The operation was success.",
                okCallback = data.okCallback;

            var okButton = dialog.find("#SuccessDialog_OkButton");

            dialog.find("#SuccessDialog_Title").html(title);
            dialog.find("#SuccessDialog_Message").html(message);

            okButton.off('click');
            okButton.one('click', function () {
                if (okCallback)
                    okCallback();
            });

            dialog.modal();
        }

        // Dialog with Confirm/Close
        function ShowConfirmationDialog(data) {
            if (!data) {
                data = {};
            }

            var dialog = $('#ConfirmationDialog'),
                title = data.title || "Confirmation",
                message = data.message || "Are you sure you want to submit this Uniform Application?\n\r Press Confirm to proceed, or Close to stay on the current page.",
                positiveButtonText = data.positiveButtonText || "Confirm",
                positiveCallback = data.positiveCallback,
                negativeButtonText = data.negativeButtonText || "Close",
                negativeCallback = data.negativeCallback;

            dialog.find("#ConfirmationDialog_Title").html(title);
            dialog.find("#ConfirmationDialog_Message").html(message);
            var ePositiveButton = dialog.find("#ConfirmationDialog_PositiveButton");
            var eNegativeButton = dialog.find("#ConfirmationDialog_NegativeButton");

            ePositiveButton.html(positiveButtonText);
            ePositiveButton.off('click');
            ePositiveButton.one('click', function () {
                if (positiveCallback)
                    positiveCallback(dialog);
            });

            eNegativeButton.html(negativeButtonText);
            eNegativeButton.off('click');
            eNegativeButton.one('click', function () {
                if (negativeCallback)
                    negativeCallback(dialog);
            });

            dialog.modal();
        }

        function HideDialog() {
            var dialog = $('#SuccessDialog');
            dialog.modal("hide");
        }

        function ShowLoadingScreen() {
            $("#divLoading").show();
        }

        function HideLoadingScreen() {
            $('#divLoading').hide();
        }

        jQuery(document).ready(function () {
            InitializeFormValue();

        });

        function InitializeFormValue() {
            $('#hfEmpID').val($('#EmployeeID').val());
            $('#txtEmpName').val($('#EmployeeDisplay').val());
            $('#Location').val($('#LocationValue').val());
            $('#State').val($('#StateValue').val());
            
        }
        
        function changeState(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/UniformApplication/_DDLLocation")',
            cache: false,
            dataType: "html",
            data: { State: e.value },
            success: function (content) {
                $("#LocationResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
    </script>

