
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Procurement Report";
}

@using (Html.BeginForm("PerformExport", "UniformApplication", FormMethod.Post))
{

    <div class="row">
        <div class="col-md-12">
            <br />
            <h1 class="page-title">
                @ViewBag.Title <span style="padding-left:20px;"><small></small></span>
            </h1>
            <input type="hidden" id="ExportIDs" name="ExportIDs" />
            <input type="hidden" id="Type" name="Type" value="Procurement" />
        </div>
    </div>
    <br />
    <div class="form-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Start Date</label>
                        <div class="col-md-8 form-control-static">
                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                <input type="text" class="form-control" id="StartDate" name="StartDate" value="@ViewBag.FromDate" />
                                <span class="input-group-btn">
                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">End Date</label>
                        <div class="col-md-8 form-control-static">
                            <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                                <input type="text" class="form-control" id="EndDate" name="EndDate" value="@ViewBag.ToDate" />
                                <span class="input-group-btn">
                                    <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Category Type</label>
                        <div class="col-md-8 form-control-static">
                            <select class="form-control" id="Category">
                                <option selected value="">- All -</option>
                                <option value="0">Yearly Cycle</option>
                                <option value="1">Special Requirement</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Status</label>
                        <div class="col-md-8 form-control-static">
                            <select class="form-control" id="Status">
                                <option selected value="">- All -</option>
                                <option value="VE">Verified</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">State</label>
                        <div class="col-md-8 form-control-static">
                            @Html.Action("_DDLState", "UniformApplication", new { ForFilter = true })
                            @*<span id="StateResult">
                                @Html.DropDownList("State", new SelectList(StateDDL, "Value", "Text"), null, new { @class = "bs-select form-control", @name = "State" })
                            </span>*@
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Location</label>
                        <div class="col-md-8 form-control-static">

                            @Html.Action("_DDLLocation", "UniformApplication", new { State = "", ForFilter = true })
                            @*<span id="LocationResult">
                                @Html.DropDownList("Location", new SelectList(LocationDDL, "Value", "Text"), null, new { @class = "bs-select form-control", @name = "Location" })
                            </span>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Employee</label>
                        <div class="col-md-8 form-control-static">
                            <input class="form-control" type="text" id="Employee" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Year</label>
                        <div class="col-md-8 form-control-static">
                            <input class="form-control" type="text" id="Year" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Reference No.</label>
                        <div class="col-md-8 form-control-static">
                            <input class="form-control" type="text" id="ReferenceNo" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-md-4 control-label">Uniform Type</label>
                        <div class="col-md-8 form-control-static">
                            <input class="form-control" type="text" id="UniformType" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">&nbsp;</div>
        <div class="row">
            <div class="col-md-12">
                <div class="text-right">
                    <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                    <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
                </div>
            </div>
        </div>
        <div class="row">&nbsp;</div>
        <div class="row">
            <div class="col-md-12">
                <div id="SearchResult">

                </div>
            </div>
        </div>
    </div>
}


@Html.Partial("_ExcelExport")

<div id="ProcurementActionDiv">
    <div class="row">
        <div class="col-md-12">
            <input type="button" class="btn green" value="Generate Report for Procurement Process" id="btnSubmit" onclick="SendToProcurement(); " />
        </div>
    </div>
</div>

<!-- Success Message -->
<div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well" id="SuccessMessage">
                    Claims has been successfully submitted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <a class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

    </p>
</div>

<script type="text/javascript">

    function SearchListing() {
        var _DateFrom = $('#StartDate').val();
        var _DateTo = $('#EndDate').val();
        var _Status = $('#Status').val();
        var _Employee = $('#Employee').val();
        var _Category = $('#Category').val();
        var _State = $('#State').val();
        var _Location = $('#Location').val();
        var _UniformType = $('#UniformType').val();
        var _Year = $('#Year').val();
        var _ReferenceNo = $('#ReferenceNo').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/UniformApplication/_ProcurementReportResult")',
            cache: false,
            dataType: "html",
            data: {
                DateFrom: _DateFrom,
                DateTo: _DateTo,
                Status: _Status,
                Employee: _Employee,
                Category: _Category,
                State: _State,
                Location: _Location,
                UniformType: _UniformType,
                Year: _Year,
                ReferenceNo: _ReferenceNo
            },
            success: function (content) {
                $("#SearchResult").html(content);
                ShowHideActionDiv('show');
                //ExportToExcel();
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function ClearFilter() {
        $('#StartDate').val('');
        $('#EndDate').val('');
        $('#Status').val('');
        $('#Employee').val('');
        $('#Category').val('');
        $('#State').val('');
        $('#Location').val('');
        $('#UniformType').val('');
        $('#Year').val('');
        $('#ReferenceNo').val('');
        
    }

    function SendToProcurement() {
        var _EntryIDs = "";

        //$("#tbl_Index_DetailsResult td input[type=checkbox]:checked").each(function (i, value) {
        //    var row = $(this).closest("tr");
        //    _EntryIDs += row.find('.ProcurementCheckBox').val() + ',';
        //});


        $.each($('#tbl_Index_DetailsResult').dataTable().fnGetNodes(), function (i, e) {

            var row = $(e).closest('tr');
            var _element = row.find('.ProcurementCheckBox'); //$row.find('td input[type=checkbox]:checked');
            //var CheckBoxElement = row.find('.ProcurementCheckBox');
            var _selected = _element.prop("checked");
            if (_selected) {
                _EntryIDs += _element.val() + ',';
                _element.attr("checked", false);
                _element.hide();
            }
            //_EntryIDs += CheckBoxElement.val() + ',';
            //CheckBoxElement.hide();
        });

        $('#ExportIDs').val(_EntryIDs);
        $("form").submit();

    }
    

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        ShowHideActionDiv('hide');

        //SearchListing();

        //$('#SelectAll').on('change', SelectUnselectAll);
    
    });

    function ShowHideActionDiv(DisplayAction) {

        if (DisplayAction == 'hide') {
            $('#ProcurementActionDiv').hide();
        }
        else {
            $('#ProcurementActionDiv').show();
        }

    }


</script>

