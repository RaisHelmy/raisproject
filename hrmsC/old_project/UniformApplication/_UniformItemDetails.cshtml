                                                    <tr>
                                                        <th>
                                                            Delivery Process
                                                            <input type="hidden" id="RequestItems[@x].ItemFeedback.Delivery" name="RequestItems[@x].ItemFeedback.Delivery" value="@Model.RequestItems[x].ItemFeedback.Delivery" />
                                                        </th>
                                                        <td><label class="radio-inline">@Html.RadioButton("Delivery_" + x + "", "1", Model.RequestItems[x].ItemFeedback.Delivery == "1", new { @class = "radio-assign-value", @readonly = "readonly" }) 1</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Delivery_" + x + "", "2", Model.RequestItems[x].ItemFeedback.Delivery == "2", new { @class = "radio-assign-value", @readonly = "readonly" }) 2</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Delivery_" + x + "", "3", Model.RequestItems[x].ItemFeedback.Delivery == "3", new { @class = "radio-assign-value", @readonly = "readonly" }) 3</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Delivery_" + x + "", "4", Model.RequestItems[x].ItemFeedback.Delivery == "4", new { @class = "radio-assign-value", @readonly = "readonly" }) 4</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Delivery_" + x + "", "5", Model.RequestItems[x].ItemFeedback.Delivery == "5", new { @class = "radio-assign-value", @readonly = "readonly" }) 5</label></td>
