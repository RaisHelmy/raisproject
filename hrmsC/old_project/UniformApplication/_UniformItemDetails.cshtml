                                        <input type="text" class="form-control" name="RequestItems[@x].StatusDesc" value='@Model.RequestItems[x].StatusDesc' readonly />


                                    }
                                    else
                                    {
                                        @Html.DropDownList("RequestItems[" + @x + "].Status", new SelectList(Model.RequestItems[x].StatusDDL, "Value", "Text"), null, new { @class = "bs-select form-control select-assign-value item-status", @name = "RequestItems[" + @x + "].Status", @value = Model.RequestItems[x].Status, @onchange = "changeItemStatus(this)" })

                                    }
                                </div>
                            </div>
                        </div>

