                                                        <td><label class="radio-inline">@Html.RadioButton("Quality_" + x + "", "2", Model.RequestItems[x].ItemFeedback.Quality == "2", new { @class = "radio-assign-value", @readonly = "readonly" }) 2</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Quality_" + x + "", "3", Model.RequestItems[x].ItemFeedback.Quality == "3", new { @class = "radio-assign-value", @readonly = "readonly" }) 3</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Quality_" + x + "", "4", Model.RequestItems[x].ItemFeedback.Quality == "4", new { @class = "radio-assign-value", @readonly = "readonly" }) 4</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Quality_" + x + "", "5", Model.RequestItems[x].ItemFeedback.Quality == "5", new { @class = "radio-assign-value", @readonly = "readonly" }) 5</label></td>
