@model UniformApplication.Model.UniformApplicationVM

@{
    Layout = "";
    bool isViewOnlyFeedback = false;
}

<style>
    .borderless td, .borderless th, .borderless tr {
        border: none !important;
    }

    .radio {
        padding-top: 0px !important;
    }

    .table-feedback tbody tr th {
        padding-left: 0px;
    }
</style>

@for (int x = 0; x < Model.RequestItems.Count; x++)
{
    <div class="row @Model.RequestItems[x].Code">
        @if (Model.IsNewApplication || Model.IsEditable)
        {
            <div class="col-md-4">
                <div class="form-horizontal">
                    <div class="form-group">
                        <img src="@Model.RequestItems[x].ImageURL" class="form-control-static col-md-12" />
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Item
                        </label>
                        <div class="col-md-7  form-control-static">
                            <input type="hidden" name="RequestItems[@x].ID" value="@Model.RequestItems[x].ID" />
                            <input type="hidden" name="RequestItems[@x].Code" value="@Model.RequestItems[x].Code" />
                            <input type="text" class="form-control" name="RequestItems[@x].Title" value='@Model.RequestItems[x].Title' readonly />
                        </div>
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Description
                        </label>
                        <div class="col-md-7  form-control-static">
                            <input type="text" class="form-control" name="RequestItems[@x].Description" value='@Model.RequestItems[x].Description' readonly />
                        </div>
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Quantity
                        </label>
                        <div class="col-md-7  form-control-static">
                            <input type="hidden" name="RequestItems[@x].RequestQtyValue" value="@Model.RequestItems[@x].RequestQty" />
                            @{
                                string SpanName = "Eligibility_" + Model.RequestItems[x].Code + "_" + x;
                            }
                            <span class="eligibility-ddl" name="@SpanName">
                                @Html.DropDownListFor(i => i.RequestItems[x].RequestQty, new SelectList(Model.RequestItems[x].EligibleQtyDDL, "Value", "Text"), new { @class = "bs-select form-control select-assign-value qty-ddl", @onchange= "disableSizeDDL(this)" })
                            </span>

                            @*@Html.DropDownList("RequestItems[" + @x + "].RequestQty", new SelectList(Model.RequestItems[x].EligibleQtyDDL, "Value", "Text"), null, new { @class = "bs-select form-control ", @name = "RequestItems[" + @x + "].RequestQty", @value = Model.RequestItems[x].RequestQty })*@
                        </div>
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Size
                        </label>
                        <div class="col-md-7  form-control-static">
                            <input type="hidden" name="RequestItems[@x].SizeValue" value="@Model.RequestItems[@x].Size" />
                            @Html.DropDownListFor(i => i.RequestItems[x].Size, new SelectList(Model.RequestItems[x].SizeDDL, "Value", "Text"), new { @class = "bs-select form-control select-assign-value", @value = @Model.RequestItems[x].Size })
                            @*@Html.DropDownList("RequestItems[" + @x + "].Size", new SelectList(Model.RequestItems[x].SizeDDL, "Value", "Text"), null, new { @class = "bs-select form-control ", @name = "RequestItems[" + @x + "].Size", @value = Model.RequestItems[x].Size })*@
                        </div>
                        @if (!string.IsNullOrEmpty(@Model.RequestItems[x].GuideURL))
                        {
                            <div class="col-md-1  form-control-static">
                                <a class="btn blue btn-sm" title="View sizing guide" onclick="ViewSizingGuide('@Model.RequestItems[x].GuideURL');">
                                    <i class="fa fa-folder-open-o"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Comment
                        </label>
                        <div class="col-md-7  form-control-static">
                            <textarea class="form-control " style="width:100%; height:100px;" name="RequestItems[@x].Remarks">@Model.RequestItems[x].Remarks</textarea>
                        </div>
                    </div>
                </div>

            </div>


        }
        else
        {
            int? currentQty = 0;

            <div class="col-md-4">
                <div class="form-horizontal">
                    <div class="form-group">
                        <img src="@Model.RequestItems[x].ImageURL" class="form-control-static col-md-12" />
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="form-horizontal">
