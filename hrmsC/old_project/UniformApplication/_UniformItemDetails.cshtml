                        </div>
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Description
                        </label>
                        <div class="col-md-7  form-control-static">
                            <input type="text" class="form-control" name="RequestItems[@x].Description" value='@Model.RequestItems[x].Description' readonly />
                        </div>
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Quantity
                        </label>
                        <div class="col-md-7  form-control-static">

                            @if (Model.IsPhaseBSOVerify && Model.IsBSOMemberOfRequest)
                            {
                                <input type="hidden" name="RequestItems[@x].RequestQty" value="@Model.RequestItems[@x].RequestQty" />
                                <input type="hidden" name="RequestItems[@x].VerifiedQtyValue" value="@Model.RequestItems[@x].RequestQty" />

                                @Html.DropDownListFor(i => i.RequestItems[x].VerifiedQty, new SelectList(Model.RequestItems[x].EligibleQtyDDL, "Value", "Text"), new { @class = "bs-select form-control select-assign-value qty-ddl" , @onchange= "disableSizeDDL(this)"})

                            }
                            else if (!Model.IsNewApplication && !Model.IsPhaseBSOVerify && Model.Status != "PE")
                            {
                                currentQty = Model.RequestItems[x].VerifiedQty;
                                <input type="text" class="form-control current-qty" name="RequestItems[@x].VerifiedQty" value='@Model.RequestItems[x].VerifiedQty' readonly />
                            }
                            else
                            {
                                currentQty = Model.RequestItems[x].RequestQty;
                                <input type="text" class="form-control current-qty" name="RequestItems[@x].RequestQty" value='@Model.RequestItems[x].RequestQty' readonly />
                            }
                        </div>
                        @if (!Model.IsNewApplication && !Model.IsPhaseBSOVerify && Model.Status != "PE")
                        {
                            <input type="hidden" name="RequestItems[@x].RequestQtyValue" value='@Model.RequestItems[x].RequestQty' />
                            <input type="hidden" name="RequestItems[@x].VerifiedQtyValue" value='@Model.RequestItems[x].VerifiedQty' />
