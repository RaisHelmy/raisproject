                                                    <tr>
                                                        <th>
                                                            Material
                                                            <input type="hidden" id="RequestItems[@x].ItemFeedback.Material" name="RequestItems[@x].ItemFeedback.Material" value="@Model.RequestItems[x].ItemFeedback.Material" />
                                                        </th>
                                                        <td><label class="radio-inline">@Html.RadioButton("Material_" + x + "", "1", Model.RequestItems[x].ItemFeedback.Material == "1", new { @class = "radio-assign-value", @readonly = "readonly" }) 1</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Material_" + x + "", "2", Model.RequestItems[x].ItemFeedback.Material == "2", new { @class = "radio-assign-value", @readonly = "readonly" }) 2</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Material_" + x + "", "3", Model.RequestItems[x].ItemFeedback.Material == "3", new { @class = "radio-assign-value", @readonly = "readonly" }) 3</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Material_" + x + "", "4", Model.RequestItems[x].ItemFeedback.Material == "4", new { @class = "radio-assign-value", @readonly = "readonly" }) 4</label></td>
                                                        <td><label class="radio-inline">@Html.RadioButton("Material_" + x + "", "5", Model.RequestItems[x].ItemFeedback.Material == "5", new { @class = "radio-assign-value", @readonly = "readonly" }) 5</label></td>
