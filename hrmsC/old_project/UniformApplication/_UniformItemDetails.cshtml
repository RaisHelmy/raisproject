                                    </div>
                                </div>

                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="control-label col-md-3">
                                            Feedback
                                        </label>
                                        <div class="col-md-7  form-control-static">
                                            <textarea class="form-control" readonly style="width:100%; height:100px;" name="RequestItems[@x].ItemFeedback.Comment">@Model.RequestItems[x].ItemFeedback.Comment</textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                }


            </div>
        }
    </div>

    <br class="@Model.RequestItems[x].Code">
    if (x < Model.RequestItems.Count)
    {
        <hr class="@Model.RequestItems[x].Code">
        <br class="@Model.RequestItems[x].Code">
    }
}

<script>

    function AssignRadioValue() {

        alert('test');
    }

    function AssignItemDDLValue() {
        $('.select-assign-value').each(function (i, v) {
            //console.log($("input[name='" + $(v).attr("name") + "Value']").val());
            $(v).val($("input[name='" + $(v).attr("name") + "Value']").val());
        })

        specialRequirementAssignQty();
        SetDefaultRequestQuantity();
    }

    function AssignItemEligibilityValue() {
        var EmployeeID = $('#hfEmpID').val();
        if ($('input[name="Category"]') !== "1") {
            $('.eligibility-ddl').each(function (i, v) {
                //console.log($("input[name='" + $(v).attr("name") + "Value']").val());
                $(v).val($("input[name='" + $(v).attr("name") + "Value']").val());

                //var EmployeeID = e.Value;
                var TargetName = $(v).attr("name");
                var NameSplit = ($(v).attr("name")).split("_");
                var ItemCode = NameSplit[1];
                var ItemCount = NameSplit[2];

                changeEmployeeEligibility(EmployeeID, ItemCode, ItemCount, TargetName);
            })
        }
    }

    function changeEmployeeEligibility(EmployeeID, Code, Count, target) {

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/UniformApplication/_DDLEligibility")',
            cache: false,
            dataType: "html",
                //string EmployeeID, string UniformCode, string Count
                data: { EmployeeID: EmployeeID, UniformCode: Code, Count: Count},
            success: function (content) {
                $("span[name='" + target + "']").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    
    function LoadItemsWithEligibility() {

        var SubmitForEmpID = $('#hfEmpID').val();
        $('input[name="SubmitFor"]').val(SubmitForEmpID);
        if ('@Model.Category' == '0') {


                  
            
        $.ajax({
            url: '../UniformApplication/IsSubmitted',
            type: 'POST',
            data: {
                EmployeeID: SubmitForEmpID,
                StartDate: $("[name='CycleStart']").val(),
                EndDate: $("[name='CycleEnd']").val()
            },
            success: function (result) {
                   
                   if (result) {
                        
                       $('#divUniformItem').hide();
                       $('#divActionButton').hide()
                       $('#divSubmittedWarning').show()
                      
                    } else {

                        $('#divUniformItem').show();
                       $('#divActionButton').show()
                       $('#divSubmittedWarning').hide(); 

                        $.ajax({
                            type: "GET",
                            url: '@Url.Content("~/UniformApplication/_UniformItems")',
                            cache: false,
                            dataType: "html",
                            data: { EmployeeID: SubmitForEmpID },
                            success: function (content) {
                    
                                $(".uniform-items").html(content);
                            },
                            error: function (e) {
                                console.log(e);
                            }
                                                  });

                    }
               
            },
            error: function (e) {
                   alert('error');
                    console.log(e);
                }
        });
          

            @*if (isSubmitted == 'false') {
                $.ajax({
                type: "GET",
                url: '@Url.Content("~/UniformApplication/_UniformItems")',
                cache: false,
                dataType: "html",
                data: { EmployeeID: SubmitForEmpID },
                success: function (content) {
                    
                    $(".uniform-items").html(content);
                },
                error: function (e) {
                    console.log(e);
                }
            });
            }*@
            
        }
        
    }

    function RemoveNonEligibleItem() {
        $('.remove-eligibility').each(function (i, v) {

            $('.' + $(v).val()).remove();
        })
    }

    function InitializeItemReturnShowHide() {
        $('.item-status').each(function (i, v) {
            changeItemStatus(v);

            //var Status = $(v).val();

            //var ElementName = $(v).attr("name");
            //var m = ElementName.indexOf("[");
            //var n = ElementName.indexOf("]");
            //var TargetClass = 'ReturnQtyDiv_' + ElementName.substring(m + 1, n);

            //if (Status === 'PR') {
            //    $('.' + TargetClass).show();
            //}
            //else {
            //    $('.' + TargetClass).hide();
            //}

        });
    }

    function changeItemStatus(e) {
        var ElementName = $(e).attr("name");
        var ElementValue = $(e).val();
        var m = ElementName.indexOf("[");
        var n = ElementName.indexOf("]");
        var TargetClass = 'ReturnQtyDiv_' + ElementName.substring(m + 1, n);
        var TargetClassFeedback = 'FeedbackDiv_' + ElementName.substring(m + 1, n);
        if (ElementValue == "PR") {

            $('.' + TargetClass).show();
        }
        else {

            $('.' + TargetClass).hide();
        }

        if (ElementValue == "NO") {
            $('.' + TargetClassFeedback).hide();
        }
        else {

            $('.' + TargetClassFeedback).show();
        }
    }



    function loadSizeTooltip() {
        $('.imgSizeInfo').each(function (i, v) {

            $(v).val($("input[name='" + $(v).attr("name") + "Value']").val());

            var NameSplit = ($(v).attr("name")).split("_");
            var Count = NameSplit[1];
            var TargetName = 'imgSizeInfo_' + Count;

            $('#' + TargetName).qtip({
                content: createSizeTooltips(Count),
                position: {
                    corner: {
                        target: 'leftMiddle',
                        tooltip: 'rightMiddle',
                        adjust: {
                            method: 'shift none'
                        }
                    }
                },
                style: {
                    width: " + this.Width + ",
                    border: {
                        width: 2,
                        radius: 5,
                        color: '#CECECE'
                    },
                    padding: 5,
                    tip: true,
                    name: 'light'
                }
            });
        })
    }

    function loadQtyTooltip() {
        $('.imgQtyInfo').each(function (i, v) {

            $(v).val($("input[name='" + $(v).attr("name") + "Value']").val());

            var NameSplit = ($(v).attr("name")).split("_");
            var Count = NameSplit[1];
            var TargetName = 'imgQtyInfo_' + Count;

            $('#' + TargetName).qtip({
                content: createQtyTooltips(Count),
                position: {
                    corner: {
                        target: 'leftMiddle',
                        tooltip: 'rightMiddle',
                        adjust: {
                            method: 'shift none'
                        }
                    }
                },
                style: {
                    width: " + this.Width + ",
                    border: {
                        width: 2,
                        radius: 5,
                        color: '#CECECE'
                    },
                    padding: 5,
                    tip: true,
                    name: 'light'
                }
            });
        })
    }


    function createQtyTooltips(Count) {
        
        return '<table align="center">' +
        '<tr><td>Applied Quantity    :   </td><td align=right>' + $('input[name="RequestItems[' + Count + '].RequestQtyValue').val() + '</td></tr>' +
            '<tr><td>Updated Quantity    :   </td><td align=right>' + $('input[name="RequestItems[' + Count + '].VerifiedQtyValue').val() + '</td></tr>' +
            '</table > ';
        
    }


    function createSizeTooltips(Count) {

        return '<table align="center">' +
            '<tr><td>Applied Size    :   </td><td align=right>' + $('input[name="RequestItems[' + Count + '].SizeValue').val() + '</td></tr>' +
            '<tr><td>Updated Size    :   </td><td align=right>' + $('input[name="RequestItems[' + Count + '].VerifiedSizeValue').val() + '</td></tr>' +
            '</table > ';

    }

    function readOnlyFeedbackRadio() {
        $(':radio').attr('disabled', true)
    }

    function specialRequirementAssignQty() {
        if ('@Model.Category' == '1') {
            //$('.qty-ddl').val('0');
            $.each($('.qty-ddl'), function (i, v) {
                var ddlValue = $(v).val();
                if (ddlValue === '') {
                    $(v).val('0');
                }
            });
        }
    }

    function SetDefaultRequestQuantity() {

        if ('@Model.Category' == '0' && '@Model.IsNewApplication' == 'True') {
            $.each($('.qty-ddl'), function (i, v) {
                var ddlValue = $(v).val();

                if (ddlValue === '') {
                    $(v).val('0');
                }
            });
        }
    }


    function disableStatusDDL() {


        $.each($('.current-qty'), function (i, v) {

            var Element = $(v);
            var ElementName = Element.attr('name');
            var SplittedName = ElementName.split(".");

            var TargetElementName = SplittedName[0] + '.Status';
            var TargetElement = $('[name="' + TargetElementName + '"]');
            if (TargetElement.length > 0) {
                if (Element.val() === "0") {
                    TargetElement.val('NO');
                    TargetElement.attr('disabled', true);
                }
                else {
                    TargetElement.attr('disabled', false);
                }
            }
            

        })

        
    }

    function disableSizeDDL(e) {
        
        var Element = $(e);
        var ElementName = Element.attr('name');
        var SplittedName = ElementName.split(".");

        var TargetElementName = SplittedName[0] + '.Size';
        var TargetElement = $('[name="' + TargetElementName + '"]');

        //quickfix for disable/enable size ddl
        var TargetElementNameVerified = SplittedName[0] + '.VerifiedSize';
        var TargetElementVerified = $('[name="' + TargetElementNameVerified + '"]');


        if (TargetElement.length > 0) {            
            if (Element.val() === "0") {
                TargetElement.val('');
                TargetElement.attr('disabled', true); 
            }
            else {
                TargetElement.attr('disabled', false); 
            }
        }

        if (TargetElementVerified.length > 0) {            
            if (Element.val() === "0") {
                TargetElementVerified.val('');
                TargetElementVerified.attr('disabled', true);

 
            }
            else {
                TargetElementVerified.attr('disabled', false);
 
            }
        }
    }


    function initiateDisableSizeDDL() {
        $.each($('.qty-ddl'), function (i, v) {
            disableSizeDDL(v);
        });
    }

    $(function () {
        AssignItemDDLValue();
        InitializeItemReturnShowHide();
        //$('#hfEmpID').change(AssignItemEligibilityValue); 

        $('#hfEmpID').change(LoadItemsWithEligibility);
        
        if ('@Model.IsNewApplication' == 'False' && '@Model.IsPhaseBSOVerify' == 'False' && '@Model.Status' != "PE")
        {
            loadQtyTooltip();
            loadSizeTooltip();
        }
        if ('@isViewOnlyFeedback' == 'True') {
            readOnlyFeedbackRadio();
        }

        //$('.radio-assign-value').change(AssignRadioValue);
        $('.radio-assign-value').change(function () {
            //console.log(this);
            var element = $(this);
            var SplitName = (element.attr("name")).split("_");
            var FeedbackName = SplitName[0];
            var Count = SplitName[1];
            var TargetName = "RequestItems[" + Count + "].ItemFeedback." + FeedbackName;
            $('[name="' + TargetName + '"]').val(element.val());
        });

        initiateDisableSizeDDL();
        disableStatusDDL();


    });
</script>