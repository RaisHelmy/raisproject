                                <img class="imgQtyInfo" name="imgQtyInfo_@x" id="imgQtyInfo_@x" src="/_layouts/15/images/info16by16.gif" alt="QtyInfo" title="">
                            </div>
                        }
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Size
                        </label>
