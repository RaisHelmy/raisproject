                                    <input type="text" class="form-control" name="RequestItems[@x].StatusDesc" value='@Model.RequestItems[x].StatusDesc' readonly />
                                </div>
                            </div>
                        </div>

                        if (!string.IsNullOrEmpty(Model.RequestItems[@x].Status) && Model.RequestItems[@x].Status == "PR")
