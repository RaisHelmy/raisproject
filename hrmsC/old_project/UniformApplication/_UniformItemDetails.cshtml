                                <img class="imgSizeInfo" name="imgSizeInfo_@x" id="imgSizeInfo_@x" src="/_layouts/15/images/info16by16.gif" alt="SizeInfo" title="">
                            </div>
                        }
                    </div>
                </div>
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-3">
                            Comment
