
@{
    Layout = "";
    string WarningMessage = ViewBag.WarningMessage;
}

@if (!string.IsNullOrEmpty(WarningMessage))
{
    <div class="col-md-12">
        <div class="note note-danger">
            <h4 class="block">
                @WarningMessage
            </h4>

        </div>
    </div>
}