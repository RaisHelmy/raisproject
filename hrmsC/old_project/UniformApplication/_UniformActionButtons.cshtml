@model SEP.RoutingManagement.Service.AllowAction

@{
    UniformApplication.Model.UniformApplicationVM vm = ViewBag.UniformApplicationVM;

    bool isNewRecord = vm.IsNewApplication;  //vm.IsNewApplication; //
    bool isCurrentEmployeeRecord = ViewBag.IsCurrentEmployeeRecord;
    String CurrentEmployeeID = ViewBag.CurrentEmployeeID;
    String CurrentApproverID = ViewBag.CurrentApproverID;
    String Status = ViewBag.Status;
}

@if (Status != "DR" && Status != "CA" && !vm.IsNewApplication)
{
    if (Model.CanAcknowledge == "1" || Model.CanAgree == "1" || Model.CanApprove == "1" || Model.CanDecline == "1" ||
        Model.CanEndorse == "1" || Model.CanProcess == "1" || Model.CanReceive == "1" || Model.CanRecommend == "1" ||
        Model.CanRework == "1" || Model.CanVerify == "1" || Model.CanCancel == "1" || Model.CanAgreeCancel == "1")
    {
        <div id="portletComment" class="row">
            <div class="col-md-12">
                <div class="portlet box blue">
                    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
                    <div class="portlet-title">
                        <div class="caption">
                            <i class="fa fa-reorder"></i>Comment
                        </div>
                        <div class="tools">
                            <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                        </div>
                    </div>
                    <div class="portlet-body form">
                        <div class="form-body">

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="control-label col-md-2">Comment</label>
                                            <div class="col-md-10 form-control-static">
                                                <textarea class="form-control" id="txtAppComment" rows="5" cols="60"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<input type="hidden" value="@ViewBag.IsNewRecord.ToString()" />
<div class="row hide" id="_Disclaimer">
    <div class="col-md-12">
        <input type="checkbox" id="disclaimer" class="form-control" />
        no ETK or substitution is allowed
    </div>
</div>

<br />
<br />

<div class="row"  id="divActionButton">
    @if (vm.IsEditable)
    {
    <div class="col-md-12">
        @if (isCurrentEmployeeRecord || vm.IsCurrentEmployeeBSO)
        {
            if (vm.IsNewApplication)
            {
                <input type="button" class="btn green" value="Save as Draft" id="btnDraft" onclick="SubmitApplication('Draft'); " />
            }

            <input type="button" class="btn green" value="Submit" id="btnSubmit" onclick="SubmitApplication('Submit'); " />

            if (vm.IsNewApplication)
            {
                if (vm.ID != Guid.Empty)
                {
                    <input type="button" class="btn red" value="Delete" id="btnSubmit" onclick="DeleteApplication(); " />
                }
            }
        }
        @*else if ((Status == "Draft" || Status == "DR"))
        {
            if (!isNewRecord)
            {
                <input type="button" class="btn red" value="Delete" id="btnDelete" onclick="DeleteApplication(); " />
            }
        }*@

        <input type="button" class="btn green" value="Back" id="btnBack" onclick="BackToHistory();" />
    </div>
    }
    else
    {
    <div class="col-md-12">
        @if (Model.CanVerify == "1")
        {
            <input type="button" class="btn green" value="Verify" id="btnVerify" onclick="ApproverAction('Verify')" />
        }

        @if (Model.CanAcknowledge == "1")
        {
            <input type="button" class="btn green" value="Acknowledge" id="btnAcknowledge" onclick="ApproverAction('Acknowledge')" />
        }

        @if (Model.CanAgree == "1")
        {
            <input type="button" class="btn green" value="Agree" id="btnAgree" onclick="ApproverAction('Agree')" />
        }

        @if (Model.CanApprove == "1")
        {
            <input type="button" class="btn green" value="Approve" id="btnApprove" onclick="ApproverAction('Approve')" />
        }

        @if (Model.CanProcess == "1")
        {
            <input type="button" class="btn green" value="Process" id="btnProcess" onclick="ApproverAction('Process')" />
        }

        @if (Model.CanProcessMemo == "1")
        {
            <input type="button" class="btn green" value="Process Memo" id="btnProcessMemo" onclick="ApproverAction('ProcessMemo')" />
        }

        @if (Model.CanReceive == "1")
        {
            <input type="button" class="btn green" value="Receive" id="btnReceive" onclick="ApproverAction('Receive')" />
        }

        @if (Model.CanRecommend == "1")
        {
            <input type="button" class="btn green" value="Recommend" id="btnRecommend" onclick="ApproverAction('Recommend')" />
        }
        @if (Model.CanEndorse == "1")
        {
            <input type="button" class="btn green" value="Endorse" id="btnEndorse" onclick="ApproverAction('Endorse')" />
        }
        @if (Model.CanAgreeCancel == "1")
        {
            @*<input type="button" class="btn green" value="Approve Cancel" id="btnAgreeCancel" onclick="ApproverAction('AgreeCancel')" />*@
            <input type="button" class="btn green" value="Approve Cancel" id="btnAgreeCancel" onclick="ApproverAction('ApproveCancel')" />
        }
        @if (Model.CanWithdraw == "1")
        {
            <input type="button" class="btn red" value="Withdraw" id="btnWithdraw" onclick="ApproverAction('Withdraw')" />
        }
        @if (Model.CanRework == "1")
        {
            <input type="button" class="btn red" value="Rework" id="btnRework" onclick="ApproverAction('Rework')" />
        }
        @if (Model.CanCancel == "1")
        {
            <input type="button" class="btn red" value="Cancel" id="btnCancel" title="Cancel this Leave" onclick="CancelThisLeave()" />
        }

        @if (Model.CanDecline == "1")
        {
            <input type="button" class="btn red" value="Decline" id="btnDecline" onclick="DeclineThisLeave();" />
        }
        @*@if (vm.IsPhaseStatusUpdate)
        {
            <input type="button" class="btn green" value="Update" id="btnSubmit" onclick="SubmitApplication('RC'); " />
        }*@


        @if (vm.IsPhaseFeedback || vm.IsPhaseStatusUpdate)
        {
            if (vm.IsBSOMemberOfRequest)
            {
                <input type="button" class="btn green" value="Update Status" id="btnSubmit" onclick="SubmitApplication('RC'); " />
            }
        }

        @if (vm.IsPhaseFeedback)
        {
            if (isCurrentEmployeeRecord || vm.IsBSOMemberOfRequest)
            {
                <input type="button" class="btn green" value="Update Feedback" id="btnSubmit" onclick="SubmitApplication('FB'); " />
            }
        }
        @*@if (vm.Status == "WD")
        {
            <input type="button" class="btn red" value="Delete" id="btnSubmit" onclick="DeleteApplication(); " />
        }*@

        <input type="button" class="btn green" value="Back" id="btnBack" onclick="BackToHistory()" />
    </div>
    }

</div>
<script>
    $(function () {
        var canCancel = '@Model.CanCancel';

        if (canCancel == "1") {
            $('#portletComment').hide();
        }
    });

    function CancelThisLeave() {
        if ($('#portletComment').is(":visible") == false) {
            $('#portletComment').show();
        }
        else {
            ApproverAction('Cancel');
        }
    }

    function BackToHistory() {
        window.location.href = '@ViewBag.BackUrl';
    }
</script>
