@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Uniform Application: My Approval History";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title <span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date From</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="StartDate" name="StartDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date To</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="EndDate" name="EndDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">State</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLState", "UniformApplication")
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Location</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLLocation", "UniformApplication")
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Category</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Category">
                            <option value="">- All -</option>
                            <option value="0">Yearly Cycle</option>
                            <option value="1">Special Requirement</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Year</label>
                    <div class="col-md-8 form-control-static">
                        <input id="Year" name="Year" class="form-control" type="text" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Reference No</label>
                    <div class="col-md-8 form-control-static">
                        <input id="RefNo" name="RefNo" class="form-control" type="text" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        <input id="Employee" name="Employee" class="form-control" type="text" />
                    </div>
                </div>
            </div>
        </div>
    </div>



    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>

<script>

    function SearchListing() {
        var _StartDate = $('#StartDate').val();
        var _EndDate = $('#EndDate').val();
        var _RefNo = $('#RefNo').val();
        var _Employee = $('#Employee').val();
        var _Category = $('#Category').val();
        var _State = $('#State').val();
        var _Location = $('#Location').val();
        var _Year = $('#Year').val();

        $("#SearchResult").html("LOADING...");

        $.post('@Url.Content("~/UniformApplication/_AppHistoryResult")',
                {
                    StartDate: _StartDate,
                    EndDate: _EndDate,
                    RefNo: _RefNo,
                    Employee: _Employee,
                    Category: _Category,
                    State: _State,
                    Location: _Location,
                    Year: _Year
                },
                function (content) {
                    $("#SearchResult").html(content);
                }
        );
    }


    function ClearFilter() {
        $('#StartDate').val('');
        $('#EndDate').val('');
        $('#RefNo').val('');
        $('#Employee').val('');
        $('#Category').val('');
        $('#State').val('');
        $('#Location').val('');
        $('#Year').val('');

        SearchListing();
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        });

        SearchListing();
    });

</script>