@model List<SEP.RoutingManagement.Models.GetMyApprovalHistory>

@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>My Approval History

                @*Action Value: @ViewBag.ActionValue <span style="padding-left:20px;"><small></small></span>
                Action Empty: @ViewBag.ActionIsEmpty <span style="padding-left:20px;"><small></small></span>*@
        </div>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No</th>
                                <th>Employee</th>
                                <th>Category</th>
                                <th>State</th>
                                <th>Location</th>
                                <th>Submission Date</th>
                                <th>Year</th>
                                <th>Action Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/UniformApplication/Index")?ID=@item.SourceID&Source=AppHistory">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>@item.DisplayText16</td>
                                    <td>@item.DisplayText1 - @item.DisplayText3</td>
                                    <td>@item.DisplayText7</td>
                                    <td>@item.DisplayText14</td>
                                    <td>@item.DisplayText15</td>
                                    <td>@item.DisplayText11</td>
                                    <td>@item.DisplayText8</td>
                                    @if (!String.IsNullOrEmpty(item.ActionDate.ToString()))
                                    {
                                        <td>@Convert.ToDateTime(item.ActionDate).ToString("dd-MM-yyyy")</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }


                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    transformTable("#tblResult");
</script>