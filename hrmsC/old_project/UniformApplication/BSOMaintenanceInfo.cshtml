
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Eligibility Setup";
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            @ViewBag.Title <span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>@ViewBag.Title
                </div>
                <div class="tools">
                    <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Submit For</label>
                                    <div class="col-md-8 form-control-static">
                                        @if (!Model.isBSOSubmitFor)
                                        {
                                            string SubmitForDisplay = @Model.EmployeeCode + " - " + Model.EmployeeName;
                                            <input type="hidden" name="SubmitFor" value="@Model.SubmitFor">
                                            <input type="hidden" name="EmployeeID" value="@Model.EmployeeID">
                                            <input type="text" class="form-control" readonly name="SubmitForDisplay" value="@SubmitForDisplay">
                                        }
                                        else
                                        {
                                            @Html.Action("_PeoplePickerExt", "PeoplePicker", new { CurrEmpID = Model.Submiter.ID, SearchType = "" })
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Category Type</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" name="Category" value="@Model.Category">
                                        <input type="text" class="form-control" readonly name="CategoryDesc" value="@Model.CategoryDesc">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Message -->
<div class="modal fade" id="SuccessSubmit" tabindex="-1" role="basic" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>*@
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well" id="SuccessMessage">
                    Claims has been successfully submitted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <a class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </a>
            </div>
        </div>
    </div>
</div>

 <!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
        top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
        opacity: .8; filter: alpha(opacity=70);display:none">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

    </p>
</div>

<script type="text/javascript">

    function showDivLoading() {
        $('#divLoading').show();
    }

    function hideDivLoading() {
        $('#divLoading').hide();
    }

</script>

