@using UniformApplication.Model
@using UniformApplication.Services
@using System.Data

@model System.Data.DataTable
@{
    Layout = null;

    int i = 0;
    int j = 0;
    string HiddenCol = "Hidden";

    string StartDate = ViewBag.StartDate;
    string EndDate = ViewBag.EndDate;
    string Category = ViewBag.Category;
    string Status = ViewBag.Status;
    string EmployeeState = ViewBag.EmployeeState;

    List<HolidayCalendar> HolidayCalendarMapping = Service.SPGetHolidayCalendar();
    string HolidayMappingColumnName = "Employee State";
}
<style>
</style>

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Feedback and Status Report
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tbl_Index_DetailsResult" class="table table-striped table-bordered table-hover table-full-width table-font-size">
                        <thead>
                            <tr>
                                @foreach (System.Data.DataColumn col in Model.Columns)
                                {
                                    if (i == 0)
                                    {

                                        <th style="max-width:50px;">

                                        </th>
                                    }
                                    else
                                    if (!col.Caption.ToUpper().Contains(HiddenCol.ToUpper()))
                                    {

                                        <th class="long-header" style="width:0px;">@col.Caption</th>
                                    }

                                    i++;
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow row in Model.Rows)
                            {
                                j = 0;
                                <tr>
                                    @foreach (var cell in row.ItemArray)
                                    {
                                        if (!row.Table.Columns[j].Caption.ToUpper().Contains(HiddenCol.ToUpper()))
                                        {
                                            if (j == 0)
                                            {

                                                <td class="long-text" style="min-width: 50px;">
                                                    <a class="btn blue btn-sm" href="@Url.Content("~/UniformApplication/FeedbackReportDetails")?Code=@cell.ToString()&StartDate=@StartDate&EndDate=@EndDate&Category=@Category&Status=@Status&EmployeeState=@EmployeeState">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                </td>
                                            }
                                            else
                                            {
                                                if (row.Table.Columns[j].Caption.ToUpper() == HolidayMappingColumnName.ToUpper())
                                                {
                                                    string value = cell.ToString();
                                                    if(!string.IsNullOrEmpty(value))
                                                    {
                                                        var MappingItem = HolidayCalendarMapping.Where(x => x.Title.ToUpper() == value.ToUpper()).FirstOrDefault();
                                                        value = (MappingItem != null) ? MappingItem.Description : value;
                                                    }

                                                    <td class="long-header">
                                                        @value
                                                    </td>
                                                }
                                                else
                                                {

                                                    <td class="long-header">
                                                        @cell.ToString()
                                                    </td>
                                                }
                                            }
                                        }

                                        j++;
                                    }
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    i = 0;
    j = 0;
}

<table id="tblExport" border="1" style="display: none;">
    <thead>
        <tr>
            @foreach (System.Data.DataColumn col in Model.Columns)
            {
                if (i == 0)
                {

                }
                else
                if (!col.Caption.ToUpper().Contains(HiddenCol.ToUpper()))
                {

                    <th>@col.Caption</th>
                }
                i++;
            }
        </tr>
    </thead>
    <tbody>
        @foreach (System.Data.DataRow row in Model.Rows)
        {
            j = 0;
            <tr>
                @foreach (var cell in row.ItemArray)
                {
                    if (!row.Table.Columns[j].Caption.ToUpper().Contains(HiddenCol.ToUpper()))
                    {
                        if (j == 0)
                        {

                        }
                        else
                        {
                            if (row.Table.Columns[j].Caption.ToUpper() == HolidayMappingColumnName.ToUpper())
                            {
                                string value = cell.ToString();
                                if (!string.IsNullOrEmpty(value))
                                {
                                    var MappingItem = HolidayCalendarMapping.Where(x => x.Title.ToUpper() == value.ToUpper()).FirstOrDefault();
                                    value = (MappingItem != null) ? MappingItem.Description : value;
                                }

                                <td>
                                    @value
                                </td>
                            }
                            else
                            {
                                <td>@cell.ToString().Trim()</td>
                            }
                        }
                    }

                    j++;
                }
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">


    var tblResult = $('#tbl_Index_DetailsResult').dataTable();

    $(function () {
        BindExport();
    });
</script>
