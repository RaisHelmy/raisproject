@model List<AdvanceClaimsListing>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Claims Report
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Holiday Calendar</th>
                                <th>Claims Category</th>
                                <th>Nett Claims (RM)</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>OF Reference No</th>
                                <th>OF Status</th>
                                <th>AC Reference No</th>
                                <th>AC Status</th>
                                <th style="width:300px!important;display:block;">Remarks</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Html.Raw(Url.Content("~/Claims/ViewAdvanceClaims?ID=" + item.RequestID))">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>
                                        @item.ReferenceNo
                                    </td>
                                    <td>@item.EmployeeCode - @item.EmployeeName</td>
                                    <td>@item.HolidayCalendar</td>
                                    <td>@item.ClaimsCategory</td>
                                    <td>@item.NettClaims</td>
                                    <td style="color:@(item.Status == "Returned" ||item.Status == "Withdrawn" ? "red":"green");">
                                        <b>@item.Status</b>
                                    </td>
                                    <td>@item.CreatedDate</td>
                                    <td>@item.OFReferenceNo</td>
                                    <td style="color:@(item.OFStatus == "Returned" ||item.Status == "Withdrawn" ? "red":"green");">
                                        <b>@item.OFStatus</b>
                                    </td>
                                    <td>@item.ACReferenceNo</td>
                                    <td style="color:@(item.ACStatus == "Returned" ||item.Status == "Withdrawn" ? "red":"green");">
                                        <b>@item.ACStatus</b>
                                    </td>
                                    <td style="white-space: pre-line;">@Html.Raw(item.Remarks)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">

    jQuery.extend(jQuery.fn.dataTableExt.oSort, {
        "date-dmy-pre": function (a) {
            if (a == null || a == "") {
                return 0;
            }
            var date = a.split('-');
            return (date[2] + date[1] + date[0]) * 1;
        },

        "date-dmy-asc": function (a, b) {
            return ((a < b) ? -1 : ((a > b) ? 1 : 0));
        },

        "date-dmy-desc": function (a, b) {
            return ((a < b) ? 1 : ((a > b) ? -1 : 0));
        }
    });

    function customTable() {
        //console.log('asdas');
        $('#tblResult').dataTable({
            "bDestroy": true,
            "aLengthMenu": [
                [10, 15, 20, -1],
                [10, 15, 20, "All"] // change per page values here
            ],
            // set the initial value
            "iDisplayLength": 10,

            "sPaginationType": "bootstrap",
            "oLanguage": {
                "sLengthMenu": "_MENU_ records",
                "oPaginate": {
                    "sPrevious": "Prev",
                    "sNext": "Next"
                }
            },
            "aoColumnDefs": [
                { "sType": "date-dmy", "aTargets": [6] }],
            //disable init sorting
            "aaSorting": []


        });
    }

    customTable("#tblResult");
</script>
