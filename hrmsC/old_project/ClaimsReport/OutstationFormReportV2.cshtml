@model List<ESS.Core.DropDownObject>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Outstation Form Report";

    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");

    //DateTime dtDefaultDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    DateTime dtDefaultDate = DateTime.Today;
    string defaultDate = dtDefaultDate.AddMonths(-1).ToString("dd/MM/yyyy");
    string defaultDate2 = dtDefaultDate.ToString("dd MMM yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Outstation Form Report<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Travel Start Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="StartDatePicker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="StartDate" name="StartDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Travel End Date</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" id="EndDatePicker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="EndDate" name="EndDate" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Mode of Transport</label>
                    <div class="col-md-8 form-control-static">
                        @Html.DropDownList("ModeOfTransport", new SelectList(Model, "Value", "Text"), "- All -", new { @class = "bs-select form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option value="">- All -</option>
                            <option value="Draft">Draft</option>
                            <option value="Pending">Pending</option>
                            <option value="Agreed">Agreed</option>
                            <option value="Approved">Approved</option>
                            <option value="Returned">Returned</option>
                            <option value="Withdrawn">Withdrawn</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Reference No</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" id="ReferenceNo" name="ReferenceNo" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Partial("_PeoplePicker")
                        @*PeoplePicker hiddenfieldid = hfEmpID, textboxid =txtEmpName*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                <input type="button" id="btn-Clear" class="btn default " value="Clear" onclick="ClearFilter();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>

<iframe id="txtArea1" style="display:none"></iframe>

<script type="text/javascript">
     $(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
         });

        $('.date-picker').datepicker('setStartDate', '@dtStrStart');
        $('.date-picker').datepicker('setEndDate', '@dtStrEnd');

        $('#StartDatePicker').datepicker('setDate', moment('@defaultDate', 'DD/MM/YYYY').toDate());

        //SearchListing();
    });


    function SearchListing() {
       
     }
</script>
