@model List<ClaimsListingCustom>
@{
    Layout = null;
}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Claims
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel"/>
        <div class="tools">
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Reference No.</th>
                                <th>Employee</th>
                                <th>Claims Category</th>
                                <th>
                                    <span class="">Nett Claims (RM)</span> 
                                </th>
                                <th>Status</th>
                                <th>Current In-tray</th>
                                <th>Submission Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in @Model)
                            {
                                <tr>
                                    <td>
                                        @if (@item.ClaimCategoryCode == "MIL01")
                                        {
                                            <a class="btn blue btn-sm" href="@Url.Content("~/Claims/MileageBookDetails")?ID=@item.RequestID&Source=ClaimsReport">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        }
                                        else if (@item.ClaimCategoryCode == "FLX01")
                                        {
                                            <a class="btn blue btn-sm" href="@Url.Action("FlexiBenefitsViewForm","Claims", new { RequestID = item.RequestID }) ">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        }
                                        else if (@item.ClaimCategoryCode == "CIS01")
                                        {
                                            <a class="btn blue btn-sm" href="@Url.Content("~/Claims/ViewILSASClaims")?ID=@item.RequestID">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn blue btn-sm" href="@Url.Content("~/Claims/Index")?ID=@item.RequestID">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        }
                                    </td>
                                    <td>@item.ReferenceNo</td>
                                    <td  style="min-width: 150px;"> <span class="long-text">@item.EmployeeCode - @item.EmployeeName  </span> </td>
                                    <td>@item.ClaimCategoryName</td>
                                    <td>@item.NettAmount</td>
                                    @if (@item.Status == "Returned" || @item.Status == "Withdrawn")
                                    {
                                        <td style="color:red;"><b>@item.Status</b></td>
                                    }
                                    else
                                    {
                                        <td style="color:green;"><b>@item.Status</b></td>
                                    }

                                    <td style="min-width: 150px;"> 
                                        <span class="long-text">@item.ApproverCode - @item.ApproverName </span>
                                    </td>
                                    

                                    @if (@item.SubmissionDate.HasValue)
                                    {   
                                        <td>@item.SubmissionDate.Value.ToString("dd-MM-yyyy hh:mm:ss tt") </td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<script type="text/javascript">
    jQuery.extend(jQuery.fn.dataTableExt.oSort, {
        "date-dmy-pre": function (a) {
            if (a == null || a == "") {
                return 0;
            }
            var datetime = a.split(' ');
            var date = datetime[0].split('-');
            var time = datetime[1].split(':');
            if (datetime[2] == 'PM' && time[0] !== '12')
            {
                var hour = parseInt(time[0]) + 12;
            }
            else if (datetime[2] == 'AM' && time[0] === '12')
            {
                var hour = '00';
            }
            else
            {
                var hour = time[0];
            }
            
            return (date[2] + date[1] + date[0] + hour + time[1] + time[2]) * 1;
        },

        "date-dmy-asc": function (a, b) {
            return ((a < b) ? -1 : ((a > b) ? 1 : 0));
        },

        "date-dmy-desc": function (a, b) {
            return ((a < b) ? 1 : ((a > b) ? -1 : 0));
        }
    });

    function customTable() {
        //console.log('asdas');
        $('#tblResult').dataTable({
            "bDestroy": true,
            "aLengthMenu": [
                [10, 15, 20, -1],
                [10, 15, 20, "All"] // change per page values here
            ],
            // set the initial value
            "iDisplayLength": 10,

            "sPaginationType": "bootstrap",
            "oLanguage": {
                "sLengthMenu": "_MENU_ records",
                "oPaginate": {
                    "sPrevious": "Prev",
                    "sNext": "Next"
                }
            },
            "aoColumnDefs": [
                { "sType": "date-dmy", "aTargets": [7] }
            ],
            //disable init sorting
            "aaSorting": []


        });
    }

    customTable("#tblResult");
</script>