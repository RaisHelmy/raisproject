@model List<ESS.EPop.Models.EPopMedicalInfoVM>
@{
    Layout = null;
}

<div class="form-horizontal">
    <div class="table-toolbar">
        <table id="tblMedical" class="table table-striped table-bordered table-hover table-full-width">
            <thead>
                <tr>
                    <th>Medical Leave - Warded</th>
                    <th>Medical Leave - Non-Warded</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in @Model)
                {
                    <tr>
                        <td>
                            @if (item.NonWarded.Length > 0)
                            {
                                <span>@item.NonWarded</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                        <td>
                            @if (item.Warded.Length > 0)
                            {
                                <span>@item.Warded</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>

                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>

<script>
    $('#tblMedical').dataTable(
       {
           "bLengthChange": false,
           "bFilter": false,
           "bPaginate": false,
           "bInfo": false,
           "bSortable": false,

       });
</script>


