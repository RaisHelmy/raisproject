@model List<ESS.EPop.Models.UnpaidLeaveHistory>
@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Unpaid Leave History
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body" id="ct01_CustomFieldFormView">
                    <div class="form-horizontal">
                        <div class="table-toolbar">
                            <table id="tblUnpadLeave" class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        <th>@(DateTime.Now.Year - 4)</th>
                                        <th>@(DateTime.Now.Year - 3)</th>
                                        <th>@(DateTime.Now.Year - 2)</th>
                                        <th>@(DateTime.Now.Year - 1)</th>
                                        <th>@(DateTime.Now.Year)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Count > 0)
                                    {
                                        foreach (var item in @Model)
                                        {
                                            <tr>
                                                <td>
                                                    @if (item.TotalYear1 > 0)
                                                    {
                                                        <span>@Convert.ToInt32(item.TotalYear1)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.TotalYear2 > 0)
                                                    {
                                                        <span>@Convert.ToInt32(item.TotalYear2)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.TotalYear3 > 0)
                                                    {
                                                        <span>@Convert.ToInt32(item.TotalYear3)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.TotalYear4 > 0)
                                                    {
                                                        <span>@Convert.ToInt32(item.TotalYear4)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.TotalYear5 > 0)
                                                    {
                                                        <span>@Convert.ToInt32(item.TotalYear5)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>-</td>
                                            <td>-</td>
                                            <td>-</td>
                                            <td>-</td>
                                            <td>-</td>
                                        </tr>
                                    }


                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<script>
    $('#tblUnpadLeave').dataTable(
       {
           "bLengthChange": false,
           "bFilter": false,
           "bPaginate": false,
           "bInfo": false,
           "bSortable": false,

       });
</script>


