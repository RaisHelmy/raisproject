                                        <div class="col-md-10">
                                            <textarea name="txtSpecialization" onkeydown="return CheckMaxLength(this, event, '1000');" style="width:100%;" rows="4" id="txtSpecialization">@Html.Raw(@Model.Item1.Specialization)</textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
