@model List<ESS.EPop.Models.EPOPReportMemo>

@{
    Layout = null;
    int CountRow = 0;

}

<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>EPOP Assessment Memo
        </div>
        <input type="button" id="btn-Export" class="btn btn-xs green pull-right" value="Export To Excel" />
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="form-horizontal">
                <div class="table-toolbar">
                    <table id="tblResult" class="table table-striped table-bordered table-hover table-full-width">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nama & No. Pekerja</th>
                                <th>Employee Sub Group</th>
                                <th>Year</th>
                                <th>PMS</th>
                                <th>Stesen</th>
                                <th>Jawatan & Gred</th>
                                <th>Tarikh cadangan kenaikan Gred</th>
                                <th>Status</th>
                                <th>Category</th>
                                <th>Last Action Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a class="btn blue btn-sm" href="@Url.Content("~/EPOP/OnlineAssessmentForm")?AssessmentID=@item.AssessmentID.Trim()&RequestID=@item.RequestID.Trim()">
                                            <i class="fa fa-search"></i>
                                        </a>
                                    </td>
                                    <td>
                                        <div>
                                            @item.EmployeeName <br/>
                                            (@item.EmployeeCode)
                                        </div> 
                                    </td>
                                    <td>@item.SubGroupName</td>
                                    <td>
                                        <div>
                                            @item.pmsInfo.Year1 <br/>
                                            @item.pmsInfo.Year2 <br />
                                            @item.pmsInfo.Year3 <br />
                                            @item.pmsInfo.Year4 <br />
                                            @item.pmsInfo.Year5 <br />
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            @item.pmsInfo.PMS1 <br />
                                            @item.pmsInfo.PMS2 <br />
                                            @item.pmsInfo.PMS3 <br />
                                            @item.pmsInfo.PMS4 <br />
                                            @item.pmsInfo.PMS5 <br />
                                        </div>
                                    </td>
                                    <td>@item.SubAreaName</td>
                                    <td>
                                        <div>
                                            @item.PositionName <br/>
                                            (@item.NextGrade)
                                        </div>
                                    </td>
                                    <td>@item.PromotionDate</td>
                                    <td>@item.StatusName</td>
                                    <td>@item.Category</td>
                                    <td>@item.ModifiedDate</td>
                                </tr>
                                CountRow++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    //transformTable("#tblResult");
    $('#tblResult').dataTable({
        "aLengthMenu": [[10, 25, 50, 100, 1000], [10, 25, 50, 100, 1000]]
    });

    var tableWrapper = "#tblResult_wrapper";

    jQuery(tableWrapper + ' .dataTables_filter input').addClass("form-control input-medium input-inline"); // modify table search input
    jQuery(tableWrapper + ' .dataTables_length select').addClass("form-control input-small"); // modify table per page dropdown
    jQuery(tableWrapper + ' .dataTables_length select').select2({
        showSearchInput: false //hide search box with special css class
    });


</script>