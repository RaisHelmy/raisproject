@model List<ESS.EPop.Models.EPopOnlineAssessmentDetailsVM>
@{ 
    Layout = null;
    int CountRow = 0;
}
<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Achievement and contribution
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">

                    <div class="form-horizontal EditContent">
                        <div class="table-toolbar">
                            <table id="tblResult1" class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        <th>Achievement and contribution Factor</th>
                                        <th>
                                            <label class="control-label col-md-12 ">
                                                Comment <span class="required">*</span>
                                            </label>
                                            @*Comment<span class="required">*</span>*@
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Title</td>
                                            <td class="WrapTextColumn" style="min-width:400px;">
                                                <textarea name="ArcContriRemark_@CountRow" class="ArcContriRemarks" style="width:100%;" rows="2" id="ArcContriRemark_@CountRow" factor="@item.Title" order="@item.OrderNo">@Html.Raw(@item.Remarks)</textarea>
                                            </td>
                                        </tr>
                                        CountRow++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="form-horizontal NonEditContent">
                        <div class="table-toolbar">
                            <table id="tblResult1" class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        <th>Achievement and contribution Factor</th>
                                        <th>Comment</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Title</td>
                                            <td class="WrapTextColumn" style="min-width:400px;">
                                                @if (!string.IsNullOrEmpty(item.Remarks))
                                                {
                                                    <span>
                                                        @item.Remarks
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        N/A
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                        CountRow++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


