@using ESS.Core
@model List<ESS.Core.DropDownObject>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Business Partner's History (HR)";

    if (!(ESS.EPop.Service.isApprover(Common.GetEmployeeID(), "SSC") || ESS.EPop.Service.isApprover(Common.GetEmployeeID(), "HRBP")))
    {
        Response.Redirect("~/AccessControl/ErrorPermission");
    }

}
<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            EPOP - Business Partner's History (HR)<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<input type="hidden" id="hfEmployeeID" value="@ViewBag.EmployeeID" />
<div class="form-body">

    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Company</label>
                    <div class="col-md-8 form-control-static">
                        @Html.DropDownList("Company", new SelectList(Model, "Value", "Text"), "- All -", new { @class = "bs-select form-control", @onchange = "changeCompany(this)" })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Department</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLDepartment", "Training", new { })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Unit / Section</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Action("_DDLUnitSection", "Training", new { })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" type="text" id="EmployeeName" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Category</label>
                    <div class="col-md-8 form-control-static">
                        <select name="ExecutiveCategory" class="bs-select form-control" id="ExecutiveCategory">
                            <option value="">- All -</option>
                            <option value="Non-Executive">Non-Executive</option>
                            <option value="Executive">Executive</option>
                            <option value="Specialist">Specialist</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Request Reference No</label>
                    <div class="col-md-8 form-control-static">
                        <input class="form-control" id="ReferenceNo" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Start" class="btn green btn-Start DivBAUserOnly" value="Restart Assessment" onclick="javascript: ApproverAction(this)">
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="SuccessSubmit" tabindex="-1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header Success-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="display: none;"></button>
                <h4 class="Success-title">Action Successfully Completed</h4>
            </div>
            <div class="modal-body Success-body">
                <div class="well">
                    The EPOP Assessment will be restarted.
                </div>
            </div>
            <div class="modal-footer Success-footer">
                <button type="submit" class="btn default blue" id="btnOK">
                    <i class="fa fa-check"></i>
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Gif -->
<div id="divLoading" style="margin: 0px; padding: 0px; position: fixed; right: 0px;
    top: 0px; width: 100%; height: 100%; background-color:gainsboro; z-index: 30001;
    opacity: .8; filter: alpha(opacity=70);display:none">
    <p style="position: absolute; top: 30%; left: 30%; color: black;">
        Loading, please wait...<img src="../Assets/img/ajax-loading.gif" />

    </p>
</div>

<script type="text/javascript">
    // Variable
    //var Path = '/_layouts/15/tnbess';
    //var Path = '/_layouts/15/essv2';
    var Path = 'http://localhost:49773';
    var EmployeeID = '';

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true
        });

        SearchListing();


    });



    function ClearFilter() {
        $('#SubDateFrom').val('');
        $('#SubDateTo').val('');
        $('#Status').val('');
        $('#txtEmpName').val('');
        $('#hfEmpID').val('');
        SearchListing();
    }

    function SearchListing() {
        var _CompanyCode = $('#Company option:selected').val();
        var _DepartmentCode = $('#Department option:selected').val();
        var _UnitSectionCode = $('#UnitSection option:selected').val();
        var _EmployeeName = $('#EmployeeName').val();
        var _Category = $('#ExecutiveCategory option:selected').val();
        var _ReferenceNo = $('#ReferenceNo').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/EPOP/_BAHistoryResult")',
            cache: false,
            dataType: "html",
            data: {
                Division: _CompanyCode, Department: _DepartmentCode,
                UnitSection: _UnitSectionCode, EmployeeCode: _EmployeeName,
                Category: _Category, ReferenceNo: _ReferenceNo
            },
            success: function (content) {
                $("#SearchResult").html(content);
                ExportToExcel();
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function changeCompany(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/EPOP/_DDLDepartment")',
            cache: false,
            dataType: "html",
            data: { CompanyCode: e.value },
            success: function (content) {
                $("#Department").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function changeDepartment(e) {
        $.ajax({
            type: "GET",
            url: '@Url.Content("~/EPOP/_DDLUnitSection")',
            cache: false,
            dataType: "html",
            data: { DepartmentCode: e.value },
            success: function (content) {
                $("#UnitSectionResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }


    function ExportExcel() {
        var dt = new Date();
        var day = dt.getDate();
        var month = dt.getMonth() + 1;
        var year = dt.getFullYear();
        var hour = dt.getHours();
        var mins = dt.getMinutes();
        var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;

        var _CompanyCode = $('#Company option:selected').val();
        var _DepartmentCode = $('#Department option:selected').val();
        var _UnitSectionCode = $('#UnitSection option:selected').val();
        var _EmployeeName = $('#EmployeeName').val();
        var _Category = $('#ExecutiveCategory option:selected').val();
        var _ReferenceNo = $('#ReferenceNo').val();

        var JsonObjectFilter = {
            "Division": _CompanyCode,
            "Department": _DepartmentCode,
            "UnitSection": _UnitSectionCode,
            "EmployeeCode": _EmployeeName,
            "Category": _Category,
            "ReferenceNo": _ReferenceNo
        }

        var Filter = JSON.stringify(JsonObjectFilter);

        window.open("../EPOP/_ExportToExcelGeneral?FileName=EPOP_BAFormHistory" + postfix +
                    "&ReportCategory=" + "BAFormHistory" +
                    "&Filter=" + Filter);

    }

    function ApproverAction(btn) {
        var _ValidationMsg = '- Please ensure at least One EPOP Assessment Form is selected before proceed.\n';

        $("#tblResult td input[name='chkSelectAssessment']:checked").each(function (i, value) {

            var row = $(this).closest("tr");
            if (row.find(".checkItem").val() != '' && row.find(".checkItem").val() != undefined) {
                _ValidationMsg = '';
            }
        });

        if (_ValidationMsg != null && _ValidationMsg != '') {
            alert(_ValidationMsg);
        }
        else {
            btn.disabled = true;
            $("#divLoading").show();
            var myVar = setTimeout(function () { RestartAssessment() }, 3000);
        }
    }

    function RestartAssessment() {
        var FullResultRequest = '';
        var resultRequest = '';

        var FullResultAssessment = '';
        var resultAssessment = '';

        var _Employeee = document.getElementById('hfEmployeeID');

        if ($('#divLoading').is(':visible')) {
            $($('input[name="chkSelectAssessment"]:checked')).each(function () {
                var nameRequest = $(this).attr('id');
                var nameAssessment = $(this).attr('id');

                resultRequest = $("#" + nameRequest).val();
                FullResultRequest += resultRequest + " ,";

                resultAssessment = $("#Label" + nameAssessment).text();
                FullResultAssessment += resultAssessment + " ,";

            });
            var form = {
                FullRID: FullResultRequest,
                FullAID: FullResultAssessment

            };

            ajaxVerify(form);
        }
    }

    function ajaxVerify(form) {
        $.ajax({
            type: "POST",
            url: '@Url.Content("~/EPOP/RestartBusinessForm")',
            cache: false,
            async: false,
            dataType: "json",
            data: form,
            success: function (result) {
                if (result.Success) {
                    $("#divLoading").hide();
                    $("#SuccessSubmit").modal();
                    $("#btnOK").click(function () { RedirectTo('Submit'); });
                }
                else {
                    $("#divLoading").hide();

                    alert(result.ErrorMsg);
                }
            },
            error: function (e) {
            }
        });
    }

    function RedirectTo(_Action) {
        switch (_Action) {
            case "Submit":
                window.location.href = '@Url.Action("BAHistory","EPOP")';
                break;
            default:
                window.location.href = '@Url.Action("BAForm","EPOP")';
        }
    }
</script>