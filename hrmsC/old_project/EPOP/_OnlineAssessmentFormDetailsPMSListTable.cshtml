@model ESS.EPop.Models.EPopPMSInfoVM
@{
    Layout = null;
}
@if (@Model != null)
{
     <div class="form-horizontal">
        <div class="table-toolbar">
            <table id="tblPMS1" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th>
                            @if (!String.IsNullOrEmpty(Model.Year5))
                            {
                                @Model.Year5
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </th>
                        <th>
                            @if (!String.IsNullOrEmpty(Model.Year4))
                            {
                                @Model.Year4
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </th>
                        <th>
                            @if (!String.IsNullOrEmpty(Model.Year3))
                            {
                                @Model.Year3
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </th>
                        <th>
                            @if (!String.IsNullOrEmpty(Model.Year2))
                            {
                                @Model.Year2
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </th>
                        <th>
                            @if (!String.IsNullOrEmpty(Model.Year1))
                            {
                                @Model.Year1
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            @if (!String.IsNullOrEmpty(Model.PMS5))
                            {
                                <span style="white-space: pre-line">@Html.Raw(Model.PMS5)</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                        <td>
                            @if (!String.IsNullOrEmpty(Model.PMS4))
                            {

                                <span style="white-space: pre-line">@Html.Raw(Model.PMS4)</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                        <td>
                            @if (!String.IsNullOrEmpty(Model.PMS3))
                            {
                                <span style="white-space: pre-line">@Html.Raw(Model.PMS3)</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                        <td>
                            @if (!String.IsNullOrEmpty(Model.PMS2))
                            {
                                <span style="white-space: pre-line">@Html.Raw(Model.PMS2)</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                        <td>
                            @if (!String.IsNullOrEmpty(Model.PMS1))
                            {
                                <span style="white-space: pre-line">@Html.Raw(Model.PMS1)</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="form-horizontal">
        <div class="table-toolbar">
            <table id="tblPMS2" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th>5th Year</th>
                        <th>4th Year</th>
                        <th>3rd Year</th>
                        <th>2nd Year</th>
                        <th>1st Year</th>
                    </tr>
                </thead>
                <tbody>
                    
                </tbody>
            </table>
        </div>
    </div>
}

<script>
    $('#tblPMS1').dataTable(
       {
           "bLengthChange": false,
           "bFilter": false,
           "bPaginate": false,
           "bInfo": false,
           "bSortable": false,

       });
    $('#tblPMS2').dataTable(
   {
       "bLengthChange": false,
       "bFilter": false,
       "bPaginate": false,
       "bInfo": false,
       "bSortable": false,

   });
</script>

