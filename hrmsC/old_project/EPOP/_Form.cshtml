@model ESS.EPop.Models.EPopPendingAssessment


<div class="portlet box blue">
    <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
    <div class="portlet-title">
        <div class="caption">
            <i class="fa fa-reorder"></i>Request Details
        </div>
    </div>
    <div class="portlet-body form">
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-3">Reference No.</label>
                            <div class="col-md-9 form-control-static">
                                <input type="text" id="txtReferenceNo" name="ReferenceNo" class="form-control" value="@Model.ReferenceNo" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-3">Employee Code</label>
                            <div class="col-md-9 form-control-static">
                                <input type="text" id="txtEmployeeCode" name="EmployeeCode" class="form-control" value="@Model.EmployeeCode @Model.EmployeeName" readonly/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-3">Immediate Manager</label>
                            <div class="col-md-9 form-control-static">
                                <div>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="txtIMCode" readonly
                                               value="@Model.CurrentApproverCode @Model.CurrentEmployeeName" />
                                        <span class="input-group-btn" style="">
                                            <a data-toggle="modal" href="#PeoplePicker" onclick="GetActiveLink('IM')" class="btn default"><i class="fa fa-user"></i></a>
                                        </span>
                                        <input type="hidden" id="IMEmpCode" name="IMEmpCode" value="@Model.CurrentApproverCode" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-3">HOD</label>
                            <div class="col-md-9 form-control-static">
                                <div>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="txtHODCode" readonly
                                               value="@Model.ApproverCode2 @Model.ApproverName2" />
                                        <span class="input-group-btn" style="">
                                            <a data-toggle="modal" href="#PeoplePicker" onclick="GetActiveLink('HOD')" class="btn default"><i class="fa fa-user"></i></a>
                                        </span>
                                        <input type="hidden" id="HODEmpCode" name="HODEmpCode" value="@Model.ApproverCode2" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="form-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-3">VP</label>
                            <div class="col-md-9 form-control-static">
                                <div>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="txtVPCode" readonly
                                               value="@Model.ApproverCode3 @Model.ApproverName3" />
                                        <span class="input-group-btn" style="">
                                            <a data-toggle="modal" href="#PeoplePicker" onclick="GetActiveLink('VP')" class="btn default"><i class="fa fa-user"></i></a>
                                        </span>
                                        <input type="hidden" id="VPEmpCode" name="VPEmpCode" value="@Model.ApproverCode3" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

