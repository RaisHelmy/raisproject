@model ESS.Core.EmployeeDetailsSummary

@{
    Layout = null;
}

<div id="RequestorDetails" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Requestor Details
                </div>
                <div class="tools">
                    <a title="" data-original-title="" href="javascript:;" class="collapse"> </a>
                </div>
            </div>
            <div id="AllowanceRequestorInfo" class="portlet-body form">
                <div class="form-body" id="ct00_CustomFieldFormView">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Number
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.EmployeeCode
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Employee Name
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.EmployeeName
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Position
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.Position
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Immediate Manager
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.ImmediateManager
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Company
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @(Model.CompanyCode + " - " + Model.Company)
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Department
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @Model.Department
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        Unit Section
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        @Model.UnitSection
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label col-md-4 ">
                                        @*Current Approver*@
                                    </label>
                                    <div class="col-md-8  form-control-static">
                                        
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div id="hdEmpInfo">
                        <input type="hidden" name="Submiter.Company" value="@Model.Company" />
                        <input type="hidden" name="Submiter.CompanyCode" value="@Model.CompanyCode" />
                        <input type="hidden" name="Submiter.CostCenterCode" value="@Model.CostCenterCode" />
                        <input type="hidden" name="Submiter.CostCenterName" value="@Model.CostCenterName" />
                        <input type="hidden" name="Submiter.Department" value="@Model.Department" />
                        <input type="hidden" name="Submiter.DepartmentCode" value="@Model.DepartmentCode" />
                        <input type="hidden" name="Submiter.Email2" value="@Model.Email2" />
                        <input type="hidden" name="Submiter.EmailAddress" value="@Model.EmailAddress" />
                        <input type="hidden" name="Submiter.EmployeeCode" value="@Model.EmployeeCode" />
                        <input type="hidden" name="Submiter.EmployeeGroup" value="@Model.EmployeeGroup" />
                        <input type="hidden" name="Submiter.EmployeeName" value="@Model.EmployeeName" />
                        <input type="hidden" name="Submiter.EmployeeSubGroup" value="@Model.EmployeeSubGroup" />
                        <input type="hidden" name="Submiter.HODID" value="@Model.HODID" />
                        <input type="hidden" name="Submiter.HODName" value="@Model.HODName" />
                        <input type="hidden" name="Submiter.ID" value="@Model.ID" />
                        <input type="hidden" name="Submiter.ImmediateManager" value="@Model.ImmediateManager" />
                        <input type="hidden" name="Submiter.Job" value="@Model.Job" />
                        <input type="hidden" name="Submiter.JoinedDate" value="@Model.JoinedDate" />
                        <input type="hidden" name="Submiter.ManagerID" value="@Model.ManagerID" />
                        <input type="hidden" name="Submiter.NewIC" value="@Model.NewIC" />
                        <input type="hidden" name="Submiter.OfficeExtension" value="@Model.OfficeExtension" />
                        <input type="hidden" name="Submiter.OfficeFax" value="@Model.OfficeFax" />
                        <input type="hidden" name="Submiter.OfficeMobile" value="@Model.OfficeMobile" />
                        <input type="hidden" name="Submiter.OfficeNo" value="@Model.OfficeNo" />
                        <input type="hidden" name="Submiter.PayScaleGroup" value="@Model.PayScaleGroup" />
                        <input type="hidden" name="Submiter.Position" value="@Model.Position" />
                        <input type="hidden" name="Submiter.PositionCode" value="@Model.PositionCode" />
                        <input type="hidden" name="Submiter.UnitSection" value="@Model.UnitSection" />
                        <input type="hidden" name="Submiter.UnitSectionCode" value="@Model.UnitSectionCode" />

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


