@model ESS.Allowance.Models.AllowanceVM

@{
    Layout = null;

    string Checked2_1 = "";
    string Checked2_2 = "";

    switch (Model.Category)
    {
        case "Penamatan":
            Checked2_2 = "checked";
            break;
        default:
            Checked2_1 = "checked";
            break;
    }
}

<style>
    .padding-left-20 {
        padding-left: 20px;
    }

    .padding-left-5px {
        padding-left: 5px;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Allowance Application
                </div>
            </div>
            <div class="portlet-body form">
                @*Brand new form*@
                @if (Model.Status == "Draft" || (Model.Status == "Reworked" && Model.IsTaskOwner))
                {
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-12 ">
                                        Application Type<span style="color:red;"> *</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="radio-list padding-left-20">
                                        <label class="radio-inline">
                                            <input type="radio" name="Category" @Checked2_1 class="reqCategory" id="radio_PemohonanBaru" value="Permohonan Baru"> Permohonan Baru
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="radio-list padding-left-20">
                                        <label class="radio-inline">
                                            <input type="radio" name="Category" @Checked2_2 class="reqCategory"  id="radio_Penamatan" value="Penamatan"> Penamatan
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Reference No.</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" readonly style="font-weight:bold; color:blue;"
                                               name="ReferenceNo" value="@Model.ReferenceNo">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Status</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" name="Status" value="@Model.Status" />

                                        @if (Model.Status == "Declined" || Model.Status == "Withdrawn" || Model.Status == "Cancelled")
                                        {
                                            <input type="text" class="form-control" readonly style="color: red;"
                                                   name="StatusDescription" value="@Model.Status">
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control" readonly style="color:green;"
                                                   name="StatusDescription" value="@Model.Status">
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Employee<span style="color:red;"> *</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        @*@Html.Action("_PeoplePickerExt", "PeoplePicker", new { CurrEmpID = Model.Submiter.ID, SearchType = "Subordinates" })*@
                                        @Html.Partial("ALPeoplePicker", new Tuple<int?, ESS.Allowance.Models.AllowanceVM>(null, @Model))
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Allowance Type<span style="color:red;"> *</span>
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <select class="form-control" id="AllowanceCode" name="AllowanceCode">
                                            <option value="">Select One</option>
                                            @foreach (var allowanceType in Model.AllowanceTypes)
                                            {
                                                <option value="@allowanceType.AllowanceCode" data-Kadar="@allowanceType.Kadar" data-FixedAmount="@allowanceType.FixedAmount" data-MinAmount="@allowanceType.MinAmount" data-MaxAmount="@allowanceType.MaxAmount" data-MaxAmountExec="@allowanceType.MaxAmountExec" data-CA11MinAmount="@allowanceType.CA11MinAmount" data-CA11MaxAmount="@allowanceType.CA11MaxAmount" @(Model.AllowanceCode == allowanceType.AllowanceCode ? "selected" : "")>@allowanceType.AllowanceCode - @allowanceType.AllowanceType</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                }
                else 
                { 
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-12 ">
                                        Application Type
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="radio-list padding-left-20">
                                        <label class="radio-inline">
                                            <input type="radio" name="Category" @Checked2_1 class="reqCategory" id="radio_PemohonanBaru" value="Permohonan Baru" disabled> Permohonan Baru
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <div class="radio-list padding-left-20">
                                        <label class="radio-inline">
                                            <input type="radio" name="Category" @Checked2_2 class="reqCategory"  id="radio_Penamatan" value="Penamatan" disabled> Penamatan
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Reference No.</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="text" class="form-control" readonly style="font-weight:bold; color:blue;"
                                                name="ReferenceNo" value="@Model.ReferenceNo">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">Status</label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" name="Status" value="@Model.Status" />

                                        @if (Model.Status == "Declined")
                                        {
                                            <input type="text" class="form-control" readonly style="color: red;"
                                                    name="StatusDescription" value="@Model.Status">
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control" readonly style="color:green;"
                                                    name="StatusDescription" value="@Model.Status">
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Employee
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" name="EmployeeID" value="@Model.EmployeeID" />
                                        <input type="hidden" name="EmployeeCode" value="@Model.EmployeeCode" />
                                        <input type="hidden" name="EmployeeName" value="@Model.EmployeeName" />
                                        <input type="text" class="form-control" readonly
                                               value="@(Model.EmployeeCode + " - " + Model.EmployeeName)">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-md-4">
                                        Allowance Type
                                    </label>
                                    <div class="col-md-8 form-control-static">
                                        <input type="hidden" id="AllowanceCode" name="AllowanceCode" value="@Model.AllowanceCode" />
                                        <input type="hidden" id="AllowanceType" name="AllowanceType" value="@Model.AllowanceType" />
                                        <input type="text" class="form-control" readonly
                                               value="@(Model.AllowanceCode + " - " + Model.AllowanceType)">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="/_layouts/15/TNBESS/Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Application Details
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="portlet-body form">
                                @if (Model.Status == "Draft" || (Model.Status == "Reworked" && Model.IsTaskOwner))
                                {
                                    <div class="form-body">
                                        <div class="form-horizontal">
                                            <div class="table-toolbar">
                                                <table class="table table-striped table-bordered table-hover table-full-width" id="tblAllowanceDetails">
                                                    <thead>
                                                        <tr>
