                                                            <tr>
                                                                <td style="min-width:30px">
                                                                    <input type="hidden" name="AllowanceDetails.Index" value="@x">
                                                                    <input type="hidden" name="@x" value="@x">
                                                                    <input type="hidden" class="DetailID" name="AllowanceDetails[@x].DetailID" value="@Model.AllowanceDetails[x].DetailID" />
                                                                    <input type="checkbox" class="AllowanceDetailCheckBox" name="AllowanceDetails[@x].AllowanceDetailCheckBox" value="@Model.AllowanceDetails[x].DetailID" />
                                                                </td>
                                                                <td>
                                                                    <div class="input-group date date-picker" data-date-format="dd MM yyyy" style="width:150px">
                                                                        <input type="text" class="form-control StartDate" value="@(Model.AllowanceDetails[x].StartDate.HasValue ? Model.AllowanceDetails[x].StartDate.Value.ToString("dd/MM/yyyy") : "")"
                                                                               id="AllowanceDetails[@x].StartDate" name="AllowanceDetails[@x].StartDate" />
