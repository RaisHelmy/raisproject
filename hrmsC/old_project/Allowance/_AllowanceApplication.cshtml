                                                                        <input type="text" class="form-control EndDate" value="@(Model.AllowanceDetails[x].EndDate.HasValue ? Model.AllowanceDetails[x].EndDate.Value.ToString("dd/MM/yyyy") : "")"
                                                                               id="AllowanceDetails[@x].EndDate" name="AllowanceDetails[@x].EndDate" />
                                                                        <span class="input-group-btn">
                                                                            <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                                                                        </span>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static">
                                                                        <select class="form-control Station" id="AllowanceDetails[@x].Station" name="AllowanceDetails[@x].Station">
                                                                            <option value="">Select One</option>
                                                                            @foreach (var station in Model.Stations)
                                                                            {
                                                                                <option value="@station.Station" data-Kadar="@station.Kadar" @(Model.AllowanceDetails[x].Station == station.Station ? "selected" : "")>@station.Station</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:120px">
                                                                        <input type="text" class="form-control Kadar" name="AllowanceDetails[@x].Kadar" value="@(Model.AllowanceDetails[x].Kadar.HasValue ? Model.AllowanceDetails[x].Kadar.Value.ToString("0.00") : "0.00")%" />
                                                                        <select class="form-control Kadar" id="AllowanceDetails[@x].Kadar" name="AllowanceDetails[@x].Kadar" style="display:none" disabled>
                                                                            <option value="">Select One</option>
                                                                            <option value="5" @(Model.AllowanceDetails[x].Kadar == 5 ? "selected" : "")>5.00%</option>
                                                                            <option value="10" @(Model.AllowanceDetails[x].Kadar == 10 ? "selected" : "")>10.00%</option>
                                                                            <option value="15" @(Model.AllowanceDetails[x].Kadar == 15 ? "selected" : "")>15.00%</option>
                                                                            <option value="20" @(Model.AllowanceDetails[x].Kadar == 20 ? "selected" : "")>20.00%</option>
                                                                        </select>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:150px">
                                                                        <input type="text" class="form-control BasicPay" name="AllowanceDetails[@x].BasicPay" value="@(Model.AllowanceDetails[x].BasicPay.HasValue ? Model.AllowanceDetails[x].BasicPay.Value.ToString("0.00") : "0.00")" disabled />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:150px">
                                                                        <input type="text" class="form-control RatePerMonth" name="AllowanceDetails[@x].RatePerMonth" value="@(Model.AllowanceDetails[x].RatePerMonth.HasValue ? Model.AllowanceDetails[x].RatePerMonth.Value.ToString("0.00") : "0.00")" onblur="_CalculateSum(this);" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static text-center" style="width:100px">
                                                                        @Html.Partial("ALAttachmentPicker", new Tuple<string, string, string, string>("Add", Model.AllowanceDetails[x].DetailID.ToString(), "Multi", Model.AllowanceDetails[x].AttachmentCount.ToString() + "_" + x.ToString()))
                                                                    </div>
                                                                </td>
                                                                <td><input type="text" class="form-control Remarks" name="AllowanceDetails[@x].Remarks" value="@Model.AllowanceDetails[x].Remarks" /></td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="form-body">
                                        <div class="form-horizontal">
                                            <div class="table-toolbar">
                                                <table class="table table-striped table-bordered table-hover table-full-width" id="tblAllowanceDetails">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col" width="5%">
                                                            </th>
                                                            <th scope="col">Start Date</th>
                                                            <th scope="col">End Date</th>
                                                            <th scope="col">Station</th>
                                                            <th scope="col">Kadar</th>
                                                            <th scope="col">Basic Pay (RM)</th>
                                                            <th scope="col">Rate Per Month (RM)</th>
                                                            <th scope="col">Attachment</th>
                                                            <th scope="col">Remarks</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int x = 0; x < Model.AllowanceDetails.Count(); x++)
                                                        {
                                                            <tr>
                                                                <td style="min-width:30px">
                                                                    <input type="hidden" name="AllowanceDetails.Index" value="@x">
                                                                    <input type="hidden" name="@x" value="@x">
                                                                    <input type="hidden" class="DetailID" name="AllowanceDetails[@x].DetailID" value="@Model.AllowanceDetails[x].DetailID" />
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:120px">
                                                                        <input type="text" class="form-control StartDate" value="@(Model.AllowanceDetails[x].StartDate.HasValue ? Model.AllowanceDetails[x].StartDate.Value.ToString("dd/MM/yyyy") : "")" readonly
                                                                               id="AllowanceDetails[@x].StartDate" name="AllowanceDetails[@x].StartDate" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:120px">
                                                                        <input type="text" class="form-control EndDate" value="@(Model.AllowanceDetails[x].EndDate.HasValue ? Model.AllowanceDetails[x].EndDate.Value.ToString("dd/MM/yyyy") : "")" readonly
                                                                               id="AllowanceDetails[@x].EndDate" name="AllowanceDetails[@x].EndDate" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:250px">
                                                                        <input type="text" class="form-control Station" value="@Model.AllowanceDetails[x].Station" title="@Model.AllowanceDetails[x].Station" readonly
                                                                               id="AllowanceDetails[@x].Station" name="AllowanceDetails[@x].Station" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:120px">
                                                                        <input type="text" class="form-control Kadar" value="@(Model.AllowanceDetails[x].Kadar.HasValue ? Model.AllowanceDetails[x].Kadar.Value.ToString("0.00") : "0.00")%" readonly
                                                                               id="AllowanceDetails[@x].Kadar" name="AllowanceDetails[@x].Kadar" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:120px">
                                                                        <input type="text" class="form-control BasicPay" value="@(Model.AllowanceDetails[x].BasicPay.HasValue ? Model.AllowanceDetails[x].BasicPay.Value.ToString("0.00") : "0.00")" readonly
                                                                               id="AllowanceDetails[@x].BasicPay" name="AllowanceDetails[@x].BasicPay" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static" style="width:150px">
                                                                        <input type="text" class="form-control RatePerMonth" value="@(Model.AllowanceDetails[x].RatePerMonth.HasValue ? Model.AllowanceDetails[x].RatePerMonth.Value.ToString("0.00") : "0.00")" readonly
                                                                               id="AllowanceDetails[@x].RatePerMonth" name="AllowanceDetails[@x].RatePerMonth" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-control-static text-center" style="width:100px">
                                                                        @Html.Partial("ALAttachmentPicker", new Tuple<string, string, string, string>("View", Model.AllowanceDetails[x].DetailID.ToString(), "Multi", Model.AllowanceDetails[x].AttachmentCount.ToString() + "_" + x.ToString()))
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <input type="text" class="form-control Remarks" value="@Model.AllowanceDetails[x].Remarks" title="@Model.AllowanceDetails[x].Remarks" readonly
                                                                           id="AllowanceDetails[@x].Remarks" name="AllowanceDetails[@x].Remarks" />
