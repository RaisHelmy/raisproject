@model Tuple<string, string, string, string>

@*Model.Item1 = Mode*@
@*Model.Item2 = RequestID*@
@*Model.Item3 = Type*@
@*Model.Item4 = AttachmentCount_EntriesCount*@

@{
    string Mode = Model.Item1;
    string RequestID = Model.Item2;
    string Type = Model.Item3;
    var splitItem4 = Model.Item4.Split('_');

    string AttachmentCount = (splitItem4.Count() > 0) ? (splitItem4[0] != 0.ToString()) ? splitItem4[0] : "" : "";
    string EntriesCount = (splitItem4.Count() > 1) ? splitItem4[1] : "";

    string EntriesCountName = !string.IsNullOrEmpty(EntriesCount) ? "AllowanceDetails[" + EntriesCount + "].AttachmentCount" : "";
}

<div>
    <div class="col-md-7" style="padding-right: 0px; text-align: right;">
        <a class="btn blue btn-sm" onclick="OpenAttachment('@Mode', '@RequestID', '@Type', '@EntriesCountName');">
            <i class="fa fa-file-o"></i>
        </a>
    </div>
    <div class="col-md-5" style="padding-left: 0px; text-align: left">
        <span class="attachment-count" name="@EntriesCountName">@AttachmentCount</span>
    </div>
</div>
