@using ESS.Claim.ClaimSubtype
@using ESS.Claim.ViewModels
@model Tuple<ColumnTemplate, ClaimsSubtype>

@{
    ColumnTemplate col = Model.Item1;
    ClaimsSubtype subtype = Model.Item2;
}

<input type="hidden" 
       value="@col.ColumnValue"
       class="@col.ColumnName"
       name="ClaimsSubtypeCategory[@subtype.categoryIndex].ClaimSubtype[@subtype.subtypeIndex].SubTypeDetails[0].@col.ColumnName" />