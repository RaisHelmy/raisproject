@using ESS.Claim.ViewModels
@using ESS.Claim.ClaimSubtype
@using Newtonsoft.Json
@model ClaimsSubtype

<tfoot>
    <tr>
        <td colspan="@(Model.Template.Columns.Where(x => x.ColumnType != ColumnType.HiddenInput).Count() - 3)"></td>
        <td><input type="text" class="form-control text-right GrandAmount" value="@(Model.SubTypeDetails == null ? "0.00" : String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.Amount) ? 0.00 : Convert.ToDouble(m.Amount)))))" readonly /></td>
        <td><input type="text" class="form-control text-right GrandGSTAmount" value="@(Model.SubTypeDetails == null ? "0.00" : String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.GSTAmount) ? 0.00 : Convert.ToDouble(m.GSTAmount)))))" readonly /></td>
        <td><input type="text" class="form-control text-right GrandTotalAmount" value="@(Model.SubTypeDetails == null ? "0.00" : String.Format("{0:0.00}", Model.SubTypeDetails.Sum(m => (String.IsNullOrEmpty(m.TotalAmount) ? 0.00 : Convert.ToDouble(m.TotalAmount)))))" readonly /></td>
    </tr>
</tfoot>