
@{
    ViewBag.Title = "E-Transfer Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime d1 = DateTime.Now.AddYears(-20);
    DateTime d2 = DateTime.Now.AddYears(20);
    string dtStrStart = d1.ToString("dd MMM yyyy");
    string dtStrEnd = d2.ToString("dd MMM yyyy");
}

<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            E-Transfer Report<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<br />
<div class="form-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee</label>
                    <div class="col-md-8 form-control-static">
                        @Html.Partial("_PeoplePicker")
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Reference No.</label>
                    <div class="col-md-8 form-control-static">
                        <input type="text" class="form-control" id="txtReferenceNo" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Company Code</label>
                    <div class="col-md-8 form-control-static">
                        <select id="ddlCompanyCode" class="form-control" name="CompanyCode">
                            <option value="">-  All -</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Transfer Request Type</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="TransferType">
                            <option value="">- All -</option>
                            <option value="Within Division">Within Division</option>
                            <option value="Inter Division">Inter Division</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Personnel Area</label>
                    <div class="col-md-8 form-control-static">
                        <select id="ddlPersonnelArea" class="form-control" name="AreaCode">
                            <option value="">-  All -</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Personnel Subarea</label>
                    <div class="col-md-8 form-control-static">
                        <select id="ddlPersonnelSubarea" class="form-control" name="SubAreaCode">
                            <option value="">-  All -</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Employee Category</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="EmployeeCategory">
                            <option value="">- All -</option>
                            <option value="Executive">Executive</option>
                            <option value="NonExecutive">Non-Executive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Status</label>
                    <div class="col-md-8 form-control-static">
                        <select class="form-control" id="Status">
                            <option value="">- All -</option>
                            <option value="Pending">Pending</option>
                            <option value="Agreed">Agreed</option>
                            <option value="Approved">Approved</option>
                            <option value="Declined">Declined</option>
                            <option value="Withdrawn">Withdrawn</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (From)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateFrom" name="SubDateFrom" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-4 control-label">Submission Date (To)</label>
                    <div class="col-md-8 form-control-static">
                        <div class="input-group date date-picker" data-date-format="dd MM yyyy">
                            <input type="text" class="form-control" id="SubDateTo" name="SubDateTo" />
                            <span class="input-group-btn">
                                <button type="button" class="btn default"><i class="fa fa-calendar"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div class="text-right">
                <input type="button" id="btn-Search" class="btn green btn-Search" value="Search" onclick="SearchListing();">
                @*<input id="btn-Clear" type="button" class="btn default " value="Clear" onclick="ClearFilter();">*@
            </div>
        </div>
    </div>
    <div class="row">&nbsp;</div>
    <div class="row">
        <div class="col-md-12">
            <div id="SearchResult">

            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function SearchListing() {
        var _DateFrom = $('#SubDateFrom').val();
        var _DateTo = $('#SubDateTo').val();
        var _TransferType = $('#TransferType').val();
        var _Status = $('#Status').val();

        var _EmployeeCategory = $('#EmployeeCategory').val();
        var _hfEmpId = $('#hfEmpID').val();
        var _txtReferenceNo = $('#txtReferenceNo').val();

        var _CompanyCode = $('#ddlCompanyCode').val();
        var _PerArea = $('#ddlPersonnelArea').val();
        var _SubPerArea = $('#ddlPersonnelSubarea').val();

        $("#SearchResult").html("LOADING...");

        $.ajax({
            type: "GET",
            url: '@Url.Content("~/ETransfer/_ETransferReportResult")',
            cache: false,
            dataType: "html",
            data: {
                DateFrom: _DateFrom, DateTo: _DateTo, TransferType: _TransferType, Status: _Status,
                EmployeeCategory: _EmployeeCategory, EmployeeID: _hfEmpId, ReferenceNo: _txtReferenceNo,
                CompanyCode: _CompanyCode, PerArea: _PerArea, SubPerArea: _SubPerArea
            },
            success: function (content) {
                $("#SearchResult").html(content);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    jQuery(document).ready(function () {
        $('.date-picker').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            setStartDate: '@dtStrStart',
            setEndDate: '@dtStrEnd'
        });

        SearchListing();
    });


    //function ClearFilter() {
    //    $('#SubDateFrom').val('');
    //    $('#SubDateTo').val('');
    //    $('#Status').val('');
    //    $('#TransferType').val('');
    //    SearchListing();
    //}

    function ExportExcel() {
        var dt = new Date();
        var day = dt.getDate();
        var month = dt.getMonth() + 1;
        var year = dt.getFullYear();
        var hour = dt.getHours();
        var mins = dt.getMinutes();
        var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;

        window.open("../ETransfer/_ExportToExcel?FileName=ETransfer_Report_" + postfix);
    }

    var OptionLink = '@Url.Action("_GetAssetSearchOptions", "Asset")';
    var ddlCompanyCode;
    var ddlGrade;
    var ddlPersonnelArea;
    var ddlPersonnelSubarea;
    var ddlDeclarationStatus;
    //var ddlCompanyCode = $('#ddlCompanyCode');

    $(function () {
        ddlCompanyCode = $('#ddlCompanyCode');
        ddlPersonnelArea = $('#ddlPersonnelArea');
        ddlPersonnelSubarea = $('#ddlPersonnelSubarea');


        InitCompanyCodeOptions();
        ddlCompanyCode.on('change', UpdateAreaCodeOption);
        ddlPersonnelArea.on('change', UpdateSubAreaCodeOption);
    });


    function InitCompanyCodeOptions() {
        FillDropdown(ddlCompanyCode,
        {
            OptionType: "CompanyCode",
            CompanyCode: ddlCompanyCode.val() || "",
            AreaCode: ddlPersonnelArea.val() || "",
            SubAreaCode: ddlPersonnelSubarea.val() || ""
        });
    }

    function UpdateAreaCodeOption() {
        FillDropdown(ddlPersonnelArea,
            {
                OptionType: "PersonnelArea",
                CompanyCode: ddlCompanyCode.val() || "",
                AreaCode: ddlPersonnelArea.val() || "",
                SubAreaCode: ddlPersonnelSubarea.val() || ""
            }, UpdateSubAreaCodeOption);
    }

    function UpdateSubAreaCodeOption() {
        FillDropdown(ddlPersonnelSubarea,
            {
                OptionType: "PersonnelSubarea",
                CompanyCode: ddlCompanyCode.val() || "",
                AreaCode: ddlPersonnelArea.val() || "",
                SubAreaCode: ddlPersonnelSubarea.val() || ""
            });
    }

    function FillDropdown(ddl, option, callback) {
        $.get(OptionLink, option, function (result) {
            ddl.empty().append('<option value="">--  All --</option>');

            for (var i = 0; i < result.length; i++) {
                ddl.append('<option value="' + result[i].Code + '">' + result[i].Description + '</option>');
            }

            if (callback) {
                callback();
            }
        });
    }
</script>
