@model List<ESS.ETransfer.Models.ETransferHistory>
@{
    Layout = null;
}

<div id="divApplicantHist" class="row">
    <div class="col-md-12">
        <div class="portlet box blue">
            <div class="mini-triangle"><img src="../Assets/img/menu-red-triangle.png" /></div>
            <div class="portlet-title">
                <div class="caption">
                    <i class="fa fa-reorder"></i>Applicant Request History
                </div>
            </div>
            <div class="portlet-body form">
                <div class="form-body">
                    <div class="form-horizontal">
                        <div class="table-toolbar">
                            <table  id="tblApplicantHist" class="table table-striped table-bordered table-hover table-full-width">
                                <thead>
                                    <tr>
                                        @*<th></th>*@
                                        <th>Reference No</th>
                                        <th>Transfer Type</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in @Model)
                                    {
                                        <tr>
                                            @*<td></td>*@
                                            <td>@item.RequestNo</td>
                                            <td>@item.TransferType</td>
                                            <td>@item.StatusName</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    transformTable("#tblApplicantHist");
</script>