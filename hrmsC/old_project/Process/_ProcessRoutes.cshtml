@model IEnumerable<ESS.ReRouting.Models.ProcessRoute>
@{
    Layout = null;
}
<div class="form-horizontal">
    <div class="form-body">
        <div class="table-toolbar">
            <input type="hidden" id="RoutesList" name="RoutesList" />
            <table id="tblProcessRoutes" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th>Routing</th>
                        <th width="10px fixed">Action</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            @Html.HiddenFor(m => item.ID, new {@class="selectedRoute"})
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                <a class="btn red btn-sm" onclick="javascript: RemoveRoutingFromProcess(this, '@item.ID', '@item.ProcessId')">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="DeleteRouteModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title" id="deleteText">Remove Route</h4>
            </div>
            <div class="modal-body">
                <div class="well">
                    <p>Clicking on "Delete" button will remove this route from your routes list. To cancel, click on "Close" button to return to the routes listing.</p>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn default red" id="btnDeleteRoute" href="">Delete</a>
                <button type="button" class="btn default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



<script>
    function  RemoveRoutingFromProcess(element, id, processId)
    {
        $("#DeleteRouteModal").modal();
        var url = '@Url.Action("DeleteRoute", "Process")?processRouteId=' + id +'&processId='+processId;
        $("#btnDeleteRoute").attr('href', url);
    }
</script>