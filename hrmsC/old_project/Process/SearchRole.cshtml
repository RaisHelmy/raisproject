
@{
    ViewBag.Title = "Search Role";
    Layout = "";
}

<div class="form-body">

    <div class="row" style="margin-top:10px">
        <div class="col-md-12">
            <div id="RoleSearchResult">

            </div>
        </div>
    </div>
</div>


<script>

    $(document).ready(function () {
        SearchRole();
    });

    function SearchRole()
    {
        var roleCode = $("#txtRoleCode").val();
        var CurrentRolesList = $("#RolesList").val();
        console.log("list is " + CurrentRolesList);
        $.ajax({
            url: '@Url.Action("_SearchRoleResult")',
            type: "GET",
            data: {roleCode: roleCode, CurrentRolesList: CurrentRolesList},
            success: function (content) {
                $("#RoleSearchResult").html(content);
            },
            error: function(err)
            {
                console.log("Error in getting roles list: " + err);
            }
        });
    }

</script>
