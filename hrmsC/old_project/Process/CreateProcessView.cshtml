
@{
    ViewBag.Title = "Create Process";
}
<div class="row">
    <div class="col-md-12">
        <br />
        <h1 class="page-title">
            Create New Process<span style="padding-left:20px;"><small></small></span>
        </h1>
    </div>
</div>
<hr />

<div class="form-horizontal">
    <div class="form-body">

        <div class="form-group">
            <label class="control-label col-md-2">Process Name <span style="color:red">*</span></label>
            <div class="col-md-4">
                <input type="text" class="form-control" id="processName"/>
            </div>
        </div>
        <br />
        <div class="form-group">
            <label class="control-label col-md-2">Description <span style="color:red">*</span></label>
            <div class="col-md-8">
                <textarea id="description" class="form-control" style="margin: 0px -1.34375px 0px 0px; width: 703px; height: 160px;"></textarea>
            </div>
        </div>
        <br />
        <div class="form-group" style="padding-top:50px">
            <div class="col-md-10">
                <a class="btn default pull-right" onclick="location.href='@Url.Action("Processes", "Process")'">Back</a>
                <button class="btn blue pull-right" style="margin-right:10px" type="submit" onclick="javascript: CreateProcess(); return false">
                    <i class="fa fa-pencil"></i> Add
                </button>
            </div>
        </div>
    </div>
</div>
<script>

    function CreateProcess()
    {
        var Name = $("#processName").val();
        var Desc = $("#description").val();

        window.location = '@Url.Action("CreateProcess")?processName=' + Name + '&description=' + Desc;
    }
</script>
