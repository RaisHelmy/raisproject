@model IEnumerable<ESS.ReRouting.Models.ProcessRole>
@{
    Layout = null;
}
<div class="form-horizontal">
    <div class="form-body">
        <div class="table-toolbar">
            <input type="hidden" id="RolesList" name="RolesList" />
            <table id="tblProcessRoles" class="table table-striped table-bordered table-hover table-full-width">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th width="10px fixed">Action</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            @Html.HiddenFor(m => item.ID, new {@class="selectedRole" })
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                <a class="btn red btn-sm" onclick="javascript: RemoveRoleFromProcess(this, '@item.ID', '@item.ProcessId')">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="DeleteRoleModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                    <h4 class="modal-title" id="deleteText">Remove Role</h4>
                </div>
                <div class="modal-body">
                    <div class="well">
                        <p>Clicking on "Delete" button will remove this role from your roles list. To cancel, click on "Close" button to return to the roles listing.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <a class="btn default red" id="btnDeleteRole" href="">Delete</a>
                    <button type="button" class="btn default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</div>


<script>
    function RemoveRoleFromProcess(element, id, processId)
    {
        $("#DeleteRoleModal").modal();
        var url = '@Url.Action("DeleteRole", "Process")?processRoleId=' + id + '&processId='+ processId;
        $("#btnDeleteRole").attr('href', url);
    }
</script>