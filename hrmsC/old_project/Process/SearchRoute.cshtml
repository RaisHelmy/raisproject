
@{
    Layout = "";
}

<div class="form-body">
    <div class="row" style="margin-top:10px">
        <div class="col-md-12">
            <div id="RouteSearchResult">

            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        SearchRoute();
    });


    function SearchRoute() {
        var routingName = $("#txtRouteName").val();
        var CurrentRoutesList = $("#RoutesList").val();

        $.ajax({
            url: '@Url.Action("_SearchRoutingResult")',
            type: "GET",
            data: { routingName: routingName, CurrentRoutesList: CurrentRoutesList },
            success: function (content) {
                $("#RouteSearchResult").html(content);
            },
            error: function(err)
            {
                console.log("Error in getting rotues." + err);
            }
        });
    }
</script>