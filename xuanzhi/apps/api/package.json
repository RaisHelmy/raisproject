{
  "name": "@xuanzhi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev --port 8787",
    "deploy": "bunx wrangler deploy",
    "types": "bunx wrangler types",
    "typecheck": "bunx wrangler types > /dev/null && bunx tsc -p tsconfig.json",
    "build": "bunx wrangler deploy --dry-run --outdir dist",
    "test": "bunx vitest run",
    "db:migrate": "bun scripts/migrate.mjs",
    "db:seed": "bun scripts/seed.mjs"
  },
  "dependencies": {
    "@xuanzhi/shared-types": "workspace:*",
    "hono": "^4.10.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.0",
    "unpdf": "^1.4.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": { "typescript": "^5.9.3", "vitest": "^3.2.0", "wrangler": "^4.103.0" }
}
