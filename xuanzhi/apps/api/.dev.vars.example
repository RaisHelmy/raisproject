# Copy to .dev.vars for local development. Never commit .dev.vars.
# Required
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-another-long-random-string   # encrypts provider API keys stored by admins
# Optional AI provider keys (admins can also enter keys in Admin → Models → Providers; stored encrypted)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# OAuth (leave empty to hide the buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Stripe (leave empty → billing runs in "not configured" mode; admins assign plans manually)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Transactional email (leave empty → verification/reset links are logged to the console)
RESEND_API_KEY=
EMAIL_FROM=XuanZhi AI <no-reply@example.com>
# Shared secret for the Ubuntu-cron-triggered /internal/cron/:job endpoint
CRON_SECRET=
