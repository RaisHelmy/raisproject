{
  "name": "@xuanzhi/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx vite --port 5173",
    "build": "bunx tsc -p tsconfig.json && bunx vite build",
    "preview": "bunx vite preview",
    "typecheck": "bunx tsc -p tsconfig.json",
    "test": "bunx vitest run",
    "deploy": "bunx vite build && bunx wrangler pages deploy dist --project-name xuanzhi"
  },
  "dependencies": {
    "@xuanzhi/shared-types": "workspace:*",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "highcharts": "^12.4.0",
    "highcharts-react-official": "^3.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.103.0"
  }
}
