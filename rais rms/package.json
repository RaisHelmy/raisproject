{
  "name": "rais-rms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "bun run build && wrangler pages deploy dist",
    "db:migrate": "for f in migrations_pg/*.sql; do echo \"applying $f\"; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -c 'SET search_path TO raisrms' -f \"$f\" || exit 1; done",
    "wrangler:types": "wrangler types",
    "deploy": "bun run build && bunx wrangler pages deploy dist --project-name rais-rms --commit-dirty=true"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tanstack/react-query": "^5.59.0",
    "bootstrap": "^5.3.3",
    "highcharts": "^11.4.8",
    "highcharts-react-official": "^3.2.1",
    "hono": "^4.6.9",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^3.83.0"
  }
}
