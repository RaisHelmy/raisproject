{
  "name": "rais-download-screenshot-automate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "rdsa": "./src/cli.ts"
  },
  "scripts": {
    "rdsa": "node src/cli.ts",
    "scan": "node src/cli.ts scan",
    "plan": "node src/cli.ts plan",
    "capture": "node src/cli.ts capture",
    "run": "node src/cli.ts run",
    "login": "node src/cli.ts login",
    "inspect": "node src/cli.ts inspect",
    "typecheck": "tsc --noEmit",
    "browsers": "bunx playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}