{
  "name": "@runforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b tsconfig.json",
    "deploy": "VITE_API_URL=https://runforge.raishelmy.uk bun run build && bunx wrangler pages deploy dist --project-name raisrunforge-web --commit-dirty=true"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "highcharts": "^11.4.8",
    "highcharts-react-official": "^3.2.1",
    "@runforge/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.3",
    "typescript": "^5.6.0"
  }
}
