{
  "name": "runforge",
  "private": true,
  "version": "0.1.0",
  "description": "RunForge — a universal control plane for developers to deploy, monitor, manage and automate their own infrastructure.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "agent/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:api:bun": "bun run --cwd apps/api dev:bun",
    "dev:agent": "bun run --cwd agent/runforge-agent dev",
    "build": "bun run --cwd apps/web build",
    "db:migrate": "bun run scripts/db-migrate.ts",
    "db:seed": "bun run scripts/db-seed.ts",
    "test": "bun test",
    "lint": "bun run scripts/lint.ts",
    "typecheck": "tsc -b tsconfig.json",
    "deploy:api": "bun run --cwd apps/api deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  }
}
