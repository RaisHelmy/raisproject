# ---------------------------------------------------------------------------
# RunForge — example environment configuration
# Copy to `.dev.vars` (Cloudflare Workers local dev) or `.env` (Bun runtime).
# Never commit real values.
# ---------------------------------------------------------------------------

# Control plane mode: "demo" runs entirely against the in-memory Demo Provider.
# "production" expects real provider adapters and Postgres (via Hyperdrive).
RUNFORGE_MODE=demo

# Postgres connection string, used by scripts/db-migrate.ts and any local/
# manual DB access (e.g. through an SSH tunnel to the DB host). The deployed
# Worker does NOT read this — it connects through the HYPERDRIVE binding in
# apps/api/wrangler.toml instead.
#
# This app's data lives in the `raisrunforge` schema inside the shared
# `raishelmy` Postgres database (one instance, one schema per app) — the
# database name below is `raishelmy`, and search_path is set to
# `raisrunforge` automatically by createPgClient() / db-migrate.ts.
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/raishelmy

# Authentication mode: "demo" signs every request in as the seeded demo owner.
# "token" requires a Bearer token (API or MCP token).
RUNFORGE_AUTH_MODE=demo

# Secret used to sign sessions / API tokens in non-demo mode.
RUNFORGE_AUTH_SECRET=change-me

# Public URL of the control plane (used by the agent and webhooks).
RUNFORGE_PUBLIC_URL=http://localhost:8787

# Agent
RUNFORGE_AGENT_TOKEN=
RUNFORGE_AGENT_SERVER_ID=

# Cloudflare (optional, only used by the CloudflareProvider adapter)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Git providers (optional)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
