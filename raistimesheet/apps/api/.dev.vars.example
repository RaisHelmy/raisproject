# Copy to .dev.vars for local development (never commit .dev.vars)
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-32-bytes-base64-or-longer-random-string
# Leave empty to run the heuristic demo AI provider (clearly labelled as DEMO in the UI)
ANTHROPIC_API_KEY=
# Jira OAuth 2.0 (3LO) app credentials — leave empty to use API token or demo mode
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Optional: static token that lets the Python MCP bootstrap an API token for a user
MCP_BOOTSTRAP_TOKEN=
