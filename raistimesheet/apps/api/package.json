{
  "name": "@rais/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev --port 8787",
    "deploy": "bunx wrangler deploy",
    "types": "bunx wrangler types",
    "typecheck": "bunx wrangler types > /dev/null && bunx tsc -p tsconfig.json",
    "test": "bunx vitest run",
    "db:migrate:local": "psql \"postgresql://postgres:postgres@localhost:15432/raishelmy?sslmode=require&options=--search_path%3Draistimesheet\" -f ./migrations-pg/0001_init.sql",
    "db:seed:local": "psql \"postgresql://postgres:postgres@localhost:15432/raishelmy?sslmode=require&options=--search_path%3Draistimesheet\" -f ./seed/demo.sql",
    "seed:build": "bun seed/build-seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@rais/shared-types": "workspace:*",
    "hono": "^4.10.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.103.0"
  }
}
