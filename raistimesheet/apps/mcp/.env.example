# Base URL of the Rais Timesheet API (Cloudflare Worker)
RAIS_API_URL=http://localhost:8787
# Personal API token created under Profile → API tokens (or via MCP bootstrap)
RAIS_API_TOKEN=
# Optional: bootstrap a token automatically using the server's MCP_BOOTSTRAP_TOKEN
RAIS_MCP_BOOTSTRAP_TOKEN=
RAIS_USER_EMAIL=
