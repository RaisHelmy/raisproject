{
  "name": "rais-timesheet",
  "private": true,
  "version": "0.1.0",
  "description": "Rais Timesheet \u2014 WhatsApp \u2192 AI \u2192 Timesheet \u2192 Approval \u2192 Jira \u2192 Reports",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun run --filter '@rais/*' dev",
    "dev:api": "bun run --filter @rais/api dev",
    "dev:web": "bun run --filter @rais/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:migrate:local": "bun run --filter @rais/api db:migrate:local",
    "db:seed:local": "bun run --filter @rais/api db:seed:local",
    "deploy": "bun run --filter @rais/api deploy && bun run --filter @rais/web deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
