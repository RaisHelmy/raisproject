# raiseat environment configuration
# Copy to .env and fill in keys. The app runs fully in demo mode without any of these.

# Grocery/food pricing API (optional — falls back to demo local estimates)
VITE_PRICING_API_URL=
VITE_PRICING_API_KEY=

# Geocoding / routing / maps (optional — travel planner uses demo routes without it)
VITE_MAPS_API_KEY=

# Restaurant / places API (optional — food-nearby uses demo listings without it)
VITE_PLACES_API_KEY=

# Currency exchange API (optional — MYR-only in demo mode)
VITE_CURRENCY_API_KEY=
