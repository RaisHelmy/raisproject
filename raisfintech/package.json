{
  "name": "rais-fintech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:pg": "for f in migrations_pg/*.sql; do echo \"applying $f\"; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -c \"SET search_path TO raisfintech;\" -f \"$f\"; done"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.0",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^6.2.0",
    "wrangler": "^4.10.0"
  }
}
